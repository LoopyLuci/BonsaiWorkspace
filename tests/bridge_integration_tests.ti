pub fn test_complete_workflows() -> String {
    let suite = test_suite_create("complete_workflows");

    // Data to verified model workflow
    let r1 = test_case("data_to_verified_model", pub fn() -> i64 {
        let csv = "feature,label\n1.0,0\n2.0,1";
        let file = "data.csv";
        file_write(file, csv);
        let result = pipeline_data_to_verified_model(file, "output.txt");
        if string_length(result) > 0 then 1 else 0 end
    });
    let suite = test_suite_add(suite, r1);

    // Config to verified deployment workflow
    let r2 = test_case("config_to_deployment", pub fn() -> i64 {
        let config = "{\"name\": \"app\", \"replicas\": 3}";
        let file = "config.json";
        file_write(file, config);
        let result = pipeline_config_to_verified_deployment(file, "deploy1");
        if string_length(result) > 0 then 1 else 0 end
    });
    let suite = test_suite_add(suite, r2);

    test_suite_run(suite)
}

// ═══════════════════════════════════════════════════════════════════════════════
// BRIDGE TEST RUNNER
// ═══════════════════════════════════════════════════════════════════════════════

pub fn run_all_bridge_tests() -> String {
    let runner = test_runner_create();

    let r1 = test_runner_register(runner, test_titan_sylva_bridges());
    let r1 = test_runner_register(r1, test_sylva_aether_bridges());
    let r1 = test_runner_register(r1, test_aether_axiom_bridges());
    let r1 = test_runner_register(r1, test_titan_aether_bridges());
    let r1 = test_runner_register(r1, test_titan_axiom_bridges());
    let r1 = test_runner_register(r1, test_sylva_axiom_bridges());
    let r1 = test_runner_register(r1, test_complete_workflows());

    test_runner_run(r1)
}

