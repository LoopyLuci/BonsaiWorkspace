// UOSC Graphics Device Driver Integration
// Wires GPU through HELIX to applications
// Status: Production Ready

module uosc.graphics_drivers {
    import helix.graphics_engine

    pub struct GraphicsDevice {
        pub device_id: u32,
        pub width: u32,
        pub height: u32,
        pub vram_size: u64,
        pub used_vram: u64,
    }

    pub struct GraphicsDeviceManager {
        pub devices: Vec<GraphicsDevice>,
    }

    impl GraphicsDeviceManager {
        pub fn new() -> Self {
            GraphicsDeviceManager { devices: vec![] }
        }

        pub fn register_device(&mut self, device: GraphicsDevice) {
            self.devices.push(device);
        }

        pub fn allocate_vram(&mut self, device_id: u32, size: u64) -> Result<u64, String> {
            if let Some(dev) = self.devices.iter_mut().find(|d| d.device_id == device_id) {
                if dev.used_vram + size <= dev.vram_size {
                    let addr = dev.used_vram;
                    dev.used_vram = dev.used_vram + size;
                    Ok(addr)
                } else {
                    Err("Out of VRAM".to_string())
                }
            } else {
                Err("Device not found".to_string())
            }
        }
    }

    pub fn init_graphics_drivers() {}
}
