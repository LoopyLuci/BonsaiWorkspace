        IN NO EVENT SHALL OMNISYSTEM BE LIABLE FOR INDIRECT, INCIDENTAL, \
        OR CONSEQUENTIAL DAMAGES.\n\n\
        For the complete license agreement, visit: https://omnisystem.dev/license".to_string()
    }

    fn get_installation_log(&self) -> String {
        let mut log = String::new();
        for file in &self.installed_files {
            log.push_str(&format!("[✓] Installed: {}\n", file));
        }
        log
    }

    fn calculate_total_space(&self) -> String {
        let total: u32 = self.selected_components.iter().map(|c| c.size_mb).sum();
        format!("{} MB", total)
    }

    fn calculate_space_mb(&self) -> u32 {
        self.selected_components.iter().map(|c| c.size_mb).sum()
    }

    fn get_default_install_path() -> PathBuf {
        #[cfg(target_os = "windows")]
        {
            PathBuf::from("C:\\Program Files\\Omnisystem")
        }

        #[cfg(target_os = "macos")]
        {
            PathBuf::from("/Applications/Omnisystem")
        }

        #[cfg(target_os = "linux")]
        {
            PathBuf::from("/opt/omnisystem")
        }
    }

    fn get_default_components() -> Vec<Component> {
        vec![
            Component { name: "Core System".to_string(), size_mb: 50, required: true },
            Component { name: "Desktop Environment".to_string(), size_mb: 120, required: true },
            Component { name: "Documentation".to_string(), size_mb: 45, required: true },
            Component { name: "System Integration".to_string(), size_mb: 25, required: true },
        ]
    }

    #[cfg(target_os = "windows")]
    fn detect_platform() -> Platform {
        Platform::Windows
    }

    #[cfg(target_os = "macos")]
    fn detect_platform() -> Platform {
        Platform::MacOS
    }

    #[cfg(target_os = "linux")]
    fn detect_platform() -> Platform {
        Platform::Linux
    }

    fn get_os_version() -> String {
        #[cfg(target_os = "windows")]
        {
            "Windows 10 / 11".to_string()
        }

        #[cfg(target_os = "macos")]
        {
            "macOS 10.15+".to_string()
        }

        #[cfg(target_os = "linux")]
        {
            "Linux (Various)".to_string()
        }
    }

    fn get_available_disk_space() -> u64 {
        // Placeholder - in real implementation would query filesystem
        500 * 1024 * 1024 // 500 MB
    }

    // ============================================================================
    // INSTALLATION LOGIC
    // ============================================================================

    pub fn perform_installation(&mut self) -> Result<(), String> {
        self.current_step = InstallerStep::Installing;

        // Step 1: Create installation directory
        self.progress = 0.1;
        fs::create_dir_all(&self.installation_path)
            .map_err(|e| format!("Failed to create directory: {}", e))?;

        // Step 2: Copy core system files
        self.progress = 0.25;
        self.copy_component_files("core")?;

        // Step 3: Copy desktop environment
        self.progress = 0.45;
        self.copy_component_files("desktop")?;

        // Step 4: Create platform-specific shortcuts and integrations
        self.progress = 0.65;
        self.create_platform_integration()?;

        // Step 5: Update registry/system files (platform-specific)
        self.progress = 0.85;
        self.register_with_system()?;

        // Step 6: Verify installation
        self.progress = 0.95;
        self.verify_installation()?;

        self.progress = 1.0;
        self.current_step = InstallerStep::Complete;

        Ok(())
    }

    fn copy_component_files(&mut self, component: &str) -> Result<(), String> {
        // Copy files for the specified component
        // In a real implementation, this would copy from embedded resources or source
        self.installed_files.push(format!("{}/bin/omnisystem.exe", self.installation_path.display()));
        self.installed_files.push(format!("{}/lib/core.dll", self.installation_path.display()));
        Ok(())
    }

    fn create_platform_integration(&mut self) -> Result<(), String> {
        match self.platform {
            Platform::Windows => self.create_windows_integration(),
            Platform::MacOS => self.create_macos_integration(),
            Platform::Linux => self.create_linux_integration(),
        }
    }

    #[cfg(target_os = "windows")]
    fn create_windows_integration(&mut self) -> Result<(), String> {
        // Create Windows shortcuts and registry entries
        // This would use Windows API calls to create Start Menu shortcuts
        // and add registry keys for file associations
        self.installed_files.push("Windows shortcuts created".to_string());
        self.installed_files.push("Registry entries updated".to_string());
        Ok(())
    }

    #[cfg(not(target_os = "windows"))]
    fn create_windows_integration(&mut self) -> Result<(), String> {
        Ok(())
    }

    #[cfg(target_os = "macos")]
    fn create_macos_integration(&mut self) -> Result<(), String> {
        // Create macOS LaunchServices integration and plist files
        self.installed_files.push("LaunchServices registered".to_string());
        self.installed_files.push("Application bundle created".to_string());
        Ok(())
    }

    #[cfg(not(target_os = "macos"))]
    fn create_macos_integration(&mut self) -> Result<(), String> {
        Ok(())
    }

    #[cfg(target_os = "linux")]
    fn create_linux_integration(&mut self) -> Result<(), String> {
        // Create Linux .desktop files and system integration
        self.installed_files.push(".desktop file created".to_string());
        self.installed_files.push("freedesktop.org registration completed".to_string());
        Ok(())
    }

    #[cfg(not(target_os = "linux"))]
    fn create_linux_integration(&mut self) -> Result<(), String> {
        Ok(())
    }

    fn register_with_system(&mut self) -> Result<(), String> {
        // Platform-specific system registration
        match self.platform {
            Platform::Windows => {
                // Add to Programs and Features
                self.installed_files.push("Added to Control Panel".to_string());
            }
            Platform::MacOS => {
                // Register in Applications folder
                self.installed_files.push("Registered in Applications".to_string());
            }
            Platform::Linux => {
                // Register with package manager
                self.installed_files.push("System integration completed".to_string());
            }
        }
        Ok(())
    }

    fn verify_installation(&mut self) -> Result<(), String> {
        // Verify that all necessary files are in place
        let exe_path = self.installation_path.join("bin/omnisystem.exe");
        if !exe_path.exists() {
            return Err("Installation verification failed".to_string());
        }
        self.installed_files.push("Installation verification completed".to_string());
        Ok(())
    }
}

// ============================================================================
// DATA STRUCTURES
// ============================================================================

#[derive(Clone, Copy, Debug)]
pub enum InstallerStep {
    Welcome,
    License,
    Components,
    Destination,
    Options,
    Ready,
    Installing,
    Complete,
}

#[derive(Clone, Copy, Debug)]
pub enum Platform {
    Windows,
    MacOS,
    Linux,
}

impl Platform {
    fn name(&self) -> &str {
        match self {
            Platform::Windows => "Windows 10/11 64-bit",
            Platform::MacOS => "macOS 10.15+",
            Platform::Linux => "Linux (Various Distributions)",
        }
    }
}

#[derive(Clone, Debug)]
pub struct Component {
    name: String,
    size_mb: u32,
    required: bool,
}

// Global installer state
pub static INSTALLER_STATE: LazyStatic<Mutex<OmnisystemInstaller>> =
    LazyStatic::new(|| {
        Mutex::new(OmnisystemInstaller::new(AssetManager::global()))
    });
