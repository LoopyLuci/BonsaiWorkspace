    // Test System Info
    println!("\n--- System Info ---");
    let info = sdk.get_system_info();
    for (key, value) in info {
        println!("  {}: {}", key, value);
    }

    sdk.print_status();

    println!("✓✓✓ Omnisystem SDK ready for app development ✓✓✓");
    Ok(())
}
