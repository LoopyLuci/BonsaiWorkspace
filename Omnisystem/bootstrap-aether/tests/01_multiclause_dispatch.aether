// @ expect-stdout: 120
// @ expect-stdout: good morning
// @ expect-stdout: good evening
// @ expect-stdout: hello stranger
def fact(0) do
  1
end

def fact(n) do
  n * fact(n - 1)
end

def greet(:morning) do
  "good morning"
end

def greet(:evening) do
  "good evening"
end

def greet(other) do
  "hello #{other}"
end

puts(fact(5))
puts(greet(:morning))
puts(greet(:evening))
puts(greet("stranger"))
