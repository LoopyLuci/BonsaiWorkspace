// @ expect-stdout: 20
// @ expect-stdout: neg
// @ expect-stdout: Aether
// @ expect-stdout: 15
def double(n) do
  n * 2
end

def classify(n) when n > 0 do
  :positive
end

def classify(n) when n < 0 do
  :negative
end

def classify(0) do
  :zero
end

result = 5 |> double() |> double()
puts(result)

x = -3
label = case classify(x) do
  :positive -> "pos"
  :negative -> "neg"
  :zero -> "zero"
end
puts(label)

m = %{name: "Aether", year: 2026}
puts(m[:name])

total = 0
for n in [1, 2, 3, 4, 5] do
  total = total + n
end
puts(total)
