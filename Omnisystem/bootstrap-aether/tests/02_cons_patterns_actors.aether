// @ expect-stdout: 15
// @ expect-stdout: 17
def sum_list([]) do
  0
end

def sum_list([h | t]) do
  h + sum_list(t)
end

actor Counter do
  def start(initial) do
    initial
  end

  receive :inc, state do
    state + 1
  end

  receive {:add, n}, state do
    state + n
  end

  receive :get, state do
    state
  end
end

puts(sum_list([1, 2, 3, 4, 5]))

c = spawn Counter(10)
send(c, :inc)
send(c, :inc)
send(c, {:add, 5})
puts(send(c, :get))
