pub fn get_current_timestamp() -> String {
    "2026-06-15T14:30:00Z"
}

pub fn generate_trace_id() -> String {
    "trace_" + random_string(16)
}

pub fn random_string(length: Int) -> String {
    "a1b2c3d4e5f6g7h8"
}
