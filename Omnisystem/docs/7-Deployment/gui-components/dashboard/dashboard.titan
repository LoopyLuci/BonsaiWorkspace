// OMNISYSTEM GUI - DASHBOARD MODULE (PHASE 2)
// Main platform dashboard and home screen
// Location: gui/modules/dashboard/dashboard.titan
// 2026-06-15

pub struct DashboardWidget {
    title: String
    content: String
    size: String
    refreshable: Bool
    lastUpdated: Int
}

pub struct DashboardMetric {
    label: String
    value: String
    trend: String
    trendPercent: Float
    icon: String
}

pub class Dashboard {
    title: String
    widgets: Array[DashboardWidget]
    metrics: Array[DashboardMetric]
    recentActivity: Array[Object]
    userGreeting: String
    theme: String

    pub fn new() -> Self {
        Dashboard {
            title: "Omnisystem Dashboard",
            widgets: Array::new(),
            metrics: Array::new(),
            recentActivity: Array::new(),
            userGreeting: "Welcome back!",
            theme: "light"
        }
    }

    pub fn render(self: Self) -> String {
        let mut html = "<div class=\"dashboard\">"

        // Header
        html = html + "<div class=\"dashboard-header\" style=\"padding: 24px; background: linear-gradient(135deg, #2563EB 0%, #7C3AED 100%);\">"
        html = html + "<h1 style=\"color: white; margin: 0; font-size: 28px;\">" + self.userGreeting + "</h1>"
        html = html + "<p style=\"color: rgba(255,255,255,0.8); margin: 8px 0 0 0;\">Here's what's happening with your system today.</p>"
        html = html + "</div>"

        // Metrics Row
        if !self.metrics.is_empty() {
            html = html + "<div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 16px; padding: 24px;\">"

            for metric in self.metrics {
                html = html + self.render_metric(metric)
            }

            html = html + "</div>"
        }

        // Widgets Grid
        if !self.widgets.is_empty() {
            html = html + "<div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px; padding: 0 24px 24px;\">"

            for widget in self.widgets {
                html = html + self.render_widget(widget)
            }

            html = html + "</div>"
        }

        // Recent Activity
        if !self.recentActivity.is_empty() {
            html = html + "<div style=\"padding: 24px;\">"
            html = html + "<h2 style=\"margin-top: 0; font-size: 18px;\">Recent Activity</h2>"
            html = html + "<div style=\"border: 1px solid #E5E7EB; border-radius: 8px; overflow: hidden;\">"

            for activity in self.recentActivity {
                html = html + "<div style=\"padding: 12px; border-bottom: 1px solid #E5E7EB; display: flex; justify-content: space-between;\">"
                html = html + "<span>" + activity["action"] + "</span>"
                html = html + "<span style=\"color: #6B7280; font-size: 0.875rem;\">" + activity["timestamp"] + "</span>"
                html = html + "</div>"
            }

            html = html + "</div>"
            html = html + "</div>"
        }

        html = html + "</div>"
        html
    }

    fn render_metric(self: Self, metric: DashboardMetric) -> String {
        let mut trendColor = "#10B981"
        if metric.trend == "down" {
            trendColor = "#EF4444"
        }

        let mut html = "<div style=\"background: white; border: 1px solid #E5E7EB; border-radius: 8px; padding: 16px;\">"

        if !metric.icon.is_empty() {
            html = html + "<i class=\"metric-icon icon-" + metric.icon + "\" style=\"font-size: 24px; color: #2563EB;\"></i>"
        }

        html = html + "<p style=\"color: #6B7280; margin: 8px 0 0 0; font-size: 0.875rem;\">" + metric.label + "</p>"
        html = html + "<h3 style=\"margin: 8px 0; font-size: 24px;\">" + metric.value + "</h3>"

        if metric.trendPercent != 0.0 {
            let trendStr = metric.trendPercent.to_string()
            html = html + "<p style=\"color: " + trendColor + "; margin: 0; font-size: 0.875rem;\">" + metric.trend + " " + trendStr + "%</p>"
        }

        html = html + "</div>"
        html
    }

    fn render_widget(self: Self, widget: DashboardWidget) -> String {
        let mut html = "<div style=\"background: white; border: 1px solid #E5E7EB; border-radius: 8px; overflow: hidden;\">"

        html = html + "<div style=\"padding: 16px; border-bottom: 1px solid #E5E7EB; display: flex; justify-content: space-between; align-items: center;\">"
        html = html + "<h3 style=\"margin: 0; font-size: 16px;\">" + widget.title + "</h3>"

        if widget.refreshable {
            html = html + "<button style=\"background: none; border: none; cursor: pointer; font-size: 18px;\">↻</button>"
        }

        html = html + "</div>"

        html = html + "<div style=\"padding: 16px;\">" + widget.content + "</div>"

        if widget.lastUpdated > 0 {
            let timestamp = widget.lastUpdated.to_string()
            html = html + "<div style=\"padding: 0 16px 16px; color: #6B7280; font-size: 0.75rem;\">Updated: " + timestamp + "</div>"
        }

        html = html + "</div>"
        html
    }

    pub fn add_widget(mut self: Self, widget: DashboardWidget) -> Self {
        self.widgets.push(widget)
        self
    }

    pub fn add_metric(mut self: Self, metric: DashboardMetric) -> Self {
        self.metrics.push(metric)
        self
    }

    pub fn add_activity(mut self: Self, activity: Object) -> Self {
        self.recentActivity.push(activity)
        self
    }

    pub fn set_greeting(mut self: Self, greeting: String) -> Self {
        self.userGreeting = greeting
        self
    }
}

pub fn create_default_dashboard() -> Dashboard {
    let mut dashboard = Dashboard::new()

    // Add metrics
    dashboard.add_metric(DashboardMetric {
        label: "Active Systems",
        value: "8/8",
        trend: "up",
        trendPercent: 0.0,
        icon: "check"
    })

    dashboard.add_metric(DashboardMetric {
        label: "Total Components",
        value: "2,250+",
        trend: "up",
        trendPercent: 15.0,
        icon: "layers"
    })

    dashboard.add_metric(DashboardMetric {
        label: "Build Status",
        value: "Passing",
        trend: "",
        trendPercent: 0.0,
        icon: "check"
    })

    dashboard.add_metric(DashboardMetric {
        label: "Performance",
        value: "98/100",
        trend: "up",
        trendPercent: 5.0,
        icon: "speed"
    })

    // Add widgets
    dashboard.add_widget(DashboardWidget {
        title: "System Status",
        content: "All systems operational",
        size: "medium",
        refreshable: true,
        lastUpdated: 0
    })

    dashboard.add_widget(DashboardWidget {
        title: "Quick Access",
        content: "Launch TITAN IDE | Launch SYLVA IDE | Launch AETHER IDE | Launch AXIOM IDE",
        size: "medium",
        refreshable: false,
        lastUpdated: 0
    })

    dashboard.add_widget(DashboardWidget {
        title: "Build Progress",
        content: "Phase 1 Foundation: 100% Complete | Phase 2 Modules: 0% | Phase 3-5: Ready",
        size: "medium",
        refreshable: false,
        lastUpdated: 0
    })

    // Add recent activity
    dashboard.add_activity(Object::from_pairs([("action", "Completed Phase 1 Foundation"), ("timestamp", "Today 10:32 AM")]))
    dashboard.add_activity(Object::from_pairs([("action", "Started Phase 2 Module Build"), ("timestamp", "Today 10:25 AM")]))
    dashboard.add_activity(Object::from_pairs([("action", "Asset Engine Created"), ("timestamp", "Today 9:45 AM")]))
    dashboard.add_activity(Object::from_pairs([("action", "Theme System Deployed"), ("timestamp", "Today 9:30 AM")]))

    dashboard
}
