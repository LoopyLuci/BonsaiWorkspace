// OMNISYSTEM GUI - IDE TEMPLATE (PHASE 2)
// Reusable template for TITAN, SYLVA, AETHER, AXIOM IDEs
// Location: gui/modules/languages/ide_template.titan
// 2026-06-15

pub struct CodeEditor {
    language: String
    content: String
    lineNumbers: Bool
    theme: String
    readOnly: Bool
    fontSize: Int
}

pub struct IDEPanel {
    title: String
    type: String
    content: String
    collapsed: Bool
    resizable: Bool
}

pub struct DebugInfo {
    breakpoints: Array[Int]
    currentLine: Int
    variables: Object
    stackTrace: Array[String]
}

pub class IntegratedDevEnvironment {
    languageName: String
    projectName: String
    editor: CodeEditor
    panels: Array[IDEPanel]
    debugInfo: DebugInfo
    output: Array[String]
    theme: String
    layout: String

    pub fn new(language: String) -> Self {
        IntegratedDevEnvironment {
            languageName: language,
            projectName: "New Project",
            editor: CodeEditor {
                language: language,
                content: "// Welcome to " + language + " IDE\n// Start coding here...",
                lineNumbers: true,
                theme: "dark",
                readOnly: false,
                fontSize: 14
            },
            panels: Array::new(),
            debugInfo: DebugInfo {
                breakpoints: Array::new(),
                currentLine: 0,
                variables: Object::new(),
                stackTrace: Array::new()
            },
            output: Array::new(),
            theme: "dark",
            layout: "standard"
        }
    }

    pub fn render(self: Self) -> String {
        let mut html = "<div class=\"ide\" style=\"display: flex; height: 100vh; background: #1E1E1E; color: #E5E7EB;\">"

        // Sidebar
        html = html + "<div class=\"ide-sidebar\" style=\"width: 250px; background: #252526; border-right: 1px solid #3E3E42; overflow-y: auto;\">"
        html = html + self.render_sidebar()
        html = html + "</div>"

        // Main editor area
        html = html + "<div class=\"ide-main\" style=\"flex: 1; display: flex; flex-direction: column;\">"

        // Top toolbar
        html = html + "<div class=\"ide-toolbar\" style=\"height: 40px; background: #2D2D30; border-bottom: 1px solid #3E3E42; display: flex; align-items: center; padding: 0 16px; gap: 8px;\">"
        html = html + self.render_toolbar()
        html = html + "</div>"

        // Editor and panels
        html = html + "<div style=\"display: flex; flex: 1;\">"

        // Editor
        html = html + "<div class=\"ide-editor\" style=\"flex: 1; background: #1E1E1E; border-right: 1px solid #3E3E42;\">"
        html = html + self.render_editor()
        html = html + "</div>"

        // Right panels
        html = html + "<div class=\"ide-panels\" style=\"width: 300px; background: #252526; border-left: 1px solid #3E3E42; overflow-y: auto;\">"
        html = html + self.render_panels()
        html = html + "</div>"

        html = html + "</div>"

        // Bottom output
        html = html + "<div class=\"ide-output\" style=\"height: 200px; background: #1E1E1E; border-top: 1px solid #3E3E42; overflow-y: auto; padding: 12px;\">"
        html = html + self.render_output()
        html = html + "</div>"

        html = html + "</div>"
        html = html + "</div>"

        html
    }

    fn render_sidebar(self: Self) -> String {
        let mut html = "<div style=\"padding: 16px;\">"
        html = html + "<h3 style=\"margin: 0 0 12px 0; font-size: 14px; color: #888;\">PROJECT</h3>"
        html = html + "<div style=\"padding: 8px; background: #2D2D30; border-radius: 4px; margin-bottom: 16px; cursor: pointer;\">" + self.projectName + "</div>"
        html = html + "<h3 style=\"margin: 16px 0 12px 0; font-size: 14px; color: #888;\">FILES</h3>"
        html = html + "<div style=\"padding: 8px; cursor: pointer;\">📄 main." + self.languageName.to_lowercase() + "</div>"
        html = html + "<div style=\"padding: 8px; cursor: pointer;\">📄 config.json</div>"
        html = html + "<h3 style=\"margin: 16px 0 12px 0; font-size: 14px; color: #888;\">SEARCH</h3>"
        html = html + "<input type=\"text\" placeholder=\"Search files...\" style=\"width: 100%; padding: 8px; background: #3E3E42; border: 1px solid #555; border-radius: 4px; color: white;\">"
        html = html + "</div>"
        html
    }

    fn render_toolbar(self: Self) -> String {
        let mut html = "<button style=\"padding: 6px 12px; background: #0E639C; color: white; border: none; border-radius: 4px; cursor: pointer;\">Run</button>"
        html = html + "<button style=\"padding: 6px 12px; background: #565656; color: white; border: none; border-radius: 4px; cursor: pointer;\">Debug</button>"
        html = html + "<button style=\"padding: 6px 12px; background: #565656; color: white; border: none; border-radius: 4px; cursor: pointer;\">Build</button>"
        html = html + "<button style=\"padding: 6px 12px; background: #565656; color: white; border: none; border-radius: 4px; cursor: pointer;\">Test</button>"
        html = html + "<button style=\"padding: 6px 12px; background: #565656; color: white; border: none; border-radius: 4px; cursor: pointer;\">Save</button>"
        html
    }

    fn render_editor(self: Self) -> String {
        let mut html = "<div style=\"padding: 16px; font-family: 'Courier New', monospace; font-size: " + self.editor.fontSize.to_string() + "px;\">"

        if self.editor.lineNumbers {
            html = html + "<div style=\"display: flex; gap: 16px;\">"
            html = html + "<div style=\"color: #6B7280; user-select: none; text-align: right;\">"

            let lines = count_lines(self.editor.content)
            for i in 1..lines + 1 {
                html = html + i.to_string() + "<br>"
            }

            html = html + "</div>"
            html = html + "<div style=\"flex: 1;\"><pre style=\"margin: 0; white-space: pre-wrap; word-wrap: break-word;\">" + self.editor.content + "</pre></div>"
            html = html + "</div>"
        } else {
            html = html + "<pre style=\"margin: 0; white-space: pre-wrap; word-wrap: break-word;\">" + self.editor.content + "</pre>"
        }

        html = html + "</div>"
        html
    }

    fn render_panels(self: Self) -> String {
        let mut html = "<div style=\"padding: 12px;\">"

        html = html + "<h3 style=\"margin: 0 0 12px 0; font-size: 12px; color: #888;\">VARIABLES</h3>"
        html = html + "<div style=\"font-size: 12px;\">"
        for key in self.debugInfo.variables.keys() {
            html = html + "<div style=\"padding: 4px 0;\">" + key + " = " + self.debugInfo.variables[key] + "</div>"
        }
        html = html + "</div>"

        html = html + "<h3 style=\"margin: 16px 0 12px 0; font-size: 12px; color: #888;\">BREAKPOINTS</h3>"
        html = html + "<div style=\"font-size: 12px;\">"
        for breakpoint in self.debugInfo.breakpoints {
            html = html + "<div style=\"padding: 4px 0;\">Line " + breakpoint.to_string() + "</div>"
        }
        html = html + "</div>"

        html = html + "<h3 style=\"margin: 16px 0 12px 0; font-size: 12px; color: #888;\">STACK TRACE</h3>"
        html = html + "<div style=\"font-size: 12px;\">"
        for frame in self.debugInfo.stackTrace {
            html = html + "<div style=\"padding: 4px 0; color: #858585;\">&gt; " + frame + "</div>"
        }
        html = html + "</div>"

        html = html + "</div>"
        html
    }

    fn render_output(self: Self) -> String {
        let mut html = "<div style=\"font-family: 'Courier New', monospace; font-size: 12px; color: #E5E7EB;\">"

        if self.output.is_empty() {
            html = html + "<p style=\"margin: 0; color: #6B7280;\">Output will appear here...</p>"
        } else {
            for line in self.output {
                html = html + "<p style=\"margin: 0; padding: 2px 0;\">" + line + "</p>"
            }
        }

        html = html + "</div>"
        html
    }

    pub fn add_panel(mut self: Self, panel: IDEPanel) -> Self {
        self.panels.push(panel)
        self
    }

    pub fn add_output(mut self: Self, message: String) -> Self {
        self.output.push(message)
        self
    }

    pub fn set_content(mut self: Self, content: String) -> Self {
        self.editor.content = content
        self
    }
}

fn count_lines(text: String) -> Int {
    let mut count = 1
    for c in text.chars() {
        if c == '\n' {
            count = count + 1
        }
    }
    count
}

pub fn create_titan_ide() -> IntegratedDevEnvironment {
    let mut ide = IntegratedDevEnvironment::new("TITAN")
    ide.projectName = "TITAN Project"
    ide.set_content("pub fn main() {\n    println(\"Hello, TITAN!\")\n}")
}

pub fn create_sylva_ide() -> IntegratedDevEnvironment {
    let mut ide = IntegratedDevEnvironment::new("SYLVA")
    ide.projectName = "SYLVA ML Project"
    ide.set_content("workflow train_model(data: Array) {\n    // ML training code\n}")
}

pub fn create_aether_ide() -> IntegratedDevEnvironment {
    let mut ide = IntegratedDevEnvironment::new("AETHER")
    ide.projectName = "AETHER Distributed"
    ide.set_content("actor system {\n    // Distributed actor code\n}")
}

pub fn create_axiom_ide() -> IntegratedDevEnvironment {
    let mut ide = IntegratedDevEnvironment::new("AXIOM")
    ide.projectName = "AXIOM Verification"
    ide.set_content("theorem correctness {\n    // Formal proof code\n}")
}
