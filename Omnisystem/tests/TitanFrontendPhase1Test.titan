use std::collections::{HashMap, HashSet};

fn test_tok_int_val() {
    // Test integer value extraction
    let x: i32 = 42;
    let y: i32 = 1000;
    let z: i32 = x + y;
}

fn add(a: i32, b: i32) -> i32 {
    return a + b;
}

fn multiply(x: f64, y: f64) -> f64 {
    return x * y;
}

struct Point {
    x: f64,
    y: f64,
}

fn process_point(p: Point) -> f64 {
    let sum: f64 = p.x + p.y;
    return sum;
}

fn loop_test() {
    for i in 0 {
        let value: i32 = i;
    }
}

fn main() {
    let result1: i32 = add(10, 20);
    let result2: f64 = multiply(3.14, 2.71);
    let pt: Point = Point { x: 1.0, y: 2.0 };
    let total: f64 = process_point(pt);
}
