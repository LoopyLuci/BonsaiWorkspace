// Routes.aether — Async Route Handlers as Actors
// Omnisystem Showcase Application · Web Server App
// Language: AETHER · ~1500 LOC

use omnisystem::{String, Vec, HashMap, Option, Result, u32, u64, f64}

// ============================================================================
// USER DOMAIN
// ============================================================================

struct User {
    id: u32,
    name: String,
    email: String,
    created_at: u64,
    role: String,
    active: bool,
}

impl User {
    fn to_json(&self) -> String {
        format!(r#"{{"id":{},"name":"{}","email":"{}","created_at":{},"role":"{}","active":{}}}"#,
            self.id, self.name, self.email, self.created_at, self.role, self.active)
    }

    fn validate(name: &str, email: &str) -> Result<(), String> {
        if name.trim().is_empty() {
            return Result::Err("Name cannot be empty".to_string())
        }
        if name.len() > 128 {
            return Result::Err("Name too long (max 128 chars)".to_string())
        }
        if !email.contains('@') || !email.contains('.') {
            return Result::Err("Invalid email address".to_string())
        }
        if email.len() > 256 {
            return Result::Err("Email too long (max 256 chars)".to_string())
        }
        Result::Ok(())
    }
}

// ============================================================================
// TASK QUEUE DOMAIN
// ============================================================================

struct Task {
    id: u64,
    kind: String,
    payload: String,
    status: String,
    created_at: u64,
    attempts: u32,
}

impl Task {
    fn new(id: u64, kind: String, payload: String) -> Self {
        Task {
            id,
            kind,
            payload,
            status: "pending".to_string(),
            created_at: id * 1000,  // synthetic timestamp
            attempts: 0,
        }
    }
}

// ============================================================================
// RATE LIMITER STATE
// ============================================================================

struct TokenBucket {
    tokens: f64,
    last_refill_ms: u64,
    rate_per_second: f64,
    capacity: f64,
}

impl TokenBucket {
    fn new(rate_per_second: f64, capacity: f64) -> Self {
        TokenBucket {
            tokens: capacity,
            last_refill_ms: 0,
            rate_per_second,
            capacity,
        }
    }

    fn try_consume(&mut self, now_ms: u64, count: f64) -> bool {
        // Refill tokens since last check
        let elapsed_s = (now_ms - self.last_refill_ms) as f64 / 1000.0
        self.tokens = (self.tokens + elapsed_s * self.rate_per_second).min(self.capacity)
        self.last_refill_ms = now_ms

        if self.tokens >= count {
            self.tokens -= count
            true
        } else {
            false
        }
    }
}

// ============================================================================
// METRICS STATE
// ============================================================================

struct RouteMetrics {
    path: String,
    request_count: u64,
    error_count: u64,
    total_duration_ms: u64,
    min_duration_ms: u64,
    max_duration_ms: u64,
}

impl RouteMetrics {
    fn new(path: String) -> Self {
        RouteMetrics {
            path,
            request_count: 0,
            error_count: 0,
            total_duration_ms: 0,
            min_duration_ms: 9999999,
            max_duration_ms: 0,
        }
    }

    fn record(&mut self, duration_ms: u64, is_error: bool) {
        self.request_count += 1
        self.total_duration_ms += duration_ms
        if duration_ms < self.min_duration_ms { self.min_duration_ms = duration_ms }
        if duration_ms > self.max_duration_ms { self.max_duration_ms = duration_ms }
        if is_error { self.error_count += 1 }
    }

    fn avg_duration_ms(&self) -> u64 {
        if self.request_count == 0 { 0 } else { self.total_duration_ms / self.request_count }
    }

    fn to_json(&self) -> String {
        format!(r#"{{"path":"{}","requests":{},"errors":{},"avg_ms":{},"min_ms":{},"max_ms":{}}}"#,
            self.path,
            self.request_count,
            self.error_count,
            self.avg_duration_ms(),
            self.min_duration_ms,
            self.max_duration_ms)
    }
}

// ============================================================================
// USER STORE ACTOR
// ============================================================================

actor UserStore {
    state {
        users: HashMap<u32, User>,
        next_id: u32,
    }

    init {
        // Seed with 10 sample users
        let sample_users = [
            ("Alice Chen",      "alice@example.com",   "admin"),
            ("Bob Martinez",    "bob@example.com",     "user"),
            ("Carol Johnson",   "carol@example.com",   "user"),
            ("David Kim",       "david@example.com",   "moderator"),
            ("Eve Williams",    "eve@example.com",     "user"),
            ("Frank Brown",     "frank@example.com",   "user"),
            ("Grace Davis",     "grace@example.com",   "admin"),
            ("Henry Wilson",    "henry@example.com",   "user"),
            ("Iris Thompson",   "iris@example.com",    "user"),
            ("Jack Anderson",   "jack@example.com",    "moderator"),
        ]
        for (i, (name, email, role)) in sample_users.iter().enumerate() {
            let id = i as u32 + 1
            state.users.insert(id, User {
                id,
                name: name.to_string(),
                email: email.to_string(),
                created_at: 1719532800 + id as u64 * 86400,
                role: role.to_string(),
                active: true,
            })
        }
        state.next_id = 11
    }

    handler list_users(page: u32, page_size: u32) -> String {
        let offset = (page * page_size) as usize
        let mut all: Vec<&User> = state.users.values().collect()
        all.sort_by_key(|u| u.id)
        let slice = all.iter().skip(offset).take(page_size as usize)
        let json_items: Vec<String> = slice.map(|u| u.to_json()).collect()
        let total = state.users.len()
        format!(r#"{{"users":[{}],"total":{},"page":{},"page_size":{}}}"#,
            json_items.join(","), total, page, page_size)
    }

    handler get_user(id: u32) -> Option<String> {
        state.users.get(&id).map(|u| u.to_json())
    }

    handler create_user(name: String, email: String, role: String) -> Result<String, String> {
        // Check for duplicate email
        let exists = state.users.values().any(|u| u.email == email)
        if exists {
            return Result::Err(format!("Email '{}' already registered", email))
        }

        let id = state.next_id
        state.next_id += 1
        let user = User {
            id,
            name: name.clone(),
            email: email.clone(),
            created_at: 1719532800 + id as u64 * 1000,
            role,
            active: true,
        }
        let json = user.to_json()
        state.users.insert(id, user)
        Result::Ok(json)
    }

    handler update_user(id: u32, name: Option<String>, email: Option<String>) -> Option<String> {
        match state.users.get_mut(&id) {
            Option::Some(user) => {
                if let Option::Some(n) = name { user.name = n }
                if let Option::Some(e) = email { user.email = e }
                Option::Some(user.to_json())
            }
            Option::None => Option::None,
        }
    }

    handler delete_user(id: u32) -> bool {
        state.users.remove(&id).is_some()
    }

    handler count() -> u32 {
        state.users.len() as u32
    }
}

// ============================================================================
// AUTH MIDDLEWARE ACTOR
// ============================================================================

actor AuthMiddleware {
    state {
        valid_tokens: Vec<String>,
        token_to_user: HashMap<String, u32>,
        public_routes: Vec<String>,
    }

    init {
        // Demo API tokens
        state.valid_tokens = vec![
            "omnitoken-admin-abc123".to_string(),
            "omnitoken-user-def456".to_string(),
            "omnitoken-mod-ghi789".to_string(),
        ]
        state.token_to_user.insert("omnitoken-admin-abc123".to_string(), 1)
        state.token_to_user.insert("omnitoken-user-def456".to_string(), 2)
        state.token_to_user.insert("omnitoken-mod-ghi789".to_string(), 4)
        state.public_routes = vec![
            "/health".to_string(),
            "/metrics".to_string(),
            "/".to_string(),
        ]
    }

    handler check_request(path: String, auth_header: Option<String>) -> Result<u32, String> {
        // Public routes bypass auth
        if state.public_routes.iter().any(|p| p == &path) {
            return Result::Ok(0)  // user_id=0 means anonymous
        }

        match auth_header {
            Option::None => Result::Err("Missing Authorization header".to_string()),
            Option::Some(header) => {
                if !header.starts_with("Bearer ") {
                    return Result::Err("Authorization must use Bearer scheme".to_string())
                }
                let token = header[7..].trim()
                if state.valid_tokens.iter().any(|t| t == token) {
                    let user_id = state.token_to_user.get(token).cloned().unwrap_or(0)
                    Result::Ok(user_id)
                } else {
                    Result::Err(format!("Invalid or expired token: {}", &token[..token.len().min(8)]))
                }
            }
        }
    }

    handler register_token(token: String, user_id: u32) {
        state.valid_tokens.push(token.clone())
        state.token_to_user.insert(token, user_id)
    }

    handler revoke_token(token: String) {
        state.valid_tokens.retain(|t| t != &token)
        state.token_to_user.remove(&token)
    }

    handler list_public_routes() -> Vec<String> {
        state.public_routes.clone()
    }
}

// ============================================================================
// RATE LIMITER ACTOR
// ============================================================================

actor RateLimiter {
    state {
        buckets: HashMap<String, TokenBucket>,
        default_rate: f64,
        default_capacity: f64,
        blocked_ips: Vec<String>,
    }

    init {
        state.default_rate = 10.0      // 10 requests per second
        state.default_capacity = 20.0  // burst up to 20
        state.buckets = HashMap::new()
        state.blocked_ips = Vec::new()
    }

    handler check_ip(ip: String, now_ms: u64) -> Result<(), String> {
        if state.blocked_ips.iter().any(|b| b == &ip) {
            return Result::Err(format!("IP {} is permanently blocked", ip))
        }

        let rate = state.default_rate
        let capacity = state.default_capacity
        let bucket = state.buckets.entry(ip.clone()).or_insert_with(|| {
            TokenBucket::new(rate, capacity)
        })

        if bucket.try_consume(now_ms, 1.0) {
            Result::Ok(())
        } else {
            Result::Err(format!("Rate limit exceeded for IP {}: {:.1} tokens remaining", ip, bucket.tokens))
        }
    }

    handler block_ip(ip: String) {
        if !state.blocked_ips.iter().any(|b| b == &ip) {
            state.blocked_ips.push(ip)
        }
    }

    handler unblock_ip(ip: String) {
        state.blocked_ips.retain(|b| b != &ip)
    }

    handler set_rate_for_ip(ip: String, rate: f64, capacity: f64) {
        state.buckets.insert(ip, TokenBucket::new(rate, capacity))
    }

    handler active_bucket_count() -> u32 {
        state.buckets.len() as u32
    }

    handler cleanup_stale_buckets(now_ms: u64, stale_threshold_ms: u64) -> u32 {
        let before = state.buckets.len()
        state.buckets.retain(|_, b| now_ms - b.last_refill_ms < stale_threshold_ms)
        (before - state.buckets.len()) as u32
    }
}

// ============================================================================
// WEBSOCKET HANDLER ACTOR
// ============================================================================

struct WsClient {
    id: u64,
    path: String,
    connected_at: u64,
    messages_received: u64,
    messages_sent: u64,
}

actor WebSocketHandler {
    state {
        clients: HashMap<u64, WsClient>,
        next_client_id: u64,
        message_history: Vec<String>,
        max_history: usize,
    }

    init {
        state.clients = HashMap::new()
        state.next_client_id = 1
        state.message_history = Vec::new()
        state.max_history = 100
    }

    handler upgrade_connection(path: String, now_ms: u64) -> u64 {
        let id = state.next_client_id
        state.next_client_id += 1
        state.clients.insert(id, WsClient {
            id,
            path,
            connected_at: now_ms,
            messages_received: 0,
            messages_sent: 0,
        })
        println!("[WS] Client {} connected. Total clients: {}", id, state.clients.len())
        id
    }

    handler receive_message(client_id: u64, message: String) -> Vec<String> {
        // Update client stats
        if let Option::Some(client) = state.clients.get_mut(&client_id) {
            client.messages_received += 1
        }

        // Store in history
        if state.message_history.len() >= state.max_history {
            state.message_history.remove(0)
        }
        let tagged = format!("[Client {}] {}", client_id, message)
        state.message_history.push(tagged.clone())

        // Broadcast to all other clients — return list of (client_id, message) to send
        let broadcast_msg = format!(r#"{{"type":"message","from":{},"text":"{}"}}"#, client_id, message)
        let mut to_send = Vec::new()
        for (&cid, client) in &mut state.clients {
            if cid != client_id {
                client.messages_sent += 1
                to_send.push(format!("{}:{}", cid, broadcast_msg))
            }
        }
        // Echo back to sender
        to_send.push(format!("{}:{}", client_id, format!(r#"{{"type":"echo","text":"{}"}}"#, message)))
        to_send
    }

    handler disconnect(client_id: u64) {
        state.clients.remove(&client_id)
        println!("[WS] Client {} disconnected. Remaining: {}", client_id, state.clients.len())
    }

    handler broadcast_system_message(msg: String) -> u32 {
        let mut count = 0u32
        for (_, client) in &mut state.clients {
            client.messages_sent += 1
            count += 1
        }
        println!("[WS] System broadcast to {} clients: {}", count, msg)
        count
    }

    handler active_client_count() -> u32 {
        state.clients.len() as u32
    }

    handler get_history(last_n: usize) -> Vec<String> {
        let skip = if state.message_history.len() > last_n {
            state.message_history.len() - last_n
        } else {
            0
        }
        state.message_history[skip..].to_vec()
    }
}

// ============================================================================
// METRICS COLLECTOR ACTOR
// ============================================================================

actor MetricsCollector {
    state {
        route_metrics: HashMap<String, RouteMetrics>,
        total_requests: u64,
        start_time_ms: u64,
        status_code_counts: HashMap<u16, u64>,
    }

    init {
        state.route_metrics = HashMap::new()
        state.total_requests = 0
        state.start_time_ms = 0
        state.status_code_counts = HashMap::new()
    }

    handler record(path: String, duration_ms: u64, status: u16) {
        state.total_requests += 1
        let is_error = status >= 400
        let metrics = state.route_metrics.entry(path.clone()).or_insert_with(|| RouteMetrics::new(path))
        metrics.record(duration_ms, is_error)

        let count = state.status_code_counts.entry(status).or_insert(0)
        *count += 1
    }

    handler set_start_time(ms: u64) {
        state.start_time_ms = ms
    }

    handler get_summary(now_ms: u64) -> String {
        let uptime_s = if now_ms > state.start_time_ms {
            (now_ms - state.start_time_ms) / 1000
        } else { 1 }
        let rps = state.total_requests / uptime_s.max(1)

        let route_jsons: Vec<String> = state.route_metrics.values()
            .map(|m| m.to_json())
            .collect()

        let status_jsons: Vec<String> = state.status_code_counts.iter()
            .map(|(code, count)| format!(r#""{}":{}"#, code, count))
            .collect()

        format!(r#"{{"total_requests":{},"uptime_seconds":{},"requests_per_second":{},"routes":[{}],"status_codes":{{{}}}}}"#,
            state.total_requests,
            uptime_s,
            rps,
            route_jsons.join(","),
            status_jsons.join(","))
    }

    handler top_routes(n: usize) -> Vec<String> {
        let mut entries: Vec<(&String, &RouteMetrics)> = state.route_metrics.iter().collect()
        entries.sort_by(|a, b| b.1.request_count.cmp(&a.1.request_count))
        entries.iter().take(n).map(|(_, m)| m.to_json()).collect()
    }

    handler reset() {
        state.route_metrics.clear()
        state.total_requests = 0
        state.status_code_counts.clear()
    }
}

// ============================================================================
// BACKGROUND WORKER ACTOR
// ============================================================================

struct BackgroundTask {
    id: u64,
    kind: String,
    payload: String,
    scheduled_at: u64,
    completed: bool,
    result: Option<String>,
}

actor BackgroundWorker {
    state {
        task_queue: Vec<BackgroundTask>,
        completed_tasks: Vec<BackgroundTask>,
        next_task_id: u64,
        last_run_ms: u64,
        tasks_processed: u64,
    }

    init {
        state.task_queue = Vec::new()
        state.completed_tasks = Vec::new()
        state.next_task_id = 1
        state.last_run_ms = 0
        state.tasks_processed = 0
    }

    handler enqueue_email(to: String, subject: String, body: String, now_ms: u64) -> u64 {
        let id = state.next_task_id
        state.next_task_id += 1
        let payload = format!(r#"{{"to":"{}","subject":"{}","body":"{}"}}"#, to, subject, body)
        state.task_queue.push(BackgroundTask {
            id,
            kind: "email".to_string(),
            payload,
            scheduled_at: now_ms,
            completed: false,
            result: Option::None,
        })
        println!("[BG] Queued email task #{} to {}", id, to)
        id
    }

    handler enqueue_cache_invalidation(key_pattern: String, now_ms: u64) -> u64 {
        let id = state.next_task_id
        state.next_task_id += 1
        state.task_queue.push(BackgroundTask {
            id,
            kind: "cache_invalidate".to_string(),
            payload: key_pattern.clone(),
            scheduled_at: now_ms,
            completed: false,
            result: Option::None,
        })
        println!("[BG] Queued cache invalidation task #{} for pattern: {}", id, key_pattern)
        id
    }

    handler run_pending(now_ms: u64) -> u32 {
        // Run tasks every 5 seconds
        if now_ms - state.last_run_ms < 5000 && state.last_run_ms != 0 {
            return 0
        }
        state.last_run_ms = now_ms

        let mut processed = 0u32
        let mut to_complete: Vec<u64> = Vec::new()

        for task in &state.task_queue {
            let result = match task.kind.as_str() {
                "email" => {
                    println!("[BG] Sending email: {}", task.payload)
                    "sent"
                }
                "cache_invalidate" => {
                    println!("[BG] Invalidating cache keys matching: {}", task.payload)
                    "invalidated"
                }
                _ => {
                    println!("[BG] Unknown task kind: {}", task.kind)
                    "skipped"
                }
            }
            to_complete.push(task.id)
            processed += 1
            state.tasks_processed += 1
        }

        // Move completed tasks
        state.task_queue.retain(|t| {
            if to_complete.iter().any(|&id| id == t.id) {
                state.completed_tasks.push(BackgroundTask {
                    id: t.id,
                    kind: t.kind.clone(),
                    payload: t.payload.clone(),
                    scheduled_at: t.scheduled_at,
                    completed: true,
                    result: Option::Some("ok".to_string()),
                })
                false
            } else {
                true
            }
        })

        processed
    }

    handler queue_length() -> u32 {
        state.task_queue.len() as u32
    }

    handler tasks_processed() -> u64 {
        state.tasks_processed
    }
}

// ============================================================================
// API HANDLER ACTOR — Main request dispatcher
// ============================================================================

actor ApiHandler {
    state {
        user_store: UserStore,
        auth: AuthMiddleware,
        rate_limiter: RateLimiter,
        ws_handler: WebSocketHandler,
        metrics: MetricsCollector,
        background: BackgroundWorker,
    }

    init {
        state.user_store = spawn UserStore
        state.auth = spawn AuthMiddleware
        state.rate_limiter = spawn RateLimiter
        state.ws_handler = spawn WebSocketHandler
        state.metrics = spawn MetricsCollector
        state.background = spawn BackgroundWorker
        println!("[ApiHandler] All sub-actors spawned and ready")
    }

    handler handle_get_users(auth_header: Option<String>, page: u32, page_size: u32, remote_ip: String, now_ms: u64) -> (u16, String) {
        // Rate limit
        match send state.rate_limiter.check_ip(remote_ip.clone(), now_ms) {
            Result::Err(e) => {
                send state.metrics.record("/api/users".to_string(), 0, 429)
                return (429, format!(r#"{{"error":"{}","retry_after_seconds":1}}"#, e))
            }
            Result::Ok(_) => {}
        }

        // Auth check
        match send state.auth.check_request("/api/users".to_string(), auth_header) {
            Result::Err(e) => {
                send state.metrics.record("/api/users".to_string(), 0, 401)
                return (401, format!(r#"{{"error":"Unauthorized: {}"}}"#, e))
            }
            Result::Ok(_) => {}
        }

        let start = now_ms
        let list_json = send state.user_store.list_users(page, page_size)
        send state.metrics.record("/api/users".to_string(), now_ms - start, 200)
        (200, list_json)
    }

    handler handle_post_user(auth_header: Option<String>, name: String, email: String, role: String, remote_ip: String, now_ms: u64) -> (u16, String) {
        match send state.rate_limiter.check_ip(remote_ip.clone(), now_ms) {
            Result::Err(e) => return (429, format!(r#"{{"error":"{}"}}"#, e)),
            Result::Ok(_) => {}
        }

        match send state.auth.check_request("/api/users".to_string(), auth_header) {
            Result::Err(e) => return (401, format!(r#"{{"error":"{}"}}"#, e)),
            Result::Ok(_) => {}
        }

        match User::validate(&name, &email) {
            Result::Err(e) => return (400, format!(r#"{{"error":"Validation failed: {}"}}"#, e)),
            Result::Ok(_)  => {}
        }

        match send state.user_store.create_user(name.clone(), email.clone(), role) {
            Result::Ok(json) => {
                // Queue welcome email in background
                send state.background.enqueue_email(
                    email,
                    "Welcome to OmniSystem!".to_string(),
                    format!("Hello {}! Your account has been created.", name),
                    now_ms)
                send state.metrics.record("/api/users".to_string(), 0, 201)
                (201, json)
            }
            Result::Err(e) => {
                send state.metrics.record("/api/users".to_string(), 0, 409)
                (409, format!(r#"{{"error":"{}"}}"#, e))
            }
        }
    }

    handler handle_get_user(id: u32, auth_header: Option<String>, remote_ip: String, now_ms: u64) -> (u16, String) {
        match send state.rate_limiter.check_ip(remote_ip.clone(), now_ms) {
            Result::Err(e) => return (429, format!(r#"{{"error":"{}"}}"#, e)),
            Result::Ok(_) => {}
        }

        match send state.auth.check_request(format!("/api/users/{}", id), auth_header) {
            Result::Err(e) => return (401, format!(r#"{{"error":"{}"}}"#, e)),
            Result::Ok(_)  => {}
        }

        match send state.user_store.get_user(id) {
            Option::Some(json) => {
                send state.metrics.record(format!("/api/users/{}", id), 0, 200)
                (200, json)
            }
            Option::None => {
                send state.metrics.record(format!("/api/users/{}", id), 0, 404)
                (404, format!(r#"{{"error":"User {} not found"}}"#, id))
            }
        }
    }

    handler handle_delete_user(id: u32, auth_header: Option<String>, remote_ip: String, now_ms: u64) -> (u16, String) {
        match send state.auth.check_request("/api/users".to_string(), auth_header) {
            Result::Err(e) => return (401, format!(r#"{{"error":"{}"}}"#, e)),
            Result::Ok(_)  => {}
        }

        let deleted = send state.user_store.delete_user(id)
        if deleted {
            send state.background.enqueue_cache_invalidation(format!("user:{}", id), now_ms)
            send state.metrics.record(format!("/api/users/{}", id), 0, 204)
            (204, String::new())
        } else {
            send state.metrics.record(format!("/api/users/{}", id), 0, 404)
            (404, format!(r#"{{"error":"User {} not found"}}"#, id))
        }
    }

    handler handle_websocket_upgrade(client_path: String, now_ms: u64) -> u64 {
        send state.ws_handler.upgrade_connection(client_path, now_ms)
    }

    handler handle_metrics(now_ms: u64) -> String {
        send state.metrics.get_summary(now_ms)
    }

    handler tick(now_ms: u64) {
        // Periodic tasks
        let processed = send state.background.run_pending(now_ms)
        if processed > 0 {
            println!("[Tick] Processed {} background tasks", processed)
        }
        let cleaned = send state.rate_limiter.cleanup_stale_buckets(now_ms, 60000)
        if cleaned > 0 {
            println!("[Tick] Removed {} stale rate-limit buckets", cleaned)
        }
    }
}

// ============================================================================
// SPAWN ALL ACTORS
// ============================================================================

spawn ApiHandler as api_handler
spawn UserStore as user_store
spawn AuthMiddleware as auth_middleware
spawn RateLimiter as rate_limiter
spawn WebSocketHandler as ws_handler
spawn MetricsCollector as metrics_collector
spawn BackgroundWorker as background_worker

replicate api_handler across workers
