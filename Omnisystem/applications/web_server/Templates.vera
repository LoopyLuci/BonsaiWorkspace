// Templates.vera — Server-Side HTML Template Components
// Omnisystem Showcase Application · Web Server App
// Language: VERA · ~500 LOC

module WebTemplates {

    // ============================================================================
    // SHARED HELPERS
    // ============================================================================

    fn html_escape(s: &str) -> String {
        s.replace('&', "&amp;")
         .replace('<', "&lt;")
         .replace('>', "&gt;")
         .replace('"', "&quot;")
         .replace('\'', "&#x27;")
    }

    fn base_styles() -> &'static str {
        r#"<style>
            * { box-sizing: border-box; margin: 0; padding: 0; }
            body { font-family: 'Segoe UI', system-ui, sans-serif; background: #0f1117; color: #e2e8f0; min-height: 100vh; }
            a { color: #60a5fa; text-decoration: none; }
            a:hover { text-decoration: underline; }
            .container { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
            .btn { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.5rem 1.25rem;
                   border-radius: 6px; border: none; cursor: pointer; font-size: 0.875rem; font-weight: 500;
                   transition: background 0.15s; }
            .btn-primary { background: #3b82f6; color: #fff; }
            .btn-primary:hover { background: #2563eb; }
            .btn-danger  { background: #ef4444; color: #fff; }
            .btn-danger:hover { background: #dc2626; }
            .badge { display: inline-block; padding: 0.2rem 0.6rem; border-radius: 9999px;
                     font-size: 0.75rem; font-weight: 600; }
            .badge-green  { background: #065f46; color: #6ee7b7; }
            .badge-blue   { background: #1e3a5f; color: #93c5fd; }
            .badge-yellow { background: #713f12; color: #fcd34d; }
            table { width: 100%; border-collapse: collapse; }
            th, td { padding: 0.75rem 1rem; text-align: left; border-bottom: 1px solid #1e2736; }
            th { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: #94a3b8; }
            tr:hover td { background: #151c2a; }
        </style>"#
    }

    fn nav_html(active: &str) -> String {
        format!(r#"<nav style="background:#151c2a;border-bottom:1px solid #1e2736;padding:1rem 0;">
            <div class="container" style="display:flex;align-items:center;justify-content:space-between;">
                <span style="font-size:1.25rem;font-weight:700;color:#60a5fa;">⬡ OmniServer</span>
                <div style="display:flex;gap:1.5rem;">
                    <a href="/" style="color:{};">Home</a>
                    <a href="/api/users" style="color:{};">Users API</a>
                    <a href="/metrics" style="color:{};">Metrics</a>
                    <a href="/health" style="color:{};">Health</a>
                </div>
            </div>
        </nav>"#,
            if active == "home" { "#e2e8f0" } else { "#94a3b8" },
            if active == "users" { "#e2e8f0" } else { "#94a3b8" },
            if active == "metrics" { "#e2e8f0" } else { "#94a3b8" },
            if active == "health" { "#e2e8f0" } else { "#94a3b8" })
    }

    // ============================================================================
    // INDEX PAGE COMPONENT
    // ============================================================================

    component IndexPage {
        props {
            server_version: String,
            uptime_seconds: u64,
            active_connections: u32,
        }

        render -> String {
            let features = [
                ("⚡", "High Performance", "Built on TITAN with async I/O and worker threads for maximum throughput"),
                ("🔒", "Secure by Default", "CORS, rate limiting, auth middleware — production-ready out of the box"),
                ("🔀", "Smart Routing",     "Trie-based router with path parameters and wildcard matching"),
                ("📁", "Static Files",      "ETag caching, MIME detection, and conditional GET support"),
                ("📊", "Built-in Metrics",  "Request counts, response times, and status codes per route"),
                ("🌐", "WebSocket Ready",   "Upgrade HTTP connections to WebSocket with actor-based broadcast"),
            ]

            let feature_cards = features.iter().map(|(icon, title, desc)| {
                format!(r#"<div style="background:#151c2a;border:1px solid #1e2736;border-radius:10px;padding:1.5rem;">
                    <div style="font-size:2rem;margin-bottom:0.75rem;">{}</div>
                    <h3 style="color:#e2e8f0;margin-bottom:0.5rem;">{}</h3>
                    <p style="color:#94a3b8;font-size:0.9rem;line-height:1.6;">{}</p>
                </div>"#, icon, title, desc)
            }).collect::<Vec<_>>().join("\n")

            let uptime_h = self.uptime_seconds / 3600
            let uptime_m = (self.uptime_seconds % 3600) / 60
            let uptime_s = self.uptime_seconds % 60

            format!(r#"<!DOCTYPE html><html lang="en"><head>
                <meta charset="UTF-8">
                <meta name="viewport" content="width=device-width,initial-scale=1">
                <title>OmniServer — Powered by TITAN</title>
                {}
            </head><body>
                {}
                <main>
                    <section style="padding:5rem 0;text-align:center;background:linear-gradient(180deg,#1a2236 0%,#0f1117 100%);">
                        <div class="container">
                            <div style="display:inline-flex;align-items:center;gap:0.5rem;background:#1e3a5f;color:#60a5fa;padding:0.4rem 1rem;border-radius:9999px;font-size:0.8rem;margin-bottom:1.5rem;">
                                <span>●</span> Version {} — ONLINE
                            </div>
                            <h1 style="font-size:3rem;font-weight:800;line-height:1.1;margin-bottom:1rem;">
                                HTTP/1.1 Web Server<br>
                                <span style="background:linear-gradient(90deg,#60a5fa,#a78bfa);-webkit-background-clip:text;-webkit-text-fill-color:transparent;">
                                    Built in Pure TITAN
                                </span>
                            </h1>
                            <p style="font-size:1.125rem;color:#94a3b8;max-width:640px;margin:0 auto 2.5rem;">
                                A full-featured HTTP server with async actors (AETHER), server-side templating (VERA),
                                trie routing, ETag caching, and production middleware — all in Omni-Languages.
                            </p>
                            <div style="display:flex;gap:1rem;justify-content:center;">
                                <a href="/api/users" class="btn btn-primary">Explore Users API →</a>
                                <a href="/metrics" class="btn" style="background:#1e2736;">View Metrics</a>
                            </div>
                        </div>
                    </section>
                    <section style="padding:4rem 0;">
                        <div class="container">
                            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:1.5rem;">
                                {}
                            </div>
                        </div>
                    </section>
                    <section style="padding:2rem 0;border-top:1px solid #1e2736;">
                        <div class="container" style="display:flex;gap:3rem;justify-content:center;">
                            <div style="text-align:center;">
                                <div style="font-size:2rem;font-weight:700;color:#60a5fa;">{}</div>
                                <div style="color:#94a3b8;font-size:0.875rem;">Active Connections</div>
                            </div>
                            <div style="text-align:center;">
                                <div style="font-size:2rem;font-weight:700;color:#a78bfa;">{:02}:{:02}:{:02}</div>
                                <div style="color:#94a3b8;font-size:0.875rem;">Server Uptime</div>
                            </div>
                            <div style="text-align:center;">
                                <div style="font-size:2rem;font-weight:700;color:#34d399;">TITAN</div>
                                <div style="color:#94a3b8;font-size:0.875rem;">Powered By</div>
                            </div>
                        </div>
                    </section>
                </main>
            </body></html>"#,
                base_styles(), nav_html("home"),
                html_escape(&self.server_version),
                feature_cards,
                self.active_connections,
                uptime_h, uptime_m, uptime_s)
        }
    }

    // ============================================================================
    // USER LIST PAGE COMPONENT
    // ============================================================================

    component UserListPage {
        props {
            users: Vec<(u32, String, String, String, bool)>,  // (id, name, email, role, active)
            page: u32,
            total: u32,
            page_size: u32,
        }

        render -> String {
            let total_pages = (self.total + self.page_size - 1) / self.page_size

            let rows = self.users.iter().map(|(id, name, email, role, active)| {
                let role_badge = match role.as_str() {
                    "admin"     => format!("<span class='badge badge-yellow'>{}</span>", role),
                    "moderator" => format!("<span class='badge badge-blue'>{}</span>", role),
                    _           => format!("<span class='badge' style='background:#1a1a2e;color:#94a3b8;'>{}</span>", role),
                }
                let status_badge = if *active {
                    "<span class='badge badge-green'>Active</span>"
                } else {
                    "<span class='badge' style='background:#3f1515;color:#f87171;'>Inactive</span>"
                }
                format!(r#"<tr>
                    <td style="color:#94a3b8;font-size:0.875rem;">#{}</td>
                    <td style="font-weight:500;">{}</td>
                    <td style="color:#94a3b8;">{}</td>
                    <td>{}</td>
                    <td>{}</td>
                    <td>
                        <a href="/api/users/{}" style="color:#60a5fa;font-size:0.875rem;">View JSON</a>
                    </td>
                </tr>"#,
                    id, html_escape(name), html_escape(email), role_badge, status_badge, id)
            }).collect::<Vec<_>>().join("\n")

            let pagination = if total_pages > 1 {
                let prev_link = if self.page > 0 {
                    format!("<a href='/api/users?page={}&page_size={}' class='btn' style='background:#1e2736;'>← Prev</a>", self.page - 1, self.page_size)
                } else {
                    "<span class='btn' style='background:#0f1117;color:#4b5563;cursor:default;'>← Prev</span>".to_string()
                }
                let next_link = if self.page + 1 < total_pages {
                    format!("<a href='/api/users?page={}&page_size={}' class='btn' style='background:#1e2736;'>Next →</a>", self.page + 1, self.page_size)
                } else {
                    "<span class='btn' style='background:#0f1117;color:#4b5563;cursor:default;'>Next →</span>".to_string()
                }
                format!("<div style='display:flex;gap:0.75rem;align-items:center;justify-content:flex-end;margin-top:1rem;'>
                    <span style='color:#94a3b8;font-size:0.875rem;'>Page {} of {}</span>
                    {} {}
                </div>", self.page + 1, total_pages, prev_link, next_link)
            } else {
                String::new()
            }

            format!(r#"<!DOCTYPE html><html lang="en"><head>
                <meta charset="UTF-8">
                <title>Users — OmniServer</title>
                {}
            </head><body>
                {}
                <main style="padding:2.5rem 0;">
                    <div class="container">
                        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:2rem;">
                            <div>
                                <h1 style="font-size:1.75rem;font-weight:700;">Users</h1>
                                <p style="color:#94a3b8;margin-top:0.25rem;">{} total users · Page {} of {}</p>
                            </div>
                            <button class="btn btn-primary">+ New User</button>
                        </div>
                        <div style="background:#151c2a;border:1px solid #1e2736;border-radius:10px;overflow:hidden;">
                            <table>
                                <thead><tr>
                                    <th>ID</th><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th>Actions</th>
                                </tr></thead>
                                <tbody>{}</tbody>
                            </table>
                        </div>
                        {}
                    </div>
                </main>
            </body></html>"#,
                base_styles(), nav_html("users"),
                self.total, self.page + 1, total_pages,
                rows, pagination)
        }
    }

    // ============================================================================
    // ERROR PAGE COMPONENT
    // ============================================================================

    component ErrorPage {
        props {
            code: u32,
            message: String,
            detail: String,
        }

        render -> String {
            let (icon, color, suggestion) = match self.code {
                400 => ("✗", "#ef4444", "Check your request format and try again."),
                401 => ("🔒", "#f59e0b", "Please log in or provide a valid API token."),
                403 => ("⊘", "#ef4444", "You don't have permission to access this resource."),
                404 => ("◯", "#60a5fa", "The page you're looking for doesn't exist."),
                429 => ("⏱", "#f59e0b", "You've sent too many requests. Please wait a moment."),
                500 => ("⚠", "#ef4444", "An internal error occurred. We're working on it."),
                _   => ("?", "#94a3b8", "An unexpected error occurred."),
            }

            format!(r#"<!DOCTYPE html><html lang="en"><head>
                <meta charset="UTF-8">
                <title>Error {} — OmniServer</title>
                {}
            </head><body>
                {}
                <main style="display:flex;align-items:center;justify-content:center;min-height:60vh;">
                    <div style="text-align:center;max-width:480px;">
                        <div style="font-size:5rem;margin-bottom:1rem;">{}</div>
                        <div style="font-size:5rem;font-weight:800;color:{};margin-bottom:0.5rem;">{}</div>
                        <h1 style="font-size:1.5rem;font-weight:600;margin-bottom:0.75rem;">{}</h1>
                        <p style="color:#94a3b8;margin-bottom:0.5rem;">{}</p>
                        <p style="color:#64748b;font-size:0.875rem;margin-bottom:2rem;">{}</p>
                        <div style="display:flex;gap:1rem;justify-content:center;">
                            <a href="/" class="btn btn-primary">← Go Home</a>
                            <a href="javascript:history.back()" class="btn" style="background:#1e2736;">Go Back</a>
                        </div>
                    </div>
                </main>
            </body></html>"#,
                self.code, base_styles(), nav_html(""),
                icon, color, self.code,
                html_escape(&self.message),
                suggestion,
                html_escape(&self.detail))
        }
    }

    // ============================================================================
    // ADMIN DASHBOARD COMPONENT
    // ============================================================================

    component AdminDashboard {
        props {
            requests_per_second: f64,
            total_requests: u64,
            active_connections: u32,
            memory_used_mb: f64,
            memory_total_mb: f64,
            error_rate_pct: f64,
            uptime_seconds: u64,
            top_routes: Vec<(String, u64, f64)>,  // (path, count, avg_ms)
        }

        render -> String {
            let mem_pct = if self.memory_total_mb > 0.0 {
                (self.memory_used_mb / self.memory_total_mb * 100.0) as u32
            } else { 0 }
            let mem_color = if mem_pct > 85 { "#ef4444" } else if mem_pct > 65 { "#f59e0b" } else { "#34d399" }

            let route_rows = self.top_routes.iter().map(|(path, count, avg_ms)| {
                format!(r#"<tr>
                    <td style="font-family:monospace;color:#60a5fa;">{}</td>
                    <td style="color:#e2e8f0;">{}</td>
                    <td style="color:#94a3b8;">{:.1}ms</td>
                </tr>"#, html_escape(path), count, avg_ms)
            }).collect::<Vec<_>>().join("\n")

            let uptime_h = self.uptime_seconds / 3600
            let uptime_m = (self.uptime_seconds % 3600) / 60

            format!(r#"<!DOCTYPE html><html lang="en"><head>
                <meta charset="UTF-8">
                <title>Admin Dashboard — OmniServer</title>
                {}
                <style>
                    .stat-card {{ background:#151c2a;border:1px solid #1e2736;border-radius:10px;padding:1.5rem; }}
                    .stat-value {{ font-size:2.25rem;font-weight:700;margin:0.25rem 0; }}
                    .stat-label {{ color:#94a3b8;font-size:0.8rem;text-transform:uppercase;letter-spacing:0.05em; }}
                    .progress {{ background:#0f1117;border-radius:9999px;height:8px;margin-top:0.75rem; }}
                    .progress-fill {{ border-radius:9999px;height:8px;transition:width 0.3s; }}
                </style>
            </head><body>
                {}
                <main style="padding:2rem 0;">
                    <div class="container">
                        <h1 style="font-size:1.75rem;font-weight:700;margin-bottom:2rem;">Admin Dashboard</h1>
                        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1rem;margin-bottom:2rem;">
                            <div class="stat-card">
                                <div class="stat-label">Requests/sec</div>
                                <div class="stat-value" style="color:#60a5fa;">{:.1}</div>
                            </div>
                            <div class="stat-card">
                                <div class="stat-label">Total Requests</div>
                                <div class="stat-value" style="color:#a78bfa;">{}</div>
                            </div>
                            <div class="stat-card">
                                <div class="stat-label">Active Connections</div>
                                <div class="stat-value" style="color:#34d399;">{}</div>
                            </div>
                            <div class="stat-card">
                                <div class="stat-label">Error Rate</div>
                                <div class="stat-value" style="color:{};">{:.2}%</div>
                            </div>
                            <div class="stat-card">
                                <div class="stat-label">Uptime</div>
                                <div class="stat-value" style="color:#fbbf24;">{:02}h {:02}m</div>
                            </div>
                            <div class="stat-card">
                                <div class="stat-label">Memory Usage</div>
                                <div class="stat-value" style="color:{};">{:.0}MB</div>
                                <div class="progress">
                                    <div class="progress-fill" style="width:{}%;background:{};"></div>
                                </div>
                                <div style="color:#64748b;font-size:0.75rem;margin-top:0.4rem;">{:.0}MB of {:.0}MB</div>
                            </div>
                        </div>
                        <div style="background:#151c2a;border:1px solid #1e2736;border-radius:10px;overflow:hidden;">
                            <div style="padding:1rem 1.5rem;border-bottom:1px solid #1e2736;">
                                <h2 style="font-size:1rem;font-weight:600;">Top Routes</h2>
                            </div>
                            <table>
                                <thead><tr><th>Path</th><th>Requests</th><th>Avg Response</th></tr></thead>
                                <tbody>{}</tbody>
                            </table>
                        </div>
                    </div>
                </main>
            </body></html>"#,
                base_styles(), nav_html(""),
                self.requests_per_second,
                self.total_requests,
                self.active_connections,
                if self.error_rate_pct > 5.0 { "#ef4444" } else { "#34d399" }, self.error_rate_pct,
                uptime_h, uptime_m,
                mem_color, self.memory_used_mb,
                mem_pct, mem_color,
                self.memory_used_mb, self.memory_total_mb,
                route_rows)
        }
    }

}  // module WebTemplates
