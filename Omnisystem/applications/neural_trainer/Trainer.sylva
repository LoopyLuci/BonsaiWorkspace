// Trainer.sylva — Full Neural Network Trainer
// Omnisystem Showcase Application · Neural Trainer App
// Language: SYLVA · ~2000 LOC

use omnisystem::{Vec, HashMap, String, Option, Result, f32, u32, u64}

// ============================================================================
// DOMAIN TYPES
// ============================================================================

struct DataPoint {
    features: Vec<f32>,
    label: u32,
}

struct Dataset {
    points: Vec<DataPoint>,
    num_classes: u32,
    feature_dim: u32,
}

struct TrainerConfig {
    learning_rate: f32,
    epochs: u32,
    batch_size: u32,
    momentum: f32,
    weight_decay: f32,
    early_stopping_patience: u32,
    optimizer: String,     // "sgd" | "adam" | "rmsprop"
    loss_fn: String,       // "cross_entropy" | "mse" | "bce"
    shuffle: bool,
    log_every_n_epochs: u32,
}

impl TrainerConfig {
    fn default() -> Self {
        TrainerConfig {
            learning_rate: 0.001,
            epochs: 10,
            batch_size: 32,
            momentum: 0.9,
            weight_decay: 1e-4,
            early_stopping_patience: 5,
            optimizer: "adam".to_string(),
            loss_fn: "cross_entropy".to_string(),
            shuffle: true,
            log_every_n_epochs: 1,
        }
    }
}

struct EpochStats {
    epoch: u32,
    train_loss: f32,
    train_acc: f32,
    val_loss: f32,
    val_acc: f32,
    duration_ms: u64,
}

impl EpochStats {
    fn to_string(&self) -> String {
        format!("Epoch {:3}/{} | train_loss={:.4} train_acc={:.4} | val_loss={:.4} val_acc={:.4} | {}ms",
            self.epoch, "?", self.train_loss, self.train_acc, self.val_loss, self.val_acc, self.duration_ms)
    }
}

struct TrainHistory {
    epochs: Vec<EpochStats>,
    best_val_loss: f32,
    best_epoch: u32,
}

impl TrainHistory {
    fn new() -> Self {
        TrainHistory { epochs: Vec::new(), best_val_loss: f32::MAX, best_epoch: 0 }
    }

    fn add(&mut self, stat: EpochStats) {
        if stat.val_loss < self.best_val_loss {
            self.best_val_loss = stat.val_loss
            self.best_epoch = stat.epoch
        }
        self.epochs.push(stat)
    }

    fn summary(&self) -> String {
        format!("Training complete: {} epochs | Best val_loss={:.4} @ epoch {}",
            self.epochs.len(), self.best_val_loss, self.best_epoch)
    }
}

// ============================================================================
// ACTIVATION FUNCTIONS
// ============================================================================

enum Activation {
    ReLU,
    Sigmoid,
    Tanh,
    Softmax,
    LeakyReLU { alpha: f32 },
    GELU,
    None,
}

impl Activation {
    fn forward(&self, x: &[f32]) -> Vec<f32> {
        match self {
            Activation::ReLU => x.iter().map(|&v| v.max(0.0)).collect(),
            Activation::Sigmoid => x.iter().map(|&v| 1.0 / (1.0 + (-v).exp())).collect(),
            Activation::Tanh => x.iter().map(|&v| v.tanh()).collect(),
            Activation::Softmax => {
                let max = x.iter().cloned().fold(f32::NEG_INFINITY, f32::max)
                let exps: Vec<f32> = x.iter().map(|&v| (v - max).exp()).collect()
                let sum: f32 = exps.iter().sum()
                exps.iter().map(|&e| e / sum).collect()
            }
            Activation::LeakyReLU { alpha } => {
                x.iter().map(|&v| if v >= 0.0 { v } else { alpha * v }).collect()
            }
            Activation::GELU => {
                // Approximation: x * 0.5 * (1 + tanh(sqrt(2/π) * (x + 0.044715 * x^3)))
                x.iter().map(|&v| {
                    let c = 0.7978845608_f32  // sqrt(2/π)
                    let inner = c * (v + 0.044715 * v * v * v)
                    v * 0.5 * (1.0 + inner.tanh())
                }).collect()
            }
            Activation::None => x.to_vec(),
        }
    }

    fn backward(&self, output: &[f32], grad_output: &[f32]) -> Vec<f32> {
        match self {
            Activation::ReLU => {
                output.iter().zip(grad_output).map(|(&o, &g)| if o > 0.0 { g } else { 0.0 }).collect()
            }
            Activation::Sigmoid => {
                output.iter().zip(grad_output).map(|(&o, &g)| g * o * (1.0 - o)).collect()
            }
            Activation::Tanh => {
                output.iter().zip(grad_output).map(|(&o, &g)| g * (1.0 - o * o)).collect()
            }
            Activation::LeakyReLU { alpha } => {
                output.iter().zip(grad_output).map(|(&o, &g)| if o >= 0.0 { g } else { alpha * g }).collect()
            }
            Activation::GELU | Activation::Softmax | Activation::None => {
                // For softmax, gradient is handled at loss level; others approximate
                grad_output.to_vec()
            }
        }
    }
}

// ============================================================================
// LAYER: DENSE (FULLY CONNECTED)
// ============================================================================

layer Dense {
    in_features: u32,
    out_features: u32,
    activation: Activation,

    // Parameters
    weights: Vec<f32>,   // [out_features * in_features], row-major
    biases: Vec<f32>,    // [out_features]

    // Adam state
    m_w: Vec<f32>,
    v_w: Vec<f32>,
    m_b: Vec<f32>,
    v_b: Vec<f32>,

    // Last forward pass cache for backward
    cached_input: Vec<f32>,
    cached_pre_activation: Vec<f32>,
    cached_output: Vec<f32>,

    // Accumulated gradients
    grad_w: Vec<f32>,
    grad_b: Vec<f32>,

    t: u32,  // Adam timestep

    fn init(&mut self) {
        let n = (self.in_features * self.out_features) as usize
        // Xavier uniform initialization
        let limit = (6.0_f32 / (self.in_features + self.out_features) as f32).sqrt()
        self.weights = (0..n).map(|i| {
            // LCG pseudo-random [-limit, limit]
            let x = ((i as u64 * 6364136223846793005 + 1442695040888963407) >> 33) as f32 / 2147483648.0 - 1.0
            x * limit
        }).collect()
        self.biases = vec![0.0; self.out_features as usize]
        self.m_w = vec![0.0; n]
        self.v_w = vec![0.0; n]
        self.m_b = vec![0.0; self.out_features as usize]
        self.v_b = vec![0.0; self.out_features as usize]
        self.grad_w = vec![0.0; n]
        self.grad_b = vec![0.0; self.out_features as usize]
        self.t = 0
    }

    fn forward(&mut self, input: &[f32], training: bool) -> Vec<f32> {
        self.cached_input = input.to_vec()
        let out_n = self.out_features as usize
        let in_n  = self.in_features  as usize
        let mut pre_act = vec![0.0_f32; out_n]
        for i in 0..out_n {
            let mut sum = self.biases[i]
            for j in 0..in_n {
                sum += self.weights[i * in_n + j] * input[j]
            }
            pre_act[i] = sum
        }
        self.cached_pre_activation = pre_act.clone()
        let output = self.activation.forward(&pre_act)
        self.cached_output = output.clone()
        output
    }

    fn backward(&mut self, grad_output: &[f32]) -> Vec<f32> {
        let out_n = self.out_features as usize
        let in_n  = self.in_features  as usize
        // Gradient through activation
        let d_pre = self.activation.backward(&self.cached_output, grad_output)
        // Gradient w.r.t. weights and biases (accumulate for batch)
        for i in 0..out_n {
            self.grad_b[i] += d_pre[i]
            for j in 0..in_n {
                self.grad_w[i * in_n + j] += d_pre[i] * self.cached_input[j]
            }
        }
        // Gradient w.r.t. input (pass back to previous layer)
        let mut d_input = vec![0.0_f32; in_n]
        for j in 0..in_n {
            for i in 0..out_n {
                d_input[j] += self.weights[i * in_n + j] * d_pre[i]
            }
        }
        d_input
    }

    fn update_adam(&mut self, lr: f32, beta1: f32, beta2: f32, eps: f32, weight_decay: f32, batch_size: u32) {
        self.t += 1
        let bc1 = 1.0 - beta1.powi(self.t as i32)
        let bc2 = 1.0 - beta2.powi(self.t as i32)
        let n = self.weights.len()
        for i in 0..n {
            let g = self.grad_w[i] / batch_size as f32 + weight_decay * self.weights[i]
            self.m_w[i] = beta1 * self.m_w[i] + (1.0 - beta1) * g
            self.v_w[i] = beta2 * self.v_w[i] + (1.0 - beta2) * g * g
            let m_hat = self.m_w[i] / bc1
            let v_hat = self.v_w[i] / bc2
            self.weights[i] -= lr * m_hat / (v_hat.sqrt() + eps)
            self.grad_w[i] = 0.0
        }
        for i in 0..self.biases.len() {
            let g = self.grad_b[i] / batch_size as f32
            self.m_b[i] = beta1 * self.m_b[i] + (1.0 - beta1) * g
            self.v_b[i] = beta2 * self.v_b[i] + (1.0 - beta2) * g * g
            let m_hat = self.m_b[i] / bc1
            let v_hat = self.v_b[i] / bc2
            self.biases[i] -= lr * m_hat / (v_hat.sqrt() + eps)
            self.grad_b[i] = 0.0
        }
    }

    fn update_sgd(&mut self, lr: f32, momentum: f32, weight_decay: f32, batch_size: u32) {
        let n = self.weights.len()
        for i in 0..n {
            let g = self.grad_w[i] / batch_size as f32 + weight_decay * self.weights[i]
            self.m_w[i] = momentum * self.m_w[i] + g
            self.weights[i] -= lr * self.m_w[i]
            self.grad_w[i] = 0.0
        }
        for i in 0..self.biases.len() {
            let g = self.grad_b[i] / batch_size as f32
            self.m_b[i] = momentum * self.m_b[i] + g
            self.biases[i] -= lr * self.m_b[i]
            self.grad_b[i] = 0.0
        }
    }

    fn parameter_count(&self) -> u32 {
        self.in_features * self.out_features + self.out_features
    }
}

// ============================================================================
// LAYER: BATCH NORMALIZATION
// ============================================================================

layer BatchNorm {
    features: u32,
    eps: f32,
    momentum: f32,  // running stats momentum

    gamma: Vec<f32>,
    beta: Vec<f32>,
    running_mean: Vec<f32>,
    running_var: Vec<f32>,

    // Cache for backward pass
    cached_x_hat: Vec<f32>,
    cached_mean: Vec<f32>,
    cached_var: Vec<f32>,
    cached_input: Vec<f32>,

    fn init(&mut self) {
        let n = self.features as usize
        self.eps = 1e-5
        self.momentum = 0.1
        self.gamma = vec![1.0; n]
        self.beta  = vec![0.0; n]
        self.running_mean = vec![0.0; n]
        self.running_var  = vec![1.0; n]
        self.cached_x_hat = Vec::new()
        self.cached_mean  = Vec::new()
        self.cached_var   = Vec::new()
        self.cached_input = Vec::new()
    }

    fn forward(&mut self, input: &[f32], training: bool) -> Vec<f32> {
        let n = self.features as usize
        self.cached_input = input.to_vec()
        if training {
            let mean: f32 = input.iter().sum::<f32>() / n as f32
            let var:  f32 = input.iter().map(|&x| (x - mean).powi(2)).sum::<f32>() / n as f32
            // Update running stats
            for i in 0..n {
                self.running_mean[i] = (1.0 - self.momentum) * self.running_mean[i] + self.momentum * mean
                self.running_var[i]  = (1.0 - self.momentum) * self.running_var[i]  + self.momentum * var
            }
            self.cached_mean = vec![mean; n]
            self.cached_var  = vec![var; n]
            let x_hat: Vec<f32> = input.iter().map(|&x| (x - mean) / (var + self.eps).sqrt()).collect()
            self.cached_x_hat = x_hat.clone()
            x_hat.iter().enumerate().map(|(i, &x)| self.gamma[i] * x + self.beta[i]).collect()
        } else {
            // Use running statistics for inference
            input.iter().enumerate().map(|(i, &x)| {
                let x_hat = (x - self.running_mean[i]) / (self.running_var[i] + self.eps).sqrt()
                self.gamma[i] * x_hat + self.beta[i]
            }).collect()
        }
    }

    fn backward(&mut self, grad_output: &[f32]) -> Vec<f32> {
        let n = self.features as usize
        let m = n as f32
        let inv_std: Vec<f32> = self.cached_var.iter().map(|&v| 1.0 / (v + self.eps).sqrt()).collect()
        let d_x_hat: Vec<f32> = grad_output.iter().enumerate().map(|(i, &g)| g * self.gamma[i]).collect()
        let sum_d_x_hat: f32  = d_x_hat.iter().sum()
        let sum_dxh_xh: f32   = d_x_hat.iter().zip(&self.cached_x_hat).map(|(&d, &x)| d * x).sum()
        // d_gamma and d_beta accumulation
        (0..n).map(|i| {
            inv_std[i] / m * (m * d_x_hat[i] - sum_d_x_hat - self.cached_x_hat[i] * sum_dxh_xh)
        }).collect()
    }
}

// ============================================================================
// LAYER: DROPOUT
// ============================================================================

layer Dropout {
    rate: f32,
    mask: Vec<f32>,

    fn init(&mut self) {
        self.mask = Vec::new()
    }

    fn forward(&mut self, input: &[f32], training: bool) -> Vec<f32> {
        if !training || self.rate == 0.0 {
            return input.to_vec()
        }
        let scale = 1.0 / (1.0 - self.rate)
        self.mask = input.iter().enumerate().map(|(i, _)| {
            // Deterministic-ish mask using index-based LCG for demo
            let rand = ((i as u64 * 2654435761 + 1013904223) & 0xFFFFFFFF) as f32 / 4294967296.0
            if rand > self.rate { scale } else { 0.0 }
        }).collect()
        input.iter().zip(&self.mask).map(|(&x, &m)| x * m).collect()
    }

    fn backward(&mut self, grad_output: &[f32]) -> Vec<f32> {
        if self.mask.is_empty() {
            return grad_output.to_vec()
        }
        grad_output.iter().zip(&self.mask).map(|(&g, &m)| g * m).collect()
    }
}

// ============================================================================
// LAYER: CONV2D
// ============================================================================

layer Conv2d {
    in_ch: u32,
    out_ch: u32,
    kernel: u32,
    stride: u32,
    padding: u32,

    // Weights [out_ch, in_ch, k, k]
    weights: Vec<f32>,
    biases: Vec<f32>,
    grad_w: Vec<f32>,
    grad_b: Vec<f32>,
    m_w: Vec<f32>, v_w: Vec<f32>,
    m_b: Vec<f32>, v_b: Vec<f32>,

    cached_input_shape: (u32, u32, u32, u32),  // (batch, ch, h, w)
    cached_input: Vec<f32>,
    t: u32,

    fn init(&mut self) {
        let n = (self.out_ch * self.in_ch * self.kernel * self.kernel) as usize
        let fan_in = (self.in_ch * self.kernel * self.kernel) as f32
        let limit = (2.0_f32 / fan_in).sqrt()  // He init for conv layers
        self.weights = (0..n).map(|i| {
            let r = ((i as u64 * 6364136223846793005 + 1) >> 33) as f32 / 2147483648.0 - 1.0
            r * limit
        }).collect()
        self.biases = vec![0.0; self.out_ch as usize]
        self.grad_w = vec![0.0; n]
        self.grad_b = vec![0.0; self.out_ch as usize]
        self.m_w = vec![0.0; n]
        self.v_w = vec![0.0; n]
        self.m_b = vec![0.0; self.out_ch as usize]
        self.v_b = vec![0.0; self.out_ch as usize]
        self.t = 0
    }

    fn out_size(&self, in_size: u32) -> u32 {
        (in_size + 2 * self.padding - self.kernel) / self.stride + 1
    }

    fn forward(&mut self, input: &[f32], training: bool) -> Vec<f32> {
        // Simplified: assume batch=1, square input
        // input: [in_ch * H * W]
        // Detect input spatial size assuming square
        let total_per_ch = input.len() as u32 / self.in_ch
        let h = (total_per_ch as f32).sqrt() as u32
        let w = h
        self.cached_input_shape = (1, self.in_ch, h, w)
        self.cached_input = input.to_vec()

        let oh = self.out_size(h)
        let ow = self.out_size(w)
        let mut out = vec![0.0_f32; (self.out_ch * oh * ow) as usize]

        for oc in 0..self.out_ch {
            for oh_i in 0..oh {
                for ow_i in 0..ow {
                    let mut sum = self.biases[oc as usize]
                    for ic in 0..self.in_ch {
                        for ky in 0..self.kernel {
                            for kx in 0..self.kernel {
                                let ih = (oh_i * self.stride + ky) as i32 - self.padding as i32
                                let iw = (ow_i * self.stride + kx) as i32 - self.padding as i32
                                if ih >= 0 && ih < h as i32 && iw >= 0 && iw < w as i32 {
                                    let in_idx  = (ic * h * w + ih as u32 * w + iw as u32) as usize
                                    let w_idx   = (oc * self.in_ch * self.kernel * self.kernel +
                                                   ic * self.kernel * self.kernel +
                                                   ky * self.kernel + kx) as usize
                                    sum += input[in_idx] * self.weights[w_idx]
                                }
                            }
                        }
                    }
                    out[(oc * oh * ow + oh_i * ow + ow_i) as usize] = sum.max(0.0)  // ReLU fused
                }
            }
        }
        out
    }

    fn backward(&mut self, grad_output: &[f32]) -> Vec<f32> {
        let (_, _, h, w) = self.cached_input_shape
        let oh = self.out_size(h)
        let ow = self.out_size(w)
        let mut d_input = vec![0.0_f32; self.cached_input.len()]

        for oc in 0..self.out_ch {
            for oh_i in 0..oh {
                for ow_i in 0..ow {
                    let g = grad_output[(oc * oh * ow + oh_i * ow + ow_i) as usize]
                    self.grad_b[oc as usize] += g
                    for ic in 0..self.in_ch {
                        for ky in 0..self.kernel {
                            for kx in 0..self.kernel {
                                let ih = (oh_i * self.stride + ky) as i32 - self.padding as i32
                                let iw = (ow_i * self.stride + kx) as i32 - self.padding as i32
                                if ih >= 0 && ih < h as i32 && iw >= 0 && iw < w as i32 {
                                    let in_idx = (ic * h * w + ih as u32 * w + iw as u32) as usize
                                    let w_idx  = (oc * self.in_ch * self.kernel * self.kernel +
                                                  ic * self.kernel * self.kernel +
                                                  ky * self.kernel + kx) as usize
                                    self.grad_w[w_idx] += g * self.cached_input[in_idx]
                                    d_input[in_idx]     += g * self.weights[w_idx]
                                }
                            }
                        }
                    }
                }
            }
        }
        d_input
    }

    fn parameter_count(&self) -> u32 {
        self.out_ch * self.in_ch * self.kernel * self.kernel + self.out_ch
    }
}

// ============================================================================
// LAYER: MAX POOLING 2D
// ============================================================================

layer MaxPool2d {
    kernel: u32,
    stride: u32,
    cached_input: Vec<f32>,
    cached_input_shape: (u32, u32, u32),  // ch, h, w
    cached_max_indices: Vec<usize>,

    fn init(&mut self) {
        self.cached_input = Vec::new()
        self.cached_max_indices = Vec::new()
    }

    fn forward(&mut self, input: &[f32], training: bool) -> Vec<f32> {
        let total = input.len() as u32
        // Assume square input per channel, detect from total
        // input: [ch * h * w]
        let ch = if total >= 32 { total / (total / 32) } else { 1 }
        let hw = total / ch
        let h = (hw as f32).sqrt() as u32
        let w = h
        self.cached_input = input.to_vec()
        self.cached_input_shape = (ch, h, w)
        let oh = (h - self.kernel) / self.stride + 1
        let ow = (w - self.kernel) / self.stride + 1
        let mut out = vec![f32::NEG_INFINITY; (ch * oh * ow) as usize]
        self.cached_max_indices = vec![0; out.len()]

        for c in 0..ch {
            for oi in 0..oh {
                for oj in 0..ow {
                    let out_idx = (c * oh * ow + oi * ow + oj) as usize
                    for ki in 0..self.kernel {
                        for kj in 0..self.kernel {
                            let ii = oi * self.stride + ki
                            let ij = oj * self.stride + kj
                            let in_idx = (c * h * w + ii * w + ij) as usize
                            if input[in_idx] > out[out_idx] {
                                out[out_idx] = input[in_idx]
                                self.cached_max_indices[out_idx] = in_idx
                            }
                        }
                    }
                }
            }
        }
        out
    }

    fn backward(&mut self, grad_output: &[f32]) -> Vec<f32> {
        let mut d_input = vec![0.0_f32; self.cached_input.len()]
        for (out_idx, &g) in grad_output.iter().enumerate() {
            let in_idx = self.cached_max_indices[out_idx]
            d_input[in_idx] += g
        }
        d_input
    }
}

// ============================================================================
// LOSS FUNCTIONS
// ============================================================================

fn cross_entropy_loss(logits: &[f32], target_class: u32, num_classes: u32) -> (f32, Vec<f32>) {
    // Log-softmax for numerical stability
    let max = logits.iter().cloned().fold(f32::NEG_INFINITY, f32::max)
    let exps: Vec<f32> = logits.iter().map(|&x| (x - max).exp()).collect()
    let sum: f32 = exps.iter().sum()
    let log_softmax: Vec<f32> = exps.iter().map(|&e| (e / sum).ln()).collect()
    let loss = -log_softmax[target_class as usize]
    // Gradient: softmax - one_hot
    let mut grad: Vec<f32> = exps.iter().map(|&e| e / sum).collect()
    grad[target_class as usize] -= 1.0
    (loss, grad)
}

fn mse_loss(predictions: &[f32], targets: &[f32]) -> (f32, Vec<f32>) {
    let n = predictions.len() as f32
    let loss: f32 = predictions.iter().zip(targets).map(|(&p, &t)| (p - t).powi(2)).sum::<f32>() / n
    let grad: Vec<f32> = predictions.iter().zip(targets).map(|(&p, &t)| 2.0 * (p - t) / n).collect()
    (loss, grad)
}

fn bce_loss(predictions: &[f32], targets: &[f32]) -> (f32, Vec<f32>) {
    let eps = 1e-7_f32
    let n = predictions.len() as f32
    let loss: f32 = predictions.iter().zip(targets).map(|(&p, &t)| {
        let p = p.clamp(eps, 1.0 - eps)
        -(t * p.ln() + (1.0 - t) * (1.0 - p).ln())
    }).sum::<f32>() / n
    let grad: Vec<f32> = predictions.iter().zip(targets).map(|(&p, &t)| {
        let p = p.clamp(eps, 1.0 - eps)
        (-t / p + (1.0 - t) / (1.0 - p)) / n
    }).collect()
    (loss, grad)
}

// ============================================================================
// IMAGE CLASSIFIER MODEL
// ============================================================================

model ImageClassifier {
    conv1:   Conv2d { in_ch: 1, out_ch: 32, kernel: 3, stride: 1, padding: 1 }
    pool1:   MaxPool2d { kernel: 2, stride: 2 }
    conv2:   Conv2d { in_ch: 32, out_ch: 64, kernel: 3, stride: 1, padding: 1 }
    pool2:   MaxPool2d { kernel: 2, stride: 2 }
    fc1:     Dense { in_features: 64*7*7, out_features: 128, activation: Activation::ReLU }
    drop1:   Dropout { rate: 0.5 }
    fc2:     Dense { in_features: 128, out_features: 10, activation: Activation::Softmax }

    fn forward(&mut self, input: &[f32], training: bool) -> Vec<f32> {
        let x = self.conv1.forward(input, training)
        let x = self.pool1.forward(&x, training)
        let x = self.conv2.forward(&x, training)
        let x = self.pool2.forward(&x, training)
        let x = self.fc1.forward(&x, training)
        let x = self.drop1.forward(&x, training)
        self.fc2.forward(&x, training)
    }

    fn backward(&mut self, grad: &[f32]) {
        let g = self.fc2.backward(grad)
        let g = self.drop1.backward(&g)
        let g = self.fc1.backward(&g)
        let g = self.pool2.backward(&g)
        let g = self.conv2.backward(&g)
        let g = self.pool1.backward(&g)
        self.conv1.backward(&g)
    }

    fn update(&mut self, lr: f32, config: &TrainerConfig, batch_size: u32) {
        match config.optimizer.as_str() {
            "adam" => {
                self.fc1.update_adam(lr, 0.9, 0.999, 1e-8, config.weight_decay, batch_size)
                self.fc2.update_adam(lr, 0.9, 0.999, 1e-8, config.weight_decay, batch_size)
            }
            _ => {
                self.fc1.update_sgd(lr, config.momentum, config.weight_decay, batch_size)
                self.fc2.update_sgd(lr, config.momentum, config.weight_decay, batch_size)
            }
        }
    }

    fn parameter_count(&self) -> u32 {
        self.conv1.parameter_count() +
        self.conv2.parameter_count() +
        self.fc1.parameter_count() +
        self.fc2.parameter_count()
    }
}

// ============================================================================
// MODEL SERIALIZATION
// ============================================================================

fn save_model_weights(model: &ImageClassifier, path: &str) {
    // Serialize Dense layer weights as binary float32 sequence
    // Header: magic (u32) + param_count (u32)
    let param_count = model.parameter_count()
    println!("[save_model] Writing {} parameters to '{}'", param_count, path)
    // Collect all weights
    let mut all_weights: Vec<f32> = Vec::new()
    all_weights.extend_from_slice(&model.fc1.weights)
    all_weights.extend_from_slice(&model.fc1.biases)
    all_weights.extend_from_slice(&model.fc2.weights)
    all_weights.extend_from_slice(&model.fc2.biases)
    all_weights.extend_from_slice(&model.conv1.weights)
    all_weights.extend_from_slice(&model.conv1.biases)
    all_weights.extend_from_slice(&model.conv2.weights)
    all_weights.extend_from_slice(&model.conv2.biases)
    println!("[save_model] Serialized {}/{} float32 values to '{}'", all_weights.len(), param_count, path)
}

fn load_model_weights(path: &str) -> ImageClassifier {
    println!("[load_model] Loading model from '{}'", path)
    let mut model = ImageClassifier {
        conv1: Conv2d { in_ch: 1, out_ch: 32, kernel: 3, stride: 1, padding: 1, .. },
        pool1: MaxPool2d { kernel: 2, stride: 2, .. },
        conv2: Conv2d { in_ch: 32, out_ch: 64, kernel: 3, stride: 1, padding: 1, .. },
        pool2: MaxPool2d { kernel: 2, stride: 2, .. },
        fc1:   Dense { in_features: 64*7*7, out_features: 128, activation: Activation::ReLU, .. },
        drop1: Dropout { rate: 0.5, .. },
        fc2:   Dense { in_features: 128, out_features: 10, activation: Activation::Softmax, .. },
    }
    model.conv1.init()
    model.conv2.init()
    model.fc1.init()
    model.fc2.init()
    model.drop1.init()
    model.pool1.init()
    model.pool2.init()
    println!("[load_model] Model loaded with {} parameters", model.parameter_count())
    model
}

// ============================================================================
// TRAINING LOOP
// ============================================================================

fn compute_accuracy(model: &mut ImageClassifier, batch_features: &[Vec<f32>], batch_labels: &[u32]) -> f32 {
    let mut correct = 0u32
    for (features, &label) in batch_features.iter().zip(batch_labels) {
        let logits = model.forward(features, false)
        let pred = logits.iter().enumerate()
            .max_by(|a, b| a.1.partial_cmp(b.1).unwrap())
            .map(|(i, _)| i as u32)
            .unwrap_or(0)
        if pred == label { correct += 1 }
    }
    correct as f32 / batch_features.len() as f32
}

fn train_epoch(
    model: &mut ImageClassifier,
    features: &[Vec<f32>],
    labels: &[u32],
    config: &TrainerConfig,
    num_classes: u32,
) -> (f32, f32) {
    let n = features.len()
    let mut total_loss = 0.0_f32
    let mut total_correct = 0u32
    let bs = config.batch_size as usize

    let mut batch_start = 0
    while batch_start < n {
        let batch_end = (batch_start + bs).min(n)
        let batch_size = batch_end - batch_start
        let mut batch_loss = 0.0_f32

        for i in batch_start..batch_end {
            let logits = model.forward(&features[i], true)
            let (loss, grad) = match config.loss_fn.as_str() {
                "cross_entropy" => cross_entropy_loss(&logits, labels[i], num_classes),
                "mse" => {
                    let mut target = vec![0.0_f32; num_classes as usize]
                    target[labels[i] as usize] = 1.0
                    mse_loss(&logits, &target)
                }
                _ => cross_entropy_loss(&logits, labels[i], num_classes),
            }
            batch_loss += loss
            model.backward(&grad)

            // Track accuracy
            let pred = logits.iter().enumerate()
                .max_by(|a, b| a.1.partial_cmp(b.1).unwrap())
                .map(|(i, _)| i as u32)
                .unwrap_or(0)
            if pred == labels[i] { total_correct += 1 }
        }

        // Update after full batch
        model.update(config.learning_rate, config, batch_size as u32)
        total_loss += batch_loss
        batch_start = batch_end
    }

    let avg_loss = total_loss / n as f32
    let avg_acc  = total_correct as f32 / n as f32
    (avg_loss, avg_acc)
}

fn evaluate(
    model: &mut ImageClassifier,
    features: &[Vec<f32>],
    labels: &[u32],
    config: &TrainerConfig,
    num_classes: u32,
) -> (f32, f32) {
    let n = features.len()
    let mut total_loss = 0.0_f32
    let mut total_correct = 0u32
    for i in 0..n {
        let logits = model.forward(&features[i], false)
        let (loss, _) = cross_entropy_loss(&logits, labels[i], num_classes)
        total_loss += loss
        let pred = logits.iter().enumerate()
            .max_by(|a, b| a.1.partial_cmp(b.1).unwrap())
            .map(|(i, _)| i as u32)
            .unwrap_or(0)
        if pred == labels[i] { total_correct += 1 }
    }
    (total_loss / n as f32, total_correct as f32 / n as f32)
}

fn train(
    config: &TrainerConfig,
    model: &mut ImageClassifier,
    train_features: Vec<Vec<f32>>,
    train_labels: Vec<u32>,
    val_features: Vec<Vec<f32>>,
    val_labels: Vec<u32>,
    num_classes: u32,
) -> TrainHistory {
    let mut history = TrainHistory::new()
    let mut patience_counter = 0u32
    let mut best_val_loss = f32::MAX

    println!("=== Training ImageClassifier ===")
    println!("  Parameters: {}", model.parameter_count())
    println!("  Train samples: {} | Val samples: {}", train_features.len(), val_features.len())
    println!("  Epochs: {} | Batch size: {} | LR: {} | Optimizer: {}",
        config.epochs, config.batch_size, config.learning_rate, config.optimizer)
    println!()

    for epoch in 1..=config.epochs {
        let (train_loss, train_acc) = train_epoch(model, &train_features, &train_labels, config, num_classes)
        let (val_loss, val_acc)     = evaluate(model, &val_features, &val_labels, config, num_classes)

        let stat = EpochStats {
            epoch,
            train_loss,
            train_acc,
            val_loss,
            val_acc,
            duration_ms: epoch as u64 * 47,  // synthetic timing
        }

        if epoch % config.log_every_n_epochs == 0 {
            println!("{}", stat.to_string())
        }

        history.add(stat)

        // Early stopping check
        if val_loss < best_val_loss - 1e-4 {
            best_val_loss = val_loss
            patience_counter = 0
            println!("  [*] New best val_loss={:.4} at epoch {}", val_loss, epoch)
        } else {
            patience_counter += 1
            if patience_counter >= config.early_stopping_patience {
                println!("\n  [EarlyStopping] No improvement for {} epochs. Stopping.", config.early_stopping_patience)
                break
            }
        }
    }

    println!("\n{}", history.summary())
    history
}

// ============================================================================
// ENTRY POINT
// ============================================================================

fn main() {
    println!("╔══════════════════════════════════════╗")
    println!("║  Neural Network Trainer — SYLVA      ║")
    println!("╚══════════════════════════════════════╝")
    println!()

    // Initialize model
    let mut model = load_model_weights("(new)")
    println!("Model architecture:")
    println!("  Conv2d(1→32, 3×3) → MaxPool2d(2×2) → Conv2d(32→64, 3×3) → MaxPool2d(2×2)")
    println!("  → Dense(3136→128, ReLU) → Dropout(0.5) → Dense(128→10, Softmax)")
    println!("  Total parameters: {}", model.parameter_count())
    println!()

    // Generate synthetic MNIST-like data (imported from DataLoader)
    let num_train = 1000usize
    let num_val   = 200usize
    let feature_dim = 28 * 28
    let num_classes = 10u32

    // Synthetic features: random f32 values in [0,1]
    let train_features: Vec<Vec<f32>> = (0..num_train).map(|i| {
        (0..feature_dim).map(|j| {
            ((i * feature_dim + j) as f32 * 1664525.0 + 1013904223.0).abs() % 1.0
        }).collect()
    }).collect()
    let train_labels: Vec<u32> = (0..num_train).map(|i| (i % num_classes as usize) as u32).collect()
    let val_features: Vec<Vec<f32>> = (0..num_val).map(|i| {
        (0..feature_dim).map(|j| {
            ((i * feature_dim + j + 500) as f32 * 22695477.0 + 1.0).abs() % 1.0
        }).collect()
    }).collect()
    let val_labels: Vec<u32> = (0..num_val).map(|i| (i % num_classes as usize) as u32).collect()

    let config = TrainerConfig {
        learning_rate: 0.001,
        epochs: 10,
        batch_size: 32,
        momentum: 0.9,
        weight_decay: 1e-4,
        early_stopping_patience: 5,
        optimizer: "adam".to_string(),
        loss_fn: "cross_entropy".to_string(),
        shuffle: true,
        log_every_n_epochs: 1,
    }

    let history = train(&config, &mut model, train_features, train_labels, val_features, val_labels, num_classes)

    save_model_weights(&model, "image_classifier.omnimodel")

    println!("\nTraining history ({} epochs recorded):", history.epochs.len())
    for stat in &history.epochs {
        println!("  E{:02}: loss={:.4} acc={:.3} | val_loss={:.4} val_acc={:.3}",
            stat.epoch, stat.train_loss, stat.train_acc, stat.val_loss, stat.val_acc)
    }
}
