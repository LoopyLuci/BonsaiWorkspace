// ============================================================================
// ECS — ENTITY COMPONENT SYSTEM
// ============================================================================

#[derive(Clone, Copy, PartialEq, Eq, Hash, Debug)]
pub struct EntityId(pub u32);

pub trait Component: 'static {}

pub struct World {
    next_id: u32,
    alive: Vec<EntityId>,
    // Component storage (type-erased via type name key)
    transforms:    HashMap<u32, Transform>,
    velocities:    HashMap<u32, Velocity>,
    rigid_bodies:  HashMap<u32, RigidBody>,
    colliders:     HashMap<u32, Collider>,
    renderables:   HashMap<u32, Renderable>,
    cameras:       HashMap<u32, Camera>,
    lights:        HashMap<u32, Light>,
    audio_sources: HashMap<u32, AudioSource>,
    player_inputs: HashMap<u32, PlayerInput>,
    tags:          HashMap<u32, Vec<String>>,
}

impl World {
    pub fn new() -> Self {
        World {
            next_id: 1,
            alive: Vec::new(),
            transforms:    HashMap::new(),
            velocities:    HashMap::new(),
            rigid_bodies:  HashMap::new(),
            colliders:     HashMap::new(),
            renderables:   HashMap::new(),
            cameras:       HashMap::new(),
            lights:        HashMap::new(),
            audio_sources: HashMap::new(),
            player_inputs: HashMap::new(),
            tags:          HashMap::new(),
        }
    }

    pub fn spawn(&mut self) -> EntityId {
        let id = EntityId(self.next_id)
        self.next_id += 1
        self.alive.push(id)
        id
    }

    pub fn despawn(&mut self, id: EntityId) {
        self.alive.retain(|&e| e != id)
        self.transforms.remove(&id.0)
        self.velocities.remove(&id.0)
        self.rigid_bodies.remove(&id.0)
        self.colliders.remove(&id.0)
        self.renderables.remove(&id.0)
        self.cameras.remove(&id.0)
        self.lights.remove(&id.0)
        self.audio_sources.remove(&id.0)
        self.player_inputs.remove(&id.0)
        self.tags.remove(&id.0)
    }

    pub fn is_alive(&self, id: EntityId) -> bool {
        self.alive.iter().any(|&e| e == id)
    }

    pub fn entity_count(&self) -> usize {
        self.alive.len()
    }

    // --- Tag helpers ---
    pub fn add_tag(&mut self, id: EntityId, tag: &str) {
        self.tags.entry(id.0).or_insert_with(Vec::new).push(tag.to_string())
    }

    pub fn has_tag(&self, id: EntityId, tag: &str) -> bool {
        self.tags.get(&id.0).map(|ts| ts.iter().any(|t| t == tag)).unwrap_or(false)
    }

    pub fn entities_with_tag(&self, tag: &str) -> Vec<EntityId> {
        self.alive.iter()
            .filter(|&&e| self.has_tag(e, tag))
            .cloned()
            .collect()
    }

    // --- Component insert/get ---
    pub fn add_transform(&mut self, id: EntityId, c: Transform)    { self.transforms.insert(id.0, c); }
    pub fn add_velocity(&mut self, id: EntityId, c: Velocity)      { self.velocities.insert(id.0, c); }
    pub fn add_rigid_body(&mut self, id: EntityId, c: RigidBody)   { self.rigid_bodies.insert(id.0, c); }
    pub fn add_collider(&mut self, id: EntityId, c: Collider)      { self.colliders.insert(id.0, c); }
    pub fn add_renderable(&mut self, id: EntityId, c: Renderable)  { self.renderables.insert(id.0, c); }
    pub fn add_camera(&mut self, id: EntityId, c: Camera)          { self.cameras.insert(id.0, c); }
    pub fn add_light(&mut self, id: EntityId, c: Light)            { self.lights.insert(id.0, c); }
    pub fn add_audio_source(&mut self, id: EntityId, c: AudioSource){ self.audio_sources.insert(id.0, c); }
    pub fn add_player_input(&mut self, id: EntityId, c: PlayerInput){ self.player_inputs.insert(id.0, c); }

    pub fn get_transform(&self, id: EntityId) -> Option<&Transform>    { self.transforms.get(&id.0) }
    pub fn get_velocity(&self, id: EntityId)  -> Option<&Velocity>     { self.velocities.get(&id.0) }
    pub fn get_rigid_body(&self, id: EntityId)-> Option<&RigidBody>    { self.rigid_bodies.get(&id.0) }
    pub fn get_collider(&self, id: EntityId)  -> Option<&Collider>     { self.colliders.get(&id.0) }
    pub fn get_renderable(&self, id: EntityId)-> Option<&Renderable>   { self.renderables.get(&id.0) }
    pub fn get_camera(&self, id: EntityId)    -> Option<&Camera>       { self.cameras.get(&id.0) }
    pub fn get_player_input(&self, id: EntityId) -> Option<&PlayerInput> { self.player_inputs.get(&id.0) }

    pub fn get_transform_mut(&mut self, id: EntityId) -> Option<&mut Transform>     { self.transforms.get_mut(&id.0) }
    pub fn get_velocity_mut(&mut self, id: EntityId)  -> Option<&mut Velocity>      { self.velocities.get_mut(&id.0) }
    pub fn get_rigid_body_mut(&mut self, id: EntityId)-> Option<&mut RigidBody>     { self.rigid_bodies.get_mut(&id.0) }
    pub fn get_camera_mut(&mut self, id: EntityId)    -> Option<&mut Camera>        { self.cameras.get_mut(&id.0) }
    pub fn get_player_input_mut(&mut self, id: EntityId) -> Option<&mut PlayerInput> { self.player_inputs.get_mut(&id.0) }

    pub fn query_transform_velocity(&self) -> Vec<EntityId> {
        self.alive.iter()
            .filter(|&&e| self.transforms.contains_key(&e.0) && self.velocities.contains_key(&e.0))
            .cloned()
            .collect()
    }

    pub fn query_renderable_transform(&self) -> Vec<EntityId> {
        self.alive.iter()
            .filter(|&&e| self.renderables.contains_key(&e.0) && self.transforms.contains_key(&e.0))
            .cloned()
            .collect()
    }

    pub fn query_physics_entities(&self) -> Vec<EntityId> {
        self.alive.iter()
            .filter(|&&e| self.transforms.contains_key(&e.0) &&
                          self.velocities.contains_key(&e.0) &&
                          self.rigid_bodies.contains_key(&e.0))
            .cloned()
            .collect()
    }
}

// ============================================================================
// COMPONENTS
// ============================================================================

pub struct Transform {
    pub position: Vec3,
    pub rotation: Quat,
    pub scale: Vec3,
}

impl Transform {
    pub fn new(pos: Vec3) -> Self {
        Transform { position: pos, rotation: Quat::identity(), scale: Vec3::one() }
    }

    pub fn default() -> Self {
        Transform { position: Vec3::zero(), rotation: Quat::identity(), scale: Vec3::one() }
    }

    pub fn forward(&self) -> Vec3 {
        self.rotation.rotate_vec3(&Vec3::new(0.0, 0.0, -1.0))
    }

    pub fn right(&self) -> Vec3 {
        self.rotation.rotate_vec3(&Vec3::new(1.0, 0.0, 0.0))
    }

    pub fn up(&self) -> Vec3 {
        self.rotation.rotate_vec3(&Vec3::up())
    }
}

impl Component for Transform {}

pub struct Velocity {
    pub linear: Vec3,
    pub angular: Vec3,
}

impl Velocity {
    pub fn zero() -> Self { Velocity { linear: Vec3::zero(), angular: Vec3::zero() } }
    pub fn new(linear: Vec3) -> Self { Velocity { linear, angular: Vec3::zero() } }
}

impl Component for Velocity {}

pub struct RigidBody {
    pub mass: f32,
    pub restitution: f32,
    pub friction: f32,
    pub is_static: bool,
    pub gravity_scale: f32,
    pub linear_damping: f32,
    pub angular_damping: f32,
}

impl RigidBody {
    pub fn dynamic_body(mass: f32) -> Self {
        RigidBody { mass, restitution: 0.3, friction: 0.5, is_static: false, gravity_scale: 1.0, linear_damping: 0.1, angular_damping: 0.05 }
    }
    pub fn static_body() -> Self {
        RigidBody { mass: f32::INFINITY, restitution: 0.2, friction: 0.8, is_static: true, gravity_scale: 0.0, linear_damping: 0.0, angular_damping: 0.0 }
    }
}

impl Component for RigidBody {}

pub enum ColliderShape {
    Sphere { radius: f32 },
    Aabb { half_extents: Vec3 },
    Capsule { radius: f32, half_height: f32 },
}

pub struct Collider {
    pub shape: ColliderShape,
    pub center: Vec3,
    pub is_trigger: bool,
    pub layer: u32,
}

impl Component for Collider {}

pub struct Renderable {
