    pub material_id: u32,
    pub visible: bool,
    pub cast_shadows: bool,
    pub receive_shadows: bool,
    pub lod_distance: f32,
}

impl Renderable {
    pub fn new(mesh_id: u32, material_id: u32) -> Self {
        Renderable { mesh_id, material_id, visible: true, cast_shadows: true, receive_shadows: true, lod_distance: 100.0 }
    }
}

impl Component for Renderable {}

pub struct Camera {
    pub fov: f32,
    pub near: f32,
    pub far: f32,
    pub aspect: f32,
    pub is_main: bool,
}

impl Camera {
    pub fn new(fov: f32, aspect: f32) -> Self {
        Camera { fov, near: 0.1, far: 1000.0, aspect, is_main: true }
    }

    pub fn view_matrix(&self, transform: &Transform) -> Mat4 {
        let pos = &transform.position
        let forward = transform.forward()
        let up = transform.up()
        let right = forward.cross(&up).normalize()
        let up_corrected = right.cross(&forward).normalize()
        let tx = -right.dot(pos)
        let ty = -up_corrected.dot(pos)
        let tz = forward.dot(pos)
        Mat4 { cols: [
            [right.x,         up_corrected.x,  -forward.x,     0.0],
            [right.y,         up_corrected.y,  -forward.y,     0.0],
            [right.z,         up_corrected.z,  -forward.z,     0.0],
            [tx,              ty,               tz,             1.0],
        ]}
    }

    pub fn proj_matrix(&self) -> Mat4 {
        let f = 1.0 / (self.fov * 0.5).tan()
        let range_inv = 1.0 / (self.near - self.far)
        Mat4 { cols: [
            [f / self.aspect, 0.0,  0.0,                              0.0],
            [0.0,             f,    0.0,                              0.0],
            [0.0,             0.0, (self.near + self.far) * range_inv,-1.0],
            [0.0,             0.0,  2.0 * self.near * self.far * range_inv, 0.0],
        ]}
    }
}

impl Component for Camera {}

pub enum LightKind { Directional, Point { range: f32 }, Spot { range: f32, inner_cone: f32, outer_cone: f32 } }

pub struct Light {
