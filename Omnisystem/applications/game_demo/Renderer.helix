// Renderer.helix — Game Rendering Pipeline
// Omnisystem Showcase Application · Game Demo App
// Language: HELIX · ~2000 LOC

use omnisystem::{Vec, HashMap, String, Option, Result, f32, u32}

// ============================================================================
// SHARED SHADER MATH / HELPER FUNCTIONS
// ============================================================================

fn ggx_distribution(n_dot_h: f32, roughness: f32) -> f32 {
    let a = roughness * roughness
    let a2 = a * a
    let denom = n_dot_h * n_dot_h * (a2 - 1.0) + 1.0
    a2 / (3.14159265 * denom * denom + 1e-7)
}

fn schlick_smith_geometry(n_dot_v: f32, n_dot_l: f32, roughness: f32) -> f32 {
    let r = roughness + 1.0
    let k = r * r / 8.0
    let gv = n_dot_v / (n_dot_v * (1.0 - k) + k)
    let gl = n_dot_l / (n_dot_l * (1.0 - k) + k)
    gv * gl
}

fn fresnel_schlick(cos_theta: f32, f0: vec3<f32>) -> vec3<f32> {
    let t = (1.0 - cos_theta).max(0.0)
    let t5 = t * t * t * t * t
    f0 + (vec3(1.0, 1.0, 1.0) - f0) * t5
}

fn fresnel_schlick_roughness(cos_theta: f32, f0: vec3<f32>, roughness: f32) -> vec3<f32> {
    let t = (1.0 - cos_theta).max(0.0)
    let t5 = t * t * t * t * t
    let env_f0 = vec3(1.0 - roughness, 1.0 - roughness, 1.0 - roughness).max(f0)
    f0 + (env_f0 - f0) * t5
}

fn shadow_pcf(shadow_map: texture2d<f32>, shadow_sampler: sampler, shadow_coord: vec3<f32>, texel_size: f32) -> f32 {
    // 9-tap PCF kernel
    let offsets = [
        vec2(-1.0, -1.0), vec2(0.0, -1.0), vec2(1.0, -1.0),
        vec2(-1.0,  0.0), vec2(0.0,  0.0), vec2(1.0,  0.0),
        vec2(-1.0,  1.0), vec2(0.0,  1.0), vec2(1.0,  1.0),
    ]
    let mut shadow = 0.0
    for offset in offsets {
        let sample_coord = shadow_coord.xy + offset * texel_size
        let closest_depth = sample(shadow_map, shadow_sampler, sample_coord).r
        shadow += if shadow_coord.z - 0.005 <= closest_depth { 1.0 } else { 0.0 }
    }
    shadow / 9.0
}

fn reconstruct_world_pos(depth: f32, uv: vec2<f32>, inv_proj: mat4<f32>, inv_view: mat4<f32>) -> vec3<f32> {
    let ndc_x = uv.x * 2.0 - 1.0
    let ndc_y = 1.0 - uv.y * 2.0
    let clip_pos = vec4(ndc_x, ndc_y, depth * 2.0 - 1.0, 1.0)
    let view_pos = inv_proj * clip_pos
    let view_pos = view_pos / view_pos.w
    let world_pos = inv_view * view_pos
    world_pos.xyz
}

fn aces_tonemap(x: vec3<f32>) -> vec3<f32> {
    let a = 2.51
    let b = vec3(0.03, 0.03, 0.03)
    let c = 2.43
    let d = vec3(0.59, 0.59, 0.59)
    let e = vec3(0.14, 0.14, 0.14)
    ((x * (a * x + b)) / (x * (c * x + d) + e)).clamp(vec3(0.0), vec3(1.0))
}

fn linear_to_srgb(c: vec3<f32>) -> vec3<f32> {
    let lo = c * 12.92
    let hi = 1.055 * c.pow(1.0 / 2.4) - vec3(0.055)
    vec3(
        if c.x < 0.0031308 { lo.x } else { hi.x },
        if c.y < 0.0031308 { lo.y } else { hi.y },
        if c.z < 0.0031308 { lo.z } else { hi.z },
    )
}

fn triplanar_sample(albedo_tex: texture2d<f32>, samp: sampler, world_pos: vec3<f32>, world_normal: vec3<f32>, tile: f32) -> vec4<f32> {
    let blend = world_normal.abs()
    let blend = blend / (blend.x + blend.y + blend.z + 1e-7)
    let tx = sample(albedo_tex, samp, world_pos.yz * tile)
    let ty = sample(albedo_tex, samp, world_pos.xz * tile)
    let tz = sample(albedo_tex, samp, world_pos.xy * tile)
    tx * blend.x + ty * blend.y + tz * blend.z
}

// ============================================================================
// FORWARD PASS — Lambert + Phong
// ============================================================================

struct ForwardVertexIn {
    @location(0) position: vec3<f32>,
    @location(1) normal:   vec3<f32>,
    @location(2) uv:       vec2<f32>,
    @location(3) tangent:  vec4<f32>,
}

struct ForwardVertexOut {
    @builtin(position) clip_pos: vec4<f32>,
    @location(0) world_pos:  vec3<f32>,
    @location(1) world_norm: vec3<f32>,
    @location(2) uv:         vec2<f32>,
    @location(3) tangent:    vec3<f32>,
    @location(4) bitangent:  vec3<f32>,
    @location(5) shadow_coord: vec4<f32>,
}

struct ForwardUniforms {
    model:       mat4<f32>,
    view:        mat4<f32>,
    projection:  mat4<f32>,
    normal_mat:  mat3<f32>,
    light_mvp:   mat4<f32>,
    camera_pos:  vec3<f32>,
    time:        f32,
}

struct ForwardMaterialUniforms {
    albedo_color:   vec4<f32>,
    roughness:      f32,
    metallic:       f32,
    emissive_scale: f32,
    uv_scale:       vec2<f32>,
    uv_offset:      vec2<f32>,
}

pipeline ForwardPass {
    vertex_shader = forward_vert
    fragment_shader = forward_frag
    topology = triangle_list
    cull_mode = back
    depth_test = less_equal
    depth_write = true
    blend = none
    sample_count = 4

    bind_group(0) {
        uniform ForwardUniforms as frame_uniforms at binding(0)
        uniform ForwardMaterialUniforms as material at binding(1)
    }
    bind_group(1) {
        texture2d<f32> as albedo_tex at binding(0)
        texture2d<f32> as normal_tex at binding(1)
        texture2d<f32> as roughness_metallic_tex at binding(2)
        texture2d<f32> as emissive_tex at binding(3)
        texture2d<f32> as shadow_map at binding(4)
        sampler as tex_sampler at binding(5)
        sampler as shadow_sampler at binding(6)
    }

    shader vertex_shader forward_vert(vin: ForwardVertexIn) -> ForwardVertexOut {
        let world_pos = (frame_uniforms.model * vec4(vin.position, 1.0)).xyz
        let clip_pos  = frame_uniforms.projection * frame_uniforms.view * vec4(world_pos, 1.0)
        let world_norm = normalize(frame_uniforms.normal_mat * vin.normal)
        let world_tang = normalize(frame_uniforms.normal_mat * vin.tangent.xyz)
        let world_btan = normalize(cross(world_norm, world_tang) * vin.tangent.w)
        let shadow_coord = frame_uniforms.light_mvp * vec4(world_pos, 1.0)
        ForwardVertexOut {
            clip_pos,
            world_pos,
            world_norm,
            uv: vin.uv * material.uv_scale + material.uv_offset,
            tangent: world_tang,
            bitangent: world_btan,
            shadow_coord,
        }
    }

    shader fragment_shader forward_frag(fin: ForwardVertexOut) -> @location(0) vec4<f32> {
        let albedo_sample = sample(albedo_tex, tex_sampler, fin.uv) * material.albedo_color
        let albedo = pow(albedo_sample.rgb, vec3(2.2))  // gamma to linear

        // Normal map
        let n_map = sample(normal_tex, tex_sampler, fin.uv).xyz * 2.0 - 1.0
        let tbn = mat3(fin.tangent, fin.bitangent, fin.world_norm)
        let N = normalize(tbn * n_map)

        let rm = sample(roughness_metallic_tex, tex_sampler, fin.uv)
        let roughness = rm.g * material.roughness
        let metallic  = rm.b * material.metallic

        let V = normalize(frame_uniforms.camera_pos - fin.world_pos)
        let L = normalize(vec3(0.5, 1.0, 0.7))  // Directional light direction
        let H = normalize(V + L)

        let n_dot_l = max(dot(N, L), 0.0)
        let n_dot_v = max(dot(N, V), 0.001)
        let n_dot_h = max(dot(N, H), 0.0)
        let h_dot_v = max(dot(H, V), 0.0)

        // PBR - Cook-Torrance BRDF
        let f0 = mix(vec3(0.04), albedo, metallic)
        let D  = ggx_distribution(n_dot_h, roughness)
        let G  = schlick_smith_geometry(n_dot_v, n_dot_l, roughness)
        let F  = fresnel_schlick(h_dot_v, f0)

        let numerator = D * G * F
        let denom = 4.0 * n_dot_v * n_dot_l + 0.001
        let specular = numerator / denom

        let kd = (vec3(1.0) - F) * (1.0 - metallic)
        let diffuse = kd * albedo / 3.14159265

        let light_color = vec3(1.0, 0.95, 0.8) * 3.0
        let shadow_coord_ndc = fin.shadow_coord.xyz / fin.shadow_coord.w
        let shadow_uv = shadow_coord_ndc.xy * 0.5 + 0.5
        let shadow = shadow_pcf(shadow_map, shadow_sampler, vec3(shadow_uv, shadow_coord_ndc.z), 1.0 / 2048.0)

        let Lo = (diffuse + specular) * light_color * n_dot_l * shadow

        // Ambient
        let ambient = vec3(0.03) * albedo

        // Emissive
        let emissive = sample(emissive_tex, tex_sampler, fin.uv).rgb * material.emissive_scale

        let color = ambient + Lo + emissive
        vec4(linear_to_srgb(color), albedo_sample.a)
    }
}

// ============================================================================
// SHADOW MAP PASS
// ============================================================================

struct ShadowVertexIn {
    @location(0) position: vec3<f32>,
}

struct ShadowVertexOut {
    @builtin(position) clip_pos: vec4<f32>,
}

struct ShadowUniforms {
    light_vp: mat4<f32>,
    model:    mat4<f32>,
}

pipeline ShadowMapPass {
    vertex_shader   = shadow_vert
    fragment_shader = shadow_frag_empty
    topology    = triangle_list
    cull_mode   = front
    depth_test  = less
    depth_write = true
    blend       = none
    color_write = none  // Depth-only output

    bind_group(0) {
        uniform ShadowUniforms as shadow_uniforms at binding(0)
    }

    output {
        depth_attachment: depth24plus at size(2048, 2048)
    }

    shader vertex_shader shadow_vert(vin: ShadowVertexIn) -> ShadowVertexOut {
        let world_pos = shadow_uniforms.model * vec4(vin.position, 1.0)
        ShadowVertexOut { clip_pos: shadow_uniforms.light_vp * world_pos }
    }

    shader fragment_shader shadow_frag_empty() { /* depth written automatically */ }
}

// ============================================================================
// DEFERRED G-BUFFER PASS
// ============================================================================

struct GBufferVertexOut {
    @builtin(position) clip_pos: vec4<f32>,
    @location(0) world_pos:  vec3<f32>,
    @location(1) world_norm: vec3<f32>,
    @location(2) uv:         vec2<f32>,
    @location(3) world_tang: vec3<f32>,
    @location(4) world_btan: vec3<f32>,
}

struct GBufferOutput {
    @location(0) albedo:   vec4<f32>,    // rgba8  — RGB albedo + alpha
    @location(1) normal:   vec4<f32>,    // rgba16f — encoded world normal
    @location(2) material: vec2<f32>,    // rg8    — metallic, roughness
    @location(3) emissive: vec4<f32>,    // rgba8  — emissive
}

pipeline DeferredGBuffer {
    vertex_shader   = gbuffer_vert
    fragment_shader = gbuffer_frag
    topology    = triangle_list
    cull_mode   = back
    depth_test  = less_equal
    depth_write = true
    blend       = none
    sample_count = 1

    bind_group(0) {
        uniform ForwardUniforms as frame_uniforms at binding(0)
        uniform ForwardMaterialUniforms as material at binding(1)
    }
    bind_group(1) {
        texture2d<f32> as albedo_tex  at binding(0)
        texture2d<f32> as normal_tex  at binding(1)
        texture2d<f32> as rm_tex      at binding(2)
        texture2d<f32> as emissive_tex at binding(3)
        sampler as tex_sampler at binding(4)
    }

    output {
        color[0]: rgba8unorm  at attachment(0)
        color[1]: rgba16float at attachment(1)
        color[2]: rg8unorm    at attachment(2)
        color[3]: rgba8unorm  at attachment(3)
        depth:    depth24plus
    }

    shader vertex_shader gbuffer_vert(vin: ForwardVertexIn) -> GBufferVertexOut {
        let world_pos = (frame_uniforms.model * vec4(vin.position, 1.0)).xyz
        let clip_pos  = frame_uniforms.projection * frame_uniforms.view * vec4(world_pos, 1.0)
        let world_norm = normalize(frame_uniforms.normal_mat * vin.normal)
        let world_tang = normalize(frame_uniforms.normal_mat * vin.tangent.xyz)
        let world_btan = cross(world_norm, world_tang) * vin.tangent.w
        GBufferVertexOut { clip_pos, world_pos, world_norm, uv: vin.uv * material.uv_scale + material.uv_offset, world_tang, world_btan }
    }

    shader fragment_shader gbuffer_frag(fin: GBufferVertexOut) -> GBufferOutput {
        let albedo = sample(albedo_tex, tex_sampler, fin.uv) * material.albedo_color
        let n_map  = sample(normal_tex, tex_sampler, fin.uv).xyz * 2.0 - 1.0
        let tbn    = mat3(fin.world_tang, fin.world_btan, fin.world_norm)
        let N      = normalize(tbn * n_map)
        let rm     = sample(rm_tex, tex_sampler, fin.uv)
        let emissive = sample(emissive_tex, tex_sampler, fin.uv) * material.emissive_scale
        GBufferOutput {
            albedo: albedo,
            normal: vec4(N * 0.5 + 0.5, 1.0),
            material: vec2(rm.b * material.metallic, rm.g * material.roughness),
            emissive: emissive,
        }
    }
}

// ============================================================================
// DEFERRED LIGHTING PASS (PBR BRDF)
// ============================================================================

struct FullscreenVertexOut {
    @builtin(position) clip_pos: vec4<f32>,
    @location(0) uv: vec2<f32>,
}

struct DeferredLightingUniforms {
    inv_view:     mat4<f32>,
    inv_proj:     mat4<f32>,
    camera_pos:   vec3<f32>,
    light_mvp:    mat4<f32>,
    dir_light_dir: vec3<f32>,
    dir_light_color: vec3<f32>,
    dir_light_intensity: f32,
    point_light_positions: array<vec4<f32>, 16>,  // .w = range
    point_light_colors:    array<vec4<f32>, 16>,  // .w = intensity
    point_light_count: u32,
    ambient_scale: f32,
}

pipeline DeferredLightingPass {
    vertex_shader   = fullscreen_vert
    fragment_shader = deferred_lighting_frag
    topology    = triangle_list
    cull_mode   = none
    depth_test  = always
    depth_write = false
    blend       = none

    bind_group(0) {
        uniform DeferredLightingUniforms as lighting_uniforms at binding(0)
    }
    bind_group(1) {
        texture2d<f32> as g_albedo   at binding(0)
        texture2d<f32> as g_normal   at binding(1)
        texture2d<f32> as g_material at binding(2)
        texture2d<f32> as g_emissive at binding(3)
        texture2d<f32> as g_depth    at binding(4)
        texture2d<f32> as shadow_map at binding(5)
        sampler as g_sampler      at binding(6)
        sampler as shadow_sampler at binding(7)
    }

    shader vertex_shader fullscreen_vert(@builtin(vertex_index) vi: u32) -> FullscreenVertexOut {
        let uv = vec2(f32((vi << 1) & 2), f32(vi & 2))
        FullscreenVertexOut { clip_pos: vec4(uv * 2.0 - 1.0, 0.0, 1.0), uv }
    }

    shader fragment_shader deferred_lighting_frag(fin: FullscreenVertexOut) -> @location(0) vec4<f32> {
        let albedo   = pow(sample(g_albedo,   g_sampler, fin.uv).rgb, vec3(2.2))
        let norm_enc = sample(g_normal,   g_sampler, fin.uv).rgb
        let N        = normalize(norm_enc * 2.0 - 1.0)
        let mat_val  = sample(g_material, g_sampler, fin.uv).rg
        let metallic = mat_val.r
        let roughness = mat_val.g
        let emissive = sample(g_emissive, g_sampler, fin.uv).rgb
        let depth    = sample(g_depth, g_sampler, fin.uv).r

        let world_pos = reconstruct_world_pos(depth, fin.uv, lighting_uniforms.inv_proj, lighting_uniforms.inv_view)
        let V = normalize(lighting_uniforms.camera_pos - world_pos)
        let n_dot_v = max(dot(N, V), 0.001)
        let f0 = mix(vec3(0.04), albedo, metallic)

        var Lo = vec3(0.0)

        // Directional light contribution
        {
            let L = normalize(-lighting_uniforms.dir_light_dir)
            let H = normalize(V + L)
            let n_dot_l = max(dot(N, L), 0.0)
            let n_dot_h = max(dot(N, H), 0.0)
            let h_dot_v = max(dot(H, V), 0.0)
            let D = ggx_distribution(n_dot_h, roughness)
            let G = schlick_smith_geometry(n_dot_v, n_dot_l, roughness)
            let F = fresnel_schlick(h_dot_v, f0)
            let kd = (vec3(1.0) - F) * (1.0 - metallic)
            let brdf = kd * albedo / 3.14159265 + F * D * G / (4.0 * n_dot_v * n_dot_l + 0.001)
            let light_rad = lighting_uniforms.dir_light_color * lighting_uniforms.dir_light_intensity

            // Shadow
            let shadow_coord = lighting_uniforms.light_mvp * vec4(world_pos, 1.0)
            let sc_ndc = shadow_coord.xyz / shadow_coord.w
            let sc_uv  = sc_ndc.xy * 0.5 + 0.5
            let shadow = shadow_pcf(shadow_map, shadow_sampler, vec3(sc_uv, sc_ndc.z), 1.0 / 2048.0)

            Lo += brdf * light_rad * n_dot_l * shadow
        }

        // Point lights
        for i in 0u..lighting_uniforms.point_light_count {
            let pl_pos   = lighting_uniforms.point_light_positions[i].xyz
            let pl_range = lighting_uniforms.point_light_positions[i].w
            let pl_color = lighting_uniforms.point_light_colors[i].rgb
            let pl_int   = lighting_uniforms.point_light_colors[i].w

            let to_light = pl_pos - world_pos
            let dist     = length(to_light)
            if dist >= pl_range { continue }

            let L = normalize(to_light)
            let H = normalize(V + L)
            let n_dot_l = max(dot(N, L), 0.0)
            let n_dot_h = max(dot(N, H), 0.0)
            let h_dot_v = max(dot(H, V), 0.0)

            let D = ggx_distribution(n_dot_h, roughness)
            let G = schlick_smith_geometry(n_dot_v, n_dot_l, roughness)
            let F = fresnel_schlick(h_dot_v, f0)
            let kd = (vec3(1.0) - F) * (1.0 - metallic)
            let brdf = kd * albedo / 3.14159265 + F * D * G / (4.0 * n_dot_v * n_dot_l + 0.001)

            let attenuation = 1.0 / (dist * dist)
            let window = (1.0 - (dist / pl_range).pow(4.0)).max(0.0).pow(2.0)  // smooth range falloff
            let radiance = pl_color * pl_int * attenuation * window

            Lo += brdf * radiance * n_dot_l
        }

        let ambient = vec3(lighting_uniforms.ambient_scale) * albedo
        let color   = ambient + Lo + emissive
        vec4(linear_to_srgb(color), 1.0)
    }
}

// ============================================================================
// SSAO PASS
// ============================================================================

struct SsaoUniforms {
    projection:   mat4<f32>,
    view:         mat4<f32>,
    inv_proj:     mat4<f32>,
    kernel:       array<vec4<f32>, 16>,
    noise_scale:  vec2<f32>,
    radius:       f32,
    bias:         f32,
    power:        f32,
}

pipeline SsaoPass {
    vertex_shader   = fullscreen_vert
    fragment_shader = ssao_frag
    topology    = triangle_list
    cull_mode   = none
    depth_test  = always
    depth_write = false

    bind_group(0) {
        uniform SsaoUniforms as ssao_uniforms at binding(0)
    }
    bind_group(1) {
        texture2d<f32> as g_normal  at binding(0)
        texture2d<f32> as g_depth   at binding(1)
        texture2d<f32> as noise_tex at binding(2)
        sampler as g_sampler     at binding(3)
        sampler as noise_sampler at binding(4)
    }

    shader fragment_shader ssao_frag(fin: FullscreenVertexOut) -> @location(0) vec4<f32> {
        let N_enc = sample(g_normal, g_sampler, fin.uv).rgb
        let N     = normalize(N_enc * 2.0 - 1.0)
        let depth = sample(g_depth, g_sampler, fin.uv).r
        let frag_pos = reconstruct_world_pos(depth, fin.uv, ssao_uniforms.inv_proj, mat4_identity())

        let random_vec = sample(noise_tex, noise_sampler, fin.uv * ssao_uniforms.noise_scale).xyz * 2.0 - 1.0
        let tangent  = normalize(random_vec - N * dot(random_vec, N))
        let bitangent = cross(N, tangent)
        let tbn = mat3(tangent, bitangent, N)

        var occlusion = 0.0
        for i in 0u..16u {
            let kernel_sample = tbn * ssao_uniforms.kernel[i].xyz
            let sample_pos = frag_pos + kernel_sample * ssao_uniforms.radius

            // Project sample to screen space
            let offset = ssao_uniforms.projection * ssao_uniforms.view * vec4(sample_pos, 1.0)
            let offset_ndc = offset.xyz / offset.w
            let sample_uv = offset_ndc.xy * 0.5 + 0.5

            let sample_depth = sample(g_depth, g_sampler, sample_uv).r
            let sample_world = reconstruct_world_pos(sample_depth, sample_uv, ssao_uniforms.inv_proj, mat4_identity())

            let range_check = smoothstep(0.0, 1.0, ssao_uniforms.radius / abs(frag_pos.z - sample_world.z) + 1e-5)
            occlusion += if sample_world.z >= sample_pos.z + ssao_uniforms.bias { 1.0 } else { 0.0 } * range_check
        }

        let ao = 1.0 - (occlusion / 16.0).pow(ssao_uniforms.power)
        vec4(ao, ao, ao, 1.0)
    }
}

// ============================================================================
// BLOOM PASS
// ============================================================================

struct BloomUniforms {
    threshold: f32,
    intensity: f32,
    upsample_filter_radius: f32,
}

pipeline BloomPass {
    vertex_shader   = fullscreen_vert
    fragment_shader = bloom_frag
    topology    = triangle_list
    cull_mode   = none
    depth_test  = always
    depth_write = false
    blend       = additive

    bind_group(0) {
        uniform BloomUniforms as bloom_uniforms at binding(0)
    }
    bind_group(1) {
        texture2d<f32> as hdr_input   at binding(0)
        texture2d<f32> as bloom_mip0  at binding(1)
        texture2d<f32> as bloom_mip1  at binding(2)
        texture2d<f32> as bloom_mip2  at binding(3)
        texture2d<f32> as bloom_mip3  at binding(4)
        texture2d<f32> as bloom_mip4  at binding(5)
        texture2d<f32> as bloom_mip5  at binding(6)
        sampler as bloom_sampler at binding(7)
    }

    shader fragment_shader bloom_frag(fin: FullscreenVertexOut) -> @location(0) vec4<f32> {
        let hdr = sample(hdr_input, bloom_sampler, fin.uv).rgb
        // Threshold extract
        let brightness = dot(hdr, vec3(0.2126, 0.7152, 0.0722))
        let bright_color = hdr * max(brightness - bloom_uniforms.threshold, 0.0) / (brightness + 1e-5)

        // Upsample and sum pyramid with tent filter
        let r = bloom_uniforms.upsample_filter_radius
        let offsets = [
            vec2(-r,-r), vec2(0.0,-r), vec2(r,-r),
            vec2(-r, 0.0),             vec2(r, 0.0),
            vec2(-r, r),  vec2(0.0, r), vec2(r, r),
        ]
        let weights = [1.0, 2.0, 1.0,  2.0, 2.0,  1.0, 2.0, 1.0]
        let weight_sum = 12.0

        var upsample = vec3(0.0)
        for i in 0..8 {
            upsample += sample(bloom_mip0, bloom_sampler, fin.uv + offsets[i]).rgb * weights[i]
        }
        upsample /= weight_sum

        let bloom0 = sample(bloom_mip0, bloom_sampler, fin.uv).rgb
        let bloom1 = sample(bloom_mip1, bloom_sampler, fin.uv).rgb
        let bloom2 = sample(bloom_mip2, bloom_sampler, fin.uv).rgb
        let bloom3 = sample(bloom_mip3, bloom_sampler, fin.uv).rgb
        let bloom4 = sample(bloom_mip4, bloom_sampler, fin.uv).rgb
        let bloom5 = sample(bloom_mip5, bloom_sampler, fin.uv).rgb

        let bloom = (bloom0 + bloom1*0.5 + bloom2*0.25 + bloom3*0.125 + bloom4*0.0625 + bloom5*0.03125) * bloom_uniforms.intensity

        vec4(bright_color + bloom, 1.0)
    }
}

// ============================================================================
// TAA PASS (TEMPORAL ANTI-ALIASING)
// ============================================================================

struct TaaUniforms {
    jitter:      vec2<f32>,
    alpha:       f32,
    resolution:  vec2<f32>,
}

pipeline TaaPass {
    vertex_shader   = fullscreen_vert
    fragment_shader = taa_frag
    topology    = triangle_list
    cull_mode   = none
    depth_test  = always
    depth_write = false

    bind_group(0) { uniform TaaUniforms as taa_uniforms at binding(0) }
    bind_group(1) {
        texture2d<f32> as current_frame  at binding(0)
        texture2d<f32> as history_buffer at binding(1)
        texture2d<f32> as velocity_buffer at binding(2)
        sampler as frame_sampler at binding(3)
    }

    shader fragment_shader taa_frag(fin: FullscreenVertexOut) -> @location(0) vec4<f32> {
        let current = sample(current_frame, frame_sampler, fin.uv).rgb
        let velocity = sample(velocity_buffer, frame_sampler, fin.uv).rg
        let reprojected_uv = fin.uv - velocity

        // Variance clamp history to prevent ghosting
        let texel = 1.0 / taa_uniforms.resolution
        var neighbor_min = vec3(1e6)
        var neighbor_max = vec3(-1e6)
        for y in -1..=1 {
            for x in -1..=1 {
                let n = sample(current_frame, frame_sampler, fin.uv + vec2(x as f32, y as f32) * texel).rgb
                neighbor_min = min(neighbor_min, n)
                neighbor_max = max(neighbor_max, n)
            }
        }
        let history = sample(history_buffer, frame_sampler, reprojected_uv).rgb
        let clamped_history = clamp(history, neighbor_min, neighbor_max)

        let blended = mix(current, clamped_history, taa_uniforms.alpha)
        vec4(blended, 1.0)
    }
}

// ============================================================================
// FINAL COMPOSITE PASS
// ============================================================================

struct CompositeUniforms {
    exposure:    f32,
    gamma:       f32,
    film_grain:  f32,
    vignette:    f32,
    time:        f32,
    resolution:  vec2<f32>,
}

pipeline FinalCompositePass {
    vertex_shader   = fullscreen_vert
    fragment_shader = composite_frag
    topology    = triangle_list
    cull_mode   = none
    depth_test  = always
    depth_write = false
    blend       = none

    bind_group(0) { uniform CompositeUniforms as composite_uniforms at binding(0) }
    bind_group(1) {
        texture2d<f32> as hdr_input at binding(0)
        texture2d<f32> as bloom_tex at binding(1)
        texture2d<f32> as ui_overlay at binding(2)
        sampler as composite_sampler at binding(3)
    }

    shader fragment_shader composite_frag(fin: FullscreenVertexOut) -> @location(0) vec4<f32> {
        let hdr   = sample(hdr_input, composite_sampler, fin.uv).rgb
        let bloom = sample(bloom_tex,  composite_sampler, fin.uv).rgb
        let ui    = sample(ui_overlay, composite_sampler, fin.uv)

        // Exposure
        let exposed = hdr * composite_uniforms.exposure + bloom

        // ACES Tonemapping
        let tonemapped = aces_tonemap(exposed)

        // Gamma correction
        let gamma_corrected = pow(tonemapped, vec3(1.0 / composite_uniforms.gamma))

        // Film grain
        let grain_uv = fin.uv * vec2(1920.0, 1080.0) / composite_uniforms.resolution
        let grain = fract(sin(dot(grain_uv + composite_uniforms.time, vec2(127.1, 311.7))) * 43758.5453)
        let grain_offset = (grain - 0.5) * composite_uniforms.film_grain
        let grained = gamma_corrected + vec3(grain_offset)

        // Vignette
        let vig_uv = fin.uv * 2.0 - 1.0
        let vig = 1.0 - dot(vig_uv, vig_uv) * composite_uniforms.vignette
        let vignetted = grained * vig.max(0.0)

        // Composite UI over game world
        let final_color = mix(vignetted, ui.rgb, ui.a)
        vec4(clamp(final_color, vec3(0.0), vec3(1.0)), 1.0)
    }
}

// ============================================================================
// PARTICLE COMPUTE PASS
// ============================================================================

struct Particle {
    position: vec3<f32>,
    lifetime: f32,
    velocity: vec3<f32>,
    size:     f32,
    color:    vec4<f32>,
}

struct ParticleUniforms {
    emitter_pos:  vec3<f32>,
    dt:           f32,
    gravity:      vec3<f32>,
    max_lifetime: f32,
    spawn_rate:   f32,
    time:         f32,
    emit_count:   u32,
}

pipeline ParticlePass {
    compute_shader = particle_compute
    dispatch_groups = (10000 / 64 + 1, 1, 1)
    workgroup_size  = (64, 1, 1)

    bind_group(0) { uniform ParticleUniforms as particle_uniforms at binding(0) }
    bind_group(1) {
        storage_rw array<Particle> as particles at binding(0)
    }

    shader compute_shader particle_compute(@builtin(global_invocation_id) gid: vec3<u32>) {
        let idx = gid.x
        if idx >= 10000u { return }

        let p = &particles[idx]

        if p.lifetime <= 0.0 {
            // Respawn particle
            if idx < particle_uniforms.emit_count {
                let seed = idx as f32 + particle_uniforms.time * 1000.0
                let angle = fract(sin(seed * 127.1) * 43758.5) * 6.283185
                let speed = 2.0 + fract(sin(seed * 311.7) * 43758.5) * 3.0
                p.position = particle_uniforms.emitter_pos
                p.velocity = vec3(cos(angle) * speed, 5.0 + fract(sin(seed * 512.3) * 100.0) * 5.0, sin(angle) * speed)
                p.lifetime = particle_uniforms.max_lifetime * (0.5 + fract(sin(seed * 97.3) * 100.0) * 0.5)
                p.size = 0.05 + fract(sin(seed * 213.7) * 100.0) * 0.1
                let hue = fract(seed * 0.01)
                p.color = vec4(hue, 0.8, 1.0 - hue, 1.0)
            }
            return
        }

        // Integrate
        p.velocity += particle_uniforms.gravity * particle_uniforms.dt
        p.velocity *= 0.99  // drag
        p.position += p.velocity * particle_uniforms.dt
        p.lifetime -= particle_uniforms.dt
        p.color.a = (p.lifetime / particle_uniforms.max_lifetime).pow(0.5)
    }
}

// ============================================================================
// TERRAIN PASS
// ============================================================================

struct TerrainUniforms {
    view_proj:     mat4<f32>,
    camera_pos:    vec3<f32>,
    lod_distances: vec4<f32>,  // distances for LOD levels 0..3
    height_scale:  f32,
    uv_scale:      f32,
}

pipeline TerrainPass {
    vertex_shader     = terrain_vert
    tesscontrol_shader = terrain_tess_ctrl
    tesseval_shader    = terrain_tess_eval
    fragment_shader    = terrain_frag
    topology    = patch_list
    cull_mode   = back
    depth_test  = less_equal
    depth_write = true

    bind_group(0) { uniform TerrainUniforms as terrain_uniforms at binding(0) }
    bind_group(1) {
        texture2d<f32> as heightmap at binding(0)
        texture2d<f32> as rock_tex  at binding(1)
        texture2d<f32> as grass_tex at binding(2)
        texture2d<f32> as snow_tex  at binding(3)
        texture2d<f32> as sand_tex  at binding(4)
        sampler as terrain_sampler at binding(5)
    }

    shader vertex_shader terrain_vert(vin: ForwardVertexIn) -> ForwardVertexOut {
        let clip = terrain_uniforms.view_proj * vec4(vin.position, 1.0)
        ForwardVertexOut {
            clip_pos: clip,
            world_pos: vin.position,
            world_norm: vin.normal,
            uv: vin.uv,
            tangent: vec3(1.0, 0.0, 0.0),
            bitangent: vec3(0.0, 0.0, 1.0),
            shadow_coord: vec4(0.0),
        }
    }

    shader tesscontrol_shader terrain_tess_ctrl(in: ForwardVertexOut[3]) -> @patch ForwardVertexOut[3] {
        let dist = length(terrain_uniforms.camera_pos - in[0].world_pos)
        let tess_level = if dist < terrain_uniforms.lod_distances.x { 64.0 }
                    else if dist < terrain_uniforms.lod_distances.y { 32.0 }
                    else if dist < terrain_uniforms.lod_distances.z { 16.0 }
                    else if dist < terrain_uniforms.lod_distances.w {  8.0 }
                    else                                             {  4.0 }
        @outer_level = vec4(tess_level)
        @inner_level = vec2(tess_level)
        in
    }

    shader tesseval_shader terrain_tess_eval(in: ForwardVertexOut, bary: vec3<f32>) -> ForwardVertexOut {
        var out = interpolate_vertex(in, bary)
        let height = sample(heightmap, terrain_sampler, out.uv).r * terrain_uniforms.height_scale
        out.world_pos.y = height
        out.clip_pos = terrain_uniforms.view_proj * vec4(out.world_pos, 1.0)
        // Compute normal via finite differences
        let step = 1.0 / 512.0
        let hr = sample(heightmap, terrain_sampler, out.uv + vec2(step, 0.0)).r * terrain_uniforms.height_scale
        let hu = sample(heightmap, terrain_sampler, out.uv + vec2(0.0, step)).r * terrain_uniforms.height_scale
        out.world_norm = normalize(vec3(height - hr, step, height - hu))
        out
    }

    shader fragment_shader terrain_frag(fin: ForwardVertexOut) -> @location(0) vec4<f32> {
        let height = fin.world_pos.y / terrain_uniforms.height_scale

        let rock  = triplanar_sample(rock_tex,  terrain_sampler, fin.world_pos, fin.world_norm, terrain_uniforms.uv_scale)
        let grass = triplanar_sample(grass_tex, terrain_sampler, fin.world_pos, fin.world_norm, terrain_uniforms.uv_scale)
        let snow  = triplanar_sample(snow_tex,  terrain_sampler, fin.world_pos, fin.world_norm, terrain_uniforms.uv_scale)
        let sand  = triplanar_sample(sand_tex,  terrain_sampler, fin.world_pos, fin.world_norm, terrain_uniforms.uv_scale)

        let slope = 1.0 - fin.world_norm.y
        let rock_blend  = smoothstep(0.3, 0.7, slope)
        let snow_blend  = smoothstep(0.7, 0.85, height)
        let sand_blend  = smoothstep(0.05, 0.1, height).max(0.0)  // near water level

        let base = mix(grass, rock, rock_blend)
        let with_sand = mix(sand, base, sand_blend)
        let final_albedo = mix(with_sand, snow, snow_blend)

        let N = fin.world_norm
        let L = normalize(vec3(0.5, 1.0, 0.7))
        let n_dot_l = max(dot(N, L), 0.0)
        let lit = final_albedo.rgb * (0.1 + 0.9 * n_dot_l)
        vec4(linear_to_srgb(lit), 1.0)
    }
}

// ============================================================================
// RENDER GRAPH
// ============================================================================

struct TransientTexture {
    id: u32,
    width: u32,
    height: u32,
    format: String,
    in_use: bool,
}

struct RenderPassNode {
    name: String,
    order: u32,
    inputs: Vec<String>,
    outputs: Vec<String>,
    enabled: bool,
}

struct RenderGraph {
    passes: Vec<RenderPassNode>,
    transient_textures: HashMap<String, TransientTexture>,
    next_texture_id: u32,
    execution_order: Vec<String>,
}

impl RenderGraph {
    fn new() -> Self {
        RenderGraph {
            passes: Vec::new(),
            transient_textures: HashMap::new(),
            next_texture_id: 1,
            execution_order: Vec::new(),
        }
    }

    fn add_pass(&mut self, name: &str, order: u32, inputs: Vec<&str>, outputs: Vec<&str>) {
        self.passes.push(RenderPassNode {
            name: name.to_string(),
            order,
            inputs: inputs.iter().map(|s| s.to_string()).collect(),
            outputs: outputs.iter().map(|s| s.to_string()).collect(),
            enabled: true,
        })
    }

    fn allocate_transient(&mut self, name: &str, width: u32, height: u32, format: &str) -> u32 {
        let id = self.next_texture_id
        self.next_texture_id += 1
        self.transient_textures.insert(name.to_string(), TransientTexture {
            id,
            width,
            height,
            format: format.to_string(),
            in_use: true,
        })
        id
    }

    fn build_execution_order(&mut self) {
        // Topological sort by order field
        let mut sorted = self.passes.clone()
        sorted.sort_by_key(|p| p.order)
        self.execution_order = sorted.iter()
            .filter(|p| p.enabled)
            .map(|p| p.name.clone())
            .collect()
    }

    fn execute(&self) {
        println!("[RenderGraph] Executing {} passes:", self.execution_order.len())
        for (i, pass_name) in self.execution_order.iter().enumerate() {
            if let Option::Some(pass) = self.passes.iter().find(|p| &p.name == pass_name) {
                println!("  [{:2}] {} (inputs={:?} → outputs={:?})", i + 1, pass.name, pass.inputs, pass.outputs)
            }
        }
        println!("[RenderGraph] Transient textures: {}", self.transient_textures.len())
        for (name, tex) in &self.transient_textures {
            println!("  {} — {}×{} {} (id={})", name, tex.width, tex.height, tex.format, tex.id)
        }
    }

    fn release_transient(&mut self, name: &str) {
        if let Option::Some(tex) = self.transient_textures.get_mut(name) {
            tex.in_use = false
        }
    }
}

fn build_game_render_graph() -> RenderGraph {
    let mut rg = RenderGraph::new()

    // Allocate transient textures
    rg.allocate_transient("shadow_map",       2048, 2048, "depth24plus")
    rg.allocate_transient("g_albedo",         1920, 1080, "rgba8unorm")
    rg.allocate_transient("g_normal",         1920, 1080, "rgba16float")
    rg.allocate_transient("g_material",       1920, 1080, "rg8unorm")
    rg.allocate_transient("g_emissive",       1920, 1080, "rgba8unorm")
    rg.allocate_transient("g_depth",          1920, 1080, "depth24plus")
    rg.allocate_transient("hdr_lit",          1920, 1080, "rgba16float")
    rg.allocate_transient("ssao",              960,  540, "r8unorm")
    rg.allocate_transient("bloom_extract",    1920, 1080, "rgba16float")
    rg.allocate_transient("bloom_mip0",        960,  540, "rgba16float")
    rg.allocate_transient("bloom_mip1",        480,  270, "rgba16float")
    rg.allocate_transient("bloom_mip2",        240,  135, "rgba16float")
    rg.allocate_transient("bloom_mip3",        120,   68, "rgba16float")
    rg.allocate_transient("bloom_mip4",         60,   34, "rgba16float")
    rg.allocate_transient("bloom_mip5",         30,   17, "rgba16float")
    rg.allocate_transient("taa_history",      1920, 1080, "rgba16float")
    rg.allocate_transient("taa_output",       1920, 1080, "rgba16float")
    rg.allocate_transient("particle_buffer",  1920, 1080, "rgba16float")
    rg.allocate_transient("ui_overlay",       1920, 1080, "rgba8unorm")

    // Register passes
    rg.add_pass("ShadowMapPass",      0,  vec![],                                   vec!["shadow_map"])
    rg.add_pass("ParticlePass",       5,  vec![],                                   vec!["particle_buffer"])
    rg.add_pass("DeferredGBuffer",    10, vec![],                                   vec!["g_albedo","g_normal","g_material","g_emissive","g_depth"])
    rg.add_pass("TerrainPass",        15, vec![],                                   vec!["g_albedo","g_normal","g_depth"])
    rg.add_pass("SsaoPass",           20, vec!["g_normal","g_depth"],               vec!["ssao"])
    rg.add_pass("DeferredLighting",   30, vec!["g_albedo","g_normal","g_material","g_emissive","g_depth","shadow_map","ssao"], vec!["hdr_lit"])
    rg.add_pass("ForwardPass",        35, vec!["hdr_lit","shadow_map"],             vec!["hdr_lit"])
    rg.add_pass("BloomPass",          40, vec!["hdr_lit"],                          vec!["bloom_mip0","bloom_mip1","bloom_mip2","bloom_mip3","bloom_mip4","bloom_mip5"])
    rg.add_pass("TaaPass",            50, vec!["hdr_lit","taa_history"],            vec!["taa_output"])
    rg.add_pass("FinalComposite",     60, vec!["taa_output","bloom_mip0","ui_overlay"], vec!["swapchain"])

    rg.build_execution_order()
    rg
}

// ============================================================================
// ENTRY POINT
// ============================================================================

fn main() {
    println!("╔══════════════════════════════════════╗")
    println!("║  Game Renderer — HELIX               ║")
    println!("╚══════════════════════════════════════╝\n")

    let mut rg = build_game_render_graph()
    println!("Render graph constructed:")
    rg.execute()

    println!("\nPipelines compiled:")
    println!("  [1] ShadowMapPass        — depth-only 2048×2048")
    println!("  [2] DeferredGBuffer      — 4 render targets (albedo, normal, material, emissive)")
    println!("  [3] TerrainPass          — tessellated heightmap, 4-level LOD")
    println!("  [4] SsaoPass             — 16-sample hemisphere, 960×540")
    println!("  [5] DeferredLightingPass — PBR Cook-Torrance GGX + point lights")
    println!("  [6] ForwardPass          — transparent objects, Lambert+Phong")
    println!("  [7] BloomPass            — 6-level pyramid, tent upsample")
    println!("  [8] TaaPass              — history blend α=0.1, variance clamp")
    println!("  [9] ParticlePass         — 10K GPU particles, compute shader")
    println!("  [10] FinalComposite      — ACES tonemap + grain + vignette + UI")
    println!("\nRender graph execution order:")
    for (i, pass) in rg.execution_order.iter().enumerate() {
        println!("  {:2}. {}", i + 1, pass)
    }
}
