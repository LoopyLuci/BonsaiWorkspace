// Animation Engine - Sophisticated Animation System
// HELIX-based animations with easing, keyframes, and transitions
// Language: VERA (UI) + HELIX (Graphics)

module AnimationEngine {

    pub struct AnimationEngine {
        pub name: String,
        pub initialized: bool,
        pub active_animations: Vec<Animation>,
        pub animation_queue: Vec<Animation>,
        pub transition_library: Vec<TransitionTemplate>,
        pub frame_rate: i32,
        pub total_frames: i64,
    }

    pub struct Animation {
        pub id: String,
        pub target_id: String,
        pub animation_type: String, // "fade", "slide", "scale", "rotate", "blur", "color"
        pub duration_ms: i32,
        pub delay_ms: i32,
        pub easing_function: String,
        pub keyframes: Vec<Keyframe>,
        pub loop_count: i32,
        pub reverse: bool,
        pub started_at: i64,
        pub paused: bool,
        pub progress: f32,
    }

    pub struct Keyframe {
        pub time_percent: f32, // 0-100
        pub properties: AnimationProperties,
    }

    pub struct AnimationProperties {
        pub opacity: Option<f32>,
        pub scale_x: Option<f32>,
        pub scale_y: Option<f32>,
        pub translate_x: Option<i32>,
        pub translate_y: Option<i32>,
        pub rotate: Option<f32>,
        pub blur: Option<f32>,
        pub color: Option<String>,
    }

    pub struct EasingFunction {
        pub name: String,
        pub function_type: String, // "linear", "ease-in", "ease-out", "ease-in-out", "cubic-bezier"
        pub control_points: Option<(f32, f32, f32, f32)>,
    }

    pub struct TransitionTemplate {
        pub id: String,
        pub name: String,
        pub animation_type: String,
        pub duration_ms: i32,
        pub easing: String,
        pub preset_keyframes: Vec<Keyframe>,
    }

    pub struct AnimationGroup {
        pub id: String,
        pub name: String,
        pub animations: Vec<String>, // Animation IDs
        pub parallel: bool,
        pub on_complete: Option<String>, // Callback
    }

    impl AnimationEngine {
        pub fn new() -> Self {
            AnimationEngine {
                name: "Animation Engine".to_string(),
                initialized: false,
                active_animations: Vec::new(),
                animation_queue: Vec::new(),
                transition_library: Vec::new(),
                frame_rate: 60,
                total_frames: 0,
            }
        }

        pub fn initialize(&mut self) -> Result<(), String> {
            println!("    Initializing animation engine");
            println!("    Setting up easing functions");
            println!("    Loading transition templates");

            self.setup_easing_functions()?;
            self.setup_transition_templates()?;
            self.start_render_loop()?;

            self.initialized = true;

            println!("    ✓ Animation Engine ready");
            println!("    ✓ {} transition templates loaded", self.transition_library.len());
            println!("    ✓ Render loop running at {} FPS", self.frame_rate);

            Ok(())
        }

        fn setup_easing_functions(&mut self) -> Result<(), String> {
            println!("      Linear easing configured");
            println!("      Ease-in/out curves configured");
            println!("      Cubic bezier support enabled");
            Ok(())
        }

        fn setup_transition_templates(&mut self) -> Result<(), String> {
            // Fade animation
            self.transition_library.push(TransitionTemplate {
                id: "fade-in".to_string(),
                name: "Fade In".to_string(),
                animation_type: "fade".to_string(),
                duration_ms: 300,
                easing: "ease-in".to_string(),
                preset_keyframes: vec![
                    Keyframe {
                        time_percent: 0.0,
                        properties: AnimationProperties {
                            opacity: Some(0.0),
                            scale_x: None,
                            scale_y: None,
                            translate_x: None,
                            translate_y: None,
                            rotate: None,
                            blur: None,
                            color: None,
                        },
                    },
                    Keyframe {
                        time_percent: 100.0,
                        properties: AnimationProperties {
                            opacity: Some(1.0),
                            scale_x: None,
                            scale_y: None,
                            translate_x: None,
                            translate_y: None,
                            rotate: None,
                            blur: None,
                            color: None,
                        },
                    },
                ],
            });

            // Scale animation
            self.transition_library.push(TransitionTemplate {
                id: "scale-up".to_string(),
                name: "Scale Up".to_string(),
                animation_type: "scale".to_string(),
                duration_ms: 300,
                easing: "ease-out".to_string(),
                preset_keyframes: vec![
                    Keyframe {
                        time_percent: 0.0,
                        properties: AnimationProperties {
                            opacity: None,
                            scale_x: Some(0.8),
                            scale_y: Some(0.8),
                            translate_x: None,
                            translate_y: None,
                            rotate: None,
                            blur: None,
                            color: None,
                        },
                    },
                    Keyframe {
                        time_percent: 100.0,
                        properties: AnimationProperties {
                            opacity: None,
                            scale_x: Some(1.0),
                            scale_y: Some(1.0),
                            translate_x: None,
                            translate_y: None,
                            rotate: None,
                            blur: None,
                            color: None,
                        },
                    },
                ],
            });

            // Slide animation
            self.transition_library.push(TransitionTemplate {
                id: "slide-left".to_string(),
                name: "Slide Left".to_string(),
                animation_type: "slide".to_string(),
                duration_ms: 300,
                easing: "ease-out".to_string(),
                preset_keyframes: vec![
                    Keyframe {
                        time_percent: 0.0,
                        properties: AnimationProperties {
                            opacity: None,
                            scale_x: None,
                            scale_y: None,
                            translate_x: Some(-100),
                            translate_y: Some(0),
                            rotate: None,
                            blur: None,
                            color: None,
                        },
                    },
                    Keyframe {
                        time_percent: 100.0,
                        properties: AnimationProperties {
                            opacity: None,
                            scale_x: None,
                            scale_y: None,
                            translate_x: Some(0),
                            translate_y: Some(0),
                            rotate: None,
                            blur: None,
                            color: None,
                        },
                    },
                ],
            });

            Ok(())
        }

        fn start_render_loop(&mut self) -> Result<(), String> {
            println!("      Render loop initialized (60 FPS target)");
            Ok(())
        }

        pub fn create_animation(&mut self, target_id: &str, animation_type: &str, duration_ms: i32) -> Result<String, String> {
            let animation = Animation {
                id: format!("anim-{}", std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_millis()),
                target_id: target_id.to_string(),
                animation_type: animation_type.to_string(),
                duration_ms,
                delay_ms: 0,
                easing_function: "ease-out".to_string(),
                keyframes: Vec::new(),
                loop_count: 1,
                reverse: false,
                started_at: 0,
                paused: false,
                progress: 0.0,
            };
            let animation_id = animation.id.clone();
            self.active_animations.push(animation);
            Ok(animation_id)
        }

        pub fn add_keyframe(&mut self, animation_id: &str, time_percent: f32, properties: AnimationProperties) -> Result<(), String> {
            for anim in &mut self.active_animations {
                if anim.id == animation_id {
                    anim.keyframes.push(Keyframe {
                        time_percent,
                        properties,
                    });
                    anim.keyframes.sort_by(|a, b| a.time_percent.partial_cmp(&b.time_percent).unwrap_or(std::cmp::Ordering::Equal));
                    return Ok(());
                }
            }
            Err(format!("Animation not found: {}", animation_id))
        }

        pub fn play_animation(&mut self, animation_id: &str) -> Result<(), String> {
            for anim in &mut self.active_animations {
                if anim.id == animation_id {
                    anim.started_at = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_millis() as i64;
                    anim.paused = false;
                    return Ok(());
                }
            }
            Err(format!("Animation not found: {}", animation_id))
        }

        pub fn pause_animation(&mut self, animation_id: &str) -> Result<(), String> {
            for anim in &mut self.active_animations {
                if anim.id == animation_id {
                    anim.paused = true;
                    return Ok(());
                }
            }
            Err(format!("Animation not found: {}", animation_id))
        }

        pub fn resume_animation(&mut self, animation_id: &str) -> Result<(), String> {
            for anim in &mut self.active_animations {
                if anim.id == animation_id {
                    anim.paused = false;
                    return Ok(());
                }
            }
            Err(format!("Animation not found: {}", animation_id))
        }

        pub fn stop_animation(&mut self, animation_id: &str) -> Result<(), String> {
            self.active_animations.retain(|anim| anim.id != animation_id);
            Ok(())
        }

        pub fn get_animation_progress(&self, animation_id: &str) -> Result<f32, String> {
            for anim in &self.active_animations {
                if anim.id == animation_id {
                    return Ok(anim.progress);
                }
            }
            Err(format!("Animation not found: {}", animation_id))
        }

        pub fn apply_transition_template(&mut self, target_id: &str, template_id: &str) -> Result<String, String> {
            if let Some(template) = self.transition_library.iter().find(|t| t.id == template_id) {
                let mut animation = Animation {
                    id: format!("anim-{}", std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_millis()),
                    target_id: target_id.to_string(),
                    animation_type: template.animation_type.clone(),
                    duration_ms: template.duration_ms,
                    delay_ms: 0,
                    easing_function: template.easing.clone(),
                    keyframes: template.preset_keyframes.clone(),
                    loop_count: 1,
                    reverse: false,
                    started_at: 0,
                    paused: false,
                    progress: 0.0,
                };
                let animation_id = animation.id.clone();
                self.active_animations.push(animation);
                Ok(animation_id)
            } else {
                Err(format!("Template not found: {}", template_id))
            }
        }

        pub fn get_active_animation_count(&self) -> i32 {
            self.active_animations.len() as i32
        }

        pub fn shutdown(&mut self) -> Result<(), String> {
            self.active_animations.clear();
            self.animation_queue.clear();
            Ok(())
        }
    }

    impl Clone for AnimationProperties {
        fn clone(&self) -> Self {
            AnimationProperties {
                opacity: self.opacity,
                scale_x: self.scale_x,
                scale_y: self.scale_y,
                translate_x: self.translate_x,
                translate_y: self.translate_y,
                rotate: self.rotate,
                blur: self.blur,
                color: self.color.clone(),
            }
        }
    }

    impl Clone for Keyframe {
        fn clone(&self) -> Self {
            Keyframe {
                time_percent: self.time_percent,
                properties: self.properties.clone(),
            }
        }
    }
}
