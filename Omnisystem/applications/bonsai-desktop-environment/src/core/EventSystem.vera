// Event System - Universal Event Handling for Desktop Environment
// Handles all user interactions and system events
// Language: VERA (UI)

module EventSystem {

    pub struct EventSystem {
        pub name: String,
        pub initialized: bool,
        pub event_queue: EventQueue,
        pub event_listeners: std::collections::HashMap<String, Vec<EventListener>>,
    }

    pub struct EventQueue {
        pub events: Vec<Event>,
        pub max_size: i32,
        pub processed_count: i64,
    }

    pub struct Event {
        pub id: String,
        pub event_type: String,
        pub source: String,
        pub target: String,
        pub timestamp: i64,
        pub data: EventData,
    }

    pub enum EventData {
        MouseEvent {
            x: i32,
            y: i32,
            button: String,
        },
        KeyboardEvent {
            key: String,
            modifiers: String,
        },
        TouchEvent {
            touch_id: i32,
            x: f32,
            y: f32,
        },
        WindowEvent {
            window_id: String,
            action: String,
        },
        ApplicationEvent {
            app_name: String,
            action: String,
        },
        SystemEvent {
            message: String,
        },
    }

    pub struct EventListener {
        pub listener_id: String,
        pub event_type: String,
        pub callback: Box<dyn Fn(&Event) -> Result<(), String>>,
    }

    pub struct EventFilter {
        pub event_type: Option<String>,
        pub source: Option<String>,
        pub target: Option<String>,
    }

    impl EventSystem {
        pub fn new() -> Self {
            EventSystem {
                name: "Event System".to_string(),
                initialized: false,
                event_queue: EventQueue {
                    events: Vec::new(),
                    max_size: 2000,
                    processed_count: 0,
                },
                event_listeners: std::collections::HashMap::new(),
            }
        }

        pub fn initialize(&mut self) -> Result<(), String> {
            println!("    Initializing event system");
            println!("    Setting up input handlers");
            println!("    Configuring event routing");

            self.setup_input_handlers()?;
            self.setup_event_routing()?;

            self.initialized = true;

            println!("    ✓ Event System ready");

            Ok(())
        }

        fn setup_input_handlers(&mut self) -> Result<(), String> {
            println!("      Mouse handler initialized");
            println!("      Keyboard handler initialized");
            println!("      Touch handler initialized");
            println!("      Window event handler initialized");
            Ok(())
        }

        fn setup_event_routing(&mut self) -> Result<(), String> {
            // Setup default event routing
            Ok(())
        }

        pub fn emit_event(&mut self, event: Event) -> Result<String, String> {
            if self.event_queue.events.len() >= self.event_queue.max_size as usize {
                return Err("Event queue full".to_string());
            }

            let event_id = event.id.clone();
            self.event_queue.events.push(event);
            self.event_queue.processed_count += 1;

            Ok(event_id)
        }

        pub fn register_listener(&mut self, event_type: &str, listener_id: &str) -> Result<(), String> {
            // Register event listener
            let entry = self.event_listeners.entry(event_type.to_string()).or_insert_with(Vec::new);
            entry.push(EventListener {
                listener_id: listener_id.to_string(),
                event_type: event_type.to_string(),
                callback: Box::new(|_| Ok(())),
            });

            Ok(())
        }

        pub fn unregister_listener(&mut self, event_type: &str, listener_id: &str) -> Result<(), String> {
            if let Some(listeners) = self.event_listeners.get_mut(event_type) {
                listeners.retain(|l| l.listener_id != listener_id);
            }
            Ok(())
        }

        pub fn process_events(&mut self) -> Result<usize, String> {
            let initial_size = self.event_queue.events.len();

            // Process up to 100 events per cycle
            for _ in 0..100.min(initial_size) {
                if !self.event_queue.events.is_empty() {
                    let event = self.event_queue.events.remove(0);

                    // Dispatch to listeners
                    if let Some(listeners) = self.event_listeners.get(&event.event_type) {
                        for listener in listeners {
                            let _ = (listener.callback)(&event);
                        }
                    }
                }
            }

            Ok(initial_size - self.event_queue.events.len())
        }

        pub fn get_pending_events(&self) -> usize {
            self.event_queue.events.len()
        }

        pub fn shutdown(&mut self) -> Result<(), String> {
            self.event_queue.events.clear();
            self.event_listeners.clear();
            Ok(())
        }
    }

    // ============================================================================
    // EVENT BUILDERS
    // ============================================================================

    impl Event {
        pub fn mouse(button: &str, x: i32, y: i32, source: &str, target: &str) -> Self {
            Event {
                id: format!("evt-mouse-{}", std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_millis()),
                event_type: "mouse".to_string(),
                source: source.to_string(),
                target: target.to_string(),
                timestamp: std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_secs() as i64,
                data: EventData::MouseEvent {
                    button: button.to_string(),
                    x,
                    y,
                },
            }
        }

        pub fn keyboard(key: &str, modifiers: &str, source: &str, target: &str) -> Self {
            Event {
                id: format!("evt-key-{}", std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_millis()),
                event_type: "keyboard".to_string(),
                source: source.to_string(),
                target: target.to_string(),
                timestamp: std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_secs() as i64,
                data: EventData::KeyboardEvent {
                    key: key.to_string(),
                    modifiers: modifiers.to_string(),
                },
            }
        }

        pub fn window(window_id: &str, action: &str, source: &str) -> Self {
            Event {
                id: format!("evt-window-{}", std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_millis()),
                event_type: "window".to_string(),
                source: source.to_string(),
                target: window_id.to_string(),
                timestamp: std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_secs() as i64,
                data: EventData::WindowEvent {
                    window_id: window_id.to_string(),
                    action: action.to_string(),
                },
            }
        }
    }
}
