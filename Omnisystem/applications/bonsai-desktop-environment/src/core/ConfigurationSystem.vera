// Configuration System - Central Configuration Management
// Handles all system configuration and preferences
// Languages: VERA (UI) + TITAN (File I/O)

module ConfigurationSystem {
    use crate::titan::*;

    pub struct ConfigurationSystem {
        pub name: String,
        pub initialized: bool,
        pub configs: std::collections::HashMap<String, ConfigSection>,
        pub defaults: std::collections::HashMap<String, String>,
    }

    pub struct ConfigSection {
        pub name: String,
        pub properties: std::collections::HashMap<String, ConfigProperty>,
        pub readonly: bool,
    }

    pub struct ConfigProperty {
        pub key: String,
        pub value: String,
        pub property_type: String, // "string", "int", "float", "bool", "color", "enum"
        pub default_value: String,
        pub description: String,
        pub validation_rule: Option<String>,
    }

    pub struct ConfigProfile {
        pub name: String,
        pub description: String,
        pub values: std::collections::HashMap<String, String>,
    }

    impl ConfigurationSystem {
        pub fn new() -> Self {
            ConfigurationSystem {
                name: "Configuration System".to_string(),
                initialized: false,
                configs: std::collections::HashMap::new(),
                defaults: std::collections::HashMap::new(),
            }
        }

        pub fn initialize(&mut self) -> Result<(), String> {
            println!("    Loading system configuration");
            println!("    Initializing preference manager");
            println!("    Building configuration cache");

            self.load_default_config()?;
            self.load_user_preferences()?;
            self.validate_configuration()?;

            self.initialized = true;

            println!("    ✓ Configuration System ready");

            Ok(())
        }

        fn load_default_config(&mut self) -> Result<(), String> {
            // Display settings
            let mut display_section = ConfigSection {
                name: "display".to_string(),
                properties: std::collections::HashMap::new(),
                readonly: false,
            };

            display_section.properties.insert(
                "brightness".to_string(),
                ConfigProperty {
                    key: "brightness".to_string(),
                    value: "100".to_string(),
                    property_type: "int".to_string(),
                    default_value: "100".to_string(),
                    description: "Screen brightness (0-100)".to_string(),
                    validation_rule: Some("0-100".to_string()),
                },
            );

            display_section.properties.insert(
                "resolution".to_string(),
                ConfigProperty {
                    key: "resolution".to_string(),
                    value: "1920x1080".to_string(),
                    property_type: "enum".to_string(),
                    default_value: "1920x1080".to_string(),
                    description: "Display resolution".to_string(),
                    validation_rule: Some("1920x1080|1680x1050|1440x900|1024x768".to_string()),
                },
            );

            display_section.properties.insert(
                "refresh_rate".to_string(),
                ConfigProperty {
                    key: "refresh_rate".to_string(),
                    value: "60".to_string(),
                    property_type: "int".to_string(),
                    default_value: "60".to_string(),
                    description: "Display refresh rate (Hz)".to_string(),
                    validation_rule: Some("30-240".to_string()),
                },
            );

            display_section.properties.insert(
                "theme".to_string(),
                ConfigProperty {
                    key: "theme".to_string(),
                    value: "light".to_string(),
                    property_type: "enum".to_string(),
                    default_value: "light".to_string(),
                    description: "Active theme".to_string(),
                    validation_rule: Some("light|dark|high_contrast|blue_light_filter|custom".to_string()),
                },
            );

            self.configs.insert("display".to_string(), display_section);

            // Audio settings
            let mut audio_section = ConfigSection {
                name: "audio".to_string(),
                properties: std::collections::HashMap::new(),
                readonly: false,
            };

            audio_section.properties.insert(
                "master_volume".to_string(),
                ConfigProperty {
                    key: "master_volume".to_string(),
                    value: "75".to_string(),
                    property_type: "int".to_string(),
                    default_value: "75".to_string(),
                    description: "Master volume level (0-100)".to_string(),
                    validation_rule: Some("0-100".to_string()),
                },
            );

            audio_section.properties.insert(
                "notification_sound".to_string(),
                ConfigProperty {
                    key: "notification_sound".to_string(),
                    value: "true".to_string(),
                    property_type: "bool".to_string(),
                    default_value: "true".to_string(),
                    description: "Enable notification sounds".to_string(),
                    validation_rule: None,
                },
            );

            self.configs.insert("audio".to_string(), audio_section);

            // Performance settings
            let mut performance_section = ConfigSection {
                name: "performance".to_string(),
                properties: std::collections::HashMap::new(),
                readonly: false,
            };

            performance_section.properties.insert(
                "target_fps".to_string(),
                ConfigProperty {
                    key: "target_fps".to_string(),
                    value: "60".to_string(),
                    property_type: "int".to_string(),
                    default_value: "60".to_string(),
                    description: "Target frames per second".to_string(),
                    validation_rule: Some("30-240".to_string()),
                },
            );

            performance_section.properties.insert(
                "gpu_acceleration".to_string(),
                ConfigProperty {
                    key: "gpu_acceleration".to_string(),
                    value: "true".to_string(),
                    property_type: "bool".to_string(),
                    default_value: "true".to_string(),
                    description: "Enable GPU acceleration".to_string(),
                    validation_rule: None,
                },
            );

            self.configs.insert("performance".to_string(), performance_section);

            // Accessibility settings
            let mut accessibility_section = ConfigSection {
                name: "accessibility".to_string(),
                properties: std::collections::HashMap::new(),
                readonly: false,
            };

            accessibility_section.properties.insert(
                "high_contrast".to_string(),
                ConfigProperty {
                    key: "high_contrast".to_string(),
                    value: "false".to_string(),
                    property_type: "bool".to_string(),
                    default_value: "false".to_string(),
                    description: "Enable high contrast mode".to_string(),
                    validation_rule: None,
                },
            );

            accessibility_section.properties.insert(
                "font_size".to_string(),
                ConfigProperty {
                    key: "font_size".to_string(),
                    value: "normal".to_string(),
                    property_type: "enum".to_string(),
                    default_value: "normal".to_string(),
                    description: "Font size scaling".to_string(),
                    validation_rule: Some("small|normal|large|extra_large".to_string()),
                },
            );

            self.configs.insert("accessibility".to_string(), accessibility_section);

            Ok(())
        }

        fn load_user_preferences(&mut self) -> Result<(), String> {
            // Load user preferences from settings storage (TITAN)
            Ok(())
        }

        fn validate_configuration(&mut self) -> Result<(), String> {
            // Validate all configuration values against rules
            Ok(())
        }

        pub fn get(&self, section: &str, key: &str) -> Result<String, String> {
            self.configs.get(section)
                .and_then(|s| s.properties.get(key))
                .map(|p| p.value.clone())
                .ok_or_else(|| format!("Configuration not found: {}.{}", section, key))
        }

        pub fn set(&mut self, section: &str, key: &str, value: &str) -> Result<(), String> {
            if let Some(config_section) = self.configs.get_mut(section) {
                if let Some(prop) = config_section.properties.get_mut(key) {
                    prop.value = value.to_string();
                    return Ok(());
                }
            }
            Err(format!("Configuration not found: {}.{}", section, key))
        }

        pub fn get_section(&self, section: &str) -> Result<Vec<(String, String)>, String> {
            self.configs.get(section)
                .map(|s| s.properties.iter().map(|(k, v)| (k.clone(), v.value.clone())).collect())
                .ok_or_else(|| format!("Section not found: {}", section))
        }

        pub fn reload(&mut self) -> Result<(), String> {
            self.configs.clear();
            self.load_default_config()?;
            self.load_user_preferences()?;
            Ok(())
        }

        pub fn export_config(&self, section: &str) -> Result<String, String> {
            // Export configuration as JSON
            Ok(format!("configuration_{}.json", section))
        }

        pub fn shutdown(&mut self) -> Result<(), String> {
            // Save all changes to disk before shutdown
            self.configs.clear();
            Ok(())
        }
    }

    // ============================================================================
    // CONFIGURATION PROFILES
    // ============================================================================

    pub fn create_profile(name: &str, description: &str) -> ConfigProfile {
        ConfigProfile {
            name: name.to_string(),
            description: description.to_string(),
            values: std::collections::HashMap::new(),
        }
    }

    // Predefined profiles
    pub fn get_gaming_profile() -> ConfigProfile {
        let mut profile = create_profile("Gaming", "Optimized for gaming performance");
        profile.values.insert("gpu_acceleration".to_string(), "true".to_string());
        profile.values.insert("target_fps".to_string(), "144".to_string());
        profile.values.insert("brightness".to_string(), "100".to_string());
        profile
    }

    pub fn get_productivity_profile() -> ConfigProfile {
        let mut profile = create_profile("Productivity", "Optimized for office work");
        profile.values.insert("brightness".to_string(), "80".to_string());
        profile.values.insert("font_size".to_string(), "normal".to_string());
        profile.values.insert("theme".to_string(), "light".to_string());
        profile
    }

    pub fn get_evening_profile() -> ConfigProfile {
        let mut profile = create_profile("Evening", "Blue light filter enabled");
        profile.values.insert("theme".to_string(), "blue_light_filter".to_string());
        profile.values.insert("brightness".to_string(), "60".to_string());
        profile
    }

    pub fn get_accessibility_profile() -> ConfigProfile {
        let mut profile = create_profile("Accessibility", "High contrast and large fonts");
        profile.values.insert("theme".to_string(), "high_contrast".to_string());
        profile.values.insert("font_size".to_string(), "extra_large".to_string());
        profile.values.insert("high_contrast".to_string(), "true".to_string());
        profile
    }
}
