// Control Panel - System Management Console
// Complete implementation with all 7 tabs
// Real-time monitoring and management UI

pub struct ControlPanel {
    id: String,
    title: String,
    width: f32,
    height: f32,
    visible: bool,
    active_tab: String,
    theme: Theme,
    asset_manager: AssetManager,
    system_monitor: SystemMonitor,
    service_controller: ServiceController,
    log_viewer: LogViewer,
    capabilities_registry: CapabilitiesRegistry,
    snapshot_manager: SnapshotManager,
    config_system: ConfigurationSystem,
    refresh_interval_ms: u32,
}

impl ControlPanel {
    pub fn new(asset_manager: AssetManager) -> Self {
        Self {
            id: "control-panel-main".to_string(),
            title: "Omnisystem Control Panel".to_string(),
            width: 1400.0,
            height: 900.0,
            visible: true,
            active_tab: "status".to_string(),
            theme: asset_manager.get_current_theme(),
            asset_manager: asset_manager.clone(),
            system_monitor: SystemMonitor::new(),
            service_controller: ServiceController::new(),
            log_viewer: LogViewer::new(),
            capabilities_registry: CapabilitiesRegistry::new(),
            snapshot_manager: SnapshotManager::new(),
            config_system: ConfigurationSystem::new(),
            refresh_interval_ms: 1000,
        }
    }

    pub fn render(&self) -> Widget {
        ApplicationWindow {
            id: self.id.clone(),
            title: self.title.clone(),
            width: self.width,
            height: self.height,
            background_color: self.theme.colors.background,

            children: vec![
                // Header
                self.render_header(),

                // Tab Navigation
                self.render_tab_navigation(),

                // Content Area (changes based on active_tab)
                self.render_active_tab_content(),

                // Footer
                self.render_footer(),
            ],
        }
    }

    // ============================================================================
    // HEADER - Application Title and Quick Stats
    // ============================================================================
    fn render_header(&self) -> Widget {
        Panel {
            id: "panel-header".to_string(),
            height: 60.0,
            padding: 16.0,
            background_color: self.theme.colors.primary,
            border_color: self.theme.colors.primary_dark,
            border_width: 1.0,

            children: vec![
                Row {
                    spacing: 16.0,
                    vertical_align: "center".to_string(),
                    children: vec![
                        // Logo/Icon
                        Image {
                            id: "header-logo".to_string(),
                            source: self.asset_manager.load_icon("omnisystem", 40),
                            width: 40.0,
                            height: 40.0,
                        },

                        // Title
                        Label {
                            id: "header-title".to_string(),
                            text: "Omnisystem Control Panel".to_string(),
                            font_size: 24.0,
                            font_weight: 700,
                            color: self.theme.colors.white,
                        },

                        // Spacer
                        Spacer {},

                        // Quick Status Indicator
                        Row {
                            spacing: 12.0,
                            children: vec![
                                // Health Indicator
                                Row {
                                    spacing: 8.0,
                                    children: vec![
                                        Circle {
                                            radius: 8.0,
                                            color: self.get_system_health_color(),
                                        },
                                        Label {
                                            text: format!(
                                                "Health: {}",
                                                self.system_monitor.get_health_status()
                                            ),
                                            color: self.theme.colors.white,
                                            font_size: 12.0,
                                        },
                                    ],
                                },

                                // Version
                                Label {
                                    text: format!(
                                        "v{}",
                                        self.system_monitor.get_version()
                                    ),
                                    color: self.theme.colors.white,
                                    font_size: 12.0,
                                },
                            ],
                        },
                    ],
                },
            ],
        }
    }

    // ============================================================================
    // TAB NAVIGATION - Tab Selection Buttons
    // ============================================================================
    fn render_tab_navigation(&self) -> Widget {
        Panel {
            id: "panel-tabs".to_string(),
            height: 48.0,
            padding: 0.0,
            background_color: self.theme.colors.surface,
            border_color: self.theme.colors.border,
            border_width: 1.0,

            children: vec![
                Row {
                    id: "tab-row".to_string(),
                    spacing: 0.0,
                    children: vec![
                        self.render_tab_button("status", "Status", "gauge"),
                        self.render_tab_button("resources", "Resources", "chart-line"),
                        self.render_tab_button("services", "Services", "server"),
                        self.render_tab_button("logs", "Logs", "file-text"),
                        self.render_tab_button("capabilities", "Capabilities", "star"),
                        self.render_tab_button("snapshots", "Snapshots", "camera"),
                        self.render_tab_button("settings", "Settings", "cog"),
                    ],
                },
            ],
        }
    }

    fn render_tab_button(&self, tab_id: &str, label: &str, icon_name: &str) -> Widget {
        let is_active = self.active_tab == tab_id;
        let bg_color = if is_active {
            self.theme.colors.primary
        } else {
            self.theme.colors.surface
        };
        let text_color = if is_active {
            self.theme.colors.white
        } else {
            self.theme.colors.foreground
        };

        Button {
            id: format!("tab-btn-{}", tab_id),
            label: label.to_string(),
            icon: self.asset_manager.load_icon(icon_name, 20),
            background_color: bg_color,
            text_color: text_color,
            padding: 12.0,
            width: "auto".to_string(),
            height: 48.0,
            border_radius: 0.0,
            border_bottom: if is_active { 3.0 } else { 0.0 },
            border_bottom_color: self.theme.colors.accent,

            onClick: {
                let tab_id_clone = tab_id.to_string();
                move || {
                    // Switch to this tab
                    CONTROL_PANEL_STATE.set_active_tab(tab_id_clone);
                }
            },
        }
    }

    // ============================================================================
    // CONTENT AREA - Tab-Specific Content
    // ============================================================================
    fn render_active_tab_content(&self) -> Widget {
        match self.active_tab.as_str() {
            "status" => self.render_status_tab(),
            "resources" => self.render_resources_tab(),
            "services" => self.render_services_tab(),
            "logs" => self.render_logs_tab(),
            "capabilities" => self.render_capabilities_tab(),
            "snapshots" => self.render_snapshots_tab(),
            "settings" => self.render_settings_tab(),
            _ => Label { text: "Unknown tab".to_string() },
        }
    }

    // ============================================================================
    // TAB 1: STATUS - System Health Overview
    // ============================================================================
    fn render_status_tab(&self) -> Widget {
        Panel {
            id: "tab-status".to_string(),
            padding: 24.0,
            background_color: self.theme.colors.background,

            children: vec![
                Label {
                    id: "status-title".to_string(),
                    text: "System Status".to_string(),
                    font_size: 20.0,
                    font_weight: 700,
                    margin_bottom: 20.0,
                    color: self.theme.colors.foreground,
                },

                // Health Overview Grid
                Grid {
                    id: "status-grid".to_string(),
                    columns: 4,
                    gap: 16.0,

                    children: vec![
                        self.render_status_card(
                            "health",
                            "System Health",
                            "health-icon",
                            self.system_monitor.get_health_percentage(),
                            "%"
                        ),
                        self.render_status_card(
                            "uptime",
                            "Uptime",
                            "clock",
                            self.system_monitor.get_uptime_hours(),
                            "hours"
                        ),
                        self.render_status_card(
                            "services",
                            "Services Running",
                            "server",
                            self.service_controller.get_running_count(),
                            ""
                        ),
                        self.render_status_card(
                            "version",
                            "System Version",
                            "package",
                            0.0, // Not a percentage
                            self.system_monitor.get_version().as_str()
                        ),
                    ],
                },

                Separator { margin: 20.0 },

                // System Information
                Label {
                    text: "System Information".to_string(),
                    font_size: 16.0,
                    font_weight: 700,
                    margin_bottom: 12.0,
                },

                Grid {
                    columns: 2,
                    gap: 16.0,

                    children: vec![
                        self.render_info_item("OS", self.system_monitor.get_os()),
                        self.render_info_item("Architecture", self.system_monitor.get_architecture()),
                        self.render_info_item("CPU Cores", format!("{}", self.system_monitor.get_cpu_count()).as_str()),
                        self.render_info_item("Total Memory", self.system_monitor.get_total_memory().as_str()),
                        self.render_info_item("Boot Time", self.system_monitor.get_boot_time().as_str()),
                        self.render_info_item("Last Updated", self.system_monitor.get_last_update().as_str()),
                    ],
                },
            ],
        }
    }

    fn render_status_card(&self, id: &str, title: &str, icon: &str, value: f32, unit: &str) -> Widget {
        Card {
            id: id.to_string(),
            padding: 16.0,

            children: vec![
                Column {
                    spacing: 12.0,

                    children: vec![
                        // Icon and Title
                        Row {
                            spacing: 8.0,

                            children: vec![
                                Image {
                                    source: self.asset_manager.load_icon(icon, 24),
                                    width: 24.0,
                                    height: 24.0,
                                },
                                Label {
                                    text: title.to_string(),
                                    font_size: 12.0,
                                    color: self.theme.colors.foreground_secondary,
                                },
                            ],
                        },

                        // Value Display
                        Label {
                            text: if unit.is_empty() {
                                format!("{}", value as i32)
                            } else if unit.starts_with("v") {
                                unit.to_string()
                            } else {
                                format!("{:.1}{}", value, unit)
                            },
                            font_size: 28.0,
                            font_weight: 700,
                            color: self.theme.colors.foreground,
                        },
                    ],
                },
            ],
        }
    }

    fn render_info_item(&self, label: &str, value: &str) -> Widget {
        Row {
            spacing: 8.0,

            children: vec![
                Label {
                    text: format!("{}:", label),
                    font_size: 12.0,
                    font_weight: 600,
                    width: "30%".to_string(),
                    color: self.theme.colors.foreground_secondary,
                },
                Label {
                    text: value.to_string(),
                    font_size: 12.0,
                    color: self.theme.colors.foreground,
                },
            ],
        }
    }

    // ============================================================================
    // TAB 2: RESOURCES - Real-Time Performance Metrics
    // ============================================================================
    fn render_resources_tab(&self) -> Widget {
        Panel {
            id: "tab-resources".to_string(),
            padding: 24.0,
            background_color: self.theme.colors.background,

            children: vec![
                Label {
                    text: "Resource Usage".to_string(),
                    font_size: 20.0,
                    font_weight: 700,
                    margin_bottom: 20.0,
                },

                // CPU Metrics
                Column {
                    spacing: 16.0,

                    children: vec![
                        // CPU
                        Column {
                            spacing: 8.0,

                            children: vec![
                                Row {
                                    spacing: 8.0,

                                    children: vec![
                                        Image {
                                            source: self.asset_manager.load_icon("cpu", 20),
                                            width: 20.0,
                                            height: 20.0,
                                        },
                                        Label {
                                            text: "CPU Usage".to_string(),
                                            font_size: 14.0,
                                            font_weight: 600,
                                        },
                                        Spacer {},
                                        Label {
                                            text: format!("{:.1}%", self.system_monitor.get_cpu_usage()),
                                            font_size: 14.0,
                                            font_weight: 600,
                                            color: self.get_metric_color(self.system_monitor.get_cpu_usage()),
                                        },
                                    ],
                                },

                                ProgressBar {
                                    id: "cpu-progress".to_string(),
                                    value: self.system_monitor.get_cpu_usage() as i32,
                                    max: 100,
                                    height: 8.0,
                                    color: self.get_metric_color(self.system_monitor.get_cpu_usage()),
                                },

                                self.render_cpu_chart(),
                            ],
                        },

                        Separator { margin: 16.0 },

                        // Memory
                        Column {
                            spacing: 8.0,

                            children: vec![
                                Row {
                                    spacing: 8.0,

                                    children: vec![
                                        Image {
                                            source: self.asset_manager.load_icon("memory", 20),
                                            width: 20.0,
                                            height: 20.0,
                                        },
                                        Label {
                                            text: "Memory Usage".to_string(),
                                            font_size: 14.0,
                                            font_weight: 600,
                                        },
                                        Spacer {},
                                        Label {
                                            text: format!(
                                                "{} / {} ({:.1}%)",
                                                self.system_monitor.get_used_memory(),
                                                self.system_monitor.get_total_memory(),
                                                self.system_monitor.get_memory_usage()
                                            ),
                                            font_size: 14.0,
                                            font_weight: 600,
                                            color: self.get_metric_color(self.system_monitor.get_memory_usage()),
                                        },
                                    ],
                                },

                                ProgressBar {
                                    id: "memory-progress".to_string(),
                                    value: self.system_monitor.get_memory_usage() as i32,
                                    max: 100,
                                    height: 8.0,
                                    color: self.get_metric_color(self.system_monitor.get_memory_usage()),
                                },

                                self.render_memory_chart(),
                            ],
                        },

                        Separator { margin: 16.0 },

                        // Disk
                        Column {
                            spacing: 8.0,

                            children: vec![
                                Row {
                                    spacing: 8.0,

                                    children: vec![
                                        Image {
                                            source: self.asset_manager.load_icon("disk", 20),
                                            width: 20.0,
                                            height: 20.0,
                                        },
                                        Label {
                                            text: "Disk Usage".to_string(),
                                            font_size: 14.0,
                                            font_weight: 600,
                                        },
                                        Spacer {},
                                        Label {
                                            text: format!(
                                                "{} / {} ({:.1}%)",
                                                self.system_monitor.get_used_disk(),
                                                self.system_monitor.get_total_disk(),
                                                self.system_monitor.get_disk_usage()
                                            ),
                                            font_size: 14.0,
                                            font_weight: 600,
                                            color: self.get_metric_color(self.system_monitor.get_disk_usage()),
                                        },
                                    ],
                                },

                                ProgressBar {
                                    id: "disk-progress".to_string(),
                                    value: self.system_monitor.get_disk_usage() as i32,
                                    max: 100,
                                    height: 8.0,
                                    color: self.get_metric_color(self.system_monitor.get_disk_usage()),
                                },
                            ],
                        },

                        Separator { margin: 16.0 },

                        // Network
                        Column {
                            spacing: 8.0,

                            children: vec![
                                Row {
                                    spacing: 8.0,

                                    children: vec![
                                        Image {
                                            source: self.asset_manager.load_icon("network", 20),
                                            width: 20.0,
                                            height: 20.0,
                                        },
                                        Label {
                                            text: "Network".to_string(),
                                            font_size: 14.0,
                                            font_weight: 600,
                                        },
                                    ],
                                },

                                Grid {
                                    columns: 2,
                                    gap: 12.0,

                                    children: vec![
                                        self.render_network_stat("Download", self.system_monitor.get_download_speed()),
                                        self.render_network_stat("Upload", self.system_monitor.get_upload_speed()),
                                    ],
                                },
                            ],
                        },
                    ],
                },
            ],
        }
    }

    fn render_cpu_chart(&self) -> Widget {
        // Real-time line chart of CPU usage over time
        Chart {
            id: "chart-cpu".to_string(),
            title: "CPU Usage History (Last 60 seconds)".to_string(),
            chart_type: "line".to_string(),
            data: self.system_monitor.get_cpu_history(),
            height: 200.0,
            show_legend: false,
            show_grid: true,
        }
    }

    fn render_memory_chart(&self) -> Widget {
        // Real-time line chart of memory usage over time
        Chart {
            id: "chart-memory".to_string(),
            title: "Memory Usage History (Last 60 seconds)".to_string(),
            chart_type: "line".to_string(),
            data: self.system_monitor.get_memory_history(),
            height: 200.0,
            show_legend: false,
            show_grid: true,
        }
    }

    fn render_network_stat(&self, label: &str, value: &str) -> Widget {
        Card {
            padding: 12.0,

            children: vec![
                Column {
                    spacing: 4.0,

                    children: vec![
                        Label {
                            text: label.to_string(),
                            font_size: 11.0,
                            color: self.theme.colors.foreground_secondary,
                        },
                        Label {
                            text: value.to_string(),
                            font_size: 14.0,
                            font_weight: 600,
                            color: self.theme.colors.foreground,
                        },
                    ],
                },
            ],
        }
    }

    // ============================================================================
    // TAB 3: SERVICES - Service Management
    // ============================================================================
    fn render_services_tab(&self) -> Widget {
        Panel {
            id: "tab-services".to_string(),
            padding: 24.0,
            background_color: self.theme.colors.background,

            children: vec![
                Row {
                    spacing: 12.0,
                    margin_bottom: 20.0,

                    children: vec![
                        Label {
                            text: "System Services".to_string(),
                            font_size: 20.0,
                            font_weight: 700,
                        },
                        Spacer {},
                        TextField {
                            id: "service-search".to_string(),
                            placeholder: "Search services...".to_string(),
                            width: "300px".to_string(),
                            icon: self.asset_manager.load_icon("search", 16),
                            onInput: |query| {
                                CONTROL_PANEL_STATE.filter_services(&query);
                            },
                        },
                    ],
                },

                // Services List
                Column {
                    spacing: 8.0,

                    children: self.render_service_items(),
                },
            ],
        }
    }

    fn render_service_items(&self) -> Vec<Widget> {
        self.service_controller
            .get_services()
            .iter()
            .map(|service| {
                Card {
                    id: format!("service-card-{}", service.id),
                    padding: 16.0,

                    children: vec![
                        Row {
                            spacing: 12.0,
                            vertical_align: "center".to_string(),

                            children: vec![
                                // Status Indicator
                                Circle {
                                    radius: 8.0,
                                    color: if service.running {
                                        self.theme.colors.success
                                    } else {
                                        self.theme.colors.error
                                    },
                                },

                                // Service Icon
                                Image {
                                    source: self.asset_manager.load_icon("server", 24),
                                    width: 24.0,
                                    height: 24.0,
                                },

                                // Service Info
                                Column {
                                    spacing: 4.0,
                                    width: "40%".to_string(),

                                    children: vec![
                                        Label {
                                            text: service.name.clone(),
                                            font_size: 14.0,
                                            font_weight: 600,
                                        },
                                        Label {
                                            text: service.description.clone(),
                                            font_size: 11.0,
                                            color: self.theme.colors.foreground_secondary,
                                        },
                                    ],
                                },

                                // Resource Usage
                                Column {
                                    spacing: 4.0,
                                    width: "20%".to_string(),

                                    children: vec![
                                        Label {
                                            text: format!("CPU: {:.1}%", service.cpu_usage),
                                            font_size: 11.0,
                                        },
                                        Label {
                                            text: format!("Memory: {} MB", service.memory_usage),
                                            font_size: 11.0,
                                        },
                                    ],
                                },

                                Spacer {},

                                // Control Buttons
                                Row {
                                    spacing: 8.0,

                                    children: vec![
                                        Button {
                                            id: format!("service-btn-{}-view-logs", service.id),
                                            label: "Logs".to_string(),
                                            icon: self.asset_manager.load_icon("file-text", 16),
                                            variant: "secondary".to_string(),
                                            size: "small".to_string(),
                                            onClick: |service_id| {
                                                CONTROL_PANEL_STATE.show_service_logs(&service_id);
                                            },
                                        },

                                        Button {
                                            id: format!("service-btn-{}-restart", service.id),
                                            label: if service.running { "Restart" } else { "Start" }.to_string(),
                                            icon: self.asset_manager.load_icon("refresh", 16),
                                            variant: "primary".to_string(),
                                            size: "small".to_string(),
                                            onClick: |service_id| {
                                                CONTROL_PANEL_STATE.restart_service(&service_id);
                                            },
                                        },

                                        Button {
                                            id: format!("service-btn-{}-stop", service.id),
                                            label: "Stop".to_string(),
                                            icon: self.asset_manager.load_icon("square", 16),
                                            variant: "danger".to_string(),
                                            size: "small".to_string(),
                                            onClick: |service_id| {
                                                CONTROL_PANEL_STATE.stop_service(&service_id);
                                            },
                                        },
                                    ],
                                },
                            ],
                        },
                    ],
                }
            })
            .collect()
    }

    // ============================================================================
    // TAB 4: LOGS - System Logging Viewer
    // ============================================================================
    fn render_logs_tab(&self) -> Widget {
        Panel {
            id: "tab-logs".to_string(),
            padding: 24.0,
            background_color: self.theme.colors.background,

            children: vec![
                Row {
                    spacing: 12.0,
                    margin_bottom: 16.0,

                    children: vec![
                        Label {
                            text: "System Logs".to_string(),
                            font_size: 20.0,
                            font_weight: 700,
                        },
                        Spacer {},
                        // Filter Buttons
                        Row {
                            spacing: 8.0,

                            children: vec![
                                Button {
                                    label: "All".to_string(),
                                    variant: if self.log_viewer.level_filter == "all" {
                                        "primary".to_string()
                                    } else {
                                        "secondary".to_string()
                                    },
                                    onClick: || {
                                        CONTROL_PANEL_STATE.set_log_filter("all");
                                    },
                                },
                                Button {
                                    label: "Info".to_string(),
                                    variant: if self.log_viewer.level_filter == "info" {
                                        "primary".to_string()
                                    } else {
                                        "secondary".to_string()
                                    },
                                    onClick: || {
                                        CONTROL_PANEL_STATE.set_log_filter("info");
                                    },
                                },
                                Button {
                                    label: "Warning".to_string(),
                                    variant: if self.log_viewer.level_filter == "warning" {
                                        "primary".to_string()
                                    } else {
                                        "secondary".to_string()
                                    },
                                    onClick: || {
                                        CONTROL_PANEL_STATE.set_log_filter("warning");
                                    },
                                },
                                Button {
                                    label: "Error".to_string(),
                                    variant: if self.log_viewer.level_filter == "error" {
                                        "primary".to_string()
                                    } else {
                                        "secondary".to_string()
                                    },
                                    onClick: || {
                                        CONTROL_PANEL_STATE.set_log_filter("error");
                                    },
                                },
                            ],
                        },
                    ],
                },

                // Search
                TextField {
                    id: "log-search".to_string(),
                    placeholder: "Search logs...".to_string(),
                    width: "100%".to_string(),
                    icon: self.asset_manager.load_icon("search", 16),
                    margin_bottom: 16.0,
                    onInput: |query| {
                        CONTROL_PANEL_STATE.search_logs(&query);
                    },
                },

                // Log Viewer
                CodeEditor {
                    id: "log-viewer".to_string(),
                    content: self.log_viewer.get_filtered_logs(),
                    language: "plaintext".to_string(),
                    height: 500.0,
                    read_only: true,
                    theme: self.theme.colors.primary,
                    font_size: 11.0,
                    line_numbers: true,
                    auto_scroll: true,
                },

                // Footer
                Row {
                    spacing: 8.0,
                    margin_top: 12.0,

                    children: vec![
                        Button {
                            label: "Clear Logs".to_string(),
                            icon: self.asset_manager.load_icon("trash", 16),
                            variant: "danger".to_string(),
                            onClick: || {
                                CONTROL_PANEL_STATE.clear_logs();
                            },
                        },
                        Button {
                            label: "Export Logs".to_string(),
                            icon: self.asset_manager.load_icon("download", 16),
                            onClick: || {
                                CONTROL_PANEL_STATE.export_logs();
                            },
                        },
                        Spacer {},
                        Label {
                            text: format!("{} log entries", self.log_viewer.get_total_count()),
                            font_size: 12.0,
                            color: self.theme.colors.foreground_secondary,
                        },
                    ],
                },
            ],
        }
    }

    // ============================================================================
    // TAB 5: CAPABILITIES - Registered Capabilities Browser
    // ============================================================================
    fn render_capabilities_tab(&self) -> Widget {
        Panel {
            id: "tab-capabilities".to_string(),
            padding: 24.0,
            background_color: self.theme.colors.background,

            children: vec![
                Row {
                    spacing: 12.0,
                    margin_bottom: 20.0,

                    children: vec![
                        Label {
                            text: "System Capabilities".to_string(),
                            font_size: 20.0,
                            font_weight: 700,
                        },
                        Spacer {},
                        TextField {
                            placeholder: "Search capabilities...".to_string(),
                            width: "300px".to_string(),
                            onInput: |query| {
                                CONTROL_PANEL_STATE.filter_capabilities(&query);
                            },
                        },
                    ],
                },

                // Capabilities Tree
                TreeView {
                    id: "capabilities-tree".to_string(),
                    items: self.capabilities_registry.get_tree(),
                    height: 600.0,
                    multi_select: false,
                },

                // Capability Details
                self.render_capability_details(),
            ],
        }
    }

    fn render_capability_details(&self) -> Widget {
        if let Some(capability) = self.capabilities_registry.get_selected() {
            Panel {
                margin_top: 20.0,
                padding: 16.0,
                border: true,

                children: vec![
                    Label {
                        text: capability.name.clone(),
                        font_size: 16.0,
                        font_weight: 600,
                        margin_bottom: 12.0,
                    },
                    Label {
                        text: capability.description.clone(),
                        font_size: 12.0,
                        color: self.theme.colors.foreground_secondary,
                        margin_bottom: 12.0,
                    },
                    Grid {
                        columns: 2,
                        gap: 12.0,

                        children: vec![
                            self.render_info_item("Version", &capability.version),
                            self.render_info_item("Type", &capability.capability_type),
                            self.render_info_item("Status", if capability.available { "Available" } else { "Unavailable" }),
                            self.render_info_item("Permission Level", &capability.permission_level),
                        ],
                    },
                ],
            }
        } else {
            Label {
                text: "Select a capability to view details".to_string(),
                color: self.theme.colors.foreground_secondary,
            }
        }
    }

    // ============================================================================
    // TAB 6: SNAPSHOTS - System State Snapshots
    // ============================================================================
    fn render_snapshots_tab(&self) -> Widget {
        Panel {
            id: "tab-snapshots".to_string(),
            padding: 24.0,
            background_color: self.theme.colors.background,

            children: vec![
                Row {
                    spacing: 12.0,
                    margin_bottom: 20.0,

                    children: vec![
                        Label {
                            text: "System Snapshots".to_string(),
                            font_size: 20.0,
                            font_weight: 700,
                        },
                        Spacer {},
                        Button {
                            label: "Create Snapshot".to_string(),
                            icon: self.asset_manager.load_icon("camera", 16),
                            variant: "primary".to_string(),
                            onClick: || {
                                CONTROL_PANEL_STATE.create_snapshot();
                            },
                        },
                    ],
                },

                // Snapshots List
                DataGrid {
                    id: "snapshots-grid".to_string(),
                    columns: vec![
                        ("Name".to_string(), "25%".to_string()),
                        ("Created".to_string(), "25%".to_string()),
                        ("Size".to_string(), "15%".to_string()),
                        ("Status".to_string(), "15%".to_string()),
                        ("Actions".to_string(), "20%".to_string()),
                    ],
                    rows: self.snapshot_manager.get_snapshots()
                        .iter()
                        .map(|snapshot| {
                            vec![
                                snapshot.name.clone(),
                                snapshot.created_at.clone(),
                                format!("{} MB", snapshot.size_mb),
                                snapshot.status.clone(),
                                format!("View | Restore | Delete"),
                            ]
                        })
                        .collect(),
                    height: 500.0,
                    sortable: true,
                    filterable: true,
                },
            ],
        }
    }

    // ============================================================================
    // TAB 7: SETTINGS - System Configuration
    // ============================================================================
    fn render_settings_tab(&self) -> Widget {
        Panel {
            id: "tab-settings".to_string(),
            padding: 24.0,
            background_color: self.theme.colors.background,

            children: vec![
                Label {
                    text: "System Settings".to_string(),
                    font_size: 20.0,
                    font_weight: 700,
                    margin_bottom: 24.0,
                },

                // Settings Groups
                Column {
                    spacing: 24.0,

                    children: vec![
                        // Display Settings
                        self.render_settings_group(
                            "Display",
                            "icon-monitor".to_string(),
                            vec![
                                ("Refresh Rate", "checkbox", true),
                                ("VSync", "checkbox", true),
                                ("Fullscreen", "checkbox", false),
                            ],
                        ),

                        // Performance Settings
                        self.render_settings_group(
                            "Performance",
                            "icon-zap".to_string(),
                            vec![
                                ("Enable GPU Acceleration", "checkbox", true),
                                ("Max FPS", "number", false),
                                ("Thermal Throttling", "checkbox", true),
                            ],
                        ),

                        // Network Settings
                        self.render_settings_group(
                            "Network",
                            "icon-network".to_string(),
                            vec![
                                ("Enable Network Discovery", "checkbox", true),
                                ("Proxy Settings", "text", false),
                                ("DNS Servers", "text", false),
                            ],
                        ),

                        // Advanced Settings
                        self.render_settings_group(
                            "Advanced",
                            "icon-sliders".to_string(),
                            vec![
                                ("Debug Mode", "checkbox", false),
                                ("Verbose Logging", "checkbox", false),
                                ("Cache Size (MB)", "number", false),
                            ],
                        ),
                    ],
                },

                // Footer Buttons
                Row {
                    spacing: 8.0,
                    margin_top: 24.0,

                    children: vec![
                        Spacer {},
                        Button {
                            label: "Reset to Defaults".to_string(),
                            variant: "secondary".to_string(),
                            onClick: || {
                                CONTROL_PANEL_STATE.reset_settings();
                            },
                        },
                        Button {
                            label: "Save Settings".to_string(),
                            variant: "primary".to_string(),
                            onClick: || {
                                CONTROL_PANEL_STATE.save_settings();
                            },
                        },
                    ],
                },
            ],
        }
    }

    fn render_settings_group(
        &self,
        title: &str,
        icon: String,
        settings: Vec<(&str, &str, bool)>,
    ) -> Widget {
        Panel {
            padding: 16.0,
            border: true,

            children: vec![
                Row {
                    spacing: 12.0,
                    margin_bottom: 16.0,

                    children: vec![
                        Image {
                            source: self.asset_manager.load_icon(&icon, 20),
                            width: 20.0,
                            height: 20.0,
                        },
                        Label {
                            text: title.to_string(),
                            font_size: 14.0,
                            font_weight: 600,
                        },
                    ],
                },

                Column {
                    spacing: 12.0,

                    children: settings
                        .iter()
                        .map(|(label, input_type, default_value)| {
                            Row {
                                spacing: 12.0,

                                children: vec![
                                    Label {
                                        text: label.to_string(),
                                        width: "40%".to_string(),
                                        font_size: 12.0,
                                    },
                                    if *input_type == "checkbox" {
                                        Checkbox {
                                            label: "Enabled".to_string(),
                                            checked: *default_value,
                                        }
                                    } else {
                                        TextField {
                                            placeholder: "Enter value".to_string(),
                                            width: "60%".to_string(),
                                        }
                                    },
                                ],
                            }
                        })
                        .collect(),
                },
            ],
        }
    }

    // ============================================================================
    // FOOTER - Status and Controls
    // ============================================================================
    fn render_footer(&self) -> Widget {
        Panel {
            id: "panel-footer".to_string(),
            height: 40.0,
            padding: 12.0,
            background_color: self.theme.colors.surface,
            border_color: self.theme.colors.border,
            border_width: 1.0,

            children: vec![
                Row {
                    spacing: 12.0,
                    vertical_align: "center".to_string(),

                    children: vec![
                        Label {
                            text: format!(
                                "Last updated: {}",
                                self.system_monitor.get_last_update_time()
                            ),
                            font_size: 11.0,
                            color: self.theme.colors.foreground_secondary,
                        },
                        Spacer {},
                        Button {
                            label: "Refresh Now".to_string(),
                            variant: "secondary".to_string(),
                            size: "small".to_string(),
                            onClick: || {
                                CONTROL_PANEL_STATE.refresh_data();
                            },
                        },
                    ],
                },
            ],
        }
    }

    // ============================================================================
    // HELPER METHODS
    // ============================================================================
    fn get_system_health_color(&self) -> Color {
        let health = self.system_monitor.get_health_percentage();
        match health {
            80.0..=100.0 => self.theme.colors.success,
            60.0..=79.9 => self.theme.colors.warning,
            _ => self.theme.colors.error,
        }
    }

    fn get_metric_color(&self, value: f32) -> Color {
        match value {
            0.0..=50.0 => self.theme.colors.success,
            50.1..=75.0 => self.theme.colors.warning,
            _ => self.theme.colors.error,
        }
    }
}

