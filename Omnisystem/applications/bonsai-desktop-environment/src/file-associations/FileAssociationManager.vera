// ============================================================================
// DATA STRUCTURES
// ============================================================================

#[derive(Clone, Debug)]
pub struct FileTypeAssociation {
    pub id: String,
    pub extension: String,
    pub name: String,
    pub description: String,
    pub icon_name: String,
    pub associated_apps: Vec<String>,
    pub default_app: Option<String>,
    pub created_at: SystemTime,
    pub modified_at: SystemTime,
}

#[derive(Clone, Debug)]
pub struct ApplicationInfo {
    pub id: String,
    pub name: String,
    pub path: String,
    pub icon_name: String,
    pub supported_file_types: Vec<String>,
    pub executable: PathBuf,
    pub installed: bool,
}

// ============================================================================
// PLATFORM-SPECIFIC HANDLER
// ============================================================================

pub struct PlatformFileAssociationHandler;

impl PlatformFileAssociationHandler {
    pub fn new() -> Self {
        Self
    }

    #[cfg(target_os = "windows")]
    fn set_file_type_handler(&self, extension: &str, app_id: &str, app_path: &str) {
        // Update Windows registry
        // HKEY_CLASSES_ROOT\.ext -> progid
        // HKEY_CLASSES_ROOT\progid\shell\open\command -> app_path
    }

    #[cfg(target_os = "macos")]
    fn set_file_type_handler(&self, extension: &str, app_id: &str, app_path: &str) {
        // Update LaunchServices database
        // duti -s com.apple.app-bundle-id .ext all
    }

    #[cfg(target_os = "linux")]
    fn set_file_type_handler(&self, extension: &str, app_id: &str, app_path: &str) {
        // Update .desktop file associations
        // Update freedesktop.org MIME type database
    }

    #[cfg(target_os = "windows")]
    fn unregister_file_type(&self, extension: &str) {
        // Remove from Windows registry
    }

    #[cfg(target_os = "macos")]
    fn unregister_file_type(&self, extension: &str) {
        // Remove from LaunchServices
    }

    #[cfg(target_os = "linux")]
    fn unregister_file_type(&self, extension: &str) {
        // Remove from freedesktop.org MIME types
    }

    pub fn launch_application(&self, app_path: &str, file_path: &str) -> Result<()> {
        #[cfg(target_os = "windows")]
        {
            std::process::Command::new(app_path)
                .arg(file_path)
                .spawn()?;
        }

        #[cfg(target_os = "macos")]
        {
            std::process::Command::new("open")
                .arg("-a")
                .arg(app_path)
                .arg(file_path)
                .spawn()?;
        }

        #[cfg(target_os = "linux")]
        {
            std::process::Command::new(app_path)
                .arg(file_path)
                .spawn()?;
        }

        Ok(())
    }
}

// Global file association manager
pub static FILE_ASSOCIATION_MANAGER: LazyStatic<Mutex<FileAssociationManager>> =
    LazyStatic::new(|| {
        Mutex::new(FileAssociationManager::new(AssetManager::global()))
    });
