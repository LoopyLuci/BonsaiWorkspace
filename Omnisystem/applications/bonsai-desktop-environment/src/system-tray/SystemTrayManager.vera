// ============================================================================
// GLOBAL SYSTEM TRAY MANAGER
// ============================================================================

pub static SYSTEM_TRAY_MANAGER: LazyStatic<Mutex<SystemTrayManager>> =
    LazyStatic::new(|| {
        Mutex::new(SystemTrayManager::new(AssetManager::global()))
    });

// ============================================================================
// INTEGRATION WITH MAIN WINDOW
// ============================================================================

pub fn setup_tray_integration() {
    // Subscribe to events
    EVENT_SYSTEM.subscribe("window:minimize", |_| {
        // Minimize to tray
        let mut tray = SYSTEM_TRAY_MANAGER.lock().unwrap();
        tray.show_tray_icon();
        MAIN_WINDOW.minimize();
    });

    EVENT_SYSTEM.subscribe("tray:show-window", |_| {
        // Show/restore main window
        MAIN_WINDOW.show();
        MAIN_WINDOW.bring_to_front();
    });

    EVENT_SYSTEM.subscribe("tray:hide-window", |_| {
        // Hide main window
        MAIN_WINDOW.hide();
    });

    // Update tray status periodically
    spawn_thread(|| loop {
        {
            let mut tray = SYSTEM_TRAY_MANAGER.lock().unwrap();
            let cpu = get_cpu_usage();
            let memory = get_memory_usage();
            tray.update_status(cpu, memory);
        }
        std::thread::sleep(std::time::Duration::from_secs(2));
    });
}

