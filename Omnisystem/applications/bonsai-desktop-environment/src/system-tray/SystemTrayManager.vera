// System Tray Manager - Background Icon and Quick Access Menu
// Cross-platform tray integration for Windows, macOS, and Linux

use std::sync::{Arc, Mutex};
use std::time::SystemTime;

pub struct SystemTrayManager {
    id: String,
    title: String,
    theme: Theme,
    asset_manager: AssetManager,

    // Tray state
    visible: bool,
    icon_state: TrayIconState,
    menu_items: Vec<TrayMenuItem>,
    status_text: String,
    cpu_usage: f32,
    memory_usage: f32,

    // Platform handlers
    platform_handler: Arc<Mutex<PlatformTrayHandler>>,

    // Callback handlers
    on_click: Option<Box<dyn Fn()>>,
    on_double_click: Option<Box<dyn Fn()>>,
    on_exit: Option<Box<dyn Fn()>>,
}

impl SystemTrayManager {
    pub fn new(asset_manager: AssetManager) -> Self {
        let mut manager = Self {
            id: "system-tray-manager".to_string(),
            title: "Omnisystem Tray".to_string(),
            theme: asset_manager.get_current_theme(),
            asset_manager: asset_manager.clone(),
            visible: true,
            icon_state: TrayIconState::Normal,
            menu_items: vec![],
            status_text: "Omnisystem Running".to_string(),
            cpu_usage: 0.0,
            memory_usage: 0.0,
            platform_handler: Arc::new(Mutex::new(PlatformTrayHandler::new())),
            on_click: None,
            on_double_click: None,
            on_exit: None,
        };

        // Initialize default menu items
        manager.initialize_menu_items();

        // Create the tray icon
        manager.create_tray_icon();

        manager
    }

    // ============================================================================
    // TRAY ICON MANAGEMENT
    // ============================================================================

    pub fn create_tray_icon(&mut self) {
        // Create platform-specific tray icon
        let mut handler = self.platform_handler.lock().unwrap();
        handler.create_tray_icon(
            &self.title,
            self.get_icon_path(),
            self.menu_items.clone(),
        );
    }

    pub fn update_tray_icon(&mut self) {
        // Update tray icon based on state
        let mut handler = self.platform_handler.lock().unwrap();
        handler.update_tray_icon(self.get_icon_path(), &self.status_text);
    }

    pub fn set_icon_state(&mut self, state: TrayIconState) {
        self.icon_state = state;
        self.update_tray_icon();
    }

    pub fn show_tray_icon(&mut self) {
        if !self.visible {
            self.visible = true;
            self.create_tray_icon();
        }
    }

    pub fn hide_tray_icon(&mut self) {
        if self.visible {
            self.visible = false;
            let mut handler = self.platform_handler.lock().unwrap();
            handler.remove_tray_icon();
        }
    }

    fn get_icon_path(&self) -> String {
        // Return path based on current state
        match self.icon_state {
            TrayIconState::Normal => "omnisystem-tray-normal".to_string(),
            TrayIconState::Active => "omnisystem-tray-active".to_string(),
            TrayIconState::Warning => "omnisystem-tray-warning".to_string(),
            TrayIconState::Error => "omnisystem-tray-error".to_string(),
        }
    }

    // ============================================================================
    // TOOLTIP & STATUS
    // ============================================================================

    pub fn update_status(&mut self, cpu: f32, memory: f32) {
        self.cpu_usage = cpu;
        self.memory_usage = memory;

        // Format status text
        self.status_text = format!(
            "Omnisystem - CPU: {:.1}% | Memory: {:.1}%",
            cpu, memory
        );

        // Update tooltip
        self.update_tooltip();

        // Update icon based on resource usage
        if cpu > 80.0 || memory > 85.0 {
            self.set_icon_state(TrayIconState::Warning);
        } else if cpu > 95.0 || memory > 95.0 {
            self.set_icon_state(TrayIconState::Error);
        } else {
            self.set_icon_state(TrayIconState::Normal);
        }
    }

    pub fn update_tooltip(&self) {
        let tooltip = format!(
            "{}\nCPU: {:.1}%\nMemory: {:.1}%\nClick to show | Right-click for menu",
            self.status_text, self.cpu_usage, self.memory_usage
        );

        let mut handler = self.platform_handler.lock().unwrap();
        handler.set_tooltip(&tooltip);
    }

    // ============================================================================
    // CONTEXT MENU
    // ============================================================================

    pub fn initialize_menu_items(&mut self) {
        self.menu_items = vec![
            TrayMenuItem {
                id: "show".to_string(),
                label: "Show Window".to_string(),
                enabled: true,
                checked: false,
                icon: Some("window".to_string()),
            },
            TrayMenuItem {
                id: "hide".to_string(),
                label: "Hide Window".to_string(),
                enabled: true,
                checked: false,
                icon: Some("window-minimize".to_string()),
            },
            TrayMenuItem {
                id: "separator1".to_string(),
                label: "---".to_string(),
                enabled: false,
                checked: false,
                icon: None,
            },
            TrayMenuItem {
                id: "status".to_string(),
                label: "System Status".to_string(),
                enabled: true,
                checked: false,
                icon: Some("gauge".to_string()),
            },
            TrayMenuItem {
                id: "control-panel".to_string(),
                label: "Control Panel".to_string(),
                enabled: true,
                checked: false,
                icon: Some("sliders".to_string()),
            },
            TrayMenuItem {
                id: "separator2".to_string(),
                label: "---".to_string(),
                enabled: false,
                checked: false,
                icon: None,
            },
            TrayMenuItem {
                id: "open-logs".to_string(),
                label: "View Logs".to_string(),
                enabled: true,
                checked: false,
                icon: Some("file-text".to_string()),
            },
            TrayMenuItem {
                id: "settings".to_string(),
                label: "Settings".to_string(),
                enabled: true,
                checked: false,
                icon: Some("cog".to_string()),
            },
            TrayMenuItem {
                id: "separator3".to_string(),
                label: "---".to_string(),
                enabled: false,
                checked: false,
                icon: None,
            },
            TrayMenuItem {
                id: "exit".to_string(),
                label: "Exit Omnisystem".to_string(),
                enabled: true,
                checked: false,
                icon: Some("power".to_string()),
            },
        ];
    }

    pub fn add_menu_item(&mut self, item: TrayMenuItem) {
        self.menu_items.push(item);
        self.update_menu();
    }

    pub fn remove_menu_item(&mut self, item_id: &str) {
        self.menu_items.retain(|item| item.id != item_id);
        self.update_menu();
    }

    pub fn update_menu_item(&mut self, item_id: &str, enabled: bool, checked: bool) {
        if let Some(item) = self.menu_items.iter_mut().find(|i| i.id == item_id) {
            item.enabled = enabled;
            item.checked = checked;
        }
        self.update_menu();
    }

    pub fn update_menu(&self) {
        let mut handler = self.platform_handler.lock().unwrap();
        handler.update_menu(&self.menu_items);
    }

    pub fn handle_menu_click(&self, item_id: &str) {
        match item_id {
            "show" => self.show_main_window(),
            "hide" => self.hide_main_window(),
            "status" => self.show_status_dialog(),
            "control-panel" => self.show_control_panel(),
            "open-logs" => self.show_logs(),
            "settings" => self.show_settings(),
            "exit" => self.exit_application(),
            _ => {
                // Fire custom event for other menu items
                EVENT_SYSTEM.fire_event(format!("tray:menu:clicked:{}", item_id));
            }
        }
    }

    // ============================================================================
    // EVENT HANDLERS
    // ============================================================================

    pub fn set_on_click<F>(&mut self, handler: F)
    where
        F: Fn() + 'static,
    {
        self.on_click = Some(Box::new(handler));
    }

    pub fn set_on_double_click<F>(&mut self, handler: F)
    where
        F: Fn() + 'static,
    {
        self.on_double_click = Some(Box::new(handler));
    }

    pub fn set_on_exit<F>(&mut self, handler: F)
    where
        F: Fn() + 'static,
    {
        self.on_exit = Some(Box::new(handler));
    }

    pub fn handle_click(&self) {
        if let Some(ref handler) = self.on_click {
            handler();
        } else {
            // Default: show/toggle main window
            self.show_main_window();
        }
    }

    pub fn handle_double_click(&self) {
        if let Some(ref handler) = self.on_double_click {
            handler();
        } else {
            // Default: show control panel
            self.show_control_panel();
        }
    }

    pub fn handle_exit(&self) {
        if let Some(ref handler) = self.on_exit {
            handler();
        } else {
            // Default: exit application
            self.exit_application();
        }
    }

    // ============================================================================
    // WINDOW CONTROL
    // ============================================================================

    fn show_main_window(&self) {
        EVENT_SYSTEM.fire_event("tray:show-window".to_string());
    }

    fn hide_main_window(&self) {
        EVENT_SYSTEM.fire_event("tray:hide-window".to_string());
    }

    fn show_control_panel(&self) {
        EVENT_SYSTEM.fire_event("tray:show-control-panel".to_string());
    }

    fn show_status_dialog(&self) {
        // Show quick status dialog
        EVENT_SYSTEM.fire_event("tray:show-status".to_string());
    }

    fn show_logs(&self) {
        EVENT_SYSTEM.fire_event("tray:show-logs".to_string());
    }

    fn show_settings(&self) {
        EVENT_SYSTEM.fire_event("tray:show-settings".to_string());
    }

    fn exit_application(&self) {
        EVENT_SYSTEM.fire_event("tray:exit".to_string());
    }

    // ============================================================================
    // STATUS POPUP
    // ============================================================================

    pub fn render_status_popup(&self) -> Widget {
        Panel {
            id: "tray-status-popup".to_string(),
            width: 300.0,
            padding: 16.0,
            background_color: self.theme.colors.background,
            border: true,
            border_color: self.theme.colors.primary,

            children: vec![
                // Title
                Row {
                    spacing: 8.0,
                    margin_bottom: 12.0,

                    children: vec![
                        Circle {
                            radius: 8.0,
                            color: match self.icon_state {
                                TrayIconState::Normal => self.theme.colors.success,
                                TrayIconState::Active => self.theme.colors.info,
                                TrayIconState::Warning => self.theme.colors.warning,
                                TrayIconState::Error => self.theme.colors.error,
                            },
                        },
                        Label {
                            text: "Omnisystem Status".to_string(),
                            font_size: 14.0,
                            font_weight: 600,
                        },
                    ],
                },

                // Status details
                Column {
                    spacing: 8.0,

                    children: vec![
                        self.render_status_row("System", "Running"),
                        self.render_status_row(
                            "CPU Usage",
                            &format!("{:.1}%", self.cpu_usage),
                        ),
                        self.render_status_row(
                            "Memory",
                            &format!("{:.1}%", self.memory_usage),
                        ),
                        self.render_status_row("Uptime", "2d 14h 32m"),
                        self.render_status_row("Services", "12 running"),
                    ],
                },

                Separator { margin: 12.0 },

                // Action buttons
                Column {
                    spacing: 6.0,

                    children: vec![
                        Button {
                            label: "Show Control Panel".to_string(),
                            width: "100%".to_string(),
                            onClick: || {
                                SYSTEM_TRAY_MANAGER.show_control_panel();
                            },
                        },
                        Button {
                            label: "Show Main Window".to_string(),
                            width: "100%".to_string(),
                            variant: "secondary".to_string(),
                            onClick: || {
                                SYSTEM_TRAY_MANAGER.show_main_window();
                            },
                        },
                    ],
                },
            ],
        }
    }

    fn render_status_row(&self, label: &str, value: &str) -> Widget {
        Row {
            spacing: 8.0,

            children: vec![
                Label {
                    text: format!("{}:", label),
                    font_size: 12.0,
                    font_weight: 500,
                    width: "40%".to_string(),
                    color: self.theme.colors.foreground_secondary,
                },
                Label {
                    text: value.to_string(),
                    font_size: 12.0,
                    width: "60%".to_string(),
                    color: self.theme.colors.foreground,
                },
            ],
        }
    }

    // ============================================================================
    // CONTEXT MENU POPUP (Windows/Linux)
    // ============================================================================

    pub fn render_context_menu(&self) -> Widget {
        Column {
            id: "tray-context-menu".to_string(),
            spacing: 0.0,

            children: self
                .menu_items
                .iter()
                .map(|item| self.render_menu_item(item))
                .collect(),
        }
    }

    fn render_menu_item(&self, item: &TrayMenuItem) -> Widget {
        if item.label == "---" {
            // Separator
            Separator {
                margin: 4.0,
                color: self.theme.colors.border,
            }
        } else {
            // Regular menu item
            Button {
                id: format!("menu-{}", item.id),
                label: item.label.clone(),
                width: "100%".to_string(),
                disabled: !item.enabled,
                variant: if item.checked {
                    "primary".to_string()
                } else {
                    "ghost".to_string()
                },
                icon: item
                    .icon
                    .as_ref()
                    .map(|icon_name| self.asset_manager.load_icon(icon_name, 16)),
                text_align: "left".to_string(),
                onClick: {
                    let item_id = item.id.clone();
                    move || {
                        SYSTEM_TRAY_MANAGER.handle_menu_click(&item_id);
                    }
                },
            }
        }
    }

    // ============================================================================
    // NOTIFICATIONS IN TRAY
    // ============================================================================

    pub fn show_notification_badge(&mut self, count: usize) {
        // Show unread notification count on tray icon
        let mut handler = self.platform_handler.lock().unwrap();
        handler.set_badge_count(count);
    }

    pub fn clear_notification_badge(&mut self) {
        let mut handler = self.platform_handler.lock().unwrap();
        handler.clear_badge();
    }
}

// ============================================================================
// DATA STRUCTURES
// ============================================================================

