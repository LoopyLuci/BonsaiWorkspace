    Normal,
    Active,
    Warning,
    Error,
}

#[derive(Clone, Debug)]
pub struct TrayMenuItem {
    pub id: String,
    pub label: String,
    pub enabled: bool,
    pub checked: bool,
    pub icon: Option<String>,
}

