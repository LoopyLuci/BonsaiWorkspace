// CONTROL PANEL API SERVER
// REST API endpoints for Control Panel UI
// Provides unified access to all system monitoring and management functions

// ═══════════════════════════════════════════════════════════════════════════════
// HTTP SERVER & ROUTING
// ═══════════════════════════════════════════════════════════════════════════════

pub fn api_server_start(port: i64) -> String {
    // Starts Control Panel API server on specified port (default: 12345)
    println("Starting Control Panel API Server on port: ");
    print_i64(port);
    println("");

    let server = json_create_object();
    let s1 = json_object_set(server, "port", int_to_string(port));
    let s2 = json_object_set(s1, "status", "running");
    let s3 = json_object_set(s2, "url", "http://localhost:");
    omnisystem_type_wrap(s3, "control_panel/api_server")
}

pub fn api_server_stop() -> String {
    // Stops Control Panel API server
    println("Stopping Control Panel API Server");
    let result = json_create_object();
    let r1 = json_object_set(result, "status", "stopped");
    omnisystem_type_wrap(r1, "control_panel/api_server_stop")
}

