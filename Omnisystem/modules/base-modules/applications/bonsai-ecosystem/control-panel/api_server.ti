// GET ENDPOINTS - System Information & Status
// ═══════════════════════════════════════════════════════════════════════════════

// GET /api/v1/system
pub fn http_get_system() -> String {
    // Returns complete system information
    // Response: {uptime, version, timestamp, hostname, os}
    let response = api_response_create("200", "OK");
    response
}

// GET /api/v1/system/cpu
pub fn http_get_cpu_stats() -> String {
    // Returns CPU statistics
    // Response: {cores, usage, frequency, temperature}
    let response = api_response_create("200", "OK");
    response
}

// GET /api/v1/system/memory
pub fn http_get_memory_stats() -> String {
    // Returns memory statistics
    // Response: {total, used, free, usage_percent}
    let response = api_response_create("200", "OK");
    response
}

// GET /api/v1/system/disk
pub fn http_get_disk_stats() -> String {
    // Returns disk statistics for all mounted drives
