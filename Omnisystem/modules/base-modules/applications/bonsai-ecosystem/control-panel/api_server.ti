// ═══════════════════════════════════════════════════════════════════════════════
// HELPER FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

fn api_response_create(status_code: String, message: String) -> String {
    // Creates API response object
    let response = json_create_object();
    let r1 = json_object_set(response, "status_code", status_code);
    let r2 = json_object_set(r1, "message", message);
    omnisystem_type_wrap(r2, "control_panel/api_response")
}

fn json_create_object() -> String { "" }
fn json_object_set(obj: String, key: String, value: String) -> String { "" }
fn omnisystem_type_wrap(value: String, type_name: String) -> String { "" }
fn int_to_string(n: i64) -> String { "" }
fn print(msg: String) {}

fn println(msg: String) {
    print(msg);
    print("\n");
}

fn print_i64(n: i64) {
    print(int_to_string(n));
}
