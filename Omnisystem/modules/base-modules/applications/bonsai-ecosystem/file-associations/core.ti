// FILE ASSOCIATIONS - File Type Registration & Default App Handling
// Cross-platform file type association system
// Registers file types and sets default application handlers

// ═══════════════════════════════════════════════════════════════════════════════
// FILE TYPE REGISTRATION & MANAGEMENT
// ═══════════════════════════════════════════════════════════════════════════════

pub fn file_association_register(
    file_extension: String,
    file_type_name: String,
    description: String,
    icon_path: String
) -> String {
    // Registers a file type with the system
    println("Registering file type: ");
    print(file_extension);
    println("");

    let association = json_create_object();
    let a1 = json_object_set(association, "extension", file_extension);
    let a2 = json_object_set(a1, "type_name", file_type_name);
    let a3 = json_object_set(a2, "description", description);
    let a4 = json_object_set(a3, "icon_path", icon_path);
    let a5 = json_object_set(a4, "registered", "true");

    omnisystem_type_wrap(a5, "file_associations/registration")
}

pub fn file_association_set_default_app(
    file_extension: String,
    application_id: String,
    executable_path: String
) -> String {
    // Sets default application for file type
    println("Setting default app for ");
    print(file_extension);
    print(": ");
    print(application_id);
    println("");

    if is_windows() {
        register_windows_file_association(file_extension, executable_path);
    } else if is_macos() {
        register_macos_file_association(file_extension, application_id);
    } else if is_linux() {
        register_linux_file_association(file_extension, application_id);
    }

    let result = json_create_object();
    let r1 = json_object_set(result, "extension", file_extension);
    let r2 = json_object_set(r1, "app_id", application_id);
    let r3 = json_object_set(r2, "default_set", "true");

    omnisystem_type_wrap(r3, "file_associations/default_app_set")
}

pub fn file_association_get_default_app(file_extension: String) -> String {
    // Gets default application for file type
    let app = json_create_object();
    let a1 = json_object_set(app, "extension", file_extension);
    let a2 = json_object_set(a1, "app_id", "omnisystem-workspace");
    let a3 = json_object_set(a2, "executable", get_default_app_path(file_extension));

    omnisystem_type_wrap(a3, "file_associations/default_app")
}

pub fn file_association_list_all() -> String {
    // Lists all registered file associations
    println("Listing file associations...");

    let associations = json_create_array();
    omnisystem_type_wrap(associations, "file_associations/all")
}

pub fn file_association_remove(file_extension: String) -> String {
    // Removes file association
    println("Removing file association: ");
    print(file_extension);
    println("");

    let result = json_create_object();
    let r1 = json_object_set(result, "extension", file_extension);
    let r2 = json_object_set(r1, "removed", "true");

    omnisystem_type_wrap(r2, "file_associations/removal")
}

// ═══════════════════════════════════════════════════════════════════════════════
// OMNISYSTEM FILE TYPES
// ═══════════════════════════════════════════════════════════════════════════════

pub fn file_associations_omnisystem_register() -> String {
    // Registers all Omnisystem file types
    println("╔════════════════════════════════════════════════════════════════╗");
    println("║ Registering Omnisystem File Types                             ║");
    println("╚════════════════════════════════════════════════════════════════╝\n");

    // Project files
    file_association_register(
        ".omnisystem",
        "Omnisystem Project",
        "Omnisystem Development Project",
        "omnisystem_project.png"
    );

    // Code files
    file_association_register(
        ".ti",
        "Titan Source Code",
        "Titan Programming Language Source",
        "titan_code.png"
    );

    // Workspace
    file_association_register(
        ".workspace",
        "Omnisystem Workspace",
        "IDE Workspace Configuration",
        "workspace.png"
    );

    // Code snippets
    file_association_register(
        ".code",
        "Code Snippet",
        "Omnisystem Code Snippet",
        "code_snippet.png"
    );

    // AI models
    file_association_register(
        ".model",
        "AI Model",
        "Omnisystem AI Model",
        "model.png"
    );

    // Compiled binaries
    file_association_register(
        ".omnib",
        "Omnisystem Binary",
        "Compiled Omnisystem Binary",
        "binary.png"
    );

    // Configuration
    file_association_register(
        ".omnisystem-config",
        "Omnisystem Config",
        "Omnisystem Configuration File",
        "config.png"
    );

    println("\n✅ All Omnisystem file types registered\n");

    let result = json_create_object();
    let r1 = json_object_set(result, "types_registered", "7");
    omnisystem_type_wrap(r1, "file_associations/omnisystem_types")
}

// ═══════════════════════════════════════════════════════════════════════════════
// CONTEXT MENU INTEGRATION
// ═══════════════════════════════════════════════════════════════════════════════

pub fn file_association_context_menu_add(
    file_extension: String,
    menu_item_label: String,
    action_command: String
) -> String {
    // Adds context menu item for file type
    println("Adding context menu: ");
    print(menu_item_label);
    println("");

    let menu_item = json_create_object();
    let m1 = json_object_set(menu_item, "extension", file_extension);
    let m2 = json_object_set(m1, "label", menu_item_label);
    let m3 = json_object_set(m2, "action", action_command);

    omnisystem_type_wrap(m3, "file_associations/context_menu_item")
}

pub fn file_association_context_menus_register() -> String {
    // Registers context menu items for file types
    println("\n📋 Registering Context Menus...\n");

    // For .ti files
    file_association_context_menu_add(".ti", "Open with Workspace", "omnisystem-workspace $(file)");
    file_association_context_menu_add(".ti", "Format Code", "omnisystem fmt $(file)");
    file_association_context_menu_add(".ti", "Check Syntax", "omnisystem check $(file)");
    file_association_context_menu_add(".ti", "Run", "omnisystem run $(file)");

    // For .omnisystem files
    file_association_context_menu_add(
        ".omnisystem",
        "Open Project",
        "omnisystem-workspace open-project $(file)"
    );
    file_association_context_menu_add(".omnisystem", "Build Project", "omnisystem build $(dir)");
    file_association_context_menu_add(".omnisystem", "Run Tests", "omnisystem test $(dir)");

    // For .model files
    file_association_context_menu_add(".model", "Load Model", "buddy-ai load $(file)");
    file_association_context_menu_add(".model", "Test Model", "buddy-ai test $(file)");
    file_association_context_menu_add(".model", "Export Model", "buddy-ai export $(file)");

    println("✅ Context menus registered\n");

    let result = json_create_object();
    omnisystem_type_wrap(result, "file_associations/context_menus")
}

// ═══════════════════════════════════════════════════════════════════════════════
// OPEN WITH DIALOG INTEGRATION
// ═══════════════════════════════════════════════════════════════════════════════

pub fn file_association_add_to_open_with_dialog(
    file_extension: String,
    application_id: String
) -> String {
    // Adds application to "Open With" dialog
    println("Adding to Open With: ");
    print(application_id);
    println("");

    let app = json_create_object();
    let a1 = json_object_set(app, "extension", file_extension);
    let a2 = json_object_set(a1, "app_id", application_id);
    let a3 = json_object_set(a2, "added_to_dialog", "true");

    omnisystem_type_wrap(a3, "file_associations/open_with")
}

pub fn file_association_open_with_register_all() -> String {
    // Registers Omnisystem apps in Open With dialogs
    println("\n🔓 Registering Open With Entries...\n");

    // Workspace for code files
    file_association_add_to_open_with_dialog(".ti", "omnisystem-workspace");
    file_association_add_to_open_with_dialog(".code", "omnisystem-workspace");
    file_association_add_to_open_with_dialog(".omnisystem", "omnisystem-workspace");

    // Buddy for models and data
    file_association_add_to_open_with_dialog(".model", "buddy-ai");
    file_association_add_to_open_with_dialog(".data", "buddy-ai");

    // Control Panel for configs
    file_association_add_to_open_with_dialog(".omnisystem-config", "control-panel");

    println("✅ Open With entries registered\n");

    let result = json_create_object();
    omnisystem_type_wrap(result, "file_associations/open_with_all")
}

// ═══════════════════════════════════════════════════════════════════════════════
// DRAG & DROP SUPPORT
// ═══════════════════════════════════════════════════════════════════════════════

pub fn file_association_drag_drop_handler_register(
    file_extension: String,
    handler_application: String
) -> String {
    // Registers drag & drop handler for file type
    println("Registering drag & drop: ");
    print(file_extension);
    println("");

    let handler = json_create_object();
    let h1 = json_object_set(handler, "extension", file_extension);
    let h2 = json_object_set(h1, "handler_app", handler_application);
    let h3 = json_object_set(h2, "drag_drop_enabled", "true");

    omnisystem_type_wrap(h3, "file_associations/drag_drop_handler")
}

// ═══════════════════════════════════════════════════════════════════════════════
// FILE TYPE MIME TYPES
// ═══════════════════════════════════════════════════════════════════════════════

pub fn file_association_mime_type_register(
    file_extension: String,
    mime_type: String
) -> String {
    // Registers MIME type for file extension (Linux)
    println("Registering MIME type: ");
    print(file_extension);
    print(" -> ");
    print(mime_type);
    println("");

    let mime = json_create_object();
    let m1 = json_object_set(mime, "extension", file_extension);
    let m2 = json_object_set(m1, "mime_type", mime_type);

    omnisystem_type_wrap(m2, "file_associations/mime_type")
}

pub fn file_association_mime_types_register() -> String {
    // Registers all Omnisystem MIME types
    println("\n📄 Registering MIME Types...\n");

    file_association_mime_type_register(".ti", "text/x-titan");
    file_association_mime_type_register(".omnisystem", "application/x-omnisystem-project");
    file_association_mime_type_register(".model", "application/x-omnisystem-model");
    file_association_mime_type_register(".code", "text/x-omnisystem-snippet");
    file_association_mime_type_register(".omnib", "application/x-omnisystem-binary");

    println("✅ MIME types registered\n");

    let result = json_create_object();
    omnisystem_type_wrap(result, "file_associations/mime_types")
}

// ═══════════════════════════════════════════════════════════════════════════════
// PLATFORM-SPECIFIC IMPLEMENTATIONS
// ═══════════════════════════════════════════════════════════════════════════════

fn register_windows_file_association(extension: String, executable: String) -> String {
    // Registers file association in Windows Registry
    // HKEY_CLASSES_ROOT\.extension -> Registry entry
    "registered"
}

fn register_macos_file_association(extension: String, app_id: String) -> String {
    // Registers file association on macOS
    // Updates /System/Library/CoreServices/LaunchServices/ApplicationServices.plist
    "registered"
}

fn register_linux_file_association(extension: String, app_id: String) -> String {
    // Registers file association on Linux
    // Updates ~/.config/mimeapps.list
    // Registers MIME type in /usr/share/mime/
    "registered"
}

fn get_default_app_path(extension: String) -> String {
    "/opt/omnisystem/bin/omnisystem-workspace"
}

fn is_windows() -> i64 { 0 }
fn is_macos() -> i64 { 0 }
fn is_linux() -> i64 { 1 }

fn json_create_object() -> String { "" }
fn json_create_array() -> String { "" }
fn json_object_set(obj: String, key: String, value: String) -> String { "" }
fn omnisystem_type_wrap(value: String, type_name: String) -> String { "" }
fn print(msg: String) {}

fn println(msg: String) {
    print(msg);
    print("\n");
}
