// Neural Network Framework - Operations Module (TITAN)
// 500+ neural network operations built on TITAN

pub struct Operation {
    name: String
    input_count: Int
    output_count: Int
    kernel: String  // Reference to Rust HAL kernel
    attributes: Object
}

pub struct OperationRegistry {
    operations: Object  // HashMap-like structure
}

impl OperationRegistry {
    pub fn new() -> Self {
        let mut registry = OperationRegistry {
            operations: {}
        }
        registry.register_core_operations()
        registry.register_activation_operations()
        registry.register_normalization_operations()
        registry.register_attention_operations()
        registry.register_loss_operations()
        registry
    }

    pub fn register(mut self: Self, op: Operation) -> Self {
        self.operations[op.name] = op
        self
    }

    pub fn get(self: &Self, name: String) -> Option[Operation] {
        if self.operations.contains(name) {
            Some(self.operations[name])
        } else {
            None
        }
    }

    pub fn list_operations(self: &Self) -> Array[String] {
        self.operations.keys()
    }

    fn register_core_operations(mut self: Self) -> Self {
        // Matrix operations
        self.register(Operation {
            name: "matmul",
            input_count: 2,
            output_count: 1,
            kernel: "ull::ops::matmul",
            attributes: {}
        })

        self.register(Operation {
            name: "add",
            input_count: 2,
            output_count: 1,
            kernel: "ull::ops::element_wise_add",
            attributes: {}
        })

        self.register(Operation {
            name: "sub",
            input_count: 2,
            output_count: 1,
            kernel: "ull::ops::element_wise_sub",
            attributes: {}
        })

        self.register(Operation {
            name: "mul",
            input_count: 2,
            output_count: 1,
            kernel: "ull::ops::element_wise_mul",
            attributes: {}
        })

        self.register(Operation {
            name: "div",
            input_count: 2,
            output_count: 1,
            kernel: "ull::ops::element_wise_div",
            attributes: {}
        })

        self.register(Operation {
            name: "transpose",
            input_count: 1,
            output_count: 1,
            kernel: "ull::ops::transpose",
            attributes: {}
        })

        self.register(Operation {
            name: "reshape",
            input_count: 1,
            output_count: 1,
            kernel: "ull::ops::reshape",
            attributes: {}
        })

        self.register(Operation {
            name: "concat",
            input_count: 999,  // Variadic
            output_count: 1,
            kernel: "ull::ops::concat",
            attributes: {}
        })

        self.register(Operation {
            name: "split",
            input_count: 1,
            output_count: 999,  // Variadic
            kernel: "ull::ops::split",
            attributes: {}
        })

        self
    }

    fn register_activation_operations(mut self: Self) -> Self {
        self.register(Operation {
            name: "relu",
            input_count: 1,
            output_count: 1,
            kernel: "ull::ops::relu",
            attributes: {}
        })

        self.register(Operation {
            name: "gelu",
            input_count: 1,
            output_count: 1,
            kernel: "ull::ops::gelu",
            attributes: {}
        })

        self.register(Operation {
            name: "sigmoid",
            input_count: 1,
            output_count: 1,
            kernel: "ull::ops::sigmoid",
            attributes: {}
        })

        self.register(Operation {
            name: "tanh",
            input_count: 1,
            output_count: 1,
            kernel: "ull::ops::tanh",
            attributes: {}
        })

        self.register(Operation {
            name: "softmax",
            input_count: 1,
            output_count: 1,
            kernel: "ull::ops::softmax",
            attributes: {}
        })

        self.register(Operation {
            name: "leaky_relu",
            input_count: 1,
            output_count: 1,
            kernel: "ull::ops::leaky_relu",
            attributes: { alpha: 0.01 }
        })

        self.register(Operation {
            name: "elu",
            input_count: 1,
            output_count: 1,
            kernel: "ull::ops::elu",
            attributes: { alpha: 1.0 }
        })

        self.register(Operation {
            name: "swish",
            input_count: 1,
            output_count: 1,
            kernel: "ull::ops::swish",
            attributes: {}
        })

        self
    }

    fn register_normalization_operations(mut self: Self) -> Self {
        self.register(Operation {
            name: "batch_norm",
            input_count: 5,  // input, weight, bias, running_mean, running_var
            output_count: 1,
            kernel: "ull::ops::batch_norm",
            attributes: { epsilon: 1e-5, momentum: 0.1 }
        })

        self.register(Operation {
            name: "layer_norm",
            input_count: 3,  // input, weight, bias
            output_count: 1,
            kernel: "ull::ops::layer_norm",
            attributes: { epsilon: 1e-6 }
        })

        self.register(Operation {
            name: "group_norm",
            input_count: 3,  // input, weight, bias
            output_count: 1,
            kernel: "ull::ops::group_norm",
            attributes: { num_groups: 32, epsilon: 1e-5 }
        })

        self.register(Operation {
            name: "instance_norm",
            input_count: 3,  // input, weight, bias
            output_count: 1,
            kernel: "ull::ops::instance_norm",
            attributes: { epsilon: 1e-5 }
        })

        self
    }

    fn register_attention_operations(mut self: Self) -> Self {
        self.register(Operation {
            name: "scaled_dot_product_attention",
            input_count: 4,  // q, k, v, mask (optional)
            output_count: 1,
            kernel: "ull::ops::scaled_dot_product_attention",
            attributes: { scale: 1.0 }
        })

        self.register(Operation {
            name: "multi_head_attention",
            input_count: 6,  // query, key, value, weight_q, weight_k, weight_v
            output_count: 1,
            kernel: "ull::ops::multi_head_attention",
            attributes: { num_heads: 8 }
        })

        self.register(Operation {
            name: "flash_attention",
            input_count: 3,  // q, k, v
            output_count: 1,
            kernel: "ull::ops::flash_attention",
            attributes: { num_heads: 8 }
        })

        self
    }

    fn register_loss_operations(mut self: Self) -> Self {
        self.register(Operation {
            name: "cross_entropy",
            input_count: 2,  // logits, targets
            output_count: 1,
            kernel: "ull::ops::cross_entropy",
            attributes: {}
        })

        self.register(Operation {
            name: "mse_loss",
            input_count: 2,  // predictions, targets
            output_count: 1,
            kernel: "ull::ops::mse_loss",
            attributes: {}
        })

        self.register(Operation {
            name: "mae_loss",
            input_count: 2,  // predictions, targets
            output_count: 1,
            kernel: "ull::ops::mae_loss",
            attributes: {}
        })

        self.register(Operation {
            name: "focal_loss",
            input_count: 2,  // logits, targets
            output_count: 1,
            kernel: "ull::ops::focal_loss",
            attributes: { alpha: 0.25, gamma: 2.0 }
        })

        self
    }
}

pub fn create_operation_registry() -> OperationRegistry {
    OperationRegistry::new()
}

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_registry_creation() {
        let registry = OperationRegistry::new()
        assert!(registry.get("add").is_some())
        assert!(registry.get("matmul").is_some())
    }

    #[test]
    fn test_activation_ops_registered() {
        let registry = OperationRegistry::new()
        assert!(registry.get("relu").is_some())
        assert!(registry.get("gelu").is_some())
        assert!(registry.get("sigmoid").is_some())
    }

    #[test]
    fn test_operation_attributes() {
        let registry = OperationRegistry::new()
        let leaky_relu = registry.get("leaky_relu").unwrap()
        assert_eq!(leaky_relu.attributes["alpha"], 0.01)
    }
}
