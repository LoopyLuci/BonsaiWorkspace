  pub struct BaseModuleRegistry {
    total_modules: usize,
    core_modules: usize,
    framework_modules: usize,
    platform_modules: usize,
  }

  impl BaseModuleRegistry {
    pub fn new() -> Self {
      Self {
        total_modules: 230,
        core_modules: 50,
        framework_modules: 80,
        platform_modules: 100,
      }
    }

    pub fn get_summary(&self) -> String {
      format!(
        "Base Modules: {} total\n  - Core: {}\n  - Framework: {}\n  - Platform: {}",
        self.total_modules,
        self.core_modules,
        self.framework_modules,
        self.platform_modules
      )
    }
  }
