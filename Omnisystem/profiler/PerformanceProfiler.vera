// Omnisystem Performance Profiler - CPU, Memory, and I/O Profiling
// Detailed flame graphs, call tree analysis, and bottleneck identification

use std::collections::HashMap;

pub struct PerformanceProfiler {
    id: String,
    version: String,
    theme: Theme,
    asset_manager: AssetManager,

    // Profiling state
    current_view: ProfilerView,
    is_profiling: bool,
    is_paused: bool,
    profiling_mode: ProfilingMode,

    // Profile data
    active_session: Option<ProfileSession>,
    call_tree: Vec<CallTreeNode>,
    flame_graph_data: Vec<FlameGraphEntry>,
    memory_allocations: Vec<MemoryAllocation>,
    hot_functions: Vec<FunctionProfile>,

    // Settings
    profiling_interval: u32,
    sample_rate: u32,
    track_memory: bool,
    track_io: bool,
    track_allocations: bool,
}

impl PerformanceProfiler {
    pub fn new(asset_manager: AssetManager) -> Self {
        Self {
            id: "performance-profiler".to_string(),
            version: "29.0.0".to_string(),
            theme: asset_manager.get_current_theme(),
            asset_manager: asset_manager.clone(),
            current_view: ProfilerView::FlameGraph,
            is_profiling: false,
            is_paused: false,
            profiling_mode: ProfilingMode::CPU,
            active_session: None,
            call_tree: vec![],
            flame_graph_data: Self::get_sample_flame_graph(),
            memory_allocations: vec![],
            hot_functions: Self::get_sample_hot_functions(),
            profiling_interval: 1,
            sample_rate: 1000,
            track_memory: true,
            track_io: true,
            track_allocations: true,
        }
    }

    pub fn render(&self) -> Widget {
        ApplicationWindow {
            id: "performance-profiler".to_string(),
            title: "Omnisystem Performance Profiler".to_string(),
            width: 1800,
            height: 1000,

            children: vec![
                self.render_header(),

                Row {
                    spacing: 0.0,
                    height: "1fr".to_string(),

                    children: vec![
                        // Sidebar
                        self.render_sidebar(),

                        // Main content
                        Panel {
                            width: "1fr".to_string(),
                            padding: 20.0,
                            background_color: self.theme.colors.background,

                            children: match self.current_view {
                                ProfilerView::FlameGraph => self.render_flame_graph_view(),
                                ProfilerView::CallTree => self.render_call_tree_view(),
                                ProfilerView::HotFunctions => self.render_hot_functions_view(),
                                ProfilerView::Memory => self.render_memory_view(),
                                ProfilerView::Timeline => self.render_timeline_view(),
                            },
                        },
                    ],
                },
            ],
        }
    }

    fn render_header(&self) -> Widget {
        Panel {
            height: 60.0,
            padding: 16.0,
            background_color: self.theme.colors.primary,
            border_bottom: true,

            children: vec![
                Row {
                    spacing: 12.0,
                    vertical_align: "center".to_string(),

                    children: vec![
                        Image {
                            source: self.asset_manager.load_icon("profile", 32),
                            width: 32.0,
                            height: 32.0,
                        },

                        Label {
                            text: "Performance Profiler".to_string(),
                            font_size: 18.0,
                            font_weight: 700,
                            color: self.theme.colors.white,
                        },

                        // Profiling controls
                        if self.is_profiling {
                            Row {
                                spacing: 8.0,

                                children: vec![
                                    Button {
                                        label: "⏹ Stop".to_string(),
                                        onClick: || {
                                            PROFILER_STATE.stop_profiling();
                                        },
                                    },
                                    Button {
                                        label: if self.is_paused { "▶ Resume" } else { "⏸ Pause" },
                                        onClick: || {
                                            if PROFILER_STATE.is_paused() {
                                                PROFILER_STATE.resume_profiling();
                                            } else {
                                                PROFILER_STATE.pause_profiling();
                                            }
                                        },
                                    },
                                ],
                            }
                        } else {
                            Button {
                                label: "▶ Start Profiling".to_string(),
                                variant: "primary".to_string(),
                                onClick: || {
                                    PROFILER_STATE.start_profiling();
                                },
                            }
                        },

                        Separator { width: 1.0, height: 40.0, margin: 8.0 },

                        // Mode selector
                        Label {
                            text: "Mode:".to_string(),
                            font_size: 11.0,
                        },

                        Dropdown {
                            options: vec!["CPU", "Memory", "I/O", "Allocations"],
                            selected: 0,
                            onChange: |index| {
                                let mode = match index {
                                    1 => ProfilingMode::Memory,
                                    2 => ProfilingMode::IO,
                                    3 => ProfilingMode::Allocations,
                                    _ => ProfilingMode::CPU,
                                };
                                PROFILER_STATE.set_profiling_mode(mode);
                            },
                        },

                        Spacer {},

                        Label {
                            text: if self.is_profiling {
                                "Profiling...".to_string()
                            } else {
                                "Ready".to_string()
                            },
                            font_size: 11.0,
                            color: if self.is_profiling { self.theme.colors.success } else { self.theme.colors.foreground_secondary },
                            font_weight: 600,
                        },
                    ],
                },
            ],
        }
    }

    fn render_sidebar(&self) -> Widget {
        Panel {
            width: "220px".to_string(),
            padding: 12.0,
            background_color: self.theme.colors.surface,
            border_right: true,

            children: vec![
                Column {
                    spacing: 2.0,
                    margin_bottom: 20.0,

                    children: vec![
                        self.render_view_button("Flame Graph", ProfilerView::FlameGraph),
                        self.render_view_button("Call Tree", ProfilerView::CallTree),
                        self.render_view_button("Hot Functions", ProfilerView::HotFunctions),
                        self.render_view_button("Memory", ProfilerView::Memory),
                        self.render_view_button("Timeline", ProfilerView::Timeline),
                    ],
                },

                Separator { margin: 12.0 },

                Label {
                    text: "Profiling Settings".to_string(),
                    font_size: 11.0,
                    font_weight: 700,
                    margin_bottom: 12.0,
                },

                Column {
                    spacing: 12.0,

                    children: vec![
                        Column {
                            spacing: 4.0,

                            children: vec![
                                Label {
                                    text: "Sample Rate (Hz)".to_string(),
                                    font_size: 10.0,
                                },
                                Slider {
                                    value: 1000,
                                    min: 100,
                                    max: 10000,
                                    onChange: |rate| {
                                        PROFILER_STATE.set_sample_rate(rate as u32);
                                    },
                                },
                                Label {
                                    text: format!("{} Hz", 1000),
                                    font_size: 10.0,
                                    color: self.theme.colors.foreground_secondary,
                                },
                            ],
                        },

                        Checkbox {
                            label: "Track Memory".to_string(),
                            checked: self.track_memory,
                            onChange: |enabled| {
                                PROFILER_STATE.set_track_memory(enabled);
                            },
                        },

                        Checkbox {
                            label: "Track I/O".to_string(),
                            checked: self.track_io,
                            onChange: |enabled| {
                                PROFILER_STATE.set_track_io(enabled);
                            },
                        },

                        Checkbox {
                            label: "Track Allocations".to_string(),
                            checked: self.track_allocations,
                            onChange: |enabled| {
                                PROFILER_STATE.set_track_allocations(enabled);
                            },
                        },

                        Separator { margin: 8.0 },

                        Button {
                            label: "Export Report".to_string(),
                            variant: "secondary".to_string(),
                            onClick: || {
                                PROFILER_STATE.export_profile();
                            },
                        },

                        Button {
                            label: "Clear Data".to_string(),
                            variant: "secondary".to_string(),
                            onClick: || {
                                PROFILER_STATE.clear_profile_data();
                            },
                        },
                    ],
                },
            ],
        }
    }

    fn render_flame_graph_view(&self) -> Vec<Widget> {
        vec![
            Column {
                spacing: 16.0,

                children: vec![
                    Label {
                        text: "Flame Graph (CPU Time by Call Stack)".to_string(),
                        font_size: 16.0,
                        font_weight: 700,
                        margin_bottom: 12.0,
                    },

                    // Flame graph visualization
                    Panel {
                        height: "500px".to_string(),
                        background_color: self.theme.colors.surface,
                        border: true,
                        padding: 16.0,

                        children: vec![
                            if self.flame_graph_data.is_empty() {
                                Label {
                                    text: "No profiling data available. Start profiling to begin.".to_string(),
                                    font_size: 12.0,
                                    color: self.theme.colors.foreground_secondary,
                                }
                            } else {
                                FlameGraphWidget {
                                    data: self.flame_graph_data.clone(),
                                    height: "460px".to_string(),
                                    on_click_function: |function_name| {
                                        PROFILER_STATE.focus_function(&function_name);
                                    },
                                }
                            },
                        ],
                    },

                    Label {
                        text: "Legend: Width = CPU time • Color = Function type".to_string(),
                        font_size: 11.0,
                        color: self.theme.colors.foreground_secondary,
                        margin_bottom: 12.0,
                    },

                    // Statistics
                    Row {
                        spacing: 16.0,

                        children: vec![
                            self.render_stat_box("Total Time", "2.34s", self.theme.colors.primary),
                            self.render_stat_box("Sampling Rate", "1000 Hz", self.theme.colors.primary),
                            self.render_stat_box("Samples Collected", "2,340", self.theme.colors.success),
                        ],
                    },
                ],
            },
        ]
    }

    fn render_call_tree_view(&self) -> Vec<Widget> {
        vec![
            Column {
                spacing: 16.0,

                children: vec![
                    Label {
                        text: "Call Tree".to_string(),
                        font_size: 16.0,
                        font_weight: 700,
                        margin_bottom: 12.0,
                    },

                    Panel {
                        height: "600px".to_string(),
                        background_color: self.theme.colors.surface,
                        border: true,
                        padding: 12.0,

                        children: vec![
                            ScrollView {
                                children: vec![
                                    self.render_call_tree_node(&CallTreeNode {
                                        function: "main".to_string(),
                                        time: 2340.0,
                                        time_percent: 100.0,
                                        calls: 1,
                                        children: vec![
                                            CallTreeNode {
                                                function: "process_data".to_string(),
                                                time: 1560.0,
                                                time_percent: 66.7,
                                                calls: 1200,
                                                children: vec![],
                                            },
                                            CallTreeNode {
                                                function: "render_ui".to_string(),
                                                time: 780.0,
                                                time_percent: 33.3,
                                                calls: 60,
                                                children: vec![],
                                            },
                                        ],
                                    }, 0),
                                ],
                            },
                        ],
                    },
                ],
            },
        ]
    }

    fn render_call_tree_node(&self, node: &CallTreeNode, depth: u32) -> Widget {
        Column {
            spacing: 0.0,

            children: vec![
                Panel {
                    padding: 8.0,
                    background_color: self.theme.colors.surface,
                    margin_bottom: 0.0,

                    children: vec![
                        Row {
                            spacing: 16.0,

                            children: vec![
                                Label {
                                    text: "  ".repeat(depth as usize),
                                    width: format!("{}px", depth * 16),
                                },

                                if !node.children.is_empty() {
                                    Button {
                                        label: "▼".to_string(),
                                        size: "small".to_string(),
                                    }
                                } else {
                                    Label { text: "  ".to_string(), width: "20px".to_string() }
                                },

                                Label {
                                    text: node.function.clone(),
                                    font_size: 11.0,
                                    font_weight: 600,
                                    width: "200px".to_string(),
                                },

                                Label {
                                    text: format!("{:.1}ms", node.time),
                                    font_size: 11.0,
                                    color: self.theme.colors.primary,
                                },

                                Label {
                                    text: format!("{:.1}%", node.time_percent),
                                    font_size: 11.0,
                                },

                                Label {
                                    text: format!("{} calls", node.calls),
                                    font_size: 11.0,
                                    color: self.theme.colors.foreground_secondary,
                                },
                            ],
                        },
                    ],
                },

                Column {
                    spacing: 0.0,

                    children: node.children.iter().map(|child| {
                        self.render_call_tree_node(child, depth + 1)
                    }).collect(),
                },
            ],
        }
    }

    fn render_hot_functions_view(&self) -> Vec<Widget> {
        vec![
            Column {
                spacing: 16.0,

                children: vec![
                    Label {
                        text: "Hot Functions (CPU Time)".to_string(),
                        font_size: 16.0,
                        font_weight: 700,
                        margin_bottom: 12.0,
                    },

                    Column {
                        spacing: 8.0,

                        children: self.hot_functions.iter().enumerate().map(|(idx, func)| {
                            Panel {
                                padding: 12.0,
                                background_color: self.theme.colors.surface,
                                border: true,

                                children: vec![
                                    Row {
                                        spacing: 16.0,

                                        children: vec![
                                            Label {
                                                text: format!("#{}", idx + 1),
                                                font_size: 14.0,
                                                font_weight: 700,
                                                color: self.theme.colors.primary,
                                                width: "40px".to_string(),
                                            },

                                            Column {
                                                spacing: 2.0,
                                                width: "1fr".to_string(),

                                                children: vec![
                                                    Label {
                                                        text: func.function_name.clone(),
                                                        font_size: 12.0,
                                                        font_weight: 600,
                                                    },
                                                    Label {
                                                        text: format!("{}:{}", func.file, func.line),
                                                        font_size: 10.0,
                                                        color: self.theme.colors.foreground_secondary,
                                                    },
                                                ],
                                            },

                                            Column {
                                                spacing: 2.0,
                                                alignment: "right".to_string(),

                                                children: vec![
                                                    Label {
                                                        text: format!("{:.1}ms", func.total_time),
                                                        font_size: 12.0,
                                                        font_weight: 700,
                                                        color: self.theme.colors.warning,
                                                    },
                                                    Label {
                                                        text: format!("{:.1}%", func.percent),
                                                        font_size: 11.0,
                                                        color: self.theme.colors.foreground_secondary,
                                                    },
                                                ],
                                            },

                                            Column {
                                                spacing: 2.0,
                                                alignment: "right".to_string(),

                                                children: vec![
                                                    Label {
                                                        text: format!("{} calls", func.call_count),
                                                        font_size: 11.0,
                                                    },
                                                    Label {
                                                        text: format!("{:.2}ms/call", func.total_time / func.call_count as f32),
                                                        font_size: 10.0,
                                                        color: self.theme.colors.foreground_secondary,
                                                    },
                                                ],
                                            },

                                            ProgressBar {
                                                value: (func.percent * 100.0) as i32,
                                                max: 100,
                                                width: "120px".to_string(),
                                                height: 4.0,
                                                color: self.theme.colors.warning,
                                            },
                                        ],
                                    },
                                ],
                            }
                        }).collect(),
                    },
                ],
            },
        ]
    }

    fn render_memory_view(&self) -> Vec<Widget> {
        vec![
            Column {
                spacing: 16.0,

                children: vec![
                    Label {
                        text: "Memory Profiling".to_string(),
                        font_size: 16.0,
                        font_weight: 700,
                        margin_bottom: 12.0,
                    },

                    Row {
                        spacing: 16.0,

                        children: vec![
                            self.render_stat_box("Total Allocated", "512.4 MB", self.theme.colors.primary),
                            self.render_stat_box("Peak Memory", "687.2 MB", self.theme.colors.warning),
                            self.render_stat_box("Allocations", "12,450", self.theme.colors.success),
                        ],
                    },

                    Label {
                        text: "Top Memory Allocations".to_string(),
                        font_size: 12.0,
                        font_weight: 700,
                        margin_top: 20.0,
                        margin_bottom: 12.0,
                    },

                    Column {
                        spacing: 8.0,

                        children: self.memory_allocations.iter().take(10).map(|alloc| {
                            Panel {
                                padding: 12.0,
                                background_color: self.theme.colors.surface,

                                children: vec![
                                    Row {
                                        spacing: 16.0,

                                        children: vec![
                                            Column {
                                                spacing: 2.0,
                                                width: "1fr".to_string(),

                                                children: vec![
                                                    Label {
                                                        text: alloc.name.clone(),
                                                        font_size: 11.0,
                                                        font_weight: 600,
                                                    },
                                                    Label {
                                                        text: format!("{}:{}", alloc.file, alloc.line),
                                                        font_size: 10.0,
                                                        color: self.theme.colors.foreground_secondary,
                                                    },
                                                ],
                                            },

                                            Label {
                                                text: format!("{:.2} MB", alloc.size_mb),
                                                font_size: 12.0,
                                                font_weight: 700,
                                                color: self.theme.colors.warning,
                                            },

                                            Label {
                                                text: format!("{} allocations", alloc.count),
                                                font_size: 11.0,
                                                color: self.theme.colors.foreground_secondary,
                                            },
                                        ],
                                    },
                                ],
                            }
                        }).collect(),
                    },
                ],
            },
        ]
    }

    fn render_timeline_view(&self) -> Vec<Widget> {
        vec![
            Column {
                spacing: 16.0,

                children: vec![
                    Label {
                        text: "Performance Timeline".to_string(),
                        font_size: 16.0,
                        font_weight: 700,
                        margin_bottom: 12.0,
                    },

                    Panel {
                        height: "500px".to_string(),
                        background_color: self.theme.colors.surface,
                        border: true,
                        padding: 16.0,

                        children: vec![
                            Label {
                                text: "Timeline visualization would show resource usage over time".to_string(),
                                font_size: 12.0,
                                color: self.theme.colors.foreground_secondary,
                            },
                        ],
                    },
                ],
            },
        ]
    }

    fn render_view_button(&self, label: &str, view: ProfilerView) -> Widget {
        Button {
            label: label.to_string(),
            variant: if std::mem::discriminant(&self.current_view) == std::mem::discriminant(&view) {
                "primary"
            } else {
                "secondary"
            },
            width: "100%".to_string(),
            margin_bottom: 2.0,
            onClick: || {
                PROFILER_STATE.switch_view(view);
            },
        }
    }

    fn render_stat_box(&self, label: &str, value: &str, color: u32) -> Widget {
        Panel {
            width: "1fr".to_string(),
            padding: 16.0,
            background_color: self.theme.colors.surface,
            border: true,

            children: vec![
                Label {
                    text: label.to_string(),
                    font_size: 11.0,
                    color: self.theme.colors.foreground_secondary,
                    margin_bottom: 8.0,
                },

                Label {
                    text: value.to_string(),
                    font_size: 16.0,
                    font_weight: 700,
                    color,
                },
            ],
        }
    }

    fn get_sample_flame_graph() -> Vec<FlameGraphEntry> {
        vec![
            FlameGraphEntry {
                function: "main".to_string(),
                time: 2340.0,
                level: 0,
                offset: 0.0,
                color: 0xFF5733,
            },
        ]
    }

    fn get_sample_hot_functions() -> Vec<FunctionProfile> {
        vec![
            FunctionProfile {
                function_name: "process_data".to_string(),
                file: "data_processor.vera".to_string(),
                line: 145,
                total_time: 1560.0,
                call_count: 1200,
                percent: 66.7,
            },
            FunctionProfile {
                function_name: "render_ui".to_string(),
                file: "ui_renderer.vera".to_string(),
                line: 89,
                total_time: 780.0,
                call_count: 60,
                percent: 33.3,
            },
        ]
    }
}

// ============================================================================
// DATA STRUCTURES
// ============================================================================

#[derive(Clone, Copy, Debug, PartialEq)]
pub enum ProfilerView {
    FlameGraph,
    CallTree,
    HotFunctions,
    Memory,
    Timeline,
}

#[derive(Clone, Copy, Debug)]
pub enum ProfilingMode {
    CPU,
    Memory,
    IO,
    Allocations,
}

#[derive(Clone, Debug)]
pub struct ProfileSession {
    id: String,
    start_time: String,
    duration: f32,
    mode: ProfilingMode,
}

#[derive(Clone, Debug)]
pub struct CallTreeNode {
    function: String,
    time: f32,
    time_percent: f32,
    calls: u32,
    children: Vec<CallTreeNode>,
}

#[derive(Clone, Debug)]
pub struct FlameGraphEntry {
    function: String,
    time: f32,
    level: u32,
    offset: f32,
    color: u32,
}

#[derive(Clone, Debug)]
pub struct FunctionProfile {
    function_name: String,
    file: String,
    line: u32,
    total_time: f32,
    call_count: u32,
    percent: f32,
}

#[derive(Clone, Debug)]
pub struct MemoryAllocation {
    name: String,
    file: String,
    line: u32,
    size_mb: f32,
    count: u32,
}

pub static PROFILER_STATE: LazyStatic<Mutex<PerformanceProfiler>> =
    LazyStatic::new(|| {
        Mutex::new(PerformanceProfiler::new(AssetManager::global()))
    });
