    // ============================================================================
    // EXAMPLE 1: Calculator Application
    // ============================================================================

    pub struct CalculatorApp {
        framework: VeraUIFramework,
        display_value: String,
        accumulator: f32,
        operation: String,
        window: Window,
    }

    impl CalculatorApp {
        pub fn new() -> Self {
            let mut framework = VeraUIFramework::new("1.0");
            framework.set_theme(Theme::light());
            framework.set_viewport(320.0, 480.0);

            let mut window = Window::new("calc-main", "Calculator");
            window.base.width = 320.0;
            window.base.height = 480.0;
            window.closeable = true;
            window.resizable = false;

            Self {
                framework,
                display_value: "0".to_string(),
                accumulator: 0.0,
                operation: String::new(),
                window,
            }
        }

        pub fn build_ui(&mut self) {
            // Display (TextBox)
            let display = TextBox::new("calc-display", "")
                .with_input_type("number");

            let mut display_component = display;
            display_component.base.width = 300.0;
            display_component.base.height = 60.0;
            display_component.value = self.display_value.clone();
            display_component.read_only = true;

            // Number buttons (Grid 4x3)
            let buttons = vec![
                ("7", "btn-7"), ("8", "btn-8"), ("9", "btn-9"), ("÷", "btn-div"),
                ("4", "btn-4"), ("5", "btn-5"), ("6", "btn-6"), ("×", "btn-mul"),
                ("1", "btn-1"), ("2", "btn-2"), ("3", "btn-3"), ("−", "btn-sub"),
                ("0", "btn-0"), (".", "btn-dot"), ("=", "btn-eq"), ("+", "btn-add"),
            ];

            for (label, id) in buttons {
                let button = Button::new(id, label)
                    .with_size(60.0, 60.0);

                if label == "=" {
                    let btn_with_callback = button;
                    // In real implementation, set on_click callback
                } else if label == "÷" || label == "×" || label == "−" || label == "+" {
                    let btn_with_callback = button.with_variant("secondary");
                } else {
                    let _ = button;
                }
            }
        }

        pub fn handle_number_click(&mut self, number: &str) {
            if self.display_value == "0" {
                self.display_value = number.to_string();
            } else {
                self.display_value.push_str(number);
            }
        }

        pub fn handle_operation_click(&mut self, op: &str) {
            if let Ok(val) = self.display_value.parse::<f32>() {
                self.accumulator = val;
                self.operation = op.to_string();
                self.display_value = "0".to_string();
            }
        }

        pub fn handle_equals(&mut self) {
            if let Ok(current) = self.display_value.parse::<f32>() {
                let result = match self.operation.as_str() {
                    "+" => self.accumulator + current,
                    "-" => self.accumulator - current,
                    "×" => self.accumulator * current,
                    "÷" => self.accumulator / current,
                    _ => current,
                };
                self.display_value = result.to_string();
                self.operation.clear();
            }
        }
    }

    // ============================================================================
    // EXAMPLE 2: Settings Dialog
    // ============================================================================

    pub struct SettingsDialog {
        window: Window,
        theme_selector: Dropdown,
        font_size_slider: Slider,
        enable_notifications: Checkbox,
        language_radio: Vec<RadioButton>,
    }

    impl SettingsDialog {
        pub fn new() -> Self {
            let mut window = Window::new("settings-win", "Application Settings");
            window.base.width = 500.0;
            window.base.height = 600.0;
            window.modal = true;

            let mut theme_dropdown = Dropdown::new("dd-theme", "Select theme")
                .add_item("Light".to_string())
                .add_item("Dark".to_string())
                .add_item("High Contrast".to_string());
            theme_dropdown.base.width = 450.0;
            theme_dropdown.base.height = 32.0;

            let mut font_slider = Slider::new("slider-font", 10.0, 24.0);
            font_slider.base.width = 450.0;
            font_slider.value = 14.0;

            let notifications_check = Checkbox::new("chk-notify", "Enable notifications")
                .with_size(450.0, 24.0);

            let mut radios = vec![];
            for (idx, lang) in &[("English", "en"), ("Spanish", "es"), ("French", "fr")] {
                let radio = RadioButton::new(
                    &format!("radio-lang-{}", lang),
                    idx,
                    "language",
                    lang,
                );
                radios.push(radio);
            }

            Self {
                window,
                theme_selector: theme_dropdown,
                font_size_slider: font_slider,
                enable_notifications: notifications_check,
                language_radio: radios,
            }
        }

        pub fn render(&self) -> String {
            format!(
                "<div id=\"{}\" class=\"dialog settings-dialog\"></div>",
                self.window.base.id
            )
        }
    }

    // ============================================================================
    // EXAMPLE 3: File Browser Window
    // ============================================================================

    pub struct FileBrowser {
        window: Window,
        toolbar: ToolBar,
        path_display: TextBox,
        file_list: ListBox,
        status_bar: StatusBar,
    }

    impl FileBrowser {
        pub fn new() -> Self {
            let mut window = Window::new("filebrowser-win", "File Manager");
            window.base.width = 800.0;
            window.base.height = 600.0;

            let mut toolbar = ToolBar::new("fb-toolbar");
            toolbar.base.width = 800.0;
            toolbar.base.height = 48.0;
            toolbar.add_item(ToolBarItem {
                id: "tb-back".to_string(),
                icon: "arrow-left".to_string(),
                label: Some("Back".to_string()),
                tooltip: Some("Go back".to_string()),
                action: Some("navigate:back".to_string()),
            });
            toolbar.add_item(ToolBarItem {
                id: "tb-forward".to_string(),
                icon: "arrow-right".to_string(),
                label: Some("Forward".to_string()),
                tooltip: Some("Go forward".to_string()),
                action: Some("navigate:forward".to_string()),
            });
            toolbar.add_item(ToolBarItem {
                id: "tb-refresh".to_string(),
                icon: "refresh".to_string(),
                label: Some("Refresh".to_string()),
                tooltip: Some("Refresh (F5)".to_string()),
                action: Some("view:refresh".to_string()),
            });

            let path_box = TextBox::new("fb-path", "/home/user")
                .with_input_type("text");

            let mut file_list = ListBox::new("fb-files");
            file_list.base.width = 780.0;
            file_list.base.height = 450.0;
            file_list.multiple = true;

            let mut status = StatusBar::new("fb-status");
            status.base.width = 800.0;
            status.base.height = 24.0;
            status.add_section(StatusBarSection {
                id: "status-files".to_string(),
                content: "0 items".to_string(),
                width: "1fr".to_string(),
            });
            status.add_section(StatusBarSection {
                id: "status-size".to_string(),
                content: "0 MB".to_string(),
                width: "150px".to_string(),
            });

            Self {
                window,
                toolbar,
                path_display: path_box,
                file_list,
                status_bar: status,
            }
        }

        pub fn load_directory(&mut self, path: &str) {
            self.path_display.value = path.to_string();
            // In real implementation, load files from path
            self.file_list.items = vec![
                "Documents".to_string(),
                "Downloads".to_string(),
                "Pictures".to_string(),
                "Videos".to_string(),
            ];
        }
    }

    // ============================================================================
    // EXAMPLE 4: Media Player Interface
    // ============================================================================

    pub struct MediaPlayer {
        window: Window,
        title_label: Label,
        playlist: ListBox,
        controls: Panel,
        play_button: Button,
        pause_button: Button,
        progress: ProgressBar,
        volume_slider: Slider,
        time_label: Label,
    }

    impl MediaPlayer {
        pub fn new() -> Self {
            let mut window = Window::new("media-win", "Media Player");
            window.base.width = 500.0;
            window.base.height = 700.0;
            window.resizable = true;

            let title = Label::new("mp-title", "Currently Playing: Song.mp3")
                .with_size(480.0, 40.0);

            let mut playlist = ListBox::new("mp-playlist");
            playlist.base.width = 480.0;
            playlist.base.height = 300.0;
            playlist.multiple = false;
            playlist.items = vec![
                "Song 1.mp3".to_string(),
                "Song 2.mp3".to_string(),
                "Song 3.mp3".to_string(),
            ];

            let controls_panel = Panel::new("mp-controls")
                .with_size(480.0, 100.0)
                .with_background("#F2F2F7");

            let play_btn = Button::new("mp-play", "▶ Play");
            let pause_btn = Button::new("mp-pause", "⏸ Pause");

            let mut progress_bar = ProgressBar::new("mp-progress");
            progress_bar.base.width = 480.0;
            progress_bar.base.height = 4.0;
            progress_bar.value = 35.0;

            let mut volume = Slider::new("mp-volume", 0.0, 100.0);
            volume.base.width = 200.0;
            volume.value = 70.0;

            let time_display = Label::new("mp-time", "1:23 / 3:45")
                .with_size(100.0, 24.0);

            Self {
                window,
                title_label: title,
                playlist,
                controls: controls_panel,
                play_button: play_btn,
                pause_button: pause_btn,
                progress: progress_bar,
                volume_slider: volume,
                time_label: time_display,
            }
        }

        pub fn play(&mut self) {
            println!("Playing...");
        }

        pub fn pause(&mut self) {
            println!("Paused");
        }

        pub fn set_volume(&mut self, level: f32) {
            println!("Volume: {}%", level);
        }

        pub fn seek(&mut self, position: f32) {
            println!("Seeking to: {}%", position);
        }
    }

