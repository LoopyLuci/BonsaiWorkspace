    // ============================================================================
    // EXAMPLE 6: Form Validation
    // ============================================================================

    pub struct RegistrationForm {
        window: Window,
        username_field: TextBox,
        email_field: TextBox,
        password_field: TextBox,
        confirm_password_field: TextBox,
        accept_terms: Checkbox,
        submit_button: Button,
        error_messages: Vec<String>,
    }

    impl RegistrationForm {
        pub fn new() -> Self {
            let mut window = Window::new("form-register", "Register");
            window.base.width = 400.0;
            window.base.height = 500.0;
            window.modal = true;

            let username = TextBox::new("form-username", "Username")
                .with_input_type("text");

            let email = TextBox::new("form-email", "Email address")
                .with_input_type("email");

            let password = TextBox::new("form-password", "Password")
                .with_input_type("password");

            let confirm = TextBox::new("form-confirm", "Confirm Password")
                .with_input_type("password");

            let terms = Checkbox::new("form-terms", "I accept the terms and conditions")
                .with_size(380.0, 24.0);

            let submit = Button::new("form-submit", "Register")
                .with_variant("primary")
                .with_size(380.0, 40.0);

            Self {
                window,
                username_field: username,
                email_field: email,
                password_field: password,
                confirm_password_field: confirm,
                accept_terms: terms,
                submit_button: submit,
                error_messages: Vec::new(),
            }
        }

        pub fn validate(&mut self) -> bool {
            self.error_messages.clear();

            // Validate username
            if self.username_field.value.len() < 3 {
                self.error_messages.push("Username must be at least 3 characters".to_string());
            }

            // Validate email
            if !self.email_field.value.contains('@') {
                self.error_messages.push("Invalid email address".to_string());
            }

            // Validate password
            if self.password_field.value.len() < 8 {
                self.error_messages.push("Password must be at least 8 characters".to_string());
            }

            // Validate password match
            if self.password_field.value != self.confirm_password_field.value {
                self.error_messages.push("Passwords do not match".to_string());
            }

            // Validate terms acceptance
            if !self.accept_terms.checked {
                self.error_messages.push("You must accept the terms".to_string());
            }

            self.error_messages.is_empty()
        }

        pub fn submit(&mut self) {
            if self.validate() {
                println!("Form submitted successfully!");
                // Process registration
            } else {
                println!("Form validation failed:");
                for error in &self.error_messages {
                    println!("  - {}", error);
                }
            }
        }
    }

    // ============================================================================
    // EXAMPLE 7: Custom Theme Application
    // ============================================================================

    pub struct ThemedApplication {
        framework: VeraUIFramework,
        custom_theme: Theme,
        window: Window,
        color_palette_display: Vec<Panel>,
    }

    impl ThemedApplication {
        pub fn new() -> Self {
            let mut framework = VeraUIFramework::new("1.0");

            // Create custom theme
            let mut custom_theme = Theme::light();
            custom_theme.name = "Ocean".to_string();
            custom_theme.colors.primary = "#0077B6".to_string();
            custom_theme.colors.secondary = "#00B4D8".to_string();
            custom_theme.colors.accent = "#90E0EF".to_string();
            custom_theme.colors.background = "#E0F7FA".to_string();
            custom_theme.colors.surface = "#B3E5FC".to_string();

            framework.set_theme(custom_theme.clone());

            let mut window = Window::new("themed-app", "Themed Application");
            window.base.width = 600.0;
            window.base.height = 500.0;

            Self {
                framework,
                custom_theme,
                window,
                color_palette_display: Vec::new(),
            }
        }

        pub fn build_color_palette_display(&mut self) {
            let colors = vec![
                ("Primary", &self.custom_theme.colors.primary),
                ("Secondary", &self.custom_theme.colors.secondary),
                ("Accent", &self.custom_theme.colors.accent),
                ("Success", &self.custom_theme.colors.success),
                ("Warning", &self.custom_theme.colors.warning),
                ("Error", &self.custom_theme.colors.error),
            ];

            for (label, color) in colors {
                let panel = Panel::new(&format!("color-{}", label))
                    .with_size(100.0, 100.0)
                    .with_background(color);

                self.color_palette_display.push(panel);
            }
        }
    }

    // ============================================================================
    // EXAMPLE 8: Responsive Layout Example
    // ============================================================================

    pub struct ResponsiveApp {
        framework: VeraUIFramework,
        window: Window,
        breakpoints: Vec<(i32, String)>,
        current_layout: String,
    }

    impl ResponsiveApp {
        pub fn new() -> Self {
            let mut framework = VeraUIFramework::new("1.0");

            let mut window = Window::new("responsive-app", "Responsive Layout");
            window.base.width = 1200.0;
            window.base.height = 800.0;
            window.resizable = true;

            let breakpoints = vec![
                (480, "mobile".to_string()),
                (768, "tablet".to_string()),
                (1024, "desktop".to_string()),
                (1440, "wide".to_string()),
            ];

            Self {
                framework,
                window,
                breakpoints,
                current_layout: "desktop".to_string(),
            }
        }

        pub fn on_window_resize(&mut self, width: i32, _height: i32) {
            self.current_layout = self.get_layout_for_width(width);
            println!("Layout changed to: {}", self.current_layout);
            self.apply_layout(&self.current_layout);
        }

        fn get_layout_for_width(&self, width: i32) -> String {
            for (breakpoint, layout) in &self.breakpoints {
                if width <= *breakpoint {
                    return layout.clone();
                }
            }
            "wide".to_string()
        }

        fn apply_layout(&mut self, layout: &str) {
            match layout {
                "mobile" => {
                    self.window.base.width = 375.0;
                    // Single column layout
                }
                "tablet" => {
                    self.window.base.width = 768.0;
                    // Two column layout
                }
                "desktop" => {
                    self.window.base.width = 1024.0;
                    // Three column layout
                }
                "wide" => {
                    self.window.base.width = 1440.0;
                    // Full layout
                }
                _ => {}
            }
        }
    }

    // ============================================================================
    // EXAMPLE 9: Animation Showcase
    // ============================================================================

    pub struct AnimationShowcase {
        framework: VeraUIFramework,
        animations: Vec<Animation>,
        animating_panel: Panel,
    }

    impl AnimationShowcase {
        pub fn new() -> Self {
            let framework = VeraUIFramework::new("1.0");

            // Create fade-in animation
            let mut fade_in = Animation::new("fade-in", 500);
            fade_in.easing = "ease-out".to_string();
            let mut kf0 = HashMap::new();
            kf0.insert("opacity".to_string(), 0.0);
            fade_in.add_keyframe(0.0, kf0);
            let mut kf100 = HashMap::new();
            kf100.insert("opacity".to_string(), 1.0);
            fade_in.add_keyframe(100.0, kf100);

            // Create slide-in animation
            let mut slide_in = Animation::new("slide-in", 300);
            slide_in.easing = "ease-in-out".to_string();
            let mut kf0 = HashMap::new();
            kf0.insert("transform".to_string(), -50.0);
            slide_in.add_keyframe(0.0, kf0);
            let mut kf100 = HashMap::new();
            kf100.insert("transform".to_string(), 0.0);
            slide_in.add_keyframe(100.0, kf100);

            // Create bounce animation
            let mut bounce = Animation::new("bounce", 600);
            bounce.easing = "ease-in-out".to_string();
            bounce.iteration_count = -1; // Infinite
            let mut kf0 = HashMap::new();
            kf0.insert("transform".to_string(), 0.0);
            bounce.add_keyframe(0.0, kf0);
            let mut kf50 = HashMap::new();
            kf50.insert("transform".to_string(), 10.0);
            bounce.add_keyframe(50.0, kf50);
            let mut kf100 = HashMap::new();
            kf100.insert("transform".to_string(), 0.0);
            bounce.add_keyframe(100.0, kf100);

            let mut panel = Panel::new("anim-panel");
            panel.base.width = 200.0;
            panel.base.height = 200.0;
            panel.base.animations.push(fade_in);
            panel.base.animations.push(slide_in);
            panel.base.animations.push(bounce);

            Self {
                framework,
                animations: vec![],
                animating_panel: panel,
            }
        }

        pub fn start_animations(&mut self) {
            for animation in &mut self.animating_panel.base.animations {
                animation.auto_play = true;
            }
        }

        pub fn stop_animations(&mut self) {
            for animation in &mut self.animating_panel.base.animations {
                animation.auto_play = false;
            }
        }
    }

    // ============================================================================
    // EXAMPLE 10: Accessibility Features Demo
    // ============================================================================

    pub struct AccessibilityDemo {
        framework: VeraUIFramework,
        accessibility_context: AccessibilityContext,
        theme_switcher: Dropdown,
        font_size_slider: Slider,
        high_contrast_checkbox: Checkbox,
        reduced_motion_checkbox: Checkbox,
    }

    impl AccessibilityDemo {
        pub fn new() -> Self {
            let mut framework = VeraUIFramework::new("1.0");

            let mut accessibility = AccessibilityContext::new();
            accessibility.apply_wcag_aaa_compliance();

            framework.enable_accessibility(true);

            let mut theme_dd = Dropdown::new("acc-theme", "Select theme")
                .add_item("Light".to_string())
                .add_item("Dark".to_string())
                .add_item("High Contrast".to_string());
            theme_dd.base.width = 300.0;

            let mut font_slider = Slider::new("acc-font", 0.8, 2.0);
            font_slider.base.width = 300.0;
            font_slider.value = 1.0;

            let hc_check = Checkbox::new("acc-hc", "Enable High Contrast")
                .with_size(300.0, 24.0);

            let rm_check = Checkbox::new("acc-rm", "Reduce Motion")
                .with_size(300.0, 24.0);

            Self {
                framework,
                accessibility_context: accessibility,
                theme_switcher: theme_dd,
                font_size_slider: font_slider,
                high_contrast_checkbox: hc_check,
                reduced_motion_checkbox: rm_check,
            }
        }

        pub fn apply_font_size(&mut self, multiplier: f32) {
            self.accessibility_context.font_size_multiplier = multiplier;
            self.framework.set_dpi_scale(multiplier);
        }

        pub fn apply_high_contrast(&mut self, enabled: bool) {
            self.accessibility_context.high_contrast_enabled = enabled;
            if enabled {
                self.framework.set_theme(Theme::high_contrast());
            }
        }

        pub fn apply_reduced_motion(&mut self, enabled: bool) {
            self.accessibility_context.reduced_motion_enabled = enabled;
            // Disable animations if reduced motion is enabled
        }
    }

    // ============================================================================
    // EXAMPLE 11: Event Handling Demo
    // ============================================================================

    pub struct EventHandlingDemo {
        framework: VeraUIFramework,
        button: Button,
        textbox: TextBox,
        slider: Slider,
        event_log: Vec<String>,
    }

    impl EventHandlingDemo {
        pub fn new() -> Self {
            let framework = VeraUIFramework::new("1.0");

            let mut button = Button::new("demo-btn", "Click Me");
            button.on_click = Some(Box::new(|| {
                println!("Button clicked!");
            }));

            let mut textbox = TextBox::new("demo-txt", "Type here");
            textbox.on_change = Some(Box::new(|value| {
                println!("TextBox changed: {}", value);
            }));

            let mut slider = Slider::new("demo-slider", 0.0, 100.0);
            slider.on_change = Some(Box::new(|value| {
                println!("Slider value: {}", value);
            }));

            Self {
                framework,
                button,
                textbox,
                slider,
                event_log: Vec::new(),
            }
        }

        pub fn log_event(&mut self, event: &UIEvent) {
            let log_entry = format!(
                "[{:?}] Target: {} at ({}, {})",
                event.event_type, event.target_id, event.x, event.y
            );
            self.event_log.push(log_entry);
        }

        pub fn get_event_log(&self) -> &Vec<String> {
            &self.event_log
        }

        pub fn clear_event_log(&mut self) {
            self.event_log.clear();
        }
    }

    // ============================================================================
    // DEMO LAUNCHER
    // ============================================================================

    pub fn run_all_examples() {
        println!("=".repeat(60));
        println!("VERA UI Framework - Examples");
        println!("=".repeat(60));

        println!("\n1. Calculator Application");
        let mut calc = CalculatorApp::new();
        calc.build_ui();
        calc.handle_number_click("5");
        calc.handle_operation_click("+");
        calc.handle_number_click("3");
        calc.handle_equals();
        println!("   Result: {}", calc.display_value);

        println!("\n2. Settings Dialog");
        let settings = SettingsDialog::new();
        println!("   Theme selector: {} items", settings.theme_selector.items.len());

        println!("\n3. File Browser");
        let mut browser = FileBrowser::new();
        browser.load_directory("/home/user/Documents");
        println!("   Files: {:?}", browser.file_list.items);

        println!("\n4. Media Player");
        let mut player = MediaPlayer::new();
        player.play();
        player.set_volume(75.0);
        println!("   Playlist: {} songs", player.playlist.items.len());

        println!("\n5. Data Dashboard");
        let dashboard = DataDashboard::new();
        println!("   Tabs: {} active", dashboard.tabs.tabs.len());

        println!("\n6. Registration Form");
        let mut form = RegistrationForm::new();
        form.username_field.value = "john_doe".to_string();
        form.email_field.value = "john@example.com".to_string();
        form.password_field.value = "secure123".to_string();
        form.confirm_password_field.value = "secure123".to_string();
        form.accept_terms.checked = true;
        form.submit();

        println!("\n7. Custom Theme");
        let mut themed = ThemedApplication::new();
        themed.build_color_palette_display();
        println!("   Colors: {} displayed", themed.color_palette_display.len());

        println!("\n8. Responsive Layout");
        let mut responsive = ResponsiveApp::new();
        responsive.on_window_resize(480, 800);
        responsive.on_window_resize(1024, 800);

        println!("\n9. Animation Showcase");
        let mut animations = AnimationShowcase::new();
        animations.start_animations();
        println!("   Animations: {} loaded", animations.animating_panel.base.animations.len());

        println!("\n10. Accessibility Features");
        let mut accessibility = AccessibilityDemo::new();
        accessibility.apply_font_size(1.5);
        accessibility.apply_high_contrast(true);
        println!("   Accessibility: WCAG AAA compliant");

        println!("\n11. Event Handling");
        let mut events = EventHandlingDemo::new();
        let test_event = UIEvent {
            event_type: EventType::MouseClick,
            target_id: "demo-btn".to_string(),
            timestamp: 0,
            x: 100,
            y: 100,
            key_code: None,
            data: HashMap::new(),
        };
        events.log_event(&test_event);
        println!("   Events logged: {}", events.get_event_log().len());

        println!("\n{}", "=".repeat(60));
        println!("All examples completed successfully!");
        println!("=".repeat(60));
    }
}

pub use vera_ui_examples::*;
