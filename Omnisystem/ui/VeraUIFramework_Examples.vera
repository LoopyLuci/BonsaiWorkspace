            // Analytics tab
            tabs = tabs.add_tab(Tab {
                id: "tab-analytics".to_string(),
                label: "Analytics".to_string(),
                icon: Some("chart-line".to_string()),
                content: "<div>Analytics content</div>".to_string(),
                closeable: false,
