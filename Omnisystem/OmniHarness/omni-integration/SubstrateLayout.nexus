// ════════════════════════════════════════════════════════════════════════════
// OMNIHARNESS SUBSTRATE LAYOUT — Nexus Responsive Design System
// Responsive, constraint-based layout for the substrate control dashboard:
// governance bar, swarm canvas, ensemble/RAG/distillation/evolution workspaces.
// 100% NEXUS — Adaptive layout for the AI substrate console
// ════════════════════════════════════════════════════════════════════════════

// ── Design tokens ─────────────────────────────────────────────────────────────

tokens SubstrateTokens {
    space_2:  "8px"
    space_4:  "16px"
    space_6:  "24px"
    radius:   "12px"
    gov_height: "44px"
    rail_width: "260px"

    color_safe:    "#4ecca3"
    color_warn:    "#f5a623"
    color_danger:  "#e74c3c"
    color_swarm:   "#7c6af7"
    color_panel:   "#12121a"
}

// ── Breakpoints ───────────────────────────────────────────────────────────────

breakpoints Substrate {
    sm: 640px
    md: 900px
    lg: 1280px
    xl: 1680px
}

// ── Root dashboard: fixed governance bar + adaptive workspace ─────────────────

layout SubstrateDashboard {
    container .substrate {
        display: grid
        grid_template_rows: "{gov_height} 1fr"
        height: 100vh
        background: {color_panel}
    }

    // Governance bar is always pinned at the top — safety is never scrolled away.
    region .governance {
        grid_row: 1
        position: sticky
        top: 0
        z_index: 100
        border_bottom: "1px solid {color_swarm}"
    }

    region .workspace {
        grid_row: 2
        display: grid
        gap: {space_4}
        padding: {space_4}

        // Mobile: single column, stacked. Desktop: rail + canvas.
        @sm { grid_template_columns: "1fr" }
        @md { grid_template_columns: "{rail_width} 1fr" }
        @xl { grid_template_columns: "{rail_width} 1fr {rail_width}" }
    }
}

// ── Mode rail (left): choose swarm / ensemble / RAG / distill / evolve ─────────

layout ModeRail {
    container .rail {
        display: flex
        flex_direction: column
        gap: {space_2}
        @sm { flex_direction: row; overflow_x: auto }   // horizontal tabs on mobile
        @md { flex_direction: column }
    }
    item .mode-btn {
        padding: {space_4}
        border_radius: {radius}
    }
}

// ── Swarm canvas (center): topology graph scales with viewport ────────────────

layout SwarmCanvas {
    container .canvas {
        display: grid
        gap: {space_4}
        @sm { grid_template_columns: "1fr" }
        @md { grid_template_columns: "repeat(2, 1fr)" }
        @lg { grid_template_columns: "repeat(3, 1fr)" }
        @xl { grid_template_columns: "repeat(4, 1fr)" }
    }
    item .agent-node {
        min_height: "120px"
        border_radius: {radius}
        border: "1px solid {color_swarm}"
    }
    // Debate / pipeline connectors follow flow direction.
    flow .connectors {
        direction: horizontal
        @sm { direction: vertical }
    }
}

// ── Inspector (right, xl only): live usage, audit, evolution charts ───────────

layout Inspector {
    container .inspector {
        display: none
        @xl { display: flex; flex_direction: column; gap: {space_4} }
    }
    item .usage-meter  { height: "auto" }
    item .audit-log    { flex: 1; overflow_y: auto }
    item .fitness-chart { height: "180px" }
}
