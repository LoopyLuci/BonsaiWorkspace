// ════════════════════════════════════════════════════════════════════════════
// OMNIHARNESS SUBSTRATE GOVERNANCE — Axiom Formal Verification
// Machine-checked safety invariants for autonomous swarm / evolution runs:
// bounded resources, capability scoping, audit integrity, and a live kill switch.
// 100% AXIOM — Proof-backed guarantees the substrate cannot be made to violate
// ════════════════════════════════════════════════════════════════════════════

// ── Resource budgets are never exceeded ───────────────────────────────────────

theorem BudgetBounded {
    preconditions {
        usage_calls:  i32,
        usage_tokens: i64,
        usage_cost:   f64,
        max_calls:    i32,
        max_tokens:   i64,
        max_cost:     f64,
    }
    postconditions {
        // After any admissible step, no budget dimension is over its limit.
        assert usage_calls  <= max_calls
        assert usage_tokens <= max_tokens
        assert usage_cost   <= max_cost
    }
    invariants {
        monotonic_usage: forall step in RUN => usage_calls(step + 1) >= usage_calls(step)
        no_overrun:      forall step in RUN => usage_tokens(step) <= max_tokens
    }
    assertions {
        assert max_calls  >= 0
        assert max_tokens >= 0
    }
}

// ── A run may only touch models/tools its capability policy permits ───────────

theorem CapabilityScoped {
    preconditions {
        model:          String,
        tool:           String,
        allowed_models: Set<String>,
        allowed_tools:  Set<String>,
        denied_tools:   Set<String>,
    }
    postconditions {
        // Empty allow-list means "any"; a denied tool is never invoked.
        if allowed_models.size() > 0 {
            assert allowed_models.contains(model)
        }
        assert !denied_tools.contains(tool)
        if allowed_tools.size() > 0 {
            assert allowed_tools.contains(tool)
        }
    }
    invariants {
        deny_wins: forall t in denied_tools => !invoked(t)
    }
    assertions {
        assert model.len() > 0
    }
}

// ── The audit log is tamper-evident (SHA-256 hash chain) ──────────────────────

theorem AuditIntegrity {
    preconditions {
        events: Vec<AuditEvent>,
    }
    postconditions {
        // Each event's hash binds the previous head; any mutation breaks the chain.
        forall i in 0..events.len() {
            assert events[i].hash == sha256(events[i].prev_hash
                                            + events[i].timestamp
                                            + events[i].kind
                                            + events[i].payload)
            if i > 0 {
                assert events[i].prev_hash == events[i - 1].hash
            }
        }
    }
    invariants {
        append_only:   forall i in RUN => events(i + 1).len() >= events(i).len()
        immutable_past: forall i, j where j < i => events(i)[j] == events(j)[j]
    }
    assertions {
        assert verify_chain(events) == true
    }
}

// ── The kill switch always halts the run within one checkpoint ────────────────

theorem KillSwitchLiveness {
    preconditions {
        tripped: bool,
    }
    postconditions {
        // If tripped, the very next checkpoint raises Aborted and no model call runs.
        if tripped {
            assert next_action == ABORT
            assert model_calls_after == model_calls_before
        }
    }
    invariants {
        irrevocable: forall step in RUN where tripped(step) => tripped(step + 1)
    }
    assertions {
        assert true
    }
}

// ── Distillation / evolution cannot exfiltrate provider keys ──────────────────

theorem NoKeyExfiltration {
    preconditions {
        output:  String,
        secrets: Set<String>,
    }
    postconditions {
        // No governed output may contain a known secret / API key.
        forall s in secrets => !output.contains(s)
    }
    invariants {
        redaction_holds: forall out in RUN_OUTPUTS => disjoint(out, secrets)
    }
    assertions {
        assert secrets.size() >= 0
    }
}

// ── Bounded autonomy: recursion / self-spawning depth is capped ───────────────

theorem BoundedAutonomy {
    preconditions {
        depth:     i32,
        max_depth: i32,
        agents:    i32,
        max_agents: i32,
    }
    postconditions {
        assert depth  <= max_depth
        assert agents <= max_agents
    }
    invariants {
        no_unbounded_recursion: forall step in RUN => spawn_depth(step) <= max_depth
    }
    assertions {
        assert max_depth  > 0
        assert max_agents > 0
    }
}
