// ════════════════════════════════════════════════════════════════════════════
// OMNIHARNESS SUBSTRATE PANEL — Vera Component System
// User control surface for the substrate: swarm designer, ensemble console,
// RAG library, distillation studio, evolution monitor, and the governance panel.
// 100% VERA — Enterprise UI for safe, controllable autonomous AI
// ════════════════════════════════════════════════════════════════════════════

use omnisystem::{Vec, HashMap, Option, Result, String, i32, f32, bool}

// ── Governance panel — the always-visible safety & control bar ────────────────

component GovernancePanel {
    props {
        max_model_calls: i32,
        max_tokens:      i32,
        max_cost_usd:    f32,
        max_parallel:    i32,
    }
    state {
        calls_used:  i32 = 0,
        tokens_used: i32 = 0,
        cost_used:   f32 = 0.0,
        running:     bool = false,
    }
    render {
        <div class="gov-bar">
            <Meter label="Model calls" value={self.calls_used}  max={self.max_model_calls}/>
            <Meter label="Tokens"      value={self.tokens_used} max={self.max_tokens}/>
            <Meter label="Cost ($)"    value={self.cost_used}   max={self.max_cost_usd}/>
            <span class="parallel">parallel ≤ {self.max_parallel}</span>
            <button class="kill" disabled={!self.running} on_click={self.emit("kill")}>Stop</button>
            <AuditBadge verified={true}/>
        </div>
    }
    on_kill() { self.running = false; self.emit("kill_switch_tripped") }
}

// ── Swarm designer — arrange agents into a topology ───────────────────────────

component SwarmDesigner {
    props { agents: Vec<AgentCard> }
    state {
        topology: String = "orchestrator",   // pipeline | parallel | orchestrator | debate
        rounds:   i32 = 2,
    }
    render {
        <div class="swarm-designer">
            <TopologyPicker selected={self.topology} on_change={self.set_topology}/>
            <div class="agent-grid">
                { self.agents.map(|a| <AgentNode spec={a} role={a.role}/>) }
            </div>
            { if self.topology == "debate" {
                <NumberField label="Debate rounds" value={self.rounds} on_change={self.set_rounds}/>
            }}
            <button class="run" on_click={self.emit("run_swarm")}>Run Swarm</button>
        </div>
    }
    on_set_topology(t: String) { self.topology = t }
    on_set_rounds(n: i32)      { self.rounds = n }
}

// ── Ensemble console — pick N models, choose an aggregation strategy ──────────

component EnsembleConsole {
    props { available_models: Vec<String> }
    state {
        selected: Vec<String> = [],
        strategy: String = "judge",     // concat | vote | judge | moa
        judge:    String = "",
    }
    render {
        <div class="ensemble-console">
            <MultiSelect options={self.available_models} selected={self.selected}
                         hint="Select up to 20 models to blend"/>
            <StrategyTabs value={self.strategy} options=["concat", "vote", "judge", "moa"]
                          on_change={self.set_strategy}/>
            { if self.strategy == "judge" || self.strategy == "moa" {
                <ModelPicker label="Aggregator / judge" value={self.judge} options={self.available_models}/>
            }}
            <button on_click={self.emit("run_ensemble")}>Blend {self.selected.len()} models</button>
        </div>
    }
    on_set_strategy(s: String) { self.strategy = s }
}

// ── Distillation studio — train from a hybrid of teacher models ───────────────

component DistillationStudio {
    props { available_models: Vec<String> }
    state {
        teachers:   Vec<String> = [],
        judge:      String = "",
        base_model: String = "",
        backend:    String = "unsloth",   // unsloth | axolotl | llama.cpp | mlx
        prompts:    i32 = 0,
    }
    render {
        <div class="distill-studio">
            <MultiSelect label="Teacher models (hybrid)" options={self.available_models} selected={self.teachers}/>
            <ModelPicker label="Judge / merger" value={self.judge}/>
            <PromptSourcePicker on_loaded={self.set_prompts}/>
            <div class="train-target">
                <TextField label="Base student model" value={self.base_model}/>
                <Segmented label="Trainer" value={self.backend}
                           options=["unsloth", "axolotl", "llama.cpp", "mlx"]/>
            </div>
            <button on_click={self.emit("build_dataset")}>Distill {self.teachers.len()} teachers → dataset</button>
            <button on_click={self.emit("emit_config")}>Emit training config</button>
        </div>
    }
    on_set_prompts(n: i32) { self.prompts = n }
}

// ── Evolution monitor — watch fitness climb across generations ────────────────

component EvolutionMonitor {
    props { generations: Vec<GenerationStat> }
    render {
        <div class="evo-monitor">
            <FitnessChart series={self.generations.map(|g| g.best_fitness)}/>
            <table class="genome-table">
                { self.generations.map(|g|
                    <tr><td>{g.generation}</td><td>{g.best_id}</td><td>{g.best_fitness}</td></tr>
                )}
            </table>
        </div>
    }
}

// ── RAG library — ingested documents and retrieval preview ────────────────────

component RagLibrary {
    props { documents: Vec<DocEntry> }
    state { query: String = "" }
    render {
        <div class="rag-library">
            <DropZone hint="Drop files or a folder to ingest" on_drop={self.emit("ingest")}/>
            <SearchField value={self.query} placeholder="Test a retrieval query…"
                         on_submit={self.emit("retrieve")}/>
            <ul class="doc-list">
                { self.documents.map(|d| <li>{d.name} — {d.chunks} chunks</li>) }
            </ul>
        </div>
    }
}
