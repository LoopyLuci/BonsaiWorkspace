// ════════════════════════════════════════════════════════════════════════════
// OMNIHARNESS LAYOUT — Nexus Responsive Design System
// Breakpoint-driven responsive layout for the OmniHarness AI interface
// 100% NEXUS — Constraint-based responsive layout engine
// ════════════════════════════════════════════════════════════════════════════

// ── Design tokens ─────────────────────────────────────────────────────────────

tokens HarnessTokens {
    // Spacing scale (4px base)
    space_1:  "4px"
    space_2:  "8px"
    space_3:  "12px"
    space_4:  "16px"
    space_5:  "20px"
    space_6:  "24px"
    space_8:  "32px"
    space_10: "40px"
    space_12: "48px"

    // Typography
    font_sans:  "'Inter', 'Segoe UI', system-ui, sans-serif"
    font_mono:  "'JetBrains Mono', 'Fira Code', 'Cascadia Code', monospace"
    text_xs:    "11px"
    text_sm:    "13px"
    text_base:  "15px"
    text_lg:    "18px"
    text_xl:    "22px"
    text_2xl:   "28px"
    leading_tight:  "1.25"
    leading_base:   "1.6"
    leading_loose:  "1.8"

    // Radius
    radius_sm:   "4px"
    radius_md:   "8px"
    radius_lg:   "12px"
    radius_xl:   "16px"
    radius_full: "9999px"

    // Shadows
    shadow_sm:  "0 1px 3px rgba(0,0,0,0.4)"
    shadow_md:  "0 4px 12px rgba(0,0,0,0.5)"
    shadow_lg:  "0 8px 24px rgba(0,0,0,0.6)"
    shadow_glow_accent: "0 0 20px rgba(124,106,247,0.3)"

    // Z-index layers
    z_base:    "1"
    z_dropdown: "100"
    z_modal:   "200"
    z_toast:   "300"
    z_tooltip: "400"

    // Animation
    duration_fast:   "100ms"
    duration_normal: "200ms"
    duration_slow:   "350ms"
    easing_default:  "cubic-bezier(0.4, 0, 0.2, 1)"
    easing_spring:   "cubic-bezier(0.34, 1.56, 0.64, 1)"
}

// ── Breakpoints ───────────────────────────────────────────────────────────────

breakpoints HarnessBreakpoints {
    compact:  "0px"      // single pane, mobile/tablet
    tablet:   "640px"    // 2 columns possible
    desktop:  "1024px"   // full 3-pane layout
    wide:     "1440px"   // extra sidebar space
    ultrawide: "1920px"  // expanded thought panel
}

// ── Root shell layout ─────────────────────────────────────────────────────────

layout HarnessShellLayout {
    display: flex
    direction: row
    height: 100vh
    overflow: hidden
    font-family: tokens.font_sans
    background: "#0a0a0f"

    // Compact: full screen single pane, sidebar overlays
    @compact {
        direction: column
    }

    // Desktop+: side-by-side
    @desktop {
        direction: row
    }
}

// ── Sidebar layout ────────────────────────────────────────────────────────────

layout SidebarLayout {
    flex: "0 0 auto"
    width: "280px"
    height: "100vh"
    display: flex
    direction: column
    overflow: hidden
    background: "#12121a"
    border-right: "1px solid #2a2a38"
    transition: "width {{ tokens.duration_normal }} {{ tokens.easing_default }}"

    @compact {
        position: "absolute"
        z-index: tokens.z_dropdown
        height: "100%"
        box-shadow: tokens.shadow_lg
        transform: "translateX(-100%)"
    }

    @tablet {
        width: "240px"
    }

    @desktop {
        width: "280px"
        position: "relative"
        transform: "none"
    }

    @wide {
        width: "320px"
    }

    // State: collapsed
    variant collapsed {
        @compact  { transform: "translateX(-100%)" }
        @desktop  { width: "0" }
    }

    // State: open
    variant open {
        @compact { transform: "translateX(0)" }
        @desktop { width: "280px" }
    }
}

layout SidebarHeader {
    flex: "0 0 auto"
    display: flex
    align-items: center
    justify-content: space-between
    padding: "{{ tokens.space_5 }} {{ tokens.space_5 }}"
    border-bottom: "1px solid #2a2a38"
    min-height: "64px"
}

layout SidebarContent {
    flex: "1 1 auto"
    overflow-y: auto
    padding: "{{ tokens.space_4 }}"
    display: flex
    direction: column
    gap: "{{ tokens.space_4 }}"
}

layout SidebarFooter {
    flex: "0 0 auto"
    padding: "{{ tokens.space_4 }}"
    border-top: "1px solid #2a2a38"
    font-size: tokens.text_xs
    color: "#666"
}

// ── Main area layout ──────────────────────────────────────────────────────────

layout MainAreaLayout {
    flex: "1 1 auto"
    display: flex
    direction: column
    overflow: hidden
    min-width: "0"

    @compact {
        width: "100%"
        height: "100%"
    }
}

layout TopbarLayout {
    flex: "0 0 auto"
    display: flex
    align-items: center
    gap: "{{ tokens.space_3 }}"
    padding: "0 {{ tokens.space_5 }}"
    height: "56px"
    background: "#12121a"
    border-bottom: "1px solid #2a2a38"

    @compact {
        height: "48px"
        padding: "0 {{ tokens.space_3 }}"
    }
}

layout ChatAreaLayout {
    flex: "1 1 auto"
    overflow-y: auto
    padding: "{{ tokens.space_6 }} {{ tokens.space_6 }}"
    display: flex
    direction: column
    gap: "{{ tokens.space_4 }}"
    scroll-behavior: smooth

    @compact {
        padding: "{{ tokens.space_4 }} {{ tokens.space_4 }}"
    }

    @ultrawide {
        padding: "{{ tokens.space_8 }}"
        max-width: "1200px"
        margin: "0 auto"
        width: "100%"
    }
}

layout InputAreaLayout {
    flex: "0 0 auto"
    padding: "{{ tokens.space_4 }} {{ tokens.space_6 }}"
    border-top: "1px solid #2a2a38"
    background: "#12121a"

    @compact {
        padding: "{{ tokens.space_3 }}"
    }
}

// ── Message bubble layouts ────────────────────────────────────────────────────

layout MessageRowLayout {
    display: flex
    max-width: "100%"
    gap: "{{ tokens.space_3 }}"

    variant user {
        flex-direction: "row-reverse"
        align-self: "flex-end"
        max-width: "72%"

        @compact { max-width: "90%" }
        @desktop { max-width: "65%" }
    }

    variant assistant {
        flex-direction: "row"
        align-self: "flex-start"
        max-width: "85%"

        @compact { max-width: "95%" }
        @ultrawide { max-width: "75%" }
    }

    variant tool {
        flex-direction: "row"
        align-self: "flex-start"
        max-width: "100%"
    }
}

layout MessageBubbleLayout {
    padding: "{{ tokens.space_4 }} {{ tokens.space_5 }}"
    border-radius: tokens.radius_lg
    font-size: tokens.text_base
    line-height: tokens.leading_base
    word-break: "break-word"
    box-shadow: tokens.shadow_sm

    variant user {
        background: "#1e2040"
        border-bottom-right-radius: tokens.radius_sm
    }

    variant assistant {
        background: "#1a2a1a"
        border-bottom-left-radius: tokens.radius_sm
    }
}

// ── Thought panel / step card layouts ────────────────────────────────────────

layout StepsContainerLayout {
    margin-top: "{{ tokens.space_3 }}"
    display: flex
    direction: column
    gap: "{{ tokens.space_2 }}"
}

layout StepCardLayout {
    border-radius: tokens.radius_md
    overflow: hidden
    border: "1px solid #2a2a38"
    transition: "border-color {{ tokens.duration_fast }}"

    variant success { border-color: "#4ecca3" }
    variant failed  { border-color: "#e74c3c" }
    variant running {
        border-color: "#7c6af7"
        box-shadow: tokens.shadow_glow_accent
    }
}

layout StepHeaderLayout {
    display: flex
    align-items: center
    gap: "{{ tokens.space_2 }}"
    padding: "{{ tokens.space_3 }} {{ tokens.space_4 }}"
    background: "#1a1a24"
    cursor: pointer

    hover {
        background: "#20202e"
    }
}

layout StepDetailLayout {
    padding: "{{ tokens.space_3 }} {{ tokens.space_4 }}"
    background: "#12121a"
    display: flex
    direction: column
    gap: "{{ tokens.space_3 }}"
    font-size: tokens.text_sm
    font-family: tokens.font_mono
}

// ── Model selector dropdown ───────────────────────────────────────────────────

layout ModelSelectorLayout {
    position: relative
}

layout ModelCurrentLayout {
    display: flex
    align-items: center
    gap: "{{ tokens.space_2 }}"
    padding: "{{ tokens.space_3 }} {{ tokens.space_4 }}"
    background: "#1a1a24"
    border: "1px solid #2a2a38"
    border-radius: tokens.radius_md
    cursor: pointer
    transition: "border-color {{ tokens.duration_fast }}"

    hover { border-color: "#7c6af7" }

    variant open {
        border-color: "#7c6af7"
        border-bottom-left-radius: "0"
        border-bottom-right-radius: "0"
    }
}

layout ModelDropdownLayout {
    position: absolute
    top: "calc(100% - 1px)"
    left: "0"
    right: "0"
    background: "#1a1a24"
    border: "1px solid #7c6af7"
    border-top: "none"
    border-radius: "0 0 {{ tokens.radius_md }} {{ tokens.radius_md }}"
    max-height: "320px"
    overflow-y: auto
    z-index: tokens.z_dropdown
    box-shadow: tokens.shadow_md
}

layout ModelOptionLayout {
    display: flex
    align-items: center
    justify-content: space-between
    padding: "{{ tokens.space_3 }} {{ tokens.space_4 }}"
    cursor: pointer
    transition: "background {{ tokens.duration_fast }}"
    border-bottom: "1px solid #1e1e2a"

    hover { background: "#22223a" }

    variant selected { background: "#1e1a40" }
}

// ── Tool panel layout ─────────────────────────────────────────────────────────

layout ToolPanelLayout {
    display: flex
    direction: column
    gap: "{{ tokens.space_2 }}"
    padding: "{{ tokens.space_2 }} 0"
}

layout ToolEntryLayout {
    display: flex
    align-items: center
    gap: "{{ tokens.space_3 }}"
    padding: "{{ tokens.space_3 }} {{ tokens.space_4 }}"
    background: "#1a1a24"
    border-radius: tokens.radius_md
    border: "1px solid #2a2a38"

    hover { border-color: "#3a3a50" }

    variant active {
        border-color: "#7c6af7"
        background: "#1a1a30"
    }
}

// ── Memory graph layout ───────────────────────────────────────────────────────

layout MemoryGraphLayout {
    width: "100%"
    height: "200px"
    position: relative
    background: "#0f0f18"
    border-radius: tokens.radius_md
    border: "1px solid #2a2a38"
    overflow: hidden

    @desktop { height: "260px" }
    @wide    { height: "320px" }
}

layout MemoryNodeLayout {
    position: absolute
    transform: "translate(-50%, -50%)"
    background: "#1e2040"
    border: "1px solid #7c6af7"
    border-radius: tokens.radius_full
    padding: "{{ tokens.space_2 }} {{ tokens.space_3 }}"
    font-size: tokens.text_xs
    color: "#e8e8f0"
    white-space: nowrap
    cursor: pointer
    box-shadow: "0 0 12px rgba(124,106,247,0.2)"
    transition: "box-shadow {{ tokens.duration_fast }}, transform {{ tokens.duration_fast }}"

    hover {
        box-shadow: "0 0 20px rgba(124,106,247,0.5)"
        transform: "translate(-50%, -50%) scale(1.1)"
    }

    variant hot {
        background: "#2a1a40"
        border-color: "#4ecca3"
        box-shadow: "0 0 12px rgba(78,204,163,0.3)"
    }
}

// ── Settings panel layout ─────────────────────────────────────────────────────

layout SettingsSectionLayout {
    display: flex
    direction: column
    gap: "{{ tokens.space_2 }}"
    margin-bottom: "{{ tokens.space_6 }}"
}

layout SettingsRowLayout {
    display: flex
    align-items: center
    justify-content: space-between
    padding: "{{ tokens.space_3 }} 0"
    border-bottom: "1px solid #1e1e2a"

    hover { background: "transparent" }
}

layout SettingsLabelLayout {
    display: flex
    direction: column
    gap: "{{ tokens.space_1 }}"
}

// ── Status bar layout ─────────────────────────────────────────────────────────

layout StatusBarLayout {
    flex: "0 0 auto"
    display: flex
    align-items: center
    gap: "{{ tokens.space_4 }}"
    padding: "0 {{ tokens.space_5 }}"
    height: "32px"
    background: "#0d0d15"
    border-top: "1px solid #2a2a38"
    font-size: tokens.text_xs
    color: "#666"

    @compact { display: none }
}

layout StatusItemLayout {
    display: flex
    align-items: center
    gap: "{{ tokens.space_2 }}"
}

// ── Toast / notification layout ───────────────────────────────────────────────

layout ToastContainerLayout {
    position: fixed
    bottom: "{{ tokens.space_6 }}"
    right: "{{ tokens.space_6 }}"
    z-index: tokens.z_toast
    display: flex
    direction: column
    gap: "{{ tokens.space_3 }}"
    pointer-events: none

    @compact {
        bottom: "{{ tokens.space_4 }}"
        right: "{{ tokens.space_4 }}"
        left: "{{ tokens.space_4 }}"
    }
}

layout ToastLayout {
    background: "#1a1a24"
    border: "1px solid #2a2a38"
    border-radius: tokens.radius_lg
    padding: "{{ tokens.space_4 }} {{ tokens.space_5 }}"
    box-shadow: tokens.shadow_lg
    pointer-events: auto
    animation: "toast-in {{ tokens.duration_slow }} {{ tokens.easing_spring }}"
    max-width: "380px"

    variant success { border-left: "4px solid #4ecca3" }
    variant error   { border-left: "4px solid #e74c3c" }
    variant warning { border-left: "4px solid #f5a623" }
    variant info    { border-left: "4px solid #7c6af7" }
}

// ── Loading states ────────────────────────────────────────────────────────────

layout LoadingIndicatorLayout {
    display: flex
    align-items: center
    gap: "{{ tokens.space_3 }}"
    padding: "{{ tokens.space_3 }} {{ tokens.space_6 }}"
    color: "#888899"
    font-size: tokens.text_sm
}

// ── Scrollbar styling (applied globally to scrollable containers) ──────────────

scrollbar HarnessScrollbar {
    width: "6px"
    track-background: "transparent"
    thumb-background: "#2a2a38"
    thumb-border-radius: tokens.radius_full

    hover {
        thumb-background: "#3a3a50"
    }
}

// ── Animation keyframes ───────────────────────────────────────────────────────

keyframes pulse {
    0%   { opacity: "1"; transform: "scale(1)" }
    50%  { opacity: "0.4"; transform: "scale(0.8)" }
    100% { opacity: "1"; transform: "scale(1)" }
}

keyframes toast-in {
    from { opacity: "0"; transform: "translateX(20px)" }
    to   { opacity: "1"; transform: "translateX(0)" }
}

keyframes spin {
    from { transform: "rotate(0deg)" }
    to   { transform: "rotate(360deg)" }
}

keyframes fade-in {
    from { opacity: "0" }
    to   { opacity: "1" }
}

keyframes slide-up {
    from { opacity: "0"; transform: "translateY(8px)" }
    to   { opacity: "1"; transform: "translateY(0)" }
}
