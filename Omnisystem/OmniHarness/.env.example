# OmniHarness — API Keys & Configuration
# Copy this file to .env and fill in the keys you want to use.
# You only need the keys for providers you want. Ollama needs no key.

# ── Anthropic (Claude) ──────────────────────────────────────────────────────
# Get key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ── OpenAI (GPT-4o, o1, o3) ────────────────────────────────────────────────
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Google (Gemini) ─────────────────────────────────────────────────────────
# Get key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# ── Groq (ultra-fast Llama / Mixtral) ───────────────────────────────────────
# Get key at: https://console.groq.com/keys
GROQ_API_KEY=

# ── Mistral ──────────────────────────────────────────────────────────────────
# Get key at: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# ── Cohere (Command R+) ──────────────────────────────────────────────────────
# Get key at: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# ── OpenRouter (100+ models via one key) ─────────────────────────────────────
# Get key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── Together AI (open-weight models) ─────────────────────────────────────────
# Get key at: https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=

# ── Fireworks AI (fast open-weight inference) ────────────────────────────────
# Get key at: https://fireworks.ai/account/api-keys
FIREWORKS_API_KEY=

# ── Ollama (local models — no key required) ──────────────────────────────────
# Set to "1" to enable. Make sure Ollama is running: https://ollama.com
OLLAMA_ENABLED=1
OLLAMA_BASE_URL=http://localhost:11434

# ── Local OpenAI-compatible server (llama.cpp / LM Studio / Jan / vLLM) ───────
# Serve a GGUF on an OpenAI-compatible port and point OmniHarness at it, e.g.:
#   llama-server -m D:\Models\general\gemma-4-31B-it-UD-Q2_K_XL\gemma-4-31B-it-UD-Q2_K_XL.gguf --port 8081
# Then use models as `local/<model-name>`. Models are auto-discovered from /v1/models.
LOCAL_OPENAI_ENABLED=1
LOCAL_OPENAI_BASE_URL=http://localhost:8081/v1

# ── OmniHarness settings ─────────────────────────────────────────────────────
OMNIHARNESS_DEFAULT_MODEL=claude-sonnet-4-6
OMNIHARNESS_HOST=localhost
OMNIHARNESS_GRPC_PORT=50051
OMNIHARNESS_PYTHON_PORT=8080
