//@ expect-stdout: got 42
fn parse_add(a: i32) -> Option<i32> {
    let x = checked(a)?
    Some(x + 2)
}
fn checked(a: i32) -> Option<i32> {
    if a > 0 { Some(a) } else { None }
}
pub fn main() {
    match parse_add(40) {
        Some(v) => println!("got {}", v),
        None => println!("nothing"),
    }
}
