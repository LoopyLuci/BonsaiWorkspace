//@ expect-stdout: Dog says Woof; Cat says Meow
trait Animal { fn speak(&self) -> String }
struct Dog {}
struct Cat {}
impl Animal for Dog { fn speak(&self) -> String { "Woof".to_string() } }
impl Animal for Cat { fn speak(&self) -> String { "Meow".to_string() } }
pub fn main() {
    let d = Dog {}
    let c = Cat {}
    println!("Dog says {}; Cat says {}", d.speak(), c.speak())
}
