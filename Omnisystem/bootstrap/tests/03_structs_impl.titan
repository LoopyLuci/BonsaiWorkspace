//@ expect-stdout: Point(3, 4) dist^2=25
struct Point { x: i32, y: i32 }
impl Point {
    fn new(x: i32, y: i32) -> Self { Point { x: x, y: y } }
    fn dist_sq(&self) -> i32 { self.x * self.x + self.y * self.y }
}
pub fn main() {
    let p = Point::new(3, 4)
    println!("Point({}, {}) dist^2={}", p.x, p.y, p.dist_sq())
}
