// `?` auto-converts a propagated error via `impl From<Src> for TargetErr`
// when the calling function's declared Result error type differs from the
// callee's, matching Rust's `?`/`From` idiom.
//@ expect-stdout: ok=70
//@ expect-stdout: parsing=xyz
struct ParseErr { msg: str }
enum AppErr {
    Parsing(str),
    Other(str),
}

impl From<ParseErr> for AppErr {
    fn from(e: ParseErr) -> AppErr {
        AppErr::Parsing(e.msg)
    }
}

fn parse_num(s: str) -> Result<i64, ParseErr> {
    match s.parse() {
        Ok(n) => Ok(n),
        Err(e) => Err(ParseErr { msg: s }),
    }
}

// Declares a DIFFERENT error type (AppErr) than parse_num's (ParseErr) —
// `?` must auto-convert via the From impl above.
fn process(s: str) -> Result<i64, AppErr> {
    let n = parse_num(s)?
    Ok(n * 10)
}

fn main() {
    match process("7") {
        Ok(n) => println!("ok={}", n),
        Err(AppErr::Parsing(m)) => println!("parsing={}", m),
        Err(AppErr::Other(m)) => println!("other={}", m),
    }
    match process("xyz") {
        Ok(n) => println!("ok={}", n),
        Err(AppErr::Parsing(m)) => println!("parsing={}", m),
        Err(AppErr::Other(m)) => println!("other={}", m),
    }
}
