// Loop labels: labeled break and labeled continue across nested loops.
//@ expect-stdout: 14
//@ expect-stdout: hits=3
fn main() {
    let mut count = 0
    'outer: for i in 0..5 {
        for j in 0..5 {
            if i * j > 6 { break 'outer }
            count = count + 1
        }
    }
    println!("{}", count)

    // labeled continue: skip to next outer iteration
    let mut hits = 0
    'rows: for a in 0..3 {
        for b in 0..3 {
            if b == 1 { continue 'rows }
            hits = hits + 1
        }
    }
    println!("hits={}", hits)
}
