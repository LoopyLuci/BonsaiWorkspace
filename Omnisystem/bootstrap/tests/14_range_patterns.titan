// Range patterns in match: inclusive, exclusive, open-ended, char ranges.
//@ expect-stdout: zero
//@ expect-stdout: small
//@ expect-stdout: medium
//@ expect-stdout: large
//@ expect-stdout: huge
//@ expect-stdout: A
//@ expect-stdout: B
//@ expect-stdout: F
fn classify(n: i64) -> str {
    match n {
        0 => "zero",
        1..=9 => "small",
        10..100 => "medium",
        100..=999 => "large",
        _ => "huge",
    }
}

fn grade(score: i64) -> char {
    match score {
        90..=100 => 'A',
        80..=89 => 'B',
        70..=79 => 'C',
        ..=69 => 'F',
        _ => '?',
    }
}

fn main() {
    println!("{}", classify(0))
    println!("{}", classify(5))
    println!("{}", classify(42))
    println!("{}", classify(500))
    println!("{}", classify(5000))
    println!("{}", grade(95))
    println!("{}", grade(83))
    println!("{}", grade(50))
}
