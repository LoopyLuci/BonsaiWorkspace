    pub struct EventEmitter {
        pub listeners: Vec<(String, u64)>,
    }

    impl EventEmitter {
        pub fn new() -> Self {
            EventEmitter {
                listeners: vec![],
            }
        }

        pub fn on(&mut self, event: String, callback_id: u64) {
            self.listeners.push((event, callback_id));
        }

        pub fn off(&mut self, event: String, callback_id: u64) {
            self.listeners.retain(|(e, c)| !(e == &event && *c == callback_id));
        }

        pub fn emit(&self, event: String, data: StateValue) {
            for (e, callback_id) in &self.listeners {
                if e == &event {
                    // Call callback with callback_id and data
                }
            }
        }
    }

