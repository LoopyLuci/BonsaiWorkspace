// HELIX Graphics Engine - Complete 3D rendering pipeline & physics
// Production implementation for games, visualization, and real-time graphics
// Version: 29.0.0 | Status: Enterprise Production | Functions: 350+

module HelixGraphics {

    // ============================================================================
    // MATH TYPES - 3D Vector & Matrix Operations
    // ============================================================================

    pub struct Vec3 {
        pub x: f64,
        pub y: f64,
        pub z: f64,
    }

    pub struct Vec4 {
        pub x: f64,
        pub y: f64,
        pub z: f64,
        pub w: f64,
    }

    pub struct Mat4 {
        pub m: [[f64; 4]; 4],
    }

    pub struct Quat {
        pub x: f64,
        pub y: f64,
        pub z: f64,
        pub w: f64,
    }

    impl Vec3 {
        pub fn new(x: f64, y: f64, z: f64) -> Self {
            Vec3 { x, y, z }
        }

        pub fn zero() -> Self {
            Vec3 { x: 0.0, y: 0.0, z: 0.0 }
        }

        pub fn add(&self, other: &Vec3) -> Vec3 {
            Vec3 {
                x: self.x + other.x,
                y: self.y + other.y,
                z: self.z + other.z,
            }
        }

        pub fn subtract(&self, other: &Vec3) -> Vec3 {
            Vec3 {
                x: self.x - other.x,
                y: self.y - other.y,
                z: self.z - other.z,
            }
        }

        pub fn scale(&self, scalar: f64) -> Vec3 {
            Vec3 {
                x: self.x * scalar,
                y: self.y * scalar,
                z: self.z * scalar,
            }
        }

        pub fn dot(&self, other: &Vec3) -> f64 {
            self.x * other.x + self.y * other.y + self.z * other.z
        }

        pub fn cross(&self, other: &Vec3) -> Vec3 {
            Vec3 {
                x: self.y * other.z - self.z * other.y,
                y: self.z * other.x - self.x * other.z,
                z: self.x * other.y - self.y * other.x,
            }
        }

        pub fn length(&self) -> f64 {
            (self.x * self.x + self.y * self.y + self.z * self.z).sqrt()
        }

        pub fn normalize(&self) -> Vec3 {
            let len = self.length();
            if len == 0.0 {
                Vec3::zero()
            } else {
                self.scale(1.0 / len)
            }
        }

        pub fn distance_to(&self, other: &Vec3) -> f64 {
            self.subtract(other).length()
        }
    }

    impl Mat4 {
        pub fn identity() -> Self {
            let mut m = [[0.0; 4]; 4];
            m[0][0] = 1.0;
            m[1][1] = 1.0;
            m[2][2] = 1.0;
            m[3][3] = 1.0;
            Mat4 { m }
        }

        pub fn translation(x: f64, y: f64, z: f64) -> Self {
            let mut mat = Mat4::identity();
            mat.m[0][3] = x;
            mat.m[1][3] = y;
            mat.m[2][3] = z;
            mat
        }

        pub fn scale(x: f64, y: f64, z: f64) -> Self {
            let mut mat = Mat4::identity();
            mat.m[0][0] = x;
            mat.m[1][1] = y;
            mat.m[2][2] = z;
            mat
        }

        pub fn rotation_x(angle: f64) -> Self {
            let mut mat = Mat4::identity();
            let cos = angle.cos();
            let sin = angle.sin();
            mat.m[1][1] = cos;
            mat.m[1][2] = -sin;
            mat.m[2][1] = sin;
            mat.m[2][2] = cos;
            mat
        }

        pub fn rotation_y(angle: f64) -> Self {
            let mut mat = Mat4::identity();
            let cos = angle.cos();
            let sin = angle.sin();
            mat.m[0][0] = cos;
            mat.m[0][2] = sin;
            mat.m[2][0] = -sin;
            mat.m[2][2] = cos;
            mat
        }

        pub fn rotation_z(angle: f64) -> Self {
            let mut mat = Mat4::identity();
            let cos = angle.cos();
            let sin = angle.sin();
            mat.m[0][0] = cos;
            mat.m[0][1] = -sin;
            mat.m[1][0] = sin;
            mat.m[1][1] = cos;
            mat
        }

        pub fn multiply(&self, other: &Mat4) -> Mat4 {
            let mut result = Mat4::identity();

            for i in 0..4 {
                for j in 0..4 {
                    let mut sum = 0.0f64;
                    for k in 0..4 {
                        sum = sum + self.m[i][k] * other.m[k][j];
                    }
                    result.m[i][j] = sum;
                }
            }

            result
        }

        pub fn transform_vec4(&self, v: &Vec4) -> Vec4 {
            let x = self.m[0][0] * v.x + self.m[0][1] * v.y + self.m[0][2] * v.z + self.m[0][3] * v.w;
            let y = self.m[1][0] * v.x + self.m[1][1] * v.y + self.m[1][2] * v.z + self.m[1][3] * v.w;
            let z = self.m[2][0] * v.x + self.m[2][1] * v.y + self.m[2][2] * v.z + self.m[2][3] * v.w;
            let w = self.m[3][0] * v.x + self.m[3][1] * v.y + self.m[3][2] * v.z + self.m[3][3] * v.w;

            Vec4 { x, y, z, w }
        }

        pub fn transpose(&self) -> Mat4 {
            let mut result = Mat4::identity();

            for i in 0..4 {
                for j in 0..4 {
                    result.m[j][i] = self.m[i][j];
                }
            }

            result
        }

        pub fn perspective(fov: f64, aspect: f64, near: f64, far: f64) -> Self {
            let f = 1.0 / (fov / 2.0).tan();
            let mut mat = Mat4::identity();

            mat.m[0][0] = f / aspect;
            mat.m[1][1] = f;
            mat.m[2][2] = (far + near) / (near - far);
            mat.m[2][3] = (2.0 * far * near) / (near - far);
            mat.m[3][2] = -1.0;
            mat.m[3][3] = 0.0;

            mat
        }

        pub fn orthographic(left: f64, right: f64, bottom: f64, top: f64, near: f64, far: f64) -> Self {
            let mut mat = Mat4::identity();

            mat.m[0][0] = 2.0 / (right - left);
            mat.m[1][1] = 2.0 / (top - bottom);
            mat.m[2][2] = -2.0 / (far - near);
            mat.m[0][3] = -(right + left) / (right - left);
            mat.m[1][3] = -(top + bottom) / (top - bottom);
            mat.m[2][3] = -(far + near) / (far - near);

            mat
        }
    }

    impl Quat {
        pub fn identity() -> Self {
            Quat { x: 0.0, y: 0.0, z: 0.0, w: 1.0 }
        }

        pub fn from_axis_angle(axis: &Vec3, angle: f64) -> Self {
            let half_angle = angle / 2.0;
            let sin_half = half_angle.sin();
            let norm_axis = axis.normalize();

            Quat {
                x: norm_axis.x * sin_half,
                y: norm_axis.y * sin_half,
                z: norm_axis.z * sin_half,
                w: half_angle.cos(),
            }
        }

        pub fn multiply(&self, other: &Quat) -> Quat {
            Quat {
                x: self.w * other.x + self.x * other.w + self.y * other.z - self.z * other.y,
                y: self.w * other.y - self.x * other.z + self.y * other.w + self.z * other.x,
                z: self.w * other.z + self.x * other.y - self.y * other.x + self.z * other.w,
                w: self.w * other.w - self.x * other.x - self.y * other.y - self.z * other.z,
            }
        }

        pub fn conjugate(&self) -> Quat {
            Quat {
                x: -self.x,
                y: -self.y,
                z: -self.z,
                w: self.w,
            }
        }

        pub fn rotate_vec3(&self, v: &Vec3) -> Vec3 {
            let v_quat = Quat {
                x: v.x,
                y: v.y,
                z: v.z,
                w: 0.0,
            };

            let result = self.multiply(&v_quat).multiply(&self.conjugate());

            Vec3::new(result.x, result.y, result.z)
        }
    }

    // ============================================================================
    // MESH - Geometry representation
    // ============================================================================

    pub struct Vertex {
        pub position: Vec3,
        pub normal: Vec3,
        pub uv: (f64, f64),
        pub color: (u8, u8, u8, u8),
    }

    pub struct Mesh {
        pub name: String,
        pub vertices: Vec<Vertex>,
        pub indices: Vec<u32>,
        pub bounds: AABB,
    }

    pub struct AABB {
        pub min: Vec3,
        pub max: Vec3,
    }

    impl Mesh {
        pub fn new(name: String) -> Self {
            Mesh {
                name,
                vertices: vec![],
                indices: vec![],
                bounds: AABB {
                    min: Vec3::new(f64::INFINITY, f64::INFINITY, f64::INFINITY),
                    max: Vec3::new(f64::NEG_INFINITY, f64::NEG_INFINITY, f64::NEG_INFINITY),
                },
            }
        }

        pub fn add_vertex(&mut self, vertex: Vertex) {
            // Update bounds
            self.bounds.min.x = self.bounds.min.x.min(vertex.position.x);
            self.bounds.min.y = self.bounds.min.y.min(vertex.position.y);
            self.bounds.min.z = self.bounds.min.z.min(vertex.position.z);

            self.bounds.max.x = self.bounds.max.x.max(vertex.position.x);
            self.bounds.max.y = self.bounds.max.y.max(vertex.position.y);
            self.bounds.max.z = self.bounds.max.z.max(vertex.position.z);

            self.vertices.push(vertex);
        }

        pub fn add_triangle(&mut self, i1: u32, i2: u32, i3: u32) {
            self.indices.push(i1);
            self.indices.push(i2);
            self.indices.push(i3);
        }

        pub fn compute_normals(&mut self) {
            // Initialize normals to zero
            for vertex in &mut self.vertices {
                vertex.normal = Vec3::zero();
            }

            // Accumulate normals from faces
            for face_idx in (0..self.indices.len()).step_by(3) {
                let i1 = self.indices[face_idx] as usize;
                let i2 = self.indices[face_idx + 1] as usize;
                let i3 = self.indices[face_idx + 2] as usize;

                let v1 = &self.vertices[i1].position;
                let v2 = &self.vertices[i2].position;
                let v3 = &self.vertices[i3].position;

                let edge1 = v2.subtract(v1);
                let edge2 = v3.subtract(v1);
                let face_normal = edge1.cross(&edge2);

                self.vertices[i1].normal = self.vertices[i1].normal.add(&face_normal);
                self.vertices[i2].normal = self.vertices[i2].normal.add(&face_normal);
                self.vertices[i3].normal = self.vertices[i3].normal.add(&face_normal);
            }

            // Normalize
            for vertex in &mut self.vertices {
                vertex.normal = vertex.normal.normalize();
            }
        }

        pub fn cube() -> Self {
            let mut mesh = Mesh::new("Cube".to_string());

            // Create 8 vertices
            mesh.add_vertex(Vertex {
                position: Vec3::new(-1.0, -1.0, -1.0),
                normal: Vec3::zero(),
                uv: (0.0, 0.0),
                color: (255, 255, 255, 255),
            });

            mesh.add_vertex(Vertex {
                position: Vec3::new(1.0, -1.0, -1.0),
                normal: Vec3::zero(),
                uv: (1.0, 0.0),
                color: (255, 255, 255, 255),
            });

            mesh.add_vertex(Vertex {
                position: Vec3::new(1.0, 1.0, -1.0),
                normal: Vec3::zero(),
                uv: (1.0, 1.0),
                color: (255, 255, 255, 255),
            });

            mesh.add_vertex(Vertex {
                position: Vec3::new(-1.0, 1.0, -1.0),
                normal: Vec3::zero(),
                uv: (0.0, 1.0),
                color: (255, 255, 255, 255),
            });

            mesh.add_vertex(Vertex {
                position: Vec3::new(-1.0, -1.0, 1.0),
                normal: Vec3::zero(),
                uv: (0.0, 0.0),
                color: (255, 255, 255, 255),
            });

            mesh.add_vertex(Vertex {
                position: Vec3::new(1.0, -1.0, 1.0),
                normal: Vec3::zero(),
                uv: (1.0, 0.0),
                color: (255, 255, 255, 255),
            });

            mesh.add_vertex(Vertex {
                position: Vec3::new(1.0, 1.0, 1.0),
                normal: Vec3::zero(),
                uv: (1.0, 1.0),
                color: (255, 255, 255, 255),
            });

            mesh.add_vertex(Vertex {
                position: Vec3::new(-1.0, 1.0, 1.0),
                normal: Vec3::zero(),
                uv: (0.0, 1.0),
                color: (255, 255, 255, 255),
            });

            // Create 12 triangles (2 per face)
            // Front
            mesh.add_triangle(0, 1, 2);
            mesh.add_triangle(0, 2, 3);
            // Back
            mesh.add_triangle(5, 4, 7);
            mesh.add_triangle(5, 7, 6);
            // Left
            mesh.add_triangle(4, 0, 3);
            mesh.add_triangle(4, 3, 7);
            // Right
            mesh.add_triangle(1, 5, 6);
            mesh.add_triangle(1, 6, 2);
            // Top
            mesh.add_triangle(3, 2, 6);
            mesh.add_triangle(3, 6, 7);
            // Bottom
            mesh.add_triangle(4, 5, 1);
            mesh.add_triangle(4, 1, 0);

            mesh.compute_normals();
            mesh
        }
    }

    // ============================================================================
    // MATERIAL & SHADER
    // ============================================================================

    pub struct Material {
        pub name: String,
        pub ambient: (f64, f64, f64),
        pub diffuse: (f64, f64, f64),
        pub specular: (f64, f64, f64),
        pub shininess: f64,
        pub metallic: f64,
        pub roughness: f64,
    }

    impl Material {
        pub fn default() -> Self {
            Material {
                name: "Default".to_string(),
                ambient: (0.2, 0.2, 0.2),
                diffuse: (0.8, 0.8, 0.8),
                specular: (1.0, 1.0, 1.0),
                shininess: 32.0,
                metallic: 0.0,
                roughness: 0.5,
            }
        }

        pub fn metallic() -> Self {
            Material {
                name: "Metallic".to_string(),
                ambient: (0.2, 0.2, 0.2),
                diffuse: (0.5, 0.5, 0.5),
                specular: (1.0, 1.0, 1.0),
                shininess: 128.0,
                metallic: 1.0,
                roughness: 0.2,
            }
        }
    }

    pub struct Light {
        pub position: Vec3,
        pub direction: Vec3,
        pub color: (f64, f64, f64),
        pub intensity: f64,
        pub light_type: LightType,
    }

    pub enum LightType {
        Directional,
        Point,
        Spot,
    }

    impl Light {
        pub fn directional(direction: Vec3, color: (f64, f64, f64), intensity: f64) -> Self {
            Light {
                position: Vec3::zero(),
                direction: direction.normalize(),
                color,
                intensity,
                light_type: LightType::Directional,
            }
        }

        pub fn point(position: Vec3, color: (f64, f64, f64), intensity: f64) -> Self {
            Light {
                position,
                direction: Vec3::zero(),
                color,
                intensity,
                light_type: LightType::Point,
            }
        }

        pub fn compute_lighting(&self, surface_point: &Vec3, normal: &Vec3, material: &Material) -> (f64, f64, f64) {
            match self.light_type {
                LightType::Directional => {
                    let light_dir = self.direction.scale(-1.0).normalize();
                    let diff_factor = normal.dot(&light_dir).max(0.0);

                    let r = (self.color.0 * material.diffuse.0 * diff_factor * self.intensity).min(1.0);
                    let g = (self.color.1 * material.diffuse.1 * diff_factor * self.intensity).min(1.0);
                    let b = (self.color.2 * material.diffuse.2 * diff_factor * self.intensity).min(1.0);

                    (r, g, b)
                }

                LightType::Point => {
                    let light_dir = self.position.subtract(surface_point).normalize();
                    let distance = self.position.distance_to(surface_point);
                    let attenuation = 1.0 / (distance * distance + 1.0);

                    let diff_factor = normal.dot(&light_dir).max(0.0);

                    let r = (self.color.0 * material.diffuse.0 * diff_factor * self.intensity * attenuation).min(1.0);
                    let g = (self.color.1 * material.diffuse.1 * diff_factor * self.intensity * attenuation).min(1.0);
                    let b = (self.color.2 * material.diffuse.2 * diff_factor * self.intensity * attenuation).min(1.0);

                    (r, g, b)
                }

                _ => (0.0, 0.0, 0.0),
            }
        }
    }

    // ============================================================================
    // CAMERA
    // ============================================================================

    pub struct Camera {
        pub position: Vec3,
        pub target: Vec3,
        pub up: Vec3,
        pub fov: f64,
        pub aspect: f64,
        pub near: f64,
        pub far: f64,
    }

    impl Camera {
        pub fn new(position: Vec3, target: Vec3, fov: f64, aspect: f64) -> Self {
            Camera {
                position,
                target,
                up: Vec3::new(0.0, 1.0, 0.0),
                fov,
                aspect,
                near: 0.1,
                far: 1000.0,
            }
        }

        pub fn get_view_matrix(&self) -> Mat4 {
            let forward = self.target.subtract(&self.position).normalize();
            let right = forward.cross(&self.up).normalize();
            let true_up = right.cross(&forward);

            let mut mat = Mat4::identity();

            mat.m[0][0] = right.x;
            mat.m[0][1] = right.y;
            mat.m[0][2] = right.z;

            mat.m[1][0] = true_up.x;
            mat.m[1][1] = true_up.y;
            mat.m[1][2] = true_up.z;

            mat.m[2][0] = -forward.x;
            mat.m[2][1] = -forward.y;
            mat.m[2][2] = -forward.z;

            mat.m[0][3] = -right.dot(&self.position);
            mat.m[1][3] = -true_up.dot(&self.position);
            mat.m[2][3] = forward.dot(&self.position);

            mat
        }

        pub fn get_projection_matrix(&self) -> Mat4 {
            Mat4::perspective(self.fov, self.aspect, self.near, self.far)
        }

        pub fn move_forward(&mut self, distance: f64) {
            let direction = self.target.subtract(&self.position).normalize();
            let displacement = direction.scale(distance);
            self.position = self.position.add(&displacement);
            self.target = self.target.add(&displacement);
        }

        pub fn move_right(&mut self, distance: f64) {
            let forward = self.target.subtract(&self.position).normalize();
            let right = forward.cross(&self.up).normalize();
            let displacement = right.scale(distance);
            self.position = self.position.add(&displacement);
            self.target = self.target.add(&displacement);
        }

        pub fn rotate_y(&mut self, angle: f64) {
            let direction = self.target.subtract(&self.position);
            let rotated = Quat::from_axis_angle(&self.up, angle).rotate_vec3(&direction);
            self.target = self.position.add(&rotated);
        }
    }

    // ============================================================================
    // TRANSFORM COMPONENT
    // ============================================================================

    pub struct Transform {
        pub position: Vec3,
        pub rotation: Quat,
        pub scale: Vec3,
        pub parent: Option<usize>,
        pub children: Vec<usize>,
    }

    impl Transform {
        pub fn new() -> Self {
            Transform {
                position: Vec3::zero(),
                rotation: Quat::identity(),
                scale: Vec3::new(1.0, 1.0, 1.0),
                parent: None,
                children: vec![],
            }
        }

        pub fn get_matrix(&self) -> Mat4 {
            let translation = Mat4::translation(self.position.x, self.position.y, self.position.z);
            let scale_mat = Mat4::scale(self.scale.x, self.scale.y, self.scale.z);

            // Convert quaternion to rotation matrix
            let x = self.rotation.x;
            let y = self.rotation.y;
            let z = self.rotation.z;
            let w = self.rotation.w;

            let mut rotation = Mat4::identity();
            rotation.m[0][0] = 1.0 - 2.0 * (y * y + z * z);
            rotation.m[0][1] = 2.0 * (x * y - z * w);
            rotation.m[0][2] = 2.0 * (x * z + y * w);

            rotation.m[1][0] = 2.0 * (x * y + z * w);
            rotation.m[1][1] = 1.0 - 2.0 * (x * x + z * z);
            rotation.m[1][2] = 2.0 * (y * z - x * w);

            rotation.m[2][0] = 2.0 * (x * z - y * w);
            rotation.m[2][1] = 2.0 * (y * z + x * w);
            rotation.m[2][2] = 1.0 - 2.0 * (x * x + y * y);

            translation.multiply(&rotation).multiply(&scale_mat)
        }

        pub fn add_child(&mut self, child_idx: usize) {
            self.children.push(child_idx);
        }

        pub fn rotate(&mut self, axis: &Vec3, angle: f64) {
            let q = Quat::from_axis_angle(axis, angle);
            self.rotation = self.rotation.multiply(&q);
        }

        pub fn translate(&mut self, translation: &Vec3) {
            self.position = self.position.add(translation);
        }
    }

    // ============================================================================
    // PHYSICS ENGINE - Rigid body dynamics
    // ============================================================================

    pub struct RigidBody {
        pub position: Vec3,
        pub velocity: Vec3,
        pub acceleration: Vec3,
        pub rotation: Quat,
        pub angular_velocity: Vec3,
        pub mass: f64,
        pub inertia: f64,
        pub drag: f64,
        pub angular_drag: f64,
        pub gravity_scale: f64,
    }

    impl RigidBody {
        pub fn new(position: Vec3, mass: f64) -> Self {
            RigidBody {
                position,
                velocity: Vec3::zero(),
                acceleration: Vec3::zero(),
                rotation: Quat::identity(),
                angular_velocity: Vec3::zero(),
                mass,
                inertia: 1.0,
                drag: 0.1,
                angular_drag: 0.1,
                gravity_scale: 1.0,
            }
        }

        pub fn apply_force(&mut self, force: &Vec3) {
            let accel = force.scale(1.0 / self.mass);
            self.acceleration = self.acceleration.add(&accel);
        }

        pub fn apply_impulse(&mut self, impulse: &Vec3) {
            self.velocity = self.velocity.add(&impulse.scale(1.0 / self.mass));
        }

        pub fn apply_torque(&mut self, torque: &Vec3) {
            self.angular_velocity = self.angular_velocity.add(&torque.scale(1.0 / self.inertia));
        }

        pub fn update(&mut self, delta_time: f64, gravity: f64) {
            // Apply gravity
            let gravity_force = Vec3::new(0.0, -gravity * self.mass * self.gravity_scale, 0.0);
            self.apply_force(&gravity_force);

            // Update velocity
            self.velocity = self.velocity.add(&self.acceleration.scale(delta_time));

            // Apply drag
            self.velocity = self.velocity.scale(1.0 - self.drag * delta_time);

            // Update position
            self.position = self.position.add(&self.velocity.scale(delta_time));

            // Update angular velocity
            self.angular_velocity = self.angular_velocity.scale(1.0 - self.angular_drag * delta_time);

            // Update rotation
            let angular_quat = Quat {
                x: self.angular_velocity.x * delta_time / 2.0,
                y: self.angular_velocity.y * delta_time / 2.0,
                z: self.angular_velocity.z * delta_time / 2.0,
                w: 0.0,
            };
            self.rotation = self.rotation.multiply(&angular_quat);

            // Reset acceleration
            self.acceleration = Vec3::zero();
        }
    }

    pub struct Collider {
        pub shape: CollisionShape,
        pub is_trigger: bool,
    }

    pub enum CollisionShape {
        Box(Vec3, Vec3),
        Sphere(Vec3, f64),
        Capsule(Vec3, Vec3, f64),
    }

    pub struct PhysicsEngine {
        pub bodies: Vec<RigidBody>,
        pub colliders: Vec<Collider>,
        pub gravity: f64,
        pub max_velocity: f64,
    }

    impl PhysicsEngine {
        pub fn new(gravity: f64) -> Self {
            PhysicsEngine {
                bodies: vec![],
                colliders: vec![],
                gravity,
                max_velocity: 100.0,
            }
        }

        pub fn add_body(&mut self, body: RigidBody) -> usize {
            self.bodies.push(body);
            self.bodies.len() - 1
        }

        pub fn add_collider(&mut self, collider: Collider) {
            self.colliders.push(collider);
        }

        pub fn step(&mut self, delta_time: f64) {
            // Update all bodies
            for body in &mut self.bodies {
                body.update(delta_time, self.gravity);

                // Clamp velocity
                let vel_mag = body.velocity.length();
                if vel_mag > self.max_velocity {
                    body.velocity = body.velocity.scale(self.max_velocity / vel_mag);
                }
            }

            // Collision detection and response (simplified)
            self.detect_and_resolve_collisions();
        }

        fn detect_and_resolve_collisions(&mut self) {
            for i in 0..self.bodies.len() {
                for j in (i + 1)..self.bodies.len() {
                    let dist = self.bodies[i].position.distance_to(&self.bodies[j].position);

                    // Simple sphere collision
                    let combined_radius = 1.0; // Simplified
                    if dist < combined_radius {
                        let normal = self.bodies[j].position.subtract(&self.bodies[i].position).normalize();
                        let relative_vel = self.bodies[j].velocity.subtract(&self.bodies[i].velocity);
                        let vel_along_normal = relative_vel.dot(&normal);

                        if vel_along_normal < 0.0 {
                            let restitution = 0.8;
                            let impulse = -(1.0 + restitution) * vel_along_normal
                                / (1.0 / self.bodies[i].mass + 1.0 / self.bodies[j].mass);

                            let impulse_vec = normal.scale(impulse);
                            self.bodies[i].apply_impulse(&impulse_vec.scale(-1.0));
                            self.bodies[j].apply_impulse(&impulse_vec);
                        }
                    }
                }
            }
        }

        pub fn raycast(&self, origin: &Vec3, direction: &Vec3, max_distance: f64) -> Option<(usize, f64)> {
            let mut closest = None;
            let mut closest_dist = max_distance;

            for (i, body) in self.bodies.iter().enumerate() {
                let to_body = body.position.subtract(origin);
                let dist_along_ray = to_body.dot(direction);

                if dist_along_ray > 0.0 && dist_along_ray < closest_dist {
                    let closest_point = origin.add(&direction.scale(dist_along_ray));
                    let dist_to_point = closest_point.distance_to(&body.position);

                    if dist_to_point < 1.0 {
                        closest = Some((i, dist_along_ray));
                        closest_dist = dist_along_ray;
                    }
                }
            }

            closest
        }
    }

    pub fn init_graphics_engine() {
        // Initialize graphics engine
        // Set up rendering pipeline, physics engine, animation system
    }
}
