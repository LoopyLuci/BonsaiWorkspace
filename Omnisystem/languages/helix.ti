pub fn scene_create(name: String) -> String {
    // Creates scene (level/world container)
    // Manages entities, lights, cameras
    let scene = json_create_object();
    let s2 = json_object_set(scene, "name", name);
    let s3 = json_object_set(s2, "entities", "0");
    omnisystem_type_wrap(s3, "helix/scene")
}

pub fn entity_create(scene: String, name: String) -> String {
    // Creates entity in scene
    // Entities are game objects with components
    let entity = json_create_object();
    let e2 = json_object_set(entity, "name", name);
    let e3 = json_object_set(e2, "scene", "scene_ref");
    omnisystem_type_wrap(e3, "helix/entity")
}

