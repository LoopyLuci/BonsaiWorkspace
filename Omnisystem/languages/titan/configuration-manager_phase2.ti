import ull::bridge
pub struct Manager { cache: Object, state: String }
impl Manager {
    pub fn new() -> Self { Manager { cache: {}, state: "init" } }
    pub fn op(mut self: Self, p: String) -> Result[Object] { if p.is_empty() { Err("Param") } else { bridge::call_rust("config", "op", {"p": p})? } }
}
#[cfg(test)]
mod tests { use super::*; #[test] fn t1() { let m = Manager::new(); assert_eq!(m.state, "init"); } #[test] fn t2() { let mut m = Manager::new(); assert!(m.op("p".to_string()).is_ok()); } #[test] fn t3() { let mut m = Manager::new(); assert!(m.op("".to_string()).is_err()); } #[test] fn t4() { let m = Manager::new(); assert!(m.cache.is_empty()); } #[test] fn t5() { let mut m = Manager::new(); m.op("a".to_string()).ok(); } #[test] fn t6() { let m = Manager::new(); assert!(m.op("x".to_string()).is_ok() || m.op("x".to_string()).is_err()); } #[test] fn t7() { let mut m = Manager::new(); m.op("test".to_string()).ok(); } #[test] fn t8() { let m = Manager::new(); assert!(!m.state.is_empty()); } #[test] fn t9() { let mut m = Manager::new(); m.op("p".to_string()).ok(); } #[test] fn t10() { let m = Manager::new(); assert_eq!(m.state, "init"); } }
