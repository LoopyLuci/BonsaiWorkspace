        level: i32,
    }

    pub struct TargetConfig {
        target_arch: String,
        target_os: String,
        optimization_level: i32,
        debug_symbols: bool,
    }

    pub fn constant_folding(ast: Vec<Statement>) -> Vec<Statement> {
