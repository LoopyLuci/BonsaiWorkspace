// TITAN Wrapper: app-manager-core
//
// Core app management implementation using ULL bridge to Rust
// Provides foundation for all app-manager modules

import ull::bridge
import ull::types

pub struct AppCore {
    app_id: String
    name: String
    version: String
    metadata: Object
}

impl AppCore {
    pub fn new(app_id: String, name: String) -> Self {
        return AppCore {
            app_id: app_id,
            name: name,
            version: "1.0.0",
            metadata: {},
        }
    }

    pub fn with_version(mut self: Self, version: String) -> Self {
        self.version = version
        return self
    }

    pub fn set_metadata(mut self: Self, key: String, value: String) -> Self {
        self.metadata[key] = value
        return self
    }
}

pub fn create_app(app_id: String, name: String) -> Result[AppCore] {
    let result = bridge::call_rust("app-manager-core", "create_app", {
        "app_id": app_id.clone(),
        "name": name.clone(),
    })?

    return Ok(AppCore::new(app_id, name))
}

pub fn update_app(app_id: String, updates: Object) -> Result[AppCore] {
    let result = bridge::call_rust("app-manager-core", "update_app", {
        "app_id": app_id.clone(),
        "updates": updates,
    })?

    return Ok(AppCore::new(app_id, "Updated"))
}

pub fn delete_app(app_id: String) -> Result[bool] {
    let result = bridge::call_rust("app-manager-core", "delete_app", {
        "app_id": app_id,
    })?

    return Ok(result as bool)
}

pub fn start_app(app_id: String) -> Result[bool] {
    let result = bridge::call_rust("app-manager-core", "start_app", {
        "app_id": app_id,
    })?

    return Ok(result as bool)
}

pub fn stop_app(app_id: String) -> Result[bool] {
    let result = bridge::call_rust("app-manager-core", "stop_app", {
        "app_id": app_id,
    })?

    return Ok(result as bool)
}

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_app_core_creation() {
        let app = AppCore::new("app1", "Test App")
        assert_eq!(app.app_id, "app1")
        assert_eq!(app.name, "Test App")
        assert_eq!(app.version, "1.0.0")
    }

    #[test]
    fn test_app_core_metadata() {
        let app = AppCore::new("app2", "App2")
            .set_metadata("env", "production")
            .set_metadata("tier", "critical")

        assert_eq!(app.metadata["env"], "production")
        assert_eq!(app.metadata["tier"], "critical")
    }
}
