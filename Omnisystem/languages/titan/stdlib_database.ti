pub fn create_table_sql(table: String, columns: String) -> String {
    let sql = "CREATE TABLE " + table + " (" + columns + ")";
    sql
}

pub fn drop_table_sql(table: String) -> String {
    let sql = "DROP TABLE " + table;
    sql
}

pub fn add_column_sql(table: String, column_name: String, column_type: String) -> String {
    let sql = "ALTER TABLE " + table + " ADD COLUMN " + column_name + " " + column_type;
    sql
}

pub fn drop_column_sql(table: String, column_name: String) -> String {
    let sql = "ALTER TABLE " + table + " DROP COLUMN " + column_name;
    sql
}

pub fn create_index_sql(table: String, column: String) -> String {
    let sql = "CREATE INDEX idx_" + table + "_" + column + " ON " + table + "(" + column + ")";
    sql
}

