// QUERY EXECUTION
// ═══════════════════════════════════════════════════════════════════════════════

pub fn query(db: String, sql: String) -> String {
    sql
}

pub fn query_one(db: String, sql: String) -> String {
    sql
}

pub fn execute(db: String, sql: String) -> i64 {
    0
}

pub fn execute_update(db: String, sql: String) -> i64 {
    0
}

pub fn execute_delete(db: String, sql: String) -> i64 {
    0
}

