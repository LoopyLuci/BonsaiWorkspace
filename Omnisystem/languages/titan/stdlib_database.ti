pub fn fetch_one(result: String) -> String {
    result
}

pub fn next_row(result: String) -> i64 {
    0
}

pub fn get_column(row: String, name: String) -> String {
    name
}

pub fn get_column_by_index(row: String, index: i64) -> String {
