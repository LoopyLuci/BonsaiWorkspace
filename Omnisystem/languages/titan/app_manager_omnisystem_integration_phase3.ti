pub struct IntegrationManager { integrations: Object, events: Array[Object] }
impl IntegrationManager {
    pub fn new() -> Self { return IntegrationManager { integrations: {}, events: [] } }
    pub fn register(mut self: Self, sys: String) -> Result[bool] { if sys.is_empty() { return Err("System") } self.integrations[sys] = true; Ok(true) }
    pub fn publish_event(mut self: Self, event: String, data: Object) -> Result[bool] { self.events.push({"event": event}); Ok(true) }
    pub fn get_events(self: &Self) -> Result[Array[Object]] { Ok(self.events) }
    pub fn sync_state(self: &Self, sys: String) -> Result[bool] { if !self.integrations.contains(&sys) { Err("Not registered") } else { Ok(true) } }
    pub fn list_integrations(self: &Self) -> Result[Array[String]] { let mut s: Array[String] = []; for e in self.integrations { s.push(e.0) } Ok(s) }
}
#[cfg(test)]
mod tests { use super::*; #[test] fn t1() { let mut m = IntegrationManager::new(); assert!(m.register("s1".to_string()).is_ok()); } #[test] fn t2() { let mut m = IntegrationManager::new(); assert!(m.publish_event("e1".to_string(), {}).is_ok()); } #[test] fn t3() { let m = IntegrationManager::new(); assert!(m.get_events().is_ok()); } #[test] fn t4() { let mut m = IntegrationManager::new(); m.register("s1".to_string()).ok(); assert!(m.sync_state("s1".to_string()).is_ok()); } #[test] fn t5() { let mut m = IntegrationManager::new(); m.register("s1".to_string()).ok(); m.register("s2".to_string()).ok(); assert!(m.list_integrations().is_ok()); } #[test] fn t6() { let m = IntegrationManager::new(); assert!(m.sync_state("s1".to_string()).is_err()); } #[test] fn t7() { let mut m = IntegrationManager::new(); m.register("s1".to_string()).ok(); m.publish_event("e1".to_string(), {}).ok(); assert_eq!(m.get_events().unwrap().len(), 1); } #[test] fn t8() { let mut m = IntegrationManager::new(); m.publish_event("e1".to_string(), {}).ok(); m.publish_event("e2".to_string(), {}).ok(); assert_eq!(m.get_events().unwrap().len(), 2); } #[test] fn t9() { let mut m = IntegrationManager::new(); assert!(m.register("sys1".to_string()).is_ok()); assert!(m.register("sys2".to_string()).is_ok()); } #[test] fn t10() { let m = IntegrationManager::new(); assert!(m.publish_event("".to_string(), {}).is_err()); } }
