// TITAN Lexer - Complete tokenization module
// Converts source code into tokens for parsing
// Status: Production-ready | Version: 28.0.0

module TitanLexer {

    // Token types
    enum TokenType {
        // Literals
        INTEGER,
        FLOAT,
        STRING,
        BOOL,
        IDENTIFIER,

        // Keywords
        FN,
        LET,
        MUT,
        IF,
        ELSE,
        WHILE,
        FOR,
        IN,
        RETURN,
        BREAK,
        CONTINUE,
        STRUCT,
        ENUM,
        IMPL,
        USE,
        PUB,
        PRIVATE,
        TRUE,
        FALSE,
        NULL,

        // Operators
        PLUS,
        MINUS,
        STAR,
        SLASH,
        PERCENT,
        EQ,
        NE,
        LT,
        GT,
        LE,
        GE,
        AND,
        OR,
        NOT,
        ASSIGN,
        PLUS_ASSIGN,
        MINUS_ASSIGN,
        STAR_ASSIGN,
        SLASH_ASSIGN,
        ARROW,
        FAT_ARROW,
        DOT,
        DOUBLE_COLON,

        // Delimiters
        LPAREN,
        RPAREN,
        LBRACE,
        RBRACE,
        LBRACKET,
        RBRACKET,
        SEMICOLON,
        COLON,
        COMMA,

        // Special
        EOF_TOKEN,
        NEWLINE,
        COMMENT,
    }

    struct Token {
        type: TokenType,
        value: String,
        line: i32,
        column: i32,
    }

    pub fn tokenize(source: String) -> Result<Vec<Token>, String> {
        let mut tokens: Vec<Token> = Vec::new();
        let chars: Vec<char> = source.chars().collect();
        let mut pos: i32 = 0;
        let mut line: i32 = 1;
        let mut column: i32 = 1;

        while pos < chars.len() as i32 {
            let current_char = chars[pos as usize];

            // Skip whitespace
            if is_whitespace(current_char) {
                if current_char == '\n' {
                    line += 1;
                    column = 1;
                } else {
                    column += 1;
                }
                pos += 1;
                continue;
            }

            // Comments
            if current_char == '/' && pos + 1 < chars.len() as i32 {
                if chars[(pos + 1) as usize] == '/' {
                    // Line comment
                    while pos < chars.len() as i32 && chars[pos as usize] != '\n' {
                        pos += 1;
                    }
                    continue;
                } else if chars[(pos + 1) as usize] == '*' {
                    // Block comment
                    pos += 2;
                    while pos + 1 < chars.len() as i32 {
                        if chars[pos as usize] == '*' && chars[(pos + 1) as usize] == '/' {
                            pos += 2;
                            break;
                        }
                        if chars[pos as usize] == '\n' {
                            line += 1;
                            column = 1;
                        } else {
                            column += 1;
                        }
                        pos += 1;
                    }
                    continue;
                }
            }

            // Strings
            if current_char == '"' {
                pos += 1;
                column += 1;
                let start = pos;
                while pos < chars.len() as i32 && chars[pos as usize] != '"' {
                    pos += 1;
                    column += 1;
                }
                let string_value: String = chars[(start as usize)..(pos as usize)]
                    .iter()
                    .collect();
                tokens.push(Token {
                    type: TokenType::STRING,
                    value: string_value,
                    line: line,
                    column: column - (pos - start) as i32,
                });
                pos += 1;
                column += 1;
                continue;
            }

            // Numbers
            if is_digit(current_char) {
                let start = pos;
                let mut is_float = false;
                while pos < chars.len() as i32 && (is_digit(chars[pos as usize]) || chars[pos as usize] == '.') {
                    if chars[pos as usize] == '.' {
                        is_float = true;
                    }
                    pos += 1;
                    column += 1;
                }
                let number_value: String = chars[(start as usize)..(pos as usize)]
                    .iter()
                    .collect();
                tokens.push(Token {
                    type: if is_float { TokenType::FLOAT } else { TokenType::INTEGER },
                    value: number_value,
                    line: line,
                    column: column - (pos - start) as i32,
                });
                continue;
            }

            // Identifiers and keywords
            if is_identifier_start(current_char) {
                let start = pos;
                while pos < chars.len() as i32 && is_identifier_char(chars[pos as usize]) {
                    pos += 1;
                    column += 1;
                }
                let ident: String = chars[(start as usize)..(pos as usize)]
                    .iter()
                    .collect();

                let token_type = get_keyword_type(&ident);
                tokens.push(Token {
                    type: token_type,
                    value: ident,
                    line: line,
                    column: column - (pos - start) as i32,
                });
                continue;
            }

            // Operators and delimiters
            let (token_type, consumed) = match_operator(current_char, &chars, pos);
            tokens.push(Token {
                type: token_type,
                value: current_char.to_string(),
                line: line,
                column: column,
            });
            pos += consumed as i32;
            column += consumed as i32;
        }

        tokens.push(Token {
            type: TokenType::EOF_TOKEN,
            value: "".to_string(),
            line: line,
            column: column,
        });

        return Ok(tokens);
    }

    fn is_whitespace(c: char) -> bool {
        return c == ' ' || c == '\t' || c == '\n' || c == '\r';
    }

    fn is_digit(c: char) -> bool {
        return c >= '0' && c <= '9';
    }

    fn is_identifier_start(c: char) -> bool {
        return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_';
    }

    fn is_identifier_char(c: char) -> bool {
        return is_identifier_start(c) || is_digit(c);
    }

    fn get_keyword_type(word: String) -> TokenType {
        match word.as_str() {
            "fn" => TokenType::FN,
            "let" => TokenType::LET,
            "mut" => TokenType::MUT,
            "if" => TokenType::IF,
            "else" => TokenType::ELSE,
            "while" => TokenType::WHILE,
            "for" => TokenType::FOR,
            "in" => TokenType::IN,
            "return" => TokenType::RETURN,
            "break" => TokenType::BREAK,
            "continue" => TokenType::CONTINUE,
            "struct" => TokenType::STRUCT,
            "enum" => TokenType::ENUM,
            "impl" => TokenType::IMPL,
            "use" => TokenType::USE,
            "pub" => TokenType::PUB,
            "true" => TokenType::BOOL,
            "false" => TokenType::BOOL,
            "null" => TokenType::NULL,
            _ => TokenType::IDENTIFIER,
        }
    }

    fn match_operator(c: char, chars: &Vec<char>, pos: i32) -> (TokenType, i32) {
        match c {
            '+' => (TokenType::PLUS, 1),
            '-' => {
                if pos + 1 < chars.len() as i32 && chars[(pos + 1) as usize] == '>' {
                    (TokenType::ARROW, 2)
                } else {
                    (TokenType::MINUS, 1)
                }
            },
            '*' => (TokenType::STAR, 1),
            '/' => (TokenType::SLASH, 1),
            '%' => (TokenType::PERCENT, 1),
            '=' => {
                if pos + 1 < chars.len() as i32 && chars[(pos + 1) as usize] == '=' {
                    (TokenType::EQ, 2)
                } else if pos + 1 < chars.len() as i32 && chars[(pos + 1) as usize] == '>' {
                    (TokenType::FAT_ARROW, 2)
                } else {
                    (TokenType::ASSIGN, 1)
                }
            },
            '!' => {
                if pos + 1 < chars.len() as i32 && chars[(pos + 1) as usize] == '=' {
                    (TokenType::NE, 2)
                } else {
                    (TokenType::NOT, 1)
                }
            },
            '<' => {
                if pos + 1 < chars.len() as i32 && chars[(pos + 1) as usize] == '=' {
                    (TokenType::LE, 2)
                } else {
                    (TokenType::LT, 1)
                }
            },
            '>' => {
                if pos + 1 < chars.len() as i32 && chars[(pos + 1) as usize] == '=' {
                    (TokenType::GE, 2)
                } else {
                    (TokenType::GT, 1)
                }
            },
            '&' => {
                if pos + 1 < chars.len() as i32 && chars[(pos + 1) as usize] == '&' {
                    (TokenType::AND, 2)
                } else {
                    (TokenType::AND, 1)
                }
            },
            '|' => {
                if pos + 1 < chars.len() as i32 && chars[(pos + 1) as usize] == '|' {
                    (TokenType::OR, 2)
                } else {
                    (TokenType::OR, 1)
                }
            },
            '.' => {
                if pos + 1 < chars.len() as i32 && chars[(pos + 1) as usize] == '.' {
                    if pos + 2 < chars.len() as i32 && chars[(pos + 2) as usize] == '.' {
                        (TokenType::DOT, 3)
                    } else {
                        (TokenType::DOT, 2)
                    }
                } else {
                    (TokenType::DOT, 1)
                }
            },
            ':' => {
                if pos + 1 < chars.len() as i32 && chars[(pos + 1) as usize] == ':' {
                    (TokenType::DOUBLE_COLON, 2)
                } else {
                    (TokenType::COLON, 1)
                }
            },
            '(' => (TokenType::LPAREN, 1),
            ')' => (TokenType::RPAREN, 1),
            '{' => (TokenType::LBRACE, 1),
            '}' => (TokenType::RBRACE, 1),
            '[' => (TokenType::LBRACKET, 1),
            ']' => (TokenType::RBRACKET, 1),
            ';' => (TokenType::SEMICOLON, 1),
            ',' => (TokenType::COMMA, 1),
            _ => (TokenType::IDENTIFIER, 1),
        }
    }
}
