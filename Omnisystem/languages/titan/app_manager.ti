#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_app_state_creation() {
        let app = AppState::new("test-app")
        assert_eq!(app.app_id, "test-app")
        assert_eq!(app.state, "created")
        assert_eq!(app.running, false)
    }

    #[test]
    fn test_app_state_mark_installed() {
        let app = AppState::new("test-app")
            .mark_installed()

        assert_eq!(app.state, "installed")
        assert!(app.installed_at.is_some())
    }

    #[test]
    fn test_app_state_mark_running() {
        let app = AppState::new("test-app")
            .mark_running()

        assert_eq!(app.running, true)
    }
}
