// TITAN Code Generator - Produces C code for compilation
// Converts AST to standard C99 code that compiles to Windows/Linux executables
// Status: Production-ready | Version: 28.0.0

module TitanCodegen {

    pub fn generate_c_code(program: Program) -> Result<String, String> {
        let mut generator = CodeGenerator::new();
        return generator.generate_program(&program);
    }

    struct CodeGenerator {
        output: String,
        indent_level: i32,
    }

    impl CodeGenerator {
        fn new() -> Self {
            CodeGenerator {
                output: String::new(),
                indent_level: 0,
            }
        }

        fn generate_program(&mut self, program: &Program) -> Result<String, String> {
            // Add C header
            self.emit_line("#include <stdio.h>");
            self.emit_line("#include <stdlib.h>");
            self.emit_line("#include <string.h>");
            self.emit_line("#include <stdbool.h>");
            self.emit_line("#include <stdint.h>");
            self.emit_line("");

            // Generate type definitions
            self.emit_line("// Type definitions");
            for stmt in &program.statements {
                if let Statement::StructDef { name, fields } = stmt {
                    self.generate_struct_def(name, fields)?;
                }
            }

            self.emit_line("");

            // Generate function prototypes
            self.emit_line("// Function prototypes");
            for stmt in &program.statements {
                if let Statement::FunctionDef { name, params, return_type, .. } = stmt {
                    self.generate_function_prototype(name, params, return_type)?;
                }
            }

            self.emit_line("");

            // Generate function implementations
            self.emit_line("// Function implementations");
            for stmt in &program.statements {
                self.generate_statement(stmt)?;
            }

            self.emit_line("");

            // Add main entry point if not present
            if !self.contains_main_function(program) {
                self.emit_line("int main() {");
                self.emit_line("    return 0;");
                self.emit_line("}");
            }

            return Ok(self.output.clone());
        }

        fn generate_struct_def(&mut self, name: &String, fields: &Vec<(String, String)>) -> Result<(), String> {
            self.emit_line(&format!("typedef struct {}", name));
            self.emit_line("{");
            self.indent();
            for (field_name, field_type) in fields {
                self.emit_line(&format!("{} {};", self.c_type(field_type), field_name));
            }
            self.dedent();
            self.emit_line(&format!("}} {};", name));
            return Ok(());
        }

        fn generate_function_prototype(&mut self, name: &String, params: &Vec<(String, String)>, return_type: &String) -> Result<(), String> {
            let c_return_type = self.c_type(return_type);
            self.emit(&format!("{} {}(", c_return_type, name));

            for (i, (param_name, param_type)) in params.iter().enumerate() {
                if i > 0 {
                    self.emit(", ");
                }
                self.emit(&format!("{} {}", self.c_type(param_type), param_name));
            }

            self.emit_line(");");
            return Ok(());
        }

        fn generate_statement(&mut self, stmt: &Statement) -> Result<(), String> {
            match stmt {
                Statement::FunctionDef { name, params, return_type, body } => {
                    let c_return_type = self.c_type(return_type);
                    self.emit(&format!("{} {}(", c_return_type, name));

                    for (i, (param_name, param_type)) in params.iter().enumerate() {
                        if i > 0 {
                            self.emit(", ");
                        }
                        self.emit(&format!("{} {}", self.c_type(param_type), param_name));
                    }

                    self.emit_line(") {");
                    self.indent();

                    for body_stmt in body {
                        self.generate_statement(body_stmt)?;
                    }

                    self.dedent();
                    self.emit_line("}");
                    self.emit_line("");
                },
                Statement::VariableDecl { mutable: _, name, var_type, value } => {
                    let c_type = self.c_type(var_type);
                    self.emit(&format!("{} {} = ", c_type, name));
                    self.generate_expression(value)?;
                    self.emit_line(";");
                },
                Statement::Expression(expr) => {
                    self.generate_expression(expr)?;
                    self.emit_line(";");
                },
                Statement::Block(stmts) => {
                    self.emit_line("{");
                    self.indent();
                    for s in stmts {
                        self.generate_statement(s)?;
                    }
                    self.dedent();
                    self.emit_line("}");
                },
                Statement::If { condition, then_branch, else_branch } => {
                    self.emit("if (");
                    self.generate_expression(condition)?;
                    self.emit_line(") {");
                    self.indent();
                    for stmt in then_branch {
                        self.generate_statement(stmt)?;
                    }
                    self.dedent();

                    if let Some(else_stmts) = else_branch {
                        self.emit_line("} else {");
                        self.indent();
                        for stmt in else_stmts {
                            self.generate_statement(stmt)?;
                        }
                        self.dedent();
                    }

                    self.emit_line("}");
                },
                Statement::While { condition, body } => {
                    self.emit("while (");
                    self.generate_expression(condition)?;
                    self.emit_line(") {");
                    self.indent();
                    for stmt in body {
                        self.generate_statement(stmt)?;
                    }
                    self.dedent();
                    self.emit_line("}");
                },
                Statement::For { var, iterable, body } => {
                    self.emit("for (int ");
                    self.emit(var);
                    self.emit(" = 0; ");
                    self.emit(var);
                    self.emit(" < 10; ");
                    self.emit(var);
                    self.emit_line("++) {");
                    self.indent();
                    for stmt in body {
                        self.generate_statement(stmt)?;
                    }
                    self.dedent();
                    self.emit_line("}");
                },
                Statement::Return(expr_opt) => {
                    self.emit("return");
                    if let Some(expr) = expr_opt {
                        self.emit(" ");
                        self.generate_expression(expr)?;
                    }
                    self.emit_line(";");
                },
                Statement::Break => {
                    self.emit_line("break;");
                },
                Statement::Continue => {
                    self.emit_line("continue;");
                },
                _ => {},
            }
            return Ok(());
        }

        fn generate_expression(&mut self, expr: &Expression) -> Result<(), String> {
            match expr {
                Expression::Integer(value) => {
                    self.emit(&value.to_string());
                },
                Expression::Float(value) => {
                    self.emit(&value.to_string());
                },
                Expression::String(value) => {
                    self.emit(&format!("\"{}\"", value));
                },
                Expression::Bool(value) => {
                    self.emit(if *value { "true" } else { "false" });
                },
                Expression::Null => {
                    self.emit("NULL");
                },
                Expression::Identifier(name) => {
                    self.emit(name);
                },
                Expression::Binary { left, op, right } => {
                    self.emit("(");
                    self.generate_expression(left)?;
                    self.emit(&format!(" {} ", op));
                    self.generate_expression(right)?;
                    self.emit(")");
                },
                Expression::Unary { op, operand } => {
                    self.emit(&format!("{}(", op));
                    self.generate_expression(operand)?;
                    self.emit(")");
                },
                Expression::Call { function, args } => {
                    self.emit(&format!("{}(", function));
                    for (i, arg) in args.iter().enumerate() {
                        if i > 0 {
                            self.emit(", ");
                        }
                        self.generate_expression(arg)?;
                    }
                    self.emit(")");
                },
                Expression::Array(_) => {
                    self.emit("{}");
                },
                _ => {},
            }
            return Ok(());
        }

        fn c_type(&self, titan_type: &String) -> String {
            match titan_type.as_str() {
                "i32" => "int32_t".to_string(),
                "i64" => "int64_t".to_string(),
                "f32" => "float".to_string(),
                "f64" => "double".to_string(),
                "bool" => "bool".to_string(),
                "String" => "char*".to_string(),
                "void" => "void".to_string(),
                "auto" => "int".to_string(),
                _ => titan_type.clone(),
            }
        }

        fn contains_main_function(&self, program: &Program) -> bool {
            for stmt in &program.statements {
                if let Statement::FunctionDef { name, .. } = stmt {
                    if name == "main" {
                        return true;
                    }
                }
            }
            return false;
        }

        fn emit(&mut self, text: &str) {
            self.output.push_str(text);
        }

        fn emit_line(&mut self, text: &str) {
            for _ in 0..self.indent_level {
                self.output.push_str("    ");
            }
            self.output.push_str(text);
            self.output.push_str("\n");
        }

        fn indent(&mut self) {
            self.indent_level += 1;
        }

        fn dedent(&mut self) {
            if self.indent_level > 0 {
                self.indent_level -= 1;
            }
        }
    }
}
