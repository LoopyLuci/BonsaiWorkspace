#[cfg(test)]
mod advanced_tests {
    use super::*

    #[test]
    fn test_cached_app_manager() {
        let manager = CachedAppManager::new()
        assert_eq!(manager.cache_ttl_ms, 60000)
        assert!(manager.last_list_refresh.is_none())
    }

    #[test]
    fn test_version_validation() {
        assert!(is_valid_version(&"1.0.0"))
        assert!(is_valid_version(&"2.5.10"))
        assert!(!is_valid_version(&"1.0"))
        assert!(!is_valid_version(&"1.a.0"))
    }

    #[test]
    fn test_batch_operations() {
        let batch = AppManagerBatch::new()
            .add_install("app1", "1.0.0")
            .add_install("app2", "2.0.0")
            .add_uninstall("app1")

        assert_eq!(batch.operations.len(), 3)
    }

    #[test]
    fn test_app_status_tracker() {
        let mut tracker = AppStatusTracker::new()

        tracker = tracker.update_status("app1", "installed", true)

        let status = tracker.get_status("app1")
        assert!(status.is_some())
    }

    #[test]
    fn test_is_numeric() {
        assert!(is_numeric(&"123"))
        assert!(is_numeric(&"0"))
        assert!(!is_numeric(&"12a"))
        assert!(!is_numeric(&""))
    }
}
