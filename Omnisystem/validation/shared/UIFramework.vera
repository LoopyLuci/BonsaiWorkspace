// Omnisystem Validation Suite - Shared UI Framework
// React-like component system for all 3 applications

// Base window component
component Window {
    props {
        title: String,
        width: u32,
        height: u32,
        resizable: bool,
        fullscreen: bool
    }

    state {
        is_open: bool,
        is_focused: bool,
        is_minimized: bool,
        is_maximized: bool
    }

    event onClick
    event onResize
    event onClose
    event onFocus
    event onBlur

    render {
        <div class="window" style="width: {width}px; height: {height}px;">
            <div class="title-bar">
                <h1>{title}</h1>
                <button onclick={onClose}>✕</button>
            </div>
            <div class="content">
                {children}
            </div>
        </div>
    }

    style {
        window {
            background: #2a2a2a;
            border: 1px solid #444;
            box-shadow: 0 4px 8px rgba(0,0,0,0.3);
            border-radius: 4px;
        }

        title-bar {
            background: #1a1a1a;
            padding: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #444;
        }

        content {
            padding: 10px;
            background: #2a2a2a;
        }
    }
}

// Panel component for organizing content
component Panel {
    props {
        title: String,
        layout: String,         // "flex", "grid", "masonry"
        padding: u32,
        gap: u32
    }

    state {
        expanded: bool,
        scroll_position: i32
    }

    event onHeaderClick

    render {
        <div class="panel">
            <div class="panel-header" onclick={onHeaderClick}>
                <h3>{title}</h3>
            </div>
            <div class="panel-body" layout={layout}>
                {children}
            </div>
        </div>
    }

    style {
        panel {
            background: #333;
            border: 1px solid #555;
            border-radius: 4px;
            margin-bottom: 10px;
        }

        panel-header {
            background: #252525;
            padding: 10px;
            cursor: pointer;
            border-bottom: 1px solid #555;
        }

        panel-body {
            padding: {padding}px;
            gap: {gap}px;
            display: {layout};
        }
    }
}

// Chart component for data visualization
component Chart {
    props {
        title: String,
        data: Vec<DataPoint>,
        chart_type: String,    // "line", "bar", "candlestick", "heatmap"
        width: u32,
        height: u32,
        x_axis_label: String,
        y_axis_label: String
    }

    state {
        selected_point: Option<DataPoint>,
        zoom_level: f32,
        pan_x: i32,
        pan_y: i32
    }

    event onPointHover(point: DataPoint)
    event onPointClick(point: DataPoint)
    event onZoom(delta: f32)
    event onPan(dx: i32, dy: i32)

    render {
        <div class="chart-container">
            <h3>{title}</h3>
            <svg class="chart" width={width} height={height}>
                {/* Render based on chart_type */}
                {match chart_type {
                    "line" => <g class="line-chart">{render_line_chart()}</g>,
                    "bar" => <g class="bar-chart">{render_bar_chart()}</g>,
                    "candlestick" => <g class="candle-chart">{render_candle_chart()}</g>,
                    _ => <g></g>
                }}
            </svg>
            <div class="chart-legend">
                <p>{x_axis_label}</p>
                <p>{y_axis_label}</p>
            </div>
        </div>
    }

    fn render_line_chart() {
        // Render polyline from data points
        let points_str = data.iter()
            .map(|p| format!("{},{}", p.timestamp_ms, p.value))
            .collect::<Vec<_>>()
            .join(" ");

        return format!("<polyline points=\"{}\" stroke=\"#0f8\" stroke-width=\"2\" fill=\"none\" />", points_str);
    }

    fn render_bar_chart() {
        // Render bars for each data point
        // Would iterate through data and generate <rect> elements
        return "<g></g>";
    }

    fn render_candle_chart() {
        // Render candlestick chart (OHLC)
        return "<g></g>";
    }

    style {
        chart-container {
            padding: 15px;
            background: #2a2a2a;
            border-radius: 4px;
        }

        chart {
            background: #1a1a1a;
            border: 1px solid #444;
            border-radius: 2px;
        }

        chart-legend {
            margin-top: 10px;
            font-size: 12px;
            color: #aaa;
        }
    }
}

// Stats table component
component StatsTable {
    props {
        title: String,
        columns: Vec<String>,
        rows: Vec<Vec<String>>,
        sort_column: u32
    }

    state {
        selected_row: Option<u32>,
        sort_descending: bool
    }

    event onRowClick(row_index: u32)
    event onHeaderClick(column_index: u32)

    render {
        <div class="table-container">
            <h3>{title}</h3>
            <table class="stats-table">
                <thead>
                    <tr>
                        {columns.iter().enumerate().map(|(i, col)| {
                            <th onclick={onHeaderClick(i as u32)}>{col}</th>
                        }).collect::<Vec<_>>()}
                    </tr>
                </thead>
                <tbody>
                    {rows.iter().enumerate().map(|(i, row)| {
                        <tr onclick={onRowClick(i as u32)} class={if selected_row == Some(i as u32) { "selected" } else { "" }}>
                            {row.iter().map(|cell| {
                                <td>{cell}</td>
                            }).collect::<Vec<_>>()}
                        </tr>
                    }).collect::<Vec<_>>()}
                </tbody>
            </table>
        </div>
    }

    style {
        table-container {
            padding: 15px;
            background: #2a2a2a;
            border-radius: 4px;
        }

        stats-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }

        thead {
            background: #1a1a1a;
            border-bottom: 2px solid #0f8;
        }

        th {
            padding: 10px;
            text-align: left;
            cursor: pointer;
            color: #0f8;
            font-weight: bold;
        }

        tbody tr {
            border-bottom: 1px solid #444;
        }

        tbody tr:hover {
            background: #3a3a3a;
        }

        tbody tr.selected {
            background: #0f8;
            color: #000;
        }

        td {
            padding: 8px;
            color: #ddd;
        }
    }
}

// Button component
component Button {
    props {
        label: String,
        variant: String,        // "primary", "secondary", "danger"
        disabled: bool
    }

    event onClick

    render {
        <button class="btn" class={variant} disabled={disabled} onclick={onClick}>
            {label}
        </button>
    }

    style {
        btn {
            padding: 8px 16px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-weight: 500;
            transition: all 0.2s;
        }

        btn.primary {
            background: #0f8;
            color: #000;
        }

        btn.primary:hover {
            background: #0ec;
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,255,136,0.3);
        }

        btn.secondary {
            background: #444;
            color: #fff;
        }

        btn.danger {
            background: #f33;
            color: #fff;
        }

        btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
    }
}

// Input field component
component InputField {
    props {
        label: String,
        placeholder: String,
        input_type: String,    // "text", "number", "password"
        value: String
    }

    state {
        is_focused: bool,
        error_message: String
    }

    event onChange(new_value: String)
    event onFocus
    event onBlur

    render {
        <div class="input-group">
            <label>{label}</label>
            <input
                type={input_type}
                placeholder={placeholder}
                value={value}
                onchange={onChange}
                onfocus={onFocus}
                onblur={onBlur}
                class={if is_focused { "focused" } else { "" }}
            />
            {if error_message.len() > 0 {
                <span class="error">{error_message}</span>
            }}
        </div>
    }

    style {
        input-group {
            margin-bottom: 15px;
        }

        label {
            display: block;
            margin-bottom: 5px;
            color: #aaa;
            font-size: 13px;
        }

        input {
            width: 100%;
            padding: 8px;
            border: 1px solid #444;
            border-radius: 4px;
            background: #1a1a1a;
            color: #ddd;
            font-size: 13px;
        }

        input.focused {
            border-color: #0f8;
            box-shadow: 0 0 8px rgba(0,255,136,0.2);
        }

        error {
            display: block;
            color: #f33;
            font-size: 12px;
            margin-top: 4px;
        }
    }
}

// Status indicator component
component StatusIndicator {
    props {
        status: String,         // "ok", "warning", "error", "busy"
        message: String
    }

    render {
        <div class="status-indicator" class={status}>
            <span class="icon"></span>
            <span class="message">{message}</span>
        </div>
    }

    style {
        status-indicator {
            display: flex;
            align-items: center;
            padding: 8px 12px;
            border-radius: 4px;
            font-size: 13px;
        }

        status-indicator.ok {
            background: rgba(0,255,136,0.1);
            color: #0f8;
        }

        status-indicator.warning {
            background: rgba(255,200,0,0.1);
            color: #fc0;
        }

        status-indicator.error {
            background: rgba(255,50,50,0.1);
            color: #f33;
        }

        status-indicator.busy {
            background: rgba(0,150,255,0.1);
            color: #0af;
            animation: pulse 1s infinite;
        }

        icon {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            margin-right: 8px;
            background: currentColor;
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }
    }
}

// Initialize UI framework
fn initialize_ui_framework() {
    println!("[UI] Omnisystem UI framework initialized");
    println!("[UI] Available components: Window, Panel, Chart, StatsTable, Button, InputField, StatusIndicator");
}
