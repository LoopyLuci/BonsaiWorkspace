// Omnisystem Validation Suite - Common Utilities
// Shared utilities for all 3 validation applications

use std::collections::HashMap;
use std::time::SystemTime;

// JSON value enumeration for simple JSON parsing
#[derive(Clone)]
enum JsonValue {
    Null,
    Bool(bool),
    Number(f64),
    String(String),
    Array(Vec<JsonValue>),
    Object(HashMap<String, JsonValue>)
}

impl JsonValue {
    // Convert to string representation
    fn to_string(&self) -> String {
        match self {
            JsonValue::Null => "null".to_string(),
            JsonValue::Bool(b) => b.to_string(),
            JsonValue::Number(n) => n.to_string(),
            JsonValue::String(s) => format!("\"{}\"", s),
            JsonValue::Array(arr) => {
                let items = arr.iter()
                    .map(|v| v.to_string())
                    .collect::<Vec<_>>()
                    .join(",");
                format!("[{}]", items)
            },
            JsonValue::Object(obj) => {
                let items = obj.iter()
                    .map(|(k, v)| format!("\"{}\":{}", k, v.to_string()))
                    .collect::<Vec<_>>()
                    .join(",");
                format!("{{{}}}", items)
            }
        }
    }

    // Get field from object
    fn get(&self, key: &str) -> Option<JsonValue> {
        match self {
            JsonValue::Object(map) => map.get(key).cloned(),
            _ => None
        }
    }

    // Get array element
    fn at(&self, index: usize) -> Option<JsonValue> {
        match self {
            JsonValue::Array(arr) => arr.get(index).cloned(),
            _ => None
        }
    }
}

// Simple JSON parser
fn parse_json(json_str: &str) -> Result<JsonValue, String> {
    // Simplified parser - would need full implementation
    // For now, basic stub that recognizes common patterns

    let trimmed = json_str.trim();

    if trimmed == "null" {
        return Ok(JsonValue::Null);
    }

    if trimmed == "true" {
        return Ok(JsonValue::Bool(true));
    }

    if trimmed == "false" {
        return Ok(JsonValue::Bool(false));
    }

    if let Ok(num) = trimmed.parse::<f64>() {
        return Ok(JsonValue::Number(num));
    }

    if trimmed.starts_with("\"") && trimmed.ends_with("\"") {
        let s = trimmed[1..trimmed.len()-1].to_string();
        return Ok(JsonValue::String(s));
    }

    if trimmed.starts_with("[") && trimmed.ends_with("]") {
        // Array parsing would go here
        return Ok(JsonValue::Array(Vec::new()));
    }

    if trimmed.starts_with("{") && trimmed.ends_with("}") {
        // Object parsing would go here
        return Ok(JsonValue::Object(HashMap::new()));
    }

    Err(format!("Failed to parse JSON: {}", trimmed))
}

// Time utilities
struct TimeUtils;

impl TimeUtils {
    // Get current time in milliseconds since epoch
    fn now_ms() -> u64 {
        // Would call system timer
        0  // Stub
    }

    // Convert milliseconds to seconds
    fn ms_to_sec(ms: u64) -> f64 {
        (ms as f64) / 1000.0
    }

    // Convert seconds to milliseconds
    fn sec_to_ms(sec: f64) -> u64 {
        (sec * 1000.0) as u64
    }

    // Format milliseconds as HH:MM:SS
    fn format_duration(ms: u64) -> String {
        let seconds = ms / 1000;
        let minutes = seconds / 60;
        let hours = minutes / 60;
        let s = seconds % 60;
        let m = minutes % 60;
        let h = hours % 24;

        format!("{:02}:{:02}:{:02}", h, m, s)
    }
}

// Circular buffer for efficient streaming data storage
struct RingBuffer<T: Clone> {
    data: Vec<T>,
    head: usize,
    tail: usize,
    size: usize,
    max_size: usize
}

impl<T: Clone> RingBuffer<T> {
    fn new(capacity: usize) -> Self {
        RingBuffer {
            data: Vec::with_capacity(capacity),
            head: 0,
            tail: 0,
            size: 0,
            max_size: capacity
        }
    }

    fn push(&mut self, item: T) {
        if self.size < self.max_size {
            self.data.push(item);
            self.size += 1;
        } else {
            // Overwrite oldest element
            self.data[self.head] = item;
            self.head = (self.head + 1) % self.max_size;
        }
    }

    fn is_full(&self) -> bool {
        self.size == self.max_size
    }

    fn is_empty(&self) -> bool {
        self.size == 0
    }

    fn len(&self) -> usize {
        self.size
    }

    fn get(&self, index: usize) -> Option<T> {
        if index >= self.size {
            return None;
        }
        let actual_index = (self.head + index) % self.max_size;
        self.data.get(actual_index).cloned()
    }

    fn clear(&mut self) {
        self.data.clear();
        self.head = 0;
        self.tail = 0;
        self.size = 0;
    }
}

// Statistics calculator
struct Statistics;

impl Statistics {
    // Calculate mean of values
    fn mean(values: &Vec<f64>) -> f64 {
        if values.is_empty() {
            return 0.0;
        }
        let sum: f64 = values.iter().sum();
        sum / (values.len() as f64)
    }

    // Calculate standard deviation
    fn stddev(values: &Vec<f64>) -> f64 {
        if values.len() < 2 {
            return 0.0;
        }
        let mean = Statistics::mean(values);
        let variance: f64 = values.iter()
            .map(|v| (v - mean).powi(2))
            .sum::<f64>() / ((values.len() - 1) as f64);
        variance.sqrt()
    }

    // Calculate percentile
    fn percentile(values: &mut Vec<f64>, p: f32) -> f64 {
        if values.is_empty() {
            return 0.0;
        }
        values.sort_by(|a, b| a.partial_cmp(b).unwrap());
        let index = ((p / 100.0) * (values.len() as f32)) as usize;
        values.get(index.min(values.len() - 1)).copied().unwrap_or(0.0)
    }

    // Calculate min value
    fn min(values: &Vec<f64>) -> f64 {
        values.iter().cloned().fold(f64::INFINITY, f64::min)
    }

    // Calculate max value
    fn max(values: &Vec<f64>) -> f64 {
        values.iter().cloned().fold(f64::NEG_INFINITY, f64::max)
    }
}

// String utilities
fn string_split(s: &str, delimiter: &str) -> Vec<String> {
    s.split(delimiter)
        .map(|part| part.to_string())
        .collect()
}

fn string_join(parts: &Vec<String>, delimiter: &str) -> String {
    parts.join(delimiter)
}

fn string_starts_with(s: &str, prefix: &str) -> bool {
    s.starts_with(prefix)
}

fn string_ends_with(s: &str, suffix: &str) -> bool {
    s.ends_with(suffix)
}

fn string_replace(s: &str, from: &str, to: &str) -> String {
    s.replace(from, to)
}

fn string_trim(s: &str) -> String {
    s.trim().to_string()
}

fn string_to_lowercase(s: &str) -> String {
    s.to_lowercase()
}

fn string_to_uppercase(s: &str) -> String {
    s.to_uppercase()
}

// Vector utilities
fn vec_contains<T: PartialEq>(vec: &Vec<T>, item: &T) -> bool {
    vec.contains(item)
}

fn vec_index_of<T: PartialEq>(vec: &Vec<T>, item: &T) -> Option<usize> {
    vec.iter().position(|x| x == item)
}

fn vec_remove_at<T>(vec: &mut Vec<T>, index: usize) -> Option<T> {
    if index < vec.len() {
        Some(vec.remove(index))
    } else {
        None
    }
}

// File path utilities
fn path_join(base: &str, relative: &str) -> String {
    if base.ends_with("/") || base.ends_with("\\") {
        format!("{}{}", base, relative)
    } else {
        format!("{}/{}", base, relative)
    }
}

fn path_filename(path: &str) -> String {
    path.split('/').last()
        .or_else(|| path.split('\\').last())
        .unwrap_or("")
        .to_string()
}

fn path_dirname(path: &str) -> String {
    path.split('/').next()
        .or_else(|| path.split('\\').next())
        .unwrap_or("")
        .to_string()
}

// Color utilities
struct Color {
    r: u8,
    g: u8,
    b: u8,
    a: u8
}

impl Color {
    fn new(r: u8, g: u8, b: u8) -> Self {
        Color { r, g, b, a: 255 }
    }

    fn with_alpha(r: u8, g: u8, b: u8, a: u8) -> Self {
        Color { r, g, b, a }
    }

    fn from_hex(hex: u32) -> Self {
        Color {
            r: ((hex >> 16) & 0xFF) as u8,
            g: ((hex >> 8) & 0xFF) as u8,
            b: (hex & 0xFF) as u8,
            a: 255
        }
    }

    fn to_hex(&self) -> u32 {
        ((self.r as u32) << 16) | ((self.g as u32) << 8) | (self.b as u32)
    }

    fn to_rgba(&self) -> u32 {
        ((self.r as u32) << 24) | ((self.g as u32) << 16) | ((self.b as u32) << 8) | (self.a as u32)
    }

    fn lerp(&self, other: &Color, t: f32) -> Color {
        let t = t.clamp(0.0, 1.0);
        Color {
            r: (self.r as f32 * (1.0 - t) + other.r as f32 * t) as u8,
            g: (self.g as f32 * (1.0 - t) + other.g as f32 * t) as u8,
            b: (self.b as f32 * (1.0 - t) + other.b as f32 * t) as u8,
            a: (self.a as f32 * (1.0 - t) + other.a as f32 * t) as u8
        }
    }
}

