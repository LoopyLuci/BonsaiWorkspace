fn main() {
    let config = Config::default();
    let mut editor = GraphicsEditor::new(config);
    editor.run(10);  // Run for 10 seconds
}

#[test]
fn test_editor_initialization() {
    let config = Config::default();
    let mut editor = GraphicsEditor::new(config);
    editor.initialize();
    assert!(editor.is_running);
    assert!(editor.scene.get_node_count() > 0);
}

#[test]
fn test_scene_graph() {
    let mut scene = SceneGraph::new();
    let node1 = scene.add_node("Test1".to_string(), "mesh".to_string());
    let node2 = scene.add_node("Test2".to_string(), "mesh".to_string());
    assert!(scene.get_node_count() >= 3);  // root + 2 nodes
}
