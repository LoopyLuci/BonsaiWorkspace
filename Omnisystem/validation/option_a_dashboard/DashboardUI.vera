// Option A: Real-Time Data Dashboard - UI Components
// VERA: React-like dashboard interface

// Main dashboard window
component DashboardWindow {
    props {
        title: String
    }

    state {
        selected_asset: String,
        selected_timeframe: String
    }

    event onAssetChange(asset: String)
    event onTimeframeChange(timeframe: String)

    render {
        <Window title={title}>
            <div class="dashboard-container">
                <ControlPanel
                    onAssetChange={onAssetChange}
                    onTimeframeChange={onTimeframeChange}
                />
                <div class="main-content">
                    <ChartPanel asset={selected_asset} timeframe={selected_timeframe} />
                    <div class="bottom-row">
                        <StatsPanel />
                        <SignalPanel />
                    </div>
                </div>
            </div>
        </Window>
    }

    style {
        dashboard-container {
            display: flex;
            flex-direction: column;
            height: 100%;
            gap: 10px;
        }

        main-content {
            display: flex;
            flex-direction: column;
            flex: 1;
            gap: 10px;
        }

        bottom-row {
            display: flex;
            gap: 10px;
            height: 30%;
        }
    }
}

// Control panel for asset and timeframe selection
component ControlPanel {
    props {
        assets: Vec<String>,
        timeframes: Vec<String>
    }

    state {
        selected_asset: String,
        selected_timeframe: String
    }

    event onAssetChange(asset: String)
    event onTimeframeChange(timeframe: String)

    render {
        <Panel title="Controls" layout="flex">
            <div class="controls">
                <div class="control-group">
                    <label>Asset</label>
                    <select onchange={onAssetChange}>
                        <option>BTC/USD</option>
                        <option>ETH/USD</option>
                        <option>SOL/USD</option>
                        <option>ADA/USD</option>
                    </select>
                </div>

                <div class="control-group">
                    <label>Timeframe</label>
                    <select onchange={onTimeframeChange}>
                        <option>1m</option>
                        <option>5m</option>
                        <option>15m</option>
                        <option>1h</option>
                        <option>4h</option>
                        <option>1d</option>
                    </select>
                </div>

                <div class="control-group">
                    <Button label="Refresh" variant="primary" />
                    <Button label="Export" variant="secondary" />
                </div>
            </div>
        </Panel>
    }

    style {
        controls {
            display: flex;
            gap: 15px;
            align-items: center;
        }

        control-group {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        label {
            font-size: 12px;
            color: #aaa;
        }

        select {
            padding: 8px;
            background: #1a1a1a;
            border: 1px solid #444;
            color: #ddd;
            border-radius: 4px;
            cursor: pointer;
        }
    }
}

// Main candlestick chart with indicators
component ChartPanel {
    props {
        asset: String,
        timeframe: String,
        width: u32,
        height: u32
    }

    state {
        zoom_level: f32,
        pan_offset: i32,
        data_points: Vec<DataPoint>,
        indicators_visible: Vec<String>
    }

    event onZoom(delta: f32)
    event onPan(dx: i32)
    event onIndicatorToggle(indicator: String)

    render {
        <Panel title={format!("Chart - {} ({})", asset, timeframe)} layout="flex">
            <div class="chart-controls">
                <button onclick={onIndicatorToggle("sma20")}>SMA 20</button>
                <button onclick={onIndicatorToggle("sma50")}>SMA 50</button>
                <button onclick={onIndicatorToggle("bollinger")}>Bollinger</button>
                <button onclick={onIndicatorToggle("volume")}>Volume</button>
                <input type="range" min="0.1" max="5.0" value={zoom_level} onchange={onZoom} />
            </div>

            <Chart
                chart_type="candlestick"
                data={data_points}
                width={width}
                height={height}
                x_axis_label="Time"
                y_axis_label={format!("Price ({})", asset)}
            />

            <div class="chart-info">
                <StatusIndicator status="ok" message="Live - 10,000 candles visible" />
            </div>
        </Panel>
    }

    style {
        chart-controls {
            display: flex;
            gap: 10px;
            margin-bottom: 10px;
            align-items: center;
        }

        chart-controls button {
            padding: 6px 12px;
            background: #444;
            border: 1px solid #666;
            color: #ddd;
            border-radius: 4px;
            cursor: pointer;
            font-size: 12px;
        }

        chart-controls button:hover {
            background: #555;
        }

        chart-controls input {
            flex: 1;
            height: 20px;
        }

        chart-info {
            margin-top: 10px;
        }
    }
}

// Statistics panel showing technical indicators
component StatsPanel {
    props {
        indicators: TechnicalIndicators
    }

    render {
        <Panel title="Technical Analysis" layout="grid">
            <StatItem label="Current Price" value="$45,234.50" />
            <StatItem label="SMA 20" value="$45,012.30" />
            <StatItem label="SMA 50" value="$44,856.20" />
            <StatItem label="SMA 200" value="$44,120.10" />

            <StatItem label="Bollinger Upper" value="$46,234.50" change="+2.3%" />
            <StatItem label="Bollinger Middle" value="$45,234.50" change="0.0%" />
            <StatItem label="Bollinger Lower" value="$44,234.50" change="-2.3%" />

            <StatItem label="RSI (14)" value="65.2" status="overbought" />
            <StatItem label="MACD" value="245.30" status="bullish" />
            <StatItem label="Volume (24h)" value="28.5B" />
        </Panel>
    }

    style {
        panel {
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
        }
    }
}

// AI signal and recommendation panel
component SignalPanel {
    props {
        prediction: Prediction
    }

    render {
        <Panel title="AI Prediction" layout="flex">
            <div class="signal-container">
                <div class="prediction-section">
                    <h3>Price Direction</h3>
                    <div class="direction-display" class={prediction.direction}>
                        {prediction.direction.to_uppercase()}
                    </div>
                    <p>Confidence: {(prediction.confidence * 100.0).to_string()}%</p>
                </div>

                <div class="recommendation-section">
                    <h3>Trading Signal</h3>
                    <div class="signal-display">
                        <StatusIndicator status="ok" message="MACD: BULLISH" />
                        <StatusIndicator status="warning" message="RSI: OVERBOUGHT" />
                        <StatusIndicator status="ok" message="Trend: UP" />
                    </div>
                </div>

                <div class="disclaimer">
                    <p style="font-size: 11px; color: #666;">
                        ⚠️ Not financial advice. Past performance does not guarantee future results.
                    </p>
                </div>
            </div>
        </Panel>
    }

    style {
        signal-container {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        prediction-section {
            border: 1px solid #444;
            padding: 10px;
            border-radius: 4px;
        }

        direction-display {
            font-size: 24px;
            font-weight: bold;
            padding: 10px;
            border-radius: 4px;
            text-align: center;
            margin: 10px 0;
        }

        direction-display.up {
            background: rgba(0,255,0,0.1);
            color: #0f8;
        }

        direction-display.down {
            background: rgba(255,0,0,0.1);
            color: #f33;
        }

        direction-display.stable {
            background: rgba(255,200,0,0.1);
            color: #fc0;
        }

        recommendation-section {
            border: 1px solid #444;
            padding: 10px;
            border-radius: 4px;
        }

        signal-display {
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-top: 10px;
        }

        disclaimer {
            color: #666;
            font-size: 11px;
            border-top: 1px solid #444;
            padding-top: 10px;
        }
    }
}

// Individual statistic item
component StatItem {
    props {
        label: String,
        value: String,
        change: Option<String>,
        status: Option<String>
    }

    render {
        <div class="stat-item">
            <div class="label">{label}</div>
            <div class="value" class={status.unwrap_or("neutral")}>{value}</div>
            {if let Some(change_str) = change {
                <div class="change" class={if change_str.starts_with("+") { "positive" } else { "negative" }}>
                    {change_str}
                </div>
            }}
        </div>
    }

    style {
        stat-item {
            background: #1a1a1a;
            padding: 10px;
            border-radius: 4px;
            border-left: 3px solid #444;
        }

        label {
            font-size: 11px;
            color: #888;
            text-transform: uppercase;
        }

        value {
            font-size: 16px;
            font-weight: bold;
            color: #ddd;
            margin: 5px 0;
        }

        value.overbought {
            color: #f33;
        }

        value.oversold {
            color: #0f8;
        }

        value.bullish {
            color: #0f8;
        }

        value.bearish {
            color: #f33;
        }

        change {
            font-size: 12px;
            margin-top: 5px;
        }

        change.positive {
            color: #0f8;
        }

        change.negative {
            color: #f33;
        }
    }
}

fn initialize_dashboard_ui() {
    println!("[DashboardUI] Initializing dashboard interface");
    println!("[DashboardUI] Components: DashboardWindow, ChartPanel, StatsPanel, SignalPanel");
    println!("[DashboardUI] Dashboard ready for display");
}
