// Option A: Real-Time Data Dashboard - GPU Rendering Pipeline
// HELIX: GPU-accelerated candlestick and indicator visualization

// Vertex shader for candlestick rendering
shader vertex CandleVertexShader {
    inputs {
        position: vec3,
        color: vec4,
        candle_width: float,
        open: float,
        high: float,
        low: float,
        close: float
    }

    outputs {
        v_color: vec4,
        v_position: vec3,
        v_open: float,
        v_high: float,
        v_low: float,
        v_close: float
    }

    uniforms {
        mvp: mat4,
        screen_width: float,
        screen_height: float,
        price_scale: float,
        time_scale: float
    }

    code {
        void main() {
            // Transform to world space
            vec4 world_pos = vec4(position, 1.0);

            // Scale by price (Y axis)
            world_pos.y = world_pos.y * price_scale;

            // Apply MVP transform
            gl_Position = mvp * world_pos;

            // Pass data to fragment shader
            v_color = color;
            v_position = position;
            v_open = open * price_scale;
            v_high = high * price_scale;
            v_low = low * price_scale;
            v_close = close * price_scale;
        }
    }
}

// Fragment shader for candlestick coloring
shader fragment CandleFragmentShader {
    inputs {
        v_color: vec4,
        v_position: vec3,
        v_open: float,
        v_high: float,
        v_low: float,
        v_close: float
    }

    outputs {
        out_color: vec4
    }

    uniforms {
        bull_color: vec4,    // Green for up
        bear_color: vec4     // Red for down
    }

    code {
        void main() {
            // Determine candle color based on open/close
            vec4 color = (v_close > v_open) ? bull_color : bear_color;

            // Add some shading based on position
            float brightness = 0.5 + 0.5 * sin(v_position.x);
            out_color = color * brightness;
        }
    }
}

// Compute shader for moving average line calculation
shader compute MovingAverageLine {
    inputs {
        price_buffer: RWBuffer<float>,
        period: uint
    }

    outputs {
        ma_buffer: RWBuffer<float>
    }

    code {
        [numthreads(256, 1, 1)]
        void main(uint3 thread_id : SV_DispatchThreadID) {
            uint idx = thread_id.x;
            if (idx < period) return;

            float sum = 0.0;
            for (uint i = idx - period; i < idx; i++) {
                sum += price_buffer[i];
            }

            ma_buffer[idx] = sum / float(period);
        }
    }
}

// Compute shader for Bollinger Bands
shader compute BollingerBands {
    inputs {
        price_buffer: RWBuffer<float>,
        period: uint,
        num_stddev: float
    }

    outputs {
        upper_buffer: RWBuffer<float>,
        middle_buffer: RWBuffer<float>,
        lower_buffer: RWBuffer<float>
    }

    code {
        [numthreads(256, 1, 1)]
        void main(uint3 thread_id : SV_DispatchThreadID) {
            uint idx = thread_id.x;
            if (idx < period) return;

            // Calculate mean
            float sum = 0.0;
            for (uint i = idx - period; i < idx; i++) {
                sum += price_buffer[i];
            }
            float mean = sum / float(period);

            // Calculate variance
            float variance = 0.0;
            for (uint i = idx - period; i < idx; i++) {
                float diff = price_buffer[i] - mean;
                variance += diff * diff;
            }
            variance /= float(period);
            float stddev = sqrt(variance);

            // Store bands
            middle_buffer[idx] = mean;
            upper_buffer[idx] = mean + (num_stddev * stddev);
            lower_buffer[idx] = mean - (num_stddev * stddev);
        }
    }
}

// GPU rendering pipeline
pipeline CandlestickRenderPipeline {
    stages {
        vertex: CandleVertexShader,
        fragment: CandleFragmentShader
    }

    render_targets {
        target_0: RGBA8,
        depth: Depth32F
    }

    blend_state {
        enabled: true,
        src_blend: SrcAlpha,
        dst_blend: OneMinusSrcAlpha
    }

    depth_state {
        enabled: true,
        write_enabled: true,
        comparison: Less
    }

    rasterizer_state {
        fill_mode: Solid,
        cull_mode: Back
    }
}

// Compute pipeline for analytics
pipeline AnalyticsPipeline {
    compute_stages {
        stage_0: MovingAverageLine,
        stage_1: BollingerBands
    }

    resources {
        price_buffer: shared,
        ma_buffer: shared,
        bollinger_buffers: shared
    }
}

// Candlestick rendering system
struct CandleRenderer {
