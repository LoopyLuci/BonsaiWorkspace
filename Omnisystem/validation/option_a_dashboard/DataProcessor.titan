// Option A: Data Dashboard - Real-Time Analytics Processing
// TITAN: Technical analysis calculations (MA, Bollinger, RSI, MACD)

use validation::shared::CoreTypes::*;
use validation::shared::CommonUtils::*;

// Technical analysis indicators
struct TechnicalIndicators {
    sma_20: f64,
    sma_50: f64,
    sma_200: f64,
    bollinger_upper: f64,
    bollinger_middle: f64,
    bollinger_lower: f64,
    rsi_14: f64,
    macd_line: f64,
    signal_line: f64,
    macd_histogram: f64
}

impl TechnicalIndicators {
    fn new() -> Self {
        TechnicalIndicators {
            sma_20: 0.0,
            sma_50: 0.0,
            sma_200: 0.0,
            bollinger_upper: 0.0,
            bollinger_middle: 0.0,
            bollinger_lower: 0.0,
            rsi_14: 0.0,
            macd_line: 0.0,
            signal_line: 0.0,
            macd_histogram: 0.0
        }
    }
}

// Real-time analytics processor
struct DataProcessor {
    price_history: Vec<f64>,
    max_history_size: usize,
    indicators: TechnicalIndicators,
    last_update_time: u64,
    update_count: u64
}

impl DataProcessor {
    fn new(history_size: usize) -> Self {
        DataProcessor {
            price_history: Vec::with_capacity(history_size),
            max_history_size: history_size,
            indicators: TechnicalIndicators::new(),
            last_update_time: 0,
            update_count: 0
        }
    }

    // Add new price point and recalculate indicators
    fn process_price(&mut self, price: f64) {
        self.price_history.push(price);

        // Keep history bounded
        if self.price_history.len() > self.max_history_size {
            self.price_history.remove(0);
        }

        // Recalculate all indicators
        self.recalculate_indicators();
        self.update_count = self.update_count + 1;
    }

    // Recalculate all technical indicators
    fn recalculate_indicators(&mut self) {
        if self.price_history.is_empty() {
            return;
        }

        // Calculate moving averages
        self.indicators.sma_20 = self.calculate_sma(20);
        self.indicators.sma_50 = self.calculate_sma(50);
        self.indicators.sma_200 = self.calculate_sma(200);

        // Calculate Bollinger Bands
        let (upper, middle, lower) = self.calculate_bollinger_bands(20);
        self.indicators.bollinger_upper = upper;
        self.indicators.bollinger_middle = middle;
        self.indicators.bollinger_lower = lower;

        // Calculate RSI
        self.indicators.rsi_14 = self.calculate_rsi(14);

        // Calculate MACD
        let (macd, signal) = self.calculate_macd();
        self.indicators.macd_line = macd;
        self.indicators.signal_line = signal;
        self.indicators.macd_histogram = macd - signal;
    }

    // Simple Moving Average
    fn calculate_sma(&self, period: usize) -> f64 {
        let len = self.price_history.len();
        if len < period {
            return 0.0;
        }

        let start = len - period;
        let slice = &self.price_history[start..len];

        let sum: f64 = slice.iter().sum();
        sum / (period as f64)
    }

    // Bollinger Bands (20-period, 2 std devs)
    fn calculate_bollinger_bands(&self, period: usize) -> (f64, f64, f64) {
        let middle = self.calculate_sma(period);

        if middle == 0.0 {
            return (0.0, 0.0, 0.0);
        }

        let len = self.price_history.len();
        if len < period {
            return (0.0, 0.0, 0.0);
        }

        let start = len - period;
        let slice = &self.price_history[start..len];

        // Calculate standard deviation
        let variance: f64 = slice.iter()
            .map(|&p| (p - middle) * (p - middle))
            .sum::<f64>() / (period as f64);
        let stddev = variance.sqrt();

        let upper = middle + (2.0 * stddev);
        let lower = middle - (2.0 * stddev);

        (upper, middle, lower)
    }

    // Relative Strength Index
    fn calculate_rsi(&self, period: usize) -> f64 {
        let len = self.price_history.len();
        if len < period + 1 {
            return 50.0;  // Neutral
        }

        let mut gains = 0.0;
        let mut losses = 0.0;

        for i in (len - period)..len {
            let change = self.price_history[i] - self.price_history[i - 1];
            if change > 0.0 {
                gains += change;
            } else {
                losses -= change;  // losses are positive
            }
        }

        let avg_gain = gains / (period as f64);
        let avg_loss = losses / (period as f64);

        if avg_loss == 0.0 {
            return 100.0;
        }

        let rs = avg_gain / avg_loss;
        100.0 - (100.0 / (1.0 + rs))
    }

    // MACD (Moving Average Convergence Divergence)
    fn calculate_macd(&self) -> (f64, f64) {
        let ema_12 = self.calculate_ema(12);
        let ema_26 = self.calculate_ema(26);
        let macd_line = ema_12 - ema_26;

        // Signal line is 9-period EMA of MACD
        let signal = 0.0;  // Simplified

        (macd_line, signal)
    }

    // Exponential Moving Average
    fn calculate_ema(&self, period: usize) -> f64 {
        let len = self.price_history.len();
        if len < period {
            return 0.0;
        }

        let multiplier = 2.0 / ((period as f64) + 1.0);
        let sma = self.calculate_sma(period);

        // Simplified EMA calculation
        sma  // In reality, would iterate with multiplier
    }

    // Get current indicators
    fn get_indicators(&self) -> &TechnicalIndicators {
        &self.indicators
    }

    // Print current state
    fn print_stats(&self) {
        if self.price_history.is_empty() {
            return;
        }

        let current_price = self.price_history[self.price_history.len() - 1];

        println!("[DataProcessor] Update #{}", self.update_count);
        println!("  Current Price: ${:.2}", current_price);
        println!("  Moving Averages: 20=${:.2} 50=${:.2} 200=${:.2}",
            self.indicators.sma_20,
            self.indicators.sma_50,
            self.indicators.sma_200);
        println!("  Bollinger Bands: ${:.2} - ${:.2} - ${:.2}",
            self.indicators.bollinger_lower,
            self.indicators.bollinger_middle,
            self.indicators.bollinger_upper);
        println!("  RSI(14): {:.2}", self.indicators.rsi_14);
        println!("  MACD: {:.4} | Signal: {:.4} | Histogram: {:.4}",
            self.indicators.macd_line,
            self.indicators.signal_line,
            self.indicators.macd_histogram);
    }
}

// Signal generator based on technical analysis
struct SignalGenerator;

impl SignalGenerator {
    fn generate_signal(indicators: &TechnicalIndicators, current_price: f64) -> String {
        let mut signals = Vec::new();

        // Bollinger Bands signal
        if current_price < indicators.bollinger_lower {
            signals.push("BB_OVERSOLD");
        }
        if current_price > indicators.bollinger_upper {
            signals.push("BB_OVERBOUGHT");
        }

        // RSI signal
        if indicators.rsi_14 < 30.0 {
            signals.push("RSI_OVERSOLD");
        }
        if indicators.rsi_14 > 70.0 {
            signals.push("RSI_OVERBOUGHT");
        }

        // MACD signal
        if indicators.macd_histogram > 0.0 {
            signals.push("MACD_BULLISH");
        } else {
            signals.push("MACD_BEARISH");
        }

        // Moving average signal
        if current_price > indicators.sma_20 {
            signals.push("PRICE_ABOVE_MA20");
        }

        if signals.is_empty() {
            "NEUTRAL".to_string()
        } else {
            signals.join(",")
        }
    }

    fn generate_recommendation(indicators: &TechnicalIndicators) -> &'static str {
        let oversold = indicators.rsi_14 < 30.0;
        let overbought = indicators.rsi_14 > 70.0;
        let macd_bullish = indicators.macd_histogram > 0.0;

        if oversold && macd_bullish {
            "STRONG_BUY"
        } else if overbought && !macd_bullish {
            "STRONG_SELL"
        } else if oversold {
            "BUY"
        } else if overbought {
            "SELL"
        } else {
            "HOLD"
        }
    }
}

// Test function
fn test_data_processor() {
    println!("[Test] Testing DataProcessor");

    let mut processor = DataProcessor::new(500);

    // Generate test prices
    let prices = vec![
        100.0, 101.0, 100.5, 101.5, 102.0, 101.8, 101.2, 100.8,
        101.0, 101.5, 102.0, 102.5, 103.0, 102.8, 102.5, 102.0
    ];

    for price in prices {
        processor.process_price(price);
    }

    processor.print_stats();

    let current_price = 102.0;
    let signal = SignalGenerator::generate_signal(&processor.indicators, current_price);
    let recommendation = SignalGenerator::generate_recommendation(&processor.indicators);

    println!("[Test] Signal: {} | Recommendation: {}", signal, recommendation);
    println!("[Test] DataProcessor test complete");
}

fn initialize_data_processor() {
    println!("[DataProcessor] Initialized - ready for real-time analytics");
}
