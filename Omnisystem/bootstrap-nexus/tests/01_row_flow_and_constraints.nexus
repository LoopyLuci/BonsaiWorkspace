// @ expect-stdout: constrain Sidebar.width + Content.width == Main.width -> OK (800.0 == 800.0)
// @ expect-stdout: constrain Sidebar.height == Content.height -> OK (600.0 == 600.0)
// @ expect-stdout: Sidebar { x=0.0 y=0.0 width=200.0 height=600.0 }
// @ expect-stdout: Content { x=200.0 y=0.0 width=600.0 height=600.0 }
// @ expect-stdout: Main { width=800.0 height=600.0 }
// @ expect-exit: 0
box Sidebar {
  width: 200
}

box Content {
  width: Main.width - Sidebar.width
}

layout Main {
  width: 800
  height: 600
  direction: row
  children: [Sidebar, Content]
}

constrain Sidebar.width + Content.width == Main.width
constrain Sidebar.height == Content.height
