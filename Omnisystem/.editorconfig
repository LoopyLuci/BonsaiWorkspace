# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# All files
[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown files
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# YAML files
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# JSON files
[*.json]
indent_style = space
indent_size = 2

# TOML files (Cargo.toml, etc.)
[*.toml]
indent_style = space
indent_size = 2

# Rust files
[*.rs]
indent_style = space
indent_size = 4
max_line_length = 100

# Titan language files
[*.titan]
indent_style = space
indent_size = 4
max_line_length = 100

# VERA language files
[*.vera]
indent_style = space
indent_size = 4
max_line_length = 100

# HELIX language files
[*.helix]
indent_style = space
indent_size = 4
max_line_length = 100

# AETHER language files
[*.aether]
indent_style = space
indent_size = 4
max_line_length = 100

# AXIOM language files
[*.axiom]
indent_style = space
indent_size = 4
max_line_length = 100

# SYLVA language files
[*.sylva]
indent_style = space
indent_size = 4
max_line_length = 100

# NEXUS language files
[*.nexus]
indent_style = space
indent_size = 4
max_line_length = 100

# Python files
[*.py]
indent_style = space
indent_size = 4
max_line_length = 100

# JavaScript/TypeScript files
[*.{js,jsx,ts,tsx}]
indent_style = space
indent_size = 2
max_line_length = 100

# Shell script files
[*.{sh,bash,zsh}]
indent_style = space
indent_size = 2

# PowerShell files
[*.ps1]
indent_style = space
indent_size = 4

# C/C++ files (if any)
[*.{c,cpp,cc,cxx,h,hpp}]
indent_style = space
indent_size = 4
max_line_length = 100

# Make files
[Makefile]
indent_style = tab

# Dockerfile
[Dockerfile]
indent_style = space
indent_size = 2

# Docker Compose
[docker-compose.yml]
indent_style = space
indent_size = 2
