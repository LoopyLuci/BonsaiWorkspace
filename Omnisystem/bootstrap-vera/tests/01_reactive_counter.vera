// @ expect-stdout: <div class=counter>
// @ expect-stdout:   <span>
// @ expect-stdout:     5
// @ expect-stdout:   </span>
// @ expect-stdout:   <span>
// @ expect-stdout:     10
// @ expect-stdout:   </span>
// @ expect-stdout: </div>
// @ expect-stdout: <div class=counter>
// @ expect-stdout:   <span>
// @ expect-stdout:     7
// @ expect-stdout:   </span>
// @ expect-stdout:   <span>
// @ expect-stdout:     14
// @ expect-stdout:   </span>
// @ expect-stdout: </div>
// @ expect-stdout: <div class=counter>
// @ expect-stdout:   <span>
// @ expect-stdout:     6
// @ expect-stdout:   </span>
// @ expect-stdout:   <span>
// @ expect-stdout:     12
// @ expect-stdout:   </span>
// @ expect-stdout: </div>
component Counter(initial) {
  state count = initial
  computed doubled = count * 2

  fn increment() {
    count = count + 1
  }

  fn decrement() {
    count = count - 1
  }

  render {
    <div class="counter">
      <span>{count}</span>
      <span>{doubled}</span>
    </div>
  }
}

c = mount(Counter, 5)
puts(render(c))

c.increment()
c.increment()
puts(render(c))

c.decrement()
puts(render(c))
