component Badge(label) {
  render {
    <span class="badge">{label}</span>
  }
}

component List(items) {
  render {
    <ul>
      {for item in items {
        <li>{item}</li>
      }}
    </ul>
  }
}

component App(name) {
  state visible = true

  fn toggle() {
    visible = not visible
  }

  render {
    <div>
      <Badge label={name}/>
      {if visible {
        <p>"shown"</p>
      } else {
        <p>"hidden"</p>
      }}
      <List items={[1, 2, 3]}/>
    </div>
  }
}

a = mount(App, "demo")
puts(render(a))
a.toggle()
puts(render(a))
