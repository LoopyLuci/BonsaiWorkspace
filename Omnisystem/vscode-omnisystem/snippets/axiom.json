{
  "Full theorem": {
    "prefix": "theorem",
    "body": [
      "theorem ${1:TheoremName} {",
      "\tpreconditions {",
      "\t\t${2:condition}: ${3:assertion},",
      "\t}",
      "",
      "\tpostconditions {",
      "\t\t${4:result}: ${5:assertion},",
      "\t}",
      "",
      "\tinvariants {",
      "\t\t${0}",
      "\t}",
      "}"
    ],
    "description": "Full theorem with preconditions, postconditions, and invariants"
  },
  "Simple theorem": {
    "prefix": "thm",
    "body": [
      "theorem ${1:TheoremName} {",
      "\tpreconditions {",
      "\t\t${2:pre}: ${3:expression},",
      "\t}",
      "\tpostconditions {",
      "\t\t${4:post}: ${5:expression},",
      "\t}",
      "}"
    ],
    "description": "Theorem with pre and postconditions"
  },
  "Preconditions block": {
    "prefix": "pre",
    "body": [
      "preconditions {",
      "\t${1:name}: ${2:assertion},",
      "\t${0}",
      "}"
    ],
    "description": "Preconditions block"
  },
  "Postconditions block": {
    "prefix": "post",
    "body": [
      "postconditions {",
      "\t${1:name}: ${2:assertion},",
      "\t${0}",
      "}"
    ],
    "description": "Postconditions block"
  },
  "Invariants block": {
    "prefix": "inv",
    "body": [
      "invariants {",
      "\t${1:name}: ${2:assertion},",
      "\t${0}",
      "}"
    ],
    "description": "Invariants block"
  },
  "Assertions block": {
    "prefix": "assert",
    "body": [
      "assertions {",
      "\t${1:name}: ${2:expression},",
      "\t${0}",
      "}"
    ],
    "description": "Assertions block"
  },
  "For all quantifier": {
    "prefix": "forall",
    "body": [
      "for_all ${1:x} in ${2:domain}: ${0}"
    ],
    "description": "Universal quantifier (for all)"
  },
  "There exists quantifier": {
    "prefix": "exists",
    "body": [
      "there_exists ${1:x} in ${2:domain}: ${0}"
    ],
    "description": "Existential quantifier (there exists)"
  },
  "Implies": {
    "prefix": "implies",
    "body": [
      "${1:A} implies ${2:B}"
    ],
    "description": "Logical implication"
  },
  "Iff": {
    "prefix": "iff",
    "body": [
      "${1:A} iff ${2:B}"
    ],
    "description": "If and only if (biconditional)"
  },
  "Verify call": {
    "prefix": "verify",
    "body": [
      "verify ${1:TheoremName}();"
    ],
    "description": "Verify a theorem"
  },
  "Prove call": {
    "prefix": "prove",
    "body": [
      "prove ${1:TheoremName}();"
    ],
    "description": "Prove a theorem"
  },
  "Function with contract": {
    "prefix": "fncontract",
    "body": [
      "fn ${1:function_name}(${2:params}) -> ${3:ReturnType}",
      "\t#[requires(${4:precondition})]",
      "\t#[ensures(${5:postcondition})]",
      "{",
      "\t${0}",
      "}"
    ],
    "description": "Function with pre/postcondition contracts"
  }
}
