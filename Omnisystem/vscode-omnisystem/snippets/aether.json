{
  "Full actor": {
    "prefix": "actor",
    "body": [
      "actor ${1:ActorName} {",
      "\tmessage ${2:MessageType} {",
      "\t\t${3:payload}: ${4:String},",
      "\t}",
      "",
      "\thandler ${2:MessageType}(msg) {",
      "\t\t${0}",
      "\t}",
      "}"
    ],
    "description": "Full actor boilerplate with message and handler"
  },
  "Actor with state": {
    "prefix": "actors",
    "body": [
      "actor ${1:ActorName} {",
      "\t// Actor state fields",
      "\t${2:state_field}: ${3:StateType},",
      "",
      "\tmessage ${4:MessageType} {",
      "\t\t${5:field}: ${6:Type},",
      "\t}",
      "",
      "\thandler ${4:MessageType}(msg) {",
      "\t\t${0}",
      "\t}",
      "}"
    ],
    "description": "Actor with state fields"
  },
  "Message declaration": {
    "prefix": "message",
    "body": [
      "message ${1:MessageName} {",
      "\t${2:field}: ${3:Type},",
      "\t${0}",
      "}"
    ],
    "description": "Message type declaration"
  },
  "Handler declaration": {
    "prefix": "handler",
    "body": [
      "handler ${1:MessageName}(${2:msg}) {",
      "\t${0}",
      "}"
    ],
    "description": "Message handler function"
  },
  "Spawn actor": {
    "prefix": "spawn",
    "body": [
      "let ${1:actor_ref} = spawn ${2:ActorName};"
    ],
    "description": "Spawn an actor and get a reference"
  },
  "Send message": {
    "prefix": "send",
    "body": [
      "${1:actor_ref}.send(${2:MessageName} { ${3:field}: ${4:value} });"
    ],
    "description": "Send a message to an actor"
  },
  "Spawn and send": {
    "prefix": "spawndo",
    "body": [
      "let ${1:actor_ref} = spawn ${2:ActorName};",
      "${1:actor_ref}.send(${3:MessageName} { ${0} });"
    ],
    "description": "Spawn actor and immediately send a message"
  },
  "Yield now": {
    "prefix": "yield",
    "body": [
      "yield_now();"
    ],
    "description": "Yield execution to the event loop"
  },
  "Run event loop": {
    "prefix": "eventloop",
    "body": [
      "run_event_loop();"
    ],
    "description": "Run the actor event loop"
  }
}
