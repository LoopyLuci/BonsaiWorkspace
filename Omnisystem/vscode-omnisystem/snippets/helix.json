{
  "Pipeline": {
    "prefix": "pipeline",
    "body": [
      "pipeline ${1:PipelineName} {",
      "\tuniforms {",
      "\t\t${2:uniform_name}: ${3:Type},",
      "\t}",
      "",
      "\tshader vertex ${4:vert_main} {",
      "\t\tinputs {",
      "\t\t\tposition: vec4,",
      "\t\t\tuv: vec2,",
      "\t\t}",
      "\t\toutputs {",
      "\t\t\tclip_position: vec4,",
      "\t\t\ttex_coords: vec2,",
      "\t\t}",
      "\t\t${0}",
      "\t}",
      "",
      "\tshader fragment ${5:frag_main} {",
      "\t\tinputs {",
      "\t\t\ttex_coords: vec2,",
      "\t\t}",
      "\t\toutputs {",
      "\t\t\tcolor: vec4,",
      "\t\t}",
      "\t}",
      "}"
    ],
    "description": "Full render pipeline with vertex and fragment shaders"
  },
  "Vertex shader": {
    "prefix": "vert",
    "body": [
      "shader vertex ${1:vert_main} {",
      "\tinputs {",
      "\t\t${2:position}: vec4,",
      "\t\t${3:uv}: vec2,",
      "\t}",
      "\toutputs {",
      "\t\tclip_position: vec4,",
      "\t\ttex_coords: vec2,",
      "\t}",
      "",
      "\tlet out_pos = ${4:uniforms}.mvp * ${2:position};",
      "\t${0}",
      "}"
    ],
    "description": "Vertex shader stage"
  },
  "Fragment shader": {
    "prefix": "frag",
    "body": [
      "shader fragment ${1:frag_main} {",
      "\tinputs {",
      "\t\t${2:tex_coords}: vec2,",
      "\t}",
      "\toutputs {",
      "\t\tcolor: vec4,",
      "\t}",
      "",
      "\tlet tex_color = textureSample(${3:texture}, ${4:sampler}, ${2:tex_coords});",
      "\t${0}",
      "\tcolor = tex_color;",
      "}"
    ],
    "description": "Fragment shader stage"
  },
  "Compute shader": {
    "prefix": "compute",
    "body": [
      "#[workgroup(${1:64}, ${2:1}, ${3:1})]",
      "shader compute ${4:compute_main} {",
      "\t@binding(0) @group(0) var<storage, read_write> data: array<f32>;",
      "",
      "\tlet global_id = builtin.global_invocation_id;",
      "\tlet idx = global_id.x;",
      "",
      "\t${0}",
      "}"
    ],
    "description": "Compute shader with workgroup size"
  },
  "Uniforms block": {
    "prefix": "uniforms",
    "body": [
      "uniforms {",
      "\t${1:name}: ${2:Type},",
      "\t${0}",
      "}"
    ],
    "description": "Uniforms block in a pipeline"
  },
  "Texture sample": {
    "prefix": "sample",
    "body": [
      "let ${1:color} = textureSample(${2:texture}, ${3:sampler}, ${4:uv});"
    ],
    "description": "Sample a 2D texture"
  },
  "Vec4 constructor": {
    "prefix": "vec4",
    "body": [
      "vec4(${1:x}, ${2:y}, ${3:z}, ${4:w})"
    ],
    "description": "Construct a vec4"
  },
  "Vec3 constructor": {
    "prefix": "vec3",
    "body": [
      "vec3(${1:x}, ${2:y}, ${3:z})"
    ],
    "description": "Construct a vec3"
  },
  "Compute pipeline": {
    "prefix": "computepipeline",
    "body": [
      "pipeline ${1:ComputePipeline} {",
      "\t#[target(vulkan)]",
      "\t#[workgroup(${2:64}, 1, 1)]",
      "\tshader compute ${3:main} {",
      "\t\t@binding(0) @group(0) var<storage, read> input: array<f32>;",
      "\t\t@binding(1) @group(0) var<storage, read_write> output: array<f32>;",
      "",
      "\t\tlet idx = builtin.global_invocation_id.x;",
      "\t\t${0}",
      "\t}",
      "}"
    ],
    "description": "Compute-only pipeline"
  }
}
