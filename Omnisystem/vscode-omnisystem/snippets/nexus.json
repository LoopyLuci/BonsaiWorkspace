{
  "Layout definition": {
    "prefix": "layout",
    "body": [
      "layout ${1:LayoutName} {",
      "\tbreakpoints {",
      "\t\tsm: 640px,",
      "\t\tmd: 768px,",
      "\t\tlg: 1024px,",
      "\t\txl: 1280px,",
      "\t}",
      "",
      "\t${0}",
      "}"
    ],
    "description": "Layout definition with breakpoints"
  },
  "Flex row": {
    "prefix": "flex",
    "body": [
      "flex {",
      "\tdirection: row,",
      "\talign: ${1|center,flex_start,flex_end,stretch,baseline|},",
      "\tjustify: ${2|flex_start,flex_end,center,space_between,space_around,space_evenly|},",
      "\tgap: ${3:8px},",
      "\t${0}",
      "}"
    ],
    "description": "Flex container (row)"
  },
  "Flex column": {
    "prefix": "flexcol",
    "body": [
      "flex {",
      "\tdirection: column,",
      "\talign: ${1|center,flex_start,flex_end,stretch|},",
      "\tjustify: ${2|flex_start,flex_end,center,space_between|},",
      "\tgap: ${3:8px},",
      "\t${0}",
      "}"
    ],
    "description": "Flex container (column)"
  },
  "Grid layout": {
    "prefix": "grid",
    "body": [
      "grid {",
      "\tcolumns: ${1:repeat(3, 1fr)},",
      "\trows: ${2:auto},",
      "\tgap: ${3:16px},",
      "\t${0}",
      "}"
    ],
    "description": "Grid layout container"
  },
  "Responsive layout": {
    "prefix": "responsive",
    "body": [
      "layout ${1:ResponsiveLayout} {",
      "\tbreakpoints {",
      "\t\tsm: 640px,",
      "\t\tmd: 768px,",
      "\t\tlg: 1024px,",
      "\t\txl: 1280px,",
      "\t}",
      "",
      "\t// Mobile-first base",
      "\tflex {",
      "\t\tdirection: column,",
      "\t\tgap: 8px,",
      "\t}",
      "",
      "\t// Tablet and up",
      "\t@md {",
      "\t\tgrid {",
      "\t\t\tcolumns: repeat(2, 1fr),",
      "\t\t\tgap: 16px,",
      "\t\t}",
      "\t}",
      "",
      "\t// Desktop",
      "\t@lg {",
      "\t\tgrid {",
      "\t\t\tcolumns: repeat(3, 1fr),",
      "\t\t\tgap: 24px,",
      "\t\t}",
      "\t}",
      "\t${0}",
      "}"
    ],
    "description": "Full responsive layout with breakpoints"
  },
  "Container": {
    "prefix": "container",
    "body": [
      "container {",
      "\tmax_width: ${1:1280px},",
      "\tpadding: ${2:0 16px},",
      "\tmargin: ${3:0 auto},",
      "\t${0}",
      "}"
    ],
    "description": "Centered container with max-width"
  },
  "Breakpoint rule": {
    "prefix": "breakpoint",
    "body": [
      "@${1|sm,md,lg,xl,xxl|} {",
      "\t${0}",
      "}"
    ],
    "description": "Breakpoint-specific style rule"
  },
  "Grid area": {
    "prefix": "gridarea",
    "body": [
      "grid_area: ${1:area-name};",
      "grid_column: ${2:1} / ${3:3};",
      "grid_row: ${4:1} / ${5:2};"
    ],
    "description": "Grid area placement"
  }
}
