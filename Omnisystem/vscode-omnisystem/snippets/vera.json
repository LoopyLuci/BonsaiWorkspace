{
  "Full component": {
    "prefix": "component",
    "body": [
      "component ${1:ComponentName} {",
      "\tprops {",
      "\t\t${2:prop_name}: ${3:Type},",
      "\t}",
      "",
      "\tstate {",
      "\t\t${4:state_name}: ${5:Type} = ${6:initial_value},",
      "\t}",
      "",
      "\trender {",
      "\t\t${0}",
      "\t}",
      "}"
    ],
    "description": "Full VERA component with props, state, and render"
  },
  "Simple component": {
    "prefix": "comp",
    "body": [
      "component ${1:ComponentName} {",
      "\trender {",
      "\t\t${0}",
      "\t}",
      "}"
    ],
    "description": "Simple component with only render block"
  },
  "Props block": {
    "prefix": "props",
    "body": [
      "props {",
      "\t${1:prop_name}: ${2:Type},",
      "\t${0}",
      "}"
    ],
    "description": "Component props block"
  },
  "State block": {
    "prefix": "state",
    "body": [
      "state {",
      "\t${1:state_name}: ${2:Type} = ${3:initial_value},",
      "\t${0}",
      "}"
    ],
    "description": "Component state block"
  },
  "On click handler": {
    "prefix": "onclick",
    "body": [
      "on_click: |${1:event}| {",
      "\t${0}",
      "}"
    ],
    "description": "Click event handler"
  },
  "On change handler": {
    "prefix": "onchange",
    "body": [
      "on_change: |${1:event}| {",
      "\t${0}",
      "}"
    ],
    "description": "Change event handler"
  },
  "On submit handler": {
    "prefix": "onsubmit",
    "body": [
      "on_submit: |${1:event}| {",
      "\t${1:event}.prevent_default();",
      "\t${0}",
      "}"
    ],
    "description": "Form submit event handler"
  },
  "Use state hook": {
    "prefix": "usestate",
    "body": [
      "let (${1:value}, ${2:set_value}) = use_state(${3:initial});"
    ],
    "description": "use_state hook for reactive state"
  },
  "Use effect hook": {
    "prefix": "useeffect",
    "body": [
      "use_effect(|| {",
      "\t${0}",
      "}, [${1:dependencies}]);"
    ],
    "description": "use_effect hook with dependencies"
  },
  "Use ref hook": {
    "prefix": "useref",
    "body": [
      "let ${1:ref_name} = use_ref(${2:initial_value});"
    ],
    "description": "use_ref hook for mutable references"
  },
  "Computed value": {
    "prefix": "computed",
    "body": [
      "computed ${1:name} = ${0};"
    ],
    "description": "Computed/derived value"
  },
  "Style block": {
    "prefix": "style",
    "body": [
      "style {",
      "\t${1:property}: ${2:value};",
      "\t${0}",
      "}"
    ],
    "description": "Inline style block"
  },
  "Watch expression": {
    "prefix": "watch",
    "body": [
      "watch ${1:expression} {",
      "\t${0}",
      "}"
    ],
    "description": "Watch for reactive changes"
  },
  "Emit event": {
    "prefix": "emit",
    "body": [
      "emit(\"${1:event-name}\", ${2:payload});"
    ],
    "description": "Emit a custom event"
  }
}
