{
  "Function definition": {
    "prefix": "fn",
    "body": [
      "fn ${1:function_name}(${2:params}) -> ${3:ReturnType} {",
      "\t${0}",
      "}"
    ],
    "description": "Define a TITAN function"
  },
  "Public function definition": {
    "prefix": "pfn",
    "body": [
      "pub fn ${1:function_name}(${2:params}) -> ${3:ReturnType} {",
      "\t${0}",
      "}"
    ],
    "description": "Define a public TITAN function"
  },
  "Struct definition": {
    "prefix": "struct",
    "body": [
      "struct ${1:StructName} {",
      "\t${2:field}: ${3:Type},",
      "\t${0}",
      "}"
    ],
    "description": "Define a TITAN struct"
  },
  "Public struct definition": {
    "prefix": "pstruct",
    "body": [
      "pub struct ${1:StructName} {",
      "\tpub ${2:field}: ${3:Type},",
      "\t${0}",
      "}"
    ],
    "description": "Define a public TITAN struct"
  },
  "Enum definition": {
    "prefix": "enum",
    "body": [
      "enum ${1:EnumName} {",
      "\t${2:Variant1},",
      "\t${3:Variant2}(${4:Type}),",
      "\t${0}",
      "}"
    ],
    "description": "Define a TITAN enum"
  },
  "Impl block": {
    "prefix": "impl",
    "body": [
      "impl ${1:TypeName} {",
      "\tpub fn ${2:new}(${3:params}) -> Self {",
      "\t\tSelf {",
      "\t\t\t${0}",
      "\t\t}",
      "\t}",
      "}"
    ],
    "description": "Define an impl block"
  },
  "Impl trait": {
    "prefix": "implt",
    "body": [
      "impl ${1:TraitName} for ${2:TypeName} {",
      "\t${0}",
      "}"
    ],
    "description": "Implement a trait for a type"
  },
  "Test function": {
    "prefix": "test",
    "body": [
      "#[test]",
      "fn ${1:test_name}() {",
      "\t${0}",
      "}"
    ],
    "description": "Define a test function"
  },
  "Test module": {
    "prefix": "testmod",
    "body": [
      "#[cfg(test)]",
      "mod tests {",
      "\tuse super::*;",
      "",
      "\t#[test]",
      "\tfn ${1:test_name}() {",
      "\t\t${0}",
      "\t}",
      "}"
    ],
    "description": "Create a test module"
  },
  "Match expression": {
    "prefix": "match",
    "body": [
      "match ${1:expression} {",
      "\t${2:Pattern1} => ${3:result1},",
      "\t${4:Pattern2} => {",
      "\t\t${0}",
      "\t},",
      "\t_ => ${5:default},",
      "}"
    ],
    "description": "Match expression with arms"
  },
  "If let pattern": {
    "prefix": "iflet",
    "body": [
      "if let ${1:Some(value)} = ${2:expression} {",
      "\t${0}",
      "}"
    ],
    "description": "If-let pattern matching"
  },
  "While let pattern": {
    "prefix": "whilelet",
    "body": [
      "while let ${1:Some(value)} = ${2:expression} {",
      "\t${0}",
      "}"
    ],
    "description": "While-let pattern matching"
  },
  "For loop": {
    "prefix": "for",
    "body": [
      "for ${1:item} in ${2:iterable} {",
      "\t${0}",
      "}"
    ],
    "description": "For-in loop"
  },
  "Vec new": {
    "prefix": "vec",
    "body": [
      "let ${1:name}: Vec<${2:T}> = Vec::new();"
    ],
    "description": "Create a new Vec"
  },
  "Vec macro": {
    "prefix": "veclit",
    "body": [
      "let ${1:name} = vec![${0}];"
    ],
    "description": "Create Vec with vec! macro"
  },
  "HashMap new": {
    "prefix": "hashmap",
    "body": [
      "let ${1:name}: HashMap<${2:K}, ${3:V}> = HashMap::new();"
    ],
    "description": "Create a new HashMap"
  },
  "Option unwrap or": {
    "prefix": "unwrap",
    "body": [
      "${1:option}.unwrap_or(${0})"
    ],
    "description": "Unwrap Option with default"
  },
  "Result propagation": {
    "prefix": "tryop",
    "body": [
      "let ${1:value} = ${2:expression}?;"
    ],
    "description": "Propagate Result with ? operator"
  },
  "Closure": {
    "prefix": "closure",
    "body": [
      "|${1:params}| ${0}"
    ],
    "description": "Closure expression"
  },
  "Closure block": {
    "prefix": "closureb",
    "body": [
      "|${1:params}| {",
      "\t${0}",
      "}"
    ],
    "description": "Block closure expression"
  },
  "Use statement": {
    "prefix": "use",
    "body": [
      "use ${1:path}::${0};"
    ],
    "description": "Use/import statement"
  },
  "Assert equal": {
    "prefix": "assert_eq",
    "body": [
      "assert_eq!(${1:left}, ${2:right});"
    ],
    "description": "Assert equality"
  }
}
