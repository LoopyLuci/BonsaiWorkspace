{
  "Layer definition": {
    "prefix": "layer",
    "body": [
      "layer ${1:LayerName} {",
      "\ttype: ${2|dense,conv2d,maxpool2d,dropout,batchnorm,lstm,attention|},",
      "\tinput_shape: [${3:batch}, ${4:features}],",
      "\toutput_shape: [${3:batch}, ${5:units}],",
      "\t${0}",
      "}"
    ],
    "description": "Neural network layer declaration"
  },
  "Dense layer": {
    "prefix": "dense",
    "body": [
      "layer ${1:LayerName} {",
      "\ttype: dense,",
      "\tunits: ${2:128},",
      "\tactivation: ${3|relu,sigmoid,tanh,softmax,gelu,linear|},",
      "\tinput_shape: [${4:batch}, ${5:in_features}],",
      "\toutput_shape: [${4:batch}, ${2:128}],",
      "}"
    ],
    "description": "Fully-connected Dense layer"
  },
  "Conv2D layer": {
    "prefix": "conv2d",
    "body": [
      "layer ${1:LayerName} {",
      "\ttype: conv2d,",
      "\tfilters: ${2:32},",
      "\tkernel_size: [${3:3}, ${3:3}],",
      "\tstride: [${4:1}, ${4:1}],",
      "\tpadding: ${5|same,valid|},",
      "\tactivation: ${6|relu,gelu,linear|},",
      "}"
    ],
    "description": "2D Convolutional layer"
  },
  "Model definition": {
    "prefix": "model",
    "body": [
      "model ${1:ModelName} {",
      "\tarchitecture: [",
      "\t\t${2:Layer1},",
      "\t\t${3:Layer2},",
      "\t\t${0}",
      "\t],",
      "",
      "\tloss: ${4|cross_entropy,mse,binary_cross_entropy|},",
      "\toptimizer: ${5|adam,sgd,rmsprop|} {",
      "\t\tlearning_rate: ${6:0.001},",
      "\t},",
      "}"
    ],
    "description": "Neural network model with architecture"
  },
  "Full model with training": {
    "prefix": "modeltrain",
    "body": [
      "model ${1:ModelName} {",
      "\tarchitecture: [${2:Layer1}, ${3:Layer2}],",
      "",
      "\tloss: ${4:cross_entropy},",
      "\toptimizer: adam {",
      "\t\tlearning_rate: ${5:0.001},",
      "\t\tbeta1: 0.9,",
      "\t\tbeta2: 0.999,",
      "\t\tepsilon: 1e-8,",
      "\t},",
      "",
      "\tfn forward(input: Tensor) -> Tensor {",
      "\t\t${0}",
      "\t}",
      "",
      "\tfn train(dataset: Dataset, epochs: u32) {",
      "\t\t// Training loop",
      "\t}",
      "}"
    ],
    "description": "Complete model with optimizer and training hooks"
  },
  "Dropout layer": {
    "prefix": "dropout",
    "body": [
      "layer ${1:DropoutLayer} {",
      "\ttype: dropout,",
      "\trate: ${2:0.5},",
      "}"
    ],
    "description": "Dropout regularization layer"
  },
  "BatchNorm layer": {
    "prefix": "batchnorm",
    "body": [
      "layer ${1:BNLayer} {",
      "\ttype: batchnorm,",
      "\tmomentum: ${2:0.99},",
      "\tepsilon: ${3:0.001},",
      "}"
    ],
    "description": "Batch normalization layer"
  },
  "Adam optimizer": {
    "prefix": "adam",
    "body": [
      "optimizer: adam {",
      "\tlearning_rate: ${1:0.001},",
      "\tbeta1: ${2:0.9},",
      "\tbeta2: ${3:0.999},",
      "\tepsilon: ${4:1e-8},",
      "\tweight_decay: ${5:0.0},",
      "}"
    ],
    "description": "Adam optimizer configuration"
  }
}
