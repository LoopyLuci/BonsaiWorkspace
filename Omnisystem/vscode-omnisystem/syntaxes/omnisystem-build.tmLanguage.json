{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Omnisystem Build",
  "scopeName": "source.omnisystem-build",
  "patterns": [
    { "include": "#comments" },
    { "include": "#sections" },
    { "include": "#keys" },
    { "include": "#values" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.omnisystem-build",
          "match": "#.*$"
        }
      ]
    },
    "sections": {
      "patterns": [
        {
          "name": "entity.name.section.omnisystem-build",
          "match": "^\\s*(\\[)\\s*([A-Za-z0-9_.\\-]+)\\s*(\\])",
          "captures": {
            "1": { "name": "punctuation.definition.section.begin.omnisystem-build" },
            "2": { "name": "entity.name.section.omnisystem-build" },
            "3": { "name": "punctuation.definition.section.end.omnisystem-build" }
          }
        }
      ]
    },
    "keys": {
      "patterns": [
        {
          "match": "([A-Za-z_][A-Za-z0-9_\\-]*)\\s*(=)",
          "captures": {
            "1": { "name": "variable.other.key.omnisystem-build" },
            "2": { "name": "keyword.operator.assignment.omnisystem-build" }
          }
        }
      ]
    },
    "values": {
      "patterns": [
        { "include": "#strings" },
        { "include": "#languages" },
        { "include": "#booleans" },
        { "include": "#numbers" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.omnisystem-build",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.omnisystem-build", "match": "\\\\." }
          ]
        }
      ]
    },
    "languages": {
      "patterns": [
        {
          "name": "support.constant.language.omnisystem-build",
          "match": "\\b(titan|vera|helix|aether|axiom|sylva|nexus)\\b"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.omnisystem-build",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.omnisystem-build",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    }
  }
}
