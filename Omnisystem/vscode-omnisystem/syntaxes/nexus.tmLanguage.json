{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "NEXUS",
  "scopeName": "source.nexus",
  "fileTypes": ["nexus"],
  "patterns": [
    { "include": "#block_comment" },
    { "include": "#line_comment" },
    { "include": "#layout_definition" },
    { "include": "#fn_definition" },
    { "include": "#breakpoint_names" },
    { "include": "#dimension_values" },
    { "include": "#string" },
    { "include": "#number" },
    { "include": "#css_properties" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#constant" }
  ],
  "repository": {
    "block_comment": {
      "name": "comment.block.nexus",
      "begin": "/\\*",
      "end": "\\*/",
      "patterns": [{ "include": "#block_comment" }]
    },
    "line_comment": {
      "name": "comment.line.double-slash.nexus",
      "begin": "//",
      "end": "$"
    },
    "layout_definition": {
      "match": "\\b(layout)\\s+([A-Z][a-zA-Z0-9_]*)\\b",
      "captures": {
        "1": { "name": "keyword.declaration.layout.nexus" },
        "2": { "name": "entity.name.class.layout.nexus" }
      }
    },
    "fn_definition": {
      "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
      "captures": {
        "1": { "name": "keyword.other.fn.nexus" },
        "2": { "name": "entity.name.function.nexus" }
      }
    },
    "breakpoint_names": {
      "name": "constant.language.breakpoint.nexus",
      "match": "\\b(xs|sm|md|lg|xl|xxl|2xl|3xl)\\b"
    },
    "dimension_values": {
      "name": "constant.numeric.dimension.nexus",
      "match": "\\b\\d+(\\.\\d+)?(px|%|em|rem|vw|vh|vmin|vmax|fr|ch|ex|cm|mm|pt|pc|in)\\b"
    },
    "css_properties": {
      "name": "support.type.property-name.nexus",
      "match": "\\b(align|justify|gap|padding|margin|width|height|min_width|max_width|min_height|max_height|display|overflow|wrap|order|grow|shrink|basis|flex_direction|flex_wrap|align_items|align_self|align_content|justify_items|justify_self|justify_content|grid_template|grid_area|grid_column|grid_row|grid_gap|column_gap|row_gap|position|top|right|bottom|left|z_index|border|border_radius|border_width|background|color|font_size|font_weight|line_height|letter_spacing|text_align|opacity|transform|transition|animation|box_shadow|cursor|pointer_events|visibility|overflow_x|overflow_y)\\b(?=\\s*:)"
    },
    "string": {
      "name": "string.quoted.double.nexus",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.nexus", "match": "\\\\[ntr\\\\\"']" }
      ]
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.float.nexus",
          "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*(f32|f64)?\\b"
        },
        {
          "name": "constant.numeric.integer.nexus",
          "match": "\\b\\d[\\d_]*(u8|u16|u32|u64|i8|i16|i32|i64|usize)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.declaration.nexus",
          "match": "\\b(layout|breakpoint|breakpoints|responsive|container|row|col|flex|grid|stack|wrap|scroll)\\b"
        },
        {
          "name": "keyword.control.nexus",
          "match": "\\b(if|else|for|while|return|break|continue|in|match)\\b"
        },
        {
          "name": "keyword.other.nexus",
          "match": "\\b(let|mut|fn|pub|use|struct|enum|ref|as)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.primitive.nexus",
          "match": "\\b(f32|f64|u8|u16|u32|u64|i8|i16|i32|i64|bool|str|String|usize)\\b"
        },
        {
          "name": "entity.name.type.layout.nexus",
          "match": "\\b(FlexDirection|JustifyContent|AlignItems|AlignSelf|Display|Overflow|Position|Unit|Color|Size)\\b"
        }
      ]
    },
    "constant": {
      "patterns": [
        {
          "name": "constant.language.nexus",
          "match": "\\b(true|false|auto|none|inherit|initial|unset|row|column|row_reverse|column_reverse|flex_start|flex_end|center|space_between|space_around|space_evenly|stretch|baseline|nowrap|wrap|wrap_reverse)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.comparison.nexus", "match": "==|!=|<=|>=" },
        { "name": "keyword.operator.arithmetic.nexus", "match": "\\+|-|\\*|/|%" },
        { "name": "keyword.operator.assignment.nexus", "match": "=" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.brackets.curly.nexus", "match": "[{}]" },
        { "name": "punctuation.brackets.round.nexus", "match": "[()]" },
        { "name": "punctuation.brackets.square.nexus", "match": "[\\[\\]]" },
        { "name": "punctuation.separator.semicolon.nexus", "match": ";" },
        { "name": "punctuation.separator.comma.nexus", "match": "," },
        { "name": "punctuation.separator.colon.nexus", "match": ":" }
      ]
    }
  }
}
