{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "AETHER",
  "scopeName": "source.aether",
  "fileTypes": ["aether"],
  "patterns": [
    { "include": "#block_comment" },
    { "include": "#line_comment" },
    { "include": "#actor_definition" },
    { "include": "#message_definition" },
    { "include": "#handler_definition" },
    { "include": "#spawn_expression" },
    { "include": "#send_call" },
    { "include": "#string" },
    { "include": "#number" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#constant" }
  ],
  "repository": {
    "block_comment": {
      "name": "comment.block.aether",
      "begin": "/\\*",
      "end": "\\*/",
      "patterns": [{ "include": "#block_comment" }]
    },
    "line_comment": {
      "name": "comment.line.double-slash.aether",
      "begin": "//",
      "end": "$"
    },
    "actor_definition": {
      "match": "\\b(actor)\\s+([A-Z][a-zA-Z0-9_]*)\\b",
      "captures": {
        "1": { "name": "keyword.declaration.actor.aether" },
        "2": { "name": "entity.name.class.actor.aether" }
      }
    },
    "message_definition": {
      "match": "\\b(message)\\s+([A-Z][a-zA-Z0-9_]*)\\b",
      "captures": {
        "1": { "name": "keyword.declaration.message.aether" },
        "2": { "name": "entity.name.type.message.aether" }
      }
    },
    "handler_definition": {
      "match": "\\b(handler)\\s+([A-Z][a-zA-Z0-9_]*)\\s*\\(([^)]*)\\)",
      "captures": {
        "1": { "name": "keyword.declaration.handler.aether" },
        "2": { "name": "entity.name.function.handler.aether" },
        "3": { "name": "variable.parameter.aether" }
      }
    },
    "spawn_expression": {
      "match": "\\b(spawn)\\s+([A-Z][a-zA-Z0-9_]*)\\b",
      "captures": {
        "1": { "name": "keyword.control.spawn.aether" },
        "2": { "name": "entity.name.class.actor.aether" }
      }
    },
    "send_call": {
      "match": "\\.send\\b",
      "name": "support.function.send.aether"
    },
    "string": {
      "name": "string.quoted.double.aether",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.aether", "match": "\\\\[ntr\\\\\"']" }
      ]
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.float.aether",
          "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*(f32|f64)?\\b"
        },
        {
          "name": "constant.numeric.integer.aether",
          "match": "\\b\\d[\\d_]*(u8|u16|u32|u64|i8|i16|i32|i64|usize)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.declaration.aether",
          "match": "\\b(actor|message|handler)\\b"
        },
        {
          "name": "keyword.control.aether",
          "match": "\\b(spawn|send|if|else|for|while|return|break|continue|in|match|yield_now|yield_until_idle|run_event_loop)\\b"
        },
        {
          "name": "keyword.other.aether",
          "match": "\\b(let|mut|fn|pub|use|struct|enum|self_ref|ref|as)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.primitive.aether",
          "match": "\\b(u8|u16|u32|u64|i8|i16|i32|i64|f32|f64|bool|str|String|usize|isize)\\b"
        },
        {
          "name": "entity.name.type.builtin.aether",
          "match": "\\b(Vec|HashMap|Option|Result|ActorRef|Mailbox|Duration)\\b"
        }
      ]
    },
    "constant": {
      "name": "constant.language.aether",
      "match": "\\b(true|false|None|Some|Ok|Err)\\b"
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.arrow.aether", "match": "->|=>" },
        { "name": "keyword.operator.comparison.aether", "match": "==|!=|<=|>=" },
        { "name": "keyword.operator.logical.aether", "match": "&&|\\|\\||!" },
        { "name": "keyword.operator.arithmetic.aether", "match": "\\+|-|\\*|/|%" },
        { "name": "keyword.operator.assignment.aether", "match": "=" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.brackets.curly.aether", "match": "[{}]" },
        { "name": "punctuation.brackets.round.aether", "match": "[()]" },
        { "name": "punctuation.brackets.square.aether", "match": "[\\[\\]]" },
        { "name": "punctuation.separator.semicolon.aether", "match": ";" },
        { "name": "punctuation.separator.comma.aether", "match": "," },
        { "name": "punctuation.separator.dot.aether", "match": "\\." }
      ]
    }
  }
}
