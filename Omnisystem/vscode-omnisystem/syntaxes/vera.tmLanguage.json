{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "VERA",
  "scopeName": "source.vera",
  "fileTypes": ["vera"],
  "patterns": [
    { "include": "#block_comment" },
    { "include": "#line_comment" },
    { "include": "#component_definition" },
    { "include": "#event_handlers" },
    { "include": "#hooks" },
    { "include": "#template_string" },
    { "include": "#string" },
    { "include": "#number" },
    { "include": "#fn_definition" },
    { "include": "#keywords" },
    { "include": "#html_tags" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#constant" }
  ],
  "repository": {
    "block_comment": {
      "name": "comment.block.vera",
      "begin": "/\\*",
      "end": "\\*/",
      "patterns": [{ "include": "#block_comment" }]
    },
    "line_comment": {
      "name": "comment.line.double-slash.vera",
      "begin": "//",
      "end": "$"
    },
    "component_definition": {
      "match": "\\b(component)\\s+([A-Z][a-zA-Z0-9_]*)\\b",
      "captures": {
        "1": { "name": "keyword.declaration.component.vera" },
        "2": { "name": "entity.name.class.component.vera" }
      }
    },
    "event_handlers": {
      "name": "support.function.event-handler.vera",
      "match": "\\b(on_click|on_change|on_submit|on_focus|on_blur|on_keydown|on_keyup|on_mouseover|on_mouseout|on_mouseenter|on_mouseleave|on_input|on_scroll)\\b"
    },
    "hooks": {
      "name": "support.function.hook.vera",
      "match": "\\b(use_effect|use_state|use_ref|use_memo|use_callback|use_context|use_reducer)\\b"
    },
    "template_string": {
      "name": "string.template.vera",
      "begin": "`",
      "end": "`",
      "patterns": [
        {
          "name": "meta.template.expression.vera",
          "begin": "\\{",
          "end": "\\}",
          "patterns": [{ "include": "$self" }]
        },
        {
          "name": "constant.character.escape.vera",
          "match": "\\\\[`\\\\ntr]"
        }
      ]
    },
    "string": {
      "name": "string.quoted.double.vera",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.vera",
          "match": "\\\\[ntr\\\\\"']"
        },
        {
          "name": "meta.embedded.expression.vera",
          "begin": "\\{",
          "end": "\\}"
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.float.vera",
          "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*([eE][+-]?\\d[\\d_]*)?(f32|f64)?\\b"
        },
        {
          "name": "constant.numeric.integer.vera",
          "match": "\\b\\d[\\d_]*(u8|u16|u32|u64|i8|i16|i32|i64|usize)?\\b"
        }
      ]
    },
    "fn_definition": {
      "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
      "captures": {
        "1": { "name": "keyword.other.fn.vera" },
        "2": { "name": "entity.name.function.vera" }
      }
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.declaration.vera",
          "match": "\\b(component|props|state|render|computed|watch|emit|slot|style)\\b"
        },
        {
          "name": "keyword.control.vera",
          "match": "\\b(if|else|for|while|return|break|continue|in|match)\\b"
        },
        {
          "name": "keyword.other.vera",
          "match": "\\b(let|mut|pub|fn|use|class|ref|as)\\b"
        }
      ]
    },
    "html_tags": {
      "patterns": [
        {
          "name": "entity.name.tag.vera",
          "match": "</?([a-z][a-zA-Z0-9]*)(?=\\s|>|/)"
        }
      ]
    },
    "constant": {
      "name": "constant.language.vera",
      "match": "\\b(true|false|null|None|Some)\\b"
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.arrow.vera", "match": "->|=>" },
        { "name": "keyword.operator.comparison.vera", "match": "==|!=|<=|>=" },
        { "name": "keyword.operator.logical.vera", "match": "&&|\\|\\||!" },
        { "name": "keyword.operator.arithmetic.vera", "match": "\\+|-|\\*|/|%" },
        { "name": "keyword.operator.assignment.vera", "match": "=" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.brackets.curly.vera", "match": "[{}]" },
        { "name": "punctuation.brackets.round.vera", "match": "[()]" },
        { "name": "punctuation.brackets.square.vera", "match": "[\\[\\]]" },
        { "name": "punctuation.separator.semicolon.vera", "match": ";" },
        { "name": "punctuation.separator.comma.vera", "match": "," },
        { "name": "punctuation.separator.dot.vera", "match": "\\." }
      ]
    }
  }
}
