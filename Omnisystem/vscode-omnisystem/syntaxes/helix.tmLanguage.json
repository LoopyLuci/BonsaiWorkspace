{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "HELIX",
  "scopeName": "source.helix",
  "fileTypes": ["helix"],
  "patterns": [
    { "include": "#block_comment" },
    { "include": "#line_comment" },
    { "include": "#attribute" },
    { "include": "#pipeline_definition" },
    { "include": "#shader_definition" },
    { "include": "#vector_constructors" },
    { "include": "#swizzle" },
    { "include": "#string" },
    { "include": "#number" },
    { "include": "#glsl_builtins" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#constant" }
  ],
  "repository": {
    "block_comment": {
      "name": "comment.block.helix",
      "begin": "/\\*",
      "end": "\\*/",
      "patterns": [{ "include": "#block_comment" }]
    },
    "line_comment": {
      "name": "comment.line.double-slash.helix",
      "begin": "//",
      "end": "$"
    },
    "attribute": {
      "name": "meta.attribute.helix",
      "begin": "#!?\\[",
      "end": "\\]",
      "patterns": [
        {
          "name": "entity.other.attribute-name.helix",
          "match": "\\b(target|workgroup|binding|group|location|builtin|interpolate)\\b"
        },
        {
          "name": "constant.language.attribute.helix",
          "match": "\\b(vulkan|dx12|metal|wasm|vertex|fragment|compute)\\b"
        },
        { "include": "#number" }
      ]
    },
    "pipeline_definition": {
      "match": "\\b(pipeline)\\s+([A-Z][a-zA-Z0-9_]*)\\b",
      "captures": {
        "1": { "name": "keyword.declaration.pipeline.helix" },
        "2": { "name": "entity.name.class.pipeline.helix" }
      }
    },
    "shader_definition": {
      "match": "\\b(shader)\\s+(vertex|fragment|compute)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
      "captures": {
        "1": { "name": "keyword.declaration.shader.helix" },
        "2": { "name": "keyword.control.shader-type.helix" },
        "3": { "name": "entity.name.function.shader.helix" }
      }
    },
    "vector_constructors": {
      "match": "\\b(vec2|vec3|vec4|mat2|mat3|mat4|uvec2|uvec3|uvec4|ivec2|ivec3|ivec4|bvec2|bvec3|bvec4)(?=\\s*\\()",
      "captures": {
        "1": { "name": "support.function.constructor.helix" }
      }
    },
    "swizzle": {
      "match": "\\.(([xyzw]{1,4})|([rgba]{1,4})|([stpq]{1,4}))\\b",
      "captures": {
        "1": { "name": "variable.other.member.swizzle.helix" }
      }
    },
    "string": {
      "name": "string.quoted.double.helix",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.helix", "match": "\\\\[ntr\\\\\"']" }
      ]
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.float.helix",
          "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*([eE][+-]?\\d[\\d_]*)?(f32|f64|h)?\\b"
        },
        {
          "name": "constant.numeric.hex.helix",
          "match": "\\b0x[0-9a-fA-F][0-9a-fA-F_]*(u32|i32)?\\b"
        },
        {
          "name": "constant.numeric.integer.helix",
          "match": "\\b\\d[\\d_]*(u32|i32|u64|i64|u8|i8)?\\b"
        }
      ]
    },
    "glsl_builtins": {
      "name": "support.function.builtin.glsl.helix",
      "match": "\\b(normalize|dot|cross|length|reflect|refract|clamp|mix|smoothstep|step|sin|cos|tan|asin|acos|atan|abs|sqrt|pow|exp|log|log2|exp2|min|max|floor|ceil|round|fract|mod|sign|distance|sample|textureSample|textureStore|atomicAdd|atomicSub|atomicAnd|atomicOr|atomicXor|atomicExchange|atomicCompareExchangeWeak|discard|dispatch_compute|store_texture|load_texture)\\b"
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.declaration.helix",
          "match": "\\b(pipeline|shader|uniform|inputs|outputs|uniforms|workgroup|storage_buffer|texture2d|texture3d|sampler|sampler_comparison)\\b"
        },
        {
          "name": "keyword.control.helix",
          "match": "\\b(if|else|for|while|return|break|continue|switch|case|default|loop)\\b"
        },
        {
          "name": "keyword.other.helix",
          "match": "\\b(let|var|fn|pub|use|struct|const|override|enable)\\b"
        },
        {
          "name": "keyword.control.shader-stage.helix",
          "match": "\\b(vertex|fragment|compute)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.primitive.helix",
          "match": "\\b(f32|f16|u32|i32|u64|i64|bool|u8|i8|atomic)\\b"
        },
        {
          "name": "entity.name.type.vector.helix",
          "match": "\\b(vec2|vec3|vec4|mat2x2|mat3x3|mat4x4|mat2|mat3|mat4|uvec2|uvec3|uvec4|ivec2|ivec3|ivec4)\\b"
        },
        {
          "name": "entity.name.type.texture.helix",
          "match": "\\b(texture2d|texture3d|texture_cube|texture2d_array|sampler|sampler_comparison|storage_texture)\\b"
        }
      ]
    },
    "constant": {
      "name": "constant.language.helix",
      "match": "\\b(true|false)\\b"
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.arrow.helix", "match": "->" },
        { "name": "keyword.operator.comparison.helix", "match": "==|!=|<=|>=" },
        { "name": "keyword.operator.logical.helix", "match": "&&|\\|\\||!" },
        { "name": "keyword.operator.bitwise.helix", "match": "&|\\||\\^|<<|>>" },
        { "name": "keyword.operator.arithmetic.helix", "match": "\\+|-|\\*|/|%" },
        { "name": "keyword.operator.assignment.helix", "match": "=" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.brackets.curly.helix", "match": "[{}]" },
        { "name": "punctuation.brackets.round.helix", "match": "[()]" },
        { "name": "punctuation.brackets.square.helix", "match": "[\\[\\]]" },
        { "name": "punctuation.separator.semicolon.helix", "match": ";" },
        { "name": "punctuation.separator.comma.helix", "match": "," },
        { "name": "punctuation.separator.colon.helix", "match": ":" }
      ]
    }
  }
}
