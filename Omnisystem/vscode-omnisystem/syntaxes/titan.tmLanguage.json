{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "TITAN",
  "scopeName": "source.titan",
  "fileTypes": ["titan"],
  "patterns": [
    { "include": "#block_comment" },
    { "include": "#line_comment" },
    { "include": "#attribute" },
    { "include": "#lifetime" },
    { "include": "#string" },
    { "include": "#char_literal" },
    { "include": "#number" },
    { "include": "#fn_definition" },
    { "include": "#struct_definition" },
    { "include": "#enum_definition" },
    { "include": "#impl_definition" },
    { "include": "#mod_definition" },
    { "include": "#macro_invocation" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#storage_modifiers" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#self_keyword" },
    { "include": "#constant" }
  ],
  "repository": {
    "block_comment": {
      "name": "comment.block.titan",
      "begin": "/\\*",
      "end": "\\*/",
      "patterns": [{ "include": "#block_comment" }]
    },
    "line_comment": {
      "name": "comment.line.double-slash.titan",
      "begin": "//",
      "end": "$"
    },
    "attribute": {
      "patterns": [
        {
          "name": "meta.attribute.titan",
          "begin": "#!?\\[",
          "end": "\\]",
          "patterns": [
            { "include": "#string" },
            { "include": "#block_comment" },
            { "include": "#line_comment" }
          ]
        }
      ]
    },
    "lifetime": {
      "name": "entity.name.lifetime.titan",
      "match": "'[a-zA-Z_][a-zA-Z0-9_]*\\b"
    },
    "string": {
      "name": "string.quoted.double.titan",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.titan",
          "match": "\\\\(n|t|r|\\\\|\"|\\'|0|x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F]+\\})"
        }
      ]
    },
    "char_literal": {
      "name": "string.quoted.single.titan",
      "match": "'([^'\\\\]|\\\\(n|t|r|\\\\|'|0|x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F]+\\}))'"
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.float.titan",
          "match": "\\b(\\d[\\d_]*)\\.(\\d[\\d_]*)([eE][+-]?\\d[\\d_]*)?(f32|f64)?\\b"
        },
        {
          "name": "constant.numeric.hex.titan",
          "match": "\\b0x[0-9a-fA-F][0-9a-fA-F_]*(u8|u16|u32|u64|u128|i8|i16|i32|i64|i128|usize|isize)?\\b"
        },
        {
          "name": "constant.numeric.binary.titan",
          "match": "\\b0b[01][01_]*(u8|u16|u32|u64|u128|i8|i16|i32|i64|i128|usize|isize)?\\b"
        },
        {
          "name": "constant.numeric.octal.titan",
          "match": "\\b0o[0-7][0-7_]*(u8|u16|u32|u64|u128|i8|i16|i32|i64|i128|usize|isize)?\\b"
        },
        {
          "name": "constant.numeric.integer.titan",
          "match": "\\b\\d[\\d_]*(u8|u16|u32|u64|u128|i8|i16|i32|i64|i128|usize|isize)?\\b"
        }
      ]
    },
    "fn_definition": {
      "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
      "captures": {
        "1": { "name": "keyword.other.fn.titan" },
        "2": { "name": "entity.name.function.titan" }
      }
    },
    "struct_definition": {
      "match": "\\b(struct)\\s+([A-Z][a-zA-Z0-9_]*)\\b",
      "captures": {
        "1": { "name": "keyword.other.struct.titan" },
        "2": { "name": "entity.name.type.struct.titan" }
      }
    },
    "enum_definition": {
      "match": "\\b(enum)\\s+([A-Z][a-zA-Z0-9_]*)\\b",
      "captures": {
        "1": { "name": "keyword.other.enum.titan" },
        "2": { "name": "entity.name.type.enum.titan" }
      }
    },
    "impl_definition": {
      "match": "\\b(impl)\\s+(<[^>]*>\\s*)?([A-Z][a-zA-Z0-9_]*)\\b",
      "captures": {
        "1": { "name": "keyword.other.impl.titan" },
        "3": { "name": "entity.name.type.impl.titan" }
      }
    },
    "mod_definition": {
      "match": "\\b(mod)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
      "captures": {
        "1": { "name": "keyword.other.mod.titan" },
        "2": { "name": "entity.name.namespace.titan" }
      }
    },
    "macro_invocation": {
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(!)",
      "captures": {
        "1": { "name": "entity.name.function.macro.titan" },
        "2": { "name": "punctuation.definition.macro.titan" }
      }
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.titan",
          "match": "\\b(if|else|for|while|loop|match|return|break|continue|in|where|async|await|yield)\\b"
        },
        {
          "name": "keyword.other.titan",
          "match": "\\b(use|pub|let|mut|ref|as|move|dyn|extern|unsafe|type|trait)\\b"
        },
        {
          "name": "keyword.operator.titan",
          "match": "\\b(and|or|not|is)\\b"
        }
      ]
    },
    "self_keyword": {
      "patterns": [
        {
          "name": "variable.language.self.titan",
          "match": "\\bself\\b"
        },
        {
          "name": "entity.name.type.self.titan",
          "match": "\\bSelf\\b"
        }
      ]
    },
    "constant": {
      "patterns": [
        {
          "name": "constant.language.titan",
          "match": "\\b(true|false|None|Some|Ok|Err)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.primitive.titan",
          "match": "\\b(u8|u16|u32|u64|u128|i8|i16|i32|i64|i128|f32|f64|bool|str|char|usize|isize|())\\b"
        },
        {
          "name": "entity.name.type.builtin.titan",
          "match": "\\b(String|Vec|HashMap|HashSet|Option|Result|Box|Rc|Arc|Cell|RefCell|Mutex|RwLock|Pin|PhantomData|Iterator|IntoIterator|From|Into|Default|Clone|Copy|Drop|Send|Sync|Fn|FnMut|FnOnce)\\b"
        }
      ]
    },
    "storage_modifiers": {
      "name": "storage.modifier.titan",
      "match": "\\b(pub|mut|ref|const|static|unsafe|extern|async|move|dyn)\\b"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.titan",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.range.titan",
          "match": "\\.\\.|\\.\\.="
        },
        {
          "name": "keyword.operator.comparison.titan",
          "match": "==|!=|<=|>=|<(?!<)|>(?!>)"
        },
        {
          "name": "keyword.operator.logical.titan",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.bitwise.titan",
          "match": "&|\\||\\^|<<|>>|~"
        },
        {
          "name": "keyword.operator.arithmetic.titan",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.assignment.titan",
          "match": "=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>="
        },
        {
          "name": "keyword.operator.question.titan",
          "match": "\\?"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.brackets.curly.titan", "match": "[{}]" },
        { "name": "punctuation.brackets.round.titan", "match": "[()]" },
        { "name": "punctuation.brackets.square.titan", "match": "[\\[\\]]" },
        { "name": "punctuation.brackets.angle.titan", "match": "(?<![=!<>])[<>](?![=])" },
        { "name": "punctuation.separator.semicolon.titan", "match": ";" },
        { "name": "punctuation.separator.colon.titan", "match": "::" },
        { "name": "punctuation.separator.comma.titan", "match": "," },
        { "name": "punctuation.separator.dot.titan", "match": "\\." }
      ]
    }
  }
}
