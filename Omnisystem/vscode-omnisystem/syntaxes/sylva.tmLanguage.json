{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SYLVA",
  "scopeName": "source.sylva",
  "fileTypes": ["sylva"],
  "patterns": [
    { "include": "#block_comment" },
    { "include": "#line_comment" },
    { "include": "#layer_definition" },
    { "include": "#model_definition" },
    { "include": "#fn_definition" },
    { "include": "#activation_functions" },
    { "include": "#string" },
    { "include": "#number" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#constant" }
  ],
  "repository": {
    "block_comment": {
      "name": "comment.block.sylva",
      "begin": "/\\*",
      "end": "\\*/",
      "patterns": [{ "include": "#block_comment" }]
    },
    "line_comment": {
      "name": "comment.line.double-slash.sylva",
      "begin": "//",
      "end": "$"
    },
    "layer_definition": {
      "match": "\\b(layer)\\s+([A-Z][a-zA-Z0-9_]*)\\b",
      "captures": {
        "1": { "name": "keyword.declaration.layer.sylva" },
        "2": { "name": "entity.name.class.layer.sylva" }
      }
    },
    "model_definition": {
      "match": "\\b(model)\\s+([A-Z][a-zA-Z0-9_]*)\\b",
      "captures": {
        "1": { "name": "keyword.declaration.model.sylva" },
        "2": { "name": "entity.name.class.model.sylva" }
      }
    },
    "fn_definition": {
      "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
      "captures": {
        "1": { "name": "keyword.other.fn.sylva" },
        "2": { "name": "entity.name.function.sylva" }
      }
    },
    "activation_functions": {
      "name": "support.function.activation.sylva",
      "match": "\\b(relu|sigmoid|tanh|softmax|gelu|leaky_relu|elu|selu|swish|mish|prelu|hardswish|hardsigmoid|linear|identity)\\b"
    },
    "string": {
      "name": "string.quoted.double.sylva",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.sylva", "match": "\\\\[ntr\\\\\"']" }
      ]
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.float.sylva",
          "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*([eE][+-]?\\d[\\d_]*)?(f32|f64)?\\b"
        },
        {
          "name": "constant.numeric.integer.sylva",
          "match": "\\b\\d[\\d_]*(u8|u16|u32|u64|i8|i16|i32|i64|usize)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.declaration.sylva",
          "match": "\\b(layer|model|architecture|train|forward|backward|loss|optimizer)\\b"
        },
        {
          "name": "keyword.declaration.layer-type.sylva",
          "match": "\\b(dense|conv2d|conv3d|maxpool2d|avgpool2d|dropout|batchnorm|layernorm|embedding|lstm|gru|rnn|attention|multihead_attention|transformer|flatten|reshape|upsample|depthwise_conv2d|separable_conv2d)\\b"
        },
        {
          "name": "keyword.declaration.optimizer.sylva",
          "match": "\\b(adam|sgd|rmsprop|adagrad|adadelta|adamw|nadam|radam|lookahead)\\b"
        },
        {
          "name": "keyword.declaration.loss.sylva",
          "match": "\\b(cross_entropy|mse|mae|binary_cross_entropy|categorical_cross_entropy|kl_divergence|huber|hinge|cosine_similarity)\\b"
        },
        {
          "name": "keyword.control.sylva",
          "match": "\\b(if|else|for|while|return|break|continue|in|match)\\b"
        },
        {
          "name": "keyword.other.sylva",
          "match": "\\b(let|mut|fn|pub|use|struct|enum|ref|as)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.primitive.sylva",
          "match": "\\b(f32|f64|u8|u16|u32|u64|i8|i16|i32|i64|bool|str|String|usize)\\b"
        },
        {
          "name": "entity.name.type.tensor.sylva",
          "match": "\\b(Tensor|Tensor2D|Tensor3D|Tensor4D|TensorND|Shape|DataType|Device|Backend)\\b"
        },
        {
          "name": "entity.name.type.builtin.sylva",
          "match": "\\b(Vec|HashMap|Option|Result)\\b"
        }
      ]
    },
    "constant": {
      "name": "constant.language.sylva",
      "match": "\\b(true|false|None|Some|Ok|Err|CPU|GPU|CUDA|Metal|Vulkan)\\b"
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.arrow.sylva", "match": "->" },
        { "name": "keyword.operator.comparison.sylva", "match": "==|!=|<=|>=" },
        { "name": "keyword.operator.logical.sylva", "match": "&&|\\|\\||!" },
        { "name": "keyword.operator.arithmetic.sylva", "match": "\\+|-|\\*|/|%" },
        { "name": "keyword.operator.assignment.sylva", "match": "=" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.brackets.curly.sylva", "match": "[{}]" },
        { "name": "punctuation.brackets.round.sylva", "match": "[()]" },
        { "name": "punctuation.brackets.square.sylva", "match": "[\\[\\]]" },
        { "name": "punctuation.separator.semicolon.sylva", "match": ";" },
        { "name": "punctuation.separator.comma.sylva", "match": "," },
        { "name": "punctuation.separator.dot.sylva", "match": "\\." }
      ]
    }
  }
}
