{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "AXIOM",
  "scopeName": "source.axiom",
  "fileTypes": ["axiom"],
  "patterns": [
    { "include": "#block_comment" },
    { "include": "#line_comment" },
    { "include": "#theorem_definition" },
    { "include": "#fn_definition" },
    { "include": "#string" },
    { "include": "#number" },
    { "include": "#verification_calls" },
    { "include": "#quantifiers" },
    { "include": "#logic_operators" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#constant" }
  ],
  "repository": {
    "block_comment": {
      "name": "comment.block.axiom",
      "begin": "/\\*",
      "end": "\\*/",
      "patterns": [{ "include": "#block_comment" }]
    },
    "line_comment": {
      "name": "comment.line.double-slash.axiom",
      "begin": "//",
      "end": "$"
    },
    "theorem_definition": {
      "match": "\\b(theorem)\\s+([A-Z][a-zA-Z0-9_]*)\\b",
      "captures": {
        "1": { "name": "keyword.declaration.theorem.axiom" },
        "2": { "name": "entity.name.type.theorem.axiom" }
      }
    },
    "fn_definition": {
      "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
      "captures": {
        "1": { "name": "keyword.other.fn.axiom" },
        "2": { "name": "entity.name.function.axiom" }
      }
    },
    "verification_calls": {
      "name": "support.function.verification.axiom",
      "match": "\\b(verify|prove|check|assert|assume|lemma|corollary|axiom)\\b(?=\\s*[({]|\\s)"
    },
    "quantifiers": {
      "name": "keyword.control.quantifier.axiom",
      "match": "\\b(for_all|there_exists|exists|forall)\\b"
    },
    "logic_operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.axiom",
          "match": "\\b(implies|iff|and|or|not|xor)\\b"
        },
        {
          "name": "keyword.operator.logical.symbolic.axiom",
          "match": "=>|<=>|&&|\\|\\||!"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.declaration.axiom",
          "match": "\\b(theorem|preconditions|postconditions|invariants|assertions|domain|requires|ensures|modifies)\\b"
        },
        {
          "name": "keyword.control.axiom",
          "match": "\\b(if|else|for|while|return|break|continue|in|match)\\b"
        },
        {
          "name": "keyword.other.axiom",
          "match": "\\b(let|mut|fn|pub|use|struct|enum|type|where)\\b"
        }
      ]
    },
    "string": {
      "name": "string.quoted.double.axiom",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.axiom", "match": "\\\\[ntr\\\\\"']" }
      ]
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.float.axiom",
          "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*(f32|f64)?\\b"
        },
        {
          "name": "constant.numeric.integer.axiom",
          "match": "\\b\\d[\\d_]*(u8|u16|u32|u64|i8|i16|i32|i64|usize|isize)?\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.primitive.axiom",
          "match": "\\b(u8|u16|u32|u64|i8|i16|i32|i64|f32|f64|bool|str|String|usize|isize|Int|Real|Bool|Set|Seq|Map)\\b"
        }
      ]
    },
    "constant": {
      "name": "constant.language.axiom",
      "match": "\\b(true|false|None|Some|Ok|Err|⊤|⊥)\\b"
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.comparison.axiom", "match": "==|!=|<=|>=|<|>" },
        { "name": "keyword.operator.arithmetic.axiom", "match": "\\+|-|\\*|/|%" },
        { "name": "keyword.operator.assignment.axiom", "match": ":=|=" },
        { "name": "keyword.operator.arrow.axiom", "match": "->" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.brackets.curly.axiom", "match": "[{}]" },
        { "name": "punctuation.brackets.round.axiom", "match": "[()]" },
        { "name": "punctuation.brackets.square.axiom", "match": "[\\[\\]]" },
        { "name": "punctuation.separator.semicolon.axiom", "match": ";" },
        { "name": "punctuation.separator.comma.axiom", "match": "," },
        { "name": "punctuation.separator.colon.axiom", "match": ":" }
      ]
    }
  }
}
