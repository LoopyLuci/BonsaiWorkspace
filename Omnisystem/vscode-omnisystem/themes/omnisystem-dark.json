  "tokenColors": [
    { "name": "Comment", "scope": "comment", "settings": { "foreground": "#2A5A7A", "fontStyle": "italic" } },
    { "name": "Comment line", "scope": "comment.line", "settings": { "foreground": "#2A5A7A" } },
    { "name": "Comment block", "scope": "comment.block", "settings": { "foreground": "#2A5A7A" } },

    { "name": "Keywords", "scope": ["keyword", "keyword.control", "keyword.operator", "storage.type", "storage.modifier"], "settings": { "foreground": "#0099FF", "fontStyle": "bold" } },
    { "name": "TITAN keywords", "scope": ["keyword.control.titan", "storage.type.titan"], "settings": { "foreground": "#00D4FF", "fontStyle": "bold" } },
    { "name": "VERA keywords", "scope": ["keyword.control.vera", "storage.type.vera"], "settings": { "foreground": "#AA66FF", "fontStyle": "bold" } },
    { "name": "HELIX keywords", "scope": ["keyword.control.helix", "storage.type.helix"], "settings": { "foreground": "#00FFCC", "fontStyle": "bold" } },
    { "name": "AETHER keywords", "scope": ["keyword.control.aether", "storage.type.aether"], "settings": { "foreground": "#FFB800", "fontStyle": "bold" } },
    { "name": "AXIOM keywords", "scope": ["keyword.control.axiom", "storage.type.axiom"], "settings": { "foreground": "#FF4488", "fontStyle": "bold" } },
    { "name": "SYLVA keywords", "scope": ["keyword.control.sylva", "storage.type.sylva"], "settings": { "foreground": "#00FF88", "fontStyle": "bold" } },
    { "name": "NEXUS keywords", "scope": ["keyword.control.nexus", "storage.type.nexus"], "settings": { "foreground": "#FF8844", "fontStyle": "bold" } },

    { "name": "Strings", "scope": ["string", "string.quoted"], "settings": { "foreground": "#00FF88" } },
    { "name": "Template literals", "scope": ["string.template", "meta.template.expression"], "settings": { "foreground": "#00EE77" } },
    { "name": "Numbers", "scope": ["constant.numeric", "constant.numeric.integer", "constant.numeric.float", "constant.numeric.hex"], "settings": { "foreground": "#FFB800" } },
    { "name": "Boolean", "scope": ["constant.language.boolean", "constant.language.null", "constant.language.undefined"], "settings": { "foreground": "#00D4FF" } },
    { "name": "Constants", "scope": ["constant", "constant.language", "variable.other.constant"], "settings": { "foreground": "#FFB800" } },

    { "name": "Functions", "scope": ["entity.name.function", "meta.function-call.generic", "support.function"], "settings": { "foreground": "#00D4FF" } },
    { "name": "Function parameters", "scope": ["variable.parameter"], "settings": { "foreground": "#88AACC", "fontStyle": "italic" } },
    { "name": "Types", "scope": ["entity.name.type", "entity.name.class", "entity.name.struct", "entity.name.enum", "entity.name.trait"], "settings": { "foreground": "#00FF88", "fontStyle": "" } },
    { "name": "Type parameters", "scope": ["entity.name.type.parameter", "punctuation.definition.generic"], "settings": { "foreground": "#FFB800" } },
    { "name": "Modules/namespaces", "scope": ["entity.name.module", "entity.name.namespace", "entity.name.scope-resolution"], "settings": { "foreground": "#88AACC" } },
    { "name": "Members/properties", "scope": ["variable.other.member", "variable.other.property", "support.variable.property"], "settings": { "foreground": "#88CCEE" } },

    { "name": "Variables", "scope": ["variable", "variable.other", "variable.other.readwrite"], "settings": { "foreground": "#C8D8E8" } },
    { "name": "Self/this", "scope": ["variable.language.self", "variable.language.this", "variable.language.super"], "settings": { "foreground": "#00D4FF", "fontStyle": "italic" } },

    { "name": "Operators", "scope": ["keyword.operator", "punctuation.separator.dot-access"], "settings": { "foreground": "#C8D8E8" } },
    { "name": "Punctuation", "scope": ["punctuation", "punctuation.separator", "punctuation.terminator"], "settings": { "foreground": "#4A6A8A" } },
    { "name": "Brackets", "scope": ["punctuation.definition.brackets", "punctuation.section.block", "punctuation.section.group"], "settings": { "foreground": "#6A8AAA" } },

    { "name": "Lifetime annotations (TITAN)", "scope": ["punctuation.definition.lifetime.titan", "entity.name.lifetime.titan"], "settings": { "foreground": "#FF8844" } },
    { "name": "Macros", "scope": ["meta.macro", "entity.name.function.macro", "keyword.other.macro"], "settings": { "foreground": "#AA66FF" } },
    { "name": "Attributes/decorators", "scope": ["meta.attribute", "punctuation.definition.attribute"], "settings": { "foreground": "#88AACC", "fontStyle": "italic" } },

    { "name": "HTML tags", "scope": ["entity.name.tag", "meta.tag", "punctuation.definition.tag"], "settings": { "foreground": "#FF4488" } },
    { "name": "HTML attributes", "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#FFB800" } },
    { "name": "CSS properties", "scope": ["support.type.property-name.css", "meta.property-name.css"], "settings": { "foreground": "#00D4FF" } },
    { "name": "CSS values", "scope": ["support.constant.property-value.css", "meta.property-value.css"], "settings": { "foreground": "#00FF88" } },
    { "name": "CSS selectors", "scope": ["entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css"], "settings": { "foreground": "#FFB800" } },

    { "name": "Shader builtins (HELIX)", "scope": ["support.function.builtin.helix", "variable.language.helix"], "settings": { "foreground": "#00FFCC" } },
    { "name": "Shader types (HELIX)", "scope": ["support.type.helix"], "settings": { "foreground": "#00FFCC", "fontStyle": "italic" } },
    { "name": "Actor/message (AETHER)", "scope": ["entity.name.actor.aether", "entity.name.message.aether"], "settings": { "foreground": "#FFB800" } },
    { "name": "Theorem (AXIOM)", "scope": ["entity.name.theorem.axiom"], "settings": { "foreground": "#FF4488" } },
    { "name": "Layer/model (SYLVA)", "scope": ["entity.name.layer.sylva", "entity.name.model.sylva"], "settings": { "foreground": "#00FF88" } },
    { "name": "Layout (NEXUS)", "scope": ["entity.name.layout.nexus"], "settings": { "foreground": "#FF8844" } },

    { "name": "JSON keys", "scope": ["support.type.property-name.json"], "settings": { "foreground": "#00D4FF" } },
    { "name": "TOML keys", "scope": ["keyword.key.toml", "support.type.property-name.toml"], "settings": { "foreground": "#00D4FF" } },
    { "name": "YAML keys", "scope": ["entity.name.tag.yaml"], "settings": { "foreground": "#00D4FF" } },
    { "name": "Markdown headings", "scope": ["markup.heading"], "settings": { "foreground": "#00D4FF", "fontStyle": "bold" } },
    { "name": "Markdown bold", "scope": ["markup.bold"], "settings": { "foreground": "#FFB800", "fontStyle": "bold" } },
    { "name": "Markdown italic", "scope": ["markup.italic"], "settings": { "foreground": "#88AACC", "fontStyle": "italic" } },
    { "name": "Markdown code", "scope": ["markup.inline.raw", "markup.fences"], "settings": { "foreground": "#00FF88" } },
    { "name": "Markdown link", "scope": ["markup.underline.link"], "settings": { "foreground": "#00D4FF" } },

    { "name": "Invalid/error", "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#FF4444", "fontStyle": "underline" } },
    { "name": "Deprecated", "scope": ["invalid.deprecated"], "settings": { "foreground": "#FFB800", "fontStyle": "strikethrough" } }
  ],
  "semanticTokenColors": {
    "type": "#00FF88",
    "class": "#00FF88",
    "struct": "#00FF88",
    "enum": "#00FF88",
    "interface": "#00FF88",
    "typeParameter": "#FFB800",
    "function": "#00D4FF",
    "method": "#00D4FF",
    "property": "#88CCEE",
    "variable": "#C8D8E8",
    "parameter": { "foreground": "#88AACC", "italic": true },
    "enumMember": "#FFB800",
    "namespace": "#88AACC",
    "macro": "#AA66FF",
    "lifetime": "#FF8844",
    "keyword": { "foreground": "#0099FF", "bold": true },
    "modifier": { "foreground": "#0099FF", "bold": true },
    "comment": { "foreground": "#2A5A7A", "italic": true },
    "string": "#00FF88",
    "number": "#FFB800",
    "regexp": "#00FFCC",
    "operator": "#C8D8E8",
    "decorator": { "foreground": "#88AACC", "italic": true },
    "label": "#FFB800",
    "selfKeyword": { "foreground": "#00D4FF", "italic": true }
  }
