// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════
// OMNISYSTEM ADVANCED SECURITY - THREAT DETECTION & DATA LOSS PREVENTION
// Anomaly detection, behavioral analysis, DLP rules, threat hunting, forensics
// Language: TITAN (Systems Language)
// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════

use std::collections::HashMap;

pub struct AdvancedSecurity {
    pub security_id: String,
    pub threat_detector: ThreatDetector,
    pub dlp_engine: DLPEngine,
    pub behavior_analyzer: BehaviorAnalyzer,
    pub forensics_system: ForensicsSystem,
    pub threat_intelligence: ThreatIntelligence,
}

pub struct ThreatDetector {
    pub detector_id: String,
    pub signatures: HashMap<String, ThreatSignature>,
    pub detection_rules: Vec<DetectionRule>,
    pub alerts: Vec<SecurityAlert>,
    pub ml_model: AnomalyDetectionModel,
}

pub struct ThreatSignature {
    pub sig_id: String,
    pub sig_name: String,
    pub pattern: String,
    pub threat_type: ThreatType,
    pub severity: ThreatSeverity,
    pub enabled: bool,
}

#[derive(Clone, Copy, Debug)]
pub enum ThreatType {
    Malware,
    APT,
    Ransomware,
    Exploit,
    WebShell,
    PrivilegeEscalation,
    LateralMovement,
    DataExfiltration,
    C2Communication,
}

#[derive(Clone, Copy, Debug)]
pub enum ThreatSeverity {
    Critical,
    High,
    Medium,
    Low,
    Info,
}

pub struct DetectionRule {
    pub rule_id: String,
    pub rule_name: String,
    pub detection_logic: String,
    pub data_source: String,
    pub enabled: bool,
}

pub struct SecurityAlert {
    pub alert_id: String,
    pub alert_name: String,
    pub threat_type: ThreatType,
    pub severity: ThreatSeverity,
    pub timestamp: u64,
    pub source: String,
    pub target: String,
    pub description: String,
    pub remediation_steps: Vec<String>,
}

pub struct AnomalyDetectionModel {
    pub model_id: String,
    pub model_type: ModelType,
    pub accuracy: f64,
    pub training_samples: u32,
    pub last_trained: u64,
}

#[derive(Clone, Copy, Debug)]
pub enum ModelType {
    IsolationForest,
    LocalOutlierFactor,
    OneClassSVM,
    AutoEncoder,
}

pub struct DLPEngine {
    pub engine_id: String,
    pub policies: HashMap<String, DLPPolicy>,
    pub rules: Vec<DLPRule>,
    pub violations: Vec<DLPViolation>,
    pub data_classifications: HashMap<String, DataClassification>,
}

pub struct DLPPolicy {
    pub policy_id: String,
    pub policy_name: String,
    pub description: String,
    pub enabled: bool,
    pub enforcement_mode: EnforcementMode,
}

#[derive(Clone, Copy, Debug)]
pub enum EnforcementMode {
    Audit,
    Block,
    Alert,
    Quarantine,
}

pub struct DLPRule {
    pub rule_id: String,
    pub rule_name: String,
    pub rule_type: DLPRuleType,
    pub trigger_condition: String,
    pub action: String,
}

#[derive(Clone, Copy, Debug)]
pub enum DLPRuleType {
    ContentMatching,
    FileType,
    Size,
    Destination,
    DataClassification,
}

pub struct DLPViolation {
    pub violation_id: String,
    pub timestamp: u64,
    pub user_id: String,
    pub resource: String,
    pub rule_triggered: String,
    pub action_taken: String,
    pub data_exposed: bool,
}

pub struct DataClassification {
    pub class_id: String,
    pub class_name: String,
    pub class_level: DataLevel,
    pub protection_requirements: Vec<String>,
}

#[derive(Clone, Copy, Debug)]
pub enum DataLevel {
    Public,
    Internal,
    Confidential,
    Secret,
    TopSecret,
}

pub struct BehaviorAnalyzer {
    pub analyzer_id: String,
    pub baselines: HashMap<String, BehaviorBaseline>,
    pub deviations: Vec<BehaviorDeviation>,
    pub user_profiles: HashMap<String, UserProfile>,
}

pub struct BehaviorBaseline {
    pub baseline_id: String,
    pub entity_id: String,
    pub entity_type: EntityType,
    pub baseline_data: HashMap<String, f64>,
    pub last_updated: u64,
}

#[derive(Clone, Copy, Debug)]
pub enum EntityType {
    User,
    Service,
    Host,
    Process,
}

pub struct BehaviorDeviation {
    pub deviation_id: String,
    pub timestamp: u64,
    pub entity_id: String,
    pub deviation_type: String,
    pub anomaly_score: f64,
    pub description: String,
}

pub struct UserProfile {
    pub profile_id: String,
    pub user_id: String,
    pub typical_login_hours: Vec<u32>,
    pub typical_locations: Vec<String>,
    pub typical_activities: Vec<String>,
    pub risk_score: f64,
}

pub struct ForensicsSystem {
    pub forensics_id: String,
    pub evidence_collection: EvidenceCollector,
    pub timeline_analyzer: TimelineAnalyzer,
    pub impact_assessor: ImpactAssessor,
}

pub struct EvidenceCollector {
    pub collector_id: String,
    pub evidence_items: Vec<EvidenceItem>,
    pub chain_of_custody: Vec<CustodyRecord>,
}

pub struct EvidenceItem {
    pub item_id: String,
    pub item_type: String,
    pub source: String,
    pub timestamp: u64,
    pub hash: String,
    pub size_bytes: u64,
}

pub struct CustodyRecord {
    pub record_id: String,
    pub evidence_id: String,
    pub handler: String,
    pub action: String,
    pub timestamp: u64,
}

pub struct TimelineAnalyzer {
    pub analyzer_id: String,
    pub events: Vec<ForensicEvent>,
}

pub struct ForensicEvent {
    pub event_id: String,
    pub timestamp: u64,
    pub event_type: String,
    pub source: String,
    pub details: HashMap<String, String>,
}

pub struct ImpactAssessor {
    pub assessor_id: String,
    pub affected_systems: Vec<String>,
    pub affected_users: Vec<String>,
    pub estimated_impact: ImpactLevel,
}

#[derive(Clone, Copy, Debug)]
pub enum ImpactLevel {
    Critical,
    High,
    Medium,
    Low,
    Minimal,
}

pub struct ThreatIntelligence {
    pub ti_id: String,
    pub indicators: HashMap<String, ThreatIndicator>,
    pub campaigns: Vec<APTCampaign>,
    pub feeds: Vec<IntelligenceFeed>,
}

pub struct ThreatIndicator {
    pub indicator_id: String,
    pub indicator_type: IndicatorType,
    pub value: String,
    pub threat_level: ThreatSeverity,
    pub source: String,
    pub last_seen: u64,
}

#[derive(Clone, Copy, Debug)]
pub enum IndicatorType {
    IPAddress,
    Domain,
    FileHash,
    Email,
    URL,
    Mutex,
    RegistryKey,
}

pub struct APTCampaign {
    pub campaign_id: String,
    pub campaign_name: String,
    pub threat_actor: String,
    pub known_targets: Vec<String>,
    pub known_ttps: Vec<String>,
    pub activity_status: ActivityStatus,
}

#[derive(Clone, Copy, Debug)]
pub enum ActivityStatus {
    Active,
    Dormant,
    Retired,
    Unknown,
}

pub struct IntelligenceFeed {
    pub feed_id: String,
    pub feed_name: String,
    pub source_url: String,
    pub update_frequency: String,
    pub enabled: bool,
    pub last_updated: u64,
}

impl AdvancedSecurity {
    pub fn new() -> Self {
        AdvancedSecurity {
            security_id: "adv-sec-1".to_string(),
            threat_detector: ThreatDetector {
                detector_id: "td-1".to_string(),
                signatures: HashMap::new(),
                detection_rules: Vec::new(),
                alerts: Vec::new(),
                ml_model: AnomalyDetectionModel {
                    model_id: "model-1".to_string(),
                    model_type: ModelType::IsolationForest,
                    accuracy: 0.94,
                    training_samples: 50000,
                    last_trained: current_timestamp(),
                },
            },
            dlp_engine: DLPEngine {
                engine_id: "dlp-1".to_string(),
                policies: HashMap::new(),
                rules: Vec::new(),
                violations: Vec::new(),
                data_classifications: HashMap::new(),
            },
            behavior_analyzer: BehaviorAnalyzer {
                analyzer_id: "ba-1".to_string(),
                baselines: HashMap::new(),
                deviations: Vec::new(),
                user_profiles: HashMap::new(),
            },
            forensics_system: ForensicsSystem {
                forensics_id: "fs-1".to_string(),
                evidence_collection: EvidenceCollector {
                    collector_id: "ec-1".to_string(),
                    evidence_items: Vec::new(),
                    chain_of_custody: Vec::new(),
                },
                timeline_analyzer: TimelineAnalyzer {
                    analyzer_id: "ta-1".to_string(),
                    events: Vec::new(),
                },
                impact_assessor: ImpactAssessor {
                    assessor_id: "ia-1".to_string(),
                    affected_systems: Vec::new(),
                    affected_users: Vec::new(),
                    estimated_impact: ImpactLevel::Medium,
                },
            },
            threat_intelligence: ThreatIntelligence {
                ti_id: "ti-1".to_string(),
                indicators: HashMap::new(),
                campaigns: Vec::new(),
                feeds: Vec::new(),
            },
        }
    }

    pub fn add_threat_signature(&mut self, name: &str, pattern: &str, threat_type: ThreatType, severity: ThreatSeverity) -> Result<String, String> {
        let sig_id = format!("sig_{}", hash_string(&format!("{}{}", name, pattern)));

        let signature = ThreatSignature {
            sig_id: sig_id.clone(),
            sig_name: name.to_string(),
            pattern: pattern.to_string(),
            threat_type,
            severity,
            enabled: true,
        };

        self.threat_detector.signatures.insert(sig_id.clone(), signature);
        println!("Added threat signature: {} ({:?})", name, threat_type);
        Ok(sig_id)
    }

    pub fn create_dlp_policy(&mut self, name: &str, enforcement_mode: EnforcementMode) -> Result<String, String> {
        let policy_id = format!("dlp_policy_{}", hash_string(&format!("{}{:?}", name, enforcement_mode)));

        let policy = DLPPolicy {
            policy_id: policy_id.clone(),
            policy_name: name.to_string(),
            description: format!("Data Loss Prevention policy: {}", name),
            enabled: true,
            enforcement_mode,
        };

        self.dlp_engine.policies.insert(policy_id.clone(), policy);
        println!("Created DLP policy: {} ({:?})", name, enforcement_mode);
        Ok(policy_id)
    }

    pub fn classify_data(&mut self, class_name: &str, level: DataLevel) -> Result<String, String> {
        let class_id = format!("class_{}", hash_string(&format!("{}{:?}", class_name, level)));

        let classification = DataClassification {
            class_id: class_id.clone(),
            class_name: class_name.to_string(),
            class_level: level,
            protection_requirements: match level {
                DataLevel::Public => vec!["No encryption required".to_string()],
                DataLevel::Internal => vec!["Basic encryption".to_string()],
                DataLevel::Confidential => vec!["AES-256 encryption".to_string(), "Restricted access".to_string()],
                DataLevel::Secret => vec!["AES-256 encryption".to_string(), "MFA required".to_string(), "Audit logging".to_string()],
                DataLevel::TopSecret => vec!["AES-256 encryption".to_string(), "MFA required".to_string(), "Physical security".to_string()],
            },
        };

        self.dlp_engine.data_classifications.insert(class_id.clone(), classification);
        println!("Classified data: {} ({:?})", class_name, level);
        Ok(class_id)
    }

    pub fn analyze_behavior(&mut self, user_id: &str) -> Result<String, String> {
        let profile_id = format!("profile_{}", hash_string(&format!("user_{}", user_id)));

        let profile = UserProfile {
            profile_id: profile_id.clone(),
            user_id: user_id.to_string(),
            typical_login_hours: vec![9, 10, 11, 12, 13, 14, 15, 16, 17],
            typical_locations: vec!["New York".to_string(), "Office".to_string()],
            typical_activities: vec!["Email".to_string(), "File Access".to_string(), "Code Review".to_string()],
            risk_score: 0.15,
        };

        self.behavior_analyzer.user_profiles.insert(profile_id.clone(), profile);
        println!("Analyzed behavior for user: {}", user_id);
        Ok(profile_id)
    }

    pub fn add_intelligence_feed(&mut self, name: &str, source_url: &str) -> Result<String, String> {
        let feed_id = format!("feed_{}", hash_string(&format!("{}{}", name, source_url)));

        let feed = IntelligenceFeed {
            feed_id: feed_id.clone(),
            feed_name: name.to_string(),
            source_url: source_url.to_string(),
            update_frequency: "hourly".to_string(),
            enabled: true,
            last_updated: current_timestamp(),
        };

        self.threat_intelligence.feeds.push(feed);
        println!("Added intelligence feed: {}", name);
        Ok(feed_id)
    }

    pub fn detect_anomaly(&mut self, entity_id: &str, anomaly_score: f64) -> Result<String, String> {
        if anomaly_score > 0.8 {
            let deviation_id = format!("dev_{}", hash_string(&format!("{}{}", entity_id, current_timestamp())));

            let deviation = BehaviorDeviation {
                deviation_id: deviation_id.clone(),
                timestamp: current_timestamp(),
                entity_id: entity_id.to_string(),
                deviation_type: "Behavioral Anomaly".to_string(),
                anomaly_score,
                description: "Significant deviation from baseline behavior detected".to_string(),
            };

            self.behavior_analyzer.deviations.push(deviation);
            println!("Detected anomaly for entity: {} (score: {:.2})", entity_id, anomaly_score);
            Ok(deviation_id)
        } else {
            Ok("No anomaly".to_string())
        }
    }

    pub fn report_dlp_violation(&mut self, user_id: &str, resource: &str, rule_triggered: &str) -> Result<String, String> {
        let violation_id = format!("viol_{}", hash_string(&format!("{}{}{}", user_id, resource, current_timestamp())));

        let violation = DLPViolation {
            violation_id: violation_id.clone(),
            timestamp: current_timestamp(),
            user_id: user_id.to_string(),
            resource: resource.to_string(),
            rule_triggered: rule_triggered.to_string(),
            action_taken: "Block and Alert".to_string(),
            data_exposed: false,
        };

        self.dlp_engine.violations.push(violation);
        println!("DLP violation reported: {} attempted access to {}", user_id, resource);
        Ok(violation_id)
    }

    pub fn get_security_stats(&self) -> String {
        let active_alerts = self.threat_detector.alerts.iter().count();
        let dlp_violations = self.dlp_engine.violations.len();
        let behavior_deviations = self.behavior_analyzer.deviations.len();

        format!(
            "Advanced Security\nThreats: {}\nSignatures: {}\nDLP Policies: {}\nData Classes: {}\nAlerts: {}\nViolations: {}\nDeviations: {}",
            self.threat_detector.detection_rules.len(),
            self.threat_detector.signatures.len(),
            self.dlp_engine.policies.len(),
            self.dlp_engine.data_classifications.len(),
            active_alerts,
            dlp_violations,
            behavior_deviations
        )
    }
}

fn hash_string(s: &str) -> String {
    let mut hash: u64 = 5381;
    for c in s.chars() {
        hash = ((hash << 5).wrapping_add(hash)).wrapping_add(c as u64);
    }
    format!("{:x}", hash).chars().take(12).collect()
}

fn current_timestamp() -> u64 {
    std::time::SystemTime::now()
        .duration_since(std::time::UNIX_EPOCH)
        .unwrap_or_default()
        .as_secs()
}

pub fn main() {
    println!("╔═══════════════════════════════════════════════════════════════╗");
    println!("║    OMNISYSTEM ADVANCED SECURITY v3.0.0                       ║");
    println!("║      Threat Detection & Data Loss Prevention                 ║");
    println!("╚═══════════════════════════════════════════════════════════════╝\n");

    let mut security = AdvancedSecurity::new();

    let _ = security.add_threat_signature("Ransomware Pattern 1", ".*\\.(encrypted|locked)$", ThreatType::Ransomware, ThreatSeverity::Critical);
    let _ = security.add_threat_signature("C2 Domain", "malicious\\.domain\\.com", ThreatType::C2Communication, ThreatSeverity::High);

    let _ = security.create_dlp_policy("Restrict PII", EnforcementMode::Block);
    let _ = security.create_dlp_policy("Monitor Credit Cards", EnforcementMode::Alert);

    let _ = security.classify_data("Public Website Content", DataLevel::Public);
    let _ = security.classify_data("Internal Policies", DataLevel::Internal);
    let _ = security.classify_data("Customer Data", DataLevel::Confidential);
    let _ = security.classify_data("Trade Secrets", DataLevel::Secret);

    let _ = security.analyze_behavior("user123");
    let _ = security.analyze_behavior("user456");

    let _ = security.add_intelligence_feed("Abuse.ch Malware Hash Feed", "https://feeds.abuse.ch/");
    let _ = security.add_intelligence_feed("Shodan Vulnerability Feed", "https://feeds.shodan.io/");

    let _ = security.detect_anomaly("user123", 0.85);
    let _ = security.detect_anomaly("user456", 0.45);

    let _ = security.report_dlp_violation("user789", "sensitive_database", "PII_Detection_Rule");

    println!("\n{}", security.get_security_stats());
}
