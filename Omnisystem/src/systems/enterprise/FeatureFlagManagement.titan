// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════
// OMNISYSTEM FEATURE FLAG MANAGEMENT - DYNAMIC FEATURE CONTROL & ROLLOUTS
// Runtime toggles, gradual rollouts, A/B testing, audience targeting, audit trails
// Language: TITAN (Systems Language)
// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════

use std::collections::HashMap;

pub struct FeatureFlagManagement {
    pub manager_id: String,
    pub flags: HashMap<String, FeatureFlag>,
    pub evaluator: FlagEvaluator,
    pub rollout_engine: RolloutEngine,
    pub audit_log: Vec<FlagAuditEvent>,
}

pub struct FeatureFlag {
    pub flag_id: String,
    pub flag_name: String,
    pub description: String,
    pub enabled: bool,
    pub owner: String,
    pub created_at: u64,
    pub rules: Vec<FlagRule>,
    pub variants: Vec<Variant>,
}

pub struct FlagRule {
    pub rule_id: String,
    pub rule_name: String,
    pub conditions: Vec<Condition>,
    pub variant: String,
}

pub struct Condition {
    pub condition_id: String,
    pub attribute: String,
    pub operator: ConditionOperator,
    pub value: String,
}

#[derive(Clone, Copy, Debug)]
pub enum ConditionOperator {
    Equals,
    NotEquals,
    GreaterThan,
    LessThan,
    Contains,
    In,
}

pub struct Variant {
    pub variant_id: String,
    pub variant_name: String,
    pub traffic_allocation: u32,
    pub metadata: HashMap<String, String>,
}

pub struct FlagEvaluator {
    pub evaluator_id: String,
    pub evaluation_cache: HashMap<String, EvaluationResult>,
    pub cache_ttl_seconds: u32,
}

pub struct EvaluationResult {
    pub result_id: String,
    pub flag_name: String,
    pub user_id: String,
    pub enabled: bool,
    pub variant: String,
    pub timestamp: u64,
}

pub struct RolloutEngine {
    pub engine_id: String,
    pub rollouts: HashMap<String, Rollout>,
    pub rollout_history: Vec<RolloutEvent>,
}

pub struct Rollout {
    pub rollout_id: String,
    pub flag_id: String,
    pub status: RolloutStatus,
    pub target_percentage: u32,
    pub current_percentage: u32,
    pub created_at: u64,
    pub started_at: u64,
}

#[derive(Clone, Copy, Debug)]
pub enum RolloutStatus {
    Planning,
    InProgress,
    Paused,
    Completed,
    Rolled Back,
}

pub struct RolloutEvent {
    pub event_id: String,
    pub rollout_id: String,
    pub event_type: String,
    pub percentage: u32,
    pub timestamp: u64,
}

pub struct FlagAuditEvent {
    pub event_id: String,
    pub flag_id: String,
    pub timestamp: u64,
    pub actor: String,
    pub action: String,
    pub change_details: HashMap<String, String>,
}

impl FeatureFlagManagement {
    pub fn new() -> Self {
        FeatureFlagManagement {
            manager_id: "ffm-1".to_string(),
            flags: HashMap::new(),
            evaluator: FlagEvaluator {
                evaluator_id: "eval-1".to_string(),
                evaluation_cache: HashMap::new(),
                cache_ttl_seconds: 300,
            },
            rollout_engine: RolloutEngine {
                engine_id: "re-1".to_string(),
                rollouts: HashMap::new(),
                rollout_history: Vec::new(),
            },
            audit_log: Vec::new(),
        }
    }

    pub fn create_flag(&mut self, flag_name: &str, owner: &str) -> Result<String, String> {
        let flag_id = format!("flag_{}", hash_string(&format!("{}{}", flag_name, owner)));

        let flag = FeatureFlag {
            flag_id: flag_id.clone(),
            flag_name: flag_name.to_string(),
            description: String::new(),
            enabled: false,
            owner: owner.to_string(),
            created_at: current_timestamp(),
            rules: Vec::new(),
            variants: vec![
                Variant {
                    variant_id: "control".to_string(),
                    variant_name: "Control".to_string(),
                    traffic_allocation: 50,
                    metadata: HashMap::new(),
                },
                Variant {
                    variant_id: "treatment".to_string(),
                    variant_name: "Treatment".to_string(),
                    traffic_allocation: 50,
                    metadata: HashMap::new(),
                },
            ],
        };

        self.flags.insert(flag_id.clone(), flag);
        self.log_audit(flag_id.clone(), owner, "create_flag");
        println!("Created feature flag: {}", flag_name);
        Ok(flag_id)
    }

    pub fn enable_flag(&mut self, flag_id: &str) -> Result<(), String> {
        if let Some(flag) = self.flags.get_mut(flag_id) {
            flag.enabled = true;
            println!("Enabled flag: {}", flag.flag_name);
            Ok(())
        } else {
            Err("Flag not found".to_string())
        }
    }

    pub fn start_rollout(&mut self, flag_id: &str, target_percentage: u32) -> Result<String, String> {
        let rollout_id = format!("rollout_{}", hash_string(&format!("{}{}", flag_id, target_percentage)));

        let rollout = Rollout {
            rollout_id: rollout_id.clone(),
            flag_id: flag_id.to_string(),
            status: RolloutStatus::InProgress,
            target_percentage,
            current_percentage: 0,
            created_at: current_timestamp(),
            started_at: current_timestamp(),
        };

        self.rollout_engine.rollouts.insert(rollout_id.clone(), rollout);
        println!("Started rollout: {} at {}%", flag_id, target_percentage);
        Ok(rollout_id)
    }

    pub fn evaluate_flag(&mut self, flag_name: &str, user_id: &str) -> Result<(bool, String), String> {
        let result_id = format!("eval_{}", hash_string(&format!("{}{}", flag_name, user_id)));

        let flag = self.flags.values().find(|f| f.flag_name == flag_name);

        if let Some(f) = flag {
            let (enabled, variant) = if f.enabled {
                (true, f.variants[0].variant_name.clone())
            } else {
                (false, "off".to_string())
            };

            let result = EvaluationResult {
                result_id,
                flag_name: flag_name.to_string(),
                user_id: user_id.to_string(),
                enabled,
                variant: variant.clone(),
                timestamp: current_timestamp(),
            };

            self.evaluator.evaluation_cache.insert(format!("{}_{}", flag_name, user_id), result);
            println!("Evaluated flag {} for {}: {}", flag_name, user_id, enabled);
            Ok((enabled, variant))
        } else {
            Err("Flag not found".to_string())
        }
    }

    pub fn log_audit(&mut self, flag_id: String, actor: &str, action: &str) {
        let event = FlagAuditEvent {
            event_id: format!("audit_{}", hash_string(&format!("{}{}{}", flag_id, actor, current_timestamp()))),
            flag_id,
            timestamp: current_timestamp(),
            actor: actor.to_string(),
            action: action.to_string(),
            change_details: HashMap::new(),
        };
        self.audit_log.push(event);
    }

    pub fn get_stats(&self) -> String {
        format!(
            "Feature Flag Management\nFlags: {}\nActive Rollouts: {}\nAudit Events: {}\nCached Evaluations: {}",
            self.flags.len(),
            self.rollout_engine.rollouts.len(),
            self.audit_log.len(),
            self.evaluator.evaluation_cache.len()
        )
    }
}

fn hash_string(s: &str) -> String {
    let mut hash: u64 = 5381;
    for c in s.chars() {
        hash = ((hash << 5).wrapping_add(hash)).wrapping_add(c as u64);
    }
    format!("{:x}", hash).chars().take(12).collect()
}

fn current_timestamp() -> u64 {
    std::time::SystemTime::now()
        .duration_since(std::time::UNIX_EPOCH)
        .unwrap_or_default()
        .as_secs()
}

pub fn main() {
    println!("╔═══════════════════════════════════════════════════════════════╗");
    println!("║     OMNISYSTEM FEATURE FLAG MANAGEMENT v3.0.0                 ║");
    println!("║         Dynamic Feature Control & Rollouts                   ║");
    println!("╚═══════════════════════════════════════════════════════════════╝\n");

    let mut ffm = FeatureFlagManagement::new();

    let f1 = ffm.create_flag("new-ui", "product-team").expect("Failed");
    let f2 = ffm.create_flag("experimental-api", "engineering").expect("Failed");

    let _ = ffm.enable_flag(&f1);
    let _ = ffm.start_rollout(&f1, 25);
    let _ = ffm.start_rollout(&f2, 10);

    let _ = ffm.evaluate_flag("new-ui", "user-123");
    let _ = ffm.evaluate_flag("new-ui", "user-456");
    let _ = ffm.evaluate_flag("experimental-api", "user-789");

    println!("\n{}", ffm.get_stats());
}
