// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════
// OMNISYSTEM INCIDENT MANAGEMENT - ON-CALL SCHEDULING & INCIDENT TRACKING
// Incident creation, escalation, on-call management, runbooks, post-mortems, metrics
// Language: TITAN (Systems Language)
// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════

use std::collections::HashMap;

pub struct IncidentManagement {
    pub im_id: String,
    pub incidents: HashMap<String, Incident>,
    pub on_call_schedules: HashMap<String, OnCallSchedule>,
    pub escalation_policies: HashMap<String, EscalationPolicy>,
    pub runbooks: HashMap<String, Runbook>,
    pub post_mortems: HashMap<String, PostMortem>,
}

pub struct Incident {
    pub incident_id: String,
    pub title: String,
    pub description: String,
    pub severity: Severity,
    pub status: IncidentStatus,
    pub created_at: u64,
    pub updated_at: u64,
    pub resolved_at: Option<u64>,
    pub created_by: String,
    pub assigned_to: Option<String>,
    pub affected_services: Vec<String>,
    pub tags: Vec<String>,
    pub timeline: Vec<TimelineEvent>,
}

#[derive(Clone, Copy, Debug)]
pub enum Severity {
    Critical,
    High,
    Medium,
    Low,
}

#[derive(Clone, Copy, Debug)]
pub enum IncidentStatus {
    Triggered,
    Acknowledged,
    Investigating,
    Identified,
    Mitigating,
    Resolved,
    Postmortem,
}

pub struct TimelineEvent {
    pub event_id: String,
    pub timestamp: u64,
    pub event_type: EventType,
    pub description: String,
    pub actor: String,
}

#[derive(Clone, Copy, Debug)]
pub enum EventType {
    Created,
    Acknowledged,
    Assigned,
    Escalated,
    Mitigated,
    Resolved,
    Update,
}

pub struct OnCallSchedule {
    pub schedule_id: String,
    pub team_id: String,
    pub members: Vec<OnCallMember>,
    pub rotation_type: RotationType,
    pub rotation_days: u32,
    pub start_date: u64,
}

pub struct OnCallMember {
    pub member_id: String,
    pub user_id: String,
    pub user_name: String,
    pub email: String,
    pub phone: String,
    pub schedule_rotation: u32,
    pub override_until: Option<u64>,
}

#[derive(Clone, Copy, Debug)]
pub enum RotationType {
    Weekly,
    Biweekly,
    Monthly,
    Custom,
}

pub struct EscalationPolicy {
    pub policy_id: String,
    pub policy_name: String,
    pub escalation_levels: Vec<EscalationLevel>,
    pub repeat_count: u32,
}

pub struct EscalationLevel {
    pub level: u32,
    pub delay_minutes: u32,
    pub target_schedule_id: String,
    pub notification_type: NotificationType,
}

#[derive(Clone, Copy, Debug)]
pub enum NotificationType {
    Email,
    SMS,
    Phone,
    Slack,
    PagerDuty,
}

pub struct Runbook {
    pub runbook_id: String,
    pub title: String,
    pub description: String,
    pub trigger_conditions: Vec<String>,
    pub steps: Vec<RunbookStep>,
    pub affected_services: Vec<String>,
    pub created_at: u64,
    pub last_updated: u64,
}

pub struct RunbookStep {
    pub step_id: String,
    pub step_number: u32,
    pub title: String,
    pub instructions: String,
    pub verification: String,
}

pub struct PostMortem {
    pub postmortem_id: String,
    pub incident_id: String,
    pub title: String,
    pub summary: String,
    pub timeline: Vec<TimelineEvent>,
    pub root_causes: Vec<String>,
    pub action_items: Vec<ActionItem>,
    pub created_at: u64,
}

pub struct ActionItem {
    pub action_id: String,
    pub title: String,
    pub description: String,
    pub owner: String,
    pub due_date: u64,
    pub status: ActionStatus,
}

#[derive(Clone, Copy, Debug)]
pub enum ActionStatus {
    Open,
    InProgress,
    Completed,
    Cancelled,
}

pub struct IncidentMetrics {
    pub metrics_id: String,
    pub total_incidents: u64,
    pub critical_incidents: u64,
    pub mean_time_to_detect: u64, // seconds
    pub mean_time_to_respond: u64,
    pub mean_time_to_resolve: u64,
    pub incident_rate_per_day: f64,
}

pub struct AlertingRule {
    pub rule_id: String,
    pub name: String,
    pub condition: String,
    pub severity: Severity,
    pub escalation_policy_id: String,
    pub enabled: bool,
}

pub struct IncidentTemplate {
    pub template_id: String,
    pub template_name: String,
    pub severity: Severity,
    pub default_runbook_id: Option<String>,
    pub affected_services: Vec<String>,
    pub escalation_policy_id: String,
}

impl IncidentManagement {
    pub fn new() -> Self {
        IncidentManagement {
            im_id: "im-1".to_string(),
            incidents: HashMap::new(),
            on_call_schedules: HashMap::new(),
            escalation_policies: HashMap::new(),
            runbooks: HashMap::new(),
            post_mortems: HashMap::new(),
        }
    }

    pub fn create_incident(&mut self, title: &str, description: &str, severity: Severity) -> Result<String, String> {
        let incident_id = format!("incident_{}", hash_string(&format!("{}{}{:?}", title, current_timestamp(), severity)));

        let incident = Incident {
            incident_id: incident_id.clone(),
            title: title.to_string(),
            description: description.to_string(),
            severity,
            status: IncidentStatus::Triggered,
            created_at: current_timestamp(),
            updated_at: current_timestamp(),
            resolved_at: None,
            created_by: "system".to_string(),
            assigned_to: None,
            affected_services: Vec::new(),
            tags: Vec::new(),
            timeline: vec![TimelineEvent {
                event_id: format!("event_{}", hash_string(&incident_id)),
                timestamp: current_timestamp(),
                event_type: EventType::Created,
                description: "Incident created".to_string(),
                actor: "system".to_string(),
            }],
        };

        self.incidents.insert(incident_id.clone(), incident);
        println!("Created incident: {} ({:?})", title, severity);
        Ok(incident_id)
    }

    pub fn acknowledge_incident(&mut self, incident_id: &str, acknowledged_by: &str) -> Result<(), String> {
        if let Some(incident) = self.incidents.get_mut(incident_id) {
            incident.status = IncidentStatus::Acknowledged;
            incident.timeline.push(TimelineEvent {
                event_id: format!("event_{}", hash_string(&format!("{}{}", incident_id, current_timestamp()))),
                timestamp: current_timestamp(),
                event_type: EventType::Acknowledged,
                description: format!("Acknowledged by {}", acknowledged_by),
                actor: acknowledged_by.to_string(),
            });
            println!("Incident {} acknowledged by {}", incident_id, acknowledged_by);
            Ok(())
        } else {
            Err("Incident not found".to_string())
        }
    }

    pub fn resolve_incident(&mut self, incident_id: &str, resolution: &str) -> Result<(), String> {
        if let Some(incident) = self.incidents.get_mut(incident_id) {
            incident.status = IncidentStatus::Resolved;
            incident.resolved_at = Some(current_timestamp());
            incident.timeline.push(TimelineEvent {
                event_id: format!("event_{}", hash_string(&format!("{}{}", incident_id, current_timestamp()))),
                timestamp: current_timestamp(),
                event_type: EventType::Resolved,
                description: resolution.to_string(),
                actor: "system".to_string(),
            });
            println!("Incident {} resolved", incident_id);
            Ok(())
        } else {
            Err("Incident not found".to_string())
        }
    }

    pub fn create_on_call_schedule(&mut self, team_id: &str) -> Result<String, String> {
        let schedule_id = format!("schedule_{}", hash_string(team_id));

        let schedule = OnCallSchedule {
            schedule_id: schedule_id.clone(),
            team_id: team_id.to_string(),
            members: Vec::new(),
            rotation_type: RotationType::Weekly,
            rotation_days: 7,
            start_date: current_timestamp(),
        };

        self.on_call_schedules.insert(schedule_id.clone(), schedule);
        println!("Created on-call schedule for team: {}", team_id);
        Ok(schedule_id)
    }

    pub fn add_on_call_member(&mut self, schedule_id: &str, user_id: &str, user_name: &str) -> Result<(), String> {
        if let Some(schedule) = self.on_call_schedules.get_mut(schedule_id) {
            let member = OnCallMember {
                member_id: format!("member_{}", hash_string(&format!("{}{}", schedule_id, user_id))),
                user_id: user_id.to_string(),
                user_name: user_name.to_string(),
                email: format!("{}@omnisystem.io", user_id),
                phone: "+1-555-0000".to_string(),
                schedule_rotation: schedule.members.len() as u32,
                override_until: None,
            };

            schedule.members.push(member);
            println!("Added {} to on-call schedule", user_name);
            Ok(())
        } else {
            Err("Schedule not found".to_string())
        }
    }

    pub fn create_runbook(&mut self, title: &str, description: &str) -> Result<String, String> {
        let runbook_id = format!("runbook_{}", hash_string(&format!("{}{}", title, current_timestamp())));

        let runbook = Runbook {
            runbook_id: runbook_id.clone(),
            title: title.to_string(),
            description: description.to_string(),
            trigger_conditions: Vec::new(),
            steps: Vec::new(),
            affected_services: Vec::new(),
            created_at: current_timestamp(),
            last_updated: current_timestamp(),
        };

        self.runbooks.insert(runbook_id.clone(), runbook);
        println!("Created runbook: {}", title);
        Ok(runbook_id)
    }

    pub fn create_post_mortem(&mut self, incident_id: &str, title: &str, summary: &str) -> Result<String, String> {
        let pm_id = format!("postmortem_{}", hash_string(&format!("{}{}", incident_id, current_timestamp())));

        let post_mortem = PostMortem {
            postmortem_id: pm_id.clone(),
            incident_id: incident_id.to_string(),
            title: title.to_string(),
            summary: summary.to_string(),
            timeline: Vec::new(),
            root_causes: Vec::new(),
            action_items: Vec::new(),
            created_at: current_timestamp(),
        };

        self.post_mortems.insert(pm_id.clone(), post_mortem);
        println!("Created post-mortem for incident: {}", incident_id);
        Ok(pm_id)
    }

    pub fn get_on_call(&self, team_id: &str) -> Result<String, String> {
        if let Some(schedule) = self.on_call_schedules.values().find(|s| s.team_id == team_id) {
            if schedule.members.is_empty() {
                return Err("No on-call members scheduled".to_string());
            }
            let current_rotation = (current_timestamp() / (86400 * schedule.rotation_days as u64)) % schedule.members.len() as u64;
            let on_call = &schedule.members[current_rotation as usize];
            println!("Current on-call for {}: {}", team_id, on_call.user_name);
            Ok(on_call.user_name.clone())
        } else {
            Err("Schedule not found".to_string())
        }
    }

    pub fn get_incident_stats(&self) -> String {
        let total = self.incidents.len();
        let critical = self.incidents.values().filter(|i| matches!(i.severity, Severity::Critical)).count();
        let resolved = self.incidents.values().filter(|i| i.resolved_at.is_some()).count();

        format!(
            "Incident Management\nTotal Incidents: {}\nCritical: {}\nResolved: {}\nOpen: {}\nRunbooks: {}\nSchedules: {}",
            total,
            critical,
            resolved,
            total - resolved,
            self.runbooks.len(),
            self.on_call_schedules.len()
        )
    }
}

fn hash_string(s: &str) -> String {
    let mut hash: u64 = 5381;
    for c in s.chars() {
        hash = ((hash << 5).wrapping_add(hash)).wrapping_add(c as u64);
    }
    format!("{:x}", hash).chars().take(12).collect()
}

fn current_timestamp() -> u64 {
    std::time::SystemTime::now()
        .duration_since(std::time::UNIX_EPOCH)
        .unwrap_or_default()
        .as_secs()
}

pub fn main() {
    println!("╔═══════════════════════════════════════════════════════════════╗");
    println!("║    OMNISYSTEM INCIDENT MANAGEMENT v3.0.0                     ║");
    println!("║   On-Call Scheduling & Incident Tracking                     ║");
    println!("╚═══════════════════════════════════════════════════════════════╝\n");

    let mut im = IncidentManagement::new();

    let incident1 = im.create_incident("Database Connection Pool Exhausted", "Prod DB experiencing connection issues", Severity::Critical).expect("Failed");
    let incident2 = im.create_incident("Memory Leak in API Service", "API memory usage increasing", Severity::High).expect("Failed");

    let _ = im.acknowledge_incident(&incident1, "alice");
    let _ = im.resolve_incident(&incident1, "Increased connection pool size");

    let schedule1 = im.create_on_call_schedule("platform-team").expect("Failed");
    let _ = im.add_on_call_member(&schedule1, "alice", "Alice Smith");
    let _ = im.add_on_call_member(&schedule1, "bob", "Bob Johnson");
    let _ = im.add_on_call_member(&schedule1, "charlie", "Charlie Davis");

    let _ = im.get_on_call("platform-team");

    let runbook1 = im.create_runbook("Database Connection Pool", "Steps to fix connection pool exhaustion").expect("Failed");
    let postmortem1 = im.create_post_mortem(&incident1, "Incident Summary", "RCA: Misconfigured connection pool").expect("Failed");

    println!("\n{}", im.get_incident_stats());
}
