// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════
// OMNISYSTEM RESOURCE MANAGER - CPU, MEMORY, DISK & NETWORK QUOTA MANAGEMENT
// Resource allocation, quota enforcement, throttling, fair scheduling, admission control
// Language: TITAN (Systems Language)
// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════

use std::collections::HashMap;

pub struct ResourceManager {
    pub manager_id: String,
    pub total_resources: SystemResources,
    pub quotas: HashMap<String, ResourceQuota>,
    pub allocations: HashMap<String, ResourceAllocation>,
    pub scheduler: ResourceScheduler,
    pub admission_controller: AdmissionController,
}

pub struct SystemResources {
    pub cpu_cores: u32,
    pub memory_mb: u64,
    pub disk_gb: u64,
    pub network_bandwidth_mbps: u32,
    pub gpu_count: u32,
}

pub struct ResourceQuota {
    pub quota_id: String,
    pub tenant_id: String,
    pub cpu_limit: f64,
    pub memory_limit_mb: u64,
    pub disk_limit_gb: u64,
    pub network_limit_mbps: u32,
    pub gpu_limit: u32,
    pub pod_limit: u32,
    pub storage_classes: Vec<String>,
}

pub struct ResourceAllocation {
    pub alloc_id: String,
    pub workload_id: String,
    pub tenant_id: String,
    pub cpu_allocated: f64,
    pub memory_allocated_mb: u64,
    pub disk_allocated_gb: u64,
    pub network_allocated_mbps: u32,
    pub gpu_allocated: u32,
    pub status: AllocationStatus,
}

#[derive(Clone, Copy, Debug)]
pub enum AllocationStatus {
    Pending,
    Granted,
    Running,
    Throttled,
    Revoked,
}

pub struct ResourceScheduler {
    pub scheduler_id: String,
    pub scheduling_algorithm: SchedulingAlgorithm,
    pub priorities: HashMap<String, u32>,
    pub affinity_rules: Vec<AffinityRule>,
}

#[derive(Clone, Copy, Debug)]
pub enum SchedulingAlgorithm {
    FIFO,
    PriorityQueue,
    FairShare,
    BinPacking,
    LoadBalancing,
}

pub struct AffinityRule {
    pub rule_id: String,
    pub workload_id: String,
    pub affinity_type: AffinityType,
    pub target_node: Option<String>,
    pub labels: HashMap<String, String>,
}

#[derive(Clone, Copy, Debug)]
pub enum AffinityType {
    PodAffinity,
    PodAntiAffinity,
    NodeAffinity,
}

pub struct AdmissionController {
    pub controller_id: String,
    pub policies: Vec<AdmissionPolicy>,
    pub webhook_enabled: bool,
    pub deny_count: u64,
    pub approve_count: u64,
}

pub struct AdmissionPolicy {
    pub policy_id: String,
    pub policy_name: String,
    pub policy_type: PolicyType,
    pub rules: Vec<AdmissionRule>,
    pub enabled: bool,
}

#[derive(Clone, Copy, Debug)]
pub enum PolicyType {
    ResourceQuota,
    LimitRange,
    NetworkPolicy,
    PodSecurityPolicy,
    StorageQuota,
}

pub struct AdmissionRule {
    pub rule_id: String,
    pub condition: String,
    pub action: AdmissionAction,
}

#[derive(Clone, Copy, Debug)]
pub enum AdmissionAction {
    Approve,
    Deny,
    Modified,
}

pub struct ResourceMonitor {
    pub monitor_id: String,
    pub metrics: HashMap<String, ResourceMetric>,
    pub alerts: Vec<ResourceAlert>,
}

pub struct ResourceMetric {
    pub metric_id: String,
    pub resource_type: ResourceType,
    pub current_usage: u64,
    pub peak_usage: u64,
    pub average_usage: u64,
    pub timestamp: u64,
}

#[derive(Clone, Copy, Debug)]
pub enum ResourceType {
    CPU,
    Memory,
    Disk,
    Network,
    GPU,
}

pub struct ResourceAlert {
    pub alert_id: String,
    pub alert_type: AlertType,
    pub threshold_percent: u32,
    pub current_usage_percent: u32,
    pub triggered_at: u64,
}

#[derive(Clone, Copy, Debug)]
pub enum AlertType {
    HighCPUUsage,
    HighMemoryUsage,
    DiskFull,
    NetworkCongestion,
    QuotaExceeded,
}

pub struct ThrottlePolicy {
    pub policy_id: String,
    pub workload_id: String,
    pub cpu_limit_percent: u32,
    pub memory_limit_mb: u64,
    pub network_limit_kbps: u32,
    pub active: bool,
}

pub struct CapacityPlanner {
    pub planner_id: String,
    pub predictions: Vec<CapacityPrediction>,
    pub trend_analysis: Vec<ResourceTrend>,
}

pub struct CapacityPrediction {
    pub prediction_id: String,
    pub resource_type: ResourceType,
    pub predicted_usage_percent: u32,
    pub time_horizon_days: u32,
    pub confidence_percent: u32,
}

pub struct ResourceTrend {
    pub trend_id: String,
    pub resource_type: ResourceType,
    pub trend_direction: TrendDirection,
    pub growth_rate_percent: f64,
}

#[derive(Clone, Copy, Debug)]
pub enum TrendDirection {
    Increasing,
    Decreasing,
    Stable,
}

impl ResourceManager {
    pub fn new(cpu: u32, memory_mb: u64, disk_gb: u64, bandwidth_mbps: u32) -> Self {
        ResourceManager {
            manager_id: "rm-1".to_string(),
            total_resources: SystemResources {
                cpu_cores: cpu,
                memory_mb,
                disk_gb,
                network_bandwidth_mbps: bandwidth_mbps,
                gpu_count: 0,
            },
            quotas: HashMap::new(),
            allocations: HashMap::new(),
            scheduler: ResourceScheduler {
                scheduler_id: "sched-1".to_string(),
                scheduling_algorithm: SchedulingAlgorithm::FairShare,
                priorities: HashMap::new(),
                affinity_rules: Vec::new(),
            },
            admission_controller: AdmissionController {
                controller_id: "ac-1".to_string(),
                policies: Vec::new(),
                webhook_enabled: false,
                deny_count: 0,
                approve_count: 0,
            },
        }
    }

    pub fn create_quota(&mut self, tenant_id: &str, cpu_limit: f64, memory_limit_mb: u64) -> Result<String, String> {
        let quota_id = format!("quota_{}", hash_string(&format!("{}{}", tenant_id, cpu_limit)));

        let quota = ResourceQuota {
            quota_id: quota_id.clone(),
            tenant_id: tenant_id.to_string(),
            cpu_limit,
            memory_limit_mb,
            disk_limit_gb: 100,
            network_limit_mbps: 1000,
            gpu_limit: 0,
            pod_limit: 100,
            storage_classes: vec!["standard".to_string()],
        };

        self.quotas.insert(quota_id.clone(), quota);
        println!("Created quota for {}: {} CPU, {}MB RAM", tenant_id, cpu_limit, memory_limit_mb);
        Ok(quota_id)
    }

    pub fn allocate_resources(&mut self, workload_id: &str, tenant_id: &str, cpu: f64, memory_mb: u64) -> Result<String, String> {
        // Check quota
        if let Some(quota) = self.quotas.values().find(|q| q.tenant_id == tenant_id) {
            if cpu > quota.cpu_limit || memory_mb > quota.memory_limit_mb {
                self.admission_controller.deny_count += 1;
                return Err("Quota exceeded".to_string());
            }
        } else {
            return Err("Tenant not found".to_string());
        }

        // Check available resources
        let used_cpu: f64 = self.allocations.values().map(|a| a.cpu_allocated).sum();
        let used_memory: u64 = self.allocations.values().map(|a| a.memory_allocated_mb).sum();

        if used_cpu + cpu > self.total_resources.cpu_cores as f64 || used_memory + memory_mb > self.total_resources.memory_mb {
            self.admission_controller.deny_count += 1;
            return Err("Insufficient resources".to_string());
        }

        let alloc_id = format!("alloc_{}", hash_string(&format!("{}{}", workload_id, current_timestamp())));

        let allocation = ResourceAllocation {
            alloc_id: alloc_id.clone(),
            workload_id: workload_id.to_string(),
            tenant_id: tenant_id.to_string(),
            cpu_allocated: cpu,
            memory_allocated_mb: memory_mb,
            disk_allocated_gb: 10,
            network_allocated_mbps: 100,
            gpu_allocated: 0,
            status: AllocationStatus::Granted,
        };

        self.allocations.insert(alloc_id.clone(), allocation);
        self.admission_controller.approve_count += 1;
        println!("Allocated resources to {}: {} CPU, {}MB RAM", workload_id, cpu, memory_mb);
        Ok(alloc_id)
    }

    pub fn deallocate_resources(&mut self, alloc_id: &str) -> Result<(), String> {
        if self.allocations.remove(alloc_id).is_some() {
            println!("Deallocated resources: {}", alloc_id);
            Ok(())
        } else {
            Err("Allocation not found".to_string())
        }
    }

    pub fn throttle_workload(&mut self, workload_id: &str, cpu_limit_percent: u32) -> Result<String, String> {
        let policy_id = format!("throttle_{}", hash_string(&format!("{}{}", workload_id, cpu_limit_percent)));

        let policy = ThrottlePolicy {
            policy_id: policy_id.clone(),
            workload_id: workload_id.to_string(),
            cpu_limit_percent,
            memory_limit_mb: 1024,
            network_limit_kbps: 100000,
            active: true,
        };

        println!("Applied throttle to {}: {}% CPU", workload_id, cpu_limit_percent);
        Ok(policy_id)
    }

    pub fn get_resource_usage(&self) -> (f64, u64) {
        let used_cpu: f64 = self.allocations.values().map(|a| a.cpu_allocated).sum();
        let used_memory: u64 = self.allocations.values().map(|a| a.memory_allocated_mb).sum();

        (used_cpu, used_memory)
    }

    pub fn get_available_resources(&self) -> (f64, u64) {
        let (used_cpu, used_memory) = self.get_resource_usage();
        let available_cpu = self.total_resources.cpu_cores as f64 - used_cpu;
        let available_memory = self.total_resources.memory_mb - used_memory;

        (available_cpu, available_memory)
    }

    pub fn predict_capacity(&self, days_ahead: u32) -> CapacityPrediction {
        let (used_cpu, _) = self.get_resource_usage();
        let usage_percent = ((used_cpu / self.total_resources.cpu_cores as f64) * 100.0) as u32;

        CapacityPrediction {
            prediction_id: format!("pred_{}", hash_string(&format!("{}{}", days_ahead, current_timestamp()))),
            resource_type: ResourceType::CPU,
            predicted_usage_percent: usage_percent + (days_ahead * 2),
            time_horizon_days: days_ahead,
            confidence_percent: 85,
        }
    }

    pub fn get_resource_stats(&self) -> String {
        let (used_cpu, used_memory) = self.get_resource_usage();
        let (avail_cpu, avail_memory) = self.get_available_resources();

        format!(
            "Resource Manager\nAllocations: {}\nCPU Used: {:.2}/{} ({}%)\nMemory Used: {}/{} MB ({}%)\nApproved: {}, Denied: {}",
            self.allocations.len(),
            used_cpu,
            self.total_resources.cpu_cores,
            ((used_cpu / self.total_resources.cpu_cores as f64) * 100.0) as u32,
            used_memory,
            self.total_resources.memory_mb,
            ((used_memory as f64 / self.total_resources.memory_mb as f64) * 100.0) as u32,
            self.admission_controller.approve_count,
            self.admission_controller.deny_count
        )
    }
}

fn hash_string(s: &str) -> String {
    let mut hash: u64 = 5381;
    for c in s.chars() {
        hash = ((hash << 5).wrapping_add(hash)).wrapping_add(c as u64);
    }
    format!("{:x}", hash).chars().take(12).collect()
}

fn current_timestamp() -> u64 {
    std::time::SystemTime::now()
        .duration_since(std::time::UNIX_EPOCH)
        .unwrap_or_default()
        .as_secs()
}

pub fn main() {
    println!("╔═══════════════════════════════════════════════════════════════╗");
    println!("║     OMNISYSTEM RESOURCE MANAGER v3.0.0                       ║");
    println!("║  CPU, Memory, Disk & Network Quota Management                ║");
    println!("╚═══════════════════════════════════════════════════════════════╝\n");

    let mut rm = ResourceManager::new(128, 256_000, 2000, 10000);

    let _ = rm.create_quota("tenant-a", 32.0, 64_000);
    let _ = rm.create_quota("tenant-b", 16.0, 32_000);
    let _ = rm.create_quota("tenant-c", 8.0, 16_000);

    let alloc1 = rm.allocate_resources("app-1", "tenant-a", 8.0, 16_000).expect("Failed");
    let alloc2 = rm.allocate_resources("app-2", "tenant-b", 4.0, 8_000).expect("Failed");
    let alloc3 = rm.allocate_resources("app-3", "tenant-c", 2.0, 4_000).expect("Failed");

    let _ = rm.throttle_workload("app-1", 50);
    let _ = rm.get_available_resources();
    let prediction = rm.predict_capacity(30);

    println!("Capacity prediction in 30 days: {}%", prediction.predicted_usage_percent);

    let _ = rm.deallocate_resources(&alloc1);

    println!("\n{}", rm.get_resource_stats());
}
