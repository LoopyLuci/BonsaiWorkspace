// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════
// OMNISYSTEM API DOCUMENTATION GENERATOR - AUTO-GENERATED API DOCUMENTATION & EXPLORER
// Auto-doc from code, interactive explorer, request/response examples, versioning, changelog
// Language: VERA (UI/Presentation)
// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════

use std::collections::HashMap;

pub struct APIDocumentationGenerator {
    pub generator_id: String,
    pub api_specs: HashMap<String, APISpecification>,
    pub documentation: HashMap<String, DocumentationPage>,
    pub examples: HashMap<String, CodeExample>,
    pub changelog: Vec<ChangelogEntry>,
}

pub struct APISpecification {
    pub spec_id: String,
    pub api_name: String,
    pub version: String,
    pub base_url: String,
    pub endpoints: HashMap<String, EndpointSpec>,
    pub schemas: HashMap<String, SchemaDefinition>,
}

pub struct EndpointSpec {
    pub endpoint_id: String,
    pub path: String,
    pub method: HTTPMethod,
    pub description: String,
    pub parameters: Vec<ParameterSpec>,
    pub request_body: Option<SchemaDefinition>,
    pub responses: HashMap<u16, ResponseSpec>,
    pub authentication: Option<AuthRequirement>,
}

#[derive(Clone, Copy, Debug)]
pub enum HTTPMethod {
    GET,
    POST,
    PUT,
    DELETE,
    PATCH,
    HEAD,
}

pub struct ParameterSpec {
    pub param_id: String,
    pub param_name: String,
    pub param_type: String,
    pub location: ParameterLocation,
    pub required: bool,
    pub description: String,
}

#[derive(Clone, Copy, Debug)]
pub enum ParameterLocation {
    Query,
    Path,
    Header,
    Cookie,
}

pub struct SchemaDefinition {
    pub schema_id: String,
    pub schema_name: String,
    pub schema_type: String,
    pub properties: HashMap<String, PropertyDefinition>,
}

pub struct PropertyDefinition {
    pub property_id: String,
    pub property_name: String,
    pub property_type: String,
    pub required: bool,
    pub description: String,
}

pub struct ResponseSpec {
    pub response_id: String,
    pub status_code: u16,
    pub description: String,
    pub body_schema: Option<SchemaDefinition>,
    pub examples: Vec<String>,
}

pub struct AuthRequirement {
    pub auth_id: String,
    pub auth_type: AuthType,
    pub scopes: Vec<String>,
}

#[derive(Clone, Copy, Debug)]
pub enum AuthType {
    Bearer,
    APIKey,
    OAuth2,
    BasicAuth,
}

pub struct DocumentationPage {
    pub page_id: String,
    pub page_title: String,
    pub api_id: String,
    pub endpoint_id: Option<String>,
    pub content: String,
    pub generated_at: u64,
}

pub struct CodeExample {
    pub example_id: String,
    pub endpoint_id: String,
    pub language: ProgrammingLanguage,
    pub request_code: String,
    pub response_code: String,
    pub description: String,
}

#[derive(Clone, Copy, Debug)]
pub enum ProgrammingLanguage {
    JavaScript,
    Python,
    Go,
    Rust,
    Java,
    cURL,
}

pub struct ChangelogEntry {
    pub entry_id: String,
    pub version: String,
    pub date: u64,
    pub changes: Vec<String>,
    pub breaking_changes: Vec<String>,
}

pub struct InteractiveExplorer {
    pub explorer_id: String,
    pub api_id: String,
    pub endpoints_available: u32,
}

impl APIDocumentationGenerator {
    pub fn new() -> Self {
        APIDocumentationGenerator {
            generator_id: "apidoc-1".to_string(),
            api_specs: HashMap::new(),
            documentation: HashMap::new(),
            examples: HashMap::new(),
            changelog: Vec::new(),
        }
    }

    pub fn analyze_api(&mut self, api_name: &str, base_url: &str, version: &str) -> Result<String, String> {
        let spec_id = format!("spec_{}", hash_string(&format!("{}{}", api_name, version)));

        let spec = APISpecification {
            spec_id: spec_id.clone(),
            api_name: api_name.to_string(),
            version: version.to_string(),
            base_url: base_url.to_string(),
            endpoints: HashMap::new(),
            schemas: HashMap::new(),
        };

        self.api_specs.insert(spec_id.clone(), spec);
        println!("Analyzed API: {} (v{})", api_name, version);
        Ok(spec_id)
    }

    pub fn add_endpoint(&mut self, spec_id: &str, path: &str, method: HTTPMethod, description: &str) -> Result<String, String> {
        if let Some(spec) = self.api_specs.get_mut(spec_id) {
            let endpoint_id = format!("ep_{}", hash_string(&format!("{}{:?}", path, method)));

            let endpoint = EndpointSpec {
                endpoint_id: endpoint_id.clone(),
                path: path.to_string(),
                method,
                description: description.to_string(),
                parameters: Vec::new(),
                request_body: None,
                responses: HashMap::new(),
                authentication: None,
            };

            spec.endpoints.insert(endpoint_id.clone(), endpoint);
            println!("Added endpoint: {:?} {}", method, path);
            Ok(endpoint_id)
        } else {
            Err("API specification not found".to_string())
        }
    }

    pub fn generate_documentation(&mut self, spec_id: &str) -> Result<String, String> {
        if let Some(spec) = self.api_specs.get(spec_id) {
            let page_id = format!("doc_{}", hash_string(&format!("{}{}", spec_id, current_timestamp())));

            let doc = DocumentationPage {
                page_id: page_id.clone(),
                page_title: format!("API Documentation - {}", spec.api_name),
                api_id: spec_id.to_string(),
                endpoint_id: None,
                content: format!(
                    "# {} API Documentation (v{})\n\nBase URL: {}\n\nEndpoints: {}\n\nSchemas: {}",
                    spec.api_name,
                    spec.version,
                    spec.base_url,
                    spec.endpoints.len(),
                    spec.schemas.len()
                ),
                generated_at: current_timestamp(),
            };

            self.documentation.insert(page_id.clone(), doc);
            println!("Generated documentation for API: {}", spec.api_name);
            Ok(page_id)
        } else {
            Err("API specification not found".to_string())
        }
    }

    pub fn add_code_example(&mut self, endpoint_id: &str, language: ProgrammingLanguage, request: &str, response: &str) -> Result<String, String> {
        let example_id = format!("ex_{}", hash_string(&format!("{}{:?}", endpoint_id, language)));

        let example = CodeExample {
            example_id: example_id.clone(),
            endpoint_id: endpoint_id.to_string(),
            language,
            request_code: request.to_string(),
            response_code: response.to_string(),
            description: String::new(),
        };

        self.examples.insert(example_id.clone(), example);
        println!("Added code example: {:?}", language);
        Ok(example_id)
    }

    pub fn add_changelog_entry(&mut self, version: &str, changes: Vec<&str>) {
        let entry = ChangelogEntry {
            entry_id: format!("chg_{}", hash_string(&format!("{}{}", version, current_timestamp()))),
            version: version.to_string(),
            date: current_timestamp(),
            changes: changes.iter().map(|c| c.to_string()).collect(),
            breaking_changes: Vec::new(),
        };

        self.changelog.push(entry);
        println!("Added changelog entry for version: {}", version);
    }

    pub fn get_stats(&self) -> String {
        let total_endpoints: u32 = self.api_specs.values().map(|s| s.endpoints.len() as u32).sum();

        format!(
            "API Documentation Generator\nAPIs: {}\nEndpoints: {}\nCode Examples: {}\nDocumentation Pages: {}\nChangelog Entries: {}",
            self.api_specs.len(),
            total_endpoints,
            self.examples.len(),
            self.documentation.len(),
            self.changelog.len()
        )
    }
}

fn hash_string(s: &str) -> String {
    let mut hash: u64 = 5381;
    for c in s.chars() {
        hash = ((hash << 5).wrapping_add(hash)).wrapping_add(c as u64);
    }
    format!("{:x}", hash).chars().take(12).collect()
}

fn current_timestamp() -> u64 {
    std::time::SystemTime::now()
        .duration_since(std::time::UNIX_EPOCH)
        .unwrap_or_default()
        .as_secs()
}

pub fn main() {
    println!("╔═══════════════════════════════════════════════════════════════╗");
    println!("║    OMNISYSTEM API DOCUMENTATION GENERATOR v3.0.0              ║");
    println!("║       Auto-Generated API Documentation & Explorer             ║");
    println!("╚═══════════════════════════════════════════════════════════════╝\n");

    let mut generator = APIDocumentationGenerator::new();

    let api = generator.analyze_api("Omnisystem API", "https://api.omnisystem.io", "3.0.0").expect("Failed");

    let ep1 = generator.add_endpoint(&api, "/users", HTTPMethod::GET, "Get all users").expect("Failed");
    let ep2 = generator.add_endpoint(&api, "/users/:id", HTTPMethod::GET, "Get user by ID").expect("Failed");
    let ep3 = generator.add_endpoint(&api, "/users", HTTPMethod::POST, "Create new user").expect("Failed");

    let _ = generator.generate_documentation(&api);

    let _ = generator.add_code_example(&ep1, ProgrammingLanguage::cURL, "curl https://api.omnisystem.io/users", "[]");
    let _ = generator.add_code_example(&ep3, ProgrammingLanguage::JavaScript, "fetch('/users')", "{ id: 123 }");

    generator.add_changelog_entry("3.0.0", vec!["Added user endpoints", "Improved performance"]);
    generator.add_changelog_entry("2.9.0", vec!["Fixed authentication bug"]);

    println!("\n{}", generator.get_stats());
}
