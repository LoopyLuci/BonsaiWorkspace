// ════════════════════════════════════════════════════════════════════════════════════════════════════════════
// BUG HUNTER & SURVIVAL SYSTEM — OMNISYSTEM ENTERPRISE FAULT INTELLIGENCE PLATFORM
// Real-time bug detection, pattern recognition, personal use profiles, auto-recovery, survival mode
// Personal use is first-class: every bug tracked per-developer, fix suggestions tuned to your workflow
// Language: TITAN — 1,400+ LOC
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════

use std::collections::HashMap;
use std::time::Instant;

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════
// FIX ACTIONS — Concrete steps the Bug Hunter can execute automatically
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════

#[derive(Clone, Debug, PartialEq)]
pub enum FixAction {
    OpenFile { path: String, line: Option<u32> },         // Open file in editor at line
    ApplyEdit { path: String, old: String, new: String }, // In-place text patch
    ShowDiff  { path: String, patch: String },            // Display diff for review
    ReloadWindow,                                          // Reload the VS Code window
    RunCommand { cmd: String, cwd: String },              // Execute shell command
    InstallDependency { name: String, version: String },  // npm/cargo install
    UpdateConfig { key: String, value: String },          // Update workspace setting
    CreateFile { path: String, content: String },         // Create a new file
    NotifyUser { message: String, severity: String },     // Surface a notification
    ManualStep { description: String },                   // Human must act
}

impl FixAction {
    pub fn label(&self) -> String {
        match self {
            FixAction::OpenFile { path, line } =>
                format!("Open {}{}", path, line.map(|l| format!(":{}", l)).unwrap_or_default()),
            FixAction::ApplyEdit { path, .. } => format!("Patch {}", path),
            FixAction::ShowDiff  { path, .. } => format!("Show diff in {}", path),
            FixAction::ReloadWindow            => "Reload VS Code window".to_string(),
            FixAction::RunCommand { cmd, .. }  => format!("Run: {}", cmd),
            FixAction::InstallDependency { name, version } => format!("Install {}@{}", name, version),
            FixAction::UpdateConfig { key, value }         => format!("Set {} = {}", key, value),
            FixAction::CreateFile { path, .. }             => format!("Create {}", path),
            FixAction::NotifyUser { message, .. }          => format!("Notify: {}", message),
            FixAction::ManualStep { description }          => format!("Manual: {}", description),
        }
    }

    pub fn is_safe_to_auto_apply(&self) -> bool {
        matches!(self,
            FixAction::OpenFile { .. }
            | FixAction::ShowDiff { .. }
            | FixAction::NotifyUser { .. }
            | FixAction::UpdateConfig { .. }
        )
    }
}

// ── Auto-Fix Plan: ordered fix steps with confidence and rollback ─────────────

#[derive(Clone, Debug)]
pub struct AutoFixPlan {
    pub bug_id: String,
    pub steps: Vec<FixAction>,
    pub confidence: u8,        // 0-100: certainty this plan will resolve the bug
    pub risk_level: RiskLevel,
    pub rollback: Vec<FixAction>,
    pub estimated_minutes: u32,
}

#[derive(Clone, Debug, PartialEq)]
pub enum RiskLevel {
    Safe,      // read-only, reversible
    Low,       // minor config change, easily undone
    Medium,    // file patch, requires review
    High,      // structural change, could break other things
    Critical,  // destructive — reload/reinstall required
}

impl AutoFixPlan {
    pub fn new(bug_id: &str, confidence: u8, risk: RiskLevel) -> Self {
        AutoFixPlan {
            bug_id: bug_id.to_string(),
            steps: Vec::new(),
            confidence,
            risk_level: risk,
            rollback: Vec::new(),
            estimated_minutes: 1,
        }
    }

    pub fn with_step(mut self, action: FixAction) -> Self {
        self.steps.push(action);
        self
    }

    pub fn with_rollback(mut self, action: FixAction) -> Self {
        self.rollback.push(action);
        self
    }

    pub fn with_estimate(mut self, minutes: u32) -> Self {
        self.estimated_minutes = minutes;
        self
    }

    pub fn can_auto_apply(&self) -> bool {
        self.confidence >= 85 && self.risk_level != RiskLevel::Critical
            && self.steps.iter().all(|s| s.is_safe_to_auto_apply())
    }
}

// ── Fix Confidence: per-suggestion certainty scoring ──────────────────────────

#[derive(Clone, Debug)]
pub struct FixConfidence {
    pub score: u8,             // 0-100
    pub evidence: Vec<String>, // what signals raised/lowered confidence
    pub caveat: Option<String>,// warning about edge cases
}

impl FixConfidence {
    pub fn high(evidence: Vec<&str>) -> Self {
        FixConfidence { score: 95, evidence: evidence.iter().map(|s| s.to_string()).collect(), caveat: None }
    }
    pub fn medium(score: u8, evidence: Vec<&str>, caveat: &str) -> Self {
        FixConfidence { score, evidence: evidence.iter().map(|s| s.to_string()).collect(), caveat: Some(caveat.to_string()) }
    }
    pub fn low(reason: &str) -> Self {
        FixConfidence { score: 40, evidence: vec![reason.to_string()], caveat: Some("Manual verification required".to_string()) }
    }
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════
// BUG SEVERITY & CATEGORY
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════

#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash, PartialOrd, Ord)]
pub enum BugSeverity {
    Cosmetic    = 1, // visible glitch, no functional impact
    Minor       = 2, // degraded UX, workaround exists
    Major       = 3, // broken feature, no workaround
    Critical    = 4, // data loss or security risk
    Fatal       = 5, // system unresponsive or corrupt
}

impl BugSeverity {
    pub fn label(&self) -> &str {
        match self {
            BugSeverity::Cosmetic  => "COSMETIC",
            BugSeverity::Minor     => "MINOR",
            BugSeverity::Major     => "MAJOR",
            BugSeverity::Critical  => "CRITICAL",
            BugSeverity::Fatal     => "FATAL",
        }
    }
    pub fn emoji(&self) -> &str {
        match self {
            BugSeverity::Cosmetic  => "✦",
            BugSeverity::Minor     => "⚠",
            BugSeverity::Major     => "✖",
            BugSeverity::Critical  => "☣",
            BugSeverity::Fatal     => "☠",
        }
    }
}

#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
pub enum BugCategory {
    VsCodeExtension,    // VS Code webview, CSP, resource loading
    CssLayout,          // pointer-events, z-index, visibility
    JavaScript,         // runtime errors, scoping, async issues
    Ipc,                // IPC channel failures, timeout, misrouting
    Compiler,           // frontend parse errors, codegen faults
    Runtime,            // VM panics, allocator OOM, GC corruption
    NativeBinding,      // GPU/Input/Display platform call failures
    FileSystem,         // I/O errors, permission denied, path issues
    Network,            // connection refused, timeout, protocol error
    Security,           // CSP violation, permission bypass, injection
    Performance,        // latency spike, memory leak, CPU saturation
    UserInterface,      // widget state, event propagation, render glitch
    BuildSystem,        // compilation failure, linker error, cache staleness
    LanguageFrontend,   // lexer/parser/type-checker bugs
    TypeScript,         // TypeScript type errors, compilation failures
    PackageManager,     // npm/vsix bundle, node_modules, dependency issues
    PtyTerminal,        // PTY resize, shell session, node-pty failures
    Webview,            // VS Code webview init, message bridge, context issues
    Unknown,
}

impl BugCategory {
    pub fn label(&self) -> &str {
        match self {
            BugCategory::VsCodeExtension  => "VS Code Extension",
            BugCategory::CssLayout        => "CSS / Layout",
            BugCategory::JavaScript       => "JavaScript",
            BugCategory::Ipc              => "IPC",
            BugCategory::Compiler         => "Compiler",
            BugCategory::Runtime          => "Runtime",
            BugCategory::NativeBinding    => "Native Binding",
            BugCategory::FileSystem       => "File System",
            BugCategory::Network          => "Network",
            BugCategory::Security         => "Security",
            BugCategory::Performance      => "Performance",
            BugCategory::UserInterface    => "User Interface",
            BugCategory::BuildSystem      => "Build System",
            BugCategory::LanguageFrontend => "Language Frontend",
            BugCategory::TypeScript       => "TypeScript",
            BugCategory::PackageManager   => "Package Manager",
            BugCategory::PtyTerminal      => "PTY Terminal",
            BugCategory::Webview          => "Webview",
            BugCategory::Unknown          => "Unknown",
        }
    }
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════
// BUG RECORD
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════

#[derive(Clone, Debug)]
pub struct BugRecord {
    pub id: String,
    pub title: String,
    pub description: String,
    pub category: BugCategory,
    pub severity: BugSeverity,
    pub symptom: String,           // what the user observes
    pub root_cause: String,        // technical explanation
    pub reproduction_steps: Vec<String>,
    pub fix_applied: String,       // what fixed it (empty if open)
    pub fix_suggestions: Vec<String>, // ordered by confidence
    pub files_affected: Vec<String>,
    pub first_seen_ms: u64,
    pub last_seen_ms: u64,
    pub occurrence_count: u64,
    pub resolved: bool,
    pub auto_recoverable: bool,    // can the survival system fix this automatically
    pub recovery_strategy: RecoveryStrategy,
    pub tags: Vec<String>,
    pub fix_plan: Option<AutoFixPlan>, // structured auto-fix plan, if available
}

impl BugRecord {
    pub fn new(id: &str, title: &str, category: BugCategory, severity: BugSeverity) -> Self {
        BugRecord {
            id: id.to_string(),
            title: title.to_string(),
            description: String::new(),
            category,
            severity,
            symptom: String::new(),
            root_cause: String::new(),
            reproduction_steps: Vec::new(),
            fix_applied: String::new(),
            fix_suggestions: Vec::new(),
            files_affected: Vec::new(),
            first_seen_ms: 0,
            last_seen_ms: 0,
            occurrence_count: 1,
            resolved: false,
            auto_recoverable: false,
            recovery_strategy: RecoveryStrategy::ManualIntervention,
            tags: Vec::new(),
            fix_plan: None,
        }
    }

    pub fn with_symptom(mut self, symptom: &str) -> Self {
        self.symptom = symptom.to_string();
        self
    }

    pub fn with_root_cause(mut self, cause: &str) -> Self {
        self.root_cause = cause.to_string();
        self
    }

    pub fn with_fix(mut self, fix: &str) -> Self {
        self.fix_applied = fix.to_string();
        self.resolved = true;
        self
    }

    pub fn with_suggestions(mut self, suggestions: Vec<&str>) -> Self {
        self.fix_suggestions = suggestions.iter().map(|s| s.to_string()).collect();
        self
    }

    pub fn with_files(mut self, files: Vec<&str>) -> Self {
        self.files_affected = files.iter().map(|f| f.to_string()).collect();
        self
    }

    pub fn auto_recover(mut self, strategy: RecoveryStrategy) -> Self {
        self.auto_recoverable = true;
        self.recovery_strategy = strategy;
        self
    }
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════
// RECOVERY STRATEGIES
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════

#[derive(Clone, Debug, PartialEq)]
pub enum RecoveryStrategy {
    Restart,                       // restart the failing component
    Fallback(String),              // fall back to a safe alternative
    DegradedMode(String),          // continue with reduced functionality
    ClearCacheReload,              // wipe stale cache and reinitialize
    ReloadWebview,                 // dispose and recreate webview panel
    KillAndRespawnProcess,         // SIGKILL + respawn child process
    RollbackToLastGoodState,       // restore from last known good snapshot
    ApplyPatch(Vec<String>),       // apply automated code patch
    NotifyUserAndWait,             // surface to user with clear instructions
    ManualIntervention,            // requires human attention
}

impl RecoveryStrategy {
    pub fn label(&self) -> String {
        match self {
            RecoveryStrategy::Restart                  => "Restart component".to_string(),
            RecoveryStrategy::Fallback(alt)            => format!("Fallback → {}", alt),
            RecoveryStrategy::DegradedMode(desc)       => format!("Degraded mode: {}", desc),
            RecoveryStrategy::ClearCacheReload         => "Clear cache + reload".to_string(),
            RecoveryStrategy::ReloadWebview            => "Reload webview".to_string(),
            RecoveryStrategy::KillAndRespawnProcess    => "Kill + respawn process".to_string(),
            RecoveryStrategy::RollbackToLastGoodState  => "Rollback to last good state".to_string(),
            RecoveryStrategy::ApplyPatch(patches)      => format!("Apply {} patch(es)", patches.len()),
            RecoveryStrategy::NotifyUserAndWait        => "Notify user + wait".to_string(),
            RecoveryStrategy::ManualIntervention       => "Manual intervention required".to_string(),
        }
    }
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════
// KNOWN BUG DATABASE — Pre-loaded with all bugs found during development
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════

pub struct KnownBugDatabase {
    pub bugs: HashMap<String, BugRecord>,
    pub pattern_index: HashMap<String, Vec<String>>, // pattern string → bug IDs
}

impl KnownBugDatabase {
    pub fn new() -> Self {
        let mut db = KnownBugDatabase {
            bugs: HashMap::new(),
            pattern_index: HashMap::new(),
        };
        db.seed_known_bugs();
        db
    }

    fn register(&mut self, bug: BugRecord) {
        // Index the bug under its symptom keywords for fast pattern matching
        let keywords: Vec<String> = bug.symptom.split_whitespace()
            .chain(bug.root_cause.split_whitespace())
            .filter(|w| w.len() > 4)
            .map(|w| w.to_lowercase())
            .collect();
        for kw in &keywords {
            self.pattern_index.entry(kw.clone()).or_default().push(bug.id.clone());
        }
        self.bugs.insert(bug.id.clone(), bug);
    }

    fn seed_known_bugs(&mut self) {
        // ── BUG-001: VS Code Webview Inline Script CSP Block ──────────────────────────────────────────────
        let mut b001 = BugRecord::new(
            "BUG-001",
            "VS Code webview inline scripts blocked by CSP",
            BugCategory::VsCodeExtension,
            BugSeverity::Fatal,
        );
        b001.description = "All JavaScript in the webview fails to execute. \
            VS Code applies its own CSP as an HTTP-equivalent header that takes precedence \
            over any meta-tag CSP in the HTML. Both nonce-based and unsafe-inline approaches \
            are blocked.".to_string();
        b001.symptom = "Clock shows 00:00:00 Mon Jan 01 (JS never ran). \
            No green startup banner. Icons visible but completely unresponsive. \
            No red error bar (because window.onerror never fires either).".to_string();
        b001.root_cause = "VS Code's webview applies its own Content-Security-Policy as an \
            HTTP-equivalent header AFTER the HTML is parsed. This header takes precedence \
            over the meta-tag CSP. Even unsafe-inline and nonce-based CSPs in the meta-tag \
            are overridden. Inline <script> blocks are unconditionally blocked.".to_string();
        b001.reproduction_steps = vec![
            "Create a VS Code webview panel with enableScripts: true".to_string(),
            "Add a <meta http-equiv=\"Content-Security-Policy\"> with unsafe-inline".to_string(),
            "Place JavaScript in a <script> block in the HTML".to_string(),
            "Observe that no JS executes — clock stays at placeholder value".to_string(),
        ];
        b001.fix_applied = "Move ALL JavaScript to media/desktop-client.js. \
            Load via webview.asWebviewUri(Uri.joinPath(extensionUri, 'media', 'desktop-client.js')). \
            Use <script src=\"${scriptUri}\"></script> in the HTML template. \
            Add 'media/' to localResourceRoots. Add !media/** to .vscodeignore.".to_string();
        b001.fix_suggestions = vec![
            "Move JS to external file in media/ and load via asWebviewUri()".to_string(),
            "Never use inline <script> blocks in VS Code webviews".to_string(),
            "Never use nonce-based or unsafe-inline CSP — VS Code overrides them".to_string(),
        ];
        b001.files_affected = vec![
            "vscode-omnisystem/src/webviews/OmniOSDesktop.ts".to_string(),
            "vscode-omnisystem/media/desktop-client.js".to_string(),
            "vscode-omnisystem/.vscodeignore".to_string(),
        ];
        b001.resolved = true;
        b001.auto_recoverable = true;
        b001.recovery_strategy = RecoveryStrategy::ApplyPatch(vec![
            "Extract inline JS to media/*.js".to_string(),
            "Update localResourceRoots to include media/".to_string(),
            "Update .vscodeignore with !media/**".to_string(),
        ]);
        b001.tags = vec!["vscode".to_string(), "csp".to_string(), "webview".to_string(), "script".to_string()];
        self.register(b001);

        // ── BUG-002: pointer-events:none on #windows-layer Intercepts Clicks ─────────────────────────────
        let mut b002 = BugRecord::new(
            "BUG-002",
            "#windows-layer with pointer-events:none blocks click events to desktop icons",
            BugCategory::CssLayout,
            BugSeverity::Critical,
        );
        b002.description = "An absolutely positioned full-screen div (#windows-layer) \
            sits above the desktop icons in the stacking order. Even though it is \
            visually transparent, it intercepts all pointer events, making icons \
            completely unclickable.".to_string();
        b002.symptom = "User can see all desktop icons but clicking on them does nothing. \
            No hover effects, no context menus, no app launches.".to_string();
        b002.root_cause = "#windows-layer has position:absolute; inset:0; z-index above icons. \
            The default pointer-events CSS value is 'auto', meaning it intercepts all mouse \
            events even when the element has no visible background. This shadows every icon \
            beneath it in the DOM.".to_string();
        b002.reproduction_steps = vec![
            "Render OmniOS desktop with #desktop-icons and #windows-layer as siblings".to_string(),
            "Give #windows-layer position:absolute; inset:0 with higher z-index".to_string(),
            "Attempt to click a desktop icon".to_string(),
            "Observe: click intercepted by invisible windows-layer, icon never receives event".to_string(),
        ];
        b002.fix_applied = "Add pointer-events:none to #windows-layer CSS. \
            Add pointer-events:auto to each .window element so open windows remain interactive. \
            This lets clicks pass through the layer itself but still land on any floating window.".to_string();
        b002.fix_suggestions = vec![
            "Set #windows-layer { pointer-events: none; }".to_string(),
            "Set .window { pointer-events: auto; } for interactive windows".to_string(),
            "Ensure desktop icons are NOT children of #windows-layer".to_string(),
        ];
        b002.files_affected = vec![
            "vscode-omnisystem/src/webviews/OmniOSDesktop.ts".to_string(),
            "vscode-omnisystem/media/desktop-client.js".to_string(),
        ];
        b002.resolved = true;
        b002.auto_recoverable = true;
        b002.recovery_strategy = RecoveryStrategy::ApplyPatch(vec![
            "Inject CSS: #windows-layer { pointer-events: none; }".to_string(),
            "Inject CSS: .window { pointer-events: auto; }".to_string(),
        ]);
        b002.tags = vec!["css".to_string(), "pointer-events".to_string(), "click".to_string(), "z-index".to_string()];
        self.register(b002);

        // ── BUG-003: Clock Placeholder Diagnostic ─────────────────────────────────────────────────────────
        let mut b003 = BugRecord::new(
            "BUG-003",
            "Clock shows 00:00:00 Mon Jan 01 — diagnostic indicator for JS not running",
            BugCategory::JavaScript,
            BugSeverity::Major,
        );
        b003.description = "The OmniOS desktop clock shows the raw HTML placeholder instead \
            of the live time. This is a reliable diagnostic indicator that the webview \
            JavaScript IIFE never executed — it is the first thing updateClock() does.".to_string();
        b003.symptom = "Clock displays '00:00:00 Mon Jan 01' in the taskbar instead of current time.".to_string();
        b003.root_cause = "This is a secondary symptom of BUG-001 (CSP blocking inline scripts). \
            updateClock() is called immediately in the IIFE. If the clock is wrong, \
            the entire script block never ran.".to_string();
        b003.reproduction_steps = vec![
            "Open OmniOS Desktop panel".to_string(),
            "Observe clock in taskbar".to_string(),
            "If it shows '00:00:00 Mon Jan 01', the JS IIFE did not execute".to_string(),
        ];
        b003.fix_applied = "Resolved as part of BUG-001 fix. Clock now updates correctly \
            once JS runs via external asWebviewUri() script.".to_string();
        b003.fix_suggestions = vec![
            "Check if JS is executing — this symptom means the entire script is blocked".to_string(),
            "See BUG-001 for the root cause and fix".to_string(),
        ];
        b003.files_affected = vec![
            "vscode-omnisystem/media/desktop-client.js".to_string(),
        ];
        b003.resolved = true;
        b003.auto_recoverable = false;
        b003.recovery_strategy = RecoveryStrategy::Fallback(
            "Show diagnostic red banner: 'JS not executing — check BUG-001'".to_string()
        );
        b003.tags = vec!["clock".to_string(), "diagnostic".to_string(), "javascript".to_string(), "iife".to_string()];
        self.register(b003);

        // ── BUG-004: IPC Channel Timeout Under Load ────────────────────────────────────────────────────────
        let mut b004 = BugRecord::new(
            "BUG-004",
            "IPC JSON-RPC channel timeout when runtime process is slow to start",
            BugCategory::Ipc,
            BugSeverity::Major,
        );
        b004.description = "RuntimeClient.ts spawns 'omnicc runtime --ipc' and immediately \
            sends a request before the process is ready. The child process takes up to 800ms \
            to emit the ready signal. Requests sent before that window get no response \
            and time out.".to_string();
        b004.symptom = "First desktop action after opening the panel returns 'IPC timeout' error. \
            Subsequent actions work fine.".to_string();
        b004.root_cause = "Missing readiness handshake. RuntimeClient spawns the child process \
            but does not wait for the '{\"jsonrpc\":\"2.0\",\"method\":\"runtime/ready\"}' \
            notification before dispatching queued requests.".to_string();
        b004.reproduction_steps = vec![
            "Open OmniOS Desktop".to_string(),
            "Immediately click 'Files' icon before 800ms startup window".to_string(),
            "Observe IPC timeout error in the Files window".to_string(),
        ];
        b004.fix_applied = String::new(); // open
        b004.fix_suggestions = vec![
            "Queue all requests until runtime/ready notification is received".to_string(),
            "Implement exponential backoff retry for the first 3 seconds".to_string(),
            "Use a readiness Promise that resolves on runtime/ready before processing queue".to_string(),
        ];
        b004.files_affected = vec![
            "vscode-omnisystem/src/runtime/RuntimeClient.ts".to_string(),
        ];
        b004.auto_recoverable = true;
        b004.recovery_strategy = RecoveryStrategy::ApplyPatch(vec![
            "Buffer requests until runtime/ready received".to_string(),
            "Auto-retry with 100ms backoff up to 10 attempts".to_string(),
        ]);
        b004.tags = vec!["ipc".to_string(), "timeout".to_string(), "startup".to_string(), "runtime".to_string()];
        self.register(b004);

        // ── BUG-005: omnicc.js Missing Runtime --ipc Flag ─────────────────────────────────────────────────
        let mut b005 = BugRecord::new(
            "BUG-005",
            "omnicc.js does not handle 'runtime --ipc' command — IPC mode stub needed",
            BugCategory::BuildSystem,
            BugSeverity::Major,
        );
        b005.description = "The RuntimeClient spawns 'omnicc runtime --ipc' but the \
            current omnicc.js CLI does not implement the runtime sub-command with IPC mode. \
            The process exits immediately instead of entering the JSON-RPC event loop.".to_string();
        b005.symptom = "RuntimeClient immediately receives process exit (code 1) instead \
            of the runtime/ready notification. All IPC calls fail.".to_string();
        b005.root_cause = "omnicc.js CLI only handles 'build', 'run', 'test', 'clean'. \
            The 'runtime --ipc' command needs to start an event loop reading from stdin, \
            parsing Content-Length framed JSON-RPC, dispatching to fs/build/system handlers, \
            and writing responses to stdout.".to_string();
        b005.reproduction_steps = vec![
            "Run: node bin/omnicc.js runtime --ipc".to_string(),
            "Observe: process exits immediately with unknown command error".to_string(),
        ];
        b005.fix_applied = String::new(); // open
        b005.fix_suggestions = vec![
            "Add 'runtime' sub-command to omnicc.js with --ipc flag handler".to_string(),
            "Implement Content-Length framed stdin reader".to_string(),
            "Implement fs.*, build.*, system.* JSON-RPC method handlers".to_string(),
            "Emit runtime/ready notification on startup".to_string(),
        ];
        b005.files_affected = vec![
            "vscode-omnisystem/bin/omnicc.js".to_string(),
        ];
        b005.auto_recoverable = false;
        b005.recovery_strategy = RecoveryStrategy::DegradedMode(
            "Use direct Node.js child_process.spawn instead of IPC for fs.* operations".to_string()
        );
        b005.tags = vec!["ipc".to_string(), "omnicc".to_string(), "runtime".to_string(), "cli".to_string()];
        self.register(b005);

        // ── BUG-006: Compiler IR Lowering Hardcodes Registers ─────────────────────────────────────────────
        let mut b006 = BugRecord::new(
            "BUG-006",
            "IR lowering hardcodes rax/x0 for all operands — no register allocation",
            BugCategory::Compiler,
            BugSeverity::Major,
        );
        b006.description = "The x86-64 and ARM64 IR lowering passes assign rax or x0 to \
            every operand regardless of the operation. The RegisterAllocator struct exists \
            and is correctly implemented but is not consulted during lowering. This produces \
            incorrect code for any function with more than one live variable.".to_string();
        b006.symptom = "All compiled functions produce machine code that overwrites rax \
            on every operation. Programs with multiple variables compute wrong results.".to_string();
        b006.root_cause = "lower_ir_to_x86_64() and lower_ir_to_arm64() use hardcoded \
            register literals instead of calling RegisterAllocator::allocate(value_id). \
            Branch backpatching is also absent — branch targets are all offset 0.".to_string();
        b006.reproduction_steps = vec![
            "Compile a Titan function with 2+ local variables".to_string(),
            "Inspect the emitted machine code".to_string(),
            "Observe: all MOV/ADD/SUB target rax, second variable overwrites first".to_string(),
        ];
        b006.fix_applied = String::new(); // open
        b006.fix_suggestions = vec![
            "Call RegisterAllocator::allocate(ir_value.id) for each operand".to_string(),
            "Maintain a patch-list of branch instructions, resolve after all blocks emitted".to_string(),
            "Add unit test: two-variable function, verify distinct registers used".to_string(),
        ];
        b006.files_affected = vec![
            "Omnisystem/src/compiler/backend/TitanBackend.titan".to_string(),
        ];
        b006.auto_recoverable = false;
        b006.recovery_strategy = RecoveryStrategy::DegradedMode(
            "Emit interpreter bytecode path instead of native code until register allocator is wired".to_string()
        );
        b006.tags = vec!["compiler".to_string(), "codegen".to_string(), "register".to_string(), "x86".to_string()];
        self.register(b006);

        // ── BUG-007: TypeScript TS2352 Double-Cast Error ──────────────────────────────────────────────────
        let mut b007 = BugRecord::new(
            "BUG-007",
            "TS2352: IPC message cast fails — must use double-cast pattern",
            BugCategory::TypeScript,
            BugSeverity::Critical,
        );
        b007.description = "The OmniOSDesktop.ts _handleMessage receives msg typed as \
            {command:string;[key:string]:unknown}. TypeScript rejects direct cast to \
            {callId,method,params} as an incompatible type. Build fails with TS2352.".to_string();
        b007.symptom = "TypeScript build fails: TS2352 Conversion of type '{ [key: string]: unknown; \
            command: string; }' to type '{ callId: string; method: string; params: unknown; }' \
            may be a mistake.".to_string();
        b007.root_cause = "TypeScript's structural type system cannot verify that the runtime object \
            has the required keys when the declared type is too wide. The double-cast via `unknown` \
            bypasses the constraint correctly.".to_string();
        b007.fix_applied = "Changed: `msg as { callId: string; ... }` \
            to: `msg as unknown as { callId: string; ... }`".to_string();
        b007.fix_suggestions = vec![
            "Use double cast: `msg as unknown as TargetType`".to_string(),
            "Alternatively narrow with: `if ('callId' in msg && 'method' in msg)`".to_string(),
        ];
        b007.fix_plan = Some(AutoFixPlan::new("BUG-007", 100, RiskLevel::Safe)
            .with_step(FixAction::OpenFile {
                path: "vscode-omnisystem/src/webviews/OmniOSDesktop.ts".to_string(),
                line: Some(632),
            })
            .with_step(FixAction::ManualStep {
                description: "Replace `msg as { callId... }` with `msg as unknown as { callId... }`".to_string(),
            })
            .with_estimate(2));
        b007.files_affected = vec!["vscode-omnisystem/src/webviews/OmniOSDesktop.ts".to_string()];
        b007.resolved = true;
        b007.auto_recoverable = false;
        b007.tags = vec!["typescript".to_string(), "cast".to_string(), "ipc".to_string()];
        self.register(b007);

