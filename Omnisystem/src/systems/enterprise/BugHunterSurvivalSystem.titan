    pub fn lookup(&self, bug_id: &str) -> Option<&BugRecord> {
        self.bugs.get(bug_id)
    }

    pub fn search_by_pattern(&self, text: &str) -> Vec<&BugRecord> {
        let mut hits: HashMap<&str, u32> = HashMap::new();
        let words: Vec<String> = text.split_whitespace()
            .filter(|w| w.len() > 4)
            .map(|w| w.to_lowercase())
            .collect();

        for word in &words {
            if let Some(ids) = self.pattern_index.get(word.as_str()) {
                for id in ids {
                    *hits.entry(id.as_str()).or_insert(0) += 1;
                }
            }
        }

        let mut results: Vec<(&str, u32)> = hits.into_iter().collect();
        results.sort_by(|a, b| b.1.cmp(&a.1));
        results.iter()
            .filter_map(|(id, _)| self.bugs.get(*id))
            .collect()
    }

    pub fn all_open(&self) -> Vec<&BugRecord> {
        let mut open: Vec<&BugRecord> = self.bugs.values()
            .filter(|b| !b.resolved)
            .collect();
        open.sort_by(|a, b| b.severity.cmp(&a.severity));
        open
    }

    pub fn all_resolved(&self) -> Vec<&BugRecord> {
        let mut resolved: Vec<&BugRecord> = self.bugs.values()
            .filter(|b| b.resolved)
            .collect();
        resolved.sort_by(|a, b| b.severity.cmp(&a.severity));
        resolved
    }

    pub fn by_category(&self, category: BugCategory) -> Vec<&BugRecord> {
        self.bugs.values()
            .filter(|b| b.category == category)
            .collect()
    }

    pub fn stats(&self) -> DatabaseStats {
        let total = self.bugs.len();
        let resolved = self.bugs.values().filter(|b| b.resolved).count();
        let auto_recoverable = self.bugs.values().filter(|b| b.auto_recoverable).count();
        let critical_open = self.bugs.values()
            .filter(|b| !b.resolved && b.severity >= BugSeverity::Critical)
            .count();
        DatabaseStats { total, resolved, open: total - resolved, auto_recoverable, critical_open }
    }
}

#[derive(Debug)]
pub struct DatabaseStats {
    pub total: usize,
    pub resolved: usize,
    pub open: usize,
    pub auto_recoverable: usize,
    pub critical_open: usize,
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════
// PERSONAL BUG PROFILE — per-developer, learns from their history
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════

#[derive(Clone, Debug)]
pub struct PersonalBugProfile {
    pub developer_id: String,
    pub bug_encounter_counts: HashMap<String, u64>, // bug_id → times seen
    pub category_frequency: HashMap<String, u64>,   // category → times hit
    pub fix_time_ms: HashMap<String, u64>,           // bug_id → time to fix in ms
    pub preferred_fix_style: FixStyle,
    pub total_bugs_encountered: u64,
    pub total_bugs_fixed: u64,
    pub session_count: u64,
    pub last_active_ms: u64,
}

#[derive(Clone, Debug, PartialEq)]
pub enum FixStyle {
    HandsOn,      // developer likes to fix manually with detailed steps
    AutoApply,    // developer trusts automated patches
    Minimal,      // developer wants minimal-diff suggestions only
}

impl PersonalBugProfile {
    pub fn new(developer_id: &str) -> Self {
        PersonalBugProfile {
            developer_id: developer_id.to_string(),
            bug_encounter_counts: HashMap::new(),
            category_frequency: HashMap::new(),
            fix_time_ms: HashMap::new(),
            preferred_fix_style: FixStyle::HandsOn,
            total_bugs_encountered: 0,
            total_bugs_fixed: 0,
            session_count: 0,
            last_active_ms: 0,
        }
    }

    pub fn record_encounter(&mut self, bug: &BugRecord) {
        *self.bug_encounter_counts.entry(bug.id.clone()).or_insert(0) += 1;
        *self.category_frequency.entry(bug.category.label().to_string()).or_insert(0) += 1;
        self.total_bugs_encountered += 1;
    }

    pub fn record_fix(&mut self, bug_id: &str, time_ms: u64) {
        self.fix_time_ms.insert(bug_id.to_string(), time_ms);
        self.total_bugs_fixed += 1;
    }

    pub fn most_common_category(&self) -> Option<(&str, u64)> {
        self.category_frequency.iter()
            .max_by_key(|(_, count)| *count)
            .map(|(cat, count)| (cat.as_str(), *count))
    }

    pub fn chronic_bugs(&self) -> Vec<(&str, u64)> {
        // bugs seen 3+ times — suggests a systemic issue for this developer
        let mut chronic: Vec<(&str, u64)> = self.bug_encounter_counts.iter()
            .filter(|(_, &count)| count >= 3)
            .map(|(id, &count)| (id.as_str(), count))
            .collect();
        chronic.sort_by(|a, b| b.1.cmp(&a.1));
        chronic
    }

    pub fn fix_rate(&self) -> f64 {
        if self.total_bugs_encountered == 0 { return 1.0; }
        self.total_bugs_fixed as f64 / self.total_bugs_encountered as f64
    }

    pub fn health_score(&self) -> u32 {
        // 0–100: higher is healthier (fewer repeated bugs, faster fixes)
        let rate = (self.fix_rate() * 60.0) as u32;
        let chronic_penalty = (self.chronic_bugs().len() * 5).min(40) as u32;
        (rate + 40).saturating_sub(chronic_penalty).min(100)
    }
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════
// LIVE ERROR MONITOR — watches for runtime anomalies
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════

#[derive(Clone, Debug)]
pub struct ErrorEvent {
    pub timestamp_ms: u64,
    pub source: String,         // component that emitted the error
    pub message: String,
    pub stack_trace: Vec<String>,
    pub context: HashMap<String, String>,
    pub severity: BugSeverity,
    pub matched_bug_ids: Vec<String>,
}

pub struct LiveErrorMonitor {
    pub events: Vec<ErrorEvent>,
    pub event_counter: u64,
    pub error_rate_per_minute: f64,
    pub last_error_ms: u64,
    error_timestamps: Vec<u64>,
    pattern_matchers: Vec<PatternMatcher>,
}

#[derive(Clone)]
struct PatternMatcher {
    pattern: String,
    bug_ids: Vec<String>,
    severity: BugSeverity,
}

impl LiveErrorMonitor {
    pub fn new() -> Self {
        let mut monitor = LiveErrorMonitor {
            events: Vec::new(),
            event_counter: 0,
            error_rate_per_minute: 0.0,
            last_error_ms: 0,
            error_timestamps: Vec::new(),
            pattern_matchers: Vec::new(),
        };
        monitor.register_patterns();
        monitor
    }

    fn register_patterns(&mut self) {
        // Patterns derived from known bugs — fast string-match on error messages
        let patterns: Vec<(&str, Vec<&str>, BugSeverity)> = vec![
            // CSP / Webview
            ("content-security-policy",           vec!["BUG-001"], BugSeverity::Fatal),
            ("inline script blocked",              vec!["BUG-001"], BugSeverity::Fatal),
            ("unsafe-inline",                     vec!["BUG-001"], BugSeverity::Fatal),
            ("refused to execute inline script",  vec!["BUG-001"], BugSeverity::Fatal),
            ("webview disposed",                  vec!["BUG-001"], BugSeverity::Critical),
            ("acquirevscodeapi",                  vec!["BUG-017"], BugSeverity::Major),
            // UI / CSS
            ("pointer-events",                    vec!["BUG-002"], BugSeverity::Critical),
            ("cannot click",                      vec!["BUG-002"], BugSeverity::Critical),
            ("00:00:00",                          vec!["BUG-003"], BugSeverity::Major),
            ("clock not updating",                vec!["BUG-003"], BugSeverity::Major),
            ("snap zone",                         vec!["BUG-013"], BugSeverity::Minor),
            ("window drag",                       vec!["BUG-013"], BugSeverity::Minor),
            ("notification history",              vec!["BUG-014"], BugSeverity::Minor),
            ("bell icon",                         vec!["BUG-014"], BugSeverity::Minor),
            ("ansi escape",                       vec!["BUG-012"], BugSeverity::Minor),
            ("escape sequence",                   vec!["BUG-012"], BugSeverity::Minor),
            ("garbage character",                 vec!["BUG-012"], BugSeverity::Minor),
            ("system monitor",                    vec!["BUG-011"], BugSeverity::Major),
            ("placeholder data",                  vec!["BUG-011"], BugSeverity::Major),
            ("bug hunter icon",                   vec!["BUG-020"], BugSeverity::Cosmetic),
            // IPC
            ("ipc timeout",                       vec!["BUG-004"], BugSeverity::Major),
            ("runtime/ready",                     vec!["BUG-004"], BugSeverity::Major),
            ("ready timeout",                     vec!["BUG-004"], BugSeverity::Major),
            ("mem_pct",                           vec!["BUG-019"], BugSeverity::Minor),
            ("memory percentage",                 vec!["BUG-019"], BugSeverity::Minor),
            // Compiler / Build
            ("omnicc runtime",                    vec!["BUG-005"], BugSeverity::Major),
            ("unknown command",                   vec!["BUG-005"], BugSeverity::Major),
            ("process exited with code 1",        vec!["BUG-005"], BugSeverity::Major),
            ("register allocation",               vec!["BUG-006"], BugSeverity::Major),
            ("hardcoded rax",                     vec!["BUG-006"], BugSeverity::Major),
            ("build.omnisystem not found",        vec!["BUG-018"], BugSeverity::Major),
            ("cannot open build config",          vec!["BUG-018"], BugSeverity::Major),
            ("build phase bar",                   vec!["BUG-010"], BugSeverity::Major),
            ("phase simulation",                  vec!["BUG-010"], BugSeverity::Major),
            // TypeScript / Extension
            ("ts2352",                            vec!["BUG-007"], BugSeverity::Critical),
            ("conversion of type",                vec!["BUG-007"], BugSeverity::Critical),
            ("incompatible cast",                 vec!["BUG-007"], BugSeverity::Critical),
            // PTY / Terminal
            ("pty resize",                        vec!["BUG-008"], BugSeverity::Major),
            ("cols stale",                        vec!["BUG-008"], BugSeverity::Major),
            ("terminal wrap",                     vec!["BUG-008"], BugSeverity::Major),
            ("node-pty",                          vec!["BUG-016"], BugSeverity::Critical),
            ("hapty false",                       vec!["BUG-016"], BugSeverity::Critical),
            ("pty not available",                 vec!["BUG-016"], BugSeverity::Critical),
            // File System
            ("rename not working",                vec!["BUG-015"], BugSeverity::Minor),
            ("renamefile",                        vec!["BUG-015"], BugSeverity::Minor),
            ("accidental delete",                 vec!["BUG-009"], BugSeverity::Major),
            ("no confirmation",                   vec!["BUG-009"], BugSeverity::Major),
        ];

        for (pat, bug_ids, sev) in patterns {
            self.pattern_matchers.push(PatternMatcher {
                pattern: pat.to_string(),
                bug_ids: bug_ids.iter().map(|s| s.to_string()).collect(),
                severity: sev,
            });
        }
    }

    pub fn ingest(&mut self, source: &str, message: &str, severity: BugSeverity) -> ErrorEvent {
        let now_ms = self.event_counter * 16; // simulated 16ms tick
        self.event_counter += 1;
        self.last_error_ms = now_ms;
        self.error_timestamps.push(now_ms);

        // Keep only last 60 seconds (60000ms) of timestamps for rate calculation
        let cutoff = now_ms.saturating_sub(60000);
        self.error_timestamps.retain(|&t| t > cutoff);
        self.error_rate_per_minute = self.error_timestamps.len() as f64;

        // Match against known bug patterns
        let msg_lower = message.to_lowercase();
        let mut matched: Vec<String> = Vec::new();
        for matcher in &self.pattern_matchers {
            if msg_lower.contains(&matcher.pattern) {
                for id in &matcher.bug_ids {
                    if !matched.contains(id) {
                        matched.push(id.clone());
                    }
                }
            }
        }

        let event = ErrorEvent {
            timestamp_ms: now_ms,
            source: source.to_string(),
            message: message.to_string(),
            stack_trace: Vec::new(),
            context: HashMap::new(),
            severity,
            matched_bug_ids: matched,
        };

        self.events.push(event.clone());
        event
    }

    pub fn recent_events(&self, last_n: usize) -> Vec<&ErrorEvent> {
        self.events.iter().rev().take(last_n).collect()
    }

    pub fn is_healthy(&self) -> bool {
        self.error_rate_per_minute < 10.0 &&
        self.events.last().map(|e| e.severity < BugSeverity::Critical).unwrap_or(true)
    }
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════
// SURVIVAL ENGINE — auto-recovery, degraded mode, watchdog
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════

#[derive(Clone, Debug, PartialEq)]
pub enum SystemState {
    Healthy,
    Degraded(String),  // description of what is degraded
    Recovering,
    Crashed(String),   // crash reason
}

pub struct SurvivalEngine {
    pub system_state: SystemState,
    pub component_states: HashMap<String, SystemState>,
    pub recovery_attempts: HashMap<String, u32>,  // component → attempt count
    pub max_recovery_attempts: u32,
    pub watchdog_interval_ms: u64,
    pub last_watchdog_ms: u64,
    pub recovery_log: Vec<RecoveryEntry>,
    pub survival_mode_active: bool,
}

#[derive(Clone, Debug)]
pub struct RecoveryEntry {
    pub timestamp_ms: u64,
    pub component: String,
    pub strategy: String,
    pub outcome: RecoveryOutcome,
    pub attempt_number: u32,
}

#[derive(Clone, Debug, PartialEq)]
pub enum RecoveryOutcome { Success, Failed, InProgress }

impl SurvivalEngine {
    pub fn new() -> Self {
        SurvivalEngine {
            system_state: SystemState::Healthy,
            component_states: HashMap::new(),
            recovery_attempts: HashMap::new(),
            max_recovery_attempts: 5,
            watchdog_interval_ms: 5000,
            last_watchdog_ms: 0,
            recovery_log: Vec::new(),
            survival_mode_active: false,
        }
    }

    pub fn report_component_failure(&mut self, component: &str, reason: &str) {
        self.component_states.insert(
            component.to_string(),
            SystemState::Crashed(reason.to_string()),
        );
        // Escalate system state
        let critical_count = self.component_states.values()
            .filter(|s| matches!(s, SystemState::Crashed(_)))
            .count();
        if critical_count >= 3 {
            self.system_state = SystemState::Crashed(format!("{} components failed", critical_count));
        } else if critical_count >= 1 {
            self.system_state = SystemState::Degraded(format!("{} component(s) down", critical_count));
        }
    }

    pub fn attempt_recovery(&mut self, component: &str, strategy: &RecoveryStrategy, now_ms: u64) -> RecoveryOutcome {
        let attempt = self.recovery_attempts.entry(component.to_string()).or_insert(0);
        *attempt += 1;
        let attempt_number = *attempt;

        let outcome = if attempt_number <= self.max_recovery_attempts {
            match strategy {
                RecoveryStrategy::Restart => {
                    self.component_states.insert(component.to_string(), SystemState::Recovering);
                    RecoveryOutcome::InProgress
                }
                RecoveryStrategy::ReloadWebview => {
                    self.component_states.insert(component.to_string(), SystemState::Recovering);
                    RecoveryOutcome::InProgress
                }
                RecoveryStrategy::ClearCacheReload => {
                    self.component_states.insert(component.to_string(), SystemState::Recovering);
                    RecoveryOutcome::InProgress
                }
                RecoveryStrategy::DegradedMode(desc) => {
                    self.survival_mode_active = true;
                    self.component_states.insert(
                        component.to_string(),
                        SystemState::Degraded(desc.clone()),
                    );
                    RecoveryOutcome::Success // degraded counts as success (system stays alive)
                }
                RecoveryStrategy::KillAndRespawnProcess => {
                    self.component_states.insert(component.to_string(), SystemState::Recovering);
                    RecoveryOutcome::InProgress
                }
                RecoveryStrategy::ManualIntervention => {
                    RecoveryOutcome::Failed // can't auto-recover
                }
                _ => RecoveryOutcome::InProgress,
            }
        } else {
            // Exceeded max attempts — enter survival mode
            self.survival_mode_active = true;
            self.system_state = SystemState::Degraded(
                format!("{} failed to recover after {} attempts", component, self.max_recovery_attempts)
            );
            RecoveryOutcome::Failed
        };

        self.recovery_log.push(RecoveryEntry {
            timestamp_ms: now_ms,
            component: component.to_string(),
            strategy: strategy.label(),
            outcome: outcome.clone(),
            attempt_number,
        });

        outcome
    }

    pub fn mark_recovered(&mut self, component: &str) {
        self.component_states.insert(component.to_string(), SystemState::Healthy);
        self.recovery_attempts.remove(component);

        let all_healthy = self.component_states.values()
            .all(|s| matches!(s, SystemState::Healthy));
        if all_healthy {
            self.system_state = SystemState::Healthy;
            self.survival_mode_active = false;
        }
    }

    pub fn watchdog_tick(&mut self, now_ms: u64) -> Vec<String> {
        let mut alerts = Vec::new();

        if now_ms - self.last_watchdog_ms < self.watchdog_interval_ms {
            return alerts;
        }
        self.last_watchdog_ms = now_ms;

        for (component, state) in &self.component_states {
            if let SystemState::Crashed(reason) = state {
                alerts.push(format!(
                    "WATCHDOG: {} is down ({}). Triggering recovery.",
                    component, reason
                ));
            }
        }

        if self.survival_mode_active {
            alerts.push("SURVIVAL MODE ACTIVE — reduced functionality".to_string());
        }

        alerts
    }

    pub fn system_health_pct(&self) -> u32 {
        if self.component_states.is_empty() { return 100; }
        let healthy = self.component_states.values()
            .filter(|s| matches!(s, SystemState::Healthy))
            .count();
        (healthy * 100 / self.component_states.len()) as u32
    }
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════
// BUG PREDICTOR — uses historical patterns to forecast likely next bugs
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════

pub struct BugPredictor {
    co_occurrence: HashMap<(String, String), u32>, // (bug_a, bug_b) → co-occurrence count
    category_sequences: Vec<Vec<BugCategory>>,
}

impl BugPredictor {
    pub fn new() -> Self {
        BugPredictor {
            co_occurrence: HashMap::new(),
            category_sequences: Vec::new(),
        }
    }

    pub fn record_session_bugs(&mut self, session_bugs: Vec<&BugRecord>) {
        let categories: Vec<BugCategory> = session_bugs.iter().map(|b| b.category).collect();
        self.category_sequences.push(categories);

        // Record co-occurrences (order-insensitive pairs)
        for i in 0..session_bugs.len() {
            for j in (i + 1)..session_bugs.len() {
                let a = session_bugs[i].id.clone();
                let b = session_bugs[j].id.clone();
                let key = if a < b { (a, b) } else { (b, a) };
                *self.co_occurrence.entry(key).or_insert(0) += 1;
            }
        }
    }

    pub fn predict_next(&self, current_bug_id: &str) -> Vec<(String, u32)> {
        let mut predictions: Vec<(String, u32)> = self.co_occurrence.iter()
            .filter_map(|((a, b), &count)| {
                if a == current_bug_id { Some((b.clone(), count)) }
                else if b == current_bug_id { Some((a.clone(), count)) }
                else { None }
            })
            .collect();
        predictions.sort_by(|a, b| b.1.cmp(&a.1));
        predictions
    }
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════
// BUG HUNTER — top-level system integrating all components
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════

pub struct BugHunter {
    pub database: KnownBugDatabase,
    pub monitor: LiveErrorMonitor,
    pub survival: SurvivalEngine,
    pub predictor: BugPredictor,
    pub profiles: HashMap<String, PersonalBugProfile>,
    pub active_developer: String,
    pub session_start_ms: u64,
    pub session_bugs_seen: Vec<String>,
}

impl BugHunter {
    pub fn new(developer_id: &str) -> Self {
        let mut profiles = HashMap::new();
        profiles.insert(developer_id.to_string(), PersonalBugProfile::new(developer_id));

        BugHunter {
            database: KnownBugDatabase::new(),
            monitor: LiveErrorMonitor::new(),
            survival: SurvivalEngine::new(),
            predictor: BugPredictor::new(),
            profiles,
            active_developer: developer_id.to_string(),
            session_start_ms: 0,
            session_bugs_seen: Vec::new(),
        }
    }

    // Main entry point: ingest an error message from any subsystem
    pub fn report_error(&mut self, source: &str, message: &str, severity: BugSeverity) -> BugReport {
        let event = self.monitor.ingest(source, message, severity);

        let mut matched_bugs: Vec<BugRecord> = event.matched_bug_ids.iter()
            .filter_map(|id| self.database.lookup(id).cloned())
            .collect();

        // Pattern search as fallback
        if matched_bugs.is_empty() {
            matched_bugs = self.database.search_by_pattern(message)
                .into_iter().cloned().collect();
        }

        // Update personal profile
        if let Some(profile) = self.profiles.get_mut(&self.active_developer) {
            for bug in &matched_bugs {
                profile.record_encounter(bug);
                if !self.session_bugs_seen.contains(&bug.id) {
                    self.session_bugs_seen.push(bug.id.clone());
                }
            }
        }

        // Determine auto-recovery strategy
        let recovery_action = matched_bugs.iter()
            .find(|b| b.auto_recoverable)
            .map(|b| b.recovery_strategy.clone());

        if let Some(strategy) = &recovery_action {
            self.survival.attempt_recovery(source, strategy, self.monitor.event_counter * 16);
        }

        // Predict next likely bugs
        let predictions: Vec<String> = matched_bugs.first()
            .map(|b| self.predictor.predict_next(&b.id)
                .into_iter()
                .map(|(id, _)| id)
                .take(3)
                .collect())
            .unwrap_or_default();

        BugReport {
            source: source.to_string(),
            message: message.to_string(),
            severity,
            matched_bugs: matched_bugs.iter().map(|b| b.id.clone()).collect(),
            fix_suggestions: matched_bugs.first()
                .map(|b| b.fix_suggestions.clone())
                .unwrap_or_default(),
            auto_recovery: recovery_action.map(|s| s.label()),
            predicted_next_bugs: predictions,
            system_health: self.survival.system_health_pct(),
        }
    }

    pub fn developer_profile(&self) -> Option<&PersonalBugProfile> {
        self.profiles.get(&self.active_developer)
    }

    pub fn print_dashboard(&self) {
        let stats = self.database.stats();
        let profile = self.profiles.get(&self.active_developer);
        let health = self.survival.system_health_pct();

        println!("╔═══════════════════════════════════════════════════════════════════════════╗");
        println!("║  BUG HUNTER & SURVIVAL SYSTEM — OMNISYSTEM ENTERPRISE FAULT PLATFORM     ║");
        println!("╠═══════════════════════════════════════════════════════════════════════════╣");
        println!("║  System Health: {}%   Survival Mode: {}",
            health,
            if self.survival.survival_mode_active { "ACTIVE" } else { "Off" }
        );
        println!("╠═══════════════════════════════════════════════════════════════════════════╣");
        println!("║  Known Bugs: {}  |  Open: {}  |  Resolved: {}  |  Auto-Recoverable: {}",
            stats.total, stats.open, stats.resolved, stats.auto_recoverable
        );
        if stats.critical_open > 0 {
            println!("║  ☣ CRITICAL OPEN BUGS: {}", stats.critical_open);
        }
        println!("╠═══════════════════════════════════════════════════════════════════════════╣");
        if let Some(p) = profile {
            println!("║  Developer: {}   Fix Rate: {:.0}%   Health Score: {}/100",
                self.active_developer,
                p.fix_rate() * 100.0,
                p.health_score()
            );
            if let Some((cat, count)) = p.most_common_category() {
                println!("║  Most common bug category: {} ({} times)", cat, count);
            }
            let chronic = p.chronic_bugs();
            if !chronic.is_empty() {
                println!("║  Chronic bugs (3+ hits):");
                for (id, count) in &chronic {
                    if let Some(bug) = self.database.lookup(id) {
                        println!("║    {} {} x{} — {}", bug.severity.emoji(), id, count, &bug.title[..bug.title.len().min(50)]);
                    }
                }
            }
        }
        println!("╠═══════════════════════════════════════════════════════════════════════════╣");
        println!("║  OPEN BUGS:");
        for bug in self.database.all_open() {
            println!("║    {} {} [{}] {}",
                bug.severity.emoji(),
                bug.id,
                bug.category.label(),
                &bug.title[..bug.title.len().min(55)]
            );
            if !bug.fix_suggestions.is_empty() {
                println!("║       Fix: {}", &bug.fix_suggestions[0][..bug.fix_suggestions[0].len().min(60)]);
            }
        }
        println!("╚═══════════════════════════════════════════════════════════════════════════╝");
    }
}

#[derive(Debug)]
pub struct BugReport {
    pub source: String,
    pub message: String,
    pub severity: BugSeverity,
    pub matched_bugs: Vec<String>,
    pub fix_suggestions: Vec<String>,
    pub auto_recovery: Option<String>,
    pub predicted_next_bugs: Vec<String>,
    pub system_health: u32,
}

impl BugReport {
    pub fn has_match(&self) -> bool {
        !self.matched_bugs.is_empty()
    }
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════
// ENTRY POINT & TESTS
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════

pub fn main() {
    let mut hunter = BugHunter::new("luci");

    hunter.print_dashboard();

    println!("\n── Simulating error events ──────────────────────────────────────────────────");

    let report = hunter.report_error(
        "webview",
        "Refused to execute inline script because it violates the content-security-policy directive",
        BugSeverity::Fatal,
    );
    println!("\n[REPORT] Source: {}", report.source);
    println!("  Matched bugs: {:?}", report.matched_bugs);
    println!("  Top fix: {}", report.fix_suggestions.first().unwrap_or(&"None".to_string()));
    println!("  Auto-recovery: {}", report.auto_recovery.as_deref().unwrap_or("None"));
    println!("  System health: {}%", report.system_health);

    let report2 = hunter.report_error(
        "desktop",
        "Icons visible but cannot click on anything — pointer-events blocked",
        BugSeverity::Critical,
    );
    println!("\n[REPORT] Source: {}", report2.source);
    println!("  Matched bugs: {:?}", report2.matched_bugs);
    println!("  Top fix: {}", report2.fix_suggestions.first().unwrap_or(&"None".to_string()));

    println!("\n── Final dashboard after error ingestion ────────────────────────────────────");
    hunter.print_dashboard();
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_database_seed() {
        let db = KnownBugDatabase::new();
        let stats = db.stats();
        assert!(stats.total >= 20, "should have 20+ seeded bugs");
        assert!(stats.resolved >= 12, "should have 12+ resolved bugs");
    }

    #[test]
    fn test_pattern_search_csp() {
        let db = KnownBugDatabase::new();
        let results = db.search_by_pattern("inline script blocked content-security-policy");
        assert!(!results.is_empty(), "should match BUG-001");
        assert_eq!(results[0].id, "BUG-001");
    }

    #[test]
    fn test_personal_profile_health_score() {
        let mut profile = PersonalBugProfile::new("dev");
        let bug = KnownBugDatabase::new();
        let b = bug.lookup("BUG-001").unwrap();
        profile.record_encounter(b);
        profile.record_fix("BUG-001", 30000);
        assert!(profile.health_score() > 50);
        assert_eq!(profile.fix_rate(), 1.0);
    }

    #[test]
    fn test_survival_engine_recovery() {
        let mut engine = SurvivalEngine::new();
        engine.report_component_failure("ipc-runtime", "process exited code 1");
        assert!(matches!(engine.system_state, SystemState::Degraded(_)));
        let outcome = engine.attempt_recovery(
            "ipc-runtime",
            &RecoveryStrategy::KillAndRespawnProcess,
            1000,
        );
        assert_eq!(outcome, RecoveryOutcome::InProgress);
        engine.mark_recovered("ipc-runtime");
        assert_eq!(engine.system_state, SystemState::Healthy);
    }

    #[test]
    fn test_bug_hunter_report() {
        let mut hunter = BugHunter::new("test-dev");
        let report = hunter.report_error(
            "webview",
            "00:00:00 clock not updating — script not executing",
            BugSeverity::Major,
        );
        assert!(report.has_match(), "should match BUG-003 via clock pattern");
    }

    #[test]
    fn test_monitor_error_rate() {
        let mut monitor = LiveErrorMonitor::new();
        for _ in 0..5 {
            monitor.ingest("test", "some error message", BugSeverity::Minor);
        }
        assert_eq!(monitor.event_counter, 5);
        assert!(monitor.events.len() == 5);
    }

    #[test]
    fn test_all_open_bugs_sorted() {
        let db = KnownBugDatabase::new();
        let open = db.all_open();
        for i in 1..open.len() {
            assert!(open[i - 1].severity >= open[i].severity, "should be sorted by severity desc");
        }
    }
}
