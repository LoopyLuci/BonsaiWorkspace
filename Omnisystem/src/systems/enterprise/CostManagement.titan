// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════
// OMNISYSTEM COST MANAGEMENT - BILLING, CHARGEBACK & COST OPTIMIZATION
// Resource costing, usage tracking, chargeback, cost allocation, optimization recommendations
// Language: TITAN (Systems Language)
// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════

use std::collections::HashMap;

pub struct CostManagement {
    pub cm_id: String,
    pub pricing_models: HashMap<String, PricingModel>,
    pub usage_records: Vec<UsageRecord>,
    pub bills: HashMap<String, Bill>,
    pub cost_allocation: CostAllocationEngine,
    pub optimization_engine: OptimizationEngine,
}

pub struct PricingModel {
    pub model_id: String,
    pub resource_type: ResourceType,
    pub unit: String,
    pub unit_cost: f64,
    pub currency: String,
    pub billing_period: BillingPeriod,
    pub discount_tiers: Vec<DiscountTier>,
}

#[derive(Clone, Copy, Debug, Hash, PartialEq, Eq)]
pub enum ResourceType {
    CPU,
    Memory,
    Storage,
    Network,
    GPU,
    License,
}

#[derive(Clone, Copy, Debug)]
pub enum BillingPeriod {
    Hourly,
    Daily,
    Monthly,
    Annual,
}

pub struct DiscountTier {
    pub tier_id: String,
    pub min_usage: u64,
    pub max_usage: u64,
    pub discount_percent: f64,
}

pub struct UsageRecord {
    pub record_id: String,
    pub tenant_id: String,
    pub resource_id: String,
    pub resource_type: ResourceType,
    pub quantity: f64,
    pub unit: String,
    pub timestamp: u64,
    pub duration_seconds: u32,
}

pub struct Bill {
    pub bill_id: String,
    pub tenant_id: String,
    pub billing_period_start: u64,
    pub billing_period_end: u64,
    pub line_items: Vec<LineItem>,
    pub subtotal: f64,
    pub taxes: f64,
    pub discounts: f64,
    pub total: f64,
    pub status: BillStatus,
}

#[derive(Clone, Copy, Debug)]
pub enum BillStatus {
    Draft,
    Pending,
    Issued,
    Paid,
    Overdue,
}

pub struct LineItem {
    pub item_id: String,
    pub resource_type: ResourceType,
    pub description: String,
    pub quantity: f64,
    pub unit_price: f64,
    pub amount: f64,
    pub discount: f64,
}

pub struct CostAllocationEngine {
    pub engine_id: String,
    pub allocation_rules: Vec<AllocationRule>,
    pub cost_centers: HashMap<String, CostCenter>,
    pub allocation_history: Vec<AllocationEvent>,
}

pub struct AllocationRule {
    pub rule_id: String,
    pub rule_name: String,
    pub source_cost_center: String,
    pub allocations: Vec<(String, f64)>, // (target_cost_center, percentage)
}

pub struct CostCenter {
    pub center_id: String,
    pub center_name: String,
    pub budget: f64,
    pub spent: f64,
    pub department: String,
    pub owner: String,
    pub projects: Vec<String>,
}

pub struct AllocationEvent {
    pub event_id: String,
    pub timestamp: u64,
    pub source_cost: f64,
    pub allocations: Vec<(String, f64)>,
}

pub struct OptimizationEngine {
    pub engine_id: String,
    pub recommendations: Vec<OptimizationRecommendation>,
    pub potential_savings: f64,
}

pub struct OptimizationRecommendation {
    pub rec_id: String,
    pub rec_type: RecommendationType,
    pub description: String,
    pub current_cost: f64,
    pub optimized_cost: f64,
    pub savings: f64,
    pub priority: Priority,
    pub implementation_effort: Effort,
}

#[derive(Clone, Copy, Debug)]
pub enum RecommendationType {
    InstanceDownsize,
    UnusedResourceCleanup,
    ReservedInstances,
    SpotInstances,
    CompressionOptimization,
    RightSizing,
}

#[derive(Clone, Copy, Debug)]
pub enum Priority {
    Critical,
    High,
    Medium,
    Low,
}

#[derive(Clone, Copy, Debug)]
pub enum Effort {
    Minimal,
    Low,
    Medium,
    High,
}

pub struct BudgetAlert {
    pub alert_id: String,
    pub cost_center_id: String,
    pub threshold_percent: u32,
    pub alert_type: AlertType,
    pub triggered: bool,
}

#[derive(Clone, Copy, Debug)]
pub enum AlertType {
    Warning,
    Critical,
}

pub struct CostTrend {
    pub trend_id: String,
    pub tenant_id: String,
    pub period_start: u64,
    pub period_end: u64,
    pub daily_costs: Vec<f64>,
    pub trend_direction: TrendDirection,
}

#[derive(Clone, Copy, Debug)]
pub enum TrendDirection {
    Increasing,
    Decreasing,
    Stable,
}

impl CostManagement {
    pub fn new() -> Self {
        CostManagement {
            cm_id: "cm-1".to_string(),
            pricing_models: HashMap::new(),
            usage_records: Vec::new(),
            bills: HashMap::new(),
            cost_allocation: CostAllocationEngine {
                engine_id: "cae-1".to_string(),
                allocation_rules: Vec::new(),
                cost_centers: HashMap::new(),
                allocation_history: Vec::new(),
            },
            optimization_engine: OptimizationEngine {
                engine_id: "oe-1".to_string(),
                recommendations: Vec::new(),
                potential_savings: 0.0,
            },
        }
    }

    pub fn set_pricing(&mut self, resource_type: ResourceType, unit_cost: f64, unit: &str) -> Result<String, String> {
        let model_id = format!("pricing_{:?}", resource_type);

        let pricing = PricingModel {
            model_id: model_id.clone(),
            resource_type,
            unit: unit.to_string(),
            unit_cost,
            currency: "USD".to_string(),
            billing_period: BillingPeriod::Monthly,
            discount_tiers: vec![
                DiscountTier {
                    tier_id: "tier1".to_string(),
                    min_usage: 1000,
                    max_usage: 10000,
                    discount_percent: 5.0,
                },
                DiscountTier {
                    tier_id: "tier2".to_string(),
                    min_usage: 10000,
                    max_usage: 100000,
                    discount_percent: 15.0,
                },
            ],
        };

        self.pricing_models.insert(model_id.clone(), pricing);
        println!("Set pricing for {:?}: ${}/unit", resource_type, unit_cost);
        Ok(model_id)
    }

    pub fn record_usage(&mut self, tenant_id: &str, resource_id: &str, resource_type: ResourceType, quantity: f64, duration_seconds: u32) {
        let record = UsageRecord {
            record_id: format!("usage_{}", hash_string(&format!("{}{}{}", tenant_id, resource_id, current_timestamp()))),
            tenant_id: tenant_id.to_string(),
            resource_id: resource_id.to_string(),
            resource_type,
            quantity,
            unit: "hours".to_string(),
            timestamp: current_timestamp(),
            duration_seconds,
        };

        self.usage_records.push(record);
    }

    pub fn generate_bill(&mut self, tenant_id: &str, period_start: u64, period_end: u64) -> Result<String, String> {
        let bill_id = format!("bill_{}", hash_string(&format!("{}{}", tenant_id, current_timestamp())));

        let mut line_items = Vec::new();
        let mut total = 0.0;

        for record in self.usage_records.iter().filter(|r| r.tenant_id == tenant_id && r.timestamp >= period_start && r.timestamp <= period_end) {
            if let Some(pricing) = self.pricing_models.get(&format!("pricing_{:?}", record.resource_type)) {
                let cost = record.quantity * pricing.unit_cost;
                total += cost;

                line_items.push(LineItem {
                    item_id: format!("item_{}", hash_string(&record.record_id)),
                    resource_type: record.resource_type,
                    description: format!("{:?} usage", record.resource_type),
                    quantity: record.quantity,
                    unit_price: pricing.unit_cost,
                    amount: cost,
                    discount: 0.0,
                });
            }
        }

        let bill = Bill {
            bill_id: bill_id.clone(),
            tenant_id: tenant_id.to_string(),
            billing_period_start: period_start,
            billing_period_end: period_end,
            line_items,
            subtotal: total,
            taxes: total * 0.1,
            discounts: 0.0,
            total: total * 1.1,
            status: BillStatus::Pending,
        };

        self.bills.insert(bill_id.clone(), bill);
        println!("Generated bill for {}: ${:.2}", tenant_id, total);
        Ok(bill_id)
    }

    pub fn create_cost_center(&mut self, name: &str, budget: f64, department: &str) -> Result<String, String> {
        let center_id = format!("cc_{}", hash_string(&format!("{}{}", name, budget)));

        let cost_center = CostCenter {
            center_id: center_id.clone(),
            center_name: name.to_string(),
            budget,
            spent: 0.0,
            department: department.to_string(),
            owner: "TBD".to_string(),
            projects: Vec::new(),
        };

        self.cost_allocation.cost_centers.insert(center_id.clone(), cost_center);
        println!("Created cost center: {} (${} budget)", name, budget);
        Ok(center_id)
    }

    pub fn generate_optimization_recommendations(&mut self) {
        // Analyze usage patterns and generate recommendations
        let total_usage = self.usage_records.len() as f64;

        if total_usage > 100.0 {
            let savings = total_usage * 0.1; // Example: 10% potential savings

            self.optimization_engine.recommendations.push(OptimizationRecommendation {
                rec_id: format!("rec_{}", hash_string(&format!("downsize{}", current_timestamp()))),
                rec_type: RecommendationType::InstanceDownsize,
                description: "Downsize underutilized instances".to_string(),
                current_cost: total_usage * 100.0,
                optimized_cost: total_usage * 100.0 * 0.9,
                savings,
                priority: Priority::High,
                implementation_effort: Effort::Low,
            });

            self.optimization_engine.potential_savings = savings;
        }

        println!("Generated {} optimization recommendations", self.optimization_engine.recommendations.len());
    }

    pub fn get_cost_stats(&self) -> String {
        let total_cost: f64 = self.bills.values().map(|b| b.total).sum();
        let avg_bill: f64 = if self.bills.is_empty() { 0.0 } else { total_cost / self.bills.len() as f64 };

        format!(
            "Cost Management\nBills Generated: {}\nTotal Cost: ${:.2}\nAverage Bill: ${:.2}\nCost Centers: {}\nSavings Potential: ${:.2}",
            self.bills.len(),
            total_cost,
            avg_bill,
            self.cost_allocation.cost_centers.len(),
            self.optimization_engine.potential_savings
        )
    }
}

fn hash_string(s: &str) -> String {
    let mut hash: u64 = 5381;
    for c in s.chars() {
        hash = ((hash << 5).wrapping_add(hash)).wrapping_add(c as u64);
    }
    format!("{:x}", hash).chars().take(12).collect()
}

fn current_timestamp() -> u64 {
    std::time::SystemTime::now()
        .duration_since(std::time::UNIX_EPOCH)
        .unwrap_or_default()
        .as_secs()
}

pub fn main() {
    println!("╔═══════════════════════════════════════════════════════════════╗");
    println!("║       OMNISYSTEM COST MANAGEMENT v3.0.0                      ║");
    println!("║    Billing, Chargeback & Cost Optimization                   ║");
    println!("╚═══════════════════════════════════════════════════════════════╝\n");

    let mut cm = CostManagement::new();

    let _ = cm.set_pricing(ResourceType::CPU, 0.10, "vCPU-hour");
    let _ = cm.set_pricing(ResourceType::Memory, 0.05, "GB-hour");
    let _ = cm.set_pricing(ResourceType::Storage, 0.01, "GB-month");
    let _ = cm.set_pricing(ResourceType::Network, 0.02, "GB-transfer");

    let _ = cm.create_cost_center("Engineering", 100_000.0, "Development");
    let _ = cm.create_cost_center("Operations", 50_000.0, "Infrastructure");
    let _ = cm.create_cost_center("Sales", 25_000.0, "Revenue");

    // Record usage
    for i in 0..50 {
        cm.record_usage("tenant-a", &format!("app-{}", i), ResourceType::CPU, 10.0, 3600);
        cm.record_usage("tenant-a", &format!("app-{}", i), ResourceType::Memory, 16.0, 3600);
    }

    let now = current_timestamp();
    let _ = cm.generate_bill("tenant-a", now - 86400 * 30, now);

    cm.generate_optimization_recommendations();

    println!("\n{}", cm.get_cost_stats());
}
