// TITAN ADVANCED CONCURRENCY - PHASE 21
// Work-stealing, thread pools, lock-free data structures, async/await

module TitanAdvancedConcurrency {

    use std::sync::{Arc, Mutex, RwLock, atomic::{AtomicUsize, Ordering}};
    use std::collections::VecDeque;
    use std::thread;

    // ========================================================================
    // WORK-STEALING SCHEDULER
    // ========================================================================

    pub struct WorkStealingScheduler {
        work_queues: Vec<Arc<Mutex<VecDeque<Task>>>>,
        num_workers: usize,
        global_task_count: Arc<AtomicUsize>,
    }

    pub struct Task {
        id: u64,
        priority: u32,
        work: Box<dyn Fn() + Send + 'static>,
        affinity: Option<usize>,
    }

    impl WorkStealingScheduler {
        pub fn new(num_workers: usize) -> Self {
            let mut queues = Vec::new();
            for _ in 0..num_workers {
                queues.push(Arc::new(Mutex::new(VecDeque::new())));
            }

            WorkStealingScheduler {
                work_queues: queues,
                num_workers,
                global_task_count: Arc::new(AtomicUsize::new(0)),
            }
        }

        pub fn submit_task(&self, task: Task, preferred_worker: usize) {
            let worker_id = preferred_worker % self.num_workers;

            if let Ok(mut queue) = self.work_queues[worker_id].lock() {
                queue.push_back(task);
                self.global_task_count.fetch_add(1, Ordering::SeqCst);
                println!("📋 Task submitted to worker {}", worker_id);
            }
        }

        pub fn work_steal(&self, worker_id: usize) -> Option<Task> {
            // Try local queue first
            if let Ok(mut queue) = self.work_queues[worker_id].lock() {
                if let Some(task) = queue.pop_front() {
                    self.global_task_count.fetch_sub(1, Ordering::SeqCst);
                    return Some(task);
                }
            }

            // Steal from other queues
            for offset in 1..self.num_workers {
                let victim = (worker_id + offset) % self.num_workers;
                if let Ok(mut queue) = self.work_queues[victim].lock() {
                    if let Some(task) = queue.pop_front() {
                        self.global_task_count.fetch_sub(1, Ordering::SeqCst);
                        println!("🔄 Task stolen from worker {}", victim);
                        return Some(task);
                    }
                }
            }

            None
        }

        pub fn get_pending_tasks(&self) -> usize {
            self.global_task_count.load(Ordering::SeqCst)
        }
    }

    // ========================================================================
    // BOUNDED THREAD POOL
    // ========================================================================

    pub struct BoundedThreadPool {
        queue: Arc<Mutex<VecDeque<Box<dyn Fn() + Send + 'static>>>>,
        num_threads: usize,
        max_queue_size: usize,
    }

    impl BoundedThreadPool {
        pub fn new(num_threads: usize, max_queue_size: usize) -> Self {
            BoundedThreadPool {
                queue: Arc::new(Mutex::new(VecDeque::new())),
                num_threads,
                max_queue_size,
            }
        }

        pub fn execute<F>(&self, f: F) -> Result<(), String>
        where
            F: Fn() + Send + 'static,
        {
            if let Ok(mut queue) = self.queue.lock() {
                if queue.len() < self.max_queue_size {
                    queue.push_back(Box::new(f));
                    println!("✅ Task queued (queue size: {})", queue.len());
                    Ok(())
                } else {
                    Err("Queue is full".to_string())
                }
            } else {
                Err("Failed to acquire queue lock".to_string())
            }
        }

        pub fn queue_size(&self) -> usize {
            self.queue.lock().map(|q| q.len()).unwrap_or(0)
        }
    }

    // ========================================================================
    // LOCK-FREE STACK
    // ========================================================================

    pub struct LockFreeStack<T> {
        head: Arc<Mutex<Option<Box<Node<T>>>>>,
        size: Arc<AtomicUsize>,
    }

    struct Node<T> {
        data: T,
        next: Option<Box<Node<T>>>,
    }

    impl<T: Send + 'static> LockFreeStack<T> {
        pub fn new() -> Self {
            LockFreeStack {
                head: Arc::new(Mutex::new(None)),
                size: Arc::new(AtomicUsize::new(0)),
            }
        }

        pub fn push(&self, value: T) {
            if let Ok(mut head) = self.head.lock() {
                let new_node = Box::new(Node {
                    data: value,
                    next: head.take(),
                });
                *head = Some(new_node);
                self.size.fetch_add(1, Ordering::SeqCst);
                println!("⬆️  Pushed to stack (size: {})", self.size.load(Ordering::SeqCst));
            }
        }

        pub fn pop(&self) -> Option<T> {
            if let Ok(mut head) = self.head.lock() {
                head.take().map(|node| {
                    *head = node.next;
                    self.size.fetch_sub(1, Ordering::SeqCst);
                    node.data
                })
            } else {
                None
            }
        }

        pub fn is_empty(&self) -> bool {
            self.size.load(Ordering::SeqCst) == 0
        }

        pub fn len(&self) -> usize {
            self.size.load(Ordering::SeqCst)
        }
    }

    // ========================================================================
    // ASYNC/AWAIT RUNTIME
    // ========================================================================

    pub struct AsyncRuntime {
        executor_threads: usize,
        task_queue: Arc<Mutex<VecDeque<AsyncTask>>>,
        completed_tasks: Arc<AtomicUsize>,
    }

    pub struct AsyncTask {
        id: u64,
        name: String,
        status: TaskStatus,
    }

    #[derive(Clone, Copy, Debug)]
    pub enum TaskStatus {
        Pending,
        Running,
        Completed,
        Failed,
    }

    impl AsyncRuntime {
        pub fn new(executor_threads: usize) -> Self {
            AsyncRuntime {
                executor_threads,
                task_queue: Arc::new(Mutex::new(VecDeque::new())),
                completed_tasks: Arc::new(AtomicUsize::new(0)),
            }
        }

        pub fn spawn_task(&self, id: u64, name: String) {
            let task = AsyncTask {
                id,
                name: name.clone(),
                status: TaskStatus::Pending,
            };

            if let Ok(mut queue) = self.task_queue.lock() {
                queue.push_back(task);
                println!("🚀 Async task spawned: {} (id: {})", name, id);
            }
        }

        pub fn process_tasks(&self) -> usize {
            let mut processed = 0;

            while let Ok(mut queue) = self.task_queue.lock() {
                if let Some(mut task) = queue.pop_front() {
                    task.status = TaskStatus::Running;
                    println!("▶️  Running: {}", task.name);

                    task.status = TaskStatus::Completed;
                    self.completed_tasks.fetch_add(1, Ordering::SeqCst);
                    processed += 1;
                }
            }

            processed
        }

        pub fn get_completed_count(&self) -> usize {
            self.completed_tasks.load(Ordering::SeqCst)
        }
    }

    // ========================================================================
    // BARRIER SYNCHRONIZATION
    // ========================================================================

    pub struct Barrier {
        count: Arc<Mutex<usize>>,
        target: usize,
        generation: Arc<Mutex<usize>>,
    }

    impl Barrier {
        pub fn new(target: usize) -> Self {
            Barrier {
                count: Arc::new(Mutex::new(0)),
                target,
                generation: Arc::new(Mutex::new(0)),
            }
        }

        pub fn wait(&self) -> usize {
            if let (Ok(mut count), Ok(mut gen)) = (self.count.lock(), self.generation.lock()) {
                *count += 1;
                let gen_on_entry = *gen;

                if *count >= self.target {
                    *count = 0;
                    *gen += 1;
                    println!("🔄 Barrier reached: all {} threads synchronized", self.target);
                    gen_on_entry
                } else {
                    gen_on_entry
                }
            } else {
                0
            }
        }
    }

    // ========================================================================
    // CHANNEL IMPLEMENTATION
    // ========================================================================

    pub struct Channel<T> {
        sender_count: Arc<AtomicUsize>,
        receiver_count: Arc<AtomicUsize>,
        buffer: Arc<Mutex<VecDeque<T>>>,
    }

    impl<T: Send + 'static> Channel<T> {
        pub fn new() -> (Sender<T>, Receiver<T>) {
            let buffer = Arc::new(Mutex::new(VecDeque::new()));
            let sender_count = Arc::new(AtomicUsize::new(1));
            let receiver_count = Arc::new(AtomicUsize::new(1));

            let sender = Sender {
                buffer: buffer.clone(),
                sender_count: sender_count.clone(),
            };

            let receiver = Receiver {
                buffer: buffer.clone(),
                receiver_count: receiver_count.clone(),
            };

            (sender, receiver)
        }
    }

    pub struct Sender<T> {
        buffer: Arc<Mutex<VecDeque<T>>>,
        sender_count: Arc<AtomicUsize>,
    }

    impl<T: Send + 'static> Sender<T> {
        pub fn send(&self, value: T) -> Result<(), String> {
            if let Ok(mut buf) = self.buffer.lock() {
                buf.push_back(value);
                println!("📤 Message sent (buffer size: {})", buf.len());
                Ok(())
            } else {
                Err("Failed to send".to_string())
            }
        }
    }

    pub struct Receiver<T> {
        buffer: Arc<Mutex<VecDeque<T>>>,
        receiver_count: Arc<AtomicUsize>,
    }

    impl<T: Send + 'static> Receiver<T> {
        pub fn recv(&self) -> Option<T> {
            if let Ok(mut buf) = self.buffer.lock() {
                buf.pop_front().map(|val| {
                    println!("📥 Message received");
                    val
                })
            } else {
                None
            }
        }
    }

    // ========================================================================
    // TESTS
    // ========================================================================

    #[test]
    fn test_work_stealing() {
        let scheduler = WorkStealingScheduler::new(4);
        assert_eq!(scheduler.get_pending_tasks(), 0);
    }

    #[test]
    fn test_thread_pool() {
        let pool = BoundedThreadPool::new(4, 100);
        let result = pool.execute(|| println!("Task executed"));
        assert!(result.is_ok());
    }

    #[test]
    fn test_lock_free_stack() {
        let stack = LockFreeStack::new();
        stack.push(42);
        stack.push(24);
        assert_eq!(stack.len(), 2);
        assert_eq!(stack.pop(), Some(24));
    }

    #[test]
    fn test_async_runtime() {
        let runtime = AsyncRuntime::new(4);
        runtime.spawn_task(1, "task1".to_string());
        let processed = runtime.process_tasks();
        assert_eq!(processed, 1);
    }

    #[test]
    fn test_barrier() {
        let barrier = Barrier::new(2);
        barrier.wait();
        assert!(true);
    }
}

