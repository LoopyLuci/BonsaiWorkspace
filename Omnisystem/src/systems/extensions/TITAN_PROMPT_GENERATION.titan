// TITAN PROMPT GENERATION SYSTEM - PHASE 20
// Core prompt generation engine, templates, variable substitution, optimization

module TitanPromptGeneration {

    use std::collections::HashMap;
    use std::sync::{Arc, RwLock};

    // ========================================================================
    // PROMPT TEMPLATE SYSTEM
    // ========================================================================

    #[derive(Clone, Debug)]
    pub struct PromptTemplate {
        pub id: String,
        pub name: String,
        pub version: u32,
        pub content: String,
        pub variables: Vec<TemplateVariable>,
        pub tags: Vec<String>,
        pub created_at: u64,
        pub updated_at: u64,
    }

    #[derive(Clone, Debug)]
    pub struct TemplateVariable {
        pub name: String,
        pub description: String,
        pub required: bool,
        pub default_value: Option<String>,
        pub var_type: VariableType,
    }

    #[derive(Clone, Debug, PartialEq)]
    pub enum VariableType {
        String,
        Number,
        Boolean,
        List,
        Object,
    }

    pub struct PromptTemplateBuilder {
        id: String,
        name: String,
        content: String,
        variables: Vec<TemplateVariable>,
        tags: Vec<String>,
    }

    impl PromptTemplateBuilder {
        pub fn new(id: &str, name: &str) -> Self {
            PromptTemplateBuilder {
                id: id.to_string(),
                name: name.to_string(),
                content: String::new(),
                variables: Vec::new(),
                tags: Vec::new(),
            }
        }

        pub fn content(mut self, content: &str) -> Self {
            self.content = content.to_string();
            self
        }

        pub fn add_variable(
            mut self,
            name: &str,
            description: &str,
            required: bool,
            var_type: VariableType,
        ) -> Self {
            self.variables.push(TemplateVariable {
                name: name.to_string(),
                description: description.to_string(),
                required,
                default_value: None,
                var_type,
            });
            self
        }

        pub fn add_tag(mut self, tag: &str) -> Self {
            self.tags.push(tag.to_string());
            self
        }

        pub fn build(self) -> PromptTemplate {
            PromptTemplate {
                id: self.id,
                name: self.name,
                version: 1,
                content: self.content,
                variables: self.variables,
                tags: self.tags,
                created_at: current_timestamp(),
                updated_at: current_timestamp(),
            }
        }
    }

    // ========================================================================
    // PROMPT GENERATOR
    // ========================================================================

    pub struct PromptGenerator {
        templates: Arc<RwLock<HashMap<String, PromptTemplate>>>,
        rendered_prompts: Arc<RwLock<Vec<RenderedPrompt>>>,
    }

    #[derive(Clone, Debug)]
    pub struct RenderedPrompt {
        pub template_id: String,
        pub prompt_text: String,
        pub variables_used: HashMap<String, String>,
        pub generated_at: u64,
        pub tokens_estimated: u32,
    }

    impl PromptGenerator {
        pub fn new() -> Self {
            PromptGenerator {
                templates: Arc::new(RwLock::new(HashMap::new())),
                rendered_prompts: Arc::new(RwLock::new(Vec::new())),
            }
        }

        pub fn register_template(&self, template: PromptTemplate) -> Result<(), String> {
            let mut templates = self.templates.write().unwrap();

            if templates.contains_key(&template.id) {
                return Err(format!("Template {} already exists", template.id));
            }

            println!("📝 Template registered: {} (v{})", template.name, template.version);
            templates.insert(template.id.clone(), template);

            Ok(())
        }

        pub fn generate(
            &self,
            template_id: &str,
            variables: HashMap<String, String>,
        ) -> Result<RenderedPrompt, String> {
            let templates = self.templates.read().unwrap();
            let template = templates
                .get(template_id)
                .ok_or_else(|| format!("Template {} not found", template_id))?;

            // Validate required variables
            for var in &template.variables {
                if var.required && !variables.contains_key(&var.name) {
                    return Err(format!("Required variable {} not provided", var.name));
                }
            }

            // Substitute variables in content
            let mut prompt_text = template.content.clone();

            for (var_name, var_value) in &variables {
                let placeholder = format!("{{{{{}}}}}", var_name);
                prompt_text = prompt_text.replace(&placeholder, var_value);
            }

            // Estimate tokens (rough approximation: 1 token ~= 4 chars)
            let tokens_estimated = (prompt_text.len() / 4) as u32;

            let rendered = RenderedPrompt {
                template_id: template_id.to_string(),
                prompt_text: prompt_text.clone(),
                variables_used: variables,
                generated_at: current_timestamp(),
                tokens_estimated,
            };

            // Store rendered prompt
            self.rendered_prompts
                .write()
                .unwrap()
                .push(rendered.clone());

            println!(
                "✅ Prompt generated from '{}': {} tokens",
                template.name, tokens_estimated
            );

            Ok(rendered)
        }

        pub fn get_template(&self, template_id: &str) -> Option<PromptTemplate> {
            self.templates.read().unwrap().get(template_id).cloned()
        }

        pub fn list_templates(&self) -> Vec<PromptTemplate> {
            self.templates
                .read()
                .unwrap()
                .values()
                .cloned()
                .collect()
        }

        pub fn get_rendered_prompts(&self) -> Vec<RenderedPrompt> {
            self.rendered_prompts.read().unwrap().clone()
        }
    }

    // ========================================================================
    // PROMPT OPTIMIZATION
    // ========================================================================

    pub struct PromptOptimizer;

    #[derive(Clone, Debug)]
    pub struct OptimizedPrompt {
        pub original_prompt: String,
        pub optimized_prompt: String,
        pub improvements: Vec<Improvement>,
        pub tokens_saved: u32,
    }

    #[derive(Clone, Debug)]
    pub struct Improvement {
        pub technique: String,
        pub description: String,
        pub impact: String,
    }

    impl PromptOptimizer {
        pub fn optimize(prompt: &str) -> OptimizedPrompt {
            let mut optimized = prompt.to_string();
            let mut improvements = Vec::new();

            // Remove redundant spaces
            optimized = optimized
                .split_whitespace()
                .collect::<Vec<&str>>()
                .join(" ");

            improvements.push(Improvement {
                technique: "whitespace-normalization".to_string(),
                description: "Normalize excessive whitespace".to_string(),
                impact: "Better token efficiency".to_string(),
            });

            // Remove common filler phrases
            let fillers = vec!["I think", "basically", "honestly", "in my opinion"];
            for filler in fillers {
                if optimized.contains(filler) {
                    optimized = optimized.replace(&format!("{} ", filler), "");
                    improvements.push(Improvement {
                        technique: "filler-removal".to_string(),
                        description: format!("Remove filler phrase: {}", filler),
                        impact: "Reduced verbosity".to_string(),
                    });
                }
            }

            let original_tokens = (prompt.len() / 4) as u32;
            let optimized_tokens = (optimized.len() / 4) as u32;
            let tokens_saved = original_tokens.saturating_sub(optimized_tokens);

            OptimizedPrompt {
                original_prompt: prompt.to_string(),
                optimized_prompt: optimized,
                improvements,
                tokens_saved,
            }
        }

        pub fn suggest_improvements(prompt: &str) -> Vec<String> {
            let mut suggestions = Vec::new();

            // Check prompt length
            if prompt.len() > 2000 {
                suggestions.push("Consider breaking into multiple focused prompts".to_string());
            }

            // Check for clarity
            if prompt.contains("?") && prompt.matches("?").count() > 5 {
                suggestions.push("Multiple questions detected - consider restructuring".to_string());
            }

            // Check for examples
            if !prompt.contains("example") && !prompt.contains("Example") {
                suggestions.push("Adding examples improves response quality".to_string());
            }

            // Check for role/context
            if !prompt.contains("role") && !prompt.contains("expert") {
                suggestions.push("Specify a role or context for better results".to_string());
            }

            suggestions
        }
    }

    // ========================================================================
    // PROMPT VALIDATION
    // ========================================================================

    pub struct PromptValidator;

    #[derive(Clone, Debug)]
    pub struct ValidationResult {
        pub valid: bool,
        pub issues: Vec<ValidationIssue>,
        pub warnings: Vec<String>,
        pub score: f32,
    }

    #[derive(Clone, Debug)]
    pub struct ValidationIssue {
        pub severity: IssueSeverity,
        pub message: String,
        pub suggestion: Option<String>,
    }

    #[derive(Clone, Debug, PartialEq)]
    pub enum IssueSeverity {
        Error,
        Warning,
        Info,
    }

    impl PromptValidator {
        pub fn validate(prompt: &str) -> ValidationResult {
            let mut issues = Vec::new();
            let mut warnings = Vec::new();
            let mut score = 100.0f32;

            // Check for empty prompt
            if prompt.trim().is_empty() {
                issues.push(ValidationIssue {
                    severity: IssueSeverity::Error,
                    message: "Prompt is empty".to_string(),
                    suggestion: Some("Provide meaningful content".to_string()),
                });
                score -= 50.0;
            }

            // Check for minimum length
            if prompt.len() < 10 {
                warnings.push("Prompt is very short - may not provide enough context".to_string());
                score -= 10.0;
            }

            // Check for clarity markers
            if !prompt.contains(":") && !prompt.contains("?") {
                warnings.push("Prompt lacks clear question or instruction structure".to_string());
                score -= 5.0;
            }

            // Check token count
            let tokens = (prompt.len() / 4) as u32;
            if tokens > 4000 {
                warnings.push(format!(
                    "Prompt is very long ({} tokens) - consider breaking it up",
                    tokens
                ));
                score -= 15.0;
            }

            // Check for balanced format
            if prompt.matches("{").count() != prompt.matches("}").count() {
                issues.push(ValidationIssue {
                    severity: IssueSeverity::Warning,
                    message: "Unbalanced braces detected".to_string(),
                    suggestion: Some("Check variable placeholder syntax".to_string()),
                });
                score -= 10.0;
            }

            let valid = issues.is_empty()
                || !issues
                    .iter()
                    .any(|i| i.severity == IssueSeverity::Error);

            ValidationResult {
                valid,
                issues,
                warnings,
                score: score.max(0.0),
            }
        }
    }

    // ========================================================================
    // PROMPT CHAINING
    // ========================================================================

    pub struct PromptChain {
        pub chain_id: String,
        pub steps: Vec<ChainStep>,
        pub context: HashMap<String, String>,
    }

    #[derive(Clone, Debug)]
    pub struct ChainStep {
        pub step_id: u32,
        pub template_id: String,
        pub input_mapping: HashMap<String, String>,
        pub output_key: String,
    }

    impl PromptChain {
        pub fn new(chain_id: &str) -> Self {
            PromptChain {
                chain_id: chain_id.to_string(),
                steps: Vec::new(),
                context: HashMap::new(),
            }
        }

        pub fn add_step(
            mut self,
            step_id: u32,
            template_id: &str,
            output_key: &str,
        ) -> Self {
            self.steps.push(ChainStep {
                step_id,
                template_id: template_id.to_string(),
                input_mapping: HashMap::new(),
                output_key: output_key.to_string(),
            });
            self
        }

        pub fn set_context(&mut self, key: &str, value: &str) {
            self.context.insert(key.to_string(), value.to_string());
        }

        pub fn execute(&self, generator: &PromptGenerator) -> Result<Vec<RenderedPrompt>, String> {
            let mut results = Vec::new();

            for step in &self.steps {
                let template = generator
                    .get_template(&step.template_id)
                    .ok_or_else(|| format!("Template {} not found", step.template_id))?;

                let mut vars = step.input_mapping.clone();

                // Add context variables
                for (key, value) in &self.context {
                    vars.insert(key.clone(), value.clone());
                }

                let rendered = generator.generate(&step.template_id, vars)?;
                results.push(rendered);
            }

            println!(
                "✅ Prompt chain '{}' executed: {} steps",
                self.chain_id,
                self.steps.len()
            );

            Ok(results)
        }
    }

    // ========================================================================
    // TESTS
    // ========================================================================

    #[test]
    fn test_template_builder() {
        let template = PromptTemplateBuilder::new("t1", "Test Template")
            .content("Hello {{name}}, you are {{role}}")
            .add_variable("name", "User's name", true, VariableType::String)
            .add_variable("role", "User's role", true, VariableType::String)
            .add_tag("greeting")
            .build();

        assert_eq!(template.name, "Test Template");
        assert_eq!(template.variables.len(), 2);
    }

    #[test]
    fn test_prompt_generation() {
        let generator = PromptGenerator::new();

        let template = PromptTemplateBuilder::new("t1", "Greeting")
            .content("Hello {{name}}")
            .add_variable("name", "Name", true, VariableType::String)
            .build();

        generator.register_template(template).ok();

        let mut vars = HashMap::new();
        vars.insert("name".to_string(), "World".to_string());

        let result = generator.generate("t1", vars);
        assert!(result.is_ok());
        assert!(result.unwrap().prompt_text.contains("World"));
    }

    #[test]
    fn test_prompt_optimization() {
        let prompt = "I think basically this is, honestly, a test prompt";
        let optimized = PromptOptimizer::optimize(prompt);
        assert!(optimized.tokens_saved > 0);
    }

    #[test]
    fn test_prompt_validation() {
        let prompt = "This is a valid prompt with clear structure and purpose.";
        let result = PromptValidator::validate(prompt);
        assert!(result.valid);
        assert!(result.score > 50.0);
    }

    #[test]
    fn test_prompt_chain() {
        let chain = PromptChain::new("chain1")
            .add_step(1, "template1", "output1")
            .add_step(2, "template2", "output2");

        assert_eq!(chain.steps.len(), 2);
    }
}

fn current_timestamp() -> u64 {
    use std::time::{SystemTime, UNIX_EPOCH};
    SystemTime::now()
        .duration_since(UNIX_EPOCH)
        .unwrap()
        .as_secs()
}

