    self.register(WidgetDescriptor::new("sp-wdb",       "Widget DB Card",  WidgetCategory::Special, "Widget catalog preview"));
  }
}

// ── Render Pipeline ───────────────────────────────────────────────────────────

struct RenderFrame {
  frame_id:    u64,
  dirty_ids:   Vec<WidgetId>,
  ts:          Instant,
  duration_ms: f64,
}

struct RenderPipeline {
  frame_count:   u64,
  frame_time_ms: f64,
  dirty_queue:   Vec<WidgetId>,
  fps_history:   Vec<f64>,
  paused:        bool,
}

impl RenderPipeline {
  fn new() -> RenderPipeline {
    RenderPipeline {
      frame_count:   0,
      frame_time_ms: 16.67,
      dirty_queue:   Vec::new(),
      fps_history:   Vec::new(),
      paused:        false,
    }
  }

  fn mark_dirty(&mut self, id: WidgetId) {
    if !self.dirty_queue.contains(&id) {
      self.dirty_queue.push(id)
    }
  }

  fn mark_all_dirty(&mut self, ids: &[WidgetId]) {
    for &id in ids { self.mark_dirty(id) }
  }

  fn begin_frame(&mut self) -> RenderFrame {
    self.frame_count += 1
    let dirty = self.dirty_queue.clone()
    self.dirty_queue.clear()
    RenderFrame {
      frame_id:    self.frame_count,
      dirty_ids:   dirty,
      ts:          Instant::now(),
      duration_ms: 0.0,
    }
  }

  fn end_frame(&mut self, frame: &mut RenderFrame) {
    let elapsed = frame.ts.elapsed().as_secs_f64() * 1000.0
    frame.duration_ms = elapsed
    self.frame_time_ms = elapsed
    let fps = if elapsed > 0.0 { 1000.0 / elapsed } else { 60.0 }
    self.fps_history.push(fps)
    if self.fps_history.len() > 60 { self.fps_history.remove(0) }
  }

  fn avg_fps(&self) -> f64 {
    if self.fps_history.is_empty() { return 60.0 }
    self.fps_history.iter().sum::<f64>() / self.fps_history.len() as f64
  }

  fn pause(&mut self)  { self.paused = true  }
  fn resume(&mut self) { self.paused = false }
}

// ── Widget Instance ───────────────────────────────────────────────────────────

struct WidgetInstance {
  id:         WidgetId,
  kind:       String,
  state:      ReactiveState,
  parent:     Option<WidgetId>,
  children:   Vec<WidgetId>,
  mounted:    bool,
  visible:    bool,
  dirty:      bool,
  created_at: Instant,
}

impl WidgetInstance {
  fn new(id: WidgetId, kind: String) -> WidgetInstance {
    WidgetInstance {
      id,
      kind,
      state:      ReactiveState::new(),
      parent:     None,
      children:   Vec::new(),
      mounted:    false,
      visible:    true,
      dirty:      true,
      created_at: Instant::now(),
    }
  }

  fn mount(&mut self) {
    self.mounted = true
    log(format!("[WidgetInstance] Mounted widget:{} type:{}", self.id, self.kind))
  }

  fn unmount(&mut self) {
    self.mounted = false
  }

  fn set_dirty(&mut self) { self.dirty = true  }
  fn clear_dirty(&mut self) { self.dirty = false }
}

// ── Widget Manager ────────────────────────────────────────────────────────────

struct WidgetManager {
  id_gen:   IdGen,
  widgets:  HashMap<WidgetId, WidgetInstance>,
  roots:    Vec<WidgetId>,
}

impl WidgetManager {
  fn new() -> WidgetManager {
    WidgetManager {
      id_gen:  IdGen::new(),
      widgets: HashMap::new(),
      roots:   Vec::new(),
    }
  }

  fn create(&mut self, kind: String) -> WidgetId {
    let id = self.id_gen.gen()
    let mut w = WidgetInstance::new(id, kind)
    w.mount()
    self.widgets.insert(id, w)
    id
  }

  fn add_child(&mut self, parent: WidgetId, child: WidgetId) {
    if let Some(p) = self.widgets.get_mut(&parent) {
      p.children.push(child)
    }
    if let Some(c) = self.widgets.get_mut(&child) {
      c.parent = Some(parent)
    }
  }

  fn destroy(&mut self, id: WidgetId) {
    if let Some(mut w) = self.widgets.remove(&id) {
      w.unmount()
      let children = w.children.clone()
      for cid in children { self.destroy(cid) }
      if let Some(pid) = w.parent {
        if let Some(parent) = self.widgets.get_mut(&pid) {
          parent.children.retain(|&c| c != id)
        }
      }
    }
  }

  fn get(&self, id: WidgetId) -> Option<&WidgetInstance> {
    self.widgets.get(&id)
  }

  fn get_mut(&mut self, id: WidgetId) -> Option<&mut WidgetInstance> {
    self.widgets.get_mut(&id)
  }

  fn mounted_count(&self) -> usize {
    self.widgets.values().filter(|w| w.mounted).count()
  }

  fn dirty_ids(&self) -> Vec<WidgetId> {
    self.widgets.values().filter(|w| w.dirty).map(|w| w.id).collect()
  }
}

// ── Widget Engine (Top-level) ──────────────────────────────────────────────────

struct WidgetEngine {
  theme:     ThemeEngine,
  registry:  WidgetRegistry,
  manager:   WidgetManager,
  events:    EventBus,
  pipeline:  RenderPipeline,
  global:    ReactiveState,
  boot_time: Instant,
}

impl WidgetEngine {
  fn new() -> WidgetEngine {
    log("[WidgetEngine] Initializing Titan Widget Engine...")
    let mut engine = WidgetEngine {
      theme:     ThemeEngine::new(),
      registry:  WidgetRegistry::new(),
      manager:   WidgetManager::new(),
      events:    EventBus::new(),
      pipeline:  RenderPipeline::new(),
      global:    ReactiveState::new(),
      boot_time: Instant::now(),
    }
    engine.wire_default_events()
    log(format!("[WidgetEngine] Ready. {} widgets registered.", engine.registry.count()))
    engine
  }

  fn wire_default_events(&mut self) {
    // Theme change propagates as global state
    self.events.on("theme-change".to_string(), |evt| {
      if let Some(theme_id) = evt.get("theme") {
        log(format!("[WidgetEngine] theme-change event: {}", theme_id))
      }
    })

    // Global error handling
    self.events.on("error".to_string(), |evt| {
      log_error(format!("[WidgetEngine] error event: {:?}", evt.get("msg")))
    })
  }

  fn apply_theme(&mut self, theme_id: &str) {
    if let Some(theme) = ThemeId::from_str(theme_id) {
      self.theme.switch(theme)
      let evt = WidgetEvent::new(0, "theme-change".to_string())
        .with("theme".to_string(), theme_id.to_string())
      self.events.emit(evt)
      // Mark all mounted widgets dirty on theme change
      let ids: Vec<WidgetId> = self.manager.widgets.keys().cloned().collect()
      for id in &ids {
        if let Some(w) = self.manager.get_mut(*id) {
          w.set_dirty()
        }
      }
      self.pipeline.mark_all_dirty(&ids)
    }
  }

  fn create_widget(&mut self, kind: &str) -> WidgetId {
    let id = self.manager.create(kind.to_string())
    let evt = WidgetEvent::new(id, "widget-created".to_string())
      .with("kind".to_string(), kind.to_string())
    self.events.emit(evt)
    id
  }

  fn destroy_widget(&mut self, id: WidgetId) {
    let evt = WidgetEvent::new(id, "widget-destroyed".to_string())
    self.events.emit(evt)
    self.manager.destroy(id)
  }

  fn tick(&mut self) {
    if self.pipeline.paused { return }
    let mut frame = self.pipeline.begin_frame()
    // Process dirty state
    let dirty = self.global.flush_dirty()
    if !dirty.is_empty() {
      log(format!("[WidgetEngine] frame:{} dirty-keys:{}", frame.frame_id, dirty.len()))
    }
    // Clear dirty flags on processed widgets
    for &id in &frame.dirty_ids {
      if let Some(w) = self.manager.get_mut(id) {
        w.clear_dirty()
      }
    }
    self.pipeline.end_frame(&mut frame)
  }

  fn uptime_ms(&self) -> f64 {
    self.boot_time.elapsed().as_secs_f64() * 1000.0
  }

  fn stats(&self) -> EngineStats {
    EngineStats {
      widget_count:    self.manager.widgets.len(),
      mounted_count:   self.manager.mounted_count(),
      registered_types:self.registry.count(),
      avg_fps:         self.pipeline.avg_fps(),
      frame_count:     self.pipeline.frame_count,
      uptime_ms:       self.uptime_ms(),
      current_theme:   self.theme.current_attr(),
    }
  }
}

struct EngineStats {
  widget_count:     usize,
  mounted_count:    usize,
  registered_types: usize,
  avg_fps:          f64,
  frame_count:      u64,
  uptime_ms:        f64,
  current_theme:    String,
}

impl EngineStats {
  fn report(&self) {
    log(format!(
      "[WidgetEngine::Stats] widgets:{} mounted:{} types:{} fps:{:.1} frames:{} uptime:{:.0}ms theme:{}",
      self.widget_count, self.mounted_count, self.registered_types,
      self.avg_fps, self.frame_count, self.uptime_ms, self.current_theme
    ))
  }
}

// ── Global Engine Singleton ───────────────────────────────────────────────────

static mut ENGINE: Option<WidgetEngine> = None

fn engine_init() {
  unsafe {
    if ENGINE.is_none() {
      ENGINE = Some(WidgetEngine::new())
    }
  }
}

fn engine_get() -> &'static mut WidgetEngine {
  unsafe {
    ENGINE.as_mut().expect("Widget engine not initialized — call engine_init() first")
  }
}

// ── Public API ────────────────────────────────────────────────────────────────

pub fn init()                     { engine_init() }
pub fn apply_theme(id: &str)      { engine_get().apply_theme(id) }
pub fn create_widget(k: &str) -> WidgetId { engine_get().create_widget(k) }
pub fn destroy_widget(id: WidgetId)       { engine_get().destroy_widget(id) }
pub fn tick()                     { engine_get().tick() }
pub fn stats() -> EngineStats     { engine_get().stats() }
pub fn registry() -> &'static WidgetRegistry { &engine_get().registry }
pub fn emit(evt: WidgetEvent)     { engine_get().events.emit(evt) }
pub fn on(kind: String, h: impl Fn(&WidgetEvent) + 'static) { engine_get().events.on(kind, h) }

pub mod titan_widget_engine {
  pub use super::{
    WidgetEngine, WidgetManager, WidgetInstance, WidgetDescriptor, WidgetRegistry,
    WidgetCategory, WidgetEvent, EventBus, ReactiveState, StateValue,
    ThemeEngine, ThemeId, RenderPipeline, RenderFrame, EngineStats,
    init, apply_theme, create_widget, destroy_widget, tick, stats, emit, on,
  }
}
