    GlobalUniforms,
    GlowEffect, GlassMorphism, GradientBackground,
    HealthRingShader, ProgressBarShader, SkeletonShimmer,
    ToastEffect, ParticleField, ScanlineOverlay,
    ThemeColorBlend, GaussianBlur,
