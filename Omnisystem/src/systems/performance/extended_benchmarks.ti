    });
    let results = benchmark_add_result(results, r4);

    let r5 = benchmark_measure("bcrypt_hash", 100, pub fn() -> i64 {
        string_length(bcrypt_hash("password"))
    });
    let results = benchmark_add_result(results, r5);

    let r6 = benchmark_measure("aes_encrypt", 1000, pub fn() -> i64 {
        string_length(aes_encrypt("plaintext", "key"))
