// ═══════════════════════════════════════════════════════════════════════════════
// COMPREHENSIVE BENCHMARK RUNNER
// ═══════════════════════════════════════════════════════════════════════════════

pub fn run_all_extended_benchmarks() -> String {
    let master_results = benchmark_create("omnisystem_master_benchmark");

    // TITAN benchmarks
    let r1 = run_benchmark_suite(benchmark_titan_string_comprehensive());
    let mr = benchmark_aggregate_suite(master_results, r1);

    let r2 = run_benchmark_suite(benchmark_titan_json_comprehensive());
    let mr = benchmark_aggregate_suite(mr, r2);

    let r3 = run_benchmark_suite(benchmark_titan_crypto_comprehensive());
    let mr = benchmark_aggregate_suite(mr, r3);

    let r4 = run_benchmark_suite(benchmark_titan_math_comprehensive());
    let mr = benchmark_aggregate_suite(mr, r4);

    let r5 = run_benchmark_suite(benchmark_titan_error_comprehensive());
    let mr = benchmark_aggregate_suite(mr, r5);

    let r6 = run_benchmark_suite(benchmark_titan_io_comprehensive());
    let mr = benchmark_aggregate_suite(mr, r6);

    // SYLVA benchmarks
    let r7 = run_benchmark_suite(benchmark_sylva_dataframe_comprehensive());
    let mr = benchmark_aggregate_suite(mr, r7);

    let r8 = run_benchmark_suite(benchmark_sylva_ml_comprehensive());
    let mr = benchmark_aggregate_suite(mr, r8);

    let r9 = run_benchmark_suite(benchmark_sylva_nlp_comprehensive());
    let mr = benchmark_aggregate_suite(mr, r9);

    // AETHER benchmarks
    let r10 = run_benchmark_suite(benchmark_aether_service_mesh_comprehensive());
    let mr = benchmark_aggregate_suite(mr, r10);

    let r11 = run_benchmark_suite(benchmark_aether_messaging_comprehensive());
    let mr = benchmark_aggregate_suite(mr, r11);

    let r12 = run_benchmark_suite(benchmark_aether_consensus_comprehensive());
    let mr = benchmark_aggregate_suite(mr, r12);

    // AXIOM benchmarks
    let r13 = run_benchmark_suite(benchmark_axiom_proof_comprehensive());
    let mr = benchmark_aggregate_suite(mr, r13);

    // Bridge benchmarks
    let r14 = run_benchmark_suite(benchmark_bridge_operations_comprehensive());
    let mr = benchmark_aggregate_suite(mr, r14);

    benchmark_generate_report(mr)
}

