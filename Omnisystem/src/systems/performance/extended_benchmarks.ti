    let results = benchmark_add_result(results, r6);

    let r7 = benchmark_measure("hmac_sha256", 5000, pub fn() -> i64 {
        string_length(hmac_sha256("message", "key"))
    });
    let results = benchmark_add_result(results, r7);

    benchmark_report(results)
}

