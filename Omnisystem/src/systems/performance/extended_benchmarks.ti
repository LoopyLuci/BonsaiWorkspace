        if circuit_breaker_is_open(breaker) then 1 else 0 end
    });
    let results = benchmark_add_result(results, r4);

    benchmark_report(results)
}

pub fn benchmark_aether_messaging_comprehensive() -> String {
    let results = benchmark_create("aether_messaging_comprehensive");

    let r1 = benchmark_measure("publish_message", 5000, pub fn() -> i64 {
        pub_sub_publish("test_topic", "test message");
        1
    });
    let results = benchmark_add_result(results, r1);

    let r2 = benchmark_measure("subscribe_topic", 1000, pub fn() -> i64 {
        let sub = pub_sub_subscribe("test_topic", pub fn(msg: String) -> String {
            msg
        });
        1
    });
    let results = benchmark_add_result(results, r2);

    let r3 = benchmark_measure("queue_enqueue", 10000, pub fn() -> i64 {
        let queue = queue_create();
        let q2 = queue_enqueue(queue, "item");
        1
    });
    let results = benchmark_add_result(results, r3);

    let r4 = benchmark_measure("queue_dequeue", 10000, pub fn() -> i64 {
        let queue = queue_create();
        let q2 = queue_enqueue(queue, "item");
        let item = queue_dequeue(q2);
        1
    });
    let results = benchmark_add_result(results, r4);

    benchmark_report(results)
}

