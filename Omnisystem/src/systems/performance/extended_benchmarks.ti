pub fn benchmark_sylva_dataframe_comprehensive() -> String {
    let results = benchmark_create("sylva_dataframe_comprehensive");

    let r1 = benchmark_measure("dataframe_create", 10000, pub fn() -> i64 {
        let df = dataframe_create(100, 5);
        1
    });
    let results = benchmark_add_result(results, r1);

    let r2 = benchmark_measure("dataframe_shape", 100000, pub fn() -> i64 {
        let df = dataframe_create(100, 5);
        string_length(dataframe_shape(df))
    });
    let results = benchmark_add_result(results, r2);

    let r3 = benchmark_measure("dataframe_select", 10000, pub fn() -> i64 {
        let df = dataframe_create(100, 5);
        let selected = dataframe_select_columns(df, "col1,col2");
        1
    });
    let results = benchmark_add_result(results, r3);

    let r4 = benchmark_measure("dataframe_filter", 5000, pub fn() -> i64 {
        let df = dataframe_create(100, 5);
        let filtered = dataframe_filter(df, "value > 50");
        1
    });
    let results = benchmark_add_result(results, r4);

    let r5 = benchmark_measure("dataframe_groupby", 1000, pub fn() -> i64 {
        let df = dataframe_create(100, 5);
        let grouped = dataframe_groupby(df, "category");
        1
    });
    let results = benchmark_add_result(results, r5);

    let r6 = benchmark_measure("dataframe_join", 1000, pub fn() -> i64 {
        let df1 = dataframe_create(100, 3);
        let df2 = dataframe_create(100, 3);
        let joined = dataframe_join(df1, df2, "id");
        1
    });
    let results = benchmark_add_result(results, r6);

    benchmark_report(results)
}

pub fn benchmark_sylva_ml_comprehensive() -> String {
    let results = benchmark_create("sylva_ml_comprehensive");

    let r1 = benchmark_measure("random_forest_train", 100, pub fn() -> i64 {
        let features = dataframe_create(100, 5);
        let labels = dataframe_create(100, 1);
        let model = random_forest(features, labels, 10);
        1
    });
    let results = benchmark_add_result(results, r1);

    let r2 = benchmark_measure("neural_net_train", 50, pub fn() -> i64 {
        let features = dataframe_create(100, 5);
        let labels = dataframe_create(100, 1);
        let model = neural_net_create(5, 3, 1);
        let trained = neural_net_train(model, features, labels);
        1
    });
    let results = benchmark_add_result(results, r2);

    let r3 = benchmark_measure("linear_regression", 500, pub fn() -> i64 {
        let features = dataframe_create(100, 5);
        let labels = dataframe_create(100, 1);
        let model = linear_regression(features, labels);
        1
    });
    let results = benchmark_add_result(results, r3);

    let r4 = benchmark_measure("kmeans_clustering", 100, pub fn() -> i64 {
        let features = dataframe_create(100, 5);
        let clusters = kmeans(features, 3);
        1
    });
    let results = benchmark_add_result(results, r4);

    benchmark_report(results)
}

