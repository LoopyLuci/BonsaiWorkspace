        1
    });
    let results = benchmark_add_result(results, r1);

    let r2 = benchmark_measure("type_unwrap", 100000, pub fn() -> i64 {
        let wrapped = omnisystem_type_wrap("value", "type");
        let unwrapped = omnisystem_type_unwrap(wrapped);
        1
    });
    let results = benchmark_add_result(results, r2);

    let r3 = benchmark_measure("error_wrap", 50000, pub fn() -> i64 {
        let err = omnisystem_error_wrap("error msg", "TITAN");
