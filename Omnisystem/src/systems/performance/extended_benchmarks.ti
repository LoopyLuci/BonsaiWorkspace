// ERROR HANDLING (95 functions)
pub fn benchmark_titan_error_comprehensive() -> String {
    let results = benchmark_create("titan_error_comprehensive");

    let r1 = benchmark_measure("result_ok", 100000, pub fn() -> i64 {
        let res = result_ok(42);
        1
    });
    let results = benchmark_add_result(results, r1);

    let r2 = benchmark_measure("result_err", 100000, pub fn() -> i64 {
        let res = result_error("error message");
        1
    });
    let results = benchmark_add_result(results, r2);

    let r3 = benchmark_measure("result_is_ok", 100000, pub fn() -> i64 {
        let res = result_ok(42);
        if result_is_ok(res) then 1 else 0 end
    });
    let results = benchmark_add_result(results, r3);

    let r4 = benchmark_measure("result_unwrap", 100000, pub fn() -> i64 {
        let res = result_ok(42);
        result_unwrap(res)
    });
    let results = benchmark_add_result(results, r4);

    let r5 = benchmark_measure("option_some", 100000, pub fn() -> i64 {
        let opt = option_some(42);
        1
    });
    let results = benchmark_add_result(results, r5);

    let r6 = benchmark_measure("option_is_some", 100000, pub fn() -> i64 {
        let opt = option_some(42);
        if option_is_some(opt) then 1 else 0 end
    });
    let results = benchmark_add_result(results, r6);

    benchmark_report(results)
}

// FILE I/O & COMPRESSION (120 functions)
pub fn benchmark_titan_io_comprehensive() -> String {
    let results = benchmark_create("titan_io_comprehensive");

    let r1 = benchmark_measure("file_read", 100, pub fn() -> i64 {
        let content = file_read_all("test.txt");
        string_length(content)
    });
    let results = benchmark_add_result(results, r1);

    let r2 = benchmark_measure("file_write", 100, pub fn() -> i64 {
        file_write("benchmark_test.txt", "test data");
        1
    });
    let results = benchmark_add_result(results, r2);

    let r3 = benchmark_measure("path_join", 100000, pub fn() -> i64 {
        string_length(path_join("dir", "file.txt"))
    });
    let results = benchmark_add_result(results, r3);

    let r4 = benchmark_measure("gzip_compress", 1000, pub fn() -> i64 {
        string_length(gzip_compress("test data to compress"))
    });
    let results = benchmark_add_result(results, r4);

    let r5 = benchmark_measure("gzip_decompress", 1000, pub fn() -> i64 {
        let compressed = gzip_compress("test data");
        string_length(gzip_decompress(compressed))
    });
    let results = benchmark_add_result(results, r5);

    benchmark_report(results)
}

