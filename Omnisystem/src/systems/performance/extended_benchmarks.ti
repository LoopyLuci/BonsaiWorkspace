        let registered = service_register(registry, "api_service", "localhost", 8080);
        1
    });
    let results = benchmark_add_result(results, r1);

    let r2 = benchmark_measure("service_discover", 10000, pub fn() -> i64 {
        let registry = service_registry_create();
        let discovered = service_discover(registry, "api_service");
        1
    });
    let results = benchmark_add_result(results, r2);

    let r3 = benchmark_measure("load_balance", 10000, pub fn() -> i64 {
        let lb = load_balancer_create("round_robin");
        let server = load_balancer_select_server(lb);
        1
    });
    let results = benchmark_add_result(results, r3);

    let r4 = benchmark_measure("circuit_breaker_check", 100000, pub fn() -> i64 {
