{
  "name": "omnisystem-workspace-runner",
  "displayName": "Omnisystem Workspace Runner",
  "description": "Streams VSCode state to Omnisystem Workspace for semantic display and bidirectional control",
  "version": "0.1.0",
  "publisher": "omnisystem",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "omnisystem.connect",
        "title": "Omnisystem: Connect to Desktop"
      },
      {
        "command": "omnisystem.disconnect",
        "title": "Omnisystem: Disconnect"
      },
      {
        "command": "omnisystem.showStatus",
        "title": "Omnisystem: Show Connection Status"
      }
    ],
    "configuration": {
      "title": "Omnisystem Workspace Runner",
      "properties": {
        "omnisystem.wsUrl": {
          "type": "string",
          "default": "ws://127.0.0.1:11369/ws",
          "description": "WebSocket URL of the Omnisystem desktop app"
        },
        "omnisystem.pairToken": {
          "type": "string",
          "default": "",
          "description": "Pairing token shown in Omnisystem Settings (scan QR or copy token)"
        },
        "omnisystem.autoConnect": {
          "type": "boolean",
          "default": true,
          "description": "Automatically connect to Omnisystem on VSCode startup"
        },
        "omnisystem.streamDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Stream errors and warnings to Omnisystem"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test:typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {}
}
