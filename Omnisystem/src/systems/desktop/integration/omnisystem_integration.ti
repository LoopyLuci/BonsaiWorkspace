fn register_control_panel_app() -> String {
    // Registers Control Panel
    println("  → Registering Control Panel...");

    let app = json_create_object();
    let a1 = json_object_set(app, "id", "bonsai-control-panel");
    let a2 = json_object_set(a1, "name", "Control Panel");
    let a3 = json_object_set(a2, "description", "System monitoring and management dashboard");
    let a4 = json_object_set(a3, "type", "application");
    let a5 = json_object_set(a4, "category", "system");
