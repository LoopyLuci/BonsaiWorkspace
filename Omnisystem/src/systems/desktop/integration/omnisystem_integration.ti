    let a2 = json_object_set(a1, "name", "App Launcher");
    let a3 = json_object_set(a2, "description", "Application discovery and launch service");
    let a4 = json_object_set(a3, "type", "service");
    let a5 = json_object_set(a4, "category", "system");

    app
}

fn register_browser_extension_app() -> String {
    // Registers Browser Extension
    println("  → Registering Browser Extension...");

    let app = json_create_object();
    let a1 = json_object_set(app, "id", "bonsai-browser-extension");
    let a2 = json_object_set(a1, "name", "Browser Extension");
    let a3 = json_object_set(a2, "description", "Cross-browser extension for web integration");
    let a4 = json_object_set(a3, "type", "extension");
    let a5 = json_object_set(a4, "browsers", "chrome,firefox,edge,safari");

