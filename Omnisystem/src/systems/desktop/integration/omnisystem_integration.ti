// BONSAI ECOSYSTEM - OMNISYSTEM INTEGRATION
// Registers BonsaiEcosystem with Omnisystem core
// Handles service registration, capability exposure, lifecycle management

// ═══════════════════════════════════════════════════════════════════════════════
// SERVICE REGISTRATION
// ═══════════════════════════════════════════════════════════════════════════════

pub fn bonsai_ecosystem_register() -> String {
    // Registers BonsaiEcosystem with Omnisystem service registry
    // Must be called during system initialization

    println("╔════════════════════════════════════════════════════════════════╗");
    println("║ Registering BonsaiEcosystem with Omnisystem                   ║");
    println("╚════════════════════════════════════════════════════════════════╝");

    let registration = json_create_object();

    // Service metadata
    let r1 = json_object_set(registration, "name", "bonsai-ecosystem");
    let r2 = json_object_set(r1, "version", "28.0.0");
    let r3 = json_object_set(r2, "status", "initializing");
    let r4 = json_object_set(r3, "layer", "3");

    // Register with service registry
    println("✓ Registering with service registry...");
    register_with_service_registry(registration);

    // Register all sub-applications
    println("✓ Registering sub-applications...");
    register_workspace_app();
    register_buddy_app();
    register_launcher_app();
    register_browser_extension_app();
    register_control_panel_app();

    // Register all capabilities
    println("✓ Registering capabilities...");
    register_capabilities();

    // Start health check
    println("✓ Starting health check...");
    start_health_check_daemon();

    let r5 = json_object_set(r4, "status", "registered");
    let r6 = json_object_set(r5, "timestamp", get_current_timestamp());

    println("\n✅ BonsaiEcosystem successfully registered");
    omnisystem_type_wrap(r6, "bonsai/registration_result")
}

pub fn bonsai_ecosystem_unregister() -> String {
    // Unregisters BonsaiEcosystem from Omnisystem
    // Called during shutdown

    println("Unregistering BonsaiEcosystem...");

    let unregistration = json_create_object();
    let u1 = json_object_set(unregistration, "name", "bonsai-ecosystem");
    let u2 = json_object_set(u1, "timestamp", get_current_timestamp());
    let u3 = json_object_set(u2, "success", "true");

    omnisystem_type_wrap(u3, "bonsai/unregistration_result")
}

// ═══════════════════════════════════════════════════════════════════════════════
// SUB-APPLICATION REGISTRATION
// ═══════════════════════════════════════════════════════════════════════════════

fn register_workspace_app() -> String {
    // Registers Bonsai Workspace IDE
    println("  → Registering Workspace IDE...");

    let app = json_create_object();
    let a1 = json_object_set(app, "id", "bonsai-workspace");
    let a2 = json_object_set(a1, "name", "Bonsai Workspace");
    let a3 = json_object_set(a2, "description", "Integrated IDE for all 7 Omnisystem languages");
    let a4 = json_object_set(a3, "type", "application");
    let a5 = json_object_set(a4, "category", "development");
    let a6 = json_object_set(a5, "launchable", "true");
    let a7 = json_object_set(a6, "entry_point", "workspace/main.rs");

    app
}

fn register_buddy_app() -> String {
    // Registers Bonsai Buddy AI Assistant
    println("  → Registering Buddy AI Assistant...");

    let app = json_create_object();
    let a1 = json_object_set(app, "id", "bonsai-buddy");
    let a2 = json_object_set(a1, "name", "Bonsai Buddy");
    let a3 = json_object_set(a2, "description", "Universal AI assistant with multi-provider support");
    let a4 = json_object_set(a3, "type", "service");
    let a5 = json_object_set(a4, "category", "ai");
    let a6 = json_object_set(a5, "platforms", "android,web,desktop");

    app
}

fn register_launcher_app() -> String {
    // Registers Application Launcher
