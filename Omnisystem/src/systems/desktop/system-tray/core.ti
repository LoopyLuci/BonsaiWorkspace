// ═══════════════════════════════════════════════════════════════════════════════
// TRAY EVENTS & CALLBACKS
// ═══════════════════════════════════════════════════════════════════════════════

pub fn tray_on_left_click() -> String {
    // Left-click on tray icon
    show_main_window();
    omnisystem_type_wrap(json_create_object(), "system_tray/left_click")
}

pub fn tray_on_right_click() -> String {
    // Right-click on tray icon
    tray_menu_create();
    omnisystem_type_wrap(json_create_object(), "system_tray/right_click")
}

pub fn tray_on_double_click() -> String {
    // Double-click on tray icon
    launch_application("omnisystem-workspace");
    omnisystem_type_wrap(json_create_object(), "system_tray/double_click")
}

pub fn tray_on_mouse_hover() -> String {
    // Mouse hover over tray icon
    // Show tooltip with system status
    let tooltip = "Omnisystem • Healthy • 3 services running";
    tray_tooltip_set(tooltip);
    omnisystem_type_wrap(json_create_object(), "system_tray/mouse_hover")
}

