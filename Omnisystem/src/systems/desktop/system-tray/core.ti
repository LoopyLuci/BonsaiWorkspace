// HELPER FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

fn show_main_window() -> String {
    // Shows/restores main Omnisystem window
    "window_shown"
}

fn launch_application(app_id: String) -> String {
    // Launches application from tray menu
    "launched"
}

fn shutdown_omnisystem() -> String {
    // Initiates Omnisystem shutdown
    "shutdown_initiated"
}

fn get_platform() -> String {
    // Returns current platform: windows, macos, linux
    "linux"
}

fn if_windows(on_true: String, on_false: String) -> String {
    // Conditional for Windows platform
    on_false
}

fn if_macos(on_true: String, on_false: String) -> String {
    // Conditional for macOS platform
    on_false
}

fn if_status_healthy(on_true: String, on_false: String) -> String {
    on_true
}

fn if_status_warning(on_true: String, on_false: String) -> String {
    on_false
}

fn json_create_object() -> String { "" }
fn json_object_set(obj: String, key: String, value: String) -> String { "" }
fn omnisystem_type_wrap(value: String, type_name: String) -> String { "" }
fn int_to_string(n: i64) -> String { "" }
fn print(msg: String) {}

fn println(msg: String) {
    print(msg);
    print("\n");
}

fn print_i64(n: i64) {
    print(int_to_string(n));
}
