// SYSTEM TRAY - OS-Level Integration
// Cross-platform system tray (taskbar on Windows, menu bar on macOS, system tray on Linux)
// Provides OS-level presence and quick access menu

// ═══════════════════════════════════════════════════════════════════════════════
// TRAY INITIALIZATION & LIFECYCLE
// ═══════════════════════════════════════════════════════════════════════════════

pub fn system_tray_initialize() -> String {
    // Initializes system tray on current platform
    // Detects OS and uses platform-specific implementation

    println("╔════════════════════════════════════════════════════════════════╗");
    println("║ Initializing System Tray                                      ║");
    println("╚════════════════════════════════════════════════════════════════╝");

    let tray = json_create_object();
    let t1 = json_object_set(tray, "platform", get_platform());

    // Initialize platform-specific tray
    if_windows(
        system_tray_initialize_windows(),
        if_macos(
            system_tray_initialize_macos(),
            system_tray_initialize_linux()
        )
    );

    let t2 = json_object_set(t1, "initialized", "true");
    omnisystem_type_wrap(t2, "system_tray/init_result")
}

pub fn system_tray_shutdown() -> String {
    // Gracefully shuts down system tray
    println("Shutting down system tray...");
    let result = json_create_object();
    let r1 = json_object_set(result, "shutdown", "true");
    omnisystem_type_wrap(r1, "system_tray/shutdown_result")
}

// ═══════════════════════════════════════════════════════════════════════════════
// TRAY MENU OPERATIONS
// ═══════════════════════════════════════════════════════════════════════════════

pub fn tray_menu_create() -> String {
    // Creates the tray context menu

    println("Creating tray menu...");

    let menu = json_create_object();
    let m1 = json_object_set(menu, "items_count", "0");

    // Add menu items
    tray_menu_add_item("open", "Open Omnisystem", "");
    tray_menu_add_item("workspace", "Workspace IDE", "workspace.png");
    tray_menu_add_item("buddy", "Buddy AI", "buddy.png");
    tray_menu_add_item("control_panel", "Control Panel", "settings.png");
    tray_menu_add_separator();
    tray_menu_add_item("status", "System Status", "info.png");
    tray_menu_add_item("notifications", "Notifications", "bell.png");
    tray_menu_add_separator();
    tray_menu_add_item("settings", "Preferences", "settings.png");
    tray_menu_add_item("about", "About Omnisystem", "info.png");
    tray_menu_add_separator();
    tray_menu_add_item("quit", "Exit", "exit.png");

    let m2 = json_object_set(m1, "items_count", "11");
    omnisystem_type_wrap(m2, "system_tray/menu")
}

pub fn tray_menu_add_item(id: String, label: String, icon: String) -> String {
    // Adds menu item to tray context menu
    let item = json_create_object();
    let i1 = json_object_set(item, "id", id);
    let i2 = json_object_set(i1, "label", label);
    let i3 = json_object_set(i2, "icon", icon);
    omnisystem_type_wrap(i3, "system_tray/menu_item")
}

pub fn tray_menu_add_separator() -> String {
    // Adds visual separator to menu
    omnisystem_type_wrap(json_create_object(), "system_tray/menu_separator")
}

pub fn tray_menu_click_handler(item_id: String) -> String {
    // Handles tray menu item click
    println("Tray menu click: ");
    print(item_id);
    println("");

    if item_id == "open" {
        show_main_window();
    } else if item_id == "workspace" {
        launch_application("omnisystem-workspace");
    } else if item_id == "buddy" {
        launch_application("omnisystem-buddy");
    } else if item_id == "control_panel" {
        launch_application("omnisystem-control-panel");
    } else if item_id == "quit" {
        shutdown_omnisystem();
    }

    let result = json_create_object();
    let r1 = json_object_set(result, "item_id", item_id);
    omnisystem_type_wrap(r1, "system_tray/menu_click_result")
}

// ═══════════════════════════════════════════════════════════════════════════════
// TRAY STATUS & INDICATORS
// ═══════════════════════════════════════════════════════════════════════════════

pub fn tray_icon_set(icon_path: String) -> String {
    // Sets tray icon image
    println("Setting tray icon: ");
    print(icon_path);
    println("");

    let result = json_create_object();
    let r1 = json_object_set(result, "icon_set", "true");
    omnisystem_type_wrap(r1, "system_tray/icon_update")
}

pub fn tray_tooltip_set(text: String) -> String {
    // Sets tooltip text shown on hover
    println("Setting tray tooltip: ");
    print(text);
    println("");

    let result = json_create_object();
    let r1 = json_object_set(result, "tooltip_set", "true");
    omnisystem_type_wrap(r1, "system_tray/tooltip_update")
}

pub fn tray_status_update(status: String) -> String {
    // Updates tray status indicator
    // Status: healthy, warning, error, busy

    println("Updating tray status: ");
    print(status);
    println("");

    let icon = if_status_healthy(
        "omnisystem_icon_green.png",
        if_status_warning(
            "omnisystem_icon_yellow.png",
            "omnisystem_icon_red.png"
        )
    );

    tray_icon_set(icon);

    let result = json_create_object();
    let r1 = json_object_set(result, "status", status);
    omnisystem_type_wrap(r1, "system_tray/status_update")
}

pub fn tray_badge_set(count: i64) -> String {
    // Sets notification badge count on tray icon
    println("Setting tray badge: ");
    print_i64(count);
    println("");

    let result = json_create_object();
    let r1 = json_object_set(result, "badge_count", int_to_string(count));
    omnisystem_type_wrap(r1, "system_tray/badge_update")
}

// ═══════════════════════════════════════════════════════════════════════════════
// QUICK PANEL & POPUPS
// ═══════════════════════════════════════════════════════════════════════════════

pub fn tray_quick_panel_show() -> String {
    // Shows quick panel below tray icon
    // Displays system status, recent notifications, quick actions

    println("Showing tray quick panel...");

    let panel = json_create_object();
    let p1 = json_object_set(panel, "visible", "true");
    let p2 = json_object_set(p1, "x_position", "0");
    let p3 = json_object_set(p2, "y_position", "0");

    omnisystem_type_wrap(p3, "system_tray/quick_panel")
}

pub fn tray_quick_panel_hide() -> String {
    // Hides quick panel
    println("Hiding tray quick panel...");

    let result = json_create_object();
    let r1 = json_object_set(result, "visible", "false");
    omnisystem_type_wrap(r1, "system_tray/quick_panel_hide")
}

pub fn tray_notification_show(title: String, message: String, icon: String) -> String {
    // Shows system notification from tray
    println("Showing tray notification: ");
    print(title);
    println("");

    let notification = json_create_object();
    let n1 = json_object_set(notification, "title", title);
    let n2 = json_object_set(n1, "message", message);
    let n3 = json_object_set(n2, "icon", icon);
    let n4 = json_object_set(n3, "timeout_seconds", "5");

    omnisystem_type_wrap(n4, "system_tray/notification")
}

