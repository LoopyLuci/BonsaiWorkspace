// OMNI Markdown Converter Module
// Bi-directional conversion between Markdown and OMNI format
// Full support for CommonMark, GitHub Flavored Markdown, and Pandoc extensions

module OmniMarkdownConverter {

  use OmniCoreSerializer::*;

  pub struct MarkdownConverter;

  pub enum MarkdownFlavor {
    CommonMark,
    GitHubFlavored,
    Pandoc,
    Custom(String),
  }

  pub enum MarkdownElement {
    Heading(HeadingElement),
    Paragraph(ParagraphElement),
    CodeBlock(CodeBlockElement),
    List(ListElement),
    Table(TableElement),
    Quote(QuoteElement),
    Link(LinkElement),
    Image(ImageElement),
    HorizontalRule,
    LineBreak,
    InlineCode(String),
    Bold(String),
    Italic(String),
    Strikethrough(String),
  }

  pub struct HeadingElement {
    level: u8,
    text: String,
    id: Option<String>,
  }

  pub struct ParagraphElement {
    text: String,
    inline_elements: Vec<InlineElement>,
  }

  pub enum InlineElement {
    Text(String),
    Code(String),
    Bold(String),
    Italic(String),
    Link(LinkData),
    Image(ImageData),
    Strikethrough(String),
  }

  pub struct LinkData {
    text: String,
    url: String,
    title: Option<String>,
  }

  pub struct ImageData {
    alt_text: String,
    url: String,
    title: Option<String>,
    width: Option<u32>,
    height: Option<u32>,
  }

  pub struct CodeBlockElement {
    language: String,
    content: String,
    line_numbers: bool,
    highlight_lines: Vec<(u32, u32)>,
  }

  pub struct ListElement {
    ordered: bool,
    start_number: Option<u32>,
    items: Vec<ListItem>,
    tight: bool,
  }

  pub struct ListItem {
    content: String,
    children: Vec<ListElement>,
    checkbox: Option<CheckboxState>,
  }

  pub enum CheckboxState {
    Unchecked,
    Checked,
  }

  pub struct TableElement {
    headers: Vec<String>,
    rows: Vec<TableRow>,
    alignments: Vec<Alignment>,
  }

  pub struct TableRow {
    cells: Vec<String>,
  }

  pub enum Alignment {
    Left,
    Center,
    Right,
  }

  pub struct QuoteElement {
    lines: Vec<String>,
    nested_quotes: Vec<QuoteElement>,
  }

  pub struct LinkElement {
    text: String,
    url: String,
    title: Option<String>,
  }

  pub struct ImageElement {
    alt_text: String,
    src: String,
    title: Option<String>,
  }

  pub struct MarkdownDocument {
    elements: Vec<MarkdownElement>,
    metadata: DocumentMetadata,
    frontmatter: Option<FrontmatterData>,
  }

  pub struct DocumentMetadata {
    title: Option<String>,
    author: Option<String>,
    date: Option<String>,
    keywords: Vec<String>,
  }

  pub struct FrontmatterData {
    format: FrontmatterFormat,
    data: Map<String, String>,
  }

  pub enum FrontmatterFormat {
    YAML,
    TOML,
    JSON,
  }

  // ===================================================================
  // Markdown → OMNI Conversion
  // ===================================================================

  impl MarkdownConverter {
    pub fn from_markdown(
      markdown: &str,
      flavor: MarkdownFlavor,
    ) -> Result<OmniFile> {
      let doc = Self::parse_markdown(markdown, flavor)?;
      Self::convert_to_omni(&doc)
    }

    pub fn from_markdown_file(path: &str, flavor: MarkdownFlavor) -> Result<OmniFile> {
      let markdown = std::fs::read_to_string(path)?;
      Self::from_markdown(&markdown, flavor)
    }

    fn parse_markdown(markdown: &str, flavor: MarkdownFlavor) -> Result<MarkdownDocument> {
      let mut elements = Vec::new();
      let mut current_pos = 0;

      while current_pos < markdown.len() {
        if let Some((element, new_pos)) = Self::parse_element(&markdown[current_pos..], flavor.clone()) {
          elements.push(element);
          current_pos += new_pos;
        } else {
          current_pos += 1;
        }
      }

      Ok(MarkdownDocument {
        elements,
        metadata: DocumentMetadata {
          title: None,
          author: None,
          date: None,
          keywords: vec![],
        },
        frontmatter: None,
      })
    }

    fn parse_element(content: &str, flavor: MarkdownFlavor) -> Option<(MarkdownElement, usize)> {
      // Parse heading
      if content.starts_with('#') {
        return Self::parse_heading(content);
      }

      // Parse code block
      if content.starts_with("```") || content.starts_with("~~~") {
        return Self::parse_code_block(content);
      }

      // Parse list
      if content.starts_with('-') || content.starts_with('*') || content.starts_with('+') {
        return Self::parse_list(content);
      }

      // Parse table
      if content.contains('|') {
        return Self::parse_table(content);
      }

      // Parse quote
      if content.starts_with('>') {
        return Self::parse_quote(content);
      }

      // Parse horizontal rule
      if content.starts_with("---") || content.starts_with("***") || content.starts_with("___") {
        return Some((MarkdownElement::HorizontalRule, 3));
      }

      // Parse paragraph
      if !content.is_empty() {
        return Self::parse_paragraph(content);
      }

      None
    }

    fn parse_heading(content: &str) -> Option<(MarkdownElement, usize)> {
      let level = content.chars().take_while(|&c| c == '#').count() as u8;
      if level > 6 {
        return None;
      }

      let rest = &content[level as usize..].trim_start();
      if let Some(newline_pos) = rest.find('\n') {
        let text = rest[..newline_pos].to_string();
        Some((
          MarkdownElement::Heading(HeadingElement {
            level,
            text,
            id: None,
          }),
          level as usize + rest.len() - rest.trim_start().len() + newline_pos + 1,
        ))
      } else {
        Some((
          MarkdownElement::Heading(HeadingElement {
            level,
            text: rest.to_string(),
            id: None,
          }),
          content.len(),
        ))
      }
    }

    fn parse_code_block(content: &str) -> Option<(MarkdownElement, usize)> {
      let fence = if content.starts_with("```") { "```" } else { "~~~" };
      let fence_len = 3;

      let rest = &content[fence_len..];
      let lang_end = rest.find('\n').unwrap_or(rest.len());
      let language = rest[..lang_end].trim().to_string();

      let code_start = lang_end + 1;
      let code_part = &rest[code_start..];

      if let Some(end_pos) = code_part.find(fence) {
        let code = code_part[..end_pos].to_string();
        Some((
          MarkdownElement::CodeBlock(CodeBlockElement {
            language,
            content: code,
            line_numbers: false,
            highlight_lines: vec![],
          }),
          fence_len + lang_end + 1 + end_pos + fence_len,
        ))
      } else {
        None
      }
    }

    fn parse_list(content: &str) -> Option<(MarkdownElement, usize)> {
      // Detect unordered (- / * / +) or ordered (1.) list items
      let line_end = content.find('\n').unwrap_or(content.len())
      let first = &content[..line_end]
      let is_unordered = first.starts_with("- ") || first.starts_with("* ") || first.starts_with("+ ")
      let is_ordered = first.len() >= 3 && first.as_bytes()[0].is_ascii_digit() && first.as_bytes()[1] == b'.' && first.as_bytes()[2] == b' '
      if !is_unordered && !is_ordered { return None }
      let mut items: Vec<ListItem> = Vec::new()
      let mut consumed = 0usize
      let mut rest = content
      loop {
        let le = rest.find('\n').unwrap_or(rest.len())
        let line = &rest[..le]
        let is_ul = line.starts_with("- ") || line.starts_with("* ") || line.starts_with("+ ")
        let is_ol = line.len() >= 3 && line.as_bytes()[0].is_ascii_digit() && line.as_bytes()[1] == b'.' && line.as_bytes()[2] == b' '
        if !is_ul && !is_ol { break }
        let text = if is_ul { line[2..].to_string() } else { line[3..].to_string() }
        items.push(ListItem { text, checked: None, sub_items: vec![] })
        consumed += le + if rest.len() > le { 1 } else { 0 }
        if rest.len() <= le { break }
        rest = &rest[le + 1..]
      }
      if items.is_empty() { return None }
      Some((MarkdownElement::List(ListElement { items, ordered: is_ordered }), consumed))
    }

    fn parse_table(content: &str) -> Option<(MarkdownElement, usize)> {
      // Tables start with a | column | row | line followed by a |---|---| separator
      let first_nl = content.find('\n')?
      let first_line = &content[..first_nl]
      if !first_line.starts_with('|') { return None }
      let rest_after_first = &content[first_nl + 1..]
      let second_nl = rest_after_first.find('\n').unwrap_or(rest_after_first.len())
      let sep_line = &rest_after_first[..second_nl]
      let is_sep = sep_line.contains("---") || sep_line.contains(":--") || sep_line.contains("--:")
      if !is_sep { return None }
      let headers: Vec<String> = first_line.split('|').filter(|s| !s.trim().is_empty()).map(|s| s.trim().to_string()).collect()
      let alignments: Vec<Alignment> = sep_line.split('|').filter(|s| !s.trim().is_empty()).map(|s| {
        let t = s.trim()
        if t.starts_with(':') && t.ends_with(':') { Alignment::Center }
        else if t.ends_with(':') { Alignment::Right }
        else { Alignment::Left }
      }).collect()
      let mut rows: Vec<TableRow> = Vec::new()
      let mut consumed = first_nl + 1 + second_nl + if rest_after_first.len() > second_nl { 1 } else { 0 }
      let mut rest = if rest_after_first.len() > second_nl { &rest_after_first[second_nl + 1..] } else { "" }
      loop {
        if rest.is_empty() || !rest.starts_with('|') { break }
        let le = rest.find('\n').unwrap_or(rest.len())
        let row_line = &rest[..le]
        let cells: Vec<String> = row_line.split('|').filter(|s| !s.trim().is_empty()).map(|s| s.trim().to_string()).collect()
        rows.push(TableRow { cells })
        consumed += le + if rest.len() > le { 1 } else { 0 }
        if rest.len() <= le { break }
        rest = &rest[le + 1..]
      }
      Some((MarkdownElement::Table(TableElement { headers, alignments, rows }), consumed))
    }

    fn parse_quote(content: &str) -> Option<(MarkdownElement, usize)> {
      if !content.starts_with("> ") && !content.starts_with(">") { return None }
      let mut lines: Vec<String> = Vec::new()
      let mut consumed = 0usize
      let mut rest = content
      loop {
        let le = rest.find('\n').unwrap_or(rest.len())
        let line = &rest[..le]
        if !line.starts_with('>') { break }
        let text = if line.starts_with("> ") { line[2..].to_string() } else { line[1..].to_string() }
        lines.push(text)
        consumed += le + if rest.len() > le { 1 } else { 0 }
        if rest.len() <= le { break }
        rest = &rest[le + 1..]
      }
      if lines.is_empty() { return None }
      Some((MarkdownElement::Quote(QuoteElement { lines, citation: None }), consumed))
    }

    fn parse_paragraph(content: &str) -> Option<(MarkdownElement, usize)> {
      if let Some(newline_pos) = content.find('\n') {
        let text = content[..newline_pos].to_string();
        Some((
          MarkdownElement::Paragraph(ParagraphElement {
            text,
            inline_elements: vec![],
          }),
          newline_pos + 1,
        ))
      } else {
        Some((
          MarkdownElement::Paragraph(ParagraphElement {
            text: content.to_string(),
            inline_elements: vec![],
          }),
          content.len(),
        ))
      }
    }

    fn convert_to_omni(doc: &MarkdownDocument) -> Result<OmniFile> {
      let mut sections = Vec::new();

      for element in &doc.elements {
        match element {
          MarkdownElement::Heading(h) => {
            sections.push(create_heading_section(h));
          }
          MarkdownElement::Paragraph(p) => {
            sections.push(create_paragraph_section(p));
          }
          MarkdownElement::CodeBlock(c) => {
            sections.push(create_code_section(c));
          }
          MarkdownElement::Table(t) => {
            sections.push(create_table_section(t));
          }
          _ => {}
        }
      }

      // Serialize all sections as a single Markdown content string
      let mut md_content = String::new()
      for s in &sections { md_content.push_str(s); md_content.push_str("\n\n") }
      let now = md_now_ns()
      Ok(OmniFile {
        header: OmniHeader {
          magic: 0x4F4D4E49, version: 0x0100, revision: 0, endianness: 1,
          compression_type: CompressionType::None, encryption_type: EncryptionType::None,
          checksum_algo: ChecksumAlgorithm::Crc32,
          total_file_size: 0, content_payload_size: md_content.len() as u32,
          metadata_offset: 0, schema_offset: 0, content_offset: 0,
          attachments_offset: 0, history_offset: 0, compatibility_offset: 0, footer_offset: 0,
          created_at: now, modified_at: now,
          master_checksum: [0u8;32], file_id: [0u8;16], author_signature: [0u8;32],
          reserved: [0u8;32], custom_header: [0u8;80],
        },
        metadata: OmniMetadata {
          version: "1.0".to_string(), created_at: now, modified_at: now,
          author: "OmniMarkdownConverter".to_string(),
          title: doc.title.clone().unwrap_or_default(),
          description: "Converted from Markdown".to_string(),
          keywords: vec![], language: "en".to_string(), encoding: "UTF-8".to_string(),
          source_format: SourceFormatInfo { original_format: "text/markdown".to_string(), original_version: "1.0".to_string(), original_app: "Markdown Parser".to_string(), conversion_date: now, conversion_tool: "OmniMarkdownConverter v1.0".to_string() },
          compression_info: CompressionInfo { algorithm: "none".to_string(), level: 0, original_size: 0, compressed_size: 0 },
          encryption_info: EncryptionInfo { algorithm: "none".to_string(), key_derivation: "".to_string(), salt: vec![], iv: vec![], tag: vec![] },
          validation_info: ValidationInfo { checksum_algorithm: "crc32".to_string(), master_checksum: "".to_string(), section_checksums: Map::new() },
          digital_signature: DigitalSignatureInfo { algorithm: "".to_string(), signer: "".to_string(), timestamp: 0, signature: "".to_string() },
          compatibility_info: CompatibilityInfo { min_reader_version: "1.0".to_string(), backward_compatible: true, forward_compatible: false, can_convert_to: vec!["markdown".to_string()] },
        },
        schema: OmniSchema { types: Map::new(), validations: vec![], format_mappings: Map::new() },
        content: Value::String(md_content),
        attachments: OmniAttachments { files: vec![], embedded_data: vec![] },
        history: OmniHistory { versions: vec![], change_log: vec![] },
        compatibility: CompatibilityInfo { min_reader_version: "1.0".to_string(), backward_compatible: true, forward_compatible: false, can_convert_to: vec!["markdown".to_string()] },
        footer: OmniFooter {
          content_integrity: 0, section_hash_tree: [0u8;32], master_signature: [0u8;32],
          timestamp: (now / 1_000_000_000) as u32, sequence_number: 1, public_key: [0u8;32],
          reserved_field_1: 0, reserved_field_2: 0, reserved_field_3: 0,
          magic_end: 0x4944454E, footer_version: 1, footer_size: 256,
          checksum_verification: 0, reserved: [0u8;32], file_terminator: 0xFFFFFFFF,
        },
      })
    }
  }

  // ===================================================================
  // OMNI → Markdown Conversion
  // ===================================================================

  impl MarkdownConverter {
    pub fn to_markdown(omni_file: &OmniFile, flavor: MarkdownFlavor) -> Result<String> {
      let mut markdown = String::new();

      // Add title if present
      if let Some(title) = &omni_file.metadata.title {
        markdown.push_str(&format!("# {}\n\n", title));
      }

      // Add description if present
      if let Some(desc) = &omni_file.metadata.description {
        markdown.push_str(&format!("{}\n\n", desc));
      }

      // Convert OMNI content value to Markdown
      match &omni_file.content {
        Value::String(s) => {
          if !s.is_empty() { markdown.push_str(s); markdown.push_str("\n\n") }
        }
        Value::Array(arr) => {
          for item in arr {
            match item {
              Value::String(s) => { markdown.push_str("- "); markdown.push_str(s); markdown.push('\n') }
              _ => {}
            }
          }
          markdown.push('\n')
        }
        Value::Object(obj) => {
          for (k, v) in obj.iter() {
            markdown.push_str("**"); markdown.push_str(k); markdown.push_str("**: ")
            match v {
              Value::String(s) => markdown.push_str(s),
              Value::Number(n) => markdown.push_str(&n.to_string()),
              Value::Boolean(b) => markdown.push_str(if *b { "true" } else { "false" }),
              _ => markdown.push_str("[complex]"),
            }
            markdown.push_str("\n\n")
          }
        }
        _ => {}
      }
      Ok(markdown)
    }

    pub fn to_markdown_file(omni_file: &OmniFile, path: &str, flavor: MarkdownFlavor) -> Result<()> {
      let markdown = Self::to_markdown(omni_file, flavor)?;
      std::fs::write(path, markdown)?;
      Ok(())
    }
  }

  // ===================================================================
  // Helper Functions
  // ===================================================================

  fn create_heading_section(heading: &HeadingElement) -> String {
    format!("{} {}", "#".repeat(heading.level as usize), heading.text)
  }

  fn create_paragraph_section(para: &ParagraphElement) -> String {
    para.text.clone()
  }

  fn create_code_section(code: &CodeBlockElement) -> String {
    format!("```{}\n{}\n```", code.language, code.content)
  }

  fn create_table_section(table: &TableElement) -> String {
    let mut result = String::new();

    // Headers
    result.push_str(&table.headers.join(" | "));
    result.push('\n');

    // Separator
    for alignment in &table.alignments {
      let sep = match alignment {
        Alignment::Left => ":---",
        Alignment::Center => ":---:",
        Alignment::Right => "---:",
      };
      result.push_str(sep);
      result.push_str(" | ");
    }
    result.push('\n');

    // Rows
    for row in &table.rows {
      result.push_str(&row.cells.join(" | "));
      result.push('\n');
    }

    result
  }
}

extern "Win32"  { fn GetSystemTimeAsFileTime_md(out: *mut u64) }
extern "POSIX"  { fn clock_gettime_real_md(sec: *mut i64, nsec: *mut i64) -> i32 }

fn md_now_ns() -> u64 {
    #[cfg(target_os = "windows")]
    unsafe { let mut ft=0u64; GetSystemTimeAsFileTime_md(&mut ft); (ft.saturating_sub(116444736000000000))*100 }
    #[cfg(not(target_os = "windows"))]
    unsafe { let mut s=0i64; let mut n=0i64; clock_gettime_real_md(&mut s,&mut n); s as u64*1_000_000_000+n as u64 }
}

pub use OmniMarkdownConverter::*;
