# BonsaiEcosystem Startup Configuration
# Initialization parameters and feature flags
# Generated: 2026-06-16

[core]
# Enable/disable BonsaiEcosystem initialization
enabled = true
version = 28.0.0
layer = 3

[startup]
# Phase 1: Omnisystem Integration
enable_service_registry = true
enable_module_system = true
enable_messaging_framework = true
enable_security_framework = true
enable_ai_shim = true

# Phase 2: Infrastructure
enable_control_panel = true
control_panel_port = 12345
enable_notifications = true
enable_system_tray = true
enable_file_associations = true
enable_theme_system = true
enable_installer = true

# Phase 3: Application Services
enable_workspace_ide = true
enable_buddy_ai = true
enable_app_launcher = true
app_launcher_port = 11450
enable_browser_extension = true

# Phase 4: OS Integration
enable_protocol_registration = true
enable_desktop_entries = true
enable_system_services = true
enable_env_variables = true

# Phase 5: Health Checks
enable_health_checks = true
enable_performance_monitoring = true

[applications]
# Sub-application registration
workspace_enabled = true
buddy_enabled = true
launcher_enabled = true
browser_extension_enabled = true
control_panel_enabled = true

[services]
# System services
notification_daemon = enabled
system_tray = enabled
control_panel_api = enabled
theme_engine = enabled
file_association_handler = enabled

[ai_providers]
# AI model providers
openai_enabled = true
anthropic_enabled = true
ollama_enabled = true
lm_studio_enabled = true
deepseek_enabled = true
mistral_enabled = true

[file_types]
# File type associations (7 types)
ti_files = enabled
omnisystem_files = enabled
model_files = enabled
code_snippet_files = enabled
binary_files = enabled
workspace_files = enabled
config_files = enabled

[themes]
# Theme system
dark_theme = enabled
light_theme = enabled
high_contrast_theme = enabled
solarized_dark_theme = enabled
solarized_light_theme = enabled
monokai_theme = enabled
dracula_theme = enabled
nord_theme = enabled
one_dark_theme = enabled
gruvbox_theme = enabled

[platforms]
# Platform-specific initialization
windows = enabled
macos = enabled
linux = enabled

[logging]
# Logging configuration
log_level = info
log_file = Omnisystem/logs/bonsai-startup.log
max_log_size = 10485760
backup_logs = 5

[performance]
# Performance tuning
startup_timeout_ms = 30000
health_check_timeout_ms = 5000
shutdown_timeout_ms = 10000
max_startup_retries = 3

[debug]
# Debug flags
verbose_logging = false
enable_profiling = false
enable_tracing = false
skip_health_checks = false

[features]
# Feature flags
auto_start_on_boot = true
check_updates_on_startup = false
enable_telemetry = false
enable_crash_reporting = false
enable_beta_features = false

[security]
# Security settings
require_authentication = false
enable_capability_checks = true
sandbox_plugins = true
verify_signatures = true

[storage]
# Data storage configuration
config_dir = ~/.config/omnisystem
cache_dir = ~/.cache/omnisystem
log_dir = ~/.local/share/omnisystem/logs
data_dir = ~/.local/share/omnisystem/data
