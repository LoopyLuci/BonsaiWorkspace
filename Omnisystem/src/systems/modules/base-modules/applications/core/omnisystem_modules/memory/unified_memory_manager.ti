# Direct GPU-storage I/O support
type GpuStorageIo = struct {
    gpu_addr: u64,
    storage_offset: u64,
    size: u64,
    is_pinned_memory: bool,
}

impl GpuStorageIo {
    fun new(gpu_addr: u64, offset: u64, size: u64) -> Self {
        GpuStorageIo {
            gpu_addr,
            storage_offset: offset,
            size,
            is_pinned_memory: false,
        }
    }

    fun enable_dma(&mut self) -> Result<(), string> {
        # Enable DMA for direct GPU-storage transfer
        self.is_pinned_memory = true
        Ok(())
    }

    fun transfer_to_storage(&self) -> Result<(), string> {
        # Transfer data from GPU to storage using DMA
        Ok(())
    }

    fun transfer_from_storage(&self) -> Result<(), string> {
        # Transfer data from storage to GPU using DMA
        Ok(())
    }
}

# GPU P2P support for multi-GPU systems
type GpuP2pTransfer = struct {
    src_gpu: u32,
    dst_gpu: u32,
    src_addr: u64,
    dst_addr: u64,
    size: u64,
}

impl GpuP2pTransfer {
    fun new(src_gpu: u32, dst_gpu: u32, size: u64) -> Self {
        GpuP2pTransfer {
            src_gpu,
            dst_gpu,
            src_addr: 0,
            dst_addr: 0,
            size,
        }
    }

    fun execute(&self) -> Result<(), string> {
        # Direct GPU-to-GPU transfer without host involvement
        Ok(())
    }
}
