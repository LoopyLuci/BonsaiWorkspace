// Neural Network Framework - Computation Graph Module (TITAN)
// DAG-based computation graph for neural networks

pub struct Node {
    id: String
    operation: String
    inputs: Array[String]
    outputs: Array[String]
    attributes: Object
}

pub struct ComputationGraph {
    id: String
    nodes: Object  // HashMap-like
    edges: Array[Object]
    input_nodes: Array[String]
    output_nodes: Array[String]
    node_order: Array[String]
}

impl ComputationGraph {
    pub fn new(id: String) -> Self {
        ComputationGraph {
            id: id,
            nodes: {},
            edges: [],
            input_nodes: [],
            output_nodes: [],
            node_order: []
        }
    }

    pub fn add_node(mut self: Self, node: Node) -> Result[Self] {
        self.nodes[node.id] = node
        self.topological_sort()
        Ok(self)
    }

    pub fn add_edge(mut self: Self, from: String, to: String, output_idx: Int, input_idx: Int) -> Result[Self] {
        self.edges.push({
            from_node: from,
            to_node: to,
            output_index: output_idx,
            input_index: input_idx
        })
        Ok(self)
    }

    pub fn mark_input(mut self: Self, node_id: String) -> Self {
        if !self.input_nodes.contains(node_id) {
            self.input_nodes.push(node_id)
        }
        self
    }

    pub fn mark_output(mut self: Self, node_id: String) -> Self {
        if !self.output_nodes.contains(node_id) {
            self.output_nodes.push(node_id)
        }
        self
    }

    pub fn validate(self: &Self) -> Result[()]{
        // Check for cycles
        for node_id in self.nodes.keys() {
            if self.has_cycle_from(node_id) {
                return Err("Cycle detected in computation graph")
            }
        }

        // Check that all inputs exist
        for node in self.nodes.values() {
            for input_id in node.inputs {
                if !self.nodes.contains(input_id) {
                    return Err(format!("Input node {} not found", input_id))
                }
            }
        }

        Ok(())
    }

    fn topological_sort(mut self: Self) {
        let mut sorted = []
        let mut visited = {}

        for node_id in self.nodes.keys() {
            if !visited.contains(node_id) {
                self.dfs(node_id, &mut visited, &mut sorted)
            }
        }

        self.node_order = sorted
    }

    fn dfs(self: &Self, node_id: String, visited: &mut Object, stack: &mut Array[String]) {
        visited[node_id] = true

        if self.nodes.contains(node_id) {
            let node = self.nodes[node_id]
            for input_id in node.inputs {
                if !visited.contains(input_id) {
                    self.dfs(input_id, visited, stack)
                }
            }
        }

        stack.push(node_id)
    }

    fn has_cycle_from(self: &Self, node_id: String) -> Bool {
        let mut visited = {}
        let mut rec_stack = {}
        self.check_cycle_from(node_id, &mut visited, &mut rec_stack)
    }

    fn check_cycle_from(self: &Self, node_id: String, visited: &mut Object, rec_stack: &mut Object) -> Bool {
        visited[node_id] = true
        rec_stack[node_id] = true

        if self.nodes.contains(node_id) {
            let node = self.nodes[node_id]
            for input_id in node.inputs {
                if !visited.contains(input_id) {
                    if self.check_cycle_from(input_id, visited, rec_stack) {
                        return true
                    }
                } else if rec_stack.contains(input_id) {
                    return true
                }
            }
        }

        rec_stack.remove(node_id)
        false
    }

    pub fn node_count(self: &Self) -> Int {
        self.nodes.keys().len()
    }

    pub fn edge_count(self: &Self) -> Int {
        self.edges.len()
    }
}

pub fn create_graph(id: String) -> ComputationGraph {
    ComputationGraph::new(id)
}

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_graph_creation() {
        let graph = ComputationGraph::new("test_graph")
        assert_eq!(graph.id, "test_graph")
        assert_eq!(graph.node_count(), 0)
    }

    #[test]
    fn test_add_node() {
        let mut graph = ComputationGraph::new("test")
        let node = Node {
            id: "input1",
            operation: "input",
            inputs: [],
            outputs: ["add1"],
            attributes: {}
        }
        let result = graph.add_node(node)
        assert!(result.is_ok())
    }

    #[test]
    fn test_graph_validation() {
        let mut graph = ComputationGraph::new("test")
        let node = Node {
            id: "input1",
            operation: "input",
            inputs: [],
            outputs: [],
            attributes: {}
        }
        graph = graph.add_node(node).unwrap()
        assert!(graph.validate().is_ok())
    }
}
