// Visualization Framework - TITAN
// Charts, graphs, data visualization, dashboards

pub struct ChartRenderer {
    chart_type: String  // "line", "bar", "pie", "scatter", "heatmap"
    title: String
    data_points: Array[DataPoint]
    colors: Array[String]
    axes: Axes
}

pub struct DataPoint {
    label: String
    x_value: Float
    y_value: Float
    metadata: Object
}

pub struct Axes {
    x_label: String
    y_label: String
    x_min: Float
    x_max: Float
    y_min: Float
    y_max: Float
}

pub struct Dashboard {
    name: String
    width: Int
    height: Int
    charts: Array[String]
    refresh_interval_ms: Int
}

pub struct Legend {
    entries: Array[LegendEntry]
    position: String  // "top", "bottom", "left", "right"
}

pub struct LegendEntry {
    label: String
    color: String
    symbol: String
}

impl ChartRenderer {
    pub fn new(chart_type: String, title: String) -> Self {
        ChartRenderer {
            chart_type: chart_type,
            title: title,
            data_points: [],
            colors: ["#FF6B6B", "#4ECDC4", "#45B7D1", "#FFA07A", "#98D8C8"],
            axes: Axes {
                x_label: "X",
                y_label: "Y",
                x_min: 0.0,
                x_max: 100.0,
                y_min: 0.0,
                y_max: 100.0
            }
        }
    }

    pub fn add_data_point(mut self: Self, label: String, x: Float, y: Float) -> Self {
        let point = DataPoint {
            label: label,
            x_value: x,
            y_value: y,
            metadata: {}
        }
        self.data_points.push(point)
        self
    }

    pub fn set_axes(mut self: Self, x_label: String, y_label: String, x_min: Float, x_max: Float, y_min: Float, y_max: Float) -> Self {
        self.axes = Axes {
            x_label: x_label,
            y_label: y_label,
            x_min: x_min,
            x_max: x_max,
            y_min: y_min,
            y_max: y_max
        }
        self
    }

    pub fn render(self: Self) -> String {
        format!("{} Chart: {} ({} data points)",
                self.chart_type,
                self.title,
                self.data_points.len())
    }
}

impl Dashboard {
    pub fn new(name: String, width: Int, height: Int) -> Self {
        Dashboard {
            name: name,
            width: width,
            height: height,
            charts: [],
            refresh_interval_ms: 5000
        }
    }

    pub fn add_chart(mut self: Self, chart_id: String) -> Self {
        self.charts.push(chart_id)
        self
    }

    pub fn set_refresh_interval(mut self: Self, interval_ms: Int) -> Self {
        self.refresh_interval_ms = interval_ms
        self
    }

    pub fn render(self: Self) -> String {
        format!("Dashboard '{}' with {} charts ({}x{})",
                self.name,
                self.charts.len(),
                self.width,
                self.height)
    }
}

pub fn create_chart(chart_type: String, title: String) -> ChartRenderer {
    ChartRenderer::new(chart_type, title)
}

pub fn create_dashboard(name: String, width: Int, height: Int) -> Dashboard {
    Dashboard::new(name, width, height)
}
