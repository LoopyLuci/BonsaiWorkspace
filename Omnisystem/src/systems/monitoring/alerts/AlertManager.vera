// Omnisystem Alert Manager - Multi-Channel Alert Distribution
// Email, Slack, SMS, webhooks with escalation policies and routing

use std::collections::HashMap;

pub struct AlertManager {
    id: String,
    version: String,
    theme: Theme,
    asset_manager: AssetManager,

    current_view: AlertView,
    alert_rules: Vec<AlertRule>,
    active_alerts: Vec<Alert>,
    recipients: Vec<Recipient>,
    notification_channels: Vec<NotificationChannel>,
}

impl AlertManager {
    pub fn new(asset_manager: AssetManager) -> Self {
        Self {
            id: "alert-manager".to_string(),
            version: "29.0.0".to_string(),
            theme: asset_manager.get_current_theme(),
            asset_manager: asset_manager.clone(),
            current_view: AlertView::Dashboard,
            alert_rules: Self::load_rules(),
            active_alerts: vec![],
            recipients: Self::load_recipients(),
            notification_channels: Self::load_channels(),
        }
    }

    pub fn render(&self) -> Widget {
        ApplicationWindow {
            id: "alert-manager".to_string(),
            title: "Alert Manager".to_string(),
            width: 1600,
            height: 900,
            children: vec![
                Panel {
                    height: 60.0,
                    padding: 16.0,
                    background_color: self.theme.colors.primary,
                    border_bottom: true,
                    children: vec![
                        Row {
                            spacing: 16.0,
                            vertical_align: "center".to_string(),
                            children: vec![
                                Image { source: self.asset_manager.load_icon("bell", 32), width: 32.0, height: 32.0 },
                                Label { text: "Alert Manager".to_string(), font_size: 18.0, font_weight: 700, color: self.theme.colors.white },
                                Spacer {},
                                Badge { label: format!("{} Active", self.active_alerts.len()), color: self.theme.colors.error },
                            ],
                        },
                    ],
                },
                Row {
                    spacing: 0.0,
                    height: "1fr".to_string(),
                    children: vec![
                        Panel {
                            width: "200px".to_string(),
                            padding: 12.0,
                            background_color: self.theme.colors.surface,
                            border_right: true,
                            children: vec![
                                Column { spacing: 2.0, children: vec![
                                    Button { label: "Dashboard".to_string(), variant: "secondary".to_string(), width: "100%".to_string(), margin_bottom: 4.0, onClick: || {} },
                                    Button { label: "Rules".to_string(), variant: "secondary".to_string(), width: "100%".to_string(), margin_bottom: 4.0, onClick: || {} },
                                    Button { label: "Recipients".to_string(), variant: "secondary".to_string(), width: "100%".to_string(), margin_bottom: 4.0, onClick: || {} },
                                    Button { label: "Channels".to_string(), variant: "secondary".to_string(), width: "100%".to_string(), margin_bottom: 4.0, onClick: || {} },
                                ]},
                            ],
                        },
                        Panel {
                            width: "1fr".to_string(),
                            padding: 20.0,
                            background_color: self.theme.colors.background,
                            children: vec![Label { text: "Alert Dashboard".to_string(), font_size: 16.0, font_weight: 700 }],
                        },
                    ],
                },
            ],
        }
    }

    fn load_rules() -> Vec<AlertRule> {
        vec![
            AlertRule { name: "High CPU".to_string(), condition: "cpu > 80%".to_string(), severity: "warning".to_string() },
            AlertRule { name: "Service Down".to_string(), condition: "uptime < 99%".to_string(), severity: "critical".to_string() },
        ]
    }

    fn load_recipients() -> Vec<Recipient> {
        vec![Recipient { name: "Admin".to_string(), email: "admin@omnisystem.dev".to_string() }]
    }

    fn load_channels() -> Vec<NotificationChannel> {
        vec![
            NotificationChannel { name: "Email".to_string(), enabled: true },
            NotificationChannel { name: "Slack".to_string(), enabled: true },
        ]
    }
}

#[derive(Clone, Copy, Debug)]
pub enum AlertView { Dashboard, Rules, Recipients, Channels }

#[derive(Clone, Debug)]
pub struct AlertRule {
    name: String,
    condition: String,
    severity: String,
}

#[derive(Clone, Debug)]
pub struct Alert {
    id: String,
    rule_id: String,
    message: String,
    severity: String,
}

#[derive(Clone, Debug)]
pub struct Recipient {
    name: String,
    email: String,
}

#[derive(Clone, Debug)]
pub struct NotificationChannel {
    name: String,
    enabled: bool,
}

pub static ALERT_MANAGER_STATE: LazyStatic<Mutex<AlertManager>> =
    LazyStatic::new(|| Mutex::new(AlertManager::new(AssetManager::global())));
