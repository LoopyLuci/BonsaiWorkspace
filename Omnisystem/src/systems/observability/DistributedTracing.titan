// OMNISYSTEM DISTRIBUTED TRACING - OPENTELEMETRY INTEGRATION
// Phase 10: Enterprise Systems | Language: TITAN

use std::collections::HashMap;

#[derive(Clone, Copy, Debug, PartialEq)]
pub enum SpanKind { Internal, Server, Client, Producer, Consumer }

impl SpanKind {
    pub fn name(&self) -> &str {
        match self {
            SpanKind::Internal => "INTERNAL",
            SpanKind::Server => "SERVER",
            SpanKind::Client => "CLIENT",
            SpanKind::Producer => "PRODUCER",
            SpanKind::Consumer => "CONSUMER",
        }
    }
}

pub struct TraceContext {
    pub trace_id: String,
    pub parent_span_id: String,
    pub baggage: HashMap<String, String>,
}

impl TraceContext {
    pub fn new(trace_id: String) -> Self {
        TraceContext {
            trace_id,
            parent_span_id: "0".to_string(),
            baggage: HashMap::new(),
        }
    }
}

pub struct Span {
    pub span_id: String,
    pub trace_id: String,
    pub operation_name: String,
    pub kind: SpanKind,
    pub start_time: u64,
    pub end_time: Option<u64>,
    pub duration_ms: Option<f64>,
    pub tags: HashMap<String, String>,
    pub status: String,
}

impl Span {
    pub fn new(span_id: String, trace_id: String, operation: String) -> Self {
        Span {
            span_id,
            trace_id,
            operation_name: operation,
            kind: SpanKind::Internal,
            start_time: 0,
            end_time: None,
            duration_ms: None,
            tags: HashMap::new(),
            status: "UNSET".to_string(),
        }
    }

    pub fn set_tag(&mut self, key: String, value: String) {
        self.tags.insert(key, value);
    }

    pub fn finish(&mut self) {
        self.end_time = Some(100);
        self.duration_ms = Some(100.0);
    }
}

pub struct Tracer {
    pub service_name: String,
    pub spans: Vec<Span>,
    pub next_span_id: u64,
}

impl Tracer {
    pub fn new(service_name: String) -> Self {
        Tracer { service_name, spans: Vec::new(), next_span_id: 1 }
    }

    pub fn start_span(&mut self, operation: String, kind: SpanKind) -> Span {
        let span_id = format!("{:016x}", self.next_span_id);
        self.next_span_id += 1;
        let trace_id = format!("{:032x}", self.spans.len() as u64 + 1);
        let mut span = Span::new(span_id, trace_id, operation);
        span.kind = kind;
        self.spans.push(span.clone());
        span
    }

    pub fn span_count(&self) -> usize { self.spans.len() }
}

pub struct JaegerExporter { pub endpoint: String }

impl JaegerExporter {
    pub fn new(endpoint: String) -> Self { JaegerExporter { endpoint } }
    pub fn export(&self, spans: &[Span]) -> Result<(), String> { Ok(()) }
}

pub struct DatadogExporter { pub api_key: String }

impl DatadogExporter {
    pub fn new(api_key: String) -> Self { DatadogExporter { api_key } }
    pub fn export(&self, spans: &[Span]) -> Result<(), String> { Ok(()) }
}

pub struct DistributedTracingSystem {
    pub tracers: HashMap<String, Tracer>,
    pub jaeger: Option<JaegerExporter>,
    pub datadog: Option<DatadogExporter>,
}

impl DistributedTracingSystem {
    pub fn new() -> Self {
        DistributedTracingSystem {
            tracers: HashMap::new(),
            jaeger: Some(JaegerExporter::new("http://localhost:6831".to_string())),
            datadog: Some(DatadogExporter::new("api_key".to_string())),
        }
    }

    pub fn get_tracer(&mut self, service: String) -> &mut Tracer {
        self.tracers.entry(service.clone()).or_insert_with(|| Tracer::new(service))
    }

    pub fn export_all(&self) -> Result<(), String> {
        for (_, tracer) in &self.tracers {
            if let Some(ref jaeger) = self.jaeger {
                jaeger.export(&tracer.spans)?;
            }
            if let Some(ref datadog) = self.datadog {
                datadog.export(&tracer.spans)?;
            }
        }
        Ok(())
    }

    pub fn total_spans(&self) -> usize { self.tracers.values().map(|t| t.span_count()).sum() }
}

pub fn main() {
    println!("DISTRIBUTED TRACING SYSTEM v1.0");
    let mut tracing = DistributedTracingSystem::new();
    let api_tracer = tracing.get_tracer("api-service".to_string());
    let mut req_span = api_tracer.start_span("handle_request".to_string(), SpanKind::Server);
    req_span.set_tag("http.method".to_string(), "GET".to_string());
    req_span.finish();
    let _ = tracing.export_all();
    println!("✓ Distributed Tracing operational");
}