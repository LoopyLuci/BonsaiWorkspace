// Omnisystem Package Manager - Application package management
pub struct PackageManager {
    id: String,
    theme: Theme,
    packages: Vec<Package>,
    repositories: Vec<Repository>,
}

impl PackageManager {
    pub fn new(asset_manager: AssetManager) -> Self {
        Self {
            id: "packages".to_string(),
            theme: asset_manager.get_current_theme(),
            packages: vec![],
            repositories: vec![],
        }
    }

    pub fn render(&self) -> Widget {
        ApplicationWindow {
            id: "packages".to_string(),
            title: "Package Manager".to_string(),
            width: 1400,
            height: 800,
            children: vec![
                Panel { height: 60.0, padding: 16.0, background_color: self.theme.colors.primary, border_bottom: true, children: vec![
                    Label { text: "Package Manager".to_string(), font_size: 18.0, font_weight: 700, color: self.theme.colors.white },
                ]},
            ],
        }
    }
}

#[derive(Clone, Debug)]
pub struct Package {
    name: String,
    version: String,
    size_mb: f32,
}

#[derive(Clone, Debug)]
pub struct Repository {
    name: String,
    url: String,
}

pub static PACKAGE_MANAGER_STATE: LazyStatic<Mutex<PackageManager>> =
    LazyStatic::new(|| Mutex::new(PackageManager::new(AssetManager::global())));
