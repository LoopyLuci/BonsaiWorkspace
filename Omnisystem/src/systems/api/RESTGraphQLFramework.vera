use std::collections::HashMap;

// ─────────────────────────────────────────────────────────────────────────────────────────────────────────
// API TYPES
// ─────────────────────────────────────────────────────────────────────────────────────────────────────────

#[derive(Clone, Copy, Debug, PartialEq)]
pub enum HTTPMethod {
    Get,
    Post,
    Put,
    Patch,
    Delete,
    Options,
    Head,
}

impl HTTPMethod {
    pub fn name(&self) -> &str {
        match self {
            HTTPMethod::Get => "GET",
            HTTPMethod::Post => "POST",
            HTTPMethod::Put => "PUT",
            HTTPMethod::Patch => "PATCH",
            HTTPMethod::Delete => "DELETE",
            HTTPMethod::Options => "OPTIONS",
            HTTPMethod::Head => "HEAD",
        }
    }

    pub fn is_idempotent(&self) -> bool {
        match self {
            HTTPMethod::Get | HTTPMethod::Put | HTTPMethod::Delete | HTTPMethod::Options | HTTPMethod::Head => true,
            _ => false,
        }
    }
}

#[derive(Clone, Debug)]
pub struct HTTPResponse {
    pub status_code: u16,
    pub status_message: String,
    pub headers: HashMap<String, String>,
    pub body: String,
    pub content_type: String,
}

impl HTTPResponse {
    pub fn ok(body: String) -> Self {
        let mut headers = HashMap::new();
        headers.insert("Content-Type".to_string(), "application/json".to_string());

        HTTPResponse {
            status_code: 200,
            status_message: "OK".to_string(),
            headers,
            body,
            content_type: "application/json".to_string(),
        }
    }

    pub fn created(body: String) -> Self {
        let mut headers = HashMap::new();
        headers.insert("Content-Type".to_string(), "application/json".to_string());

        HTTPResponse {
            status_code: 201,
            status_message: "Created".to_string(),
            headers,
            body,
            content_type: "application/json".to_string(),
        }
    }

    pub fn bad_request(message: String) -> Self {
        let mut headers = HashMap::new();
        headers.insert("Content-Type".to_string(), "application/json".to_string());

        HTTPResponse {
            status_code: 400,
            status_message: "Bad Request".to_string(),
            headers,
            body: format!(r#"{{"error":"{}"}}"#, message),
            content_type: "application/json".to_string(),
        }
    }

    pub fn not_found() -> Self {
        let mut headers = HashMap::new();
        headers.insert("Content-Type".to_string(), "application/json".to_string());

        HTTPResponse {
            status_code: 404,
            status_message: "Not Found".to_string(),
            headers,
            body: r#"{"error":"Resource not found"}"#.to_string(),
            content_type: "application/json".to_string(),
        }
    }

    pub fn internal_error(message: String) -> Self {
        let mut headers = HashMap::new();
        headers.insert("Content-Type".to_string(), "application/json".to_string());

        HTTPResponse {
            status_code: 500,
            status_message: "Internal Server Error".to_string(),
            headers,
            body: format!(r#"{{"error":"{}"}}"#, message),
            content_type: "application/json".to_string(),
        }
    }
}

#[derive(Clone, Debug)]
pub struct RESTEndpoint {
    pub path: String,
    pub method: HTTPMethod,
    pub description: String,
    pub parameters: Vec<String>,
    pub request_schema: String,
    pub response_schema: String,
    pub examples: Vec<(String, String)>,
}

impl RESTEndpoint {
    pub fn new(path: String, method: HTTPMethod, description: String) -> Self {
        RESTEndpoint {
            path,
            method,
            description,
            parameters: Vec::new(),
            request_schema: String::new(),
            response_schema: String::new(),
            examples: Vec::new(),
        }
    }

    pub fn with_parameter(mut self, param: String) -> Self {
        self.parameters.push(param);
        self
    }

    pub fn with_schemas(mut self, request: String, response: String) -> Self {
        self.request_schema = request;
        self.response_schema = response;
        self
    }

    pub fn add_example(mut self, request: String, response: String) -> Self {
        self.examples.push((request, response));
        self
    }
}

#[derive(Clone, Debug)]
pub struct GraphQLSchema {
    pub name: String,
    pub types: HashMap<String, String>,
    pub queries: Vec<String>,
    pub mutations: Vec<String>,
}

impl GraphQLSchema {
    pub fn new(name: String) -> Self {
        GraphQLSchema {
            name,
            types: HashMap::new(),
            queries: Vec::new(),
            mutations: Vec::new(),
        }
    }

    pub fn add_type(&mut self, type_name: String, definition: String) {
        self.types.insert(type_name, definition);
    }

    pub fn add_query(&mut self, query: String) {
        self.queries.push(query);
    }

    pub fn add_mutation(&mut self, mutation: String) {
        self.mutations.push(mutation);
    }
}

pub struct RESTGraphQLFramework {
    pub endpoints: HashMap<String, RESTEndpoint>,
    pub graphql_schemas: Vec<GraphQLSchema>,
    pub request_count: u32,
    pub error_count: u32,
    pub cache_enabled: bool,
    pub rate_limiting_enabled: bool,
    pub request_log: Vec<(String, u16)>,
}

impl RESTGraphQLFramework {
    pub fn new() -> Self {
        RESTGraphQLFramework {
            endpoints: HashMap::new(),
            graphql_schemas: Vec::new(),
            request_count: 0,
            error_count: 0,
            cache_enabled: true,
            rate_limiting_enabled: true,
            request_log: Vec::new(),
        }
    }

    pub fn register_rest_endpoint(&mut self, endpoint: RESTEndpoint) {
        let key = format!("{} {}", endpoint.method.name(), endpoint.path);
        self.endpoints.insert(key, endpoint);
    }

    pub fn register_graphql_schema(&mut self, schema: GraphQLSchema) {
        self.graphql_schemas.push(schema);
    }

    pub fn handle_rest_request(&mut self, method: HTTPMethod, path: &str, body: Option<String>) -> HTTPResponse {
        let key = format!("{} {}", method.name(), path);

        self.request_count += 1;

        // Route to endpoint
        if let Some(endpoint) = self.endpoints.get(&key) {
            // Validate request
            if let Some(ref req_body) = body {
                if !req_body.is_empty() && endpoint.request_schema.is_empty() {
                    self.error_count += 1;
                    self.request_log.push((key, 400));
                    return HTTPResponse::bad_request("Invalid request body".to_string());
                }
            }

            // Execute endpoint
            let response_body = self.execute_endpoint(endpoint);
            self.request_log.push((key, 200));

            HTTPResponse::ok(response_body)
        } else {
            self.error_count += 1;
            self.request_log.push((key, 404));
            HTTPResponse::not_found()
        }
    }

    fn execute_endpoint(&self, endpoint: &RESTEndpoint) -> String {
        // Simulate endpoint execution
        match endpoint.method {
            HTTPMethod::Get => {
                format!(r#"{{"message":"Retrieved resource from {}","success":true}}"#, endpoint.path)
            },
            HTTPMethod::Post => {
                format!(r#"{{"message":"Created resource at {}","success":true}}"#, endpoint.path)
            },
            HTTPMethod::Put => {
                format!(r#"{{"message":"Updated resource at {}","success":true}}"#, endpoint.path)
            },
            HTTPMethod::Delete => {
                format!(r#"{{"message":"Deleted resource at {}","success":true}}"#, endpoint.path)
            },
            _ => r#"{"success":true}"#.to_string(),
        }
    }

    pub fn handle_graphql_query(&mut self, query: String) -> HTTPResponse {
        self.request_count += 1;

        // Simple GraphQL query validation
        if query.contains("query") || query.contains("mutation") {
            self.request_log.push(("GraphQL".to_string(), 200));
            let response = format!(r#"{{"data":{{"result":"success","query":"{}"}}}}"#, query.chars().take(50).collect::<String>());
            HTTPResponse::ok(response)
        } else {
            self.error_count += 1;
            self.request_log.push(("GraphQL".to_string(), 400));
            HTTPResponse::bad_request("Invalid GraphQL query".to_string())
        }
    }

    pub fn generate_openapi_spec(&self) -> String {
        let mut spec = String::new();

        spec.push_str("openapi: 3.0.0\n");
        spec.push_str("info:\n");
        spec.push_str("  title: Omnisystem API\n");
        spec.push_str("  version: 1.0.0\n");
        spec.push_str("paths:\n");

        for (key, endpoint) in &self.endpoints {
            spec.push_str(&format!("  {}:\n", endpoint.path));
            spec.push_str(&format!("    {}:\n", endpoint.method.name().to_lowercase()));
            spec.push_str(&format!("      description: {}\n", endpoint.description));
            spec.push_str("      responses:\n");
            spec.push_str("        '200':\n");
            spec.push_str("          description: Successful response\n");
        }

        spec
    }

    pub fn print_api_documentation(&self) {
        println!("\n╔════ REST API DOCUMENTATION ════╗");
        println!("║ Registered Endpoints: {}", self.endpoints.len());

        for (key, endpoint) in &self.endpoints {
            println!("║");
            println!("║ {} {}", endpoint.method.name(), endpoint.path);
            println!("║   {}", endpoint.description);

            if !endpoint.parameters.is_empty() {
                println!("║   Parameters:");
                for param in &endpoint.parameters {
                    println!("║     • {}", param);
                }
            }

            if !endpoint.examples.is_empty() {
                println!("║   Example Response:");
                if let Some((_, response)) = endpoint.examples.first() {
                    println!("║     {}", response);
                }
            }
        }

        println!("╚═════════════════════════════════╝\n");
    }

    pub fn print_graphql_documentation(&self) {
        println!("\n╔════ GRAPHQL SCHEMA DOCUMENTATION ════╗");

        for schema in &self.graphql_schemas {
            println!("║ Schema: {}", schema.name);
            println!("║");

            if !schema.queries.is_empty() {
                println!("║ Queries:");
                for query in &schema.queries {
                    println!("║   • {}", query);
                }
            }

            if !schema.mutations.is_empty() {
                println!("║ Mutations:");
                for mutation in &schema.mutations {
                    println!("║   • {}", mutation);
                }
            }

            println!("║");
        }

        println!("╚═════════════════════════════════════╝\n");
    }

    pub fn print_api_metrics(&self) {
        println!("\n╔════ API METRICS ════╗");
        println!("║ Total Requests:     {}", self.request_count);
        println!("║ Errors:             {}", self.error_count);
        println!("║ Success Rate:       {:.1}%",
                 if self.request_count > 0 {
                     ((self.request_count - self.error_count) as f64 / self.request_count as f64) * 100.0
                 } else {
                     0.0
                 });
        println!("║ Cache:              {}", if self.cache_enabled { "✓ Enabled" } else { "✗ Disabled" });
        println!("║ Rate Limiting:      {}", if self.rate_limiting_enabled { "✓ Enabled" } else { "✗ Disabled" });
        println!("╚═════════════════════╝\n");
    }

    pub fn print_openapi_spec(&self) {
        println!("\n╔════ OPENAPI 3.0 SPECIFICATION ════╗");
        println!("{}", self.generate_openapi_spec());
        println!("╚═══════════════════════════════════╝\n");
    }
}

pub fn main() {
    println!("╔════════════════════════════════════════════════════════════════╗");
    println!("║        OMNISYSTEM REST/GRAPHQL FRAMEWORK v1.0                 ║");
    println!("║        Standard APIs | OpenAPI | GraphQL Support             ║");
    println!("╚════════════════════════════════════════════════════════════════╝\n");

    let mut framework = RESTGraphQLFramework::new();

    // Register REST endpoints
    let get_users = RESTEndpoint::new(
        "/api/v1/users".to_string(),
        HTTPMethod::Get,
        "Get all users".to_string(),
    );
    framework.register_rest_endpoint(get_users);

    let create_user = RESTEndpoint::new(
        "/api/v1/users".to_string(),
        HTTPMethod::Post,
        "Create a new user".to_string(),
    ).with_schemas(
        r#"{"name":"string","email":"string"}"#.to_string(),
        r#"{"id":"string","name":"string","email":"string"}"#.to_string(),
    );
    framework.register_rest_endpoint(create_user);

    let update_user = RESTEndpoint::new(
        "/api/v1/users/{id}".to_string(),
        HTTPMethod::Put,
        "Update a user".to_string(),
    ).with_parameter("id: user ID".to_string());
    framework.register_rest_endpoint(update_user);

    let delete_user = RESTEndpoint::new(
        "/api/v1/users/{id}".to_string(),
        HTTPMethod::Delete,
        "Delete a user".to_string(),
    ).with_parameter("id: user ID".to_string());
    framework.register_rest_endpoint(delete_user);

    // Register GraphQL schema
    let mut graphql = GraphQLSchema::new("OmnisystemSchema".to_string());
    graphql.add_query("getUsers: [User!]!".to_string());
    graphql.add_query("getUser(id: ID!): User".to_string());
    graphql.add_mutation("createUser(name: String!, email: String!): User!".to_string());
    graphql.add_mutation("updateUser(id: ID!, name: String): User".to_string());
    framework.register_graphql_schema(graphql);

    // Simulate requests
    println!("Simulating API requests...\n");

    let resp1 = framework.handle_rest_request(HTTPMethod::Get, "/api/v1/users", None);
    println!("GET /api/v1/users → {} {}", resp1.status_code, resp1.status_message);

    let resp2 = framework.handle_rest_request(HTTPMethod::Post, "/api/v1/users", Some(r#"{"name":"Alice","email":"alice@example.com"}"#.to_string()));
    println!("POST /api/v1/users → {} {}", resp2.status_code, resp2.status_message);

    let resp3 = framework.handle_rest_request(HTTPMethod::Get, "/api/v1/users/123", None);
    println!("GET /api/v1/users/123 → {} {}", resp3.status_code, resp3.status_message);

    let resp4 = framework.handle_rest_request(HTTPMethod::Delete, "/api/v1/invalid", None);
    println!("DELETE /api/v1/invalid → {} {}", resp4.status_code, resp4.status_message);

    println!();

    // Handle GraphQL
    let graphql_resp = framework.handle_graphql_query("query { getUsers { id name email } }".to_string());
    println!("GraphQL Query → {} {}", graphql_resp.status_code, graphql_resp.status_message);

    println!();

    // Print documentation
    framework.print_api_documentation();
    framework.print_graphql_documentation();
    framework.print_api_metrics();

    println!("✓ REST/GraphQL framework operational");
}
