use std::collections::HashMap;
use std::time::{SystemTime, UNIX_EPOCH};

// ─────────────────────────────────────────────────────────────────────────────────────────────────────────
// IDE EXTENSION TYPES
// ─────────────────────────────────────────────────────────────────────────────────────────────────────────

#[derive(Clone, Copy, Debug, PartialEq)]
pub enum IDEType {
    VSCode,
    JetBrains,
    Vim,
    Emacs,
}

impl IDEType {
    pub fn name(&self) -> &str {
        match self {
            IDEType::VSCode => "VS Code",
            IDEType::JetBrains => "JetBrains",
            IDEType::Vim => "Vim",
            IDEType::Emacs => "Emacs",
        }
    }

    pub fn marketplace(&self) -> &str {
        match self {
            IDEType::VSCode => "Visual Studio Marketplace",
            IDEType::JetBrains => "JetBrains Plugins",
            IDEType::Vim => "vim-plug / Vundle",
            IDEType::Emacs => "MELPA",
        }
    }
}

#[derive(Clone, Debug)]
pub struct IDEExtension {
    pub name: String,
    pub ide: IDEType,
    pub version: String,
    pub features: Vec<String>,
    pub installed: bool,
    pub enabled: bool,
}

impl IDEExtension {
    pub fn new(name: String, ide: IDEType, version: String) -> Self {
        IDEExtension {
            name,
            ide,
            version,
            features: Vec::new(),
            installed: false,
            enabled: false,
        }
    }

    pub fn add_feature(&mut self, feature: String) {
        self.features.push(feature);
    }

    pub fn install(&mut self) {
        self.installed = true;
        self.enabled = true;
    }
}

#[derive(Clone, Copy, Debug, PartialEq)]
pub enum ReleaseType {
    Major,
    Minor,
    Patch,
}

impl ReleaseType {
    pub fn name(&self) -> &str {
        match self {
            ReleaseType::Major => "Major",
            ReleaseType::Minor => "Minor",
            ReleaseType::Patch => "Patch",
        }
    }
}

#[derive(Clone, Debug)]
pub struct Release {
    pub version: String,
    pub release_type: ReleaseType,
    pub timestamp: u64,
    pub commits: Vec<String>,
    pub breaking_changes: Vec<String>,
    pub new_features: Vec<String>,
    pub bug_fixes: Vec<String>,
    pub changelog: String,
}

impl Release {
    pub fn new(version: String, release_type: ReleaseType) -> Self {
        Release {
            version,
            release_type,
            timestamp: current_timestamp(),
            commits: Vec::new(),
            breaking_changes: Vec::new(),
            new_features: Vec::new(),
            bug_fixes: Vec::new(),
            changelog: String::new(),
        }
    }

    pub fn add_commit(&mut self, commit: String) {
        self.commits.push(commit);
    }

    pub fn add_feature(&mut self, feature: String) {
        self.new_features.push(feature);
    }

    pub fn add_bug_fix(&mut self, fix: String) {
        self.bug_fixes.push(fix);
    }

    pub fn add_breaking_change(&mut self, change: String) {
        self.breaking_changes.push(change);
    }

    pub fn generate_changelog(&mut self) {
        let mut changelog = String::new();
        changelog.push_str(&format!("# Version {}\n\n", self.version));
        changelog.push_str(&format!("Released: {}\n\n", self.timestamp));

        if !self.breaking_changes.is_empty() {
            changelog.push_str("## Breaking Changes\n");
            for change in &self.breaking_changes {
                changelog.push_str(&format!("- {}\n", change));
            }
            changelog.push_str("\n");
        }

        if !self.new_features.is_empty() {
            changelog.push_str("## New Features\n");
            for feature in &self.new_features {
                changelog.push_str(&format!("- {}\n", feature));
            }
            changelog.push_str("\n");
        }

        if !self.bug_fixes.is_empty() {
            changelog.push_str("## Bug Fixes\n");
            for fix in &self.bug_fixes {
                changelog.push_str(&format!("- {}\n", fix));
            }
            changelog.push_str("\n");
        }

        changelog.push_str(&format!("## Commits\n{} commits included\n", self.commits.len()));

        self.changelog = changelog;
    }
}

pub struct IDEIntegrationSystem {
    pub extensions: HashMap<String, IDEExtension>,
    pub releases: Vec<Release>,
    pub current_version: String,
    pub lsp_enabled: bool,
    pub auto_format_enabled: bool,
    pub syntax_highlighting_enabled: bool,
}

impl IDEIntegrationSystem {
    pub fn new(current_version: String) -> Self {
        IDEIntegrationSystem {
            extensions: HashMap::new(),
            releases: Vec::new(),
            current_version,
            lsp_enabled: true,
            auto_format_enabled: true,
            syntax_highlighting_enabled: true,
        }
    }

    pub fn register_extension(&mut self, extension: IDEExtension) -> Result<(), String> {
        self.extensions.insert(extension.name.clone(), extension);
        Ok(())
    }

    pub fn install_extension(&mut self, name: &str) -> Result<(), String> {
        if let Some(ext) = self.extensions.get_mut(name) {
            ext.install();
            println!("✓ {} extension installed and enabled", name);
            Ok(())
        } else {
            Err(format!("Extension {} not found", name))
        }
    }

    pub fn create_release(&mut self, version: String, release_type: ReleaseType) -> Result<Release, String> {
        let release = Release::new(version, release_type);
        self.releases.push(release.clone());
        Ok(release)
    }

    pub fn publish_release(&mut self, version: &str) -> Result<(), String> {
        if let Some(release) = self.releases.iter_mut().find(|r| r.version == version) {
            release.generate_changelog();
            self.current_version = version.to_string();
            println!("✓ Version {} published", version);
            Ok(())
        } else {
            Err(format!("Release {} not found", version))
        }
    }

    pub fn print_extension_status(&self) {
        println!("\n╔════ IDE EXTENSIONS ════╗");

        for (name, ext) in &self.extensions {
            let status = if ext.enabled { "✓ ENABLED" } else { "✗ DISABLED" };
            println!("║ {} - {}", name, status);
            println!("║   IDE: {}", ext.ide.name());
            println!("║   Version: {}", ext.version);
            println!("║   Features: {}", ext.features.join(", "));
        }

        println!("╚═══════════════════════╝\n");
    }

    pub fn print_release_history(&self) {
        println!("\n╔════ RELEASE HISTORY ════╗");

        for release in self.releases.iter().rev() {
            println!("║ v{} ({})", release.version, release.release_type.name());
            println!("║   Features: {}", release.new_features.len());
            println!("║   Fixes: {}", release.bug_fixes.len());
            if !release.breaking_changes.is_empty() {
                println!("║   Breaking Changes: {}", release.breaking_changes.len());
            }
        }

        println!("╚═════════════════════════╝\n");
    }

    pub fn print_changelog(&self, version: &str) {
        if let Some(release) = self.releases.iter().find(|r| r.version == version) {
            println!("\n{}", release.changelog);
        } else {
            println!("Release {} not found", version);
        }
    }

    pub fn print_feature_status(&self) {
        println!("\n╔════ IDE FEATURES ════╗");
        println!("║ Language Server Protocol: {}", if self.lsp_enabled { "✓ Enabled" } else { "✗ Disabled" });
        println!("║ Auto-formatting: {}", if self.auto_format_enabled { "✓ Enabled" } else { "✗ Disabled" });
        println!("║ Syntax Highlighting: {}", if self.syntax_highlighting_enabled { "✓ Enabled" } else { "✗ Disabled" });
        println!("╚══════════════════════╝\n");
    }
}

fn current_timestamp() -> u64 {
    SystemTime::now()
        .duration_since(UNIX_EPOCH)
        .unwrap_or_default()
        .as_secs()
}

pub fn main() {
    println!("╔════════════════════════════════════════════════════════════════╗");
    println!("║        OMNISYSTEM IDE INTEGRATION v1.0                        ║");
    println!("║        VS Code | JetBrains | Release Automation              ║");
    println!("╚════════════════════════════════════════════════════════════════╝\n");

    let mut ide_system = IDEIntegrationSystem::new("1.0.0".to_string());

    // Register VS Code extension
    let mut vscode_ext = IDEExtension::new(
        "Omnisystem".to_string(),
        IDEType::VSCode,
        "1.0.0".to_string(),
    );
    vscode_ext.add_feature("Syntax Highlighting".to_string());
    vscode_ext.add_feature("Code Completion".to_string());
    vscode_ext.add_feature("Debugger Integration".to_string());
    vscode_ext.add_feature("Performance Profiler".to_string());
    ide_system.register_extension(vscode_ext).ok();

    // Register JetBrains extension
    let mut jetbrains_ext = IDEExtension::new(
        "Omnisystem".to_string(),
        IDEType::JetBrains,
        "1.0.0".to_string(),
    );
    jetbrains_ext.add_feature("Code Inspection".to_string());
    jetbrains_ext.add_feature("Refactoring Tools".to_string());
    jetbrains_ext.add_feature("Test Runner".to_string());
    ide_system.register_extension(jetbrains_ext).ok();

    // Install extensions
    println!("Installing IDE extensions...\n");
    ide_system.install_extension("Omnisystem").ok();

    // Create releases
    println!("Creating release history...\n");

    let mut v1_0_0 = ide_system.create_release("1.0.0".to_string(), ReleaseType::Major).ok().unwrap();
    v1_0_0.add_feature("Initial release with all 12 enterprise systems".to_string());
    v1_0_0.add_feature("VS Code extension".to_string());
    v1_0_0.add_feature("JetBrains plugin".to_string());
    v1_0_0.add_feature("Language Server Protocol support".to_string());
    v1_0_0.generate_changelog();

    let mut v1_0_1 = ide_system.create_release("1.0.1".to_string(), ReleaseType::Patch).ok().unwrap();
    v1_0_1.add_bug_fix("Fixed debugger variable inspection".to_string());
    v1_0_1.add_bug_fix("Improved syntax highlighting performance".to_string());
    v1_0_1.generate_changelog();

    let mut v1_1_0 = ide_system.create_release("1.1.0".to_string(), ReleaseType::Minor).ok().unwrap();
    v1_1_0.add_feature("AI-powered code completion".to_string());
    v1_1_0.add_feature("Real-time error analysis".to_string());
    v1_1_0.add_bug_fix("Fixed LSP connection stability".to_string());
    v1_1_0.generate_changelog();

    // Publish latest release
    println!("Publishing v1.1.0...\n");
    ide_system.publish_release("1.1.0").ok();

    // Print status
    ide_system.print_feature_status();
    ide_system.print_extension_status();
    ide_system.print_release_history();

    // Print latest changelog
    println!("Latest Release Changelog:");
    ide_system.print_changelog("1.1.0");

    println!("✓ IDE integration system operational");
}
