// OMNISYSTEM COST OPTIMIZATION ENGINE - RESOURCE TRACKING & OPTIMIZATION
// Phase 13: Enterprise Systems | Language: TITAN

use std::collections::HashMap;

pub struct ResourceUsage {
    pub cpu_percent: f32,
    pub memory_mb: f32,
    pub disk_gb: f32,
    pub network_mbps: f32,
}

pub struct Workload {
    pub name: String,
    pub service: String,
    pub current_usage: ResourceUsage,
    pub cost_per_hour: f32,
}

impl Workload {
    pub fn new(name: String, service: String) -> Self {
        Workload {
            name,
            service,
            current_usage: ResourceUsage {
                cpu_percent: 0.0,
                memory_mb: 0.0,
                disk_gb: 0.0,
                network_mbps: 0.0,
            },
            cost_per_hour: 0.0,
        }
    }

    pub fn update_usage(&mut self, usage: ResourceUsage) {
        self.current_usage = usage;
        self.cost_per_hour = (self.current_usage.cpu_percent * 0.05) + (self.current_usage.memory_mb * 0.01);
    }
}

pub struct CostAllocation {
    pub team: String,
    pub total_cost: f32,
    pub workloads: Vec<String>,
}

pub struct OptimizationRecommendation {
    pub workload: String,
    pub recommendation_type: String,
    pub projected_savings: f32,
}

pub struct CostOptimizationEngine {
    pub workloads: HashMap<String, Workload>,
    pub cost_allocations: HashMap<String, CostAllocation>,
    pub total_monthly_cost: f32,
}

impl CostOptimizationEngine {
    pub fn new() -> Self {
        CostOptimizationEngine {
            workloads: HashMap::new(),
            cost_allocations: HashMap::new(),
            total_monthly_cost: 0.0,
        }
    }

    pub fn register_workload(&mut self, workload: Workload) -> Result<(), String> {
        self.workloads.insert(workload.name.clone(), workload);
        Ok(())
    }

    pub fn allocate_cost(&mut self, team: String, workloads: Vec<String>) -> Result<(), String> {
        let mut total = 0.0;
        for workload_name in &workloads {
            if let Some(workload) = self.workloads.get(workload_name) {
                total += workload.cost_per_hour * 730.0;
            }
        }
        self.cost_allocations.insert(team, CostAllocation {
            team: "platform".to_string(),
            total_cost: total,
            workloads,
        });
        self.total_monthly_cost += total;
        Ok(())
    }

    pub fn generate_recommendations(&self) -> Vec<OptimizationRecommendation> {
        let mut recs = Vec::new();
        for (_, workload) in &self.workloads {
            if workload.current_usage.cpu_percent < 20.0 {
                recs.push(OptimizationRecommendation {
                    workload: workload.name.clone(),
                    recommendation_type: "reduce_size".to_string(),
                    projected_savings: workload.cost_per_hour * 730.0 * 0.4,
                });
            }
        }
        recs
    }
}

pub fn main() {
    println!("COST OPTIMIZATION ENGINE v1.0");
    let mut optimizer = CostOptimizationEngine::new();
    
    let mut w1 = Workload::new("api-prod".to_string(), "api".to_string());
    w1.update_usage(ResourceUsage { cpu_percent: 15.0, memory_mb: 400.0, disk_gb: 50.0, network_mbps: 10.0 });
    optimizer.register_workload(w1).ok();
    
    let mut w2 = Workload::new("db-prod".to_string(), "db".to_string());
    w2.update_usage(ResourceUsage { cpu_percent: 45.0, memory_mb: 2000.0, disk_gb: 500.0, network_mbps: 50.0 });
    optimizer.register_workload(w2).ok();
    
    optimizer.allocate_cost("platform".to_string(), vec!["api-prod".to_string()]).ok();
    
    let recs = optimizer.generate_recommendations();
    println!("✓ Cost Optimization operational - {} recommendations", recs.len());
}