{
  "mcpServers": {
    "mcp-server": {
      "command": "cargo",
      "args": [
        "run",
        "--manifest-path",
        "Z:\\Projects\\OmnisystemEcosystem\\crates\\mcp-server\\Cargo.toml",
        "--release"
      ],
      "env": {
        "RUST_LOG": "debug,omnisystem_mcp=trace",
        "OMNISYSTEM_CONFIG": "Z:\\Projects\\OmnisystemEcosystem\\.omnisystem\\config.toml"
      }
    },
    "omnisystem-bug-hunter": {
      "command": "cargo",
      "args": [
        "run",
        "--manifest-path",
        "Z:\\Projects\\OmnisystemEcosystem\\crates\\omnisystem-bug-hunter\\Cargo.toml",
        "--release"
      ],
      "env": {
        "RUST_LOG": "debug,bug_hunter=trace"
      }
    },
    "omnisystem-ci": {
      "command": "cargo",
      "args": [
        "run",
        "--manifest-path",
        "Z:\\Projects\\OmnisystemEcosystem\\crates\\omnisystem-ci\\Cargo.toml",
        "--release"
      ]
    }
  },
  "tools": {
    "omnisystem-mcp": [
      "omnisystem_lint",
      "omnisystem_apply_fix",
      "omnisystem_dismiss_diagnostic",
      "omnisystem_report_false_positive"
    ],
    "omnisystem-bug-hunter": [
      "omnisystem_scan_repo",
      "omnisystem_scan_status",
      "omnisystem_list_findings",
      "omnisystem_get_finding",
      "omnisystem_auto_fix",
      "omnisystem_explain_diagnostic",
      "omnisystem_prioritize_findings",
      "omnisystem_generate_report"
    ],
    "omnisystem-ci": [
      "omnisystem_run_checks",
      "omnisystem_trigger_workflow",
      "omnisystem_get_workflow_status",
      "omnisystem_list_workflows"
    ]
  }
}
