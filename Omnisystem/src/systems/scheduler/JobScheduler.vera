// Omnisystem Job Scheduler - Task Automation and Scheduling Framework
// Cron-like scheduling, job monitoring, execution history, and failure handling

use std::collections::HashMap;

pub struct JobScheduler {
    id: String,
    version: String,
    theme: Theme,
    asset_manager: AssetManager,

    // Job data
    scheduled_jobs: Vec<ScheduledJob>,
    job_history: Vec<JobExecutionRecord>,
    active_executions: HashMap<String, JobExecution>,
    job_templates: Vec<JobTemplate>,

    // Scheduler state
    is_enabled: bool,
    current_tab: SchedulerTab,
    selected_job: Option<String>,

    // Settings
    max_concurrent_jobs: u32,
    job_timeout: u32,
    retry_policy: RetryPolicy,
    notification_on_failure: bool,
}

impl JobScheduler {
    pub fn new(asset_manager: AssetManager) -> Self {
        Self {
            id: "job-scheduler".to_string(),
            version: "29.0.0".to_string(),
            theme: asset_manager.get_current_theme(),
            asset_manager: asset_manager.clone(),
            scheduled_jobs: Self::load_default_jobs(),
            job_history: vec![],
            active_executions: HashMap::new(),
            job_templates: Self::load_job_templates(),
            is_enabled: true,
            current_tab: SchedulerTab::Jobs,
            selected_job: None,
            max_concurrent_jobs: 10,
            job_timeout: 3600,
            retry_policy: RetryPolicy::default(),
            notification_on_failure: true,
        }
    }

    pub fn render(&self) -> Widget {
        ApplicationWindow {
            id: "job-scheduler".to_string(),
            title: "Omnisystem Job Scheduler".to_string(),
            width: 1600,
            height: 900,

            children: vec![
                self.render_header(),

                Row {
                    spacing: 0.0,
                    height: "1fr".to_string(),

                    children: vec![
                        // Sidebar
                        self.render_sidebar(),

                        // Main content
                        Panel {
                            width: "1fr".to_string(),
                            padding: 20.0,
                            background_color: self.theme.colors.background,

                            children: match self.current_tab {
                                SchedulerTab::Jobs => self.render_jobs_tab(),
                                SchedulerTab::Templates => self.render_templates_tab(),
                                SchedulerTab::History => self.render_history_tab(),
                                SchedulerTab::Settings => self.render_settings_tab(),
                            },
                        },
                    ],
                },
            ],
        }
    }

    fn render_header(&self) -> Widget {
        Panel {
            height: 60.0,
            padding: 16.0,
            background_color: self.theme.colors.primary,
            border_bottom: true,

            children: vec![
                Row {
                    spacing: 16.0,
                    vertical_align: "center".to_string(),

                    children: vec![
                        Image {
                            source: self.asset_manager.load_icon("schedule", 32),
                            width: 32.0,
                            height: 32.0,
                        },

                        Label {
                            text: "Job Scheduler".to_string(),
                            font_size: 18.0,
                            font_weight: 700,
                            color: self.theme.colors.white,
                        },

                        Spacer {},

                        // Status
                        Row {
                            spacing: 12.0,

                            children: vec![
                                Row {
                                    spacing: 6.0,
                                    children: vec![
                                        Circle {
                                            radius: 6.0,
                                            color: if self.is_enabled { self.theme.colors.success } else { self.theme.colors.error },
                                        },
                                        Label {
                                            text: if self.is_enabled { "Scheduler Running" } else { "Scheduler Stopped" },
                                            font_size: 11.0,
                                            color: self.theme.colors.white,
                                            font_weight: 600,
                                        },
                                    ],
                                },

                                Button {
                                    label: if self.is_enabled { "Pause" } else { "Resume" },
                                    size: "small".to_string(),
                                    onClick: || {
                                        if JOB_SCHEDULER_STATE.is_enabled() {
                                            JOB_SCHEDULER_STATE.pause_scheduler();
                                        } else {
                                            JOB_SCHEDULER_STATE.resume_scheduler();
                                        }
                                    },
                                },

                                Badge {
                                    label: format!("{} jobs", self.scheduled_jobs.len()),
                                },

                                Badge {
                                    label: format!("{} executing", self.active_executions.len()),
                                    color: self.theme.colors.primary,
                                },
                            ],
                        },
                    ],
                },
            ],
        }
    }

    fn render_sidebar(&self) -> Widget {
        Panel {
            width: "180px".to_string(),
            padding: 12.0,
            background_color: self.theme.colors.surface,
            border_right: true,

            children: vec![
                Column {
                    spacing: 2.0,
                    margin_bottom: 20.0,

                    children: vec![
                        self.render_tab_button("Jobs", SchedulerTab::Jobs),
                        self.render_tab_button("Templates", SchedulerTab::Templates),
                        self.render_tab_button("History", SchedulerTab::History),
                        self.render_tab_button("Settings", SchedulerTab::Settings),
                    ],
                },

                Separator { margin: 12.0 },

                Column {
                    spacing: 8.0,

                    children: vec![
                        Label {
                            text: "Quick Stats".to_string(),
                            font_size: 11.0,
                            font_weight: 700,
                            margin_bottom: 8.0,
                        },

                        Row {
                            spacing: 4.0,
                            children: vec![
                                Circle { radius: 4.0, color: self.theme.colors.success },
                                Label {
                                    text: format!("{} Successful", self.job_history.iter().filter(|h| h.status == JobStatus::Success).count()),
                                    font_size: 10.0,
                                },
                            ],
                        },

                        Row {
                            spacing: 4.0,
                            children: vec![
                                Circle { radius: 4.0, color: self.theme.colors.error },
                                Label {
                                    text: format!("{} Failed", self.job_history.iter().filter(|h| h.status == JobStatus::Failed).count()),
                                    font_size: 10.0,
                                },
                            ],
                        },

                        Row {
                            spacing: 4.0,
                            children: vec![
                                Circle { radius: 4.0, color: self.theme.colors.warning },
                                Label {
                                    text: format!("{} Executing", self.active_executions.len()),
                                    font_size: 10.0,
                                },
                            ],
                        },
                    ],
                },
            ],
        }
    }

    fn render_jobs_tab(&self) -> Vec<Widget> {
        vec![
            Column {
                spacing: 16.0,

                children: vec![
                    Row {
                        spacing: 12.0,
                        margin_bottom: 16.0,

                        children: vec![
                            Label {
                                text: "Scheduled Jobs".to_string(),
                                font_size: 16.0,
                                font_weight: 700,
                            },

                            Spacer {},

                            Button {
                                label: "+ Create Job".to_string(),
                                variant: "primary".to_string(),
                                onClick: || {
                                    JOB_SCHEDULER_STATE.show_create_job_dialog();
                                },
                            },
                        ],
                    },

                    if self.scheduled_jobs.is_empty() {
                        Panel {
                            padding: 40.0,
                            alignment: "center".to_string(),

                            children: vec![
                                Label {
                                    text: "No scheduled jobs".to_string(),
                                    font_size: 12.0,
                                    color: self.theme.colors.foreground_secondary,
                                },
                            ],
                        }
                    } else {
                        Column {
                            spacing: 8.0,

                            children: self.scheduled_jobs.iter().map(|job| {
                                self.render_job_item(job)
                            }).collect(),
                        }
                    },
                ],
            },
        ]
    }

    fn render_job_item(&self, job: &ScheduledJob) -> Widget {
        Panel {
            padding: 12.0,
            background_color: self.theme.colors.surface,
            border: true,

            children: vec![
                Row {
                    spacing: 12.0,

                    children: vec![
                        Circle {
                            radius: 6.0,
                            color: match job.status {
                                JobStatus::Success => self.theme.colors.success,
                                JobStatus::Failed => self.theme.colors.error,
                                JobStatus::Running => self.theme.colors.primary,
                                JobStatus::Pending => self.theme.colors.warning,
                                JobStatus::Disabled => self.theme.colors.foreground_secondary,
                            },
                        },

                        Column {
                            spacing: 2.0,
                            width: "1fr".to_string(),

                            children: vec![
                                Row {
                                    spacing: 8.0,

                                    children: vec![
                                        Label {
                                            text: job.name.clone(),
                                            font_size: 12.0,
                                            font_weight: 700,
                                        },
                                        Badge {
                                            label: match job.status {
                                                JobStatus::Success => "Success".to_string(),
                                                JobStatus::Failed => "Failed".to_string(),
                                                JobStatus::Running => "Running".to_string(),
                                                JobStatus::Pending => "Pending".to_string(),
                                                JobStatus::Disabled => "Disabled".to_string(),
                                            },
                                            color: match job.status {
                                                JobStatus::Success => self.theme.colors.success,
                                                JobStatus::Failed => self.theme.colors.error,
                                                JobStatus::Running => self.theme.colors.primary,
                                                JobStatus::Pending => self.theme.colors.warning,
                                                JobStatus::Disabled => self.theme.colors.foreground_secondary,
                                            },
                                        },
                                    ],
                                },

                                Label {
                                    text: format!("Schedule: {} • Next run: {}", job.schedule, job.next_run),
                                    font_size: 10.0,
                                    color: self.theme.colors.foreground_secondary,
                                },

                                if let Some(msg) = &job.last_error {
                                    Label {
                                        text: format!("Last error: {}", msg),
                                        font_size: 9.0,
                                        color: self.theme.colors.error,
                                    }
                                } else {
                                    EmptyWidget {}
                                },
                            ],
                        },

                        Spacer {},

                        Column {
                            spacing: 4.0,

                            children: vec![
                                Button {
                                    label: "Edit".to_string(),
                                    size: "small".to_string(),
                                    onClick: || {
                                        JOB_SCHEDULER_STATE.edit_job(&job.id);
                                    },
                                },

                                Button {
                                    label: "Run Now".to_string(),
                                    size: "small".to_string(),
                                    variant: "primary".to_string(),
                                    onClick: || {
                                        JOB_SCHEDULER_STATE.run_job_now(&job.id);
                                    },
                                },

                                Button {
                                    label: "Delete".to_string(),
                                    size: "small".to_string(),
                                    variant: "danger".to_string(),
                                    onClick: || {
                                        JOB_SCHEDULER_STATE.delete_job(&job.id);
                                    },
                                },
                            ],
                        },
                    ],
                },
            ],
        }
    }

    fn render_templates_tab(&self) -> Vec<Widget> {
        vec![
            Column {
                spacing: 16.0,

                children: vec![
                    Label {
                        text: "Job Templates".to_string(),
                        font_size: 16.0,
                        font_weight: 700,
                        margin_bottom: 12.0,
                    },

                    Column {
                        spacing: 8.0,

                        children: self.job_templates.iter().map(|template| {
                            Panel {
                                padding: 12.0,
                                background_color: self.theme.colors.surface,
                                border: true,

                                children: vec![
                                    Row {
                                        spacing: 12.0,

                                        children: vec![
                                            Column {
                                                spacing: 2.0,
                                                width: "1fr".to_string(),

                                                children: vec![
                                                    Label {
                                                        text: template.name.clone(),
                                                        font_size: 12.0,
                                                        font_weight: 700,
                                                    },
                                                    Label {
                                                        text: template.description.clone(),
                                                        font_size: 10.0,
                                                        color: self.theme.colors.foreground_secondary,
                                                    },
                                                ],
                                            },

                                            Spacer {},

                                            Button {
                                                label: "Use Template".to_string(),
                                                size: "small".to_string(),
                                                onClick: || {
                                                    JOB_SCHEDULER_STATE.create_from_template(&template.id);
                                                },
                                            },
                                        ],
                                    },
                                ],
                            }
                        }).collect(),
                    },
                ],
            },
        ]
    }

    fn render_history_tab(&self) -> Vec<Widget> {
        vec![
            Column {
                spacing: 16.0,

                children: vec![
                    Label {
                        text: "Execution History".to_string(),
                        font_size: 16.0,
                        font_weight: 700,
                        margin_bottom: 12.0,
                    },

                    if self.job_history.is_empty() {
                        Label {
                            text: "No execution history".to_string(),
                            font_size: 12.0,
                            color: self.theme.colors.foreground_secondary,
                        }
                    } else {
                        Column {
                            spacing: 4.0,

                            children: self.job_history.iter().take(50).map(|record| {
                                Panel {
                                    padding: 10.0,
                                    background_color: self.theme.colors.surface,

                                    children: vec![
                                        Row {
                                            spacing: 12.0,

                                            children: vec![
                                                Circle {
                                                    radius: 5.0,
                                                    color: match record.status {
                                                        JobStatus::Success => self.theme.colors.success,
                                                        JobStatus::Failed => self.theme.colors.error,
                                                        _ => self.theme.colors.foreground_secondary,
                                                    },
                                                },

                                                Label {
                                                    text: record.job_name.clone(),
                                                    font_size: 11.0,
                                                    font_weight: 600,
                                                    width: "150px".to_string(),
                                                },

                                                Label {
                                                    text: record.start_time.clone(),
                                                    font_size: 10.0,
                                                    color: self.theme.colors.foreground_secondary,
                                                    width: "140px".to_string(),
                                                },

                                                Label {
                                                    text: format!("{:.2}s", record.duration_seconds),
                                                    font_size: 10.0,
                                                    width: "60px".to_string(),
                                                },

                                                Label {
                                                    text: match record.status {
                                                        JobStatus::Success => "✓ Success".to_string(),
                                                        JobStatus::Failed => "✗ Failed".to_string(),
                                                        _ => "Unknown".to_string(),
                                                    },
                                                    font_size: 10.0,
                                                    color: match record.status {
                                                        JobStatus::Success => self.theme.colors.success,
                                                        JobStatus::Failed => self.theme.colors.error,
                                                        _ => self.theme.colors.foreground_secondary,
                                                    },
                                                },

                                                if let Some(msg) = &record.error_message {
                                                    Label {
                                                        text: msg.clone(),
                                                        font_size: 9.0,
                                                        color: self.theme.colors.error,
                                                    }
                                                } else {
                                                    EmptyWidget {}
                                                },
                                            ],
                                        },
                                    ],
                                }
                            }).collect(),
                        }
                    },
                ],
            },
        ]
    }

    fn render_settings_tab(&self) -> Vec<Widget> {
        vec![
            Column {
                spacing: 20.0,

                children: vec![
                    Label {
                        text: "Scheduler Settings".to_string(),
                        font_size: 16.0,
                        font_weight: 700,
                        margin_bottom: 12.0,
                    },

                    Column {
                        spacing: 12.0,

                        children: vec![
                            Label {
                                text: "Execution Settings".to_string(),
                                font_size: 12.0,
                                font_weight: 700,
                                margin_bottom: 8.0,
                            },

                            Row {
                                spacing: 8.0,

                                children: vec![
                                    Label {
                                        text: "Max concurrent jobs:".to_string(),
                                        font_size: 11.0,
                                    },
                                    Slider {
                                        value: self.max_concurrent_jobs as i32,
                                        min: 1,
                                        max: 50,
                                    },
                                    Label {
                                        text: self.max_concurrent_jobs.to_string(),
                                        font_size: 11.0,
                                        color: self.theme.colors.foreground_secondary,
                                    },
                                ],
                            },

                            Row {
                                spacing: 8.0,

                                children: vec![
                                    Label {
                                        text: "Job timeout (seconds):".to_string(),
                                        font_size: 11.0,
                                    },
                                    Slider {
                                        value: (self.job_timeout / 60) as i32,
                                        min: 60,
                                        max: 3600,
                                    },
                                    Label {
                                        text: format!("{}m", self.job_timeout / 60),
                                        font_size: 11.0,
                                        color: self.theme.colors.foreground_secondary,
                                    },
                                ],
                            },
                        ],
                    },

                    Separator { margin: 12.0 },

                    Column {
                        spacing: 12.0,

                        children: vec![
                            Label {
                                text: "Retry Policy".to_string(),
                                font_size: 12.0,
                                font_weight: 700,
                                margin_bottom: 8.0,
                            },

                            Row {
                                spacing: 8.0,

                                children: vec![
                                    Label {
                                        text: "Max retries:".to_string(),
                                        font_size: 11.0,
                                    },
                                    Slider {
                                        value: self.retry_policy.max_retries as i32,
                                        min: 0,
                                        max: 10,
                                    },
                                ],
                            },

                            Checkbox {
                                label: "Exponential backoff".to_string(),
                                checked: true,
                            },
                        ],
                    },

                    Separator { margin: 12.0 },

                    Checkbox {
                        label: "Notify on job failure".to_string(),
                        checked: self.notification_on_failure,
                        onChange: |enabled| {
                            JOB_SCHEDULER_STATE.set_notification_on_failure(enabled);
                        },
                    },
                ],
            },
        ]
    }

    fn render_tab_button(&self, label: &str, tab: SchedulerTab) -> Widget {
        Button {
            label: label.to_string(),
            variant: if std::mem::discriminant(&self.current_tab) == std::mem::discriminant(&tab) {
                "primary"
            } else {
                "secondary"
            },
            width: "100%".to_string(),
            margin_bottom: 4.0,
            onClick: || {
                JOB_SCHEDULER_STATE.switch_tab(tab);
            },
        }
    }

    fn load_default_jobs() -> Vec<ScheduledJob> {
        vec![
            ScheduledJob {
                id: "job-backup".to_string(),
                name: "System Backup".to_string(),
                schedule: "0 2 * * *".to_string(),
                next_run: "Tomorrow at 2:00 AM".to_string(),
                status: JobStatus::Pending,
                last_error: None,
            },
            ScheduledJob {
                id: "job-cleanup".to_string(),
                name: "Temporary Files Cleanup".to_string(),
                schedule: "0 3 * * 0".to_string(),
                next_run: "Sunday at 3:00 AM".to_string(),
                status: JobStatus::Pending,
                last_error: None,
            },
        ]
    }

    fn load_job_templates() -> Vec<JobTemplate> {
        vec![
            JobTemplate {
                id: "template-backup".to_string(),
                name: "Backup Job".to_string(),
                description: "Create system backup".to_string(),
            },
            JobTemplate {
                id: "template-cleanup".to_string(),
                name: "Cleanup Job".to_string(),
                description: "Remove old files and cache".to_string(),
            },
        ]
    }
}

// ============================================================================
// DATA STRUCTURES
// ============================================================================

#[derive(Clone, Copy, Debug, PartialEq)]
pub enum SchedulerTab {
    Jobs,
    Templates,
    History,
    Settings,
}

#[derive(Clone, Copy, Debug, PartialEq)]
pub enum JobStatus {
    Success,
    Failed,
    Running,
    Pending,
    Disabled,
}

#[derive(Clone, Debug)]
pub struct ScheduledJob {
    pub id: String,
    pub name: String,
    pub schedule: String,
    pub next_run: String,
    pub status: JobStatus,
    pub last_error: Option<String>,
}

#[derive(Clone, Debug)]
pub struct JobExecution {
    pub job_id: String,
    pub start_time: String,
    pub progress: f32,
}

#[derive(Clone, Debug)]
pub struct JobExecutionRecord {
    pub job_name: String,
    pub start_time: String,
    pub duration_seconds: f32,
    pub status: JobStatus,
    pub error_message: Option<String>,
}

#[derive(Clone, Debug)]
pub struct JobTemplate {
    pub id: String,
    pub name: String,
    pub description: String,
}

#[derive(Clone, Debug)]
pub struct RetryPolicy {
    pub max_retries: u32,
    pub exponential_backoff: bool,
}

impl Default for RetryPolicy {
    fn default() -> Self {
        Self {
            max_retries: 3,
            exponential_backoff: true,
        }
    }
}

pub static JOB_SCHEDULER_STATE: LazyStatic<Mutex<JobScheduler>> =
    LazyStatic::new(|| {
        Mutex::new(JobScheduler::new(AssetManager::global()))
    });
