        }

        pub fn blue_light_filter() -> Self {
            ThemeDefinition {
                name: "Blue Light Filter".to_string(),
                colors: ColorSet {
                    primary: "#D4A574".to_string(),
                    secondary: "#A8754D".to_string(),
                    background: "#FFF8E7".to_string(),
                    foreground: "#3D2817".to_string(),
                    accent: "#E8A857".to_string(),
                    error: "#C85A54".to_string(),
                    warning: "#D4A557".to_string(),
