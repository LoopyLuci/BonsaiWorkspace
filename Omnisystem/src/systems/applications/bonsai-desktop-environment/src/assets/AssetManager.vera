    }

    // ============================================================================
    // FONT DEFINITIONS
    // ============================================================================

    impl FontResource {
        pub fn system() -> Self {
            FontResource {
                name: "Segoe UI".to_string(),
                path: "assets/fonts/segoe-ui/segoe-ui.ttf".to_string(),
                sizes: vec![11, 12, 13, 14, 15, 16, 18, 20],
                weights: vec![400, 500, 600, 700],
                styles: vec!["normal".to_string(), "italic".to_string()],
            }
        }

        pub fn heading() -> Self {
            FontResource {
                name: "Segoe UI".to_string(),
                path: "assets/fonts/segoe-ui/segoe-ui-bold.ttf".to_string(),
                sizes: vec![18, 20, 24, 28, 32, 36, 40, 48],
                weights: vec![600, 700],
                styles: vec!["normal".to_string()],
            }
        }

        pub fn monospace() -> Self {
            FontResource {
                name: "Cascadia Code".to_string(),
                path: "assets/fonts/cascadia-code/cascadia-code.ttf".to_string(),
                sizes: vec![10, 11, 12, 13, 14],
                weights: vec![400, 500, 600],
                styles: vec!["normal".to_string()],
            }
        }
    }
}
