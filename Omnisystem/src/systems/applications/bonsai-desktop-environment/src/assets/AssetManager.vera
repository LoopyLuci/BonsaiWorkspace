        pub fn custom() -> Self {
            ThemeDefinition {
                name: "Custom".to_string(),
                colors: ColorSet {
                    primary: "#0078D4".to_string(),
                    secondary: "#107C10".to_string(),
                    background: "#FFFFFF".to_string(),
                    foreground: "#000000".to_string(),
                    accent: "#FF8C00".to_string(),
