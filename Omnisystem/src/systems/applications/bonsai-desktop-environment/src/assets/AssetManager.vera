                    foreground: "#FFFFFF".to_string(),
                    accent: "#FF8C00".to_string(),
                    error: "#F03C2E".to_string(),
                    warning: "#FFB900".to_string(),
                    success: "#107C10".to_string(),
                    info: "#0078D4".to_string(),
                },
                shadows: vec![
                    ShadowDefinition {
                        name: "small".to_string(),
                        blur: 4.0,
                        offset_x: 0.0,
                        offset_y: 2.0,
                        opacity: 0.3,
                    },
                    ShadowDefinition {
                        name: "medium".to_string(),
                        blur: 8.0,
                        offset_x: 0.0,
                        offset_y: 4.0,
                        opacity: 0.4,
                    },
                    ShadowDefinition {
                        name: "large".to_string(),
                        blur: 16.0,
                        offset_x: 0.0,
                        offset_y: 8.0,
                        opacity: 0.5,
                    },
                ],
                borders: vec![
                    BorderDefinition {
                        name: "default".to_string(),
                        width: 1.0,
                        radius: 4.0,
                        style: "solid".to_string(),
                    },
                    BorderDefinition {
                        name: "rounded".to_string(),
                        width: 1.0,
                        radius: 8.0,
                        style: "solid".to_string(),
                    },
                ],
            }
        }

        pub fn high_contrast() -> Self {
            ThemeDefinition {
                name: "High Contrast".to_string(),
                colors: ColorSet {
                    primary: "#FFFFFF".to_string(),
                    secondary: "#000000".to_string(),
                    background: "#000000".to_string(),
                    foreground: "#FFFFFF".to_string(),
                    accent: "#FFFF00".to_string(),
                    error: "#FF0000".to_string(),
                    warning: "#FFFF00".to_string(),
                    success: "#00FF00".to_string(),
                    info: "#00FFFF".to_string(),
                },
                shadows: vec![],
                borders: vec![
                    BorderDefinition {
                        name: "default".to_string(),
