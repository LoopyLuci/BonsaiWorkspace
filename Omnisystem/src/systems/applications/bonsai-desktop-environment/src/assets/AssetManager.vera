                    background: "#FFFFFF".to_string(),
                    foreground: "#000000".to_string(),
                    accent: "#FF8C00".to_string(),
                    error: "#E81123".to_string(),
                    warning: "#FFB900".to_string(),
                    success: "#107C10".to_string(),
                    info: "#0078D4".to_string(),
                },
                shadows: vec![
                    ShadowDefinition {
                        name: "small".to_string(),
                        blur: 4.0,
                        offset_x: 0.0,
                        offset_y: 2.0,
                        opacity: 0.1,
                    },
                    ShadowDefinition {
                        name: "medium".to_string(),
                        blur: 8.0,
                        offset_x: 0.0,
                        offset_y: 4.0,
                        opacity: 0.15,
                    },
                    ShadowDefinition {
                        name: "large".to_string(),
                        blur: 16.0,
                        offset_x: 0.0,
                        offset_y: 8.0,
                        opacity: 0.2,
                    },
                ],
                borders: vec![
                    BorderDefinition {
                        name: "default".to_string(),
                        width: 1.0,
                        radius: 4.0,
                        style: "solid".to_string(),
                    },
                    BorderDefinition {
                        name: "rounded".to_string(),
                        width: 1.0,
                        radius: 8.0,
                        style: "solid".to_string(),
                    },
                ],
            }
        }

        pub fn dark() -> Self {
            ThemeDefinition {
                name: "Dark".to_string(),
