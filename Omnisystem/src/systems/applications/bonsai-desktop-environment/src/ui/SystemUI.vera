// System UI - Complete Desktop Environment User Interface
// Main visual interface for BonsaiEcosystem Desktop
// Language: VERA (UI) + HELIX (Graphics)

module SystemUI {

    pub struct SystemUI {
        pub name: String,
        pub initialized: bool,
        pub taskbar: TaskbarUI,
        pub system_tray: SystemTrayUI,
        pub desktop: DesktopUI,
        pub notification_popup: Option<NotificationPopup>,
        pub theme: String,
    }

    pub struct TaskbarUI {
        pub id: String,
        pub height: i32,
        pub position: String, // "bottom", "top", "left", "right"
        pub background_color: String,
        pub buttons: Vec<TaskbarButton>,
        pub pinned_apps: Vec<PinnedApp>,
        pub running_apps: Vec<RunningApp>,
    }

    pub struct TaskbarButton {
        pub id: String,
        pub label: String,
        pub icon: String,
        pub tooltip: String,
        pub action: String,
        pub highlighted: bool,
    }

    pub struct PinnedApp {
        pub id: String,
        pub name: String,
        pub icon: String,
        pub executable: String,
    }

    pub struct RunningApp {
        pub window_id: String,
        pub title: String,
        pub icon: String,
        pub preview_available: bool,
    }

    pub struct SystemTrayUI {
        pub id: String,
        pub width: i32,
        pub height: i32,
        pub icons: Vec<TrayIcon>,
        pub show_hidden: bool,
        pub overflow_count: i32,
    }

    pub struct TrayIcon {
        pub id: String,
        pub app_name: String,
        pub icon: String,
        pub tooltip: String,
        pub actions: Vec<String>,
    }

    pub struct DesktopUI {
        pub id: String,
        pub width: i32,
        pub height: i32,
        pub background: DesktopBackground,
        pub widgets: Vec<DesktopWidget>,
        pub shortcuts: Vec<DesktopShortcut>,
    }

    pub struct DesktopBackground {
        pub image_path: Option<String>,
        pub color: String,
        pub blur_enabled: bool,
        pub blur_amount: f32,
    }

    pub struct DesktopWidget {
        pub id: String,
        pub widget_type: String, // "clock", "weather", "calendar", "notes", "quicklaunch"
        pub x: i32,
        pub y: i32,
        pub width: i32,
        pub height: i32,
        pub content: String,
    }

    pub struct DesktopShortcut {
        pub id: String,
        pub name: String,
        pub icon: String,
        pub target: String,
        pub x: i32,
        pub y: i32,
    }

    pub struct NotificationPopup {
        pub id: String,
        pub title: String,
        pub message: String,
        pub icon: String,
        pub duration: i32,
        pub position: String, // "top-right", "top-left", "bottom-right", "bottom-left"
        pub actions: Vec<NotificationAction>,
    }

    pub struct NotificationAction {
        pub id: String,
        pub label: String,
        pub action: String,
    }

    pub struct ContextualMenu {
        pub id: String,
        pub items: Vec<ContextualMenuItem>,
        pub x: i32,
        pub y: i32,
    }

    pub struct ContextualMenuItem {
        pub id: String,
        pub label: String,
        pub icon: Option<String>,
        pub action: String,
        pub separator: bool,
    }

    impl SystemUI {
        pub fn new(screen_width: i32, screen_height: i32) -> Self {
            SystemUI {
                name: "System UI".to_string(),
                initialized: false,
                taskbar: TaskbarUI {
                    id: "taskbar".to_string(),
                    height: 48,
                    position: "bottom".to_string(),
                    background_color: "#FFFFFF".to_string(),
                    buttons: Vec::new(),
                    pinned_apps: Vec::new(),
                    running_apps: Vec::new(),
                },
                system_tray: SystemTrayUI {
                    id: "tray".to_string(),
                    width: 200,
                    height: 48,
                    icons: Vec::new(),
                    show_hidden: false,
                    overflow_count: 0,
                },
                desktop: DesktopUI {
                    id: "desktop".to_string(),
                    width: screen_width,
                    height: screen_height - 48, // Taskbar height
                    background: DesktopBackground {
                        image_path: None,
                        color: "#1A1A1A".to_string(),
                        blur_enabled: false,
                        blur_amount: 0.0,
                    },
                    widgets: Vec::new(),
                    shortcuts: Vec::new(),
                },
                notification_popup: None,
                theme: "light".to_string(),
            }
        }

        pub fn initialize(&mut self) -> Result<(), String> {
            println!("    Initializing System UI");
            println!("    Setting up taskbar");
            println!("    Setting up system tray");
            println!("    Configuring desktop");

            self.setup_taskbar()?;
            self.setup_system_tray()?;
            self.setup_desktop()?;

            self.initialized = true;

            println!("    ✓ System UI ready");
            println!("    ✓ Taskbar configured ({}px height)", self.taskbar.height);
            println!("    ✓ System tray configured");
            println!("    ✓ Desktop background set");

            Ok(())
        }

        fn setup_taskbar(&mut self) -> Result<(), String> {
            // Add standard taskbar buttons
            self.taskbar.buttons.push(TaskbarButton {
                id: "start".to_string(),
                label: "Start".to_string(),
                icon: "bonsai".to_string(),
                tooltip: "Open Start Menu".to_string(),
                action: "open_start_menu".to_string(),
                highlighted: false,
            });

            // Add pinned apps
            self.taskbar.pinned_apps.push(PinnedApp {
                id: "file-manager".to_string(),
                name: "File Manager".to_string(),
                icon: "file-manager".to_string(),
                executable: "FileManager.exe".to_string(),
            });

            self.taskbar.pinned_apps.push(PinnedApp {
                id: "settings".to_string(),
                name: "Settings".to_string(),
                icon: "settings".to_string(),
                executable: "ControlPanel.exe".to_string(),
            });

            Ok(())
        }

        fn setup_system_tray(&mut self) -> Result<(), String> {
            // Add default system tray icons
            self.system_tray.icons.push(TrayIcon {
                id: "network".to_string(),
                app_name: "Network".to_string(),
                icon: "wifi".to_string(),
                tooltip: "Network Status".to_string(),
                actions: vec!["open_network_settings".to_string()],
            });

            self.system_tray.icons.push(TrayIcon {
                id: "volume".to_string(),
                app_name: "Volume".to_string(),
                icon: "volume".to_string(),
                tooltip: "Volume Control".to_string(),
                actions: vec!["volume_up".to_string(), "volume_down".to_string()],
            });

            self.system_tray.icons.push(TrayIcon {
                id: "battery".to_string(),
                app_name: "Battery".to_string(),
                icon: "battery".to_string(),
                tooltip: "Battery Status".to_string(),
                actions: vec!["power_settings".to_string()],
            });

            Ok(())
        }

        fn setup_desktop(&mut self) -> Result<(), String> {
            println!("      Desktop background configured");
            println!("      Widget system initialized");
            Ok(())
        }

        pub fn add_pinned_app(&mut self, name: &str, icon: &str, executable: &str) -> Result<String, String> {
            let app = PinnedApp {
                id: format!("app-{}", std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_millis()),
                name: name.to_string(),
                icon: icon.to_string(),
                executable: executable.to_string(),
            };
            let app_id = app.id.clone();
            self.taskbar.pinned_apps.push(app);
            Ok(app_id)
        }

        pub fn add_running_app(&mut self, window_id: &str, title: &str, icon: &str) -> Result<(), String> {
            self.taskbar.running_apps.push(RunningApp {
                window_id: window_id.to_string(),
                title: title.to_string(),
                icon: icon.to_string(),
                preview_available: true,
            });
            Ok(())
        }

        pub fn remove_running_app(&mut self, window_id: &str) -> Result<(), String> {
            self.taskbar.running_apps.retain(|app| app.window_id != window_id);
            Ok(())
        }

        pub fn add_tray_icon(&mut self, app_name: &str, icon: &str) -> Result<String, String> {
            let tray_icon = TrayIcon {
                id: format!("tray-{}", std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_millis()),
                app_name: app_name.to_string(),
                icon: icon.to_string(),
                tooltip: app_name.to_string(),
                actions: Vec::new(),
            };
            let icon_id = tray_icon.id.clone();
            self.system_tray.icons.push(tray_icon);
            Ok(icon_id)
        }

        pub fn remove_tray_icon(&mut self, icon_id: &str) -> Result<(), String> {
            self.system_tray.icons.retain(|icon| icon.id != icon_id);
            Ok(())
        }

        pub fn set_background(&mut self, color: &str) -> Result<(), String> {
            self.desktop.background.color = color.to_string();
            Ok(())
        }

        pub fn set_background_image(&mut self, path: &str) -> Result<(), String> {
            self.desktop.background.image_path = Some(path.to_string());
            Ok(())
        }

        pub fn show_notification(&mut self, title: &str, message: &str, icon: &str) -> Result<String, String> {
            let notification = NotificationPopup {
                id: format!("notif-{}", std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_millis()),
                title: title.to_string(),
                message: message.to_string(),
                icon: icon.to_string(),
                duration: 5,
                position: "top-right".to_string(),
                actions: Vec::new(),
            };
            let notif_id = notification.id.clone();
            self.notification_popup = Some(notification);
            Ok(notif_id)
        }

        pub fn hide_notification(&mut self) -> Result<(), String> {
            self.notification_popup = None;
            Ok(())
        }

        pub fn show_context_menu(&self, x: i32, y: i32, items: Vec<(String, String)>) -> Result<ContextualMenu, String> {
            let menu = ContextualMenu {
                id: format!("ctx-{}", std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_millis()),
                items: items.into_iter()
                    .map(|(label, action)| ContextualMenuItem {
                        id: format!("item-{}", label),
                        label,
                        icon: None,
                        action,
                        separator: false,
                    })
                    .collect(),
                x,
                y,
            };
            Ok(menu)
        }

        pub fn set_theme(&mut self, theme: &str) -> Result<(), String> {
            self.theme = theme.to_string();
            match theme {
                "light" => {
                    self.taskbar.background_color = "#FFFFFF".to_string();
                    self.desktop.background.color = "#E0E0E0".to_string();
                },
                "dark" => {
                    self.taskbar.background_color = "#2D2D2D".to_string();
                    self.desktop.background.color = "#1A1A1A".to_string();
                },
                "high_contrast" => {
                    self.taskbar.background_color = "#000000".to_string();
                    self.desktop.background.color = "#000000".to_string();
                },
                _ => {}
            }
            Ok(())
        }

        pub fn shutdown(&mut self) -> Result<(), String> {
            self.taskbar.buttons.clear();
            self.taskbar.pinned_apps.clear();
            self.taskbar.running_apps.clear();
            self.system_tray.icons.clear();
            self.desktop.widgets.clear();
            self.desktop.shortcuts.clear();
            self.notification_popup = None;
            Ok(())
        }
    }
}
