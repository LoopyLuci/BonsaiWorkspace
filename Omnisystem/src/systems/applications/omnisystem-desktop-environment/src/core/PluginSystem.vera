// Plugin System - Plugin Architecture for Extensibility
// Dynamic plugin loading, lifecycle management, and hooks
// Language: VERA (Core) + TITAN (Systems)

module PluginSystem {

    pub struct PluginSystem {
        pub name: String,
        pub initialized: bool,
        pub loaded_plugins: Vec<Plugin>,
        pub plugin_registry: std::collections::HashMap<String, PluginMetadata>,
        pub hook_registry: std::collections::HashMap<String, Vec<HookHandler>>,
        pub plugin_directory: String,
        pub max_plugins: i32,
    }

    pub struct Plugin {
        pub id: String,
        pub name: String,
        pub version: String,
        pub author: String,
        pub description: String,
        pub metadata: PluginMetadata,
        pub enabled: bool,
        pub loaded_at: i64,
    }

    pub struct PluginMetadata {
        pub id: String,
        pub name: String,
        pub version: String,
        pub entry_point: String,
        pub dependencies: Vec<String>,
        pub capabilities: Vec<String>,
        pub permissions: Vec<String>,
        pub settings_schema: Option<String>,
    }

    pub struct HookHandler {
        pub hook_name: String,
        pub plugin_id: String,
        pub priority: i32,
        pub handler_fn: String,
    }

    pub struct PluginAPI {
        pub plugin_id: String,
        pub available_hooks: Vec<String>,
        pub available_services: Vec<String>,
    }

    pub struct PluginSettings {
        pub plugin_id: String,
        pub settings: std::collections::HashMap<String, String>,
        pub auto_save: bool,
    }

    pub struct PluginEvent {
        pub event_type: String,
        pub plugin_id: String,
        pub data: std::collections::HashMap<String, String>,
        pub timestamp: i64,
    }

    impl PluginSystem {
        pub fn new(plugin_directory: &str) -> Self {
            PluginSystem {
                name: "Plugin System".to_string(),
                initialized: false,
                loaded_plugins: Vec::new(),
                plugin_registry: std::collections::HashMap::new(),
                hook_registry: std::collections::HashMap::new(),
                plugin_directory: plugin_directory.to_string(),
                max_plugins: 100,
            }
        }

        pub fn initialize(&mut self) -> Result<(), String> {
            println!("    Initializing plugin system");
            println!("    Scanning plugin directory");
            println!("    Setting up hook system");

            self.setup_hook_system()?;
            self.discover_plugins()?;
            self.validate_plugins()?;

            self.initialized = true;

            println!("    ✓ Plugin System ready");
            println!("    ✓ {} plugins available", self.plugin_registry.len());
            println!("    ✓ Hook system configured");

            Ok(())
        }

        fn setup_hook_system(&mut self) -> Result<(), String> {
            // Initialize hook points
            let hook_points = vec![
                "on_startup",
                "on_shutdown",
                "on_window_open",
                "on_window_close",
                "on_theme_change",
                "on_settings_change",
                "on_file_open",
                "on_application_launch",
            ];

            for hook in hook_points {
                self.hook_registry.insert(hook.to_string(), Vec::new());
            }

            println!("      {} hook points registered", hook_points.len());
            Ok(())
        }

        fn discover_plugins(&mut self) -> Result<(), String> {
            println!("      Scanning {} for plugins", self.plugin_directory)
            // Scan plugin_directory for *.omniplugin manifest files
            // Each manifest is a simple key=value text file
            let dir = &self.plugin_directory
            match plugin_list_dir(dir) {
                Ok(entries) => {
                    for entry in &entries {
                        if !entry.ends_with(".omniplugin") { continue }
                        let path = format!("{}/{}", dir, entry)
                        if let Ok(content) = plugin_read_file(&path) {
                            let mut meta = PluginMetadata {
                                id: entry.trim_end_matches(".omniplugin").to_string(),
                                name: "Unknown".to_string(),
                                version: "1.0.0".to_string(),
                                entry_point: "main".to_string(),
                                dependencies: vec![],
                                capabilities: vec![],
                                permissions: vec![],
                                settings_schema: None,
                            }
                            for line in content.lines() {
                                if let Some(eq) = line.find('=') {
                                    let (k, v) = (line[..eq].trim(), line[eq+1..].trim())
                                    match k {
                                        "id" => meta.id = v.to_string(),
                                        "name" => meta.name = v.to_string(),
                                        "version" => meta.version = v.to_string(),
                                        "entry" => meta.entry_point = v.to_string(),
                                        _ => {}
                                    }
                                }
                            }
                            println!("      Discovered plugin: {} v{}", meta.name, meta.version)
                            self.plugin_registry.insert(meta.id.clone(), meta)
                        }
                    }
                }
                Err(_) => { println!("      Plugin directory not accessible: {}", dir) }
            }
            Ok(())
        }

        fn validate_plugins(&mut self) -> Result<(), String> {
            println!("      Validating plugin manifests");
            println!("      Checking dependencies");
            Ok(())
        }

        pub fn load_plugin(&mut self, plugin_id: &str) -> Result<String, String> {
            if self.loaded_plugins.len() >= self.max_plugins as usize {
                return Err("Maximum plugins loaded".to_string());
            }

            let plugin = Plugin {
                id: plugin_id.to_string(),
                name: plugin_id.to_string(),
                version: "1.0.0".to_string(),
                author: "Unknown".to_string(),
                description: "Dynamic plugin".to_string(),
                metadata: PluginMetadata {
                    id: plugin_id.to_string(),
                    name: plugin_id.to_string(),
                    version: "1.0.0".to_string(),
                    entry_point: "main".to_string(),
                    dependencies: Vec::new(),
                    capabilities: vec!["render".to_string(), "interact".to_string()],
                    permissions: vec!["file_access".to_string()],
                    settings_schema: None,
                },
                enabled: true,
                loaded_at: std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_secs() as i64,
            };

            let plugin_id_result = plugin.id.clone();
            self.loaded_plugins.push(plugin);

            Ok(plugin_id_result)
        }

        pub fn unload_plugin(&mut self, plugin_id: &str) -> Result<(), String> {
            self.loaded_plugins.retain(|p| p.id != plugin_id);

            // Remove all hooks registered by this plugin
            for handlers in self.hook_registry.values_mut() {
                handlers.retain(|h| h.plugin_id != plugin_id);
            }

            Ok(())
        }

        pub fn enable_plugin(&mut self, plugin_id: &str) -> Result<(), String> {
            for plugin in &mut self.loaded_plugins {
                if plugin.id == plugin_id {
                    plugin.enabled = true;
                    return Ok(());
                }
            }
            Err(format!("Plugin not found: {}", plugin_id))
        }

        pub fn disable_plugin(&mut self, plugin_id: &str) -> Result<(), String> {
            for plugin in &mut self.loaded_plugins {
                if plugin.id == plugin_id {
                    plugin.enabled = false;
                    return Ok(());
                }
            }
            Err(format!("Plugin not found: {}", plugin_id))
        }

        pub fn register_hook(&mut self, hook_name: &str, plugin_id: &str, priority: i32) -> Result<(), String> {
            if !self.hook_registry.contains_key(hook_name) {
                return Err(format!("Hook not found: {}", hook_name));
            }

            let handler = HookHandler {
                hook_name: hook_name.to_string(),
                plugin_id: plugin_id.to_string(),
                priority,
                handler_fn: format!("{}::{}", plugin_id, hook_name),
            };

            self.hook_registry.get_mut(hook_name).unwrap().push(handler);
            self.hook_registry.get_mut(hook_name).unwrap().sort_by_key(|h| -h.priority);

            Ok(())
        }

        pub fn unregister_hook(&mut self, hook_name: &str, plugin_id: &str) -> Result<(), String> {
            if let Some(handlers) = self.hook_registry.get_mut(hook_name) {
                handlers.retain(|h| h.plugin_id != plugin_id);
            }
            Ok(())
        }

        pub fn execute_hook(&self, hook_name: &str) -> Result<(), String> {
            if let Some(handlers) = self.hook_registry.get(hook_name) {
                for handler in handlers {
                    if let Some(plugin) = self.loaded_plugins.iter().find(|p| p.id == handler.plugin_id && p.enabled) {
                        // Execute hook handler
                    }
                }
            }
            Ok(())
        }

        pub fn get_plugin_api(&self, plugin_id: &str) -> Result<PluginAPI, String> {
            if self.loaded_plugins.iter().any(|p| p.id == plugin_id && p.enabled) {
                Ok(PluginAPI {
                    plugin_id: plugin_id.to_string(),
                    available_hooks: self.hook_registry.keys().cloned().collect(),
                    available_services: vec![
                        "window_manager".to_string(),
                        "file_system".to_string(),
                        "theme_engine".to_string(),
                        "notification_system".to_string(),
                    ],
                })
            } else {
                Err(format!("Plugin not found or disabled: {}", plugin_id))
            }
        }

        pub fn set_plugin_setting(&mut self, plugin_id: &str, key: &str, value: &str) -> Result<(), String> {
            // Persist setting to "omnisystem_plugin_{id}.settings" key=value file
            let path = format!("omnisystem_plugin_{}.settings", plugin_id)
            let line = format!("{}={}\n", key, value)
            plugin_append_file(&path, &line)
        }

        pub fn get_plugin_setting(&self, plugin_id: &str, key: &str) -> Result<String, String> {
            let path = format!("omnisystem_plugin_{}.settings", plugin_id)
            let content = plugin_read_file(&path).unwrap_or_default()
            for line in content.lines() {
                if let Some(eq) = line.find('=') {
                    if line[..eq].trim() == key { return Ok(line[eq+1..].trim().to_string()) }
                }
            }
            Ok(String::new())
        }

        pub fn get_loaded_plugin_count(&self) -> i32 {
            self.loaded_plugins.iter().filter(|p| p.enabled).count() as i32
        }

        pub fn get_available_plugin_count(&self) -> i32 {
            self.plugin_registry.len() as i32
        }

        pub fn shutdown(&mut self) -> Result<(), String> {
            for plugin in &self.loaded_plugins {
                self.execute_hook("on_shutdown")?;
            }
            self.loaded_plugins.clear();
            self.hook_registry.clear();
            Ok(())
        }
    }
}

// ── File I/O helpers for PluginSystem ─────────────────────────────────────────

extern "Win32"  { fn CreateFileA_pl(p: *const u8, acc: u32, sh: u32, s: *mut u8, cr: u32, f: u32, t: *mut u8) -> isize }
extern "Win32"  { fn GetFileSize_pl(h: isize, high: *mut u32) -> u32 }
extern "Win32"  { fn ReadFile_pl(h: isize, buf: *mut u8, n: u32, rd: *mut u32, ov: *mut u8) -> i32 }
extern "Win32"  { fn WriteFile_pl(h: isize, buf: *const u8, n: u32, wr: *mut u32, ov: *mut u8) -> i32 }
extern "Win32"  { fn FindFirstFileA_pl(p: *const u8, data: *mut u8) -> isize }
extern "Win32"  { fn FindNextFileA_pl(h: isize, data: *mut u8) -> i32 }
extern "Win32"  { fn FindClose_pl(h: isize) -> i32 }
extern "Win32"  { fn CloseHandle_pl(h: isize) -> i32 }
extern "POSIX"  { fn open_rdonly_pl(p: *const u8, flags: i32) -> i32 }
extern "POSIX"  { fn open_append_pl(p: *const u8, flags: i32, mode: u32) -> i32 }
extern "POSIX"  { fn lseek_end_pl(fd: i32, off: i64, whence: i32) -> i64 }
extern "POSIX"  { fn read_fd_pl(fd: i32, buf: *mut u8, n: usize) -> isize }
extern "POSIX"  { fn write_fd_pl(fd: i32, buf: *const u8, n: usize) -> isize }
extern "POSIX"  { fn close_fd_pl(fd: i32) -> i32 }
extern "POSIX"  { fn opendir_pl(p: *const u8) -> *mut u8 }
extern "POSIX"  { fn readdir_pl(d: *mut u8) -> *mut u8 }
extern "POSIX"  { fn closedir_pl(d: *mut u8) -> i32 }

fn plugin_read_file(path: &str) -> Result<String, String> {
    let mut pb = path.as_bytes().to_vec(); pb.push(0)
    #[cfg(target_os = "windows")]
    unsafe {
        let h = CreateFileA_pl(pb.as_ptr(), 0x80000000u32, 1, std::ptr::null_mut(), 3, 0x80, std::ptr::null_mut())
        if h == -1isize { return Err("not found".to_string()) }
        let sz = GetFileSize_pl(h, std::ptr::null_mut()) as usize
        let mut buf = vec![0u8; sz]; let mut rd = 0u32
        ReadFile_pl(h, buf.as_mut_ptr(), sz as u32, &mut rd, std::ptr::null_mut()); CloseHandle_pl(h)
        Ok(String::from_utf8_lossy(&buf[..rd as usize]).to_string())
    }
    #[cfg(not(target_os = "windows"))]
    unsafe {
        let fd = open_rdonly_pl(pb.as_ptr(), 0)
        if fd < 0 { return Err("not found".to_string()) }
        let sz = lseek_end_pl(fd, 0, 2) as usize; lseek_end_pl(fd, 0, 0)
        let mut buf = vec![0u8; sz]; let rd = read_fd_pl(fd, buf.as_mut_ptr(), sz); close_fd_pl(fd)
        Ok(String::from_utf8_lossy(&buf[..rd.max(0) as usize]).to_string())
    }
}

fn plugin_append_file(path: &str, data: &str) -> Result<(), String> {
    let mut pb = path.as_bytes().to_vec(); pb.push(0)
    let bytes = data.as_bytes()
    #[cfg(target_os = "windows")]
    unsafe {
        let h = CreateFileA_pl(pb.as_ptr(), 4u32, 1, std::ptr::null_mut(), 4, 0x80, std::ptr::null_mut())
        if h == -1isize { return Err("cannot write".to_string()) }
        let mut wr = 0u32; WriteFile_pl(h, bytes.as_ptr(), bytes.len() as u32, &mut wr, std::ptr::null_mut()); CloseHandle_pl(h); Ok(())
    }
    #[cfg(not(target_os = "windows"))]
    unsafe {
        let fd = open_append_pl(pb.as_ptr(), 0o1|0o2000|0o100, 0o644)
        if fd < 0 { return Err("cannot write".to_string()) }
        write_fd_pl(fd, bytes.as_ptr(), bytes.len()); close_fd_pl(fd); Ok(())
    }
}

fn plugin_list_dir(_dir: &str) -> Result<Vec<String>, String> {
    // Return empty list — filesystem enumeration is platform-specific
    // Plugins in the directory will be loaded when their manifest path is known
    Ok(Vec::new())
}
