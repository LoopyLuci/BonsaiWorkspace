// Performance Monitor - Metrics, Profiling, and Optimization
// Real-time performance monitoring and analysis
// Language: VERA (UI) + SYLVA (Analytics) + TITAN (Systems)

module PerformanceMonitor {

    pub struct PerformanceMonitor {
        pub name: String,
        pub initialized: bool,
        pub metrics: PerformanceMetrics,
        pub frame_data: Vec<FrameData>,
        pub profiling_enabled: bool,
        pub max_frame_history: i32,
        pub alerts: Vec<PerformanceAlert>,
        pub optimization_suggestions: Vec<String>,
    }

    pub struct PerformanceMetrics {
        pub fps: f32,
        pub average_frame_time: f32,
        pub cpu_usage: f32,
        pub memory_usage: f32,
        pub peak_memory: f32,
        pub garbage_collection_time: f32,
        pub render_time: f32,
        pub update_time: f32,
        pub event_processing_time: f32,
        pub ui_layout_time: f32,
        pub total_frames_rendered: i64,
        pub total_dropped_frames: i64,
        pub uptime_seconds: i64,
    }

    pub struct FrameData {
        pub timestamp: i64,
        pub duration_ms: f32,
        pub cpu_load: f32,
        pub memory_usage: f32,
        pub objects_rendered: i32,
        pub draw_calls: i32,
        pub gc_occurred: bool,
    }

    pub struct PerformanceAlert {
        pub id: String,
        pub alert_type: String, // "fps_drop", "memory_spike", "cpu_high", "lag"
        pub severity: String, // "warning", "critical"
        pub message: String,
        pub timestamp: i64,
        pub value: f32,
        pub threshold: f32,
    }

    pub struct ProfilerSession {
        pub id: String,
        pub name: String,
        pub started_at: i64,
        pub ended_at: i64,
        pub duration_ms: f32,
        pub samples: Vec<ProfilerSample>,
    }

    pub struct ProfilerSample {
        pub timestamp: i64,
        pub function_name: String,
        pub duration_ms: f32,
        pub call_count: i32,
        pub memory_delta: f32,
    }

    pub struct PerformanceReport {
        pub id: String,
        pub generated_at: i64,
        pub summary: ReportSummary,
        pub metrics: PerformanceMetrics,
        pub bottlenecks: Vec<Bottleneck>,
        pub recommendations: Vec<String>,
    }

    pub struct ReportSummary {
        pub average_fps: f32,
        pub peak_fps: f32,
        pub lowest_fps: f32,
        pub frame_time_95th_percentile: f32,
        pub memory_peak: f32,
        pub memory_average: f32,
        pub dropped_frames_percent: f32,
    }

    pub struct Bottleneck {
        pub component: String,
        pub issue: String,
        pub impact: String,
        pub suggestion: String,
    }

    impl PerformanceMonitor {
        pub fn new() -> Self {
            PerformanceMonitor {
                name: "Performance Monitor".to_string(),
                initialized: false,
                metrics: PerformanceMetrics {
                    fps: 60.0,
                    average_frame_time: 16.67,
                    cpu_usage: 0.0,
                    memory_usage: 0.0,
                    peak_memory: 0.0,
                    garbage_collection_time: 0.0,
                    render_time: 0.0,
                    update_time: 0.0,
                    event_processing_time: 0.0,
                    ui_layout_time: 0.0,
                    total_frames_rendered: 0,
                    total_dropped_frames: 0,
                    uptime_seconds: 0,
                },
                frame_data: Vec::new(),
                profiling_enabled: false,
                max_frame_history: 300, // 5 seconds at 60 FPS
                alerts: Vec::new(),
                optimization_suggestions: Vec::new(),
            }
        }

        pub fn initialize(&mut self) -> Result<(), String> {
            println!("    Initializing performance monitor");
            println!("    Setting up metrics collection");
            println!("    Configuring alerts");

            self.setup_alert_thresholds()?;
            self.enable_profiling()?;

            self.initialized = true;

            println!("    ✓ Performance Monitor ready");
            println!("    ✓ Profiling enabled");
            println!("    ✓ Alert system configured");

            Ok(())
        }

        fn setup_alert_thresholds(&mut self) -> Result<(), String> {
            println!("      FPS drop alert threshold: 30 FPS");
            println!("      Memory spike threshold: 80%");
            println!("      CPU usage threshold: 90%");
            Ok(())
        }

        fn enable_profiling(&mut self) -> Result<(), String> {
            self.profiling_enabled = true;
            println!("      Frame profiling enabled");
            println!("      Memory tracking enabled");
            println!("      CPU monitoring enabled");
            Ok(())
        }

        pub fn record_frame(&mut self, duration_ms: f32) -> Result<(), String> {
            let frame = FrameData {
                timestamp: std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_millis() as i64,
                duration_ms,
                cpu_load: 0.0,
                memory_usage: self.metrics.memory_usage,
                objects_rendered: 0,
                draw_calls: 0,
                gc_occurred: false,
            };

            self.frame_data.push(frame);
            if self.frame_data.len() > self.max_frame_history as usize {
                self.frame_data.remove(0);
            }

            self.update_metrics(duration_ms)?;
            self.check_performance_thresholds()?;

            Ok(())
        }

        fn update_metrics(&mut self, frame_duration: f32) -> Result<(), String> {
            if frame_duration <= 0.0 {
                return Ok(());
            }

            let fps = 1000.0 / frame_duration;
            self.metrics.fps = fps;
            self.metrics.average_frame_time = frame_duration;
            self.metrics.total_frames_rendered += 1;

            if fps < 30.0 {
                self.metrics.total_dropped_frames += 1;
            }

            Ok(())
        }

        fn check_performance_thresholds(&mut self) -> Result<(), String> {
            if self.metrics.fps < 30.0 {
                self.create_alert(
                    "fps_drop",
                    "warning",
                    &format!("FPS dropped to {:.1}", self.metrics.fps),
                    self.metrics.fps,
                    30.0,
                )?;
            }

            if self.metrics.memory_usage > 80.0 {
                self.create_alert(
                    "memory_spike",
                    "critical",
                    &format!("Memory usage at {:.1}%", self.metrics.memory_usage),
                    self.metrics.memory_usage,
                    80.0,
                )?;
            }

            Ok(())
        }

        pub fn create_alert(&mut self, alert_type: &str, severity: &str, message: &str, value: f32, threshold: f32) -> Result<String, String> {
            let alert = PerformanceAlert {
                id: format!("alert-{}", std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_millis()),
                alert_type: alert_type.to_string(),
                severity: severity.to_string(),
                message: message.to_string(),
                timestamp: std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_secs() as i64,
                value,
                threshold,
            };

            let alert_id = alert.id.clone();
            self.alerts.push(alert);

            Ok(alert_id)
        }

        pub fn start_profiler_session(&self, name: &str) -> Result<ProfilerSession, String> {
            Ok(ProfilerSession {
                id: format!("profile-{}", std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_millis()),
                name: name.to_string(),
                started_at: std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_secs() as i64,
                ended_at: 0,
                duration_ms: 0.0,
                samples: Vec::new(),
            })
        }

        pub fn record_sample(&mut self, session_id: &str, function_name: &str, duration_ms: f32) -> Result<(), String> {
            let sample = ProfilerSample {
                timestamp: std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_millis() as i64,
                function_name: function_name.to_string(),
                duration_ms,
                call_count: 1,
                memory_delta: 0.0,
            };

            // Persist sample to per-session log file
            let log_path = format!("omnisystem_profiler_{}.log", session_id)
            let log_line = format!("{}\t{}\t{:.3}\t{}\n",
                sample.timestamp, sample.function_name, sample.duration_ms, sample.call_count)
            let _ = perf_append_file(&log_path, &log_line)
            Ok(())
        }

        pub fn generate_performance_report(&self) -> Result<PerformanceReport, String> {
            let (peak_fps, lowest_fps) = self.calculate_fps_range();

            let summary = ReportSummary {
                average_fps: self.metrics.fps,
                peak_fps,
                lowest_fps,
                frame_time_95th_percentile: 0.0,
                memory_peak: self.metrics.peak_memory,
                memory_average: self.metrics.memory_usage,
                dropped_frames_percent: if self.metrics.total_frames_rendered > 0 {
                    (self.metrics.total_dropped_frames as f32 / self.metrics.total_frames_rendered as f32) * 100.0
                } else {
                    0.0
                },
            };

            let bottlenecks = self.identify_bottlenecks();
            let recommendations = self.generate_recommendations(&bottlenecks);

            Ok(PerformanceReport {
                id: format!("report-{}", std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_millis()),
                generated_at: std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_secs() as i64,
                summary,
                metrics: self.metrics.clone(),
                bottlenecks,
                recommendations,
            })
        }

        fn calculate_fps_range(&self) -> (f32, f32) {
            if self.frame_data.is_empty() {
                return (0.0, 0.0);
            }

            let fps_values: Vec<f32> = self.frame_data.iter()
                .map(|f| if f.duration_ms > 0.0 { 1000.0 / f.duration_ms } else { 0.0 })
                .collect();

            let peak = fps_values.iter().cloned().fold(f32::NEG_INFINITY, f32::max);
            let lowest = fps_values.iter().cloned().fold(f32::INFINITY, f32::min);

            (peak, lowest)
        }

        fn identify_bottlenecks(&self) -> Vec<Bottleneck> {
            let mut bottlenecks = Vec::new();

            if self.metrics.fps < 30.0 {
                bottlenecks.push(Bottleneck {
                    component: "Rendering".to_string(),
                    issue: "Low FPS detected".to_string(),
                    impact: "Impacts user experience".to_string(),
                    suggestion: "Reduce draw calls, optimize shaders".to_string(),
                });
            }

            if self.metrics.memory_usage > 80.0 {
                bottlenecks.push(Bottleneck {
                    component: "Memory".to_string(),
                    issue: "High memory usage".to_string(),
                    impact: "Risk of system slowdown".to_string(),
                    suggestion: "Profile memory allocations, enable garbage collection".to_string(),
                });
            }

            if self.metrics.render_time > self.metrics.average_frame_time * 0.8 {
                bottlenecks.push(Bottleneck {
                    component: "Rendering".to_string(),
                    issue: "Render time exceeds frame budget".to_string(),
                    impact: "Frame drops likely".to_string(),
                    suggestion: "Optimize render pipeline, batch operations".to_string(),
                });
            }

            bottlenecks
        }

        fn generate_recommendations(&self, bottlenecks: &[Bottleneck]) -> Vec<String> {
            let mut recommendations = vec!["Monitor performance regularly".to_string()];

            for bottleneck in bottlenecks {
                recommendations.push(bottleneck.suggestion.clone());
            }

            if self.metrics.total_frames_rendered > 1000 {
                recommendations.push("Analyze performance trends over time".to_string());
            }

            recommendations
        }

        pub fn get_metrics(&self) -> PerformanceMetrics {
            self.metrics.clone()
        }

        pub fn get_recent_alerts(&self) -> Vec<PerformanceAlert> {
            self.alerts.iter().rev().take(10).cloned().collect()
        }

        pub fn clear_alerts(&mut self) -> Result<(), String> {
            self.alerts.clear();
            Ok(())
        }

        pub fn shutdown(&mut self) -> Result<(), String> {
            let _ = self.generate_performance_report();
            self.frame_data.clear();
            self.alerts.clear();
            Ok(())
        }
    }

    impl Clone for PerformanceMetrics {
        fn clone(&self) -> Self {
            PerformanceMetrics {
                fps: self.fps,
                average_frame_time: self.average_frame_time,
                cpu_usage: self.cpu_usage,
                memory_usage: self.memory_usage,
                peak_memory: self.peak_memory,
                garbage_collection_time: self.garbage_collection_time,
                render_time: self.render_time,
                update_time: self.update_time,
                event_processing_time: self.event_processing_time,
                ui_layout_time: self.ui_layout_time,
                total_frames_rendered: self.total_frames_rendered,
                total_dropped_frames: self.total_dropped_frames,
                uptime_seconds: self.uptime_seconds,
            }
        }
    }

    impl Clone for PerformanceAlert {
        fn clone(&self) -> Self {
            PerformanceAlert {
                id: self.id.clone(),
                alert_type: self.alert_type.clone(),
                severity: self.severity.clone(),
                message: self.message.clone(),
                timestamp: self.timestamp,
                value: self.value,
                threshold: self.threshold,
            }
        }
    }
}

// ── File append helper for PerformanceMonitor profiling ───────────────────────

extern "Win32"  { fn CreateFileA_perf(p: *const u8, acc: u32, sh: u32, s: *mut u8, cr: u32, f: u32, t: *mut u8) -> isize }
extern "Win32"  { fn WriteFile_perf(h: isize, buf: *const u8, n: u32, wr: *mut u32, ov: *mut u8) -> i32 }
extern "Win32"  { fn CloseHandle_perf(h: isize) -> i32 }
extern "POSIX"  { fn open_append_perf(p: *const u8, flags: i32, mode: u32) -> i32 }
extern "POSIX"  { fn write_fd_perf(fd: i32, buf: *const u8, n: usize) -> isize }
extern "POSIX"  { fn close_fd_perf(fd: i32) -> i32 }

fn perf_append_file(path: &str, line: &str) -> Result<(), String> {
    let mut pb = path.as_bytes().to_vec(); pb.push(0)
    let data = line.as_bytes()
    #[cfg(target_os = "windows")]
    unsafe {
        let h = CreateFileA_perf(pb.as_ptr(), 4u32, 1, std::ptr::null_mut(), 4, 0x80, std::ptr::null_mut())
        if h == -1isize { return Err("cannot open".to_string()) }
        let mut wr = 0u32; WriteFile_perf(h, data.as_ptr(), data.len() as u32, &mut wr, std::ptr::null_mut()); CloseHandle_perf(h); Ok(())
    }
    #[cfg(not(target_os = "windows"))]
    unsafe {
        let fd = open_append_perf(pb.as_ptr(), 0o1|0o2000|0o100, 0o644)
        if fd < 0 { return Err("cannot open".to_string()) }
        write_fd_perf(fd, data.as_ptr(), data.len()); close_fd_perf(fd); Ok(())
    }
}
