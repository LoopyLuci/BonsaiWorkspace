        pub fn get_all_applications(&self) -> Vec<DesktopApplication> {
            self.applications.clone()
        }

        pub fn get_pinned_applications(&self) -> Vec<DesktopApplication> {
            self.applications.iter()
                .filter(|app| app.pinned)
                .cloned()
                .collect()
        }

        pub fn get_applications_by_category(&self, category: &str) -> Vec<DesktopApplication> {
            self.applications.iter()
                .filter(|app| app.category == category)
                .cloned()
                .collect()
        }

        pub fn get_categories(&self) -> Vec<String> {
            let mut categories = Vec::new();
            for app in &self.applications {
                if !categories.contains(&app.category) {
                    categories.push(app.category.clone());
                }
            }
            categories.sort();
            categories
        }

        pub fn launch_application(&self, app_id: &str) -> Result<String, String> {
            if let Some(app) = self.applications.iter().find(|a| a.id == app_id) {
                println!("\n🚀 Launching: {}", app.name);
                println!("   Description: {}", app.description);
                println!("   Version: {}", app.version);
                println!("   Languages: {}", app.languages_used.join(", "));
                println!("   Features:");
                for feature in &app.features {
                    println!("      • {}", feature);
                }
                println!("\n✓ {} started successfully\n", app.name);
                Ok(format!("Application {} launched", app.name))
            } else {
                Err(format!("Application not found: {}", app_id))
            }
        }

        pub fn get_application_count(&self) -> i32 {
            self.applications.len() as i32
        }

        pub fn search_applications(&self, query: &str) -> Vec<DesktopApplication> {
            let query_lower = query.to_lowercase();
            self.applications.iter()
                .filter(|app| {
                    app.name.to_lowercase().contains(&query_lower) ||
                    app.description.to_lowercase().contains(&query_lower) ||
                    app.features.iter().any(|f| f.to_lowercase().contains(&query_lower))
                })
                .cloned()
                .collect()
        }
    }

    impl Clone for DesktopApplication {
        fn clone(&self) -> Self {
            DesktopApplication {
                id: self.id.clone(),
                name: self.name.clone(),
                description: self.description.clone(),
                icon: self.icon.clone(),
                executable: self.executable.clone(),
                category: self.category.clone(),
                version: self.version.clone(),
                author: self.author.clone(),
                features: self.features.clone(),
                languages_used: self.languages_used.clone(),
                pinned: self.pinned,
            }
        }
    }
}
