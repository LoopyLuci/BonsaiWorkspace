// Omnisystem API Gateway - Request routing, rate limiting, authentication
use std::collections::HashMap;

pub struct APIGateway {
    id: String,
    theme: Theme,
    routes: Vec<Route>,
    rate_limits: HashMap<String, RateLimit>,
    current_view: GatewayView,
}

impl APIGateway {
    pub fn new(asset_manager: AssetManager) -> Self {
        Self {
            id: "api-gateway".to_string(),
            theme: asset_manager.get_current_theme(),
            routes: Self::load_routes(),
            rate_limits: HashMap::new(),
            current_view: GatewayView::Overview,
        }
    }

    pub fn render(&self) -> Widget {
        ApplicationWindow {
            id: "api-gateway".to_string(),
            title: "API Gateway".to_string(),
            width: 1600,
            height: 900,
            children: vec![
                Panel {
                    height: 60.0,
                    padding: 16.0,
                    background_color: self.theme.colors.primary,
                    border_bottom: true,
                    children: vec![Row { spacing: 16.0, children: vec![
                        Label { text: "API Gateway".to_string(), font_size: 18.0, font_weight: 700, color: self.theme.colors.white },
                        Spacer {},
                        Badge { label: format!("{} Routes", self.routes.len()) },
                    ]}],
                },
                Panel {
                    padding: 20.0,
                    background_color: self.theme.colors.background,
                    children: vec![
                        Label { text: "API Routes".to_string(), font_size: 16.0, font_weight: 700 },
                        Column { spacing: 8.0, children: self.routes.iter().map(|r| {
                            Panel { padding: 12.0, background_color: self.theme.colors.surface, border: true, children: vec![
                                Label { text: format!("{} {}", r.method, r.path), font_size: 12.0, font_weight: 700 },
                            ]}
                        }).collect() },
                    ],
                },
            ],
        }
    }

    fn load_routes() -> Vec<Route> {
        vec![
            Route { method: "GET".to_string(), path: "/api/system/status".to_string() },
            Route { method: "POST".to_string(), path: "/api/services/start".to_string() },
        ]
    }
}

#[derive(Clone, Copy, Debug)]
pub enum GatewayView { Overview, Routes, RateLimits, Logs }

#[derive(Clone, Debug)]
pub struct Route {
    method: String,
    path: String,
}

#[derive(Clone, Debug)]
pub struct RateLimit {
    requests_per_second: u32,
    burst_size: u32,
}

pub static API_GATEWAY_STATE: LazyStatic<Mutex<APIGateway>> =
    LazyStatic::new(|| Mutex::new(APIGateway::new(AssetManager::global())));
