// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════
// OMNISYSTEM CONTAINER REGISTRY - CONTAINER IMAGE STORAGE & MANAGEMENT
// Image storage, tagging, versioning, garbage collection, push/pull, signature verification
// Language: AETHER (Distributed Systems)
// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════

module ContainerRegistry {
    use std::collections::HashMap;

    pub struct ContainerRegistry {
        pub registry_id: String,
        pub storage_path: String,
        pub images: HashMap<String, ContainerImage>,
        pub repositories: HashMap<String, Repository>,
        pub access_control: RegistryAccessControl,
        pub garbage_collector: GarbageCollector,
        pub signature_verifier: SignatureVerifier,
        pub replication_config: ReplicationConfig,
    }

    pub struct ContainerImage {
        pub image_id: String,
        pub repository: String,
        pub tags: Vec<String>,
        pub digest: String,
        pub config_digest: String,
        pub layers: Vec<ImageLayer>,
        pub size_bytes: u64,
        pub created_at: u64,
        pub updated_at: u64,
        pub manifest: ImageManifest,
        pub signature: Option<ImageSignature>,
    }

    pub struct ImageLayer {
        pub layer_id: String,
        pub digest: String,
        pub size_bytes: u64,
        pub media_type: String,
        pub compressed: bool,
        pub compression_algorithm: String,
        pub created_by: String,
    }

    pub struct ImageManifest {
        pub manifest_id: String,
        pub schema_version: u32,
        pub media_type: String,
        pub config: ManifestConfig,
        pub layers: Vec<ManifestLayer>,
    }

    pub struct ManifestConfig {
        pub digest: String,
        pub size: u64,
        pub media_type: String,
    }

    pub struct ManifestLayer {
        pub digest: String,
        pub size: u64,
        pub media_type: String,
    }

    pub struct ImageSignature {
        pub signature_id: String,
        pub algorithm: SignatureAlgorithm,
        pub signature_data: Vec<u8>,
        pub certificate: String,
        pub valid: bool,
    }

    #[derive(Clone, Copy, Debug)]
    pub enum SignatureAlgorithm {
        RSA2048,
        RSA4096,
        ECDSA256,
        ECDSA384,
    }

    pub struct Repository {
        pub repo_id: String,
        pub name: String,
        pub namespace: String,
        pub description: String,
        pub images: Vec<String>,
        pub pull_count: u64,
        pub push_count: u64,
        pub star_count: u32,
        pub private: bool,
        pub tags: HashMap<String, String>, // tag -> digest
    }

    pub struct RegistryAccessControl {
        pub access_id: String,
        pub users: HashMap<String, RegistryUser>,
        pub tokens: HashMap<String, RegistryToken>,
        pub policies: Vec<AccessPolicy>,
    }

    pub struct RegistryUser {
        pub user_id: String,
        pub username: String,
        pub password_hash: String,
        pub roles: Vec<String>,
        pub created_at: u64,
        pub last_login: u64,
    }

    pub struct RegistryToken {
        pub token_id: String,
        pub user_id: String,
        pub scopes: Vec<String>,
        pub created_at: u64,
        pub expires_at: u64,
        pub is_valid: bool,
    }

    pub struct AccessPolicy {
        pub policy_id: String,
        pub user_id: String,
        pub repository: String,
        pub actions: Vec<String>, // push, pull, delete, etc.
        pub effect: PolicyEffect,
    }

    #[derive(Clone, Copy, Debug)]
    pub enum PolicyEffect {
        Allow,
        Deny,
    }

    pub struct GarbageCollector {
        pub gc_id: String,
        pub enabled: bool,
        pub schedule_hours: u32,
        pub retention_days: u32,
        pub last_run: u64,
        pub unreferenced_blobs: Vec<String>,
    }

    pub struct SignatureVerifier {
        pub verifier_id: String,
        pub trusted_keys: HashMap<String, TrustedKey>,
        pub verification_enabled: bool,
    }

    pub struct TrustedKey {
        pub key_id: String,
        pub key_type: String,
        pub fingerprint: String,
        pub expiry: u64,
    }

    pub struct ReplicationConfig {
        pub replication_id: String,
        pub enabled: bool,
        pub source_registry: String,
        pub target_registries: Vec<String>,
        pub replication_rules: Vec<ReplicationRule>,
        pub last_sync: u64,
    }

    pub struct ReplicationRule {
        pub rule_id: String,
        pub source_pattern: String,
        pub target_namespace: String,
        pub delete_src: bool,
    }

    pub struct RegistryStatistics {
        pub total_images: u64,
        pub total_size_bytes: u64,
        pub total_downloads: u64,
        pub total_uploads: u64,
        pub average_image_size_bytes: u64,
    }

    pub struct BlobStore {
        pub store_id: String,
        pub blobs: HashMap<String, BlobMetadata>,
        pub storage_path: String,
        pub total_size_bytes: u64,
        pub max_size_bytes: u64,
    }

    pub struct BlobMetadata {
        pub blob_id: String,
        pub digest: String,
        pub size_bytes: u64,
        pub content_type: String,
        pub created_at: u64,
        pub reference_count: u32,
    }

    impl ContainerRegistry {
        pub fn new(storage_path: &str) -> Self {
            ContainerRegistry {
                registry_id: "registry-1".to_string(),
                storage_path: storage_path.to_string(),
                images: HashMap::new(),
                repositories: HashMap::new(),
                access_control: RegistryAccessControl {
                    access_id: "ac-1".to_string(),
                    users: HashMap::new(),
                    tokens: HashMap::new(),
                    policies: Vec::new(),
                },
                garbage_collector: GarbageCollector {
                    gc_id: "gc-1".to_string(),
                    enabled: true,
                    schedule_hours: 24,
                    retention_days: 30,
                    last_run: 0,
                    unreferenced_blobs: Vec::new(),
                },
                signature_verifier: SignatureVerifier {
                    verifier_id: "sv-1".to_string(),
                    trusted_keys: HashMap::new(),
                    verification_enabled: true,
                },
                replication_config: ReplicationConfig {
                    replication_id: "repl-1".to_string(),
                    enabled: false,
                    source_registry: String::new(),
                    target_registries: Vec::new(),
                    replication_rules: Vec::new(),
                    last_sync: 0,
                },
            }
        }

        pub fn create_repository(&mut self, name: &str, namespace: &str, private: bool) -> Result<String, String> {
            let repo_id = format!("repo_{}", hash_string(&format!("{}/{}", namespace, name)));

            let repo = Repository {
                repo_id: repo_id.clone(),
                name: name.to_string(),
                namespace: namespace.to_string(),
                description: String::new(),
                images: Vec::new(),
                pull_count: 0,
                push_count: 0,
                star_count: 0,
                private,
                tags: HashMap::new(),
            };

            self.repositories.insert(repo_id.clone(), repo);
            println!("Created repository: {}/{}", namespace, name);
            Ok(repo_id)
        }

        pub fn push_image(&mut self, repository: &str, tag: &str, image_data: &[u8]) -> Result<String, String> {
            let digest = format!("sha256:{}", hash_string(&format!("{}{}", repository, tag)));
            let image_id = format!("img_{}", hash_string(&digest));

            let image = ContainerImage {
                image_id: image_id.clone(),
                repository: repository.to_string(),
                tags: vec![tag.to_string()],
                digest: digest.clone(),
                config_digest: format!("sha256:{}", hash_string(&digest)),
                layers: vec![
                    ImageLayer {
                        layer_id: format!("layer_0"),
                        digest: format!("sha256:{}", hash_string(&format!("{}:{}", repository, tag))),
                        size_bytes: image_data.len() as u64,
                        media_type: "application/vnd.docker.image.rootfs.diff.tar.gzip".to_string(),
                        compressed: true,
                        compression_algorithm: "gzip".to_string(),
                        created_by: "omnisystem".to_string(),
                    },
                ],
                size_bytes: image_data.len() as u64,
                created_at: current_timestamp(),
                updated_at: current_timestamp(),
                manifest: ImageManifest {
                    manifest_id: format!("manifest_{}", hash_string(&digest)),
                    schema_version: 2,
                    media_type: "application/vnd.docker.distribution.manifest.v2+json".to_string(),
                    config: ManifestConfig {
                        digest: format!("sha256:{}", hash_string(&"config")),
                        size: 7023,
                        media_type: "application/vnd.docker.container.image.v1+json".to_string(),
                    },
                    layers: vec![ManifestLayer {
                        digest: format!("sha256:{}", hash_string(&format!("{}:{}", repository, tag))),
                        size: image_data.len() as u64,
                        media_type: "application/vnd.docker.image.rootfs.diff.tar.gzip".to_string(),
                    }],
                },
                signature: None,
            };

            self.images.insert(image_id.clone(), image);
            println!("Pushed image: {}:{}", repository, tag);
            Ok(image_id)
        }

        pub fn pull_image(&self, repository: &str, tag: &str) -> Result<(String, Vec<u8>), String> {
            for (_, img) in &self.images {
                if img.repository == repository && img.tags.contains(&tag.to_string()) {
                    println!("Pulled image: {}:{}", repository, tag);
                    return Ok((img.image_id.clone(), vec![0u8; img.size_bytes as usize]));
                }
            }
            Err("Image not found".to_string())
        }

        pub fn tag_image(&mut self, image_id: &str, new_tag: &str) -> Result<(), String> {
            if let Some(image) = self.images.get_mut(image_id) {
                if !image.tags.contains(&new_tag.to_string()) {
                    image.tags.push(new_tag.to_string());
                    println!("Tagged image: {} -> {}", image_id, new_tag);
                    Ok(())
                } else {
                    Err("Tag already exists".to_string())
                }
            } else {
                Err("Image not found".to_string())
            }
        }

        pub fn delete_image(&mut self, repository: &str, tag: &str) -> Result<(), String> {
            if let Some((id, _)) = self.images.iter().find(|(_, img)| img.repository == repository && img.tags.contains(&tag.to_string())).map(|(k, v)| (k.clone(), v)) {
                self.images.remove(&id);
                println!("Deleted image: {}:{}", repository, tag);
                Ok(())
            } else {
                Err("Image not found".to_string())
            }
        }

        pub fn add_user(&mut self, username: &str, password_hash: &str) -> Result<String, String> {
            let user_id = format!("user_{}", hash_string(username));

            let user = RegistryUser {
                user_id: user_id.clone(),
                username: username.to_string(),
                password_hash: password_hash.to_string(),
                roles: vec!["user".to_string()],
                created_at: current_timestamp(),
                last_login: 0,
            };

            self.access_control.users.insert(user_id.clone(), user);
            println!("Added registry user: {}", username);
            Ok(user_id)
        }

        pub fn get_registry_stats(&self) -> String {
            let total_size: u64 = self.images.iter().map(|(_, img)| img.size_bytes).sum();
            format!(
                "Container Registry\nImages: {}\nRepositories: {}\nTotal Size: {} MB\nUsers: {}",
                self.images.len(),
                self.repositories.len(),
                total_size / 1024 / 1024,
                self.access_control.users.len()
            )
        }
    }

    fn hash_string(s: &str) -> String {
        let mut hash: u64 = 5381;
        for c in s.chars() {
            hash = ((hash << 5).wrapping_add(hash)).wrapping_add(c as u64);
        }
        format!("{:x}", hash).chars().take(16).collect()
    }

    fn current_timestamp() -> u64 {
        std::time::SystemTime::now()
            .duration_since(std::time::UNIX_EPOCH)
            .unwrap_or_default()
            .as_secs()
    }

    pub fn main() {
        println!("╔═══════════════════════════════════════════════════════════════╗");
        println!("║    OMNISYSTEM CONTAINER REGISTRY v3.0.0                      ║");
        println!("║   Container Image Storage & Management                        ║");
        println!("╚═══════════════════════════════════════════════════════════════╝\n");

        let mut registry = ContainerRegistry::new("/var/lib/omnisystem/registry");

        let _ = registry.create_repository("omnisystem", "library", false);
        let _ = registry.create_repository("web-app", "mycompany", true);
        let _ = registry.add_user("alice", "hashed_password");
        let _ = registry.push_image("library/omnisystem", "latest", &vec![0u8; 1024 * 1024 * 100]); // 100MB
        let _ = registry.push_image("mycompany/web-app", "v1.0.0", &vec![0u8; 1024 * 1024 * 250]); // 250MB
        let _ = registry.tag_image("img_0", "stable");
        let _ = registry.pull_image("library/omnisystem", "latest");

        println!("\n{}", registry.get_registry_stats());
    }
}
