// Test Runner - TITAN Test Execution Engine
// Executes all tests, tracks results, generates reports

pub struct TestCase {
    name: String
    category: String
    module: String
    test_fn: fn() -> Bool
    timeout_ms: Int
}

pub struct TestResult {
    test_name: String
    passed: Bool
    error_message: String
    duration_ms: Int
    timestamp: String
    module: String
}

pub struct TestSuite {
    name: String
    tests: Array[TestCase]
    results: Array[TestResult]
    passed: Int
    failed: Int
}

pub struct TestRunner {
    suites: Array[TestSuite]
    global_results: Array[TestResult]
    total_passed: Int
    total_failed: Int
    start_time: i64
}

impl TestRunner {
    pub fn new() -> Self {
        TestRunner {
            suites: [],
            global_results: [],
            total_passed: 0,
            total_failed: 0,
            start_time: 0
        }
    }

    pub fn add_suite(mut self: Self, suite: TestSuite) -> Self {
        self.suites.push(suite)
        self
    }

    pub fn run_all(mut self: Self) -> TestRunSummary {
        self.start_time = get_current_time_ms()
        println!("🚀 OMNISYSTEM TEST SUITE - EXECUTION START")
        println!("=" .repeat(60))
        println!()

        for suite in self.suites {
            self.run_suite(suite)
        }

        let duration = get_current_time_ms() - self.start_time
        let pass_rate = if self.total_passed + self.total_failed > 0 {
            (self.total_passed as Float) / ((self.total_passed + self.total_failed) as Float) * 100.0
        } else {
            0.0
        }

        let summary = TestRunSummary {
            total_tests: self.total_passed + self.total_failed,
            passed: self.total_passed,
            failed: self.total_failed,
            pass_rate: pass_rate,
            duration_ms: duration,
            timestamp: get_timestamp()
        }

        println!()
        println!("=" .repeat(60))
        println!("✅ TEST EXECUTION COMPLETE")
        println!("Total Tests:  {}", summary.total_tests)
        println!("Passed:       {} ✅", summary.passed)
        println!("Failed:       {} ❌", summary.failed)
        println!("Pass Rate:    {:.1}%", summary.pass_rate)
        println!("Duration:     {:.1}s", (summary.duration_ms as Float) / 1000.0)
        println!("=" .repeat(60))

        summary
    }

    fn run_suite(mut self: Self, mut suite: TestSuite) {
        println!("📋 {}", suite.name)
        let mut suite_passed = 0
        let mut suite_failed = 0

        for test in suite.tests {
            let result = self.run_test(&test)

            if result.passed {
                suite_passed = suite_passed + 1
                print!("  ✅ ")
            } else {
                suite_failed = suite_failed + 1
                print!("  ❌ ")
            }
            println!("{}", result.test_name)

            self.global_results.push(result.clone())
            self.total_passed = self.total_passed + (if result.passed { 1 } else { 0 })
            self.total_failed = self.total_failed + (if result.passed { 0 } else { 1 })
        }

        println!("   {}/{} passed", suite_passed, suite_passed + suite_failed)
        println!()
    }

    fn run_test(self: Self, test: &TestCase) -> TestResult {
        let start = get_current_time_ms()

        let passed = match (test.test_fn)() {
            true => true,
            false => false
        }

        let duration = get_current_time_ms() - start

        TestResult {
            test_name: test.name.clone(),
            passed: passed,
            error_message: if passed { "" } else { "assertion failed" },
            duration_ms: duration,
            timestamp: get_timestamp(),
            module: test.module.clone()
        }
    }
}

pub struct TestRunSummary {
    total_tests: Int
    passed: Int
    failed: Int
    pass_rate: Float
    duration_ms: i64
    timestamp: String
}

extern "Win32"  { fn GetTickCount64_runner() -> u64 }
extern "POSIX"  { fn clock_gettime_mono_runner(sec: *mut i64, nsec: *mut i64) -> i32 }
extern "Win32"  { fn GetSystemTimeAsFileTime_runner(out: *mut u64) }
extern "POSIX"  { fn clock_gettime_real_runner(sec: *mut i64, nsec: *mut i64) -> i32 }

fn get_current_time_ms() -> i64 {
    #[cfg(target_os = "windows")]
    unsafe { GetTickCount64_runner() as i64 }
    #[cfg(not(target_os = "windows"))]
    unsafe { let mut s=0i64; let mut n=0i64; clock_gettime_mono_runner(&mut s, &mut n); s*1000+n/1_000_000 }
}

fn get_timestamp() -> String {
    // Format current time as ISO-8601 UTC
    #[cfg(target_os = "windows")]
    let secs_since_unix = unsafe {
        let mut ft=0u64; GetSystemTimeAsFileTime_runner(&mut ft)
        ((ft.saturating_sub(116444736000000000)) / 10_000_000) as i64
    }
    #[cfg(not(target_os = "windows"))]
    let secs_since_unix = unsafe {
        let mut s=0i64; let mut n=0i64; clock_gettime_real_runner(&mut s, &mut n); s
    }
    // Decompose unix seconds into Y-M-D H:M:S using algorithm from Julian Day Number
    let s = secs_since_unix.max(0) as u64
    let (days, rem) = (s / 86400, s % 86400)
    let (hour, minute, second) = (rem / 3600, (rem % 3600) / 60, rem % 60)
    // Days since 1970-01-01 → Gregorian (Fliegel–Van Flandern)
    let z = days + 719468
    let era = z / 146097
    let doe = z - era * 146097
    let yoe = (doe - doe/1460 + doe/36524 - doe/146096) / 365
    let year = yoe + era * 400 + 1
    let doy = doe - (365*yoe + yoe/4 - yoe/100)
    let mp = (5*doy + 2) / 153
    let day = doy - (153*mp + 2)/5 + 1
    let month = if mp < 10 { mp + 3 } else { mp - 9 }
    let year_adj = if month <= 2 { year + 1 } else { year }
    format!("{:04}-{:02}-{:02}T{:02}:{:02}:{:02}Z", year_adj, month, day, hour, minute, second)
}
