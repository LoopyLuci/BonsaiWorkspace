// Integration Tests - Verify all modules load and communicate
// Version: 29.0.0

module omnisystem.tests.integration {
    import omnisystem.integration
    import omnisystem.modules.connector_gateway
    import omnisystem.modules.module_loader

    pub fn test_module_loading() -> Result<(), String> {
        println!("Test: Module Loading");
        
        let mut loader = omnisystem::modules::module_loader::ModuleLoader::new("/registry".to_string());
        
        loader.load_module("titan".to_string(), "systems".to_string())?;
        loader.load_module("sylva".to_string(), "ml".to_string())?;
        loader.load_module("aether".to_string(), "distributed".to_string())?;
        loader.load_module("vera".to_string(), "web".to_string())?;
        loader.load_module("helix".to_string(), "graphics".to_string())?;
        loader.load_module("nexus".to_string(), "mobile".to_string())?;
        
        let modules = loader.list_loaded_modules();
        println!("  ✅ Loaded {} modules", modules.len());
        
        if modules.len() == 6 {
            Ok(())
        } else {
            Err("Not all modules loaded".to_string())
        }
    }

    pub fn test_service_registration() -> Result<(), String> {
        println!("Test: Service Registration");
        
        let mut gateway = omnisystem::modules::connector_gateway::ConnectorGateway::new();
        
        let service = omnisystem::modules::connector_gateway::Service {
            name: "test_service".to_string(),
            language: "titan".to_string(),
            methods: vec!["test_method".to_string()],
            status: "ready".to_string(),
        };
        
        gateway.registry.register_service(service);
        
        if let Some(_svc) = gateway.registry.find_service("test_service") {
            println!("  ✅ Service registered and found");
            Ok(())
        } else {
            Err("Service not found".to_string())
        }
    }

    pub fn test_message_sending() -> Result<(), String> {
        println!("Test: Message Sending");
        
        let mut gateway = omnisystem::modules::connector_gateway::ConnectorGateway::new();
        
        let msg = omnisystem::modules::connector_gateway::Message {
            message_type: "request".to_string(),
            source_language: "vera".to_string(),
            target_language: "titan".to_string(),
            method_name: "test_method".to_string(),
            parameters: vec![],
            message_id: "msg_001".to_string(),
        };
        
        gateway.send_message(msg)?;
        println!("  ✅ Message queued successfully");
        
        if gateway.message_queue.len() == 1 {
            Ok(())
        } else {
            Err("Message not queued".to_string())
        }
    }

    pub fn run_all_tests() -> Result<(), String> {
        println!("\n═══════════════════════════════════════════════════");
        println!("Running Omnisystem Integration Tests");
        println!("═══════════════════════════════════════════════════\n");
        
        test_module_loading()?;
        test_service_registration()?;
        test_message_sending()?;
        
        println!("\n═══════════════════════════════════════════════════");
        println!("✅ All integration tests passed!");
        println!("═══════════════════════════════════════════════════\n");
        
        Ok(())
    }
}
