// Omnisystem Test Runner - Execute and manage automated tests
pub struct TestRunner {
    id: String,
    theme: Theme,
    test_suites: Vec<TestSuite>,
    results: Vec<TestResult>,
}

impl TestRunner {
    pub fn new(asset_manager: AssetManager) -> Self {
        Self {
            id: "testing".to_string(),
            theme: asset_manager.get_current_theme(),
            test_suites: vec![],
            results: vec![],
        }
    }

    pub fn render(&self) -> Widget {
        ApplicationWindow {
            id: "testing".to_string(),
            title: "Test Runner".to_string(),
            width: 1400,
            height: 800,
            children: vec![
                Panel { height: 60.0, padding: 16.0, background_color: self.theme.colors.primary, border_bottom: true, children: vec![
                    Label { text: "Test Runner".to_string(), font_size: 18.0, font_weight: 700, color: self.theme.colors.white },
                ]},
            ],
        }
    }
}

#[derive(Clone, Debug)]
pub struct TestSuite {
    name: String,
    tests: Vec<String>,
    status: String,
}

#[derive(Clone, Debug)]
pub struct TestResult {
    test_name: String,
    status: String,
    duration_ms: f32,
}

pub static TEST_RUNNER_STATE: LazyStatic<Mutex<TestRunner>> =
    LazyStatic::new(|| Mutex::new(TestRunner::new(AssetManager::global())));
