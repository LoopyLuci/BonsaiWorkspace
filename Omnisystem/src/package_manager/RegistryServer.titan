// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// OMNISYSTEM PACKAGE REGISTRY SERVER
// Central repository for package management with search, discovery, and versioning
// Language: TITAN
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

use std::collections::HashMap;

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// REGISTRY DATA STRUCTURES
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

pub struct RegistryPackage {
    id: String,
    name: String,
    latest_version: String,
    all_versions: Vec<String>,
    downloads: u64,
    rating: f32,
    description: String,
    language: String,
    author: String,
    license: String,
    homepage: String,
    repository: String,
    documentation: String,
    keywords: Vec<String>,
    categories: Vec<String>,
    created_at: String,
    last_updated: String,
}

impl RegistryPackage {
    pub fn new(
        name: String,
        version: String,
        description: String,
        language: String,
        author: String,
    ) -> Self {
        RegistryPackage {
            id: format!("{}/{}", language.to_lowercase(), name),
            name,
            latest_version: version.clone(),
            all_versions: vec![version],
            downloads: 0,
            rating: 5.0,
            description,
            language,
            author,
            license: "MIT".to_string(),
            homepage: "".to_string(),
            repository: "".to_string(),
            documentation: "".to_string(),
            keywords: vec![],
            categories: vec![],
            created_at: "2026-06-28".to_string(),
            last_updated: "2026-06-28".to_string(),
        }
    }
}

pub struct RegistryStats {
    total_packages: u64,
    total_downloads: u64,
    total_authors: u64,
    growth_rate: f32,
}

impl RegistryStats {
    pub fn new() -> Self {
        RegistryStats {
            total_packages: 0,
            total_downloads: 0,
            total_authors: 0,
            growth_rate: 0.15,  // 15% monthly growth
        }
    }
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// PACKAGE REGISTRY
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

pub struct PackageRegistry {
    packages: HashMap<String, RegistryPackage>,
    stats: RegistryStats,
    search_index: HashMap<String, Vec<String>>,  // keyword -> package IDs
}

impl PackageRegistry {
    pub fn new() -> Self {
        PackageRegistry {
            packages: HashMap::new(),
            stats: RegistryStats::new(),
            search_index: HashMap::new(),
        }
    }

    pub fn register_package(&mut self, pkg: RegistryPackage) -> Result<(), String> {
        let pkg_id = pkg.id.clone()

        if self.packages.contains_key(&pkg_id) {
            return Err(format!("Package already exists: {}", pkg_id))
        }

        // Index keywords
        for keyword in &pkg.keywords {
            let key = keyword.to_lowercase()
            self.search_index
                .entry(key)
                .or_insert_with(Vec::new)
                .push(pkg_id.clone())
        }

        self.packages.insert(pkg_id, pkg)
        self.stats.total_packages += 1
        Ok(())
    }

    pub fn search(&self, query: &str) -> Vec<String> {
        let query_lower = query.to_lowercase()
        let mut results = Vec::new()

        // Keyword search
        if let Some(keyword_matches) = self.search_index.get(&query_lower) {
            results.extend(keyword_matches.clone())
        }

        // Name substring search
        for (id, pkg) in &self.packages {
            if pkg.name.to_lowercase().contains(&query_lower) && !results.contains(id) {
                results.push(id.clone())
            }
        }

        // Description search
        for (id, pkg) in &self.packages {
            if pkg.description.to_lowercase().contains(&query_lower) && !results.contains(id) {
                results.push(id.clone())
            }
        }

        results
    }

    pub fn lookup(&self, package_id: &str) -> Option<&RegistryPackage> {
        self.packages.get(package_id)
    }

    pub fn get_by_name(&self, name: &str, language: &str) -> Option<&RegistryPackage> {
        let full_id = format!("{}/{}", language.to_lowercase(), name)
        self.packages.get(&full_id)
    }

    pub fn list_packages(&self) -> Vec<String> {
        self.packages.keys().cloned().collect()
    }

    pub fn record_download(&mut self, package_id: &str) -> Result<(), String> {
        if let Some(pkg) = self.packages.get_mut(package_id) {
            pkg.downloads += 1
            self.stats.total_downloads += 1
            Ok(())
        } else {
            Err(format!("Package not found: {}", package_id))
        }
    }

    pub fn get_stats(&self) -> (&RegistryStats) {
        &self.stats
    }
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// HTTP REGISTRY SERVER
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

pub struct RegistryServer {
    registry: PackageRegistry,
    port: u16,
    base_url: String,
}

impl RegistryServer {
    pub fn new(port: u16) -> Self {
        RegistryServer {
            registry: PackageRegistry::new(),
            port,
            base_url: format!("http://localhost:{}", port),
        }
    }

    pub fn startup(&mut self) -> Result<(), String> {
        println!("╔════════════════════════════════════════════════════════════════════════════════╗");
        println!("║  OMNISYSTEM PACKAGE REGISTRY SERVER                                           ║");
        println!("║  Central Package Repository v1.0                                              ║");
        println!("╚════════════════════════════════════════════════════════════════════════════════╝");
        println!("");
        println!("Starting registry server on {}...", self.base_url);
        println!("");

        // Load default packages
        self.load_default_packages()?;

        println!("✓ Registry initialized with {} packages", self.registry.stats.total_packages);
        println!("✓ Server ready to accept connections");
        println!("");
        println!("API Endpoints:");
        println!("  GET  /api/packages             - List all packages");
        println!("  GET  /api/packages?q=<query>   - Search packages");
        println!("  GET  /api/packages/<id>        - Get package info");
        println!("  POST /api/packages/publish     - Publish new package");
        println!("  GET  /api/stats                - Get registry statistics");
        println!("");

        Ok(())
    }

    fn load_default_packages(&mut self) -> Result<(), String> {
        // HTTP Server
        let mut http_pkg = RegistryPackage::new(
            "http-server".to_string(),
            "1.0.0".to_string(),
            "High-performance HTTP/1.1 server for building web applications".to_string(),
            "TITAN".to_string(),
            "Omnisystem Community <community@omnisystem.dev>".to_string(),
        )
        http_pkg.keywords = vec!["http", "server", "web", "networking".to_string()]
        http_pkg.categories = vec!["networking", "web".to_string()]
        http_pkg.homepage = "https://github.com/omnisystem/http-server".to_string()
        http_pkg.repository = "https://github.com/omnisystem/http-server.git".to_string()
        self.registry.register_package(http_pkg)?

        // Graphics Engine
        let mut graphics_pkg = RegistryPackage::new(
            "graphics-engine".to_string(),
            "2.0.0".to_string(),
            "3D graphics rendering engine with lighting and materials".to_string(),
            "HELIX".to_string(),
            "Omnisystem Graphics Team <graphics@omnisystem.dev>".to_string(),
        )
        graphics_pkg.keywords = vec!["graphics", "3d", "rendering", "gpu".to_string()]
        graphics_pkg.categories = vec!["graphics", "gpu".to_string()]
        self.registry.register_package(graphics_pkg)?

        // ML Framework
        let mut ml_pkg = RegistryPackage::new(
            "neural-network-framework".to_string(),
            "1.5.0".to_string(),
            "Complete machine learning framework with neural networks".to_string(),
            "SYLVA".to_string(),
            "Omnisystem ML Team <ml@omnisystem.dev>".to_string(),
        )
        ml_pkg.keywords = vec!["machine-learning", "neural-network", "deep-learning", "ml".to_string()]
        ml_pkg.categories = vec!["machine-learning", "ai".to_string()]
        self.registry.register_package(ml_pkg)?

        // UI Framework
        let mut ui_pkg = RegistryPackage::new(
            "ui-framework".to_string(),
            "3.0.0".to_string(),
            "Modern reactive UI component library".to_string(),
            "VERA".to_string(),
            "Omnisystem UI Team <ui@omnisystem.dev>".to_string(),
        )
        ui_pkg.keywords = vec!["ui", "components", "reactive", "gui".to_string()]
        ui_pkg.categories = vec!["ui", "frontend".to_string()]
        self.registry.register_package(ui_pkg)?

        // Distributed Systems
        let mut distributed_pkg = RegistryPackage::new(
            "distributed-runtime".to_string(),
            "1.2.0".to_string(),
            "Actor-based distributed systems runtime".to_string(),
            "AETHER".to_string(),
            "Omnisystem Systems Team <systems@omnisystem.dev>".to_string(),
        )
        distributed_pkg.keywords = vec!["distributed", "actors", "concurrency", "messaging".to_string()]
        distributed_pkg.categories = vec!["distributed", "concurrency".to_string()]
        self.registry.register_package(distributed_pkg)?

        // Formal Verification
        let mut verification_pkg = RegistryPackage::new(
            "formal-verification".to_string(),
            "0.9.0".to_string(),
            "Formal verification and theorem proving framework".to_string(),
            "AXIOM".to_string(),
            "Omnisystem Verification Team <verify@omnisystem.dev>".to_string(),
        )
        verification_pkg.keywords = vec!["verification", "formal-methods", "theorem-proving".to_string()]
        verification_pkg.categories = vec!["verification", "testing".to_string()]
        self.registry.register_package(verification_pkg)?

        Ok(())
    }

    pub fn handle_list_packages(&self) -> String {
        let packages = self.registry.list_packages()
        let json = format!(
            r#"{{
  "packages": [{}],
  "total": {}
}}"#,
            packages.iter()
                .filter_map(|id| {
                    self.registry.lookup(id).map(|pkg| {
                        format!(
                            r#"{{
    "id": "{}",
    "name": "{}",
    "version": "{}",
    "language": "{}",
    "downloads": {}
  }}"#,
                            id, pkg.name, pkg.latest_version, pkg.language, pkg.downloads
                        )
                    })
                })
                .collect::<Vec<_>>()
                .join(","),
            packages.len()
        )
        json
    }

    pub fn handle_search(&self, query: &str) -> String {
        let results = self.registry.search(query)
        let json = format!(
            r#"{{
  "query": "{}",
  "results": [{}],
  "count": {}
}}"#,
            query,
            results.iter()
                .filter_map(|id| {
                    self.registry.lookup(id).map(|pkg| {
                        format!(
                            r#"{{
    "id": "{}",
    "name": "{}",
    "description": "{}",
    "rating": {:.1},
    "downloads": {}
  }}"#,
                            id, pkg.name, pkg.description, pkg.rating, pkg.downloads
                        )
                    })
                })
                .collect::<Vec<_>>()
                .join(","),
            results.len()
        )
        json
    }

    pub fn handle_package_info(&self, package_id: &str) -> Result<String, String> {
        match self.registry.lookup(package_id) {
            Some(pkg) => {
                let json = format!(
                    r#"{{
  "id": "{}",
  "name": "{}",
  "version": "{}",
  "description": "{}",
  "language": "{}",
  "author": "{}",
  "license": "{}",
  "downloads": {},
  "rating": {:.1},
  "keywords": [{}],
  "categories": [{}],
  "homepage": "{}",
  "repository": "{}",
  "documentation": "{}",
  "created": "{}",
  "updated": "{}"
}}"#,
                    package_id,
                    pkg.name,
                    pkg.latest_version,
                    pkg.description,
                    pkg.language,
                    pkg.author,
                    pkg.license,
                    pkg.downloads,
                    pkg.rating,
                    pkg.keywords.iter()
                        .map(|k| format!(r#""{}""#, k))
                        .collect::<Vec<_>>()
                        .join(","),
                    pkg.categories.iter()
                        .map(|c| format!(r#""{}""#, c))
                        .collect::<Vec<_>>()
                        .join(","),
                    pkg.homepage,
                    pkg.repository,
                    pkg.documentation,
                    pkg.created_at,
                    pkg.last_updated
                )
                Ok(json)
            }
            None => Err(format!("Package not found: {}", package_id)),
        }
    }

    pub fn handle_registry_stats(&self) -> String {
        let stats = self.registry.get_stats()
        let json = format!(
            r#"{{
  "total_packages": {},
  "total_downloads": {},
  "total_authors": {},
  "growth_rate": {:.1}%
}}"#,
            stats.total_packages,
            stats.total_downloads,
            stats.total_authors,
            stats.growth_rate * 100.0
        )
        json
    }

    pub fn demo(&mut self) -> Result<(), String> {
        println!("═══════════════════════════════════════════════════════════════════════════════════");
        println!("DEMO: Registry Server Operations");
        println!("═══════════════════════════════════════════════════════════════════════════════════");
        println!("");

        println!("[1/5] Listing all packages...");
        let list_response = self.handle_list_packages()
        println!("{}", list_response);
        println!("");

        println!("[2/5] Searching for 'http'...");
        let search_response = self.handle_search("http")
        println!("{}", search_response);
        println!("");

        println!("[3/5] Fetching package info...");
        match self.handle_package_info("titan/http-server") {
            Ok(info) => println!("{}", info),
            Err(e) => println!("Error: {}", e),
        }
        println!("");

        println!("[4/5] Recording download...");
        match self.registry.record_download("titan/http-server") {
            Ok(_) => println!("✓ Download recorded"),
            Err(e) => println!("Error: {}", e),
        }
        println!("");

        println!("[5/5] Getting registry statistics...");
        let stats = self.handle_registry_stats()
        println!("{}", stats);
        println!("");

        println!("═══════════════════════════════════════════════════════════════════════════════════");
        println!("✓ Registry server demo complete");
        println!("═══════════════════════════════════════════════════════════════════════════════════");

        Ok(())
    }
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// MAIN ENTRY POINT
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

pub fn main() -> Result<(), Box<dyn std::error::Error>> {
    let mut server = RegistryServer::new(5000)

    server.startup()?
    server.demo()?

    Ok(())
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_package_creation() {
        let pkg = RegistryPackage::new(
            "test-pkg".to_string(),
            "1.0.0".to_string(),
            "A test package".to_string(),
            "TITAN".to_string(),
            "Test Author".to_string(),
        )
        assert_eq!(pkg.name, "test-pkg")
        assert_eq!(pkg.latest_version, "1.0.0")
    }

    #[test]
    fn test_registry_register() {
        let mut registry = PackageRegistry::new()

        let pkg = RegistryPackage::new(
            "test-pkg".to_string(),
            "1.0.0".to_string(),
            "A test package".to_string(),
            "TITAN".to_string(),
            "Test Author".to_string(),
        )

        assert!(registry.register_package(pkg).is_ok())
        assert_eq!(registry.list_packages().len(), 1)
    }

    #[test]
    fn test_registry_search() {
        let mut registry = PackageRegistry::new()

        let mut pkg = RegistryPackage::new(
            "search-pkg".to_string(),
            "1.0.0".to_string(),
            "A searchable package".to_string(),
            "TITAN".to_string(),
            "Author".to_string(),
        )
        pkg.keywords = vec!["test".to_string(), "search".to_string()]

        let _ = registry.register_package(pkg)

        let results = registry.search("test")
        assert_eq!(results.len(), 1)
    }
}
