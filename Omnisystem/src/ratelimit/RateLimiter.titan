// RateLimiter.titan - Rate limiting and throttling
use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

pub struct RateLimitBucket {
    pub bucket_id: String,
    pub max_requests: u32,
    pub current_requests: u32,
    pub reset_at: u64,
}

impl RateLimitBucket {
    pub fn new(bucket_id: String, max_requests: u32) -> Self {
        RateLimitBucket {
            bucket_id,
            max_requests,
            current_requests: 0,
            reset_at: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs() + 60,
        }
    }

    pub fn allow_request(&mut self) -> bool {
        if self.current_requests < self.max_requests {
            self.current_requests += 1;
            true
        } else {
            false
        }
    }
}

pub struct RateLimiter {
    pub limiter_id: String,
    pub buckets: HashMap<String, RateLimitBucket>,
}

impl RateLimiter {
    pub fn new(limiter_id: String) -> Self {
        RateLimiter {
            limiter_id,
            buckets: HashMap::new(),
        }
    }

    pub fn check_limit(&mut self, client_id: &str) -> bool {
        let bucket = self.buckets.entry(client_id.to_string())
            .or_insert_with(|| RateLimitBucket::new(client_id.to_string(), 100));
        bucket.allow_request()
    }
}

fn main() -> Result<(), String> {
    println!("=== PHASE 57: RATE LIMITER ===\n");
    let mut limiter = RateLimiter::new("rl_001".to_string());
    for _ in 0..5 {
        limiter.check_limit("client_1");
    }
    println!("✓✓✓ Rate Limiter operational ✓✓✓");
    Ok(())
}
