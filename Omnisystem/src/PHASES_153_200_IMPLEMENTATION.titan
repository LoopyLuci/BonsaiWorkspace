pub actor AssetManager {
    assets: Arc<Mutex<HashMap<String, String>>>,
    asset_count: i32,
    versions: Arc<Mutex<HashMap<String, Vec<String>>>>

    message RegisterAsset(id: String, path: String) -> Result<(), String> {
        assets.lock().unwrap().insert(id.clone(), path)
        versions.lock().unwrap().insert(id, Vec::new())
        self.asset_count += 1
        Ok(())
    }

    message GetAsset(id: String) -> Result<String, String> {
        assets.lock().unwrap()
            .get(&id)
            .cloned()
            .ok_or("Asset not found".to_string())
    }

    message GetAssetCount() -> i32 {
        self.asset_count
    }
}

