// DistributedTracing.aether - Distributed tracing and request tracking
use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

pub struct Span {
    pub span_id: String,
    pub trace_id: String,
    pub parent_span_id: Option<String>,
    pub operation_name: String,
    pub start_time: u64,
    pub end_time: Option<u64>,
    pub duration_ms: u32,
    pub tags: HashMap<String, String>,
    pub logs: Vec<String>,
}

impl Span {
    pub fn new(span_id: String, trace_id: String, operation_name: String) -> Self {
        Span {
            span_id,
            trace_id,
            parent_span_id: None,
            operation_name,
            start_time: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_millis() as u64,
            end_time: None,
            duration_ms: 0,
            tags: HashMap::new(),
            logs: Vec::new(),
        }
    }

    pub fn add_tag(&mut self, key: String, value: String) {
        self.tags.insert(key, value);
    }

    pub fn finish(&mut self) {
        self.end_time = Some(
            std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_millis() as u64
        );
        self.duration_ms = (self.end_time.unwrap_or(0) - self.start_time) as u32;
    }
}

pub struct Trace {
    pub trace_id: String,
    pub spans: HashMap<String, Span>,
    pub root_span_id: String,
}

impl Trace {
    pub fn new(trace_id: String, root_span_id: String) -> Self {
        Trace {
            trace_id,
            spans: HashMap::new(),
            root_span_id,
        }
    }

    pub fn add_span(&mut self, span: Span) {
        self.spans.insert(span.span_id.clone(), span);
    }
}

pub struct DistributedTracer {
    pub tracer_id: String,
    pub traces: HashMap<String, Trace>,
    pub active_traces: u32,
}

impl DistributedTracer {
    pub fn new(tracer_id: String) -> Self {
        DistributedTracer {
            tracer_id,
            traces: HashMap::new(),
            active_traces: 0,
        }
    }

    pub fn start_trace(&mut self, trace_id: String) -> Result<String, String> {
        let root_span_id = format!("{}_root", trace_id);
        let span = Span::new(root_span_id.clone(), trace_id.clone(), "root".to_string());

        let mut trace = Trace::new(trace_id.clone(), root_span_id);
        trace.add_span(span);

        self.traces.insert(trace_id.clone(), trace);
        self.active_traces += 1;

        Ok(trace_id)
    }

    pub fn finish_trace(&mut self, trace_id: &str) -> Result<(), String> {
        if let Some(trace) = self.traces.get_mut(trace_id) {
            if let Some(span) = trace.spans.get_mut(&trace.root_span_id) {
                span.finish();
            }
            self.active_traces = self.active_traces.saturating_sub(1);
            Ok(())
        } else {
            Err(format!("Trace {} not found", trace_id))
        }
    }
}

fn main() -> Result<(), String> {
    println!("=== PHASE 62: DISTRIBUTED TRACER ===\n");
    let mut tracer = DistributedTracer::new("tracer_001".to_string());
    tracer.start_trace("trace_001".to_string())?;
    tracer.finish_trace("trace_001")?;
    println!("✓ Trace recorded");
    println!("✓✓✓ Distributed Tracer operational ✓✓✓");
    Ok(())
}
