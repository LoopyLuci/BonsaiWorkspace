// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════
// OMNISYSTEM INTERACTIVE DEBUGGER - BREAKPOINTS, STEP-THROUGH, VARIABLE INSPECTION
// Full-featured debugger with breakpoints, call stack navigation, variable watching, expression evaluation
// Language: TITAN (Systems Programming)
// Phase 0: Critical Foundation Layer
// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════

use std::collections::HashMap;
use std::io::{self, BufRead, Write};
use std::time::Instant;

// ─────────────────────────────────────────────────────────────────────────────────────────────────────────
// DEBUGGER TYPES
// ─────────────────────────────────────────────────────────────────────────────────────────────────────────

#[derive(Clone, Debug, PartialEq)]
pub enum BreakpointType {
    LineBreakpoint,
    ConditionalBreakpoint,
    FunctionBreakpoint,
    ExceptionBreakpoint,
}

#[derive(Clone, Debug)]
pub struct Breakpoint {
    pub id: u32,
    pub bp_type: BreakpointType,
    pub file: String,
    pub line: u32,
    pub condition: Option<String>,
    pub function_name: Option<String>,
    pub enabled: bool,
    pub hit_count: u32,
}

impl Breakpoint {
    pub fn new(id: u32, file: String, line: u32) -> Self {
        Breakpoint {
            id,
            bp_type: BreakpointType::LineBreakpoint,
            file,
            line,
            condition: None,
            function_name: None,
            enabled: true,
            hit_count: 0,
        }
    }

    pub fn with_condition(mut self, condition: String) -> Self {
        self.bp_type = BreakpointType::ConditionalBreakpoint;
        self.condition = Some(condition);
        self
    }

    pub fn evaluate_condition(&mut self, variables: &HashMap<String, String>) -> Result<bool, String> {
        if let Some(ref cond) = self.condition {
            // Simple condition evaluation
            if cond.contains("==") {
                let parts: Vec<&str> = cond.split("==").collect();
                if parts.len() == 2 {
                    let left = parts[0].trim();
                    let right = parts[1].trim();
                    if let Some(left_val) = variables.get(left) {
                        return Ok(left_val == right);
                    }
                }
            }
        }
        Ok(true)
    }
}

#[derive(Clone, Debug)]
pub struct StackFrame {
    pub frame_id: u32,
    pub function_name: String,
    pub file: String,
    pub line: u32,
    pub column: u32,
    pub variables: HashMap<String, String>,
    pub return_value: Option<String>,
}

#[derive(Clone, Debug)]
pub struct WatchExpression {
    pub id: u32,
    pub expression: String,
    pub current_value: Option<String>,
    pub previous_value: Option<String>,
    pub changed: bool,
}

#[derive(Clone, Copy, Debug, PartialEq)]
pub enum DebuggerState {
    Running,
    Paused,
    SteppingInto,
    SteppingOver,
    SteppingOut,
    Stopped,
}

pub struct InteractiveDebugger {
    state: DebuggerState,
    breakpoints: HashMap<u32, Breakpoint>,
    next_breakpoint_id: u32,
    call_stack: Vec<StackFrame>,
    current_frame: usize,
    watches: HashMap<u32, WatchExpression>,
    next_watch_id: u32,
    session_start: Instant,
    pause_reason: String,
    last_breakpoint_hit: Option<u32>,
}

impl InteractiveDebugger {
    pub fn new() -> Self {
        InteractiveDebugger {
            state: DebuggerState::Stopped,
            breakpoints: HashMap::new(),
            next_breakpoint_id: 1,
            call_stack: Vec::new(),
            current_frame: 0,
            watches: HashMap::new(),
            next_watch_id: 1,
            session_start: Instant::now(),
            pause_reason: String::new(),
            last_breakpoint_hit: None,
        }
    }

    pub fn start_session(&mut self) -> Result<(), String> {
        println!("╔════════════════════════════════════════════════════════════════╗");
        println!("║        OMNISYSTEM INTERACTIVE DEBUGGER v1.0                   ║");
        println!("║        Breakpoints | Step-Through | Variable Inspection       ║");
        println!("╚════════════════════════════════════════════════════════════════╝\n");

        self.state = DebuggerState::Running;
        println!("✓ Debugger started. Type 'help' for commands.");

        Ok(())
    }

    pub fn set_breakpoint(&mut self, file: String, line: u32) -> Result<u32, String> {
        let bp = Breakpoint::new(self.next_breakpoint_id, file.clone(), line);
        let id = self.next_breakpoint_id;
        self.breakpoints.insert(id, bp);
        self.next_breakpoint_id += 1;
        println!("✓ Breakpoint {} set at {}:{}", id, file, line);
        Ok(id)
    }

    pub fn set_conditional_breakpoint(&mut self, file: String, line: u32, condition: String) -> Result<u32, String> {
        let bp = Breakpoint::new(self.next_breakpoint_id, file.clone(), line)
            .with_condition(condition.clone());
        let id = self.next_breakpoint_id;
        self.breakpoints.insert(id, bp);
        self.next_breakpoint_id += 1;
        println!("✓ Conditional breakpoint {} set at {}:{} ({})", id, file, line, condition);
        Ok(id)
    }

    pub fn remove_breakpoint(&mut self, id: u32) -> Result<(), String> {
        if self.breakpoints.remove(&id).is_some() {
            println!("✓ Breakpoint {} removed", id);
            Ok(())
        } else {
            Err(format!("Breakpoint {} not found", id))
        }
    }

    pub fn enable_breakpoint(&mut self, id: u32) -> Result<(), String> {
        if let Some(bp) = self.breakpoints.get_mut(&id) {
            bp.enabled = true;
            println!("✓ Breakpoint {} enabled", id);
            Ok(())
        } else {
            Err(format!("Breakpoint {} not found", id))
        }
    }

    pub fn disable_breakpoint(&mut self, id: u32) -> Result<(), String> {
        if let Some(bp) = self.breakpoints.get_mut(&id) {
            bp.enabled = false;
            println!("✓ Breakpoint {} disabled", id);
            Ok(())
        } else {
            Err(format!("Breakpoint {} not found", id))
        }
    }

    pub fn add_watch(&mut self, expression: String) -> Result<u32, String> {
        let watch = WatchExpression {
            id: self.next_watch_id,
            expression,
            current_value: None,
            previous_value: None,
            changed: false,
        };
        let id = self.next_watch_id;
        self.watches.insert(id, watch);
        self.next_watch_id += 1;
        println!("✓ Watch {} added", id);
        Ok(id)
    }

    pub fn remove_watch(&mut self, id: u32) -> Result<(), String> {
        if self.watches.remove(&id).is_some() {
            println!("✓ Watch {} removed", id);
            Ok(())
        } else {
            Err(format!("Watch {} not found", id))
        }
    }

    pub fn pause(&mut self, reason: String) -> Result<(), String> {
        self.state = DebuggerState::Paused;
        self.pause_reason = reason.clone();
        println!("⏸  Debugger paused: {}", reason);
        Ok(())
    }

    pub fn continue_execution(&mut self) -> Result<(), String> {
        self.state = DebuggerState::Running;
        self.pause_reason.clear();
        println!("▶  Continuing execution");
        Ok(())
    }

    pub fn step_into(&mut self) -> Result<(), String> {
        self.state = DebuggerState::SteppingInto;
        println!("↓  Stepping into next function");
        Ok(())
    }

    pub fn step_over(&mut self) -> Result<(), String> {
        self.state = DebuggerState::SteppingOver;
        println!("→  Stepping over next line");
        Ok(())
    }

    pub fn step_out(&mut self) -> Result<(), String> {
        self.state = DebuggerState::SteppingOut;
        println!("↑  Stepping out of current function");
        Ok(())
    }

    pub fn push_frame(&mut self, frame: StackFrame) {
        self.call_stack.push(frame);
        self.current_frame = self.call_stack.len() - 1;
    }

    pub fn pop_frame(&mut self) -> Option<StackFrame> {
        if self.call_stack.len() > 1 {
            self.current_frame = self.call_stack.len() - 2;
            self.call_stack.pop()
        } else {
            None
        }
    }

    pub fn get_current_frame(&self) -> Option<&StackFrame> {
        if self.current_frame < self.call_stack.len() {
            Some(&self.call_stack[self.current_frame])
        } else {
            None
        }
    }

    pub fn inspect_variable(&self, name: &str) -> Result<String, String> {
        if let Some(frame) = self.get_current_frame() {
            if let Some(value) = frame.variables.get(name) {
                Ok(value.clone())
            } else {
                Err(format!("Variable '{}' not found in current scope", name))
            }
        } else {
            Err("No active frame".to_string())
        }
    }

    pub fn set_variable(&mut self, name: String, value: String) -> Result<(), String> {
        if let Some(frame) = self.call_stack.get_mut(self.current_frame) {
            frame.variables.insert(name.clone(), value.clone());
            println!("✓ {} = {}", name, value);
            Ok(())
        } else {
            Err("No active frame".to_string())
        }
    }

    pub fn print_call_stack(&self) {
        println!("\n╔════ CALL STACK ════╗");
        for (idx, frame) in self.call_stack.iter().enumerate() {
            let marker = if idx == self.current_frame { "→ " } else { "  " };
            println!("{}[{}] {} at {}:{}", marker, idx, frame.function_name, frame.file, frame.line);
        }
        println!("╚═══════════════════╝\n");
    }

    pub fn print_breakpoints(&self) {
        if self.breakpoints.is_empty() {
            println!("No breakpoints set");
            return;
        }

        println!("\n╔════ BREAKPOINTS ════╗");
        for (_, bp) in &self.breakpoints {
            let status = if bp.enabled { "✓" } else { "✗" };
            let cond = if let Some(ref c) = bp.condition { format!(" ({})", c) } else { String::new() };
            println!("{}[{}] {}:{}{} (hits: {})", status, bp.id, bp.file, bp.line, cond, bp.hit_count);
        }
        println!("╚════════════════════╝\n");
    }

    pub fn print_variables(&self) {
        if let Some(frame) = self.get_current_frame() {
            println!("\n╔════ VARIABLES IN {} ════╗", frame.function_name);
            if frame.variables.is_empty() {
                println!("║ No variables");
            } else {
                for (name, value) in &frame.variables {
                    println!("║ {} = {}", name, value);
                }
            }
            println!("╚═════════════════════════╝\n");
        }
    }

    pub fn print_watches(&self) {
        if self.watches.is_empty() {
            println!("No watches set");
            return;
        }

        println!("\n╔════ WATCHES ════╗");
        for (_, watch) in &self.watches {
            let value_str = watch.current_value.clone().unwrap_or_else(|| "?".to_string());
            let changed_marker = if watch.changed { "⚡" } else { " " };
            println!("{}[{}] {} = {}", changed_marker, watch.id, watch.expression, value_str);
        }
        println!("╚═══════════════════╝\n");
    }

    pub fn print_help(&self) {
        println!("\n╔════ DEBUGGER COMMANDS ════╗");
        println!("║ EXECUTION:                │");
        println!("║  c/continue - Continue    │");
        println!("║  n/next     - Step over   │");
        println!("║  s/step     - Step into   │");
        println!("║  f/finish   - Step out    │");
        println!("║                           │");
        println!("║ BREAKPOINTS:              │");
        println!("║  b FILE:LINE - Set bp     │");
        println!("║  db ID       - Delete bp  │");
        println!("║  bl          - List bp    │");
        println!("║                           │");
        println!("║ INSPECTION:               │");
        println!("║  p VAR       - Print var  │");
        println!("║  bt          - Backtrace  │");
        println!("║  locals      - Show vars  │");
        println!("║  watch EXPR  - Add watch  │");
        println!("║                           │");
        println!("║ SESSION:                  │");
        println!("║  info        - Debug info │");
        println!("║  help        - This menu  │");
        println!("║  quit        - Exit       │");
        println!("╚═══════════════════════════╝\n");
    }

    pub fn print_info(&self) {
        println!("\n╔════ DEBUG SESSION INFO ════╗");
        println!("║ State:        {:?}", self.state);
        println!("║ Breakpoints:  {}", self.breakpoints.len());
        println!("║ Call stack:   {}", self.call_stack.len());
        println!("║ Watches:      {}", self.watches.len());
        println!("║ Duration:     {:.2}s", self.session_start.elapsed().as_secs_f64());
        if !self.pause_reason.is_empty() {
            println!("║ Pause reason: {}", self.pause_reason);
        }
        println!("╚════════════════════════════╝\n");
    }
}

pub fn main() {
    println!("╔════════════════════════════════════════════════════════════════╗");
    println!("║        OMNISYSTEM INTERACTIVE DEBUGGER v1.0                   ║");
    println!("║        Breakpoints | Step-Through | Variable Inspection       ║");
    println!("╚════════════════════════════════════════════════════════════════╝\n");

    let mut debugger = InteractiveDebugger::new();
    debugger.start_session().expect("Failed to start debugger");

    // Create sample call stack
    let mut frame = StackFrame {
        frame_id: 0,
        function_name: "main".to_string(),
        file: "program.titan".to_string(),
        line: 10,
        column: 0,
        variables: HashMap::new(),
        return_value: None,
    };
    frame.variables.insert("x".to_string(), "42".to_string());
    frame.variables.insert("y".to_string(), "3.14".to_string());
    debugger.push_frame(frame);

    // Interactive loop
    let stdin = io::stdin();
    let reader = stdin.lock();

    for line in reader.lines() {
        match line {
            Ok(input) => {
                let trimmed = input.trim();

                match trimmed {
                    "help" => debugger.print_help(),
                    "quit" | "exit" => {
                        println!("Debugger stopped");
                        break;
                    },
                    "info" => debugger.print_info(),
                    "bt" | "backtrace" => debugger.print_call_stack(),
                    "bl" | "breakpoints" => debugger.print_breakpoints(),
                    "locals" | "vars" => debugger.print_variables(),
                    "watches" => debugger.print_watches(),
                    "c" | "continue" => { let _ = debugger.continue_execution(); },
                    "s" | "step" => { let _ = debugger.step_into(); },
                    "n" | "next" => { let _ = debugger.step_over(); },
                    "f" | "finish" => { let _ = debugger.step_out(); },
                    cmd if cmd.starts_with("p ") => {
                        let var_name = cmd.strip_prefix("p ").unwrap().trim();
                        match debugger.inspect_variable(var_name) {
                            Ok(val) => println!("{} = {}", var_name, val),
                            Err(e) => println!("Error: {}", e),
                        }
                    },
                    cmd if cmd.starts_with("b ") => {
                        let parts: Vec<&str> = cmd.strip_prefix("b ").unwrap().split(':').collect();
                        if parts.len() == 2 {
                            if let Ok(line) = parts[1].parse::<u32>() {
                                let _ = debugger.set_breakpoint(parts[0].to_string(), line);
                            }
                        }
                    },
                    cmd if cmd.starts_with("watch ") => {
                        let expr = cmd.strip_prefix("watch ").unwrap();
                        let _ = debugger.add_watch(expr.to_string());
                    },
                    _ => println!("Unknown command. Type 'help' for list."),
                }
            },
            Err(_) => break,
        }
    }
}
