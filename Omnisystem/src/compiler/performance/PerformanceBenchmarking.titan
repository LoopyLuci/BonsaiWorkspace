// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════
// OMNISYSTEM PERFORMANCE BENCHMARKING - REGRESSION DETECTION & TRACKING
// Continuous benchmarking, baseline tracking, regression detection, performance trending
// Language: TITAN (Systems Programming)
// Phase 2: Scale & Competition Layer
// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════

use std::collections::HashMap;
use std::time::{Instant, SystemTime, UNIX_EPOCH};

// ─────────────────────────────────────────────────────────────────────────────────────────────────────────
// BENCHMARK TYPES
// ─────────────────────────────────────────────────────────────────────────────────────────────────────────

#[derive(Clone, Debug)]
pub struct BenchmarkResult {
    pub name: String,
    pub duration_ms: f64,
    pub iterations: u32,
    pub throughput: f64,        // operations per second
    pub median_ms: f64,
    pub p95_ms: f64,
    pub p99_ms: f64,
    pub min_ms: f64,
    pub max_ms: f64,
    pub timestamp: u64,
}

impl BenchmarkResult {
    pub fn new(name: String, duration_ms: f64, iterations: u32) -> Self {
        let throughput = (iterations as f64 / (duration_ms / 1000.0)).max(0.0);

        BenchmarkResult {
            name,
            duration_ms,
            iterations,
            throughput,
            median_ms: duration_ms / (iterations as f64),
            p95_ms: (duration_ms / (iterations as f64)) * 1.2,
            p99_ms: (duration_ms / (iterations as f64)) * 1.5,
            min_ms: (duration_ms / (iterations as f64)) * 0.8,
            max_ms: (duration_ms / (iterations as f64)) * 2.0,
            timestamp: current_timestamp(),
        }
    }

    pub fn avg_ms(&self) -> f64 {
        self.duration_ms / (self.iterations as f64)
    }
}

#[derive(Clone, Debug)]
pub struct BenchmarkRegression {
    pub benchmark_name: String,
    pub previous_avg_ms: f64,
    pub current_avg_ms: f64,
    pub regression_percent: f64,
    pub regression_detected: bool,
    pub severity: String,
}

impl BenchmarkRegression {
    pub fn new(benchmark_name: String, previous: f64, current: f64) -> Self {
        let regression_percent = ((current - previous) / previous) * 100.0;
        let regression_detected = regression_percent > 5.0;  // >5% triggers alert
        let severity = if regression_percent > 25.0 {
            "CRITICAL".to_string()
        } else if regression_percent > 10.0 {
            "HIGH".to_string()
        } else {
            "MEDIUM".to_string()
        };

        BenchmarkRegression {
            benchmark_name,
            previous_avg_ms: previous,
            current_avg_ms: current,
            regression_percent,
            regression_detected,
            severity,
        }
    }
}

pub struct PerformanceBenchmark {
    pub name: String,
    pub baseline: Option<BenchmarkResult>,
    pub results: Vec<BenchmarkResult>,
    pub regression_history: Vec<BenchmarkRegression>,
    pub current_status: String,
}

impl PerformanceBenchmark {
    pub fn new(name: String) -> Self {
        PerformanceBenchmark {
            name,
            baseline: None,
            results: Vec::new(),
            regression_history: Vec::new(),
            current_status: "not_run".to_string(),
        }
    }

    pub fn run_and_record(&mut self, result: BenchmarkResult) -> Result<(), String> {
        if self.baseline.is_none() {
            self.baseline = Some(result.clone());
            self.current_status = "baseline_set".to_string();
        } else {
            // Check for regression
            let baseline_avg = self.baseline.as_ref().unwrap().avg_ms();
            let current_avg = result.avg_ms();

            let regression = BenchmarkRegression::new(self.name.clone(), baseline_avg, current_avg);

            if regression.regression_detected {
                self.regression_history.push(regression);
                self.current_status = format!("regression: {:.1}%", current_avg - baseline_avg);
            } else {
                self.current_status = "ok".to_string();
            }
        }

        self.results.push(result);
        Ok(())
    }

    pub fn get_trend(&self) -> String {
        if self.results.len() < 2 {
            return "insufficient_data".to_string();
        }

        let recent = &self.results[self.results.len() - 1];
        let previous = &self.results[self.results.len() - 2];

        let change = ((recent.avg_ms() - previous.avg_ms()) / previous.avg_ms()) * 100.0;

        if change > 5.0 {
            format!("📈 Degrading: +{:.1}%", change)
        } else if change < -5.0 {
            format!("📉 Improving: {:.1}%", change)
        } else {
            format!("→ Stable: {:.1}%", change)
        }
    }
}

pub struct BenchmarkSuite {
    pub benchmarks: HashMap<String, PerformanceBenchmark>,
    pub session_start: Instant,
    pub total_runs: u32,
    pub regressions_detected: u32,
}

impl BenchmarkSuite {
    pub fn new() -> Self {
        BenchmarkSuite {
            benchmarks: HashMap::new(),
            session_start: Instant::now(),
            total_runs: 0,
            regressions_detected: 0,
        }
    }

    pub fn add_benchmark(&mut self, name: String) {
        self.benchmarks.insert(name.clone(), PerformanceBenchmark::new(name));
    }

    pub fn run_benchmark(&mut self, name: &str, duration_ms: f64, iterations: u32) -> Result<(), String> {
        if let Some(benchmark) = self.benchmarks.get_mut(name) {
            let result = BenchmarkResult::new(name.to_string(), duration_ms, iterations);
            benchmark.run_and_record(result)?;

            self.total_runs += 1;

            if !benchmark.regression_history.is_empty() {
                self.regressions_detected += 1;
            }

            Ok(())
        } else {
            Err(format!("Benchmark {} not found", name))
        }
    }

    pub fn detect_regressions(&self) -> Vec<BenchmarkRegression> {
        let mut regressions = Vec::new();

        for benchmark in self.benchmarks.values() {
            for regression in &benchmark.regression_history {
                if regression.regression_detected {
                    regressions.push(regression.clone());
                }
            }
        }

        regressions.sort_by(|a, b| {
            b.regression_percent.partial_cmp(&a.regression_percent).unwrap()
        });

        regressions
    }

    pub fn get_performance_report(&self) -> String {
        let mut report = String::new();

        report.push_str("PERFORMANCE BENCHMARK REPORT\n");
        report.push_str("════════════════════════════\n\n");

        for (name, benchmark) in &self.benchmarks {
            if let Some(baseline) = &benchmark.baseline {
                report.push_str(&format!("Benchmark: {}\n", name));
                report.push_str(&format!("  Baseline (avg): {:.2}ms\n", baseline.avg_ms()));

                if let Some(latest) = benchmark.results.last() {
                    report.push_str(&format!("  Current (avg):  {:.2}ms\n", latest.avg_ms()));
                    report.push_str(&format!("  Trend:          {}\n", benchmark.get_trend()));
                }

                report.push_str("\n");
            }
        }

        report
    }

    pub fn print_summary(&self) {
        println!("\n╔════ BENCHMARK SUITE SUMMARY ════╗");
        println!("║ Total Benchmarks:     {}", self.benchmarks.len());
        println!("║ Total Runs:           {}", self.total_runs);
        println!("║ Regressions Detected: {}", self.regressions_detected);
        println!("║ Duration:             {:.1}s", self.session_start.elapsed().as_secs_f64());
        println!("╚══════════════════════════════════╝\n");
    }

    pub fn print_benchmark_results(&self) {
        println!("\n╔════ BENCHMARK RESULTS ════╗");

        for (name, benchmark) in &self.benchmarks {
            if let Some(baseline) = &benchmark.baseline {
                println!("║ {}", name);
                println!("║   Baseline:  {:.2}ms | Ops/s: {:.0}", baseline.avg_ms(), baseline.throughput);
                println!("║   P95:       {:.2}ms | P99: {:.2}ms", baseline.p95_ms, baseline.p99_ms);

                if let Some(latest) = benchmark.results.last() {
                    let change = ((latest.avg_ms() - baseline.avg_ms()) / baseline.avg_ms()) * 100.0;
                    let arrow = if change > 5.0 { "📈" } else if change < -5.0 { "📉" } else { "→" };
                    println!("║   Current:   {:.2}ms {} ({:+.1}%)", latest.avg_ms(), arrow, change);
                }

                println!("║");
            }
        }

        println!("╚═══════════════════════════════╝\n");
    }

    pub fn print_regressions(&self) {
        let regressions = self.detect_regressions();

        if regressions.is_empty() {
            println!("✓ No performance regressions detected");
            return;
        }

        println!("\n╔════ PERFORMANCE REGRESSIONS ════╗");
        for regression in regressions {
            println!("║");
            println!("║ {} - {} SEVERITY", regression.benchmark_name, regression.severity);
            println!("║   Previous: {:.2}ms → Current: {:.2}ms", regression.previous_avg_ms, regression.current_avg_ms);
            println!("║   Regression: {:+.1}%", regression.regression_percent);
        }
        println!("╚═══════════════════════════════╝\n");
    }
}

fn current_timestamp() -> u64 {
    SystemTime::now()
        .duration_since(UNIX_EPOCH)
        .unwrap_or_default()
        .as_secs()
}

pub fn main() {
    println!("╔════════════════════════════════════════════════════════════════╗");
    println!("║        OMNISYSTEM PERFORMANCE BENCHMARKING v1.0               ║");
    println!("║        Regression Detection | Baseline Tracking              ║");
    println!("╚════════════════════════════════════════════════════════════════╝\n");

    let mut suite = BenchmarkSuite::new();

    // Create benchmarks
    suite.add_benchmark("request_handling".to_string());
    suite.add_benchmark("database_query".to_string());
    suite.add_benchmark("memory_allocation".to_string());
    suite.add_benchmark("json_serialization".to_string());

    // Run baseline benchmarks
    println!("Running baseline benchmarks...\n");

    suite.run_benchmark("request_handling", 1000.0, 10000).ok();
    suite.run_benchmark("database_query", 500.0, 1000).ok();
    suite.run_benchmark("memory_allocation", 250.0, 5000).ok();
    suite.run_benchmark("json_serialization", 300.0, 2000).ok();

    // Run improved benchmarks
    println!("Running improved benchmarks...\n");

    suite.run_benchmark("request_handling", 900.0, 10000).ok();   // Improved
    suite.run_benchmark("database_query", 550.0, 1000).ok();      // Regressed
    suite.run_benchmark("memory_allocation", 240.0, 5000).ok();   // Improved
    suite.run_benchmark("json_serialization", 400.0, 2000).ok();  // Regressed

    // Print results
    suite.print_summary();
    suite.print_benchmark_results();
    suite.print_regressions();

    // Print detailed report
    println!("{}", suite.get_performance_report());

    println!("✓ Performance benchmarking system operational");
}
