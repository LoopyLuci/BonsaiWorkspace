// ════════════════════════════════════════════════════════════════════════════════════════════════════════════
// FFI RUNTIME - DYNAMIC LIBRARY LOADER & NATIVE CALL TRAMPOLINE (Phase C of the enterprise FFI/extern layer)
// Real per-platform dlopen/dlsym/dlclose and LoadLibraryW/GetProcAddress/FreeLibrary call sequences,
// reference-counted library handles, ABI-aware value marshaling, panic-safe native call boundary,
// and C-ABI callback trampoline generation reusing X86_64Encoder-style machine-code byte patterns.
// Language: TITAN (Systems Programming) - Production-Grade Runtime FFI Layer
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════

use std::collections::HashMap;
use std::sync::{Arc, Mutex};
use std::fmt;
use std::panic::{catch_unwind, AssertUnwindSafe};

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════
// PLATFORM CONSTANTS - dlopen/LoadLibrary flags
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════

/// `RTLD_NOW` - resolve all undefined symbols in the shared object before dlopen() returns.
pub const RTLD_NOW: i32 = 0x2;
/// `RTLD_GLOBAL` - symbols defined by this shared object are made available for symbol
/// resolution of subsequently loaded shared objects.
pub const RTLD_GLOBAL: i32 = 0x100;

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════
// OPAQUE LIBRARY HANDLE
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════

/// Opaque handle wrapping a raw loaded-library identifier (a `dlopen()` `void*` cast to `u64`
/// on Linux/macOS, or an `HMODULE` cast to `u64` on Windows). Callers never construct this
/// directly - it is only produced by `FfiRuntime::load_library`.
#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
pub struct DynLibHandle(pub u64);

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════
// STRUCTURED FFI ERRORS
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════

#[derive(Clone, Debug, PartialEq, Eq)]
pub enum FfiError {
    LibraryNotFound(String),
    SymbolNotFound { library: String, symbol: String },
    AbiMismatch { library: String, expected: String, found: String },
    CallPanicked(String),
    InvalidArgument(String),
    AlreadyUnloaded(String),
}

impl fmt::Display for FfiError {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        match self {
            FfiError::LibraryNotFound(name) => {
                write!(f, "FFI: failed to load native library '{}' (dlopen/LoadLibraryW returned null)", name)
            }
            FfiError::SymbolNotFound { library, symbol } => {
                write!(f, "FFI: symbol '{}' not found in library '{}' (dlsym/GetProcAddress returned null)", symbol, library)
            }
            FfiError::AbiMismatch { library, expected, found } => {
                write!(
                    f,
                    "FFI: ABI mismatch loading '{}' - manifest expects abi_version '{}' but library reports '{}'",
                    library, expected, found
                )
            }
            FfiError::CallPanicked(msg) => {
                write!(f, "FFI: native call panicked across the extern boundary: {}", msg)
            }
            FfiError::InvalidArgument(msg) => {
                write!(f, "FFI: invalid argument for native call: {}", msg)
            }
            FfiError::AlreadyUnloaded(name) => {
                write!(f, "FFI: attempted to unload/use library '{}' which is not currently loaded", name)
            }
        }
    }
}

impl std::error::Error for FfiError {}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════
// DYNAMICALLY-TYPED FFI VALUE (runtime-level marshaling type; the value-level counterpart
// to Phase B's statically-compiled CallingConvention::classify_params codegen)
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════

#[derive(Clone, Debug, PartialEq)]
pub enum FfiValue {
    Int(i64),
    Float(f64),
    Ptr(u64),
    Bool(bool),
    CString(String),
}

impl FfiValue {
    /// True if this value is classified into the ABI's integer/pointer register class
    /// (as opposed to the float register class). Mirrors the int-vs-float split Phase B's
    /// `CallingConvention::classify_params` performs at the type level, but at the value level.
    pub fn is_integer_class(&self) -> bool {
        !matches!(self, FfiValue::Float(_))
    }

    /// Lowers this value to its raw 64-bit register/stack-slot representation for marshaling.
    pub fn to_raw_bits(&self) -> u64 {
        match self {
            FfiValue::Int(i) => *i as u64,
            FfiValue::Float(f) => f.to_bits(),
            FfiValue::Ptr(p) => *p,
            FfiValue::Bool(b) => if *b { 1 } else { 0 },
            // Real FFI would allocate/pin a null-terminated buffer and pass its address;
            // here we report the address of the owned buffer's first byte as a u64.
            FfiValue::CString(s) => s.as_ptr() as u64,
        }
    }
}

/// A type-correct lowered argument, used by `call_extern_typed`'s dispatch table instead of
/// `classify_call_args`'s pre-flattened u64 bit patterns: keeping the int-vs-float distinction
/// as a real Rust type (rather than a same-typed u64 slot) is what lets the concrete
/// `extern "C" fn(...)` casts in `call_extern_typed` route each value to the correct register
/// class through ordinary Rust/C-ABI lowering.
#[derive(Clone, Copy, Debug, PartialEq)]
enum ArgVal {
    I(i64),
    F(f64),
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════
// LOADED LIBRARY BOOKKEEPING
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════

#[derive(Clone, Debug)]
pub struct LoadedLibrary {
    pub handle: DynLibHandle,
    pub path: String,
    pub ref_count: u32,
    pub abi_version: Option<String>,
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════
// ABI CLASSIFICATION - per-ABI integer/float register counts (value-level mirror of Phase B)
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════

/// Returns (num_integer_registers, num_float_registers) available for argument passing
/// under the named ABI, before overflow args spill to the stack. Mirrors the register-class
/// budgets used by Phase B's `CallingConvention::classify_params` for "C"/"sysv64"/"win64"/"aapcs64".
fn abi_register_budget(abi: &str) -> (usize, usize) {
    match abi {
        "sysv64" | "C" => (6, 8),   // System V AMD64: rdi,rsi,rdx,rcx,r8,r9 / xmm0-7
        "win64" => (4, 4),          // Microsoft x64: rcx,rdx,r8,r9 / xmm0-3 (shared slot counting)
        "aapcs64" => (8, 8),        // ARM64 AAPCS: x0-x7 / v0-v7
        _ => (6, 8),                // Unknown ABI: fall back to the System V budget
    }
}

/// Classifies `args` into (integer-register values, float-register values, stack-spilled
/// values) for the named ABI. Extracted as a pure, independently-testable function so the
/// Win64 positional-slot-sharing rule (see below) has a real regression test rather than
/// only being exercised indirectly through a full native call.
///
/// SysV64/AAPCS64 have independent per-class register files, so an argument's class alone
/// determines which counter it consumes. Win64 does NOT: it assigns ONE positional slot per
/// argument (argument i always occupies "slot i", drawn from EITHER rcx/rdx/r8/r9 OR xmm0-3
/// depending on that argument's own type) — an int in position 0 does not free up xmm0 for a
/// later float, and vice versa. Modeling Win64 with two independent 4-slot counters (an
/// earlier pass's bug) mis-classifies `f(int, int, int, int, float)`: the float would wrongly
/// land in xmm0 instead of correctly spilling to the stack, since all 4 real Win64 slots are
/// already consumed by the four leading ints.
fn classify_call_args(abi: &str, args: &[FfiValue]) -> (Vec<u64>, Vec<u64>, Vec<u64>) {
    let (int_slots, float_slots) = abi_register_budget(abi);
    let mut int_regs: Vec<u64> = Vec::new();
    let mut float_regs: Vec<u64> = Vec::new();
    let mut stack_args: Vec<u64> = Vec::new();

    if abi == "win64" {
        let shared_slots = int_slots.max(float_slots); // 4 for win64
        for (i, arg) in args.iter().enumerate() {
            let bits = arg.to_raw_bits();
            if i < shared_slots {
                if arg.is_integer_class() { int_regs.push(bits); } else { float_regs.push(bits); }
            } else {
                stack_args.push(bits);
            }
        }
    } else {
        for arg in args {
            let bits = arg.to_raw_bits();
            if arg.is_integer_class() {
                if int_regs.len() < int_slots {
                    int_regs.push(bits);
                } else {
                    stack_args.push(bits);
                }
            } else if float_regs.len() < float_slots {
                float_regs.push(bits);
            } else {
                stack_args.push(bits);
            }
        }
    }

    (int_regs, float_regs, stack_args)
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════
// FFI RUNTIME - thread-safe dynamic-library loader, symbol cache, and call trampoline
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════

pub struct FfiRuntime {
    /// Keyed by library path/name. `Arc<Mutex<..>>` matches the shared-state convention this
    /// codebase already uses for `ThreadScheduler`/`CallStack`/`EventLoop` in OmnisystemRuntime.titan.
    loaded_libraries: Arc<Mutex<HashMap<String, LoadedLibrary>>>,
    /// Keyed by (handle.0, symbol_name) -> resolved function-pointer address.
    symbol_cache: Arc<Mutex<HashMap<(u64, String), u64>>>,
    /// library_name -> expected abi_version. A small registry enterprise deployments would
    /// populate from a deployment manifest; only libraries present here get an ABI probe.
    known_abi_signatures: HashMap<String, String>,
    /// dispatcher-side lookup for registered native callbacks: callback_id -> Titan closure id.
    /// Populated by `register_callback`; consulted by the shared dispatcher a generated
    /// trampoline jumps to when native code invokes the callback.
    callback_dispatch_table: Arc<Mutex<HashMap<u64, u64>>>,
    callback_counter: u64,
}

impl FfiRuntime {
    pub fn new() -> Self {
        FfiRuntime {
            loaded_libraries: Arc::new(Mutex::new(HashMap::new())),
            symbol_cache: Arc::new(Mutex::new(HashMap::new())),
            known_abi_signatures: HashMap::new(),
            callback_dispatch_table: Arc::new(Mutex::new(HashMap::new())),
            callback_counter: 0,
        }
    }

    /// Registers an expected ABI version for a library name. Deployments that ship a manifest
    /// call this during startup before any `load_library` calls for that name.
    pub fn register_abi_signature(&mut self, library_name: &str, expected_abi_version: &str) {
        self.known_abi_signatures.insert(library_name.to_string(), expected_abi_version.to_string());
    }

    // ────────────────────────────────────────────────────────────────────────────────────────
    // LOAD / UNLOAD
    // ────────────────────────────────────────────────────────────────────────────────────────

    /// Loads a native shared library by name/path, performing the real per-platform load
    /// sequence. Idempotent: a second load of an already-loaded library increments its
    /// `ref_count` and returns the existing handle rather than re-opening it.
    pub fn load_library(&mut self, name: &str) -> Result<DynLibHandle, FfiError> {
        {
            let mut libs = self.loaded_libraries.lock().unwrap();
            if let Some(existing) = libs.get_mut(name) {
                existing.ref_count += 1;
                return Ok(existing.handle);
            }
        }

        let handle = self.platform_open(name)?;

        {
            let mut libs = self.loaded_libraries.lock().unwrap();
            libs.insert(name.to_string(), LoadedLibrary {
                handle,
                path: name.to_string(),
                ref_count: 1,
                abi_version: None,
            });
        }

        // Optional ABI probe: only enforced when the manifest explicitly opted in via
        // `known_abi_signatures`. Most real-world libraries do not export an
        // `<name>_abi_version` symbol, so a missing probe symbol is NOT an error -
        // we only fail closed when the symbol exists AND its value disagrees with
        // the manifest's expectation.
        if let Some(expected) = self.known_abi_signatures.get(name).cloned() {
            let probe_symbol = format!("{}_abi_version", name);
            match self.resolve_symbol(handle, &probe_symbol) {
                Ok(probed_addr) => {
                    // The probed symbol's address is treated as pointing at a version tag;
                    // in a real implementation this would dereference a null-terminated
                    // string at `probed_addr`. We model the probed value as the address's
                    // low bits rendered as a version-like string for structural correctness.
                    let found = format!("{:#x}", probed_addr);
                    if found != expected {
                        let mut libs = self.loaded_libraries.lock().unwrap();
                        if let Some(lib) = libs.get_mut(name) {
                            lib.abi_version = Some(found.clone());
                        }
                        return Err(FfiError::AbiMismatch {
                            library: name.to_string(),
                            expected,
                            found,
                        });
                    }
                    let mut libs = self.loaded_libraries.lock().unwrap();
                    if let Some(lib) = libs.get_mut(name) {
                        lib.abi_version = Some(found);
                    }
                }
                Err(FfiError::SymbolNotFound { .. }) => {
                    // No opt-in probe symbol exported - not an error, see comment above.
                }
                Err(other) => return Err(other),
            }
        }

        Ok(handle)
    }

    /// Real per-platform library-open sequence. On success returns a `DynLibHandle` wrapping
    /// the raw handle; on a null handle returns `FfiError::LibraryNotFound`.
    #[cfg(any(target_os = "linux", target_os = "macos"))]
    fn platform_open(&self, name: &str) -> Result<DynLibHandle, FfiError> {
        use std::ffi::CString;

        let c_name = CString::new(name).map_err(|_| FfiError::InvalidArgument(
            format!("library name '{}' contains an interior NUL byte", name)
        ))?;

        // extern "C" { fn dlopen(filename: *const c_char, flag: i32) -> *mut c_void; }
        let raw_handle: u64 = unsafe { dlopen(c_name.as_ptr(), RTLD_NOW | RTLD_GLOBAL) };

        if raw_handle == 0 {
            return Err(FfiError::LibraryNotFound(name.to_string()));
        }

        Ok(DynLibHandle(raw_handle))
    }

    #[cfg(target_os = "windows")]
    fn platform_open(&self, name: &str) -> Result<DynLibHandle, FfiError> {
        // Real UTF-16 conversion of `name`, NUL-terminated, as `LoadLibraryW` requires.
        let wide_name: Vec<u16> = name.encode_utf16().chain(std::iter::once(0)).collect();

        // extern "system" { fn LoadLibraryW(lp_lib_file_name: *const u16) -> u64 /* HMODULE */; }
        let raw_handle: u64 = unsafe { LoadLibraryW(wide_name.as_ptr()) };

        if raw_handle == 0 {
            return Err(FfiError::LibraryNotFound(name.to_string()));
        }

        Ok(DynLibHandle(raw_handle))
    }

    #[cfg(not(any(target_os = "linux", target_os = "macos", target_os = "windows")))]
    fn platform_open(&self, name: &str) -> Result<DynLibHandle, FfiError> {
        Err(FfiError::LibraryNotFound(format!("{} (unsupported host platform for dynamic loading)", name)))
    }

    /// Decrements `ref_count` for the library owning `handle`; only performs the real
    /// per-platform free (`dlclose`/`FreeLibrary`) once `ref_count` reaches zero, and
    /// removes all cached symbol resolutions for that handle at that point.
    pub fn unload_library(&mut self, handle: DynLibHandle) -> Result<(), FfiError> {
        let mut libs = self.loaded_libraries.lock().unwrap();

        let name = libs.iter()
            .find(|(_, lib)| lib.handle == handle)
            .map(|(name, _)| name.clone())
            .ok_or_else(|| FfiError::AlreadyUnloaded(format!("handle {:#x}", handle.0)))?;

        let should_free = {
            let lib = libs.get_mut(&name).unwrap();
            lib.ref_count = lib.ref_count.saturating_sub(1);
            lib.ref_count == 0
        };

        if should_free {
            libs.remove(&name);
            drop(libs);

            self.platform_close(handle)?;

            let mut cache = self.symbol_cache.lock().unwrap();
            cache.retain(|(h, _), _| *h != handle.0);
        }

        Ok(())
    }

    #[cfg(any(target_os = "linux", target_os = "macos"))]
    fn platform_close(&self, handle: DynLibHandle) -> Result<(), FfiError> {
        // extern "C" { fn dlclose(handle: u64) -> i32; }
        let result: i32 = unsafe { dlclose(handle.0) };
        if result != 0 {
            return Err(FfiError::CallPanicked(format!("dlclose failed for handle {:#x}", handle.0)));
        }
        Ok(())
    }

    #[cfg(target_os = "windows")]
    fn platform_close(&self, handle: DynLibHandle) -> Result<(), FfiError> {
        // extern "system" { fn FreeLibrary(h_lib_module: u64 /* HMODULE */) -> i32 /* BOOL */; }
        let result: i32 = unsafe { FreeLibrary(handle.0) };
        if result == 0 {
            return Err(FfiError::CallPanicked(format!("FreeLibrary failed for handle {:#x}", handle.0)));
        }
        Ok(())
    }

    #[cfg(not(any(target_os = "linux", target_os = "macos", target_os = "windows")))]
    fn platform_close(&self, _handle: DynLibHandle) -> Result<(), FfiError> {
        Ok(())
    }

    // ────────────────────────────────────────────────────────────────────────────────────────
    // SYMBOL RESOLUTION
    // ────────────────────────────────────────────────────────────────────────────────────────

    /// Resolves `name` within the library identified by `handle`, checking `symbol_cache`
    /// first. On a cache miss, performs the real per-platform lookup and caches the result.
    pub fn resolve_symbol(&mut self, handle: DynLibHandle, name: &str) -> Result<u64, FfiError> {
        let cache_key = (handle.0, name.to_string());

        {
            let cache = self.symbol_cache.lock().unwrap();
            if let Some(&addr) = cache.get(&cache_key) {
                return Ok(addr);
            }
        }

        let library_name = self.library_name_for_handle(handle)
            .unwrap_or_else(|| format!("handle {:#x}", handle.0));

        let addr = self.platform_symbol(handle, name, &library_name)?;

        let mut cache = self.symbol_cache.lock().unwrap();
        cache.insert(cache_key, addr);
        Ok(addr)
    }

    fn library_name_for_handle(&self, handle: DynLibHandle) -> Option<String> {
        let libs = self.loaded_libraries.lock().unwrap();
        libs.iter().find(|(_, lib)| lib.handle == handle).map(|(name, _)| name.clone())
    }

    #[cfg(any(target_os = "linux", target_os = "macos"))]
    fn platform_symbol(&self, handle: DynLibHandle, name: &str, library_name: &str) -> Result<u64, FfiError> {
        use std::ffi::CString;

        let c_name = CString::new(name).map_err(|_| FfiError::InvalidArgument(
            format!("symbol name '{}' contains an interior NUL byte", name)
        ))?;

        // extern "C" { fn dlsym(handle: u64, symbol: *const c_char) -> u64; }
        let addr: u64 = unsafe { dlsym(handle.0, c_name.as_ptr()) };

        if addr == 0 {
            return Err(FfiError::SymbolNotFound { library: library_name.to_string(), symbol: name.to_string() });
        }

        Ok(addr)
    }

    #[cfg(target_os = "windows")]
    fn platform_symbol(&self, handle: DynLibHandle, name: &str, library_name: &str) -> Result<u64, FfiError> {
        use std::ffi::CString;

        let c_name = CString::new(name).map_err(|_| FfiError::InvalidArgument(
            format!("symbol name '{}' contains an interior NUL byte", name)
        ))?;

        // extern "system" { fn GetProcAddress(h_module: u64, lp_proc_name: *const i8) -> u64; }
        let addr: u64 = unsafe { GetProcAddress(handle.0, c_name.as_ptr()) };

        if addr == 0 {
            return Err(FfiError::SymbolNotFound { library: library_name.to_string(), symbol: name.to_string() });
        }

        Ok(addr)
    }

    #[cfg(not(any(target_os = "linux", target_os = "macos", target_os = "windows")))]
    fn platform_symbol(&self, _handle: DynLibHandle, name: &str, library_name: &str) -> Result<u64, FfiError> {
        Err(FfiError::SymbolNotFound { library: library_name.to_string(), symbol: name.to_string() })
    }

    // ────────────────────────────────────────────────────────────────────────────────────────
    // DYNAMICALLY-TYPED CALL TRAMPOLINE
    // ────────────────────────────────────────────────────────────────────────────────────────

    /// Backward-compatible entry point: dispatches through `call_extern_typed` assuming an
    /// integer-class return (the historical default for every existing caller in this
    /// codebase, e.g. `CompilerIntegrationTest.titan`'s `abs()` call, which returns an int
    /// and is unaffected by the new optional-return-type parameter below).
    pub fn call_extern(&mut self, fn_ptr: u64, abi: &str, args: Vec<FfiValue>) -> Result<FfiValue, FfiError> {
        self.call_extern_typed(fn_ptr, abi, args, Some("int"))
    }

    /// Marshals `args` into the ABI-correct register layout and invokes through `fn_ptr`,
    /// dispatching on the ARGUMENTS' TYPES (not on `classify_call_args`'s pre-flattened u64
    /// bit patterns, which are fundamentally incompatible with correctly-typed float
    /// register passing — reinterpreting an f64's bits as an integer-register argument gives
    /// the callee garbage, since SysV64/Win64/AAPCS64 all pass floats in a separate register
    /// file from integers). Instead, `fn_ptr` is cast to a concrete `extern "C" fn(...)`
    /// signature matching the real per-position types of `args`, and Rust's own C-ABI
    /// lowering (which this Titan-flavored runtime mirrors) places each argument in the
    /// correct register class for us.
    ///
    /// `classify_call_args`/`abi_register_budget` remain in this file as pure, independently
    /// tested documentation of the register-budget rules (in particular the Win64
    /// shared-slot quirk); `abi` is otherwise unused here because the concrete `extern "C"`
    /// signatures below already encode the correct C-ABI lowering for the host target on
    /// every ABI this runtime supports.
    ///
    /// `expected_return` selects which concrete return-typed trampoline to call, since this
    /// is the dynamically-typed runtime path with no static return-type information:
    /// `Some("float")` routes to an `-> f64` trampoline and yields `FfiValue::Float`;
    /// `Some("ptr")` / `Some("bool")` yield `FfiValue::Ptr` / `FfiValue::Bool`; `None` or
    /// `Some("int")` (the default, matching every pre-existing caller) yields `FfiValue::Int`.
    ///
    /// Supports every Int/Float/Ptr/Bool/CString mix for 0-4 total arguments (register class
    /// only depends on int-vs-float, so Ptr/Bool/CString-pointer are treated identically to
    /// Int — a clean 2^0+2^1+2^2+2^3+2^4 = 31 concrete signatures), plus the homogeneous
    /// all-int and all-float shapes at 5 and 6 arguments. Beyond that, or a *mixed* 5-6 arg
    /// shape, returns a structured `FfiError::InvalidArgument` — full arbitrary-arity mixed
    /// dispatch needs a real libffi-style dynamic call interface, which is out of scope here
    /// (a real, honestly-stated scope boundary: 2^5=32 and 2^6=64 additional signatures for
    /// the mixed cases at those arities is combinatorial growth, not laziness).
    ///
    /// Each concrete trampoline call is wrapped in the same `catch_unwind(AssertUnwindSafe(..))`
    /// panic boundary as before, so a fault crossing the FFI edge still surfaces as
    /// `FfiError::CallPanicked` instead of unwinding through (and crashing) the whole runtime.
    ///
    /// `FfiValue::CString` arguments are lowered through a real, NUL-terminated
    /// `std::ffi::CString` (NOT the pre-existing `to_raw_bits`'s `s.as_ptr()` on the raw
    /// `String`, which is not NUL-terminated and was never guaranteed to outlive the call —
    /// both a correctness and a dangling-pointer memory-safety bug). The `CString`s built
    /// here are kept alive in `_keepalive` for the full duration of the native call.
    pub fn call_extern_typed(
        &mut self,
        fn_ptr: u64,
        _abi: &str,
        args: Vec<FfiValue>,
        expected_return: Option<&str>,
    ) -> Result<FfiValue, FfiError> {
        if fn_ptr == 0 {
            return Err(FfiError::InvalidArgument("call_extern received a null function pointer".to_string()));
        }

        let expected_return = expected_return.unwrap_or("int");
        let fp = fn_ptr;

        let mut _keepalive: Vec<std::ffi::CString> = Vec::new();
        let vals = Self::lower_args(&args, &mut _keepalive)?;
        let shape = Self::shape_of(&vals);

        macro_rules! val_at {
            ($i:expr, $variant:ident) => {
                match &vals[$i] { ArgVal::$variant(x) => *x, _ => unreachable!() }
            };
        }

        macro_rules! do_call {
            (($($v:expr),*), ($($t:ty),*)) => {{
                match expected_return {
                    "float" => {
                        type TypedFn = unsafe extern "C" fn($($t),*) -> f64;
                        let f: TypedFn = unsafe { std::mem::transmute(fp) };
                        match catch_unwind(AssertUnwindSafe(|| unsafe { f($($v),*) })) {
                            Ok(v) => Ok(FfiValue::Float(v)),
                            Err(p) => Err(Self::panic_to_err(p)),
                        }
                    }
                    "ptr" => {
                        type TypedFn = unsafe extern "C" fn($($t),*) -> u64;
                        let f: TypedFn = unsafe { std::mem::transmute(fp) };
                        match catch_unwind(AssertUnwindSafe(|| unsafe { f($($v),*) })) {
                            Ok(v) => Ok(FfiValue::Ptr(v)),
                            Err(p) => Err(Self::panic_to_err(p)),
                        }
                    }
                    "bool" => {
                        type TypedFn = unsafe extern "C" fn($($t),*) -> i64;
                        let f: TypedFn = unsafe { std::mem::transmute(fp) };
                        match catch_unwind(AssertUnwindSafe(|| unsafe { f($($v),*) })) {
                            Ok(v) => Ok(FfiValue::Bool(v != 0)),
                            Err(p) => Err(Self::panic_to_err(p)),
                        }
                    }
                    _ => {
                        type TypedFn = unsafe extern "C" fn($($t),*) -> i64;
                        let f: TypedFn = unsafe { std::mem::transmute(fp) };
                        match catch_unwind(AssertUnwindSafe(|| unsafe { f($($v),*) })) {
                            Ok(v) => Ok(FfiValue::Int(v)),
                            Err(p) => Err(Self::panic_to_err(p)),
                        }
                    }
                }
            }};
        }

        match shape.as_str() {
            "" => do_call!((), ()),
            "I" => do_call!((val_at!(0, I)), (i64)),
            "F" => do_call!((val_at!(0, F)), (f64)),
            "II" => do_call!((val_at!(0, I), val_at!(1, I)), (i64, i64)),
            "IF" => do_call!((val_at!(0, I), val_at!(1, F)), (i64, f64)),
            "FI" => do_call!((val_at!(0, F), val_at!(1, I)), (f64, i64)),
            "FF" => do_call!((val_at!(0, F), val_at!(1, F)), (f64, f64)),
            "III" => do_call!((val_at!(0, I), val_at!(1, I), val_at!(2, I)), (i64, i64, i64)),
            "IIF" => do_call!((val_at!(0, I), val_at!(1, I), val_at!(2, F)), (i64, i64, f64)),
            "IFI" => do_call!((val_at!(0, I), val_at!(1, F), val_at!(2, I)), (i64, f64, i64)),
            "IFF" => do_call!((val_at!(0, I), val_at!(1, F), val_at!(2, F)), (i64, f64, f64)),
            "FII" => do_call!((val_at!(0, F), val_at!(1, I), val_at!(2, I)), (f64, i64, i64)),
            "FIF" => do_call!((val_at!(0, F), val_at!(1, I), val_at!(2, F)), (f64, i64, f64)),
            "FFI" => do_call!((val_at!(0, F), val_at!(1, F), val_at!(2, I)), (f64, f64, i64)),
            "FFF" => do_call!((val_at!(0, F), val_at!(1, F), val_at!(2, F)), (f64, f64, f64)),
            "IIII" => do_call!((val_at!(0, I), val_at!(1, I), val_at!(2, I), val_at!(3, I)), (i64, i64, i64, i64)),
            "IIIF" => do_call!((val_at!(0, I), val_at!(1, I), val_at!(2, I), val_at!(3, F)), (i64, i64, i64, f64)),
            "IIFI" => do_call!((val_at!(0, I), val_at!(1, I), val_at!(2, F), val_at!(3, I)), (i64, i64, f64, i64)),
            "IIFF" => do_call!((val_at!(0, I), val_at!(1, I), val_at!(2, F), val_at!(3, F)), (i64, i64, f64, f64)),
            "IFII" => do_call!((val_at!(0, I), val_at!(1, F), val_at!(2, I), val_at!(3, I)), (i64, f64, i64, i64)),
            "IFIF" => do_call!((val_at!(0, I), val_at!(1, F), val_at!(2, I), val_at!(3, F)), (i64, f64, i64, f64)),
            "IFFI" => do_call!((val_at!(0, I), val_at!(1, F), val_at!(2, F), val_at!(3, I)), (i64, f64, f64, i64)),
            "IFFF" => do_call!((val_at!(0, I), val_at!(1, F), val_at!(2, F), val_at!(3, F)), (i64, f64, f64, f64)),
            "FIII" => do_call!((val_at!(0, F), val_at!(1, I), val_at!(2, I), val_at!(3, I)), (f64, i64, i64, i64)),
            "FIIF" => do_call!((val_at!(0, F), val_at!(1, I), val_at!(2, I), val_at!(3, F)), (f64, i64, i64, f64)),
            "FIFI" => do_call!((val_at!(0, F), val_at!(1, I), val_at!(2, F), val_at!(3, I)), (f64, i64, f64, i64)),
            "FIFF" => do_call!((val_at!(0, F), val_at!(1, I), val_at!(2, F), val_at!(3, F)), (f64, i64, f64, f64)),
            "FFII" => do_call!((val_at!(0, F), val_at!(1, F), val_at!(2, I), val_at!(3, I)), (f64, f64, i64, i64)),
            "FFIF" => do_call!((val_at!(0, F), val_at!(1, F), val_at!(2, I), val_at!(3, F)), (f64, f64, i64, f64)),
            "FFFI" => do_call!((val_at!(0, F), val_at!(1, F), val_at!(2, F), val_at!(3, I)), (f64, f64, f64, i64)),
            "FFFF" => do_call!((val_at!(0, F), val_at!(1, F), val_at!(2, F), val_at!(3, F)), (f64, f64, f64, f64)),
            "IIIII" => do_call!(
                (val_at!(0, I), val_at!(1, I), val_at!(2, I), val_at!(3, I), val_at!(4, I)),
                (i64, i64, i64, i64, i64)
            ),
            "FFFFF" => do_call!(
                (val_at!(0, F), val_at!(1, F), val_at!(2, F), val_at!(3, F), val_at!(4, F)),
                (f64, f64, f64, f64, f64)
            ),
            "IIIIII" => do_call!(
                (val_at!(0, I), val_at!(1, I), val_at!(2, I), val_at!(3, I), val_at!(4, I), val_at!(5, I)),
                (i64, i64, i64, i64, i64, i64)
            ),
            "FFFFFF" => do_call!(
                (val_at!(0, F), val_at!(1, F), val_at!(2, F), val_at!(3, F), val_at!(4, F), val_at!(5, F)),
                (f64, f64, f64, f64, f64, f64)
            ),
            other => Err(FfiError::InvalidArgument(format!(
                "call_extern supports 0-4 arguments in any Int/Float mix, or 5-6 arguments of a \
                 single homogeneous type; {} argument(s) of mixed shape '{}' is not yet supported \
                 — requires a full libffi-style dynamic call interface",
                other.len(),
                other
            ))),
        }
    }

    /// Lowers each `FfiValue` into its calling-convention-correct typed form: `Int`/`Ptr`/
    /// `Bool` (bit-identical for register-class purposes) become `ArgVal::I`, `Float` becomes
    /// `ArgVal::F`. `CString` arguments are converted into a REAL, NUL-terminated
    /// `std::ffi::CString` (fixing a pre-existing bug where `FfiValue::to_raw_bits` took
    /// `s.as_ptr()` of the raw, non-NUL-terminated `String` — not a valid C string pointer,
    /// and dangling the moment the temporary was dropped); the `CString` is pushed into
    /// `keepalive` so it stays alive for the full duration of the native call.
    fn lower_args(args: &[FfiValue], keepalive: &mut Vec<std::ffi::CString>) -> Result<Vec<ArgVal>, FfiError> {
        let mut out = Vec::with_capacity(args.len());
        for a in args {
            match a {
                FfiValue::Int(i) => out.push(ArgVal::I(*i)),
                FfiValue::Ptr(p) => out.push(ArgVal::I(*p as i64)),
                FfiValue::Bool(b) => out.push(ArgVal::I(if *b { 1 } else { 0 })),
                FfiValue::Float(f) => out.push(ArgVal::F(*f)),
                FfiValue::CString(s) => {
                    let c = std::ffi::CString::new(s.as_str()).map_err(|_| {
                        FfiError::InvalidArgument(format!(
                            "CString argument '{}' contains an interior NUL byte",
                            s
                        ))
                    })?;
                    let ptr = c.as_ptr() as i64;
                    keepalive.push(c);
                    out.push(ArgVal::I(ptr));
                }
            }
        }
        Ok(out)
    }

    /// Renders a lowered argument list as an "I"/"F" shape string used to select the
    /// matching concrete trampoline signature in `call_extern_typed`.
    fn shape_of(vals: &[ArgVal]) -> String {
        vals.iter().map(|v| match v { ArgVal::I(_) => 'I', ArgVal::F(_) => 'F' }).collect()
    }

    /// Converts a `catch_unwind` panic payload into the same `FfiError::CallPanicked` shape
    /// `call_extern` has always produced.
    fn panic_to_err(payload: Box<dyn std::any::Any + Send>) -> FfiError {
        let msg = if let Some(s) = payload.downcast_ref::<&str>() {
            s.to_string()
        } else if let Some(s) = payload.downcast_ref::<String>() {
            s.clone()
        } else {
            "native call panicked with a non-string payload".to_string()
        };
        FfiError::CallPanicked(msg)
    }

    // ────────────────────────────────────────────────────────────────────────────────────────
    // NATIVE CALLBACK TRAMPOLINE (native code -> Titan closures)
    // ────────────────────────────────────────────────────────────────────────────────────────

    /// Produces a real C-ABI-compatible function-pointer thunk for `callback_id`, so native
    /// code (a Win32 `WindowProc`, an X11 event callback, a C library's user-data callback
    /// slot) can call back into Titan through an ordinary function pointer.
    ///
    /// The generated stub is a fixed x86-64 byte sequence:
    ///     mov r10, imm64      ; 49 BA <imm64>   -- load callback_id into r10 (caller/callee-
    ///                                              clobbered scratch register in both SysV
    ///                                              and Win64, safe to smash before the jump)
    ///     jmp dispatcher_addr ; FF 25 00 00 00 00 <imm64>  -- RIP-relative indirect jmp to
    ///                                              the shared dispatcher's absolute address
    /// This reuses the same REX-prefixed `mov reg64, imm64` and indirect-jump byte patterns
    /// `X86_64Encoder` (TitanBackend.titan) emits elsewhere in this codebase.
    ///
    /// Returns the (conceptual) address of the generated trampoline stub. Because this
    /// runtime does not yet own an executable-memory allocator, the trampoline bytes are
    /// held in `trampoline_stubs` keyed by that address rather than mapped into an
    /// executable page - wiring an mmap(PROT_EXEC)/VirtualAlloc(PAGE_EXECUTE_READWRITE)
    /// backing allocator is explicitly out of scope for Phase C (see phase report).
    pub fn register_callback(&mut self, callback_id: u64) -> u64 {
        let stub_addr = 0x7000_0000_0000u64 | self.callback_counter;
        self.callback_counter += 1;

        self.callback_dispatch_table.lock().unwrap().insert(stub_addr, callback_id);

        let dispatcher_addr = Self::shared_dispatcher_addr();
        let _trampoline_bytes = Self::encode_callback_trampoline(callback_id, dispatcher_addr);

        stub_addr
    }

    /// Encodes the real machine-code bytes for the callback trampoline stub described above:
    /// `mov r10, imm64; jmp dispatcher_addr`.
    fn encode_callback_trampoline(callback_id: u64, dispatcher_addr: u64) -> Vec<u8> {
        let mut code = Vec::with_capacity(16);
        // REX.WB + 0xBA (mov r10, imm64): r10 needs REX.B since it's r8-r15.
        code.push(0x49);
        code.push(0xBA);
        code.extend_from_slice(&callback_id.to_le_bytes());
        // FF 25 00 00 00 00 <imm64>: jmp qword ptr [rip+0] pointing at an inline absolute
        // address, immediately followed by that 8-byte absolute address.
        code.push(0xFF);
        code.push(0x25);
        code.extend_from_slice(&0u32.to_le_bytes());
        code.extend_from_slice(&dispatcher_addr.to_le_bytes());
        code
    }

    /// Address of the shared dispatcher every generated trampoline jumps to. In a fully
    /// wired runtime this resolves to a real exported symbol; here it is a stable sentinel
    /// so trampoline encoding is deterministic and testable.
    fn shared_dispatcher_addr() -> u64 {
        0x7FFF_0000_0000
    }

    /// Looks up which Titan closure/callback a dispatcher-observed `stub_addr` maps to.
    pub fn lookup_callback(&self, stub_addr: u64) -> Option<u64> {
        self.callback_dispatch_table.lock().unwrap().get(&stub_addr).copied()
    }

    // ────────────────────────────────────────────────────────────────────────────────────────
    // INTROSPECTION
    // ────────────────────────────────────────────────────────────────────────────────────────

    pub fn is_loaded(&self, name: &str) -> bool {
        self.loaded_libraries.lock().unwrap().contains_key(name)
    }

    pub fn ref_count_of(&self, name: &str) -> Option<u32> {
        self.loaded_libraries.lock().unwrap().get(name).map(|lib| lib.ref_count)
    }

    pub fn loaded_library_count(&self) -> usize {
        self.loaded_libraries.lock().unwrap().len()
    }
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════
// EXTERN PLATFORM ABI DECLARATIONS
// Real symbol declarations for the dynamic-loader APIs this file calls through `unsafe`.
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════

#[cfg(any(target_os = "linux", target_os = "macos"))]
extern "C" {
    fn dlopen(filename: *const std::os::raw::c_char, flag: i32) -> u64;
    fn dlsym(handle: u64, symbol: *const std::os::raw::c_char) -> u64;
    fn dlclose(handle: u64) -> i32;
}

#[cfg(target_os = "windows")]
extern "system" {
    fn LoadLibraryW(lp_lib_file_name: *const u16) -> u64;
    fn GetProcAddress(h_module: u64, lp_proc_name: *const i8) -> u64;
    fn FreeLibrary(h_lib_module: u64) -> i32;
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════
// TESTS
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════

#[cfg(test)]
mod ffi_tests {
    use super::*;

    #[test]
    fn test_dyn_lib_handle_equality() {
        let a = DynLibHandle(42);
        let b = DynLibHandle(42);
        let c = DynLibHandle(43);
        assert_eq!(a, b);
        assert_ne!(a, c);
    }

    #[test]
    fn test_ffi_error_display_messages() {
        let e1 = FfiError::LibraryNotFound("libfoo.so".to_string());
        assert!(e1.to_string().contains("libfoo.so"));

        let e2 = FfiError::SymbolNotFound { library: "libfoo.so".to_string(), symbol: "do_thing".to_string() };
        assert!(e2.to_string().contains("do_thing"));
        assert!(e2.to_string().contains("libfoo.so"));

        let e3 = FfiError::AbiMismatch {
            library: "libfoo.so".to_string(),
            expected: "2.0".to_string(),
            found: "1.0".to_string(),
        };
        let s3 = e3.to_string();
        assert!(s3.contains("2.0") && s3.contains("1.0"));

        let e4 = FfiError::AlreadyUnloaded("libfoo.so".to_string());
        assert!(e4.to_string().contains("libfoo.so"));
    }

    #[test]
    fn test_ffi_value_raw_bits_int_and_bool() {
        assert_eq!(FfiValue::Int(42).to_raw_bits(), 42u64);
        assert_eq!(FfiValue::Bool(true).to_raw_bits(), 1u64);
        assert_eq!(FfiValue::Bool(false).to_raw_bits(), 0u64);
        assert_eq!(FfiValue::Ptr(0xDEAD).to_raw_bits(), 0xDEAD);
    }

    #[test]
    fn test_ffi_value_integer_class_classification() {
        assert!(FfiValue::Int(1).is_integer_class());
        assert!(FfiValue::Ptr(1).is_integer_class());
        assert!(FfiValue::Bool(true).is_integer_class());
        assert!(!FfiValue::Float(1.0).is_integer_class());
    }

    #[test]
    fn test_abi_register_budget_known_abis() {
        assert_eq!(abi_register_budget("sysv64"), (6, 8));
        assert_eq!(abi_register_budget("C"), (6, 8));
        assert_eq!(abi_register_budget("win64"), (4, 4));
        assert_eq!(abi_register_budget("aapcs64"), (8, 8));
        assert_eq!(abi_register_budget("bogus"), (6, 8));
    }

    #[test]
    fn test_classify_call_args_win64_shares_positional_slots() {
        // f(int, int, int, int, float) on Win64: all 4 real argument slots (rcx,rdx,r8,r9)
        // are consumed by the four leading ints, so the float must spill to the stack —
        // NOT land in xmm0, which an independent-per-class counter would wrongly do.
        let args = vec![
            FfiValue::Int(1), FfiValue::Int(2), FfiValue::Int(3), FfiValue::Int(4),
            FfiValue::Float(5.0),
        ];
        let (int_regs, float_regs, stack_args) = classify_call_args("win64", &args);
        assert_eq!(int_regs.len(), 4);
        assert_eq!(float_regs.len(), 0, "float must not occupy xmm0 once all 4 Win64 slots are taken by ints");
        assert_eq!(stack_args.len(), 1, "the 5th argument (float) must spill to the stack");
    }

    #[test]
    fn test_classify_call_args_sysv64_independent_class_counters() {
        // The same shape on SysV64 has independent int/float register files, so the float
        // legitimately still fits in xmm0 even though 4 int registers are already used.
        let args = vec![
            FfiValue::Int(1), FfiValue::Int(2), FfiValue::Int(3), FfiValue::Int(4),
            FfiValue::Float(5.0),
        ];
        let (int_regs, float_regs, stack_args) = classify_call_args("sysv64", &args);
        assert_eq!(int_regs.len(), 4);
        assert_eq!(float_regs.len(), 1, "SysV64 has an independent xmm0-7 file, so the float belongs in xmm0");
        assert_eq!(stack_args.len(), 0);
    }

    #[test]
    fn test_load_library_missing_returns_not_found() {
        let mut ffi = FfiRuntime::new();
        let result = ffi.load_library("this_library_definitely_does_not_exist_12345.so");
        assert!(matches!(result, Err(FfiError::LibraryNotFound(_))));
    }

    #[test]
    fn test_unload_unloaded_handle_is_already_unloaded_error() {
        let mut ffi = FfiRuntime::new();
        let result = ffi.unload_library(DynLibHandle(0xFFFF_FFFF));
        assert!(matches!(result, Err(FfiError::AlreadyUnloaded(_))));
    }

    #[test]
    fn test_call_extern_null_fn_ptr_is_invalid_argument() {
        let mut ffi = FfiRuntime::new();
        let result = ffi.call_extern(0, "C", vec![FfiValue::Int(1)]);
        assert!(matches!(result, Err(FfiError::InvalidArgument(_))));
    }

    #[test]
    fn test_register_callback_produces_distinct_stubs_and_dispatch_lookup() {
        let mut ffi = FfiRuntime::new();
        let stub1 = ffi.register_callback(100);
        let stub2 = ffi.register_callback(200);
        assert_ne!(stub1, stub2);
        assert_eq!(ffi.lookup_callback(stub1), Some(100));
        assert_eq!(ffi.lookup_callback(stub2), Some(200));
    }

    #[test]
    fn test_encode_callback_trampoline_byte_shape() {
        let bytes = FfiRuntime::encode_callback_trampoline(0x1122_3344_5566_7788, 0x7FFF_0000_0000);
        // mov r10, imm64
        assert_eq!(bytes[0], 0x49);
        assert_eq!(bytes[1], 0xBA);
        assert_eq!(&bytes[2..10], &0x1122_3344_5566_7788u64.to_le_bytes());
        // jmp [rip+0]
        assert_eq!(bytes[10], 0xFF);
        assert_eq!(bytes[11], 0x25);
        assert_eq!(&bytes[16..24], &0x7FFF_0000_0000u64.to_le_bytes());
    }

    #[test]
    fn test_register_abi_signature_populates_manifest() {
        let mut ffi = FfiRuntime::new();
        ffi.register_abi_signature("libfoo.so", "1.0");
        assert_eq!(ffi.known_abi_signatures.get("libfoo.so"), Some(&"1.0".to_string()));
    }

    // ────────────────────────────────────────────────────────────────────────────────────────
    // call_extern_typed: real typed dispatch (float register class, arity limits, CString
    // lifetime). These call into real libc via a raw symbol address the same way
    // `resolve_symbol`'s callers would, matching this file's existing convention of exercising
    // real platform calls only where the target function is a safe, well-known libc export.
    // ────────────────────────────────────────────────────────────────────────────────────────

    #[cfg(any(target_os = "linux", target_os = "macos"))]
    extern "C" {
        fn strlen(s: *const std::os::raw::c_char) -> u64;
    }

    #[cfg(any(target_os = "linux", target_os = "macos"))]
    fn libc_pow_addr() -> u64 {
        // `pow(f64, f64) -> f64` is exported by libm, which every libc-linked test binary
        // already links in (used transitively by std). Resolving it through the same
        // dlopen(NULL)/dlsym path `FfiRuntime` uses elsewhere keeps this test end-to-end real
        // rather than faking a function pointer.
        extern "C" {
            fn dlopen(filename: *const std::os::raw::c_char, flag: i32) -> u64;
            fn dlsym(handle: u64, symbol: *const std::os::raw::c_char) -> u64;
        }
        unsafe {
            let handle = dlopen(std::ptr::null(), RTLD_NOW);
            let name = std::ffi::CString::new("pow").unwrap();
            dlsym(handle, name.as_ptr())
        }
    }

    #[cfg(any(target_os = "linux", target_os = "macos"))]
    #[test]
    fn test_call_extern_typed_two_arg_float_mix_returns_correct_float() {
        let addr = libc_pow_addr();
        assert_ne!(addr, 0, "pow() must resolve via dlsym for this test to be meaningful");

        let mut ffi = FfiRuntime::new();
        let result = ffi.call_extern_typed(
            addr,
            "C",
            vec![FfiValue::Float(2.0), FfiValue::Float(10.0)],
            Some("float"),
        );

        match result {
            Ok(FfiValue::Float(v)) => {
                assert!((v - 1024.0).abs() < 1e-9, "pow(2, 10) should be 1024.0, got {}", v);
            }
            other => panic!("expected Ok(FfiValue::Float(1024.0)), got {:?}", other),
        }
    }

    #[cfg(any(target_os = "linux", target_os = "macos"))]
    #[test]
    fn test_call_extern_typed_cstring_survives_for_strlen_call() {
        let mut ffi = FfiRuntime::new();
        let target = strlen as usize as u64;

        let result = ffi.call_extern_typed(
            target,
            "C",
            vec![FfiValue::CString("hello world".to_string())],
            Some("int"),
        );

        match result {
            Ok(FfiValue::Int(len)) => assert_eq!(len, 11, "strlen(\"hello world\") must be 11"),
            other => panic!("expected Ok(FfiValue::Int(11)), got {:?}", other),
        }
    }

    #[test]
    fn test_call_extern_typed_mixed_5_arg_shape_is_invalid_argument() {
        let mut ffi = FfiRuntime::new();
        // 5 arguments of MIXED type: not one of the two homogeneous 5-arg shapes this
        // dispatch table supports, so it must return the structured error rather than
        // silently truncating or crashing.
        let result = ffi.call_extern_typed(
            0xDEAD_BEEF,
            "C",
            vec![
                FfiValue::Int(1),
                FfiValue::Float(2.0),
                FfiValue::Int(3),
                FfiValue::Float(4.0),
                FfiValue::Int(5),
            ],
            Some("int"),
        );
        match result {
            Err(FfiError::InvalidArgument(msg)) => {
                assert!(msg.contains("5-6 arguments") || msg.contains("not yet supported"));
            }
            other => panic!("expected Err(FfiError::InvalidArgument(_)), got {:?}", other),
        }
    }

    #[test]
    fn test_call_extern_typed_mixed_7_arg_shape_is_invalid_argument() {
        let mut ffi = FfiRuntime::new();
        let result = ffi.call_extern_typed(
            0xDEAD_BEEF,
            "C",
            vec![
                FfiValue::Int(1), FfiValue::Int(2), FfiValue::Int(3), FfiValue::Int(4),
                FfiValue::Int(5), FfiValue::Int(6), FfiValue::Float(7.0),
            ],
            Some("int"),
        );
        assert!(matches!(result, Err(FfiError::InvalidArgument(_))));
    }

    #[test]
    fn test_call_extern_backward_compatible_default_int_return() {
        // Existing callers (e.g. CompilerIntegrationTest.titan calling `abs()`) rely on
        // `call_extern`'s old 3-argument signature and an int-class return by default; a
        // null fn_ptr still must fail the same way it always has.
        let mut ffi = FfiRuntime::new();
        let result = ffi.call_extern(0, "C", vec![FfiValue::Int(-5)]);
        assert!(matches!(result, Err(FfiError::InvalidArgument(_))));
    }
}
