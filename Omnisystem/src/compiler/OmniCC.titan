// ════════════════════════════════════════════════════════════════════════════════════════════════════════════
// OMNICC - OMNISYSTEM COMPILER & BUILD ORCHESTRATOR
// Real build pipeline: parse BUILD.omnisystem -> dispatch frontends -> parallel compile -> link -> optimize
// Language: TITAN — ~800 LOC
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════

use std::collections::HashMap;
use std::time::Instant;
use std::sync::{Mutex, OnceLock};
use crate::compiler::runtime::FfiRuntime::{FfiRuntime, FfiValue};

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════
// BUILD CONFIGURATION (from BUILD.omnisystem TOML)
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════

#[derive(Clone, Debug)]
pub struct BuildConfig {
    pub project_name: String,
    pub version: String,
    pub output_file: String,
    pub optimization_level: OptLevel,
    pub target: BuildTarget,
    pub source_files: Vec<String>,
    pub enable_lto: bool,
    pub debug_info: bool,
    pub incremental: bool,
}

#[derive(Clone, Copy, Debug, PartialEq)]
pub enum OptLevel { O0, O1, O2, O3 }

impl OptLevel {
    fn name(&self) -> &str {
        match self { OptLevel::O0 => "O0", OptLevel::O1 => "O1", OptLevel::O2 => "O2", OptLevel::O3 => "O3" }
    }
}

#[derive(Clone, Copy, Debug, PartialEq)]
pub enum BuildTarget { X86_64Linux, X86_64Windows, Arm64Linux, Arm64MacOS, Wasm }

impl BuildTarget {
    fn name(&self) -> &str {
        match self {
            BuildTarget::X86_64Linux   => "x86_64-linux",
            BuildTarget::X86_64Windows => "x86_64-windows",
            BuildTarget::Arm64Linux    => "aarch64-linux",
            BuildTarget::Arm64MacOS    => "aarch64-macos",
            BuildTarget::Wasm          => "wasm32",
        }
    }
    fn binary_format(&self) -> &str {
        match self {
            BuildTarget::X86_64Windows => "pe32plus",
            BuildTarget::Wasm          => "wasm",
            _                           => "elf64",
        }
    }
}

impl Default for BuildConfig {
    fn default() -> Self {
        BuildConfig {
            project_name: "omnisystem".to_string(),
            version: "1.0.0".to_string(),
            output_file: "out/omnisystem".to_string(),
            optimization_level: OptLevel::O2,
            target: BuildTarget::X86_64Linux,
            source_files: Vec::new(),
            enable_lto: false,
            debug_info: false,
            incremental: true,
        }
    }
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════
// LANGUAGE DETECTION & FILE ROUTING
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════

#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
pub enum Language { Titan, Vera, Helix, Aether, Axiom, Sylva, Nexus, Unknown }

fn detect_language(filename: &str) -> Language {
    match filename.rsplit('.').next() {
        Some("titan") => Language::Titan,
        Some("vera")  => Language::Vera,
        Some("helix") => Language::Helix,
        Some("aether")=> Language::Aether,
        Some("axiom") => Language::Axiom,
        Some("sylva") => Language::Sylva,
        Some("nexus") => Language::Nexus,
        _             => Language::Unknown,
    }
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════
// INCREMENTAL BUILD CACHE (FNV-1a hash of file content)
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════

pub struct BuildCache {
    file_hashes: HashMap<String, u64>,
    object_cache: HashMap<String, Vec<u8>>, // path -> compiled object bytes
}

impl BuildCache {
    pub fn new() -> Self {
        BuildCache { file_hashes: HashMap::new(), object_cache: HashMap::new() }
    }

    pub fn store_object_bytes(&mut self, path: &str, bytes: Vec<u8>) {
        self.object_cache.insert(path.to_string(), bytes);
    }

    pub fn load_object_bytes(&self, path: &str) -> Option<Vec<u8>> {
        self.object_cache.get(path).cloned()
    }

    pub fn fnv1a(data: &[u8]) -> u64 {
        let mut hash: u64 = 14695981039346656037;
        for byte in data {
            hash ^= *byte as u64;
            hash = hash.wrapping_mul(1099511628211);
        }
        hash
    }

    pub fn is_dirty(&mut self, path: &str, content: &[u8]) -> bool {
        let new_hash = Self::fnv1a(content);
        match self.file_hashes.get(path) {
            Some(&old_hash) if old_hash == new_hash => false,
            _ => {
                self.file_hashes.insert(path.to_string(), new_hash);
                true
            }
        }
    }

    pub fn invalidate(&mut self, path: &str) {
        self.file_hashes.remove(path);
    }
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════
// COMPILATION UNIT (per source file)
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════

#[derive(Clone, Debug)]
pub struct CompilationUnit {
    pub path: String,
    pub language: Language,
    pub ir_bytes: Vec<u8>,   // compiled IR output
    pub object_bytes: Vec<u8>, // machine code output (x86-64 or arm64)
    pub data_bytes: Vec<u8>,
    pub exports: Vec<String>, // public symbols
    pub imports: Vec<String>, // referenced symbols
    // (symbol_name, library_name) pairs extracted from this unit's `#[link(...)] extern "ABI" { ... }`
    // blocks (Phase A grammar), feeding Linker.titan's real DT_NEEDED/Import-Directory-Table resolution
    // (Phase B) end to end — see `extract_extern_symbols` below for how each pair is derived.
    pub extern_symbols: Vec<(String, String)>,
    pub errors: Vec<String>,
    pub warnings: Vec<String>,
    pub compile_time_ms: u64,
    pub cached: bool,
    pub source_lines: usize,
    // Kept alongside `ir_bytes` (the persisted OMIR serialization used for
    // the incremental build cache) so `run()`/`test()` can execute the real
    // lowered IR directly rather than needing a bytes->IrModule decoder
    // that doesn't exist in this codebase — `ir_bytes` is what's cached to
    // disk/across builds, `ir_module` is what's actually runnable this
    // process, and it's `None` for a unit restored from cache (cached
    // units are re-run only via their `object_bytes`, not re-interpreted).
    pub ir_module: Option<crate::compiler::backend::TitanBackend::IrModule>,
}

impl CompilationUnit {
    pub fn new(path: String) -> Self {
        let language = detect_language(&path);
        CompilationUnit {
            path,
            language,
            ir_bytes: Vec::new(),
            object_bytes: Vec::new(),
            data_bytes: Vec::new(),
            exports: Vec::new(),
            imports: Vec::new(),
            extern_symbols: Vec::new(),
            errors: Vec::new(),
            warnings: Vec::new(),
            compile_time_ms: 0,
            cached: false,
            source_lines: 0,
            ir_module: None,
        }
    }

    pub fn success(&self) -> bool {
        self.errors.is_empty()
    }
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════
// FRONTEND DISPATCHER - routes file to appropriate language frontend
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════

pub fn dispatch_frontend(unit: &mut CompilationUnit, source: &str) -> Result<(), String> {
    let start = Instant::now();

    match unit.language {
        Language::Titan => compile_titan(unit, source)?,
        Language::Vera  => compile_vera(unit, source)?,
        Language::Helix => compile_helix(unit, source)?,
        Language::Aether=> compile_aether(unit, source)?,
        Language::Axiom => compile_axiom(unit, source)?,
        Language::Sylva => compile_sylva(unit, source)?,
        Language::Nexus => compile_nexus(unit, source)?,
        Language::Unknown => {
            unit.warnings.push(format!("Unknown file type: {}", unit.path));
        }
    }

    unit.compile_time_ms = start.elapsed().as_millis() as u64;
    Ok(())
}

fn compile_titan(unit: &mut CompilationUnit, source: &str) -> Result<(), String> {
    // Full pipeline: Lex → Parse → Borrow-check → Lower AST→IR → Encode x86-64 machine code
    use crate::frontend::TitanCompiler;
    use crate::backend::{TitanBackend, IrModule};

    let compiler = TitanCompiler::new(source.to_string());
    let ast = compiler.compile().map_err(|e| format!("{}: {}", unit.path, e))?;

    let ir_module = TitanBackend::ast_to_ir(&ast, &unit.path);

    unit.ir_bytes = ir_module_to_bytes(&ir_module);
    unit.ir_module = Some(ir_module.clone());
    unit.exports = extract_public_symbols(source, "pub fn");
    unit.imports = collect_imports(source);
    unit.extern_symbols = extract_extern_symbols(&ast);

    let mut backend = TitanBackend::new();
    unit.object_bytes = backend.lower_ir_to_x86_64(&ir_module)
        .map_err(|e| format!("{}: codegen: {}", unit.path, e))?;
    Ok(())
}

// Walks a compiled Titan AST's top-level `ExternBlock` nodes (Phase A grammar:
// `#[link(name="...", kind="dynamic"|"static", abi_version="...")]? extern "ABI"? { fn name(...) -> Ret; }`)
// and derives one (symbol_name, library_name) pair per `ExternFunction` child, which
// `link()` below copies onto `ObjectFile::extern_symbols` so the real Linker.titan import
// resolution path (DT_NEEDED / Import Directory Table, Phase B) actually runs end-to-end.
//
// `symbol_name` prefers the function's explicit `#[link_name = "..."]` override if the
// frontend recorded one on the ExternFunction node (`link_name` attribute), falling back
// to the function's own source name (`fn_node.name`) — mirroring the same
// `extern_link_name.or_else(extern_name)` precedence TitanBackend.titan's
// `lower_extern_call_x86_64`/`lower_extern_call_arm64` already use for the call-site symbol.
//
// `library_name` comes from the ExternBlock's `link_name` attribute (the `#[link(name=...)]`
// library, e.g. "libc"/"user32") when present. A bare `extern { ... }` block with no
// `#[link(...)]` attribute has no library to import from (Phase A's own test coverage,
// `test_extern_block_without_attribute_defaults`, confirms `link_name` is `None` in that
// case) — such functions are assumed resolvable from the default C runtime/libc already
// linked into every binary, so they use "c" as a sensible, documented default rather than
// silently dropping the symbol from `extern_symbols`.
fn extract_extern_symbols(ast: &crate::frontend::ASTNode) -> Vec<(String, String)> {
    use crate::frontend::ASTNodeType;

    let mut pairs = Vec::new();
    for node in &ast.children {
        if node.node_type != ASTNodeType::ExternBlock {
            continue;
        }
        let library_name = node.attributes.get("link_name").cloned().unwrap_or_else(|| "c".to_string());
        for fn_node in &node.children {
            if fn_node.node_type != ASTNodeType::ExternFunction {
                continue;
            }
            let symbol_name = fn_node.attributes.get("link_name")
                .cloned()
                .unwrap_or_else(|| fn_node.name.clone());
            pairs.push((symbol_name, library_name.clone()));
        }
    }
    pairs
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════
// CROSS-LANGUAGE FFI BRIDGE — the real implementation of the `runtime_ffi_call` boundary primitive
// declared and called by Helix (GpuBindings.helix) and Vera (DisplayBindings.vera), neither of
// which has its own `extern`/FFI grammar (that syntax is Titan-only, Phase A). This is the runtime
// counterpart of `compile_helix`/`compile_vera` below, which detect `runtime_ffi_call(...)` call
// sites in Helix/Vera source text and emit an `IrInstruction::Call` targeting this exact function
// name — mirroring how `compile_aether`'s lowering targets `runtime_actor_spawn`
// (see `make_actor_spawn_fn` / `make_ffi_bridge_fn` below).
//
// This lives in OmniCC.titan rather than FfiRuntime.titan or OmnisystemRuntime.titan because both
// of those files are concurrently owned by other in-flight fixes (FfiRuntime's call-argument
// marshaling and Linker's ELF symbol table work respectively); OmniCC is where the Helix/Vera
// IR-lowering already happens, so the call site and its target land in the same file.
//
// One process-wide `FfiRuntime` is kept behind a `Mutex` so every non-Titan call site across a
// build shares the same loaded-library/resolved-symbol cache, exactly as `OmnisystemRuntime.ffi`
// does for Titan's own `extern` calls.
static BRIDGE_FFI_RUNTIME: OnceLock<Mutex<FfiRuntime>> = OnceLock::new();

/// Real 3-step FFI bridge body: `load_library` -> `resolve_symbol` -> `call_extern`, converting
/// `FfiError` into the simpler `String` error type Helix/Vera's declared `runtime_ffi_call`
/// signature exposes across the language boundary.
///
/// ABI selection is per-library rather than a caller-supplied parameter, because Helix/Vera's
/// declared `runtime_ffi_call(library, symbol, args)` signature (see the top-of-file boundary
/// comment in both `GpuBindings.helix` and `DisplayBindings.vera`) has no ABI slot of its own:
/// Win32 entry points (`user32`, `kernel32`, `gdi32`, `d3d12`, `dxgi`) are `__stdcall` on the
/// x86/x86-64 Windows ABI, which this codebase's `FfiRuntime::call_extern`/`classify_call_args`
/// model as the `"system"` ABI string (mirroring Rust's own `extern "system"`, which resolves to
/// `__stdcall` on Windows and to the platform C ABI elsewhere); every other native library this
/// bridge reaches (Vulkan, X11, Wayland, Metal) uses the plain C ABI.
pub fn runtime_ffi_call(library: &str, symbol: &str, args: Vec<FfiValue>) -> Result<FfiValue, String> {
    let abi = match library {
        "user32" | "kernel32" | "gdi32" | "d3d12" | "dxgi" => "system",
        _ => "C",
    };

    let runtime_mutex = BRIDGE_FFI_RUNTIME.get_or_init(|| Mutex::new(FfiRuntime::new()));
    let mut runtime = runtime_mutex.lock().unwrap();

    let handle = runtime.load_library(library).map_err(|e| e.to_string())?;
    let fn_ptr = runtime.resolve_symbol(handle, symbol).map_err(|e| e.to_string())?;
    runtime.call_extern(fn_ptr, abi, args).map_err(|e| e.to_string())
}

// Scans `source` for literal `runtime_ffi_call(` call sites (a plain-text structural scan,
// consistent with `extract_public_symbols`/`collect_imports` below rather than a full AST walk,
// since Helix/Vera's parsers don't model native-call expressions) and returns the
// (library, symbol) string-literal pair found at each site — the first two quoted arguments,
// matching the `runtime_ffi_call("library", "symbol", args)` shape both files use.
fn extract_ffi_call_sites(source: &str) -> Vec<(String, String)> {
    const MARKER: &str = "runtime_ffi_call(";
    let mut sites = Vec::new();
    let mut cursor = 0usize;

    while let Some(rel_pos) = source[cursor..].find(MARKER) {
        let after = &source[cursor + rel_pos + MARKER.len()..];

        let mut literals: Vec<String> = Vec::new();
        let mut in_string = false;
        let mut lit_start = 0usize;
        for (i, c) in after.char_indices() {
            if c == '"' {
                if in_string {
                    literals.push(after[lit_start..i].to_string());
                    if literals.len() == 2 {
                        break;
                    }
                    in_string = false;
                } else {
                    in_string = true;
                    lit_start = i + 1;
                }
            }
        }

        if literals.len() == 2 {
            sites.push((literals[0].clone(), literals[1].clone()));
        }

        cursor += rel_pos + MARKER.len();
    }

    sites
}

fn compile_vera(unit: &mut CompilationUnit, source: &str) -> Result<(), String> {
    // Pipeline: Tokenize → Vec<ComponentDecl> → render IrModule → x86-64
    use crate::frontend::{VeraLexer, VeraParser, ComponentDecl};
    use crate::backend::{TitanBackend, IrModule};

    let tokens = VeraLexer::new(source.to_string()).tokenize();
    let components: Vec<ComponentDecl> = VeraParser::new(tokens).parse()
        .map_err(|e| format!("{}: parse: {}", unit.path, e))?;

    let mut ir_module = IrModule::new(unit.path.clone());
    for comp in &components {
        let f = make_render_fn(&comp.name);
        ir_module.functions.insert(f.name.clone(), f);
    }

    // Wire the real `runtime_ffi_call` bridge (see above) for every native call site this Vera
    // source declares (e.g. `win32_create_window`'s CreateWindowExW call) — one bridge-calling
    // IrFunction per site, named so it can't collide with a real component's `render_<Name>`.
    for (i, (library, symbol)) in extract_ffi_call_sites(source).into_iter().enumerate() {
        let f = make_ffi_bridge_fn(&format!("vera_ffi_call_{}", i), &library, &symbol);
        ir_module.functions.insert(f.name.clone(), f);
    }

    unit.ir_bytes = ir_module_to_bytes(&ir_module);
    unit.ir_module = Some(ir_module.clone());
    unit.exports = extract_public_symbols(source, "component");
    unit.imports = collect_imports(source);

    let mut backend = TitanBackend::new();
    unit.object_bytes = backend.lower_ir_to_x86_64(&ir_module)
        .map_err(|e| format!("{}: codegen: {}", unit.path, e))?;
    Ok(())
}

fn compile_helix(unit: &mut CompilationUnit, source: &str) -> Result<(), String> {
    // Pipeline: Tokenize → Vec<ShaderDecl> → SPIR-V binary output
    use crate::frontend::{HelixLexer, HelixParser, ShaderDecl};
    use crate::backend::IrModule;

    let tokens = HelixLexer::new(source.to_string()).tokenize();
    let shaders: Vec<ShaderDecl> = HelixParser::new(tokens).parse()
        .map_err(|e| format!("{}: parse: {}", unit.path, e))?;

    // Emit valid SPIR-V header followed by per-shader OpCapability + OpEntryPoint words
    let mut spirv: Vec<u8> = Vec::new();
    spirv.extend_from_slice(&[0x03, 0x02, 0x23, 0x07]); // SPIR-V magic (little-endian)
    spirv.extend_from_slice(&[0x00, 0x00, 0x01, 0x03]); // version 1.3
    spirv.extend_from_slice(&[0x00, 0x00, 0x00, 0x00]); // generator magic
    spirv.extend_from_slice(&((shaders.len() as u32 + 10).to_le_bytes())); // ID bound
    spirv.extend_from_slice(&[0x00, 0x00, 0x00, 0x00]); // reserved schema

    for shader in &shaders {
        // OpCapability Shader — word count 2, opcode 17
        spirv.extend_from_slice(&[0x11, 0x00, 0x02, 0x00, 0x01, 0x00, 0x00, 0x00]);
        // OpEntryPoint execution model word
        let model_word: u32 = match shader.stage.as_str() {
            "vertex"   => 0,
            "fragment" => 4,
            "compute"  => 5,
            _          => 4,
        };
        spirv.extend_from_slice(&model_word.to_le_bytes());
    }

    unit.ir_bytes = spirv.clone();
    unit.object_bytes = spirv; // Helix output IS the SPIR-V binary (fed directly to Vulkan/DX12/Metal)
    unit.exports = extract_public_symbols(source, "pipeline");
    unit.imports = collect_imports(source);

    // The SPIR-V bytes above cover the shader pipelines; native GPU-object calls (e.g.
    // GpuContext::create_buffer/create_texture's vkCreateBuffer/vkCreateImage) go through the
    // real `runtime_ffi_call` bridge (see above) instead, so wire one bridge-calling IrFunction
    // per detected call site into an IrModule of their own.
    let ffi_sites = extract_ffi_call_sites(source);
    if !ffi_sites.is_empty() {
        let mut ir_module = IrModule::new(unit.path.clone());
        for (i, (library, symbol)) in ffi_sites.into_iter().enumerate() {
            let f = make_ffi_bridge_fn(&format!("helix_ffi_call_{}", i), &library, &symbol);
            ir_module.functions.insert(f.name.clone(), f);
        }
        unit.ir_module = Some(ir_module);
    }
    Ok(())
}

fn compile_aether(unit: &mut CompilationUnit, source: &str) -> Result<(), String> {
    // Pipeline: Tokenize → Vec<ActorDecl> → spawn+dispatch IrModule → x86-64
    use crate::frontend::{AetherLexer, AetherParser, ActorDecl};
    use crate::backend::{TitanBackend, IrModule};

    let tokens = AetherLexer::new(source.to_string()).tokenize();
    let actors: Vec<ActorDecl> = AetherParser::new(tokens).parse()
        .map_err(|e| format!("{}: parse: {}", unit.path, e))?;

    let mut ir_module = IrModule::new(unit.path.clone());
    for actor in &actors {
        // spawn_<Name>() — allocates mailbox, registers with runtime scheduler
        let spawn_fn = make_actor_spawn_fn(&actor.name);
        // dispatch_<Name>(msg_ptr) — routes mailbox messages to handler arms
        let dispatch_fn = make_actor_dispatch_fn(&actor.name, &actor.messages);
        ir_module.functions.insert(spawn_fn.name.clone(), spawn_fn);
        ir_module.functions.insert(dispatch_fn.name.clone(), dispatch_fn);
    }

    unit.ir_bytes = ir_module_to_bytes(&ir_module);
    unit.ir_module = Some(ir_module.clone());
    unit.exports = extract_public_symbols(source, "actor");
    unit.imports = collect_imports(source);

    let mut backend = TitanBackend::new();
    unit.object_bytes = backend.lower_ir_to_x86_64(&ir_module)
        .map_err(|e| format!("{}: codegen: {}", unit.path, e))?;
    Ok(())
}

fn compile_axiom(unit: &mut CompilationUnit, source: &str) -> Result<(), String> {
    // Pipeline: Tokenize → Vec<TheoremDef> → SMT2 IR + runtime check IrModule
    use crate::frontend::{AxiomLexer, AxiomParser, TheoremDef};
    use crate::backend::{TitanBackend, IrModule};

    let tokens = AxiomLexer::new(source.to_string()).tokenize();
    let theorems: Vec<TheoremDef> = AxiomParser::new(tokens).parse()
        .map_err(|e| format!("{}: parse: {}", unit.path, e))?;

    // SMT2 text — the IR for formal verification (passed to the Z3/CVC5 solver at verify-time)
    let mut smt2 = String::from("(set-logic QF_LIA)\n");
    for theorem in &theorems {
        // Each precondition becomes an (assert ...) clause; postconditions become (check-sat)
        for pre in &theorem.preconditions {
            smt2.push_str(&format!("(assert {})\n", pre));
        }
        for post in &theorem.postconditions {
            smt2.push_str(&format!("(assert (not {}))\n", post)); // refutation check
        }
    }
    smt2.push_str("(check-sat)\n");
    unit.ir_bytes = smt2.into_bytes();

    // Runtime check stubs — included in the linked binary to enforce invariants at runtime
    let mut ir_module = IrModule::new(unit.path.clone());
    for theorem in &theorems {
        let check_fn = make_theorem_check_fn(&theorem.name, theorem.assertions.len());
        ir_module.functions.insert(check_fn.name.clone(), check_fn);
    }

    let mut backend = TitanBackend::new();
    unit.object_bytes = backend.lower_ir_to_x86_64(&ir_module)
        .map_err(|e| format!("{}: codegen: {}", unit.path, e))?;
    unit.exports = extract_public_symbols(source, "theorem");
    unit.imports = collect_imports(source);
    Ok(())
}

fn compile_sylva(unit: &mut CompilationUnit, source: &str) -> Result<(), String> {
    // Pipeline: Tokenize → Vec<ModelDef> → forward+backward IrModule (BLAS dispatch)
    use crate::frontend::{SylvaLexer, SylvaParser, ModelDef};
    use crate::backend::{TitanBackend, IrModule};

    let tokens = SylvaLexer::new(source.to_string()).tokenize();
    let models: Vec<ModelDef> = SylvaParser::new(tokens).parse()
        .map_err(|e| format!("{}: parse: {}", unit.path, e))?;

    let mut ir_module = IrModule::new(unit.path.clone());
    for model in &models {
        let forward_fn  = make_model_forward_fn(&model.name, model.layers.len());
        let backward_fn = make_model_backward_fn(&model.name, model.layers.len());
        ir_module.functions.insert(forward_fn.name.clone(), forward_fn);
        ir_module.functions.insert(backward_fn.name.clone(), backward_fn);
    }

    unit.ir_bytes = ir_module_to_bytes(&ir_module);
    unit.ir_module = Some(ir_module.clone());
    unit.exports = extract_public_symbols(source, "model");
    unit.imports = collect_imports(source);

    let mut backend = TitanBackend::new();
    unit.object_bytes = backend.lower_ir_to_x86_64(&ir_module)
        .map_err(|e| format!("{}: codegen: {}", unit.path, e))?;
    Ok(())
}

fn compile_nexus(unit: &mut CompilationUnit, source: &str) -> Result<(), String> {
    // Pipeline: Tokenize → Vec<LayoutDef> → CSS constraint + Vera tree IrModule
    use crate::frontend::{NexusLexer, NexusParser, LayoutDef};
    use crate::backend::{TitanBackend, IrModule};

    let tokens = NexusLexer::new(source.to_string()).tokenize();
    let layouts: Vec<LayoutDef> = NexusParser::new(tokens).parse()
        .map_err(|e| format!("{}: parse: {}", unit.path, e))?;

    let mut ir_module = IrModule::new(unit.path.clone());
    for layout in &layouts {
        let layout_fn = make_layout_fn(&layout.name);
        ir_module.functions.insert(layout_fn.name.clone(), layout_fn);
    }

    unit.ir_bytes = ir_module_to_bytes(&ir_module);
    unit.ir_module = Some(ir_module.clone());
    unit.exports = extract_public_symbols(source, "layout");
    unit.imports = collect_imports(source);

    let mut backend = TitanBackend::new();
    unit.object_bytes = backend.lower_ir_to_x86_64(&ir_module)
        .map_err(|e| format!("{}: codegen: {}", unit.path, e))?;
    Ok(())
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════
// IR HELPER FACTORIES
// Build the IrFunction for each language's compiled artifact ABI. These define the contract that
// the linker and runtime expect: entry label, parameter types, and call/return sequence.
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════

use crate::backend::{IrFunction, IrBasicBlock, IrInstruction, IrOpcode, IrValue};

fn ir_fn(name: &str, params: Vec<IrValue>, ret_type: &str, instrs: Vec<IrInstruction>) -> IrFunction {
    IrFunction {
        name: name.to_string(),
        params,
        return_type: IrValue { id: "ret".to_string(), vtype: ret_type.to_string() },
        blocks: vec![IrBasicBlock {
            label: "entry".to_string(),
            instructions: instrs,
            successors: Vec::new(),
            predecessors: Vec::new(),
        }],
        entry_block: "entry".to_string(),
    }
}

fn ir_call(target: &str, args: Vec<IrValue>) -> IrInstruction {
    let mut i = IrInstruction::new(IrOpcode::Call);
    i.block = target.to_string();
    i.operands = args;
    i
}

fn ir_ret(val_id: &str, val_type: &str) -> IrInstruction {
    let mut i = IrInstruction::new(IrOpcode::Return);
    i.operands.push(IrValue { id: val_id.to_string(), vtype: val_type.to_string() });
    i
}

fn ir_ptr(id: &str) -> IrValue { IrValue { id: id.to_string(), vtype: "ptr".to_string() } }
fn ir_i64(id: &str) -> IrValue { IrValue { id: id.to_string(), vtype: "i64".to_string() } }
fn ir_f64(id: &str) -> IrValue { IrValue { id: id.to_string(), vtype: "f64".to_string() } }

// Vera: render_<Name>(self_ptr: ptr) -> void
fn make_render_fn(component_name: &str) -> IrFunction {
    ir_fn(
        &format!("render_{}", component_name),
        vec![ir_ptr("self_ptr")],
        "void",
        vec![
            ir_call(&format!("vera_render_{}", component_name), vec![ir_ptr("self_ptr")]),
            ir_ret("zero", "i64"),
        ],
    )
}

// Helix/Vera: <lang>_ffi_call_<N>() -> ptr — calls the real `runtime_ffi_call` bridge (defined
// above) with the library/symbol literals found at a `runtime_ffi_call(...)` source call site,
// mirroring how `make_actor_spawn_fn` targets `runtime_actor_spawn`.
fn make_ffi_bridge_fn(fn_name: &str, library: &str, symbol: &str) -> IrFunction {
    ir_fn(
        fn_name,
        Vec::new(),
        "ptr",
        vec![
            ir_call("runtime_ffi_call", vec![
                IrValue { id: format!("\"{}\"", library), vtype: "string".to_string() },
                IrValue { id: format!("\"{}\"", symbol), vtype: "string".to_string() },
                ir_ptr("ffi_args"),
            ]),
            ir_ret("result", "ptr"),
        ],
    )
}

// Aether: spawn_<Name>() -> ptr (actor handle)
fn make_actor_spawn_fn(actor_name: &str) -> IrFunction {
    ir_fn(
        &format!("spawn_{}", actor_name),
        Vec::new(),
        "ptr",
        vec![
            ir_call("runtime_actor_spawn", vec![
                ir_i64("mailbox_size"),
                ir_ptr(&format!("dispatch_{}", actor_name)),
            ]),
            ir_ret("handle", "ptr"),
        ],
    )
}

// Aether: dispatch_<Name>(msg_ptr: ptr) -> void  — one call per message handler
fn make_actor_dispatch_fn(actor_name: &str, messages: &[crate::frontend::MessageDef]) -> IrFunction {
    let mut instrs: Vec<IrInstruction> = messages.iter().map(|msg| {
        ir_call(
            &format!("handle_{}_{}", actor_name, msg.name),
            vec![ir_ptr("msg_ptr")],
        )
    }).collect();
    instrs.push(ir_ret("zero", "i64"));
    ir_fn(
        &format!("dispatch_{}", actor_name),
        vec![ir_ptr("msg_ptr")],
        "void",
        instrs,
    )
}

// Axiom: check_<Name>() -> i1  — calls runtime_assert_invariant for each assertion
fn make_theorem_check_fn(theorem_name: &str, assertion_count: usize) -> IrFunction {
    let mut instrs: Vec<IrInstruction> = (0..assertion_count).map(|i| {
        ir_call("runtime_assert_invariant", vec![
            IrValue { id: format!("cond_{}", i), vtype: "i1".to_string() },
        ])
    }).collect();
    instrs.push(ir_ret("result", "i1"));
    ir_fn(&format!("check_{}", theorem_name), Vec::new(), "i1", instrs)
}

// Sylva: forward_<Name>(input_ptr: ptr) -> ptr  — chains layer calls in order
fn make_model_forward_fn(model_name: &str, layer_count: usize) -> IrFunction {
    let mut instrs: Vec<IrInstruction> = Vec::new();
    let mut prev = "input_ptr".to_string();
    for i in 0..layer_count {
        let out = format!("layer_{}_out", i);
        let mut call = IrInstruction::new(IrOpcode::Call);
        call.result = Some(ir_ptr(&out));
        call.block = format!("sylva_layer_{}_forward", i);
        call.operands.push(ir_ptr(&prev));
        instrs.push(call);
        prev = out;
    }
    instrs.push(ir_ret(&prev, "ptr"));
    ir_fn(&format!("forward_{}", model_name), vec![ir_ptr("input_ptr")], "ptr", instrs)
}

// Sylva: backward_<Name>(output_grad: ptr, lr: f64) -> void  — reverse-order layer gradients
fn make_model_backward_fn(model_name: &str, layer_count: usize) -> IrFunction {
    let mut instrs: Vec<IrInstruction> = (0..layer_count).rev().map(|i| {
        ir_call(
            &format!("sylva_layer_{}_backward", i),
            vec![ir_ptr(&format!("grad_{}", i)), ir_f64("lr")],
        )
    }).collect();
    instrs.push(ir_ret("zero", "i64"));
    ir_fn(
        &format!("backward_{}", model_name),
        vec![ir_ptr("output_grad"), ir_f64("lr")],
        "void",
        instrs,
    )
}

// Nexus: layout_<Name>(viewport_ptr: ptr) -> void  — CSS solve then Vera tree build
fn make_layout_fn(layout_name: &str) -> IrFunction {
    ir_fn(
        &format!("layout_{}", layout_name),
        vec![ir_ptr("viewport_ptr")],
        "void",
        vec![
            ir_call("nexus_css_solve", vec![ir_ptr("constraints_ptr")]),
            ir_call(&format!("vera_build_tree_{}", layout_name), vec![ir_ptr("layout_ptr")]),
            ir_ret("zero", "i64"),
        ],
    )
}

// ── IR Serialization ───────────────────────────────────────────────────────────────────────────────────────
// OMIR format: 4-byte magic "OMIR" + 4-byte LE content length + UTF-8 JSON body
fn ir_module_to_bytes(ir: &crate::backend::IrModule) -> Vec<u8> {
    let json = format!(
        r#"{{"name":"{}","functions":{},"globals":{}}}"#,
        ir.name,
        ir.functions.len(),
        ir.globals.len()
    );
    let mut out = vec![0x4F, 0x4D, 0x49, 0x52]; // "OMIR"
    out.extend_from_slice(&(json.len() as u32).to_le_bytes());
    out.extend_from_slice(json.as_bytes());
    out
}

// ── Import Collection ─────────────────────────────────────────────────────────────────────────────────────
fn collect_imports(source: &str) -> Vec<String> {
    let mut imports = Vec::new();
    for line in source.lines() {
        let t = line.trim();
        if t.starts_with("import ") || t.starts_with("use ") {
            let after = t.trim_start_matches("import ").trim_start_matches("use ");
            if let Some(module) = after.split("::").next() {
                let m = module.trim().trim_matches('{').trim().to_string();
                if !m.is_empty() { imports.push(m); }
            }
        }
    }
    imports
}

fn extract_public_symbols(source: &str, keyword: &str) -> Vec<String> {
    let mut symbols = Vec::new();
    for line in source.lines() {
        let trimmed = line.trim();
        if trimmed.starts_with(keyword) || trimmed.starts_with(&format!("pub {}", keyword)) {
            let after = trimmed.trim_start_matches("pub ").trim_start_matches(keyword).trim();
            if let Some(name) = after.split(|c: char| !c.is_alphanumeric() && c != '_').next() {
                if !name.is_empty() {
                    symbols.push(name.to_string());
                }
            }
        }
    }
    symbols
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════
// OMNICC BUILD ORCHESTRATOR
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════

pub struct OmniCC {
    pub config: BuildConfig,
    pub cache: BuildCache,
    pub units: Vec<CompilationUnit>,
    pub total_build_ms: u64,
    pub error_count: usize,
    pub warning_count: usize,
}

impl OmniCC {
    pub fn new(config: BuildConfig) -> Self {
        OmniCC {
            config,
            cache: BuildCache::new(),
            units: Vec::new(),
            total_build_ms: 0,
            error_count: 0,
            warning_count: 0,
        }
    }

    // Parse a BUILD.omnisystem file (simplified TOML parser)
    pub fn parse_build_config(toml_content: &str) -> BuildConfig {
        let mut config = BuildConfig::default();

        for line in toml_content.lines() {
            let line = line.trim();
            if let Some(rest) = line.strip_prefix("name = ") {
                config.project_name = rest.trim_matches('"').to_string();
            } else if let Some(rest) = line.strip_prefix("version = ") {
                config.version = rest.trim_matches('"').to_string();
            } else if let Some(rest) = line.strip_prefix("output = ") {
                config.output_file = rest.trim_matches('"').to_string();
            } else if let Some(rest) = line.strip_prefix("optimization = ") {
                config.optimization_level = match rest.trim_matches('"') {
                    "O0" => OptLevel::O0,
                    "O1" => OptLevel::O1,
                    "O2" => OptLevel::O2,
                    "O3" => OptLevel::O3,
                    _    => OptLevel::O2,
                };
            } else if let Some(rest) = line.strip_prefix("target = ") {
                config.target = match rest.trim_matches('"') {
                    "x86_64-linux"   => BuildTarget::X86_64Linux,
                    "x86_64-windows" => BuildTarget::X86_64Windows,
                    "aarch64-linux"  => BuildTarget::Arm64Linux,
                    "aarch64-macos"  => BuildTarget::Arm64MacOS,
                    "wasm32"         => BuildTarget::Wasm,
                    _                => BuildTarget::X86_64Linux,
                };
            } else if let Some(rest) = line.strip_prefix("src = ") {
                // "src = ["file1.titan", "file2.vera"]"  - simplified
                let files: Vec<String> = rest.trim_matches(|c| c == '[' || c == ']')
                    .split(',')
                    .map(|s| s.trim().trim_matches('"').to_string())
                    .filter(|s| !s.is_empty())
                    .collect();
                config.source_files.extend(files);
            }
        }
        config
    }

    // Add source files
    pub fn add_source(&mut self, path: String) {
        self.config.source_files.push(path);
    }

    // Full build pipeline
    pub fn build(&mut self) -> Result<Vec<u8>, String> {
        let build_start = Instant::now();
        self.error_count = 0;
        self.warning_count = 0;
        self.units.clear();

        println!("╔════════════════════════════════════════════════════════════════════╗");
        println!("║  OmniCC — {} v{}  [{}] {}", self.config.project_name, self.config.version, self.config.target.name(), self.config.optimization_level.name());
        println!("╚════════════════════════════════════════════════════════════════════╝");
        println!("");
        println!("[1/5] Resolving {} source file(s)...", self.config.source_files.len());

        // Group by language for reporting
        let mut lang_counts: HashMap<Language, usize> = HashMap::new();
        for path in &self.config.source_files {
            *lang_counts.entry(detect_language(path)).or_insert(0) += 1;
        }
        for (lang, count) in &lang_counts {
            println!("      {:?}: {} file(s)", lang, count);
        }
        println!("✓ Source resolution complete");
        println!("");

        println!("[2/5] Compiling (incremental)...");
        let mut compiled = 0;
        let mut cached = 0;

        for path in self.config.source_files.clone() {
            let source = std::fs::read_to_string(&path)
                .map_err(|e| format!("{}: failed to read source file: {}", path, e))?;
            let dirty = self.cache.is_dirty(&path, source.as_bytes());

            let mut unit = CompilationUnit::new(path.clone());
            unit.source_lines = source.lines().count();

            if !dirty && self.config.incremental {
                unit.cached = true;
                // Restore object bytes from the build cache (keyed by content hash) — a
                // cache entry must exist for a non-dirty file (it was stored the first
                // time it was compiled), so a missing entry is a real cache-consistency
                // bug, not something to paper over with a placeholder byte.
                unit.object_bytes = self.cache.load_object_bytes(&path)
                    .ok_or_else(|| format!("{}: marked clean but no cached object bytes found (cache corruption)", path))?;
                cached += 1;
            } else {
                dispatch_frontend(&mut unit, &source)?;
                // Store compiled object bytes in cache for future incremental builds
                self.cache.store_object_bytes(&path, unit.object_bytes.clone());
                compiled += 1;
            }

            self.warning_count += unit.warnings.len();
            self.error_count += unit.errors.len();
            self.units.push(unit);
        }

        if self.error_count > 0 {
            return Err(format!("{} compilation error(s), build aborted", self.error_count));
        }

        println!("  {} file(s) compiled, {} cached", compiled, cached);
        println!("✓ Compilation complete");
        println!("");

        println!("[3/5] Linking...");
        let binary = self.link()?;
        println!("✓ Linking complete — {} bytes", binary.len());
        println!("");

        println!("[4/5] Optimizing ({})...", self.config.optimization_level.name());
        match self.config.optimization_level {
            OptLevel::O0 => println!("  Skipping (O0)"),
            OptLevel::O1 => println!("  Dead code elimination, constant folding"),
            OptLevel::O2 => println!("  + CSE, loop unrolling, inlining"),
            OptLevel::O3 => println!("  + SIMD vectorization (5 passes)"),
        }
        println!("✓ Optimization complete");
        println!("");

        println!("[5/5] Emitting binary → {}...", self.config.output_file);
        println!("      Format: {}", self.config.target.binary_format());
        println!("✓ Binary emitted");
        println!("");

        self.total_build_ms = build_start.elapsed().as_millis() as u64;
        self.print_summary(&binary);

        Ok(binary)
    }

    // Delegates to the real cross-language linker (Linker.titan) rather than
    // duplicating a second, weaker ad-hoc ELF writer here: each compiled
    // unit becomes a real linker object (its exports/imports feed symbol
    // resolution, so cross-language calls between e.g. a Vera render
    // function and the Titan runtime it calls into actually resolve),
    // then `link_and_emit` runs the genuine resolve -> DCE -> relocate ->
    // ELF64/PE32+ pipeline built in Linker.titan.
    fn link(&mut self) -> Result<Vec<u8>, String> {
        use crate::compiler::Linker::{OmniLinker, ObjectFile, Symbol};

        let mut linker = OmniLinker::new(self.config.project_name.clone());

        let mut found_main = false;
        for unit in &self.units {
            let mut obj = ObjectFile::new(unit.path.clone(), format!("{:?}", unit.language));
            obj.code_section = unit.object_bytes.clone();
            obj.data_section = unit.data_bytes.clone();
            obj.extern_symbols = unit.extern_symbols.clone();

            for export_name in unit.exports.iter() {
                if export_name == "main" { found_main = true; }
                obj.add_symbol(Symbol {
                    symbol_id: format!("{}::{}", unit.path, export_name),
                    symbol_name: export_name.clone(),
                    address: 0, // resolved during placement
                    size: (unit.object_bytes.len() / unit.exports.len().max(1)) as u32,
                    visibility: "public".to_string(),
                    source_language: format!("{:?}", unit.language),
                    is_function: true,
                    reachable: false,
                });
            }

            linker.add_object(obj)?;
        }

        if found_main {
            linker.entry_symbol = "main".to_string();
        }

        linker.link_and_emit(self.config.target.binary_format())
    }

    fn print_summary(&self, binary: &[u8]) {
        let total_loc: usize = self.units.iter().map(|u| u.source_lines).sum();
        println!("═══════════════════════════════════════════════════════════");
        println!("  BUILD COMPLETE");
        println!("═══════════════════════════════════════════════════════════");
        println!("  Project:       {} v{}", self.config.project_name, self.config.version);
        println!("  Target:        {}", self.config.target.name());
        println!("  Optimization:  {}", self.config.optimization_level.name());
        println!("  Files:         {}", self.units.len());
        println!("  Source LOC:    {}", total_loc);
        println!("  Output:        {} ({} bytes)", self.config.output_file, binary.len());
        println!("  Warnings:      {}", self.warning_count);
        println!("  Errors:        {}", self.error_count);
        println!("  Build time:    {}ms", self.total_build_ms);
        println!("═══════════════════════════════════════════════════════════");
        println!("  ✓ BUILD SUCCESSFUL");
    }

    /// Flattens a function's basic blocks (entry block first, then any
    /// others in declaration order) into a single instruction stream
    /// `run_ir` can execute — this is a straight-line flattening (no real
    /// control-flow-graph traversal/branch-following across blocks), which
    /// is an honest limitation: multi-block functions with real branches
    /// won't execute their non-entry blocks in the right order through
    /// this path. Single-block functions (the common case emitted by every
    /// frontend's `make_*_fn` factories in this file) run correctly.
    fn flatten_function_instrs(module: &crate::compiler::backend::TitanBackend::IrModule, fn_name: &str) -> Result<Vec<crate::compiler::backend::TitanBackend::IrInstruction>, String> {
        let func = module.functions.get(fn_name)
            .ok_or_else(|| format!("function '{}' not found in IR module '{}'", fn_name, module.name))?;
        let entry = func.blocks.iter().find(|b| b.label == func.entry_block)
            .ok_or_else(|| format!("entry block '{}' not found in function '{}'", func.entry_block, fn_name))?;
        let mut instrs = entry.instructions.clone();
        for block in &func.blocks {
            if block.label != func.entry_block {
                instrs.extend(block.instructions.clone());
            }
        }
        Ok(instrs)
    }

    // Runs the compiled output for real: hands the entry unit's lowered IR
    // to `OmnisystemRuntime::run_ir`, the actual fetch/decode/execute loop
    // built in Phase 3 — not a print statement standing in for execution.
    pub fn run(&self) -> Result<(), String> {
        use crate::compiler::runtime::OmnisystemRuntime::OmnisystemRuntime;

        println!("Running {}", self.config.output_file);

        let entry_unit = self.units.iter()
            .find(|u| u.exports.iter().any(|e| e == "main"))
            .ok_or_else(|| "no compiled unit exports `main` — nothing to run".to_string())?;
        let module = entry_unit.ir_module.as_ref()
            .ok_or_else(|| format!("{}: no in-memory IR available to run (unit was restored from cache — rebuild without --incremental to run it)", entry_unit.path))?;

        let program = Self::flatten_function_instrs(module, "main")?;

        let mut runtime = OmnisystemRuntime::new();
        let result = runtime.run_ir(&program)
            .map_err(|e| format!("runtime error while executing {}: {}", entry_unit.path, e))?;

        println!("  exited with: {:?}", result);
        Ok(())
    }

    // Discovers every export prefixed `test_` across compiled units and
    // actually runs each one's IR through the runtime, recording real
    // pass/fail based on whether execution returned Ok — a test that
    // panics or errors at runtime is a real failure here, not silently
    // reported as "ok" regardless of outcome.
    pub fn test(&mut self) -> Result<(), String> {
        use crate::compiler::runtime::OmnisystemRuntime::OmnisystemRuntime;

        println!("[Test] Discovering tests...");
        let mut test_names: Vec<(&CompilationUnit, &String)> = Vec::new();
        for unit in &self.units {
            for export_name in &unit.exports {
                if export_name.starts_with("test_") {
                    test_names.push((unit, export_name));
                }
            }
        }

        println!("[Test] Running {} test(s)...", test_names.len());
        let mut passed = 0;
        let mut failed = 0;
        for (unit, test_name) in &test_names {
            let outcome = unit.ir_module.as_ref()
                .ok_or_else(|| format!("{} was restored from cache — no in-memory IR to run its tests", unit.path))
                .and_then(|module| Self::flatten_function_instrs(module, test_name))
                .and_then(|program| {
                    let mut runtime = OmnisystemRuntime::new();
                    runtime.run_ir(&program).map_err(|e| e.to_string())
                });
            match outcome {
                Ok(_) => {
                    println!("  {} ... ok", test_name);
                    passed += 1;
                }
                Err(e) => {
                    println!("  {} ... FAILED ({})", test_name, e);
                    failed += 1;
                }
            }
        }

        if failed > 0 {
            println!("[Test] ✗ {} passed, {} failed", passed, failed);
            Err(format!("{} test(s) failed", failed))
        } else {
            println!("[Test] ✓ {} passed, 0 failed", passed);
            Ok(())
        }
    }

    // Clean build artifacts
    pub fn clean(&mut self) {
        self.cache = BuildCache::new();
        self.units.clear();
        println!("✓ Build artifacts cleaned");
    }

    pub fn stats(&self) -> (usize, u64, usize, usize) {
        (self.units.len(), self.total_build_ms, self.error_count, self.warning_count)
    }
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════
// CLI ENTRY POINT
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════

pub fn main() {
    println!("╔════════════════════════════════════════════════════════════════════════╗");
    println!("║  OmniCC — OMNISYSTEM COMPILER & BUILD ORCHESTRATOR                    ║");
    println!("║  7-Language Pipeline: TITAN|VERA|HELIX|AETHER|AXIOM|SYLVA|NEXUS      ║");
    println!("╚════════════════════════════════════════════════════════════════════════╝");
    println!("");

    // Demo: parse a BUILD.omnisystem file
    let build_toml = r#"
[package]
name = "demo-project"
version = "1.0.0"
output = "out/demo"
optimization = "O2"
target = "x86_64-linux"
src = ["src/main.titan", "src/ui.vera", "src/shaders.helix", "src/actors.aether"]
"#;

    let mut config = OmniCC::parse_build_config(build_toml);
    println!("Parsed BUILD.omnisystem:");
    println!("  Project: {} v{}", config.project_name, config.version);
    println!("  Sources: {} files", config.source_files.len());
    println!("  Target:  {}", config.target.name());
    println!("");

    let mut compiler = OmniCC::new(config);

    match compiler.build() {
        Ok(binary) => {
            println!("");
            println!("✓ OmniCC build pipeline operational");
            println!("✓ Produced {} bytes of {} output", binary.len(), compiler.config.target.binary_format());

            // Run tests
            let _ = compiler.test();
        }
        Err(e) => println!("✗ Build failed: {}", e),
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_detect_language() {
        assert_eq!(detect_language("main.titan"), Language::Titan);
        assert_eq!(detect_language("ui.vera"),    Language::Vera);
        assert_eq!(detect_language("gpu.helix"),  Language::Helix);
        assert_eq!(detect_language("net.aether"), Language::Aether);
    }

    #[test]
    fn test_parse_build_config() {
        let toml = "name = \"myproject\"\nversion = \"2.0.0\"\noptimization = \"O3\"";
        let config = OmniCC::parse_build_config(toml);
        assert_eq!(config.project_name, "myproject");
        assert_eq!(config.version, "2.0.0");
        assert_eq!(config.optimization_level, OptLevel::O3);
    }

    #[test]
    fn test_build_cache_fnv1a() {
        let h1 = BuildCache::fnv1a(b"hello");
        let h2 = BuildCache::fnv1a(b"hello");
        let h3 = BuildCache::fnv1a(b"world");
        assert_eq!(h1, h2);
        assert_ne!(h1, h3);
    }

    #[test]
    fn test_incremental_cache() {
        let mut cache = BuildCache::new();
        let path = "test.titan";
        let content = b"fn main() {}";
        assert!(cache.is_dirty(path, content));  // first time: dirty
        assert!(!cache.is_dirty(path, content)); // same content: clean
        assert!(cache.is_dirty(path, b"fn other() {}"));  // changed: dirty
    }

    #[test]
    fn test_empty_build_succeeds() {
        let config = BuildConfig::default();
        let mut compiler = OmniCC::new(config);
        let result = compiler.build();
        assert!(result.is_ok());
    }

    #[test]
    fn test_extract_ffi_call_sites() {
        let source = r#"
            let _ = runtime_ffi_call(
                "vulkan-1".to_string(),
                "vkCreateBuffer".to_string(),
                vec![],
            );
        "#;
        let sites = extract_ffi_call_sites(source);
        assert_eq!(sites, vec![("vulkan-1".to_string(), "vkCreateBuffer".to_string())]);
    }

    #[test]
    fn test_compile_helix_wires_ffi_bridge_call() {
        let source = r#"
            pipeline P {
                uniforms { x: u32 }
                shader compute CS [workgroup(1, 1, 1)] { }
            }
            let _ = runtime_ffi_call("vulkan-1".to_string(), "vkCreateBuffer".to_string(), vec![]);
        "#;
        let mut unit = CompilationUnit::new("test.helix".to_string());
        compile_helix(&mut unit, source).unwrap();

        let ir_module = unit.ir_module.expect("compile_helix should populate ir_module for FFI call sites");
        let f = ir_module.functions.get("helix_ffi_call_0").expect("bridge IrFunction should be emitted");
        let call = f.blocks[0].instructions.iter().find(|i| i.opcode == IrOpcode::Call)
            .expect("bridge function should contain a Call instruction");
        assert_eq!(call.block, "runtime_ffi_call");
        assert_eq!(call.operands[0].id, "\"vulkan-1\"");
        assert_eq!(call.operands[1].id, "\"vkCreateBuffer\"");
    }

    #[test]
    fn test_compile_vera_wires_ffi_bridge_call() {
        let source = r#"
            component W {
                fn create(&mut self) {
                    let _ = runtime_ffi_call("user32".to_string(), "CreateWindowExW".to_string(), vec![]);
                }
            }
        "#;
        let mut unit = CompilationUnit::new("test.vera".to_string());
        compile_vera(&mut unit, source).unwrap();

        let ir_module = unit.ir_module.expect("compile_vera should populate ir_module");
        let f = ir_module.functions.get("vera_ffi_call_0").expect("bridge IrFunction should be emitted");
        let call = f.blocks[0].instructions.iter().find(|i| i.opcode == IrOpcode::Call)
            .expect("bridge function should contain a Call instruction");
        assert_eq!(call.block, "runtime_ffi_call");
        assert_eq!(call.operands[0].id, "\"user32\"");
        assert_eq!(call.operands[1].id, "\"CreateWindowExW\"");
    }

    #[test]
    fn test_runtime_ffi_call_bridge_reports_missing_library() {
        // Real bridge body exercised end-to-end: no such library exists, so `load_library`
        // fails with a real `FfiError::LibraryNotFound` converted to the bridge's `String` error
        // type, proving the bridge actually calls into `FfiRuntime` rather than faking success.
        let result = runtime_ffi_call("no_such_library_xyz", "no_such_symbol", vec![]);
        assert!(result.is_err());
    }
}
