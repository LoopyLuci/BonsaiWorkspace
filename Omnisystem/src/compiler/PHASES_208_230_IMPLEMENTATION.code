pub actor VeraFrontend {
    components: Arc<Mutex<HashMap<String, String>>>,
    compilation_count: i32

    message CompileComponent(name: String, code: String) -> Result<String, String> {
        let component_id = format!("component_{}", self.compilation_count)
        self.components.lock().unwrap().insert(component_id.clone(), code)
        self.compilation_count += 1
        Ok(component_id)
    }
}

