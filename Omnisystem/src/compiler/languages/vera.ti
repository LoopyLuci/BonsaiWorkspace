pub fn dom_get_element_by_id(id: String) -> String {
    // Gets element by ID, returns element reference
    let element = json_create_object();
    let e2 = json_object_set(element, "id", id);
    let e3 = json_object_set(e2, "type", "element");
    omnisystem_type_wrap(e3, "vera/element")
}

pub fn dom_query_selector(selector: String) -> String {
    // Gets first element matching CSS selector
    let element = json_create_object();
    let e2 = json_object_set(element, "selector", selector);
    omnisystem_type_wrap(e2, "vera/element")
}

pub fn dom_query_selector_all(selector: String) -> String {
    // Gets all elements matching CSS selector
