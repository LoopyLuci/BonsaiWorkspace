        return QuantumAlgorithm {
            name: "Grover",
            description: "Unstructured search with quadratic speedup",
            qubits_needed: 20,
            gates_needed: 1000,
            depth: 500,
            circuit_generator: |n| {
                let mut circuit = QuantumCircuit { name: "grovers".to_string(), num_qubits: 20, num_classical_bits: 20, gates: vec![], measurements: vec![], barriers: vec![], metadata: CircuitMetadata { description: "", version: "", creation_date: 0, last_modified: 0, author: "", tags: vec![] } };
                return circuit;
            }
        };
    }

    pub fn vqe_algorithm(hamiltonian: String) -> QuantumAlgorithm {
        return QuantumAlgorithm {
            name: "VQE",
            description: "Variational Quantum Eigensolver",
            qubits_needed: 10,
            gates_needed: 500,
            depth: 250,
            circuit_generator: |n| {
                let mut circuit = QuantumCircuit { name: "vqe".to_string(), num_qubits: 10, num_classical_bits: 1, gates: vec![], measurements: vec![], barriers: vec![], metadata: CircuitMetadata { description: "", version: "", creation_date: 0, last_modified: 0, author: "", tags: vec![] } };
                return circuit;
            }
        };
    }

