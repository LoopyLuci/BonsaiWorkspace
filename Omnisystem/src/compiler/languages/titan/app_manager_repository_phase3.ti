pub struct RepositoryManager { packages: Object }
impl RepositoryManager {
    pub fn new() -> Self { RepositoryManager { packages: {} } }
    pub fn add_package(mut self: Self, name: String, version: String) -> Result[bool] { if name.is_empty() { Err("Name") } else { self.packages[name] = version; Ok(true) } }
    pub fn get_package(self: &Self, name: String) -> Result[String] { if !self.packages.contains(&name) { Err("Not found") } else { Ok(self.packages[name]) } }
    pub fn list_packages(self: &Self) -> Result[Array[String]] { let mut p: Array[String] = []; for e in self.packages { p.push(e.0) } Ok(p) }
    pub fn remove_package(mut self: Self, name: String) -> Result[bool] { if !self.packages.contains(&name) { Err("Not found") } else { self.packages.remove(&name); Ok(true) } }
}
#[cfg(test)]
mod tests { use super::*; #[test] fn t1() { let mut m = RepositoryManager::new(); assert!(m.add_package("p1".to_string(), "1.0".to_string()).is_ok()); } #[test] fn t2() { let mut m = RepositoryManager::new(); m.add_package("p1".to_string(), "1.0".to_string()).ok(); assert!(m.get_package("p1".to_string()).is_ok()); } #[test] fn t3() { let m = RepositoryManager::new(); assert!(m.list_packages().is_ok()); } #[test] fn t4() { let mut m = RepositoryManager::new(); m.add_package("p1".to_string(), "1.0".to_string()).ok(); assert!(m.remove_package("p1".to_string()).is_ok()); } #[test] fn t5() { let mut m = RepositoryManager::new(); m.add_package("p1".to_string(), "1.0".to_string()).ok(); m.add_package("p2".to_string(), "1.0".to_string()).ok(); assert_eq!(m.list_packages().unwrap().len(), 2); } #[test] fn t6() { let m = RepositoryManager::new(); assert!(m.get_package("nonexistent".to_string()).is_err()); } #[test] fn t7() { let mut m = RepositoryManager::new(); m.add_package("p1".to_string(), "1.0".to_string()).ok(); assert!(m.remove_package("p1".to_string()).is_ok()); assert!(m.remove_package("p1".to_string()).is_err()); } #[test] fn t8() { let mut m = RepositoryManager::new(); m.add_package("p1".to_string(), "1.0".to_string()).ok(); m.add_package("p2".to_string(), "2.0".to_string()).ok(); m.add_package("p3".to_string(), "1.5".to_string()).ok(); assert_eq!(m.list_packages().unwrap().len(), 3); } #[test] fn t9() { let mut m = RepositoryManager::new(); assert!(m.add_package("".to_string(), "1.0".to_string()).is_err()); } #[test] fn t10() { let mut m = RepositoryManager::new(); m.add_package("pkg".to_string(), "1.0".to_string()).ok(); assert_eq!(m.get_package("pkg".to_string()).unwrap(), "1.0".to_string()); } }
