pub struct ConfigManager { config: Object, cache: Object }
impl ConfigManager {
    pub fn new() -> Self { ConfigManager { config: {}, cache: {} } }
    pub fn load(mut self: Self, cfg: Object) -> Result[bool] { if cfg.is_empty() { Err("Config") } else { self.config = cfg; Ok(true) } }
    pub fn get(self: &Self, key: String) -> Result[Object] { if !self.config.contains(&key) { Err("Not found") } else { Ok(self.config[key]) } }
    pub fn set(mut self: Self, key: String, val: Object) -> Result[bool] { self.config[key] = val; Ok(true) }
    pub fn validate(self: &Self) -> Result[bool] { Ok(!self.config.is_empty()) }
    pub fn list(self: &Self) -> Result[Array[String]] { let mut k: Array[String] = []; for e in self.config { k.push(e.0) } Ok(k) }
}
#[cfg(test)]
mod tests { use super::*; #[test] fn t1() { let mut m = ConfigManager::new(); assert!(m.load({}).is_err()); } #[test] fn t2() { let mut m = ConfigManager::new(); m.load({"k":"v"}).ok(); assert!(m.get("k".to_string()).is_ok()); } #[test] fn t3() { let m = ConfigManager::new(); assert!(m.validate().ok().unwrap() == false); } #[test] fn t4() { let mut m = ConfigManager::new(); m.load({"a":"b"}).ok(); assert!(m.set("c".to_string(), {}).is_ok()); } #[test] fn t5() { let mut m = ConfigManager::new(); m.load({"k1":"v1","k2":"v2"}).ok(); assert_eq!(m.list().unwrap().len(), 2); } #[test] fn t6() { let mut m = ConfigManager::new(); m.load({"k":"v"}).ok(); assert!(m.validate().ok().unwrap()); } #[test] fn t7() { let mut m = ConfigManager::new(); m.load({"a":"1"}).ok(); m.set("b".to_string(), {}).ok(); assert_eq!(m.list().unwrap().len(), 2); } #[test] fn t8() { let m = ConfigManager::new(); assert!(m.get("x".to_string()).is_err()); } #[test] fn t9() { let mut m = ConfigManager::new(); m.load({"k":"v"}).ok(); m.load({"k":"v2"}).ok(); assert_eq!(m.get("k".to_string()).unwrap(), "v2"); } #[test] fn t10() { let mut m = ConfigManager::new(); m.load({"k1":"v1","k2":"v2","k3":"v3"}).ok(); assert!(m.validate().is_ok()); } }
