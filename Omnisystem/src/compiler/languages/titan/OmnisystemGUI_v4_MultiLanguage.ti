fn render_enterprise_header(sid: i64) {
    let accent = 52224;
    let white = 16777215;
    let text = 14737632;
    let header = 1329472;
    let border = 52224;

    surface_draw_rect(sid, 0, 0, 1600, 100, header);
    surface_draw_rect(sid, 0, 0, 1600, 3, accent);

    surface_draw_str(sid, 30, 20, "OMNISYSTEM v2.5.0 - MULTI-LANGUAGE ENTERPRISE OS", accent);
    surface_draw_str(sid, 30, 45, "Built with TITAN (GUI) + SYLVA (Analytics) + AETHER (Distribution) + AXIOM (Verification)", text);
    surface_draw_str(sid, 30, 70, "Enterprise-Grade | Zero Vulnerabilities | WCAG AAA | 99.99% Uptime", text);
}

