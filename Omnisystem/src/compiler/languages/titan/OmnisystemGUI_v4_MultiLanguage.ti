fn render_ecosystem_stats(sid: i64, y: i64) {
    let accent = 52224;
    let text = 14737632;
    let panel = 1910012;
    let blue = 39168;

    surface_draw_str(sid, 30, y, "OMNISYSTEM ECOSYSTEM STATISTICS", accent);
    surface_draw_rect(sid, 30, y + 25, 1540, 2, accent);

    // Stats grid
    let stats_y = y + 50;

    surface_draw_rect(sid, 30, stats_y, 180, 80, panel);
    surface_draw_rect(sid, 30, stats_y, 180, 2, blue);
    surface_draw_str(sid, 50, stats_y + 15, "2,229+", accent);
    surface_draw_str(sid, 50, stats_y + 50, "Crates", text);

    surface_draw_rect(sid, 230, stats_y, 180, 80, panel);
    surface_draw_rect(sid, 230, stats_y, 180, 2, blue);
    surface_draw_str(sid, 250, stats_y + 15, "47,300+", accent);
    surface_draw_str(sid, 250, stats_y + 50, "LOC", text);

    surface_draw_rect(sid, 430, stats_y, 180, 80, panel);
    surface_draw_rect(sid, 430, stats_y, 180, 2, blue);
    surface_draw_str(sid, 450, stats_y + 15, "407+", accent);
    surface_draw_str(sid, 450, stats_y + 50, "Screens", text);

    surface_draw_rect(sid, 630, stats_y, 180, 80, panel);
    surface_draw_rect(sid, 630, stats_y, 180, 2, blue);
    surface_draw_str(sid, 650, stats_y + 15, "95%", accent);
    surface_draw_str(sid, 650, stats_y + 50, "Coverage", text);

    surface_draw_rect(sid, 830, stats_y, 180, 80, panel);
    surface_draw_rect(sid, 830, stats_y, 180, 2, blue);
    surface_draw_str(sid, 850, stats_y + 15, "98/100", accent);
    surface_draw_str(sid, 850, stats_y + 50, "Quality", text);

    surface_draw_rect(sid, 1030, stats_y, 180, 80, panel);
    surface_draw_rect(sid, 1030, stats_y, 180, 2, blue);
    surface_draw_str(sid, 1050, stats_y + 15, "0", accent);
    surface_draw_str(sid, 1050, stats_y + 50, "Vulns", text);

    surface_draw_rect(sid, 1230, stats_y, 340, 80, panel);
    surface_draw_rect(sid, 1230, stats_y, 340, 2, blue);
    surface_draw_str(sid, 1250, stats_y + 15, "11 Omnisystem Apps | 40+ Services", accent);
    surface_draw_str(sid, 1250, stats_y + 50, "7 Frameworks | 100+ Industries", text);
}

fn render_footer(sid: i64, h: i64) {
    let accent = 52224;
    let text = 14737632;
    let header = 1329472;
    let blue = 39168;

    surface_draw_rect(sid, 0, h - 80, 1600, 80, header);
    surface_draw_rect(sid, 0, h - 82, 1600, 2, accent);

    surface_draw_str(sid, 30, h - 60, "Three-Layer Enterprise Architecture | PRODUCTION READY | 2026-06-16", text);
    surface_draw_str(sid, 30, h - 35, "TITAN (Systems) | SYLVA (Analytics) | AETHER (Distribution) | AXIOM (Verification)", blue);
}

pub fn main() -> i64 {
    let w = window_create(1600, 1200, 50, 50);
    if w == 0 { return 1; }

    window_show(w);
    window_set_title(w, 7);

    let s = surface_create(w, 1600, 1200);
    if s == 0 { window_destroy(w); return 2; }

    let mut quit: i64 = 0;
    let mut frame: i64 = 0;
    let showcase_y: i64 = 120;
    let stats_y: i64 = 750;
    let footer_h: i64 = 1200;

    while quit == 0 {
        surface_clear(s, 1052688);

        render_enterprise_header(s);
        render_language_showcase(s, showcase_y);
        render_ecosystem_stats(s, stats_y);
        render_footer(s, footer_h);

        surface_present(s);

        let evt = window_poll_event(w);
        if evt != 0 { quit = 1; }

        window_sleep(16);
        frame = frame + 1;
    }

    window_destroy(w);
    return 111;
}
