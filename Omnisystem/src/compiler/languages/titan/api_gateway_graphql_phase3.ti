pub struct Manager { data: Object }
impl Manager {
    pub fn new() -> Self { Manager { data: {} } }
    pub fn create(mut self: Self, id: String) -> Result[Object] { if id.is_empty() { Err("ID") } else { self.data[id.clone()] = {}; Ok(self.data[id]) } }
    pub fn get(self: &Self, id: String) -> Result[Object] { if !self.data.contains(&id) { Err("Not found") } else { Ok(self.data[id]) } }
    pub fn list(self: &Self) -> Result[Array[String]] { let mut l: Array[String] = []; for e in self.data { l.push(e.0) } Ok(l) }
    pub fn delete(mut self: Self, id: String) -> Result[bool] { if !self.data.contains(&id) { Err("Not found") } else { self.data.remove(&id); Ok(true) } }
}
#[cfg(test)]
mod tests { use super::*; #[test] fn t1() { let mut m = Manager::new(); assert!(m.create("id1".to_string()).is_ok()); } #[test] fn t2() { let mut m = Manager::new(); m.create("id1".to_string()).ok(); assert!(m.get("id1".to_string()).is_ok()); } #[test] fn t3() { let m = Manager::new(); assert!(m.get("id1".to_string()).is_err()); } #[test] fn t4() { let m = Manager::new(); assert!(m.list().is_ok()); } #[test] fn t5() { let mut m = Manager::new(); m.create("id1".to_string()).ok(); assert!(m.delete("id1".to_string()).is_ok()); } #[test] fn t6() { let mut m = Manager::new(); assert!(m.create("".to_string()).is_err()); } #[test] fn t7() { let mut m = Manager::new(); m.create("id1".to_string()).ok(); m.create("id2".to_string()).ok(); assert_eq!(m.list().unwrap().len(), 2); } #[test] fn t8() { let mut m = Manager::new(); m.create("id1".to_string()).ok(); assert!(m.delete("id1".to_string()).is_ok()); assert!(m.delete("id1".to_string()).is_err()); } #[test] fn t9() { let mut m = Manager::new(); m.create("id1".to_string()).ok(); m.create("id2".to_string()).ok(); m.create("id3".to_string()).ok(); assert_eq!(m.list().unwrap().len(), 3); } #[test] fn t10() { let m = Manager::new(); let r = m.list(); assert!(r.is_ok() && r.unwrap().len() == 0); } }
