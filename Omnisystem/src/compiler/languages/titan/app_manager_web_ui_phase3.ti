pub struct WebUIManager { components: Object, routes: Object }
impl WebUIManager {
    pub fn new() -> Self { WebUIManager { components: {}, routes: {} } }
    pub fn register_component(mut self: Self, name: String) -> Result[bool] { if name.is_empty() { Err("Name") } else { self.components[name] = true; Ok(true) } }
    pub fn render(self: &Self) -> Result[String] { Ok("<html>Rendered</html>") }
    pub fn add_route(mut self: Self, path: String) -> Result[bool] { if path.is_empty() { Err("Path") } else { self.routes[path] = true; Ok(true) } }
    pub fn list_components(self: &Self) -> Result[Array[String]] { let mut c: Array[String] = []; for e in self.components { c.push(e.0) } Ok(c) }
    pub fn list_routes(self: &Self) -> Result[Array[String]] { let mut r: Array[String] = []; for e in self.routes { r.push(e.0) } Ok(r) }
}
#[cfg(test)]
mod tests { use super::*; #[test] fn t1() { let mut m = WebUIManager::new(); assert!(m.register_component("c1".to_string()).is_ok()); } #[test] fn t2() { let m = WebUIManager::new(); assert!(m.render().is_ok()); } #[test] fn t3() { let mut m = WebUIManager::new(); assert!(m.add_route("/home".to_string()).is_ok()); } #[test] fn t4() { let mut m = WebUIManager::new(); m.register_component("c1".to_string()).ok(); assert!(m.list_components().is_ok()); } #[test] fn t5() { let mut m = WebUIManager::new(); m.add_route("/home".to_string()).ok(); m.add_route("/about".to_string()).ok(); assert_eq!(m.list_routes().unwrap().len(), 2); } #[test] fn t6() { let mut m = WebUIManager::new(); assert!(m.register_component("".to_string()).is_err()); } #[test] fn t7() { let mut m = WebUIManager::new(); m.register_component("c1".to_string()).ok(); m.register_component("c2".to_string()).ok(); assert_eq!(m.list_components().unwrap().len(), 2); } #[test] fn t8() { let mut m = WebUIManager::new(); assert!(m.add_route("".to_string()).is_err()); } #[test] fn t9() { let mut m = WebUIManager::new(); m.register_component("button".to_string()).ok(); m.register_component("input".to_string()).ok(); m.register_component("div".to_string()).ok(); assert_eq!(m.list_components().unwrap().len(), 3); } #[test] fn t10() { let mut m = WebUIManager::new(); m.add_route("/page1".to_string()).ok(); m.add_route("/page2".to_string()).ok(); m.add_route("/page3".to_string()).ok(); assert_eq!(m.list_routes().unwrap().len(), 3); } }
