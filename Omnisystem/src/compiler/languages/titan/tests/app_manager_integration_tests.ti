// Integration Tests: TITAN app_manager ↔ Rust app-manager-api
//
// Tests cross-language function calls between TITAN and Rust
// through the Universal Language Layer (ULL) bridge

import app_manager
import ull::bridge
import ull::types

// Test module for app manager integration
pub mod app_manager_tests {

    // Test 1: Create and verify AppState
    #[test]
    fn test_create_app_state() {
        let app = app_manager::AppState::new("test-app-1")

        assert_eq!(app.app_id, "test-app-1")
        assert_eq!(app.version, "0.1.0")
        assert_eq!(app.state, "created")
        assert_eq!(app.running, false)
        assert!(app.installed_at.is_none())
    }

    // Test 2: Mark app as installed
    #[test]
    fn test_mark_installed() {
        let app = app_manager::AppState::new("test-app-2")
            .mark_installed()

        assert_eq!(app.state, "installed")
        assert!(app.installed_at.is_some())
    }

    // Test 3: Mark app as running
    #[test]
    fn test_mark_running() {
        let app = app_manager::AppState::new("test-app-3")
            .mark_running()

        assert_eq!(app.running, true)
    }

    // Test 4: Mark app as stopped
    #[test]
    fn test_mark_stopped() {
        let app = app_manager::AppState::new("test-app-4")
            .mark_running()
            .mark_stopped()

        assert_eq!(app.running, false)
    }

    // Test 5: Get app info from Rust through ULL
    #[test]
    async fn test_get_app_info_from_rust() {
        let result = app_manager::get_app_info("real-app-id")

        // Should succeed if Rust function is available
        assert!(result.is_ok() || result.is_err())
        // Note: Actual behavior depends on Rust implementation
    }

    // Test 6: List apps from Rust through ULL
    #[test]
    async fn test_list_apps_from_rust() {
        let result = app_manager::list_apps()

        // Should return array or error
        assert!(result.is_ok() || result.is_err())
    }

    // Test 7: Install app through Rust bridge
    #[test]
    async fn test_install_app_through_bridge() {
        let result = app_manager::install_app("new-app", "1.0.0")

        // Should return AppState or error
        if let Ok(app) = result {
            assert_eq!(app.app_id, "new-app")
            assert_eq!(app.version, "1.0.0")
        }
    }

    // Test 8: Uninstall app through Rust bridge
    #[test]
    async fn test_uninstall_app_through_bridge() {
        let result = app_manager::uninstall_app("app-to-remove")

        // Should return boolean or error
        assert!(result.is_ok() || result.is_err())
    }

    // Test 9: AppState lifecycle
    #[test]
    fn test_app_state_lifecycle() {
        let mut app = app_manager::AppState::new("lifecycle-app")

        // Initial state
        assert_eq!(app.state, "created")
        assert!(!app.running)

        // Mark installed
        app = app.mark_installed()
        assert_eq!(app.state, "installed")

        // Mark running
        app = app.mark_running()
        assert!(app.running)

        // Mark stopped
        app = app.mark_stopped()
        assert!(!app.running)

        // Final verification
        assert_eq!(app.version, "0.1.0")
    }

    // Test 10: Type safety - AppState can't be modified incorrectly
    #[test]
    fn test_app_state_type_safety() {
        let app = app_manager::AppState::new("safe-app")

        // These should compile without errors
        assert_eq!(app.app_id.len(), 8) // "safe-app"
        assert_eq!(app.version.len(), 5) // "0.1.0"

        // The following would be compile errors (test code correctness):
        // app.app_id = 123  // Error: expected String, got i64
        // app.running = "true"  // Error: expected bool, got String
    }

    // Test 11: Multiple apps independent
    #[test]
    fn test_multiple_apps() {
        let app1 = app_manager::AppState::new("app-1")
        let app2 = app_manager::AppState::new("app-2")
        let app3 = app_manager::AppState::new("app-3")

        assert_eq!(app1.app_id, "app-1")
        assert_eq!(app2.app_id, "app-2")
        assert_eq!(app3.app_id, "app-3")

        // Verify independence
        assert_ne!(app1.app_id, app2.app_id)
        assert_ne!(app2.app_id, app3.app_id)
    }

    // Test 12: ULL bridge is available
    #[test]
    fn test_ull_bridge_available() {
        // Verify we can access ULL types
        let val = ull::types::Value::string("test")
        assert_eq!(val.as_str().unwrap(), "test")
    }

    // Test 13: Cross-language async support
    #[test]
    async fn test_async_cross_language_call() {
        // These async calls should work across language boundary
        let _result1 = app_manager::get_app_info("app-1");
        let _result2 = app_manager::list_apps();
        let _result3 = app_manager::install_app("app-new", "1.0.0");

        // All async operations should complete
        // (actual success depends on Rust implementation)
    }

    // Test 14: Error handling from bridge
    #[test]
    async fn test_error_handling() {
        // Test error cases
        let result = app_manager::get_app_info("nonexistent-app")

        match result {
            Ok(app) => {
                // If Rust returns success, verify structure
                assert!(!app.app_id.is_empty())
            }
            Err(_e) => {
                // If error, that's also valid (app not found)
            }
        }
    }

    // Test 15: Roundtrip data integrity
    #[test]
    async fn test_roundtrip_data_integrity() {
        // Create an app
        let created_app = app_manager::AppState::new("roundtrip-test")
            .mark_installed()
            .mark_running()

        // Verify all fields preserved
        assert_eq!(created_app.app_id, "roundtrip-test")
        assert_eq!(created_app.version, "0.1.0")
        assert_eq!(created_app.state, "installed")
        assert_eq!(created_app.running, true)
        assert!(created_app.installed_at.is_some())

        // If sent through Rust bridge and back, data should match
        // This tests the ULL type conversion system
    }
}

// Integration test module - tests the bridge layer
pub mod ull_bridge_tests {

    #[test]
    fn test_bridge_can_be_called() {
        // Verify we can access the bridge
        let _result = bridge::call_rust("app-manager-api", "list_apps", {});
        // Actual execution depends on Rust implementation
    }

    #[test]
    fn test_type_conversion_string() {
        let val = ull::types::Value::string("hello")
        let str_val = val.as_str().unwrap()
        assert_eq!(str_val, "hello")
    }

    #[test]
    fn test_type_conversion_integer() {
        let val = ull::types::Value::integer(42)
        let int_val = val.as_i64().unwrap()
        assert_eq!(int_val, 42)
    }

    #[test]
    fn test_type_conversion_boolean() {
        let val = ull::types::Value::boolean(true)
        let bool_val = val.as_bool().unwrap()
        assert_eq!(bool_val, true)
    }

    #[test]
    fn test_type_conversion_array() {
        let vals = vec![
            ull::types::Value::integer(1),
            ull::types::Value::integer(2),
            ull::types::Value::integer(3),
        ]
        let arr = ull::types::Value::array(vals)
        let recovered = arr.as_array().unwrap()
        assert_eq!(recovered.len(), 3)
    }

    #[test]
    fn test_type_conversion_object() {
        let mut obj = {}
        obj["key1"] = ull::types::Value::string("value1")
        obj["key2"] = ull::types::Value::integer(42)

        let val = ull::types::Value::object(obj)
        let obj_recovered = val.as_object().unwrap()

        assert_eq!(obj_recovered["key1"].as_str().unwrap(), "value1")
        assert_eq!(obj_recovered["key2"].as_i64().unwrap(), 42)
    }
}

// End of tests
