pub struct DesktopUIManager { windows: Object, layout: String }
impl DesktopUIManager {
    pub fn new() -> Self { DesktopUIManager { windows: {}, layout: "default" } }
    pub fn create_window(mut self: Self, id: String) -> Result[Object] { if id.is_empty() { Err("ID") } else { self.windows[id.clone()] = {"id": id}; Ok(self.windows[id]) } }
    pub fn close_window(mut self: Self, id: String) -> Result[bool] { if !self.windows.contains(&id) { Err("Not found") } else { self.windows.remove(&id); Ok(true) } }
    pub fn set_layout(mut self: Self, layout: String) -> Result[bool] { if layout.is_empty() { Err("Layout") } else { self.layout = layout; Ok(true) } }
    pub fn list_windows(self: &Self) -> Result[Array[String]] { let mut w: Array[String] = []; for e in self.windows { w.push(e.0) } Ok(w) }
}
#[cfg(test)]
mod tests { use super::*; #[test] fn t1() { let mut m = DesktopUIManager::new(); assert!(m.create_window("w1".to_string()).is_ok()); } #[test] fn t2() { let mut m = DesktopUIManager::new(); m.create_window("w1".to_string()).ok(); assert!(m.close_window("w1".to_string()).is_ok()); } #[test] fn t3() { let mut m = DesktopUIManager::new(); assert!(m.set_layout("compact".to_string()).is_ok()); } #[test] fn t4() { let mut m = DesktopUIManager::new(); m.create_window("w1".to_string()).ok(); m.create_window("w2".to_string()).ok(); assert_eq!(m.list_windows().unwrap().len(), 2); } #[test] fn t5() { let m = DesktopUIManager::new(); assert!(m.create_window("".to_string()).is_err()); } #[test] fn t6() { let mut m = DesktopUIManager::new(); assert!(m.set_layout("".to_string()).is_err()); } #[test] fn t7() { let mut m = DesktopUIManager::new(); m.create_window("w1".to_string()).ok(); m.close_window("w1".to_string()).ok(); assert!(m.close_window("w1".to_string()).is_err()); } #[test] fn t8() { let mut m = DesktopUIManager::new(); m.create_window("w1".to_string()).ok(); assert!(m.list_windows().is_ok()); } #[test] fn t9() { let mut m = DesktopUIManager::new(); m.create_window("w1".to_string()).ok(); m.create_window("w2".to_string()).ok(); m.create_window("w3".to_string()).ok(); assert_eq!(m.list_windows().unwrap().len(), 3); } #[test] fn t10() { let mut m = DesktopUIManager::new(); m.set_layout("dark".to_string()).ok(); m.set_layout("light".to_string()).ok(); assert_eq!(m.layout, "light".to_string()); } }
