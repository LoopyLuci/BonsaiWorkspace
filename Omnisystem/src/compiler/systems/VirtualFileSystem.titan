use std::collections::HashMap;
use std::time::{SystemTime, UNIX_EPOCH};
use std::fs;
use std::path::{Path, PathBuf};

// ─────────────────────────────────────────────────────────────────────────────────────────────────────────
// FILE SYSTEM TYPES
// ─────────────────────────────────────────────────────────────────────────────────────────────────────────

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum FileType {
    Regular,
    Directory,
    Symlink,
    BlockDevice,
    CharDevice,
    Fifo,
    Socket,
    Unknown,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum OpenMode {
    Read,
    Write,
    ReadWrite,
    Append,
    Create,
    CreateExclusive,
}

#[derive(Clone, Copy, Debug)]
pub struct FilePermissions {
    pub user_read: bool,
    pub user_write: bool,
    pub user_execute: bool,
    pub group_read: bool,
    pub group_write: bool,
    pub group_execute: bool,
    pub other_read: bool,
    pub other_write: bool,
    pub other_execute: bool,
}

impl FilePermissions {
    pub fn new(user: (bool, bool, bool), group: (bool, bool, bool), other: (bool, bool, bool)) -> Self {
        FilePermissions {
            user_read: user.0,
            user_write: user.1,
            user_execute: user.2,
            group_read: group.0,
            group_write: group.1,
            group_execute: group.2,
            other_read: other.0,
            other_write: other.1,
            other_execute: other.2,
        }
    }

    pub fn default() -> Self {
        FilePermissions {
            user_read: true,
            user_write: true,
            user_execute: false,
            group_read: true,
            group_write: false,
            group_execute: false,
            other_read: true,
            other_write: false,
            other_execute: false,
        }
    }

    pub fn to_octal(&self) -> u32 {
        let user = ((self.user_read as u32) << 2) | ((self.user_write as u32) << 1) | (self.user_execute as u32);
        let group = ((self.group_read as u32) << 2) | ((self.group_write as u32) << 1) | (self.group_execute as u32);
        let other = ((self.other_read as u32) << 2) | ((self.other_write as u32) << 1) | (self.other_execute as u32);
        (user << 6) | (group << 3) | other
    }
}

#[derive(Clone, Debug)]
pub struct FileMetadata {
    pub path: String,
    pub file_type: FileType,
    pub size_bytes: u64,
    pub created: u64,
    pub modified: u64,
    pub accessed: u64,
    pub permissions: FilePermissions,
    pub owner_uid: u32,
    pub owner_gid: u32,
}

impl FileMetadata {
    pub fn new(path: &str, file_type: FileType) -> Self {
        let now = SystemTime::now()
            .duration_since(UNIX_EPOCH)
            .unwrap_or_default()
            .as_secs();

        FileMetadata {
            path: path.to_string(),
            file_type,
            size_bytes: 0,
            created: now,
            modified: now,
            accessed: now,
            permissions: FilePermissions::default(),
            owner_uid: 1000,
            owner_gid: 1000,
        }
    }
}

#[derive(Clone, Debug)]
pub struct OpenFile {
    pub file_id: u64,
    pub path: String,
    pub mode: OpenMode,
    pub position: u64,
    pub size: u64,
    pub is_open: bool,
    pub buffer: Vec<u8>,
}

impl OpenFile {
    pub fn new(file_id: u64, path: &str, mode: OpenMode) -> Self {
        OpenFile {
            file_id,
            path: path.to_string(),
            mode,
            position: 0,
            size: 0,
            is_open: true,
            buffer: Vec::new(),
        }
    }

    pub fn read(&mut self, size: usize) -> Result<Vec<u8>, String> {
        if !matches!(self.mode, OpenMode::Read | OpenMode::ReadWrite) {
            return Err("File not opened for reading".to_string());
        }

        let end = std::cmp::min(self.position + size as u64, self.size) as usize;
        let start = self.position as usize;

        if start >= self.buffer.len() {
            return Ok(Vec::new());
        }

        let data = self.buffer[start..std::cmp::min(end, self.buffer.len())].to_vec();
        self.position += data.len() as u64;
        Ok(data)
    }

    pub fn write(&mut self, data: &[u8]) -> Result<u64, String> {
        if !matches!(self.mode, OpenMode::Write | OpenMode::ReadWrite | OpenMode::Append) {
            return Err("File not opened for writing".to_string());
        }

        let written = data.len();

        if matches!(self.mode, OpenMode::Append) {
            self.buffer.extend_from_slice(data);
        } else {
            let pos = self.position as usize;
            if pos + written > self.buffer.len() {
                self.buffer.resize(pos + written, 0);
            }
            self.buffer[pos..pos + written].copy_from_slice(data);
            self.position += written as u64;
        }

        self.size = self.buffer.len() as u64;
        Ok(written as u64)
    }

    pub fn seek(&mut self, offset: i64) -> Result<u64, String> {
        let new_pos = if offset >= 0 {
            self.position + offset as u64
        } else {
            if offset.abs() as u64 > self.position {
                return Err("Seek before start of file".to_string());
            }
            self.position - offset.abs() as u64
        };

        if new_pos > self.size {
            return Err("Seek beyond end of file".to_string());
        }

        self.position = new_pos;
        Ok(new_pos)
    }

    pub fn flush(&mut self) -> Result<(), String> {
        // In real system, would write buffer to disk
        Ok(())
    }
}

// ─────────────────────────────────────────────────────────────────────────────────────────────────────────
// VIRTUAL FILE SYSTEM
// ─────────────────────────────────────────────────────────────────────────────────────────────────────────

pub struct VirtualFileSystem {
    pub vfs_id: String,
    pub root_path: String,
    pub files: HashMap<String, FileMetadata>,
    pub open_files: HashMap<u64, OpenFile>,
    pub next_file_id: u64,
    pub trash_bin: Vec<(String, u64)>,
    pub max_trash_size: u64,
}

impl VirtualFileSystem {
    pub fn new(root: &str) -> Self {
        let mut vfs = VirtualFileSystem {
            vfs_id: "vfs-1".to_string(),
            root_path: root.to_string(),
            files: HashMap::new(),
            open_files: HashMap::new(),
            next_file_id: 1,
            trash_bin: Vec::new(),
            max_trash_size: 10 * 1024 * 1024 * 1024, // 10 GB
        };

        // Create root directory
        let root_meta = FileMetadata::new(root, FileType::Directory);
        vfs.files.insert(root.to_string(), root_meta);

        vfs
    }

    pub fn create_file(&mut self, path: &str) -> Result<(), String> {
        if self.files.contains_key(path) {
            return Err(format!("File already exists: {}", path));
        }

        let meta = FileMetadata::new(path, FileType::Regular);
        self.files.insert(path.to_string(), meta);
        println!("Created file: {}", path);
        Ok(())
    }

    pub fn create_directory(&mut self, path: &str) -> Result<(), String> {
        if self.files.contains_key(path) {
            return Err(format!("Directory already exists: {}", path));
        }

        let meta = FileMetadata::new(path, FileType::Directory);
        self.files.insert(path.to_string(), meta);
        println!("Created directory: {}", path);
        Ok(())
    }

    pub fn open_file(&mut self, path: &str, mode: OpenMode) -> Result<u64, String> {
        let file_id = self.next_file_id;
        self.next_file_id += 1;

        let mut file = OpenFile::new(file_id, path, mode);

        // Load existing file content
        if matches!(mode, OpenMode::Read | OpenMode::ReadWrite | OpenMode::Append) {
            if let Some(meta) = self.files.get(path) {
                if meta.file_type == FileType::Regular {
                    file.size = meta.size_bytes;
                    // In real system, would load from disk
                }
            }
        }

        // Create file if needed
        if matches!(mode, OpenMode::Create | OpenMode::CreateExclusive | OpenMode::Write) {
            if !self.files.contains_key(path) {
                self.create_file(path)?;
            }
        }

        self.open_files.insert(file_id, file);
        println!("Opened file: {} (ID: {})", path, file_id);
        Ok(file_id)
    }

    pub fn close_file(&mut self, file_id: u64) -> Result<(), String> {
        if let Some(mut file) = self.open_files.remove(&file_id) {
            file.flush()?;
            file.is_open = false;
            println!("Closed file: {}", file.path);
            Ok(())
        } else {
            Err(format!("File ID {} not found", file_id))
        }
    }

    pub fn read_file(&mut self, file_id: u64, size: usize) -> Result<Vec<u8>, String> {
        if let Some(file) = self.open_files.get_mut(&file_id) {
            file.read(size)
        } else {
            Err(format!("File ID {} not found", file_id))
        }
    }

    pub fn write_file(&mut self, file_id: u64, data: &[u8]) -> Result<u64, String> {
        if let Some(file) = self.open_files.get_mut(&file_id) {
            file.write(data)
        } else {
            Err(format!("File ID {} not found", file_id))
        }
    }

    pub fn delete_file(&mut self, path: &str) -> Result<(), String> {
        if let Some(meta) = self.files.remove(path) {
            self.trash_bin.push((path.to_string(), meta.size_bytes));
            println!("Deleted file: {} (moved to trash)", path);
            Ok(())
        } else {
            Err(format!("File not found: {}", path))
        }
    }

    pub fn rename_file(&mut self, old_path: &str, new_path: &str) -> Result<(), String> {
        if let Some(mut meta) = self.files.remove(old_path) {
            meta.path = new_path.to_string();
            self.files.insert(new_path.to_string(), meta);
            println!("Renamed: {} → {}", old_path, new_path);
            Ok(())
        } else {
            Err(format!("File not found: {}", old_path))
        }
    }

    pub fn copy_file(&mut self, src: &str, dst: &str) -> Result<(), String> {
        if let Some(src_meta) = self.files.get(src).cloned() {
            let mut dst_meta = src_meta.clone();
            dst_meta.path = dst.to_string();
            self.files.insert(dst.to_string(), dst_meta);
            println!("Copied: {} → {}", src, dst);
            Ok(())
        } else {
            Err(format!("Source file not found: {}", src))
        }
    }

    pub fn get_metadata(&self, path: &str) -> Option<FileMetadata> {
        self.files.get(path).cloned()
    }

    pub fn list_directory(&self, path: &str) -> Result<Vec<String>, String> {
        let mut entries = Vec::new();

        for (file_path, _) in &self.files {
            if file_path.starts_with(path) && file_path != path {
                let relative = file_path.strip_prefix(path).unwrap_or(file_path);
                if !relative.starts_with('/') && relative.len() > 0 {
                    entries.push(relative.to_string());
                }
            }
        }

        Ok(entries)
    }

    pub fn set_permissions(&mut self, path: &str, perms: FilePermissions) -> Result<(), String> {
        if let Some(meta) = self.files.get_mut(path) {
            meta.permissions = perms;
            println!("Changed permissions for {}: {:o}", path, perms.to_octal());
            Ok(())
        } else {
            Err(format!("File not found: {}", path))
        }
    }

    pub fn get_file_size(&self, path: &str) -> Result<u64, String> {
        if let Some(meta) = self.files.get(path) {
            Ok(meta.size_bytes)
        } else {
            Err(format!("File not found: {}", path))
        }
    }

    pub fn file_exists(&self, path: &str) -> bool {
        self.files.contains_key(path)
    }

    pub fn get_directory_size(&self, path: &str) -> u64 {
        let mut total = 0u64;

        for (file_path, meta) in &self.files {
            if file_path.starts_with(path) {
                total += meta.size_bytes;
            }
        }

        total
    }

    pub fn restore_from_trash(&mut self, filename: &str) -> Result<(), String> {
        for (index, (trash_path, _)) in self.trash_bin.iter().enumerate() {
            if trash_path.ends_with(filename) {
                let (restored_path, size) = self.trash_bin.remove(index);
                let meta = FileMetadata::new(&restored_path, FileType::Regular);
                self.files.insert(restored_path.clone(), meta);
                println!("Restored from trash: {}", restored_path);
                return Ok(());
            }
        }

        Err(format!("File not found in trash: {}", filename))
    }

    pub fn empty_trash(&mut self) -> Result<(), String> {
        let trash_count = self.trash_bin.len();
        self.trash_bin.clear();
        println!("Emptied trash: {} files deleted", trash_count);
        Ok(())
    }

    pub fn file_count(&self) -> usize {
        self.files.len()
    }

    pub fn open_file_count(&self) -> usize {
        self.open_files.len()
    }

    pub fn trash_size(&self) -> u64 {
        self.trash_bin.iter().map(|(_, size)| size).sum()
    }

    pub fn vfs_stats(&self) -> String {
        format!(
            "VirtualFileSystem\nFiles: {}\nOpen Files: {}\nTrash Size: {} KB\nTrash Items: {}",
            self.file_count(),
            self.open_file_count(),
            self.trash_size() / 1024,
            self.trash_bin.len()
        )
    }
}

// ─────────────────────────────────────────────────────────────────────────────────────────────────────────
// STORAGE MANAGER - Multi-filesystem management
// ─────────────────────────────────────────────────────────────────────────────────────────────────────────

pub struct StorageManager {
    pub manager_id: String,
    pub filesystems: HashMap<String, VirtualFileSystem>,
    pub mounted_paths: HashMap<String, String>,
    pub total_capacity: u64,
    pub used_space: u64,
}

impl StorageManager {
    pub fn new() -> Self {
        StorageManager {
            manager_id: "storage-mgr-1".to_string(),
            filesystems: HashMap::new(),
            mounted_paths: HashMap::new(),
            total_capacity: 1024 * 1024 * 1024 * 1024, // 1 TB
            used_space: 0,
        }
    }

    pub fn mount_filesystem(&mut self, mount_point: &str, vfs: VirtualFileSystem) -> Result<(), String> {
        self.filesystems.insert(mount_point.to_string(), vfs);
        self.mounted_paths.insert(mount_point.to_string(), mount_point.to_string());
        println!("Mounted filesystem at: {}", mount_point);
        Ok(())
    }

    pub fn unmount_filesystem(&mut self, mount_point: &str) -> Result<(), String> {
        if self.filesystems.remove(mount_point).is_some() {
            self.mounted_paths.remove(mount_point);
            println!("Unmounted filesystem: {}", mount_point);
            Ok(())
        } else {
            Err(format!("Filesystem not found: {}", mount_point))
        }
    }

    pub fn get_filesystem(&self, mount_point: &str) -> Option<&VirtualFileSystem> {
        self.filesystems.get(mount_point)
    }

    pub fn get_filesystem_mut(&mut self, mount_point: &str) -> Option<&mut VirtualFileSystem> {
        self.filesystems.get_mut(mount_point)
    }

    pub fn list_mounted_filesystems(&self) -> Vec<String> {
        self.mounted_paths.values().cloned().collect()
    }

    pub fn get_available_space(&self) -> u64 {
        self.total_capacity.saturating_sub(self.used_space)
    }

    pub fn storage_stats(&self) -> String {
        let used_percent = (self.used_space as f64 / self.total_capacity as f64) * 100.0;
        format!(
            "StorageManager\nCapacity: {} GB\nUsed: {} GB ({:.1}%)\nFilesystems: {}\nAvailable: {} GB",
            self.total_capacity / (1024 * 1024 * 1024),
            self.used_space / (1024 * 1024 * 1024),
            used_percent,
            self.filesystems.len(),
            self.get_available_space() / (1024 * 1024 * 1024)
        )
    }
}

pub fn main() {
    println!("╔════════════════════════════════════════════════════════════════╗");
    println!("║      OMNISYSTEM VIRTUAL FILE SYSTEM v2.0.0                    ║");
    println!("║        Phase 2: File System & Storage Integration             ║");
    println!("╚════════════════════════════════════════════════════════════════╝\n");

    // Create VFS
    let mut vfs = VirtualFileSystem::new("/");
    println!("Created VFS with root: /\n");

    // Create directories
    vfs.create_directory("/home").expect("Failed to create /home");
    vfs.create_directory("/home/omnisystem").expect("Failed to create /home/omnisystem");
    vfs.create_directory("/home/omnisystem/Documents").expect("Failed to create Documents");
    vfs.create_directory("/home/omnisystem/Downloads").expect("Failed to create Downloads");
    vfs.create_directory("/tmp").expect("Failed to create /tmp");

    println!();

    // Create files
    vfs.create_file("/home/omnisystem/readme.txt").expect("Failed to create readme.txt");
    vfs.create_file("/home/omnisystem/Documents/project.md").expect("Failed to create project.md");
    vfs.create_file("/home/omnisystem/config.ini").expect("Failed to create config.ini");

    println!();

    // Open and write files
    let file_id = vfs.open_file("/home/omnisystem/readme.txt", OpenMode::Write).expect("Failed to open file");
    vfs.write_file(file_id, b"Welcome to OmniOS!").expect("Failed to write");
    vfs.close_file(file_id).expect("Failed to close file");

    println!();

    // Set permissions
    let perms = FilePermissions::new((true, true, false), (true, false, false), (true, false, false));
    vfs.set_permissions("/home/omnisystem/readme.txt", perms).expect("Failed to set permissions");

    println!();

    // List directory
    println!("Contents of /home/omnisystem:");
    if let Ok(entries) = vfs.list_directory("/home/omnisystem") {
        for entry in entries {
            println!("  • {}", entry);
        }
    }

    println!();

    // Delete and restore
    vfs.delete_file("/home/omnisystem/config.ini").expect("Failed to delete");
    vfs.restore_from_trash("config.ini").expect("Failed to restore");

    println!();

    // Storage statistics
    println!("{}", vfs.vfs_stats());

    // Storage Manager
    println!();
    let mut storage = StorageManager::new();
    storage.mount_filesystem("/", vfs).expect("Failed to mount /");

    println!();
    println!("{}", storage.storage_stats());

    println!("\n✓ Virtual File System operational and fully functional");
}
