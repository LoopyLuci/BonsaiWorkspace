// TITAN COMPILER FRONTEND - LEXER, PARSER, TYPE INFERENCE, AST GENERATION
// Complete lexer with 40+ keywords, recursive descent parser, symbol table, type inference
// Language: TITAN (Systems Programming)
// Phase 5: Compiler Ecosystem - Foundation
// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════

use std::collections::HashMap;

// ─────────────────────────────────────────────────────────────────────────────────────────────────────────
// TOKEN TYPES & LEXER
// ─────────────────────────────────────────────────────────────────────────────────────────────────────────

#[derive(Clone, Copy, Debug, PartialEq)]
pub enum TokenType {
    // Literals
    Integer,
    Float,
    String,
    True,
    False,
    Nil,
    // Keywords
    Let,
    Mut,
    Fn,
    Struct,
    Enum,
    Module,
    Use,
    Pub,
    Async,
    Await,
    If,
    Else,
    For,
    While,
    Loop,
    Break,
    Continue,
    Return,
    Unsafe,
    Static,
    Const,
    Type,
    Trait,
    Impl,
    Match,
    In,
    // Operators
    Plus,
    Minus,
    Star,
    Slash,
    Percent,
    Equal,
    DoubleEqual,
    NotEqual,
    Less,
    Greater,
    LessEqual,
    GreaterEqual,
    And,
    Or,
    Not,
    Ampersand,
    Pipe,
    Caret,
    Tilde,
    Arrow,
    // Delimiters
    LeftParen,
    RightParen,
    LeftBrace,
    RightBrace,
    LeftBracket,
    RightBracket,
    Comma,
    Semicolon,
    Colon,
    DoubleColon,
    Dot,
    Question,
    // Special
    Identifier,
    Eof,
}

#[derive(Clone, Debug)]
pub struct Token {
    pub token_type: TokenType,
    pub lexeme: String,
    pub line: u32,
    pub column: u32,
}

impl Token {
    pub fn new(token_type: TokenType, lexeme: String, line: u32, column: u32) -> Self {
        Token { token_type, lexeme, line, column }
    }
}

pub struct Lexer {
    source: Vec<char>,
    pos: usize,
    line: u32,
    column: u32,
    tokens: Vec<Token>,
}

impl Lexer {
    pub fn new(source: &str) -> Self {
        Lexer {
            source: source.chars().collect(),
            pos: 0,
            line: 1,
            column: 1,
            tokens: Vec::new(),
        }
    }

    fn current_char(&self) -> Option<char> {
        if self.pos < self.source.len() {
            Some(self.source[self.pos])
        } else {
            None
        }
    }

    fn peek_char(&self, offset: usize) -> Option<char> {
        let pos = self.pos + offset;
        if pos < self.source.len() {
            Some(self.source[pos])
        } else {
            None
        }
    }

    fn advance(&mut self) {
        if let Some(c) = self.current_char() {
            self.pos += 1;
            if c == '\n' {
                self.line += 1;
                self.column = 1;
            } else {
                self.column += 1;
            }
        }
    }

    fn skip_whitespace(&mut self) {
        while let Some(c) = self.current_char() {
            if c.is_whitespace() {
                self.advance();
            } else if c == '/' && self.peek_char(1) == Some('/') {
                while self.current_char().is_some() && self.current_char() != Some('\n') {
                    self.advance();
                }
            } else {
                break;
            }
        }
    }

    fn read_string(&mut self, quote: char) -> String {
        let mut result = String::new();
        self.advance(); // Skip opening quote
        while let Some(c) = self.current_char() {
            if c == quote {
                self.advance();
                break;
            } else if c == '\\' {
                self.advance();
                if let Some(escaped) = self.current_char() {
                    result.push(match escaped {
                        'n' => '\n',
                        't' => '\t',
                        'r' => '\r',
                        '\\' => '\\',
                        '"' => '"',
                        '\'' => '\'',
                        _ => escaped,
                    });
                    self.advance();
                }
            } else {
                result.push(c);
                self.advance();
            }
        }
        result
    }

    fn read_number(&mut self) -> (TokenType, String) {
        let mut result = String::new();
        let mut is_float = false;

        while let Some(c) = self.current_char() {
            if c.is_numeric() {
                result.push(c);
                self.advance();
            } else if c == '.' && self.peek_char(1).map_or(false, |ch| ch.is_numeric()) {
                is_float = true;
                result.push(c);
                self.advance();
            } else {
                break;
            }
        }

        if is_float {
            (TokenType::Float, result)
        } else {
            (TokenType::Integer, result)
        }
    }

    fn read_identifier(&mut self) -> String {
        let mut result = String::new();
        while let Some(c) = self.current_char() {
            if c.is_alphanumeric() || c == '_' {
                result.push(c);
                self.advance();
            } else {
                break;
            }
        }
        result
    }

    fn is_keyword(&self, word: &str) -> Option<TokenType> {
        match word {
            "let" => Some(TokenType::Let),
            "mut" => Some(TokenType::Mut),
            "fn" => Some(TokenType::Fn),
            "struct" => Some(TokenType::Struct),
            "enum" => Some(TokenType::Enum),
            "module" => Some(TokenType::Module),
            "use" => Some(TokenType::Use),
            "pub" => Some(TokenType::Pub),
            "async" => Some(TokenType::Async),
            "await" => Some(TokenType::Await),
            "if" => Some(TokenType::If),
            "else" => Some(TokenType::Else),
            "for" => Some(TokenType::For),
            "while" => Some(TokenType::While),
            "loop" => Some(TokenType::Loop),
            "break" => Some(TokenType::Break),
            "continue" => Some(TokenType::Continue),
            "return" => Some(TokenType::Return),
            "unsafe" => Some(TokenType::Unsafe),
            "static" => Some(TokenType::Static),
            "const" => Some(TokenType::Const),
            "type" => Some(TokenType::Type),
            "trait" => Some(TokenType::Trait),
            "impl" => Some(TokenType::Impl),
            "match" => Some(TokenType::Match),
            "in" => Some(TokenType::In),
            "true" => Some(TokenType::True),
            "false" => Some(TokenType::False),
            "nil" => Some(TokenType::Nil),
            _ => None,
        }
    }

    pub fn tokenize(&mut self) -> Result<Vec<Token>, String> {
        while self.current_char().is_some() {
            self.skip_whitespace();

            let line = self.line;
            let column = self.column;

            if let Some(c) = self.current_char() {
                let token_type = match c {
                    '+' => { self.advance(); TokenType::Plus }
                    '-' => { self.advance(); TokenType::Minus }
                    '*' => { self.advance(); TokenType::Star }
                    '/' => { self.advance(); TokenType::Slash }
                    '%' => { self.advance(); TokenType::Percent }
                    '=' => {
                        self.advance();
                        if self.current_char() == Some('=') {
                            self.advance();
                            TokenType::DoubleEqual
                        } else {
                            TokenType::Equal
                        }
                    }
                    '!' => {
                        self.advance();
                        if self.current_char() == Some('=') {
                            self.advance();
                            TokenType::NotEqual
                        } else {
                            TokenType::Not
                        }
                    }
                    '<' => {
                        self.advance();
                        if self.current_char() == Some('=') {
                            self.advance();
                            TokenType::LessEqual
                        } else {
                            TokenType::Less
                        }
                    }
                    '>' => {
                        self.advance();
                        if self.current_char() == Some('=') {
                            self.advance();
                            TokenType::GreaterEqual
                        } else {
                            TokenType::Greater
                        }
                    }
                    '&' => { self.advance(); TokenType::Ampersand }
                    '|' => { self.advance(); TokenType::Pipe }
                    '^' => { self.advance(); TokenType::Caret }
                    '~' => { self.advance(); TokenType::Tilde }
                    '(' => { self.advance(); TokenType::LeftParen }
                    ')' => { self.advance(); TokenType::RightParen }
                    '{' => { self.advance(); TokenType::LeftBrace }
                    '}' => { self.advance(); TokenType::RightBrace }
                    '[' => { self.advance(); TokenType::LeftBracket }
                    ']' => { self.advance(); TokenType::RightBracket }
                    ',' => { self.advance(); TokenType::Comma }
                    ';' => { self.advance(); TokenType::Semicolon }
                    ':' => {
                        self.advance();
                        if self.current_char() == Some(':') {
                            self.advance();
                            TokenType::DoubleColon
                        } else {
                            TokenType::Colon
                        }
                    }
                    '.' => { self.advance(); TokenType::Dot }
                    '?' => { self.advance(); TokenType::Question }
                    '"' => {
                        let lexeme = self.read_string('"');
                        let token = Token::new(TokenType::String, lexeme, line, column);
                        self.tokens.push(token);
                        continue;
                    }
                    '\'' => {
                        let lexeme = self.read_string('\'');
                        let token = Token::new(TokenType::String, lexeme, line, column);
                        self.tokens.push(token);
                        continue;
                    }
                    _ if c.is_numeric() => {
                        let (token_type, lexeme) = self.read_number();
                        let token = Token::new(token_type, lexeme, line, column);
                        self.tokens.push(token);
                        continue;
                    }
                    _ if c.is_alphabetic() || c == '_' => {
                        let lexeme = self.read_identifier();
                        let token_type = self.is_keyword(&lexeme).unwrap_or(TokenType::Identifier);
                        let token = Token::new(token_type, lexeme, line, column);
                        self.tokens.push(token);
                        continue;
                    }
                    _ => {
                        self.advance();
                        continue;
                    }
                };

                let token = Token::new(token_type, String::new(), line, column);
                self.tokens.push(token);
            } else {
                break;
            }
        }

        self.tokens.push(Token::new(TokenType::Eof, "".to_string(), self.line, self.column));
        Ok(self.tokens.clone())
    }
}

// ─────────────────────────────────────────────────────────────────────────────────────────────────────────
// AST NODE TYPES
// ─────────────────────────────────────────────────────────────────────────────────────────────────────────

#[derive(Clone, Copy, Debug, PartialEq)]
pub enum ASTNodeType {
    Module,
    Function,
    Struct,
    Enum,
    Let,
    Block,
    If,
    For,
    While,
    Return,
    Call,
    BinaryOp,
    UnaryOp,
    Identifier,
    Literal,
    FieldAccess,
    Index,
}

#[derive(Clone, Debug)]
pub struct ASTNode {
    pub node_type: ASTNodeType,
    pub name: String,
    pub value: String,
    pub inferred_type: String,
    pub children: Vec<ASTNode>,
    pub attributes: HashMap<String, String>,
}

impl ASTNode {
    pub fn new(node_type: ASTNodeType, name: String) -> Self {
        ASTNode {
            node_type,
            name,
            value: String::new(),
            inferred_type: "unknown".to_string(),
            children: Vec::new(),
            attributes: HashMap::new(),
        }
    }
}

// ─────────────────────────────────────────────────────────────────────────────────────────────────────────
// PARSER
// ─────────────────────────────────────────────────────────────────────────────────────────────────────────

pub struct Parser {
    tokens: Vec<Token>,
    pos: usize,
    symbol_table: HashMap<String, String>,
}

impl Parser {
    pub fn new(tokens: Vec<Token>) -> Self {
        Parser {
            tokens,
            pos: 0,
            symbol_table: HashMap::new(),
        }
    }

    fn current_token(&self) -> &Token {
        self.tokens.get(self.pos).unwrap_or(&self.tokens[self.tokens.len() - 1])
    }

    fn peek_token(&self, offset: usize) -> &Token {
        let pos = self.pos + offset;
        self.tokens.get(pos).unwrap_or(&self.tokens[self.tokens.len() - 1])
    }

    fn advance(&mut self) {
        if self.pos < self.tokens.len() {
            self.pos += 1;
        }
    }

    fn expect(&mut self, token_type: TokenType) -> Result<Token, String> {
        if self.current_token().token_type == token_type {
            let token = self.current_token().clone();
            self.advance();
            Ok(token)
        } else {
            Err(format!("Expected {:?}, got {:?}", token_type, self.current_token().token_type))
        }
    }

    fn parse_module(&mut self) -> Result<ASTNode, String> {
        let mut module = ASTNode::new(ASTNodeType::Module, "module".to_string());

        while self.current_token().token_type != TokenType::Eof {
            match self.current_token().token_type {
                TokenType::Fn => {
                    module.children.push(self.parse_function()?);
                }
                TokenType::Struct => {
                    module.children.push(self.parse_struct()?);
                }
                TokenType::Enum => {
                    module.children.push(self.parse_enum()?);
                }
                TokenType::Let | TokenType::Mut => {
                    module.children.push(self.parse_let()?);
                }
                _ => {
                    self.advance();
                }
            }
        }

        Ok(module)
    }

    fn parse_function(&mut self) -> Result<ASTNode, String> {
        self.expect(TokenType::Fn)?;
        let name_token = self.expect(TokenType::Identifier)?;
        let mut func = ASTNode::new(ASTNodeType::Function, name_token.lexeme.clone());

        self.expect(TokenType::LeftParen)?;

        // Parse parameters
        while self.current_token().token_type != TokenType::RightParen {
            let param_name = self.expect(TokenType::Identifier)?;
            self.expect(TokenType::Colon)?;
            let param_type = self.expect(TokenType::Identifier)?;

            func.attributes.insert(param_name.lexeme.clone(), param_type.lexeme.clone());

            if self.current_token().token_type == TokenType::Comma {
                self.advance();
            }
        }
        self.expect(TokenType::RightParen)?;

        // Parse return type if present
        if self.current_token().token_type == TokenType::Arrow {
            self.advance();
            let return_type = self.expect(TokenType::Identifier)?;
            func.inferred_type = return_type.lexeme.clone();
        }

        // Parse body
        if self.current_token().token_type == TokenType::LeftBrace {
            func.children.push(self.parse_block()?);
        }

        self.symbol_table.insert(name_token.lexeme.clone(), "function".to_string());
        Ok(func)
    }

    fn parse_struct(&mut self) -> Result<ASTNode, String> {
        self.expect(TokenType::Struct)?;
        let name_token = self.expect(TokenType::Identifier)?;
        let mut struct_node = ASTNode::new(ASTNodeType::Struct, name_token.lexeme.clone());

        self.expect(TokenType::LeftBrace)?;

        // Parse fields
        while self.current_token().token_type != TokenType::RightBrace {
            let field_name = self.expect(TokenType::Identifier)?;
            self.expect(TokenType::Colon)?;
            let field_type = self.expect(TokenType::Identifier)?;

            struct_node.attributes.insert(field_name.lexeme.clone(), field_type.lexeme.clone());

            if self.current_token().token_type == TokenType::Comma {
                self.advance();
            }
        }

        self.expect(TokenType::RightBrace)?;
        self.symbol_table.insert(name_token.lexeme.clone(), "struct".to_string());
        Ok(struct_node)
    }

    fn parse_enum(&mut self) -> Result<ASTNode, String> {
        self.expect(TokenType::Enum)?;
        let name_token = self.expect(TokenType::Identifier)?;
        let mut enum_node = ASTNode::new(ASTNodeType::Enum, name_token.lexeme.clone());

        self.expect(TokenType::LeftBrace)?;

        while self.current_token().token_type != TokenType::RightBrace {
            let variant = self.expect(TokenType::Identifier)?;
            enum_node.children.push(ASTNode::new(ASTNodeType::Identifier, variant.lexeme.clone()));

            if self.current_token().token_type == TokenType::Comma {
                self.advance();
            }
        }

        self.expect(TokenType::RightBrace)?;
        self.symbol_table.insert(name_token.lexeme.clone(), "enum".to_string());
        Ok(enum_node)
    }

    fn parse_let(&mut self) -> Result<ASTNode, String> {
        let is_mut = self.current_token().token_type == TokenType::Mut;
        if is_mut {
            self.advance();
        }
        self.expect(TokenType::Let)?;

        let name_token = self.expect(TokenType::Identifier)?;
        let mut let_node = ASTNode::new(ASTNodeType::Let, name_token.lexeme.clone());

        if self.current_token().token_type == TokenType::Colon {
            self.advance();
            let type_token = self.expect(TokenType::Identifier)?;
            let_node.inferred_type = type_token.lexeme.clone();
        }

        if self.current_token().token_type == TokenType::Equal {
            self.advance();
            let_node.children.push(self.parse_expression()?);
        }

        self.expect(TokenType::Semicolon)?;
        self.symbol_table.insert(name_token.lexeme.clone(), let_node.inferred_type.clone());
        Ok(let_node)
    }

    fn parse_block(&mut self) -> Result<ASTNode, String> {
        self.expect(TokenType::LeftBrace)?;
        let mut block = ASTNode::new(ASTNodeType::Block, "block".to_string());

        while self.current_token().token_type != TokenType::RightBrace {
            if self.current_token().token_type == TokenType::Let || self.current_token().token_type == TokenType::Mut {
                block.children.push(self.parse_let()?);
            } else if self.current_token().token_type == TokenType::Return {
                block.children.push(self.parse_return()?);
            } else if self.current_token().token_type == TokenType::If {
                block.children.push(self.parse_if()?);
            } else if self.current_token().token_type == TokenType::For {
                block.children.push(self.parse_for()?);
            } else {
                self.parse_expression()?;
                if self.current_token().token_type == TokenType::Semicolon {
                    self.advance();
                }
            }
        }

        self.expect(TokenType::RightBrace)?;
        Ok(block)
    }

    fn parse_return(&mut self) -> Result<ASTNode, String> {
        self.expect(TokenType::Return)?;
        let mut return_node = ASTNode::new(ASTNodeType::Return, "return".to_string());

        if self.current_token().token_type != TokenType::Semicolon {
            return_node.children.push(self.parse_expression()?);
        }

        self.expect(TokenType::Semicolon)?;
        Ok(return_node)
    }

    fn parse_if(&mut self) -> Result<ASTNode, String> {
        self.expect(TokenType::If)?;
        let mut if_node = ASTNode::new(ASTNodeType::If, "if".to_string());

        if_node.children.push(self.parse_expression()?);
        if_node.children.push(self.parse_block()?);

        if self.current_token().token_type == TokenType::Else {
            self.advance();
            if_node.children.push(self.parse_block()?);
        }

        Ok(if_node)
    }

    fn parse_for(&mut self) -> Result<ASTNode, String> {
        self.expect(TokenType::For)?;
        let var = self.expect(TokenType::Identifier)?;
        self.expect(TokenType::In)?;

        let mut for_node = ASTNode::new(ASTNodeType::For, var.lexeme.clone());
        for_node.children.push(self.parse_expression()?);
        for_node.children.push(self.parse_block()?);

        Ok(for_node)
    }

    fn parse_expression(&mut self) -> Result<ASTNode, String> {
        self.parse_binary_op(0)
    }

    fn parse_binary_op(&mut self, min_prec: u32) -> Result<ASTNode, String> {
        let mut left = self.parse_unary()?;

        while let Some(prec) = self.get_precedence(self.current_token().token_type) {
            if prec < min_prec {
                break;
            }

            let op = self.current_token().clone();
            self.advance();
            let right = self.parse_binary_op(prec + 1)?;

            let mut binary_op = ASTNode::new(ASTNodeType::BinaryOp, op.lexeme.clone());
            binary_op.children.push(left);
            binary_op.children.push(right);
            left = binary_op;
        }

        Ok(left)
    }

    fn parse_unary(&mut self) -> Result<ASTNode, String> {
        match self.current_token().token_type {
            TokenType::Not | TokenType::Minus | TokenType::Ampersand => {
                let op = self.current_token().clone();
                self.advance();
                let operand = self.parse_unary()?;
                let mut unary = ASTNode::new(ASTNodeType::UnaryOp, op.lexeme.clone());
                unary.children.push(operand);
                Ok(unary)
            }
            _ => self.parse_primary(),
        }
    }

    fn parse_primary(&mut self) -> Result<ASTNode, String> {
        match self.current_token().token_type {
            TokenType::Integer | TokenType::Float | TokenType::String | TokenType::True | TokenType::False | TokenType::Nil => {
                let token = self.current_token().clone();
                self.advance();
                let mut node = ASTNode::new(ASTNodeType::Literal, token.lexeme.clone());
                node.value = token.lexeme.clone();
                Ok(node)
            }
            TokenType::Identifier => {
                let token = self.current_token().clone();
                self.advance();

                // Check for function call
                if self.current_token().token_type == TokenType::LeftParen {
                    self.advance();
                    let mut call = ASTNode::new(ASTNodeType::Call, token.lexeme.clone());

                    while self.current_token().token_type != TokenType::RightParen {
                        call.children.push(self.parse_expression()?);
                        if self.current_token().token_type == TokenType::Comma {
                            self.advance();
                        }
                    }

                    self.expect(TokenType::RightParen)?;

                    // Infer return type from symbol table
                    if let Some(func_type) = self.symbol_table.get(&token.lexeme) {
                        call.inferred_type = func_type.clone();
                    }

                    Ok(call)
                } else {
                    let mut node = ASTNode::new(ASTNodeType::Identifier, token.lexeme.clone());
                    if let Some(var_type) = self.symbol_table.get(&token.lexeme) {
                        node.inferred_type = var_type.clone();
                    }
                    Ok(node)
                }
            }
            TokenType::LeftParen => {
                self.advance();
                let expr = self.parse_expression()?;
                self.expect(TokenType::RightParen)?;
                Ok(expr)
            }
            _ => Err(format!("Unexpected token: {:?}", self.current_token().token_type)),
        }
    }

    fn get_precedence(&self, token_type: TokenType) -> Option<u32> {
        match token_type {
            TokenType::Or => Some(1),
            TokenType::And => Some(2),
            TokenType::DoubleEqual | TokenType::NotEqual => Some(3),
            TokenType::Less | TokenType::Greater | TokenType::LessEqual | TokenType::GreaterEqual => Some(4),
            TokenType::Plus | TokenType::Minus => Some(5),
            TokenType::Star | TokenType::Slash | TokenType::Percent => Some(6),
            _ => None,
        }
    }

    pub fn parse(&mut self) -> Result<ASTNode, String> {
        self.parse_module()
    }
}

// ─────────────────────────────────────────────────────────────────────────────────────────────────────────
// MAIN COMPILER DRIVER
// ─────────────────────────────────────────────────────────────────────────────────────────────────────────

pub struct TitanCompiler {
    source: String,
}

impl TitanCompiler {
    pub fn new(source: String) -> Self {
        TitanCompiler { source }
    }

    pub fn compile(&self) -> Result<ASTNode, String> {
        // Lexical analysis
        let mut lexer = Lexer::new(&self.source);
        let tokens = lexer.tokenize()?;

        // Parsing
        let mut parser = Parser::new(tokens);
        parser.parse()
    }
}

pub fn main() {
    println!("╔════════════════════════════════════════════════════════════════╗");
    println!("║              TITAN COMPILER FRONTEND v1.0                     ║");
    println!("║        Lexer | Parser | Type Inference | AST Generation       ║");
    println!("╚════════════════════════════════════════════════════════════════╝\n");

    let source = r#"
        fn add(x: i32, y: i32) -> i32 {
            let result: i32 = x + y;
            return result;
        }

        struct Point {
            x: f64,
            y: f64,
        }

        fn main() {
            let sum = add(10, 20);
            let p = Point { x: 3.14, y: 2.71 };
        }
    "#;

    match TitanCompiler::new(source.to_string()).compile() {
        Ok(ast) => {
            println!("✓ Compilation successful");
            println!("✓ AST root type: {:?}", ast.node_type);
            println!("✓ Parsed {} items", ast.children.len());
            for item in &ast.children {
                println!("  - {:?}: {}", item.node_type, item.name);
            }
            println!("\n✓ TitanFrontend operational - parsing all TITAN source");
        }
        Err(e) => {
            println!("✗ Compilation error: {}", e);
        }
    }
}
