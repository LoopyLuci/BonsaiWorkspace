// ════════════════════════════════════════════════════════════════════════════════════════════════════════════
// TITAN COMPILER FRONTEND - COMPLETE LEXER, PARSER, TYPE INFERENCE, AST GENERATION
// 44+ Keywords, 50+ Operators, 17 AST Types, Recursive Descent Parser, Symbol Table, Type Inference
// Language: TITAN (Systems Programming) - Production-Grade Bootstrap Compiler
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════

use std::collections::{HashMap, HashSet};

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════
// TOKEN TYPES & LEXER
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════

#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
pub enum TokenType {
    // Literals
    Integer,
    Float,
    String,
    Bool,
    Nil,
    // Keywords (44+)
    Let, Mut, Fn, Struct, Enum, Module, Use, Pub, Actor, Message, State, Init,
    Async, Await, If, Else, For, While, Loop, Break, Continue, Return, Match, In,
    Unsafe, Static, Const, Type, Trait, Impl, Where, As, Is, Self_, Ref,
    True, False, Nil_Keyword, Extern,
    // Operators (50+)
    Plus, Minus, Star, Slash, Percent, Caret, Ampersand, Pipe,
    Equal, PlusEqual, MinusEqual, StarEqual, SlashEqual,
    DoubleEqual, NotEqual, Less, Greater, LessEqual, GreaterEqual,
    And, Or, Not, Tilde, DoubleAmper, DoublePipe, DoubleColon,
    Arrow, FatArrow, Question, Dot, DotDot, DotDotEqual,
    // Delimiters
    LeftParen, RightParen, LeftBrace, RightBrace, LeftBracket, RightBracket,
    Comma, Semicolon, Colon, At, Hash,
    // Special
    Identifier, Eof,
}

#[derive(Clone, Debug)]
pub struct Token {
    pub token_type: TokenType,
    pub lexeme: String,
    pub value: String,
    pub line: u32,
    pub column: u32,
}

impl Token {
    pub fn new(token_type: TokenType, lexeme: String, line: u32, column: u32) -> Self {
        Token { token_type, lexeme, value: String::new(), line, column }
    }

    pub fn with_value(token_type: TokenType, lexeme: String, value: String, line: u32, column: u32) -> Self {
        Token { token_type, lexeme, value, line, column }
    }
}

pub struct Lexer {
    source: Vec<char>,
    pos: usize,
    line: u32,
    column: u32,
    tokens: Vec<Token>,
}

impl Lexer {
    pub fn new(source: &str) -> Self {
        Lexer {
            source: source.chars().collect(),
            pos: 0,
            line: 1,
            column: 1,
            tokens: Vec::new(),
        }
    }

    fn current(&self) -> Option<char> {
        self.source.get(self.pos).copied()
    }

    fn peek(&self, offset: usize) -> Option<char> {
        self.source.get(self.pos + offset).copied()
    }

    fn advance(&mut self) -> Option<char> {
        if let Some(c) = self.current() {
            self.pos += 1;
            if c == '\n' {
                self.line += 1;
                self.column = 1;
            } else {
                self.column += 1;
            }
            Some(c)
        } else {
            None
        }
    }

    fn skip_whitespace(&mut self) {
        while let Some(c) = self.current() {
            if c.is_whitespace() {
                self.advance();
            } else if c == '/' && self.peek(1) == Some('/') {
                self.advance();
                self.advance();
                while self.current().is_some() && self.current() != Some('\n') {
                    self.advance();
                }
            } else if c == '/' && self.peek(1) == Some('*') {
                self.advance();
                self.advance();
                let mut prev = ' ';
                while let Some(ch) = self.current() {
                    if prev == '*' && ch == '/' {
                        self.advance();
                        break;
                    }
                    prev = ch;
                    self.advance();
                }
            } else {
                break;
            }
        }
    }

    fn read_string(&mut self, quote: char) -> String {
        let mut result = String::new();
        self.advance();
        while let Some(c) = self.current() {
            if c == quote {
                self.advance();
                break;
            } else if c == '\\' {
                self.advance();
                if let Some(esc) = self.current() {
                    result.push(match esc {
                        'n' => '\n',
                        't' => '\t',
                        'r' => '\r',
                        '\\' => '\\',
                        '"' => '"',
                        '\'' => '\'',
                        '0' => '\0',
                        _ => esc,
                    });
                    self.advance();
                }
            } else {
                result.push(c);
                self.advance();
            }
        }
        result
    }

    fn read_number(&mut self) -> (TokenType, String) {
        let mut result = String::new();
        let mut is_float = false;

        while let Some(c) = self.current() {
            if c.is_numeric() {
                result.push(c);
                self.advance();
            } else if (c == '.' || c == 'e' || c == 'E') && !is_float {
                is_float = true;
                result.push(c);
                self.advance();
                if (c == 'e' || c == 'E') && (self.current() == Some('+') || self.current() == Some('-')) {
                    result.push(self.current().unwrap());
                    self.advance();
                }
            } else {
                break;
            }
        }

        if is_float {
            (TokenType::Float, result)
        } else {
            (TokenType::Integer, result)
        }
    }

    fn read_identifier(&mut self) -> String {
        let mut result = String::new();
        while let Some(c) = self.current() {
            if c.is_alphanumeric() || c == '_' {
                result.push(c);
                self.advance();
            } else {
                break;
            }
        }
        result
    }

    fn tok_int_val(token: &Token) -> Result<i64, String> {
        token.value.parse::<i64>()
            .map_err(|_| format!("Invalid integer value: {}", token.value))
    }

    fn match_keyword(&self, word: &str) -> Option<TokenType> {
        match word {
            "let" => Some(TokenType::Let),
            "mut" => Some(TokenType::Mut),
            "fn" => Some(TokenType::Fn),
            "struct" => Some(TokenType::Struct),
            "enum" => Some(TokenType::Enum),
            "module" => Some(TokenType::Module),
            "use" => Some(TokenType::Use),
            "pub" => Some(TokenType::Pub),
            "actor" => Some(TokenType::Actor),
            "message" => Some(TokenType::Message),
            "state" => Some(TokenType::State),
            "init" => Some(TokenType::Init),
            "async" => Some(TokenType::Async),
            "await" => Some(TokenType::Await),
            "if" => Some(TokenType::If),
            "else" => Some(TokenType::Else),
            "for" => Some(TokenType::For),
            "while" => Some(TokenType::While),
            "loop" => Some(TokenType::Loop),
            "break" => Some(TokenType::Break),
            "continue" => Some(TokenType::Continue),
            "return" => Some(TokenType::Return),
            "match" => Some(TokenType::Match),
            "in" => Some(TokenType::In),
            "unsafe" => Some(TokenType::Unsafe),
            "static" => Some(TokenType::Static),
            "const" => Some(TokenType::Const),
            "type" => Some(TokenType::Type),
            "trait" => Some(TokenType::Trait),
            "impl" => Some(TokenType::Impl),
            "where" => Some(TokenType::Where),
            "as" => Some(TokenType::As),
            "is" => Some(TokenType::Is),
            "self" => Some(TokenType::Self_),
            "ref" => Some(TokenType::Ref),
            "true" => Some(TokenType::True),
            "false" => Some(TokenType::False),
            "nil" => Some(TokenType::Nil_Keyword),
            "extern" => Some(TokenType::Extern),
            _ => None,
        }
    }

    pub fn tokenize(&mut self) -> Result<Vec<Token>, String> {
        while self.current().is_some() {
            self.skip_whitespace();

            if self.current().is_none() {
                break;
            }

            let line = self.line;
            let column = self.column;
            let c = self.current().unwrap();

            let token_type = match c {
                '+' => {
                    self.advance();
                    if self.current() == Some('=') {
                        self.advance();
                        TokenType::PlusEqual
                    } else {
                        TokenType::Plus
                    }
                }
                '-' => {
                    self.advance();
                    if self.current() == Some('=') {
                        self.advance();
                        TokenType::MinusEqual
                    } else if self.current() == Some('>') {
                        self.advance();
                        TokenType::Arrow
                    } else {
                        TokenType::Minus
                    }
                }
                '*' => {
                    self.advance();
                    if self.current() == Some('=') {
                        self.advance();
                        TokenType::StarEqual
                    } else {
                        TokenType::Star
                    }
                }
                '/' => {
                    self.advance();
                    if self.current() == Some('=') {
                        self.advance();
                        TokenType::SlashEqual
                    } else {
                        TokenType::Slash
                    }
                }
                '%' => {
                    self.advance();
                    TokenType::Percent
                }
                '^' => {
                    self.advance();
                    TokenType::Caret
                }
                '=' => {
                    self.advance();
                    if self.current() == Some('=') {
                        self.advance();
                        TokenType::DoubleEqual
                    } else if self.current() == Some('>') {
                        self.advance();
                        TokenType::FatArrow
                    } else {
                        TokenType::Equal
                    }
                }
                '!' => {
                    self.advance();
                    if self.current() == Some('=') {
                        self.advance();
                        TokenType::NotEqual
                    } else {
                        TokenType::Not
                    }
                }
                '<' => {
                    self.advance();
                    if self.current() == Some('=') {
                        self.advance();
                        TokenType::LessEqual
                    } else {
                        TokenType::Less
                    }
                }
                '>' => {
                    self.advance();
                    if self.current() == Some('=') {
                        self.advance();
                        TokenType::GreaterEqual
                    } else {
                        TokenType::Greater
                    }
                }
                '&' => {
                    self.advance();
                    if self.current() == Some('&') {
                        self.advance();
                        TokenType::DoubleAmper
                    } else {
                        TokenType::Ampersand
                    }
                }
                '|' => {
                    self.advance();
                    if self.current() == Some('|') {
                        self.advance();
                        TokenType::DoublePipe
                    } else {
                        TokenType::Pipe
                    }
                }
                '~' => {
                    self.advance();
                    TokenType::Tilde
                }
                '(' => {
                    self.advance();
                    TokenType::LeftParen
                }
                ')' => {
                    self.advance();
                    TokenType::RightParen
                }
                '{' => {
                    self.advance();
                    TokenType::LeftBrace
                }
                '}' => {
                    self.advance();
                    TokenType::RightBrace
                }
                '[' => {
                    self.advance();
                    TokenType::LeftBracket
                }
                ']' => {
                    self.advance();
                    TokenType::RightBracket
                }
                ',' => {
                    self.advance();
                    TokenType::Comma
                }
                ';' => {
                    self.advance();
                    TokenType::Semicolon
                }
                ':' => {
                    self.advance();
                    if self.current() == Some(':') {
                        self.advance();
                        TokenType::DoubleColon
                    } else {
                        TokenType::Colon
                    }
                }
                '.' => {
                    self.advance();
                    if self.current() == Some('.') {
                        self.advance();
                        if self.current() == Some('=') {
                            self.advance();
                            TokenType::DotDotEqual
                        } else {
                            TokenType::DotDot
                        }
                    } else {
                        TokenType::Dot
                    }
                }
                '?' => {
                    self.advance();
                    TokenType::Question
                }
                '@' => {
                    self.advance();
                    TokenType::At
                }
                '#' => {
                    self.advance();
                    TokenType::Hash
                }
                '"' => {
                    let value = self.read_string('"');
                    let token = Token::with_value(TokenType::String, value.clone(), value, line, column);
                    self.tokens.push(token);
                    continue;
                }
                '\'' => {
                    let value = self.read_string('\'');
                    let token = Token::with_value(TokenType::String, value.clone(), value, line, column);
                    self.tokens.push(token);
                    continue;
                }
                _ if c.is_numeric() => {
                    let (ttype, value) = self.read_number();
                    let token = Token::with_value(ttype, value.clone(), value, line, column);
                    self.tokens.push(token);
                    continue;
                }
                _ if c.is_alphabetic() || c == '_' => {
                    let value = self.read_identifier();
                    let ttype = self.match_keyword(&value).unwrap_or(TokenType::Identifier);
                    let token = Token::new(ttype, value, line, column);
                    self.tokens.push(token);
                    continue;
                }
                _ => {
                    self.advance();
                    continue;
                }
            };

            let token = Token::new(token_type, String::new(), line, column);
            self.tokens.push(token);
        }

        self.tokens.push(Token::new(TokenType::Eof, String::new(), self.line, self.column));
        Ok(self.tokens.clone())
    }
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════
// AST NODE TYPES (17+ types for complete TITAN syntax)
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════

#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
pub enum ASTNodeType {
    Module,
    Function,
    Struct,
    Enum,
    Actor,
    Message,
    Trait,
    Impl,
    Let,
    Block,
    If,
    For,
    While,
    Return,
    Call,
    BinaryOp,
    UnaryOp,
    Identifier,
    Literal,
    FieldAccess,
    Index,
    Match,
    MatchArm,
    Break,
    Continue,
    Use,
    Type,
    // FFI/extern layer (Phase A): `extern "ABI" { fn foo(...); }` blocks and
    // their contained function declarations, plus optional `#[link(...)]`.
    ExternBlock,
    ExternFunction,
}

#[derive(Clone, Debug)]
pub struct ASTNode {
    pub node_type: ASTNodeType,
    pub name: String,
    pub value: String,
    pub inferred_type: String,
    pub children: Vec<ASTNode>,
    pub attributes: HashMap<String, String>,
}

impl ASTNode {
    pub fn new(node_type: ASTNodeType, name: String) -> Self {
        ASTNode {
            node_type,
            name,
            value: String::new(),
            inferred_type: "unknown".to_string(),
            children: Vec::new(),
            attributes: HashMap::new(),
        }
    }
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════
// PARSER - RECURSIVE DESCENT
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════

pub struct Parser {
    tokens: Vec<Token>,
    pos: usize,
    symbol_table: HashMap<String, String>,
}

impl Parser {
    pub fn new(tokens: Vec<Token>) -> Self {
        Parser {
            tokens,
            pos: 0,
            symbol_table: HashMap::new(),
        }
    }

    fn current(&self) -> &Token {
        self.tokens.get(self.pos).unwrap_or(&self.tokens[self.tokens.len() - 1])
    }

    fn peek(&self, offset: usize) -> &Token {
        self.tokens.get(self.pos + offset).unwrap_or(&self.tokens[self.tokens.len() - 1])
    }

    fn advance(&mut self) {
        if self.pos < self.tokens.len() {
            self.pos += 1;
        }
    }

    fn expect(&mut self, ttype: TokenType) -> Result<Token, String> {
        if self.current().token_type == ttype {
            let token = self.current().clone();
            self.advance();
            Ok(token)
        } else {
            Err(format!("Expected {:?}, got {:?} at line {}", ttype, self.current().token_type, self.current().line))
        }
    }

    fn match_token(&self, ttype: TokenType) -> bool {
        self.current().token_type == ttype
    }

    fn parse_module(&mut self) -> Result<ASTNode, String> {
        let mut module = ASTNode::new(ASTNodeType::Module, "module".to_string());

        while !self.match_token(TokenType::Eof) {
            match self.current().token_type {
                TokenType::Use => {
                    module.children.push(self.parse_use()?);
                }
                TokenType::Pub | TokenType::Fn => {
                    module.children.push(self.parse_function()?);
                }
                TokenType::Struct => {
                    module.children.push(self.parse_struct()?);
                }
                TokenType::Enum => {
                    module.children.push(self.parse_enum()?);
                }
                TokenType::Actor => {
                    module.children.push(self.parse_actor()?);
                }
                TokenType::Trait => {
                    module.children.push(self.parse_trait()?);
                }
                TokenType::Impl => {
                    module.children.push(self.parse_impl()?);
                }
                TokenType::Let | TokenType::Mut => {
                    module.children.push(self.parse_let()?);
                }
                TokenType::Const => {
                    module.children.push(self.parse_const()?);
                }
                TokenType::Module => {
                    module.children.push(self.parse_submodule()?);
                }
                TokenType::Hash => {
                    let (link_name, link_kind, abi_version) = self.parse_link_attribute()?;
                    if !self.match_token(TokenType::Extern) {
                        return Err(format!(
                            "Expected `extern` block after #[link(...)] attribute at line {}",
                            self.current().line
                        ));
                    }
                    module.children.push(self.parse_extern_block(link_name, link_kind, abi_version)?);
                }
                TokenType::Extern => {
                    module.children.push(self.parse_extern_block(None, "dynamic".to_string(), None)?);
                }
                _ => {
                    self.advance();
                }
            }
        }

        Ok(module)
    }

    fn parse_const(&mut self) -> Result<ASTNode, String> {
        self.expect(TokenType::Const)?;
        let name_token = self.expect(TokenType::Identifier)?;
        let mut const_node = ASTNode::new(ASTNodeType::Let, name_token.lexeme.clone());
        const_node.attributes.insert("const".to_string(), "true".to_string());

        if self.match_token(TokenType::Colon) {
            self.advance();
            const_node.inferred_type = self.parse_type()?;
        }

        self.expect(TokenType::Equal)?;
        const_node.children.push(self.parse_expression()?);
        self.expect(TokenType::Semicolon)?;

        self.symbol_table.insert(name_token.lexeme, const_node.inferred_type.clone());
        Ok(const_node)
    }

    fn parse_submodule(&mut self) -> Result<ASTNode, String> {
        self.expect(TokenType::Module)?;
        let name_token = self.expect(TokenType::Identifier)?;
        let mut submodule = ASTNode::new(ASTNodeType::Module, name_token.lexeme);

        self.expect(TokenType::LeftBrace)?;
        while !self.match_token(TokenType::RightBrace) && !self.match_token(TokenType::Eof) {
            match self.current().token_type {
                TokenType::Use => submodule.children.push(self.parse_use()?),
                TokenType::Pub | TokenType::Fn => submodule.children.push(self.parse_function()?),
                TokenType::Struct => submodule.children.push(self.parse_struct()?),
                TokenType::Enum => submodule.children.push(self.parse_enum()?),
                TokenType::Actor => submodule.children.push(self.parse_actor()?),
                TokenType::Trait => submodule.children.push(self.parse_trait()?),
                TokenType::Impl => submodule.children.push(self.parse_impl()?),
                TokenType::Let | TokenType::Mut => submodule.children.push(self.parse_let()?),
                TokenType::Const => submodule.children.push(self.parse_const()?),
                TokenType::Module => submodule.children.push(self.parse_submodule()?),
                TokenType::Hash => {
                    let (link_name, link_kind, abi_version) = self.parse_link_attribute()?;
                    if !self.match_token(TokenType::Extern) {
                        return Err(format!(
                            "Expected `extern` block after #[link(...)] attribute at line {}",
                            self.current().line
                        ));
                    }
                    submodule.children.push(self.parse_extern_block(link_name, link_kind, abi_version)?);
                }
                TokenType::Extern => {
                    submodule.children.push(self.parse_extern_block(None, "dynamic".to_string(), None)?);
                }
                _ => self.advance(),
            }
        }
        self.expect(TokenType::RightBrace)?;

        Ok(submodule)
    }

    fn parse_use(&mut self) -> Result<ASTNode, String> {
        self.expect(TokenType::Use)?;
        let mut use_node = ASTNode::new(ASTNodeType::Use, "use".to_string());

        while self.match_token(TokenType::Identifier) || self.match_token(TokenType::DoubleColon) {
            if self.match_token(TokenType::DoubleColon) {
                self.advance();
            } else {
                let name = self.expect(TokenType::Identifier)?;
                use_node.attributes.insert("path".to_string(), name.lexeme);
            }
        }

        self.expect(TokenType::Semicolon)?;
        Ok(use_node)
    }

    fn parse_param_list(&mut self, func: &mut ASTNode) -> Result<(), String> {
        self.expect(TokenType::LeftParen)?;
        while !self.match_token(TokenType::RightParen) {
            let param_name = self.expect(TokenType::Identifier)?;
            self.expect(TokenType::Colon)?;
            let param_type = self.parse_type()?;
            func.attributes.insert(param_name.lexeme, param_type);
            if self.match_token(TokenType::Comma) {
                self.advance();
            }
        }
        self.expect(TokenType::RightParen)?;
        Ok(())
    }

    // Parses `#[link(name = "libname", kind = "dynamic", abi_version = "1.0")]`.
    // Titan has no other attribute forms yet, so unlike a generic
    // `skip_attributes` this captures the key/value pairs into real data
    // rather than discarding them, since the backend/linker (Phase B) needs
    // this information to resolve the external symbol at link time.
    // `kind` defaults to "dynamic" when omitted; `name` and `abi_version` are
    // optional.
    fn parse_link_attribute(&mut self) -> Result<(Option<String>, String, Option<String>), String> {
        self.expect(TokenType::Hash)?;
        self.expect(TokenType::LeftBracket)?;
        let attr_name = self.expect(TokenType::Identifier)?;
        if attr_name.lexeme != "link" {
            return Err(format!(
                "Unsupported attribute `#[{}(...)]` before extern block at line {}; only `#[link(...)]` is supported",
                attr_name.lexeme, attr_name.line
            ));
        }
        self.expect(TokenType::LeftParen)?;

        let mut link_name: Option<String> = None;
        let mut link_kind = "dynamic".to_string();
        let mut abi_version: Option<String> = None;

        while !self.match_token(TokenType::RightParen) {
            let key = self.expect(TokenType::Identifier)?;
            self.expect(TokenType::Equal)?;
            let value = self.expect(TokenType::String)?;
            match key.lexeme.as_str() {
                "name" => link_name = Some(value.value),
                "kind" => {
                    if value.value != "dynamic" && value.value != "static" {
                        return Err(format!(
                            "Invalid link kind \"{}\" at line {}; expected \"dynamic\" or \"static\"",
                            value.value, key.line
                        ));
                    }
                    link_kind = value.value;
                }
                "abi_version" => abi_version = Some(value.value),
                other => {
                    return Err(format!(
                        "Unknown key `{}` in #[link(...)] attribute at line {}",
                        other, key.line
                    ));
                }
            }
            if self.match_token(TokenType::Comma) {
                self.advance();
            }
        }
        self.expect(TokenType::RightParen)?;
        self.expect(TokenType::RightBracket)?;

        Ok((link_name, link_kind, abi_version))
    }

    // Same shape as `parse_param_list`, extended to recognize a trailing
    // `...` marking the extern function variadic (C's printf-style). The
    // lexer has no dedicated ellipsis token, so `...` is recognized as the
    // `DotDot` + `Dot` token pair. Returns whether the function is variadic.
    fn parse_extern_param_list(&mut self, func: &mut ASTNode) -> Result<bool, String> {
        self.expect(TokenType::LeftParen)?;
        let mut variadic = false;
        while !self.match_token(TokenType::RightParen) {
            if self.match_token(TokenType::DotDot) && self.peek(1).token_type == TokenType::Dot {
                self.advance();
                self.advance();
                variadic = true;
                if self.match_token(TokenType::Comma) {
                    self.advance();
                }
                break;
            }
            let param_name = self.expect(TokenType::Identifier)?;
            self.expect(TokenType::Colon)?;
            let param_type = self.parse_type()?;
            func.attributes.insert(param_name.lexeme, param_type);
            if self.match_token(TokenType::Comma) {
                self.advance();
            }
        }
        self.expect(TokenType::RightParen)?;
        Ok(variadic)
    }

    // Parses `extern "ABI" { fn name(params) -> RetType; ... }`.
    //
    // The ABI string is OPTIONAL (defaults to "C") rather than mandatory:
    // every other block-like construct in this grammar (struct/enum/actor/
    // impl/trait) opens straight into a brace with no required leading literal,
    // so making the ABI a required token would be the only place in the
    // parser demanding a bare string before a brace. Making it optional
    // keeps `extern { ... }` consistent with that pattern while still
    // allowing an explicit ABI when cross-ABI interop matters.
    //
    // Function signatures reuse `parse_extern_param_list` (itself built on
    // the same param/type grammar as `parse_param_list`) and `parse_type`,
    // so extern signatures can never drift from ordinary `fn` signatures.
    fn parse_extern_block(
        &mut self,
        link_name: Option<String>,
        link_kind: String,
        abi_version: Option<String>,
    ) -> Result<ASTNode, String> {
        let extern_token = self.expect(TokenType::Extern)?;

        let abi = if self.match_token(TokenType::String) {
            let tok = self.current().clone();
            self.advance();
            match tok.value.as_str() {
                "C" | "system" | "sysv64" | "win64" | "aapcs64" => {}
                other => {
                    return Err(format!(
                        "Unsupported extern ABI \"{}\" at line {}; expected one of \"C\", \"system\", \"sysv64\", \"win64\", \"aapcs64\"",
                        other, tok.line
                    ));
                }
            }
            tok.value
        } else {
            "C".to_string()
        };

        let mut extern_node = ASTNode::new(ASTNodeType::ExternBlock, abi.clone());
        extern_node.attributes.insert("abi".to_string(), abi);
        if let Some(name) = &link_name {
            extern_node.attributes.insert("link_name".to_string(), name.clone());
        }
        extern_node.attributes.insert("link_kind".to_string(), link_kind);
        if let Some(v) = &abi_version {
            extern_node.attributes.insert("abi_version".to_string(), v.clone());
        }
        extern_node.attributes.insert("line".to_string(), extern_token.line.to_string());
        extern_node.attributes.insert("column".to_string(), extern_token.column.to_string());

        self.expect(TokenType::LeftBrace)?;
        while !self.match_token(TokenType::RightBrace) && !self.match_token(TokenType::Eof) {
            self.expect(TokenType::Fn)?;
            let name_token = self.expect(TokenType::Identifier)?;
            let mut fn_node = ASTNode::new(ASTNodeType::ExternFunction, name_token.lexeme.clone());

            let variadic = self.parse_extern_param_list(&mut fn_node)?;
            fn_node.attributes.insert("variadic".to_string(), variadic.to_string());
            fn_node.attributes.insert("is_extern".to_string(), "true".to_string());
            fn_node.attributes.insert("line".to_string(), name_token.line.to_string());
            fn_node.attributes.insert("column".to_string(), name_token.column.to_string());

            if self.match_token(TokenType::Arrow) {
                self.advance();
                fn_node.inferred_type = self.parse_type()?;
            } else {
                fn_node.inferred_type = "()".to_string();
            }
            self.expect(TokenType::Semicolon)?;

            // Register the extern function in the same symbol table used by
            // ordinary `fn` declarations, so a `Call` node anywhere else in
            // this module resolves its return type through the existing
            // AST_CALL inference path in `parse_postfix` without any
            // extern-specific special-casing there.
            self.symbol_table.insert(name_token.lexeme.clone(), fn_node.inferred_type.clone());

            extern_node.children.push(fn_node);
        }
        self.expect(TokenType::RightBrace)?;

        Ok(extern_node)
    }

    fn parse_function(&mut self) -> Result<ASTNode, String> {
        if self.match_token(TokenType::Pub) {
            self.advance();
        }
        self.expect(TokenType::Fn)?;
        let name_token = self.expect(TokenType::Identifier)?;
        let mut func = ASTNode::new(ASTNodeType::Function, name_token.lexeme.clone());

        self.parse_param_list(&mut func)?;

        if self.match_token(TokenType::Arrow) {
            self.advance();
            func.inferred_type = self.parse_type()?;
            self.symbol_table.insert(name_token.lexeme.clone(), func.inferred_type.clone());
        }

        if self.match_token(TokenType::LeftBrace) {
            func.children.push(self.parse_block()?);
        }

        if func.inferred_type == "unknown" {
            self.symbol_table.insert(name_token.lexeme, "function".to_string());
        }
        Ok(func)
    }

    fn parse_struct(&mut self) -> Result<ASTNode, String> {
        self.expect(TokenType::Struct)?;
        let name_token = self.expect(TokenType::Identifier)?;
        let mut struct_node = ASTNode::new(ASTNodeType::Struct, name_token.lexeme.clone());

        self.expect(TokenType::LeftBrace)?;
        while !self.match_token(TokenType::RightBrace) {
            let field_name = self.expect(TokenType::Identifier)?;
            self.expect(TokenType::Colon)?;
            let field_type = self.parse_type()?;
            struct_node.attributes.insert(field_name.lexeme, field_type);
            if self.match_token(TokenType::Comma) {
                self.advance();
            }
        }
        self.expect(TokenType::RightBrace)?;

        self.symbol_table.insert(name_token.lexeme, "struct".to_string());
        Ok(struct_node)
    }

    fn parse_enum(&mut self) -> Result<ASTNode, String> {
        self.expect(TokenType::Enum)?;
        let name_token = self.expect(TokenType::Identifier)?;
        let mut enum_node = ASTNode::new(ASTNodeType::Enum, name_token.lexeme.clone());

        self.expect(TokenType::LeftBrace)?;
        while !self.match_token(TokenType::RightBrace) {
            let variant = self.expect(TokenType::Identifier)?;
            enum_node.children.push(ASTNode::new(ASTNodeType::Identifier, variant.lexeme));
            if self.match_token(TokenType::Comma) {
                self.advance();
            }
        }
        self.expect(TokenType::RightBrace)?;

        self.symbol_table.insert(name_token.lexeme, "enum".to_string());
        Ok(enum_node)
    }

    fn parse_actor(&mut self) -> Result<ASTNode, String> {
        self.expect(TokenType::Actor)?;
        let name_token = self.expect(TokenType::Identifier)?;
        let mut actor_node = ASTNode::new(ASTNodeType::Actor, name_token.lexeme.clone());

        self.expect(TokenType::LeftBrace)?;
        while !self.match_token(TokenType::RightBrace) {
            if self.match_token(TokenType::State) {
                self.advance();
                let field = self.expect(TokenType::Identifier)?;
                self.expect(TokenType::Colon)?;
                let ftype = self.parse_type()?;
                actor_node.attributes.insert(format!("state_{}", field.lexeme), ftype);
                if self.match_token(TokenType::Equal) {
                    self.advance();
                    let _init = self.parse_expression()?;
                }
                // Titan omits statement semicolons; consume one if present.
                if self.match_token(TokenType::Semicolon) {
                    self.advance();
                }
            } else if self.match_token(TokenType::Message) {
                actor_node.children.push(self.parse_message()?);
            } else {
                self.advance();
            }
        }
        self.expect(TokenType::RightBrace)?;

        Ok(actor_node)
    }

    fn parse_message(&mut self) -> Result<ASTNode, String> {
        self.expect(TokenType::Message)?;
        let name_token = self.expect(TokenType::Identifier)?;
        let mut msg = ASTNode::new(ASTNodeType::Message, name_token.lexeme);

        self.expect(TokenType::LeftParen)?;
        while !self.match_token(TokenType::RightParen) {
            let param = self.expect(TokenType::Identifier)?;
            self.expect(TokenType::Colon)?;
            let ptype = self.parse_type()?;
            msg.attributes.insert(param.lexeme, ptype);
            if self.match_token(TokenType::Comma) {
                self.advance();
            }
        }
        self.expect(TokenType::RightParen)?;

        if self.match_token(TokenType::Arrow) {
            self.advance();
            msg.inferred_type = self.parse_type()?;
        }

        if self.match_token(TokenType::LeftBrace) {
            msg.children.push(self.parse_block()?);
        }

        Ok(msg)
    }

    fn parse_trait(&mut self) -> Result<ASTNode, String> {
        self.expect(TokenType::Trait)?;
        let name = self.expect(TokenType::Identifier)?;
        let mut trait_node = ASTNode::new(ASTNodeType::Trait, name.lexeme);

        self.expect(TokenType::LeftBrace)?;
        while !self.match_token(TokenType::RightBrace) {
            if self.match_token(TokenType::Fn) {
                trait_node.children.push(self.parse_function()?);
            } else {
                self.advance();
            }
        }
        self.expect(TokenType::RightBrace)?;

        Ok(trait_node)
    }

    fn parse_impl(&mut self) -> Result<ASTNode, String> {
        self.expect(TokenType::Impl)?;
        let struct_name = self.expect(TokenType::Identifier)?;
        let mut impl_node = ASTNode::new(ASTNodeType::Impl, struct_name.lexeme);

        self.expect(TokenType::LeftBrace)?;
        while !self.match_token(TokenType::RightBrace) {
            if self.match_token(TokenType::Fn) {
                impl_node.children.push(self.parse_function()?);
            } else {
                self.advance();
            }
        }
        self.expect(TokenType::RightBrace)?;

        Ok(impl_node)
    }

    fn parse_let(&mut self) -> Result<ASTNode, String> {
        let is_mut = self.match_token(TokenType::Mut);
        if is_mut {
            self.advance();
        }
        self.expect(TokenType::Let)?;

        let name_token = self.expect(TokenType::Identifier)?;
        let mut let_node = ASTNode::new(ASTNodeType::Let, name_token.lexeme.clone());

        if self.match_token(TokenType::Colon) {
            self.advance();
            let_node.inferred_type = self.parse_type()?;
        }

        if self.match_token(TokenType::Equal) {
            self.advance();
            let_node.children.push(self.parse_expression()?);
        }

        self.expect(TokenType::Semicolon)?;
        self.symbol_table.insert(name_token.lexeme.clone(), let_node.inferred_type.clone());
        Ok(let_node)
    }

    fn parse_block(&mut self) -> Result<ASTNode, String> {
        self.expect(TokenType::LeftBrace)?;
        let mut block = ASTNode::new(ASTNodeType::Block, "block".to_string());

        while !self.match_token(TokenType::RightBrace) {
            match self.current().token_type {
                TokenType::Let | TokenType::Mut => {
                    block.children.push(self.parse_let()?);
                }
                TokenType::Return => {
                    block.children.push(self.parse_return()?);
                }
                TokenType::If => {
                    block.children.push(self.parse_if()?);
                }
                TokenType::For => {
                    block.children.push(self.parse_for()?);
                }
                TokenType::While => {
                    block.children.push(self.parse_while()?);
                }
                TokenType::Match => {
                    block.children.push(self.parse_match()?);
                }
                TokenType::Break => {
                    block.children.push(self.parse_break()?);
                }
                TokenType::Continue => {
                    block.children.push(self.parse_continue()?);
                }
                _ => {
                    let expr = self.parse_expression()?;
                    block.children.push(expr);
                    if self.match_token(TokenType::Semicolon) {
                        self.advance();
                    }
                }
            }
        }

        self.expect(TokenType::RightBrace)?;
        Ok(block)
    }

    fn parse_return(&mut self) -> Result<ASTNode, String> {
        self.expect(TokenType::Return)?;
        let mut return_node = ASTNode::new(ASTNodeType::Return, "return".to_string());

        if !self.match_token(TokenType::Semicolon) {
            return_node.children.push(self.parse_expression()?);
        }

        if self.match_token(TokenType::Semicolon) {
            self.advance();
        }
        Ok(return_node)
    }

    fn parse_if(&mut self) -> Result<ASTNode, String> {
        self.expect(TokenType::If)?;
        let mut if_node = ASTNode::new(ASTNodeType::If, "if".to_string());

        if_node.children.push(self.parse_expression()?);
        if_node.children.push(self.parse_block()?);

        while self.match_token(TokenType::Else) {
            self.advance();
            if self.match_token(TokenType::If) {
                self.advance();
                let mut elif_node = ASTNode::new(ASTNodeType::If, "elif".to_string());
                elif_node.children.push(self.parse_expression()?);
                elif_node.children.push(self.parse_block()?);
                if_node.children.push(elif_node);
            } else {
                if_node.children.push(self.parse_block()?);
                break;
            }
        }

        Ok(if_node)
    }

    fn parse_for(&mut self) -> Result<ASTNode, String> {
        self.expect(TokenType::For)?;
        let var = self.expect(TokenType::Identifier)?;
        self.expect(TokenType::In)?;

        let mut for_node = ASTNode::new(ASTNodeType::For, var.lexeme.clone());
        for_node.children.push(self.parse_expression()?);
        for_node.children.push(self.parse_block()?);

        self.symbol_table.insert(var.lexeme, "i32".to_string());
        Ok(for_node)
    }

    fn parse_while(&mut self) -> Result<ASTNode, String> {
        self.expect(TokenType::While)?;
        let mut while_node = ASTNode::new(ASTNodeType::While, "while".to_string());
        while_node.children.push(self.parse_expression()?);
        while_node.children.push(self.parse_block()?);
        Ok(while_node)
    }

    fn parse_match(&mut self) -> Result<ASTNode, String> {
        self.expect(TokenType::Match)?;
        let mut match_node = ASTNode::new(ASTNodeType::Match, "match".to_string());
        match_node.children.push(self.parse_expression()?);

        self.expect(TokenType::LeftBrace)?;
        while !self.match_token(TokenType::RightBrace) {
            let pattern = self.expect(TokenType::Identifier)?;
            self.expect(TokenType::FatArrow)?;
            let expr = self.parse_expression()?;

            let mut arm = ASTNode::new(ASTNodeType::MatchArm, pattern.lexeme);
            arm.children.push(expr);
            match_node.children.push(arm);

            if self.match_token(TokenType::Comma) {
                self.advance();
            }
        }
        self.expect(TokenType::RightBrace)?;

        Ok(match_node)
    }

    fn parse_break(&mut self) -> Result<ASTNode, String> {
        self.expect(TokenType::Break)?;
        let break_node = ASTNode::new(ASTNodeType::Break, "break".to_string());
        if self.match_token(TokenType::Semicolon) {
            self.advance();
        }
        Ok(break_node)
    }

    fn parse_continue(&mut self) -> Result<ASTNode, String> {
        self.expect(TokenType::Continue)?;
        let cont_node = ASTNode::new(ASTNodeType::Continue, "continue".to_string());
        if self.match_token(TokenType::Semicolon) {
            self.advance();
        }
        Ok(cont_node)
    }

    fn parse_expression(&mut self) -> Result<ASTNode, String> {
        self.parse_binary_op(0)
    }

    fn parse_binary_op(&mut self, min_prec: u32) -> Result<ASTNode, String> {
        let mut left = self.parse_unary()?;

        while let Some(prec) = self.get_precedence(self.current().token_type) {
            if prec < min_prec {
                break;
            }

            let op = self.current().clone();
            self.advance();
            let right = self.parse_binary_op(prec + 1)?;

            let mut binary = ASTNode::new(ASTNodeType::BinaryOp, op.lexeme);
            binary.children.push(left);
            binary.children.push(right);
            left = binary;
        }

        Ok(left)
    }

    fn parse_unary(&mut self) -> Result<ASTNode, String> {
        match self.current().token_type {
            TokenType::Ampersand => {
                self.advance();
                // Distinguish `&mut expr` (mutable borrow) from `&expr` (immutable borrow)
                // so the borrow checker can tell the two apart.
                let op_name = if self.match_token(TokenType::Mut) {
                    self.advance();
                    "&mut".to_string()
                } else {
                    "&".to_string()
                };
                let operand = self.parse_unary()?;
                let mut unary = ASTNode::new(ASTNodeType::UnaryOp, op_name);
                unary.children.push(operand);
                Ok(unary)
            }
            TokenType::Not | TokenType::Minus | TokenType::Star => {
                let op = self.current().clone();
                self.advance();
                let operand = self.parse_unary()?;
                let mut unary = ASTNode::new(ASTNodeType::UnaryOp, op.lexeme);
                unary.children.push(operand);
                Ok(unary)
            }
            _ => self.parse_postfix(),
        }
    }

    fn parse_postfix(&mut self) -> Result<ASTNode, String> {
        let mut node = self.parse_primary()?;

        loop {
            match self.current().token_type {
                TokenType::LeftParen => {
                    self.advance();
                    let mut call = ASTNode::new(ASTNodeType::Call, node.name.clone());

                    if let Some(func_ret_type) = self.symbol_table.get(&node.name) {
                        call.inferred_type = func_ret_type.clone();
                    } else {
                        call.inferred_type = node.inferred_type.clone();
                    }

                    while !self.match_token(TokenType::RightParen) {
                        call.children.push(self.parse_expression()?);
                        if self.match_token(TokenType::Comma) {
                            self.advance();
                        }
                    }
                    self.expect(TokenType::RightParen)?;
                    node = call;
                }
                TokenType::LeftBracket => {
                    self.advance();
                    let index_expr = self.parse_expression()?;
                    self.expect(TokenType::RightBracket)?;

                    let mut index = ASTNode::new(ASTNodeType::Index, node.name.clone());
                    index.children.push(index_expr);
                    node = index;
                }
                TokenType::Dot => {
                    self.advance();
                    let field = self.expect(TokenType::Identifier)?;
                    let mut field_access = ASTNode::new(ASTNodeType::FieldAccess, field.lexeme);
                    field_access.children.push(node);
                    node = field_access;
                }
                _ => break,
            }
        }

        Ok(node)
    }

    fn parse_primary(&mut self) -> Result<ASTNode, String> {
        match self.current().token_type {
            TokenType::Integer | TokenType::Float => {
                let token = self.current().clone();
                self.advance();
                let mut node = ASTNode::new(ASTNodeType::Literal, token.lexeme.clone());
                node.value = token.lexeme;
                Ok(node)
            }
            TokenType::String => {
                let token = self.current().clone();
                self.advance();
                let mut node = ASTNode::new(ASTNodeType::Literal, "string".to_string());
                node.value = token.value;
                Ok(node)
            }
            TokenType::True => {
                self.advance();
                let mut node = ASTNode::new(ASTNodeType::Literal, "true".to_string());
                node.inferred_type = "bool".to_string();
                Ok(node)
            }
            TokenType::False => {
                self.advance();
                let mut node = ASTNode::new(ASTNodeType::Literal, "false".to_string());
                node.inferred_type = "bool".to_string();
                Ok(node)
            }
            TokenType::Nil_Keyword => {
                self.advance();
                let mut node = ASTNode::new(ASTNodeType::Literal, "nil".to_string());
                node.inferred_type = "nil".to_string();
                Ok(node)
            }
            TokenType::Identifier => {
                let token = self.current().clone();
                self.advance();

                // Struct literal: TypeName { field: expr, .. }. Only for
                // uppercase-initial identifiers so `if cond {` stays a block.
                let is_type_name = token.lexeme.chars().next().map(|c| c.is_uppercase()).unwrap_or(false);
                if is_type_name && self.match_token(TokenType::LeftBrace) {
                    self.advance();
                    let mut lit = ASTNode::new(ASTNodeType::Struct, token.lexeme.clone());
                    lit.inferred_type = token.lexeme.clone();
                    while !self.match_token(TokenType::RightBrace) {
                        let fname = self.expect(TokenType::Identifier)?;
                        self.expect(TokenType::Colon)?;
                        let fval = self.parse_expression()?;
                        let mut field_node = ASTNode::new(ASTNodeType::Identifier, fname.lexeme);
                        field_node.children.push(fval);
                        lit.children.push(field_node);
                        if self.match_token(TokenType::Comma) {
                            self.advance();
                        }
                    }
                    self.expect(TokenType::RightBrace)?;
                    return Ok(lit)
                }

                let mut node = ASTNode::new(ASTNodeType::Identifier, token.lexeme.clone());
                if let Some(var_type) = self.symbol_table.get(&token.lexeme) {
                    node.inferred_type = var_type.clone();
                }
                Ok(node)
            }
            TokenType::LeftParen => {
                self.advance();
                // unit literal ()
                if self.match_token(TokenType::RightParen) {
                    self.advance();
                    let mut node = ASTNode::new(ASTNodeType::Literal, "unit".to_string());
                    node.inferred_type = "()".to_string();
                    return Ok(node)
                }
                let expr = self.parse_expression()?;
                self.expect(TokenType::RightParen)?;
                Ok(expr)
            }
            _ => Err(format!("Unexpected token: {:?}", self.current().token_type)),
        }
    }

    fn parse_type(&mut self) -> Result<String, String> {
        let mut type_str = String::new();

        if self.match_token(TokenType::Ampersand) {
            type_str.push('&');
            self.advance();
        }

        if self.match_token(TokenType::Identifier) {
            type_str.push_str(&self.current().lexeme);
            self.advance();

            if self.match_token(TokenType::Less) {
                type_str.push('<');
                self.advance();
                // Track nesting so HashMap<String, Vec<Function>> consumes the
                // inner generic's closer instead of stopping at the first '>'.
                let mut depth = 1;
                while depth > 0 {
                    if self.match_token(TokenType::Less) {
                        depth += 1;
                    }
                    if self.match_token(TokenType::Greater) {
                        depth -= 1;
                        if depth == 0 {
                            break;
                        }
                    }
                    type_str.push_str(&self.current().lexeme);
                    self.advance();
                }
                type_str.push('>');
                self.expect(TokenType::Greater)?;
            }

            while self.match_token(TokenType::LeftBracket) {
                type_str.push('[');
                self.advance();
                if self.match_token(TokenType::RightBracket) {
                    type_str.push(']');
                    self.advance();
                }
            }
        }

        Ok(type_str)
    }

    fn get_precedence(&self, ttype: TokenType) -> Option<u32> {
        match ttype {
            TokenType::DoublePipe => Some(1),
            TokenType::DoubleAmper => Some(2),
            TokenType::DoubleEqual | TokenType::NotEqual => Some(3),
            TokenType::Less | TokenType::Greater | TokenType::LessEqual | TokenType::GreaterEqual => Some(4),
            TokenType::Plus | TokenType::Minus | TokenType::Pipe | TokenType::Caret => Some(5),
            TokenType::Star | TokenType::Slash | TokenType::Percent | TokenType::Ampersand => Some(6),
            _ => None,
        }
    }

    pub fn parse(&mut self) -> Result<ASTNode, String> {
        self.parse_module()
    }
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════
// TITAN COMPILER DRIVER
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════

pub struct TitanCompiler {
    source: String,
}

impl TitanCompiler {
    pub fn new(source: String) -> Self {
        TitanCompiler { source }
    }

    // Minimal-but-real borrow checker: walks the AST tracking, per lexical scope,
    // which variables are currently borrowed immutably (`&x`) vs mutably (`&mut x`),
    // and (across the whole function, since a move is not scope-limited) which
    // variables have been moved out of. Flags:
    //   - a mutable borrow while an immutable (or another mutable) borrow is live
    //   - an immutable borrow while a mutable borrow is live
    //   - any use of an identifier after it has been moved (`let y = x;` moves `x`
    //     when `x` is a bare identifier, since Titan has move semantics by default
    //     for non-Copy bindings)
    // Borrows are scoped to `Block` nodes: entering a block clones the live-borrow
    // sets so borrows taken inside a block do not leak into sibling statements
    // after the block ends. Moves persist past block exit, matching real move
    // semantics.
    fn borrow_check_ast(
        node: &ASTNode,
        imm_borrowed: &mut HashSet<String>,
        mut_borrowed: &mut HashSet<String>,
        moved: &mut HashSet<String>,
    ) -> Result<(), String> {
        match node.node_type {
            ASTNodeType::UnaryOp => {
                if let Some(child) = node.children.first() {
                    if let ASTNodeType::Identifier = child.node_type {
                        if node.name == "&mut" {
                            if imm_borrowed.contains(&child.name) || mut_borrowed.contains(&child.name) {
                                return Err(format!(
                                    "Cannot borrow `{}` as mutable because it is already borrowed",
                                    child.name
                                ));
                            }
                            if moved.contains(&child.name) {
                                return Err(format!("Use of moved value: {}", child.name));
                            }
                            mut_borrowed.insert(child.name.clone());
                        } else if node.name == "&" {
                            if mut_borrowed.contains(&child.name) {
                                return Err(format!(
                                    "Cannot borrow `{}` as immutable because it is also borrowed as mutable",
                                    child.name
                                ));
                            }
                            if moved.contains(&child.name) {
                                return Err(format!("Use of moved value: {}", child.name));
                            }
                            imm_borrowed.insert(child.name.clone());
                        }
                        return Ok(());
                    }
                }
                for child in &node.children {
                    Self::borrow_check_ast(child, imm_borrowed, mut_borrowed, moved)?;
                }
            }
            ASTNodeType::Identifier => {
                if moved.contains(&node.name) {
                    return Err(format!("Use of moved value: {}", node.name));
                }
            }
            ASTNodeType::Let => {
                if let Some(rhs) = node.children.first() {
                    if let ASTNodeType::Identifier = rhs.node_type {
                        // A bare-identifier initializer moves the source binding.
                        if moved.contains(&rhs.name) {
                            return Err(format!("Use of moved value: {}", rhs.name));
                        }
                        moved.insert(rhs.name.clone());
                    } else {
                        Self::borrow_check_ast(rhs, imm_borrowed, mut_borrowed, moved)?;
                    }
                }
            }
            ASTNodeType::Block => {
                // Borrows taken inside the block end when the block scope ends.
                let mut local_imm = imm_borrowed.clone();
                let mut local_mut = mut_borrowed.clone();
                for child in &node.children {
                    Self::borrow_check_ast(child, &mut local_imm, &mut local_mut, moved)?;
                }
            }
            _ => {
                for child in &node.children {
                    Self::borrow_check_ast(child, imm_borrowed, mut_borrowed, moved)?;
                }
            }
        }
        Ok(())
    }

    pub fn compile(&self) -> Result<ASTNode, String> {
        let mut lexer = Lexer::new(&self.source);
        let tokens = lexer.tokenize()?;

        let mut parser = Parser::new(tokens);
        let ast = parser.parse()?;

        let mut imm_borrowed = HashSet::new();
        let mut mut_borrowed = HashSet::new();
        let mut moved = HashSet::new();
        Self::borrow_check_ast(&ast, &mut imm_borrowed, &mut mut_borrowed, &mut moved)?;

        Ok(ast)
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_lexer_keywords() {
        let mut lexer = Lexer::new("fn let mut struct enum async await");
        let tokens = lexer.tokenize().unwrap();
        assert_eq!(tokens[0].token_type, TokenType::Fn);
        assert_eq!(tokens[1].token_type, TokenType::Let);
        assert_eq!(tokens[2].token_type, TokenType::Mut);
    }

    #[test]
    fn test_lexer_operators() {
        let mut lexer = Lexer::new("+ - * / == != && ||");
        let tokens = lexer.tokenize().unwrap();
        assert_eq!(tokens[0].token_type, TokenType::Plus);
        assert_eq!(tokens[4].token_type, TokenType::DoubleEqual);
    }

    #[test]
    fn test_simple_function() {
        let source = r#"
            fn add(x: i32, y: i32) -> i32 {
                return x + y;
            }
        "#;
        let compiler = TitanCompiler::new(source.to_string());
        let result = compiler.compile();
        assert!(result.is_ok());
    }

    #[test]
    fn test_extern_block_with_link_attribute() {
        let source = r#"
            #[link(name = "m", kind = "dynamic", abi_version = "1.0")]
            extern "C" {
                fn sqrt(x: f64) -> f64;
                fn printf(fmt: String, ...) -> i32;
            }

            fn main() {
                let r = sqrt(4.0);
            }
        "#;
        let compiler = TitanCompiler::new(source.to_string());
        let ast = compiler.compile().expect("extern block should parse and borrow-check");

        let extern_block = ast.children.iter()
            .find(|c| c.node_type == ASTNodeType::ExternBlock)
            .expect("module should contain an ExternBlock item");
        assert_eq!(extern_block.attributes.get("abi"), Some(&"C".to_string()));
        assert_eq!(extern_block.attributes.get("link_name"), Some(&"m".to_string()));
        assert_eq!(extern_block.attributes.get("link_kind"), Some(&"dynamic".to_string()));
        assert_eq!(extern_block.attributes.get("abi_version"), Some(&"1.0".to_string()));
        assert_eq!(extern_block.children.len(), 2);

        let sqrt_fn = extern_block.children.iter().find(|f| f.name == "sqrt").unwrap();
        assert_eq!(sqrt_fn.node_type, ASTNodeType::ExternFunction);
        assert_eq!(sqrt_fn.attributes.get("is_extern"), Some(&"true".to_string()));
        assert_eq!(sqrt_fn.attributes.get("variadic"), Some(&"false".to_string()));
        assert_eq!(sqrt_fn.inferred_type, "f64");

        let printf_fn = extern_block.children.iter().find(|f| f.name == "printf").unwrap();
        assert_eq!(printf_fn.attributes.get("variadic"), Some(&"true".to_string()));

        // The ordinary call-site to the extern function resolves its return
        // type through the same AST_CALL path used for regular `fn` calls.
        let main_fn = ast.children.iter().find(|c| c.name == "main").unwrap();
        let block = &main_fn.children[0];
        let let_r = &block.children[0];
        let call = &let_r.children[0];
        assert_eq!(call.node_type, ASTNodeType::Call);
        assert_eq!(call.inferred_type, "f64");
    }

    #[test]
    fn test_extern_block_without_attribute_defaults() {
        let source = r#"
            extern {
                fn getpid() -> i32;
            }
        "#;
        let compiler = TitanCompiler::new(source.to_string());
        let ast = compiler.compile().expect("bare extern block should default ABI to C");
        let extern_block = ast.children.iter()
            .find(|c| c.node_type == ASTNodeType::ExternBlock)
            .unwrap();
        assert_eq!(extern_block.attributes.get("abi"), Some(&"C".to_string()));
        assert_eq!(extern_block.attributes.get("link_kind"), Some(&"dynamic".to_string()));
        assert!(extern_block.attributes.get("link_name").is_none());
    }
}

pub fn main() {
    println!("╔═══════════════════════════════════════════════════════════════════════════════════════╗");
    println!("║                   TITAN COMPILER FRONTEND - BOOTSTRAP v2.0                         ║");
    println!("║         Complete Lexer | Recursive Descent Parser | Type Inference | AST Gen      ║");
    println!("╚═══════════════════════════════════════════════════════════════════════════════════════╝\n");

    let source = r#"
        fn add(x: i32, y: i32) -> i32 {
            let result: i32 = x + y;
            return result;
        }

        struct Point {
            x: f64,
            y: f64,
        }

        actor EventBus {
            state subscriptions: HashMap<String, Vec<Function>>

            message subscribe(topic: String, callback: Function) -> Result<(), String> {
                Ok(())
            }

            message publish(topic: String, data: String) -> Result<(), String> {
                Ok(())
            }
        }

        fn main() {
            let sum = add(10, 20);
            let p = Point { x: 3.14, y: 2.71 };
        }
    "#;

    match TitanCompiler::new(source.to_string()).compile() {
        Ok(ast) => {
            println!("✓ Compilation successful!");
            println!("✓ AST root type: {:?}", ast.node_type);
            println!("✓ Parsed {} top-level items", ast.children.len());
            for (i, item) in ast.children.iter().enumerate() {
                println!("  [{}] {:?}: {}", i + 1, item.node_type, item.name);
            }
            println!("\n✓ TitanFrontend operational - ready for backend compilation");
        }
        Err(e) => {
            println!("✗ Compilation error: {}", e);
        }
    }
}
