// SYLVA COMPILER FRONTEND - MACHINE LEARNING
// Phase 8: Language Frontends | Language: SYLVA

pub struct Layer {
    pub name: String,
    pub layer_type: String,
}

pub struct SylvaFrontend {
    pub layers: Vec<Layer>,
}

impl SylvaFrontend {
    pub fn new() -> Self { SylvaFrontend { layers: Vec::new() } }

    pub fn parse_layer(&mut self, name: String, ty: String) -> Result<(), String> {
        self.layers.push(Layer { name, layer_type: ty });
        Ok(())
    }

    pub fn compile_to_blas(&self) -> Result<String, String> {
        Ok(format!("compiled {} layers", self.layers.len()))
    }
}

pub fn main() {
    println!("SYLVA Frontend operational");
}
