// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// AXIOM SELF-HOSTED FRONTEND COMPILER
// Tokenizes real AXIOM source, parses theorem/axiom/invariant blocks (preconditions{},
// postconditions{}, invariants{}, assertions{}, forall quantifiers) into a real TheoremAst,
// then emits SMT-LIB2 (assert ...) constraints AND TITAN IR assert_invariant() runtime calls.
// Language: AXIOM - Self-Compiling Formal Verification Framework
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

use omnisystem::{Vec, HashMap, Option, Result, String, Arc, Mutex, i32, i64, f32, bool}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// TOKENS
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

pub enum TokKind {
    Ident, IntLit,
    LBrace, RBrace, LParen, RParen,
    Colon, Comma,
    Plus, Minus, Star, Slash,
    EqEq, NotEq, Lt, Gt, LtEq, GtEq,
    AndAnd, OrOr, Not,
    Arrow, FatArrow, DotDot,
    Eof,
}

pub struct Token {
    kind: TokKind,
    text: String,
    line: i32,
}

impl Token {
    fn clone(&self) -> Token { Token { kind: self.kind, text: self.text.clone(), line: self.line } }
}

pub struct AxiomLexer {
    chars: Vec<char>,
    pos: i32,
    line: i32,
}

impl AxiomLexer {
    pub fn new(source: String) -> Self { AxiomLexer { chars: source.chars().collect(), pos: 0, line: 1 } }

    fn peek(&self) -> char { if self.pos < (self.chars.len() as i32) { self.chars[self.pos as usize] } else { '\0' } }
    fn peek_at(&self, off: i32) -> char {
        let p = self.pos + off
        if p >= 0 && p < (self.chars.len() as i32) { self.chars[p as usize] } else { '\0' }
    }
    fn bump(&mut self) -> char {
        let c = self.peek()
        self.pos += 1
        if c == '\n' { self.line += 1 }
        c
    }

    pub fn tokenize(&mut self) -> Vec<Token> {
        let mut out = Vec::new()
        loop {
            self.skip_trivia()
            let c = self.peek()
            if c == '\0' { out.push(Token { kind: TokKind::Eof, text: String::new(), line: self.line }); break }
            if c.is_alphabetic() || c == '_' { out.push(self.lex_ident()) }
            else if c.is_numeric() { out.push(self.lex_number()) }
            else { out.push(self.lex_symbol()) }
        }
        out
    }

    fn skip_trivia(&mut self) {
        loop {
            let c = self.peek()
            if c == ' ' || c == '\t' || c == '\n' || c == '\r' { self.bump(); }
            else if c == '/' && self.peek_at(1) == '/' { while self.peek() != '\n' && self.peek() != '\0' { self.bump(); } }
            else { break }
        }
    }

    fn lex_ident(&mut self) -> Token {
        let line = self.line
        let mut s = String::new()
        while self.peek().is_alphanumeric() || self.peek() == '_' { s.push(self.bump()) }
        Token { kind: TokKind::Ident, text: s, line: line }
    }

    fn lex_number(&mut self) -> Token {
        let line = self.line
        let mut s = String::new()
        if self.peek() == '-' { s.push(self.bump()) }
        while self.peek().is_numeric() { s.push(self.bump()) }
        Token { kind: TokKind::IntLit, text: s, line: line }
    }

    fn lex_symbol(&mut self) -> Token {
        let line = self.line
        let c = self.bump()
        match c {
            '{' => Token { kind: TokKind::LBrace, text: "{".to_string(), line },
            '}' => Token { kind: TokKind::RBrace, text: "}".to_string(), line },
            '(' => Token { kind: TokKind::LParen, text: "(".to_string(), line },
            ')' => Token { kind: TokKind::RParen, text: ")".to_string(), line },
            ':' => Token { kind: TokKind::Colon, text: ":".to_string(), line },
            ',' => Token { kind: TokKind::Comma, text: ",".to_string(), line },
            '+' => Token { kind: TokKind::Plus, text: "+".to_string(), line },
            '*' => Token { kind: TokKind::Star, text: "*".to_string(), line },
            '/' => Token { kind: TokKind::Slash, text: "/".to_string(), line },
            '-' => {
                if self.peek() == '>' { self.bump(); Token { kind: TokKind::Arrow, text: "->".to_string(), line } }
                else { Token { kind: TokKind::Minus, text: "-".to_string(), line } }
            },
            '.' => {
                if self.peek() == '.' { self.bump(); Token { kind: TokKind::DotDot, text: "..".to_string(), line } }
                else { Token { kind: TokKind::Eof, text: ".".to_string(), line } }
            },
            '=' => {
                if self.peek() == '=' { self.bump(); Token { kind: TokKind::EqEq, text: "==".to_string(), line } }
                else if self.peek() == '>' { self.bump(); Token { kind: TokKind::FatArrow, text: "=>".to_string(), line } }
                else { Token { kind: TokKind::Eof, text: "=".to_string(), line } }
            },
            '!' => {
                if self.peek() == '=' { self.bump(); Token { kind: TokKind::NotEq, text: "!=".to_string(), line } }
                else { Token { kind: TokKind::Not, text: "!".to_string(), line } }
            },
            '<' => {
                if self.peek() == '=' { self.bump(); Token { kind: TokKind::LtEq, text: "<=".to_string(), line } }
                else { Token { kind: TokKind::Lt, text: "<".to_string(), line } }
            },
            '>' => {
                if self.peek() == '=' { self.bump(); Token { kind: TokKind::GtEq, text: ">=".to_string(), line } }
                else { Token { kind: TokKind::Gt, text: ">".to_string(), line } }
            },
            '&' => { if self.peek() == '&' { self.bump(); } Token { kind: TokKind::AndAnd, text: "&&".to_string(), line } },
            '|' => { if self.peek() == '|' { self.bump(); } Token { kind: TokKind::OrOr, text: "||".to_string(), line } },
            _ => Token { kind: TokKind::Eof, text: c.to_string(), line },
        }
    }
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// THEOREM AST
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

pub enum AExpr {
    Ident(String),
    IntLit(i64),
    Binary(String, Box<AExpr>, Box<AExpr>),
    Implies(Box<AExpr>, Box<AExpr>),
    Not(Box<AExpr>),
    Call(String, Vec<AExpr>),
}

pub struct Quantifier {
    var: String,
    lo: i64,
    hi: i64,
}

pub struct StateSample {
    fields: Vec<(String, i64)>,
}

pub enum TheoremKind {
    Theorem,
    Axiom,
    Invariant,
}

pub struct TheoremDecl {
    name: String,
    kind: TheoremKind,
    quantifiers: Vec<Quantifier>,
    states: Vec<StateSample>,
    body: AExpr,
    preconditions: Vec<AExpr>,
    postconditions: Vec<AExpr>,
    invariant_exprs: Vec<AExpr>,
    assertions: Vec<AExpr>,
}

pub struct TheoremAst {
    theorems: Vec<TheoremDecl>,
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// PARSER
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

pub struct AxiomParser {
    toks: Vec<Token>,
    pos: i32,
}

impl AxiomParser {
    pub fn new(toks: Vec<Token>) -> Self { AxiomParser { toks, pos: 0 } }

    fn cur(&self) -> Token { if self.pos < (self.toks.len() as i32) { self.toks[self.pos as usize].clone() } else { Token { kind: TokKind::Eof, text: String::new(), line: 0 } } }
    fn cur_text(&self) -> String { self.cur().text }
    fn advance(&mut self) -> Token { let t = self.cur(); self.pos += 1; t }
    fn at_eof(&self) -> bool { matches!(self.cur().kind, TokKind::Eof) }

    fn expect_text(&mut self, s: &str) -> Result<(), String> {
        if self.cur_text() == s.to_string() { self.advance(); Ok(()) }
        else { Err(format!("AXIOM parse error at line {}: expected '{}', found '{}'", self.cur().line, s, self.cur_text())) }
    }

    pub fn parse(&mut self) -> Result<TheoremAst, String> {
        let mut ast = TheoremAst { theorems: Vec::new() }
        while !self.at_eof() {
            if self.cur_text() == "theorem".to_string() {
                ast.theorems.push(self.parse_theorem()?)
            } else if self.cur_text() == "axiom".to_string() {
                ast.theorems.push(self.parse_axiom()?)
            } else if self.cur_text() == "invariant".to_string() {
                ast.theorems.push(self.parse_invariant()?)
            } else {
                self.advance();
            }
        }
        Ok(ast)
    }

    fn parse_quantifiers(&mut self) -> Result<Vec<Quantifier>, String> {
        let mut qs = Vec::new()
        if self.cur_text() == "forall".to_string() {
            self.advance();
            loop {
                let var = self.advance().text
                self.expect_text("in")?
                let lo_tok = self.advance().text
                let lo = lo_tok.parse::<i64>().unwrap_or(0)
                self.expect_text("..")?
                let hi_tok = self.advance().text
                let hi = hi_tok.parse::<i64>().unwrap_or(0)
                qs.push(Quantifier { var, lo, hi })
                if self.cur_text() == ",".to_string() { self.advance(); } else { break }
            }
        }
        Ok(qs)
    }

    fn parse_theorem(&mut self) -> Result<TheoremDecl, String> {
        self.expect_text("theorem")?
        let name = self.advance().text
        let quantifiers = self.parse_quantifiers()?
        self.expect_text("{")?
        let body = self.parse_expr()?
        self.expect_text("}")?
        Ok(TheoremDecl {
            name, kind: TheoremKind::Theorem, quantifiers, states: Vec::new(),
            body, preconditions: Vec::new(), postconditions: Vec::new(),
            invariant_exprs: Vec::new(), assertions: Vec::new(),
        })
    }

    fn parse_axiom(&mut self) -> Result<TheoremDecl, String> {
        self.expect_text("axiom")?
        let name = self.advance().text
        self.expect_text("{")?
        let body = self.parse_expr()?
        self.expect_text("}")?
        Ok(TheoremDecl {
            name, kind: TheoremKind::Axiom, quantifiers: Vec::new(), states: Vec::new(),
            body, preconditions: Vec::new(), postconditions: Vec::new(),
            invariant_exprs: Vec::new(), assertions: Vec::new(),
        })
    }

    fn parse_invariant(&mut self) -> Result<TheoremDecl, String> {
        self.expect_text("invariant")?
        let name = self.advance().text
        let mut states = Vec::new()
        if self.cur_text() == "over".to_string() {
            self.advance();
            self.expect_text("states")?
            self.expect_text("(")?
            while self.cur_text() != ")".to_string() && !self.at_eof() {
                if self.cur_text() == "{".to_string() {
                    self.advance();
                    let mut fields = Vec::new()
                    while self.cur_text() != "}".to_string() && !self.at_eof() {
                        let fname = self.advance().text
                        self.expect_text(":")?
                        let neg = if self.cur_text() == "-".to_string() { self.advance(); true } else { false }
                        let raw = self.advance().text
                        let mut val = raw.parse::<i64>().unwrap_or(0)
                        if neg { val = -val }
                        fields.push((fname, val))
                        if self.cur_text() == ",".to_string() { self.advance(); }
                    }
                    self.expect_text("}")?
                    states.push(StateSample { fields })
                }
                if self.cur_text() == ",".to_string() { self.advance(); }
            }
            self.expect_text(")")?
        }
        self.expect_text("{")?
        let body = self.parse_expr()?
        self.expect_text("}")?
        Ok(TheoremDecl {
            name, kind: TheoremKind::Invariant, quantifiers: Vec::new(), states,
            body, preconditions: Vec::new(), postconditions: Vec::new(),
            invariant_exprs: Vec::new(), assertions: Vec::new(),
        })
    }

    // Expression grammar (lowest to highest precedence):
    // implies (=>) > or (||) > and (&&) > equality (==, !=) > relational (<,>,<=,>=) > additive > multiplicative > unary > primary
    fn parse_expr(&mut self) -> Result<AExpr, String> { self.parse_implies() }

    fn parse_implies(&mut self) -> Result<AExpr, String> {
        let lhs = self.parse_or()?
        if self.cur_text() == "=>".to_string() {
            self.advance();
            let rhs = self.parse_implies()?
            return Ok(AExpr::Implies(Box::new(lhs), Box::new(rhs)))
        }
        Ok(lhs)
    }

    fn parse_or(&mut self) -> Result<AExpr, String> {
        let mut lhs = self.parse_and()?
        while self.cur_text() == "||".to_string() {
            self.advance();
            let rhs = self.parse_and()?
            lhs = AExpr::Binary("or".to_string(), Box::new(lhs), Box::new(rhs))
        }
        Ok(lhs)
    }

    fn parse_and(&mut self) -> Result<AExpr, String> {
        let mut lhs = self.parse_equality()?
        while self.cur_text() == "&&".to_string() {
            self.advance();
            let rhs = self.parse_equality()?
            lhs = AExpr::Binary("and".to_string(), Box::new(lhs), Box::new(rhs))
        }
        Ok(lhs)
    }

    fn parse_equality(&mut self) -> Result<AExpr, String> {
        let mut lhs = self.parse_relational()?
        loop {
            if self.cur_text() == "==".to_string() {
                self.advance();
                let rhs = self.parse_relational()?
                lhs = AExpr::Binary("=".to_string(), Box::new(lhs), Box::new(rhs))
            } else if self.cur_text() == "!=".to_string() {
                self.advance();
                let rhs = self.parse_relational()?
                lhs = AExpr::Not(Box::new(AExpr::Binary("=".to_string(), Box::new(lhs), Box::new(rhs))))
            } else { break }
        }
        Ok(lhs)
    }

    fn parse_relational(&mut self) -> Result<AExpr, String> {
        let mut lhs = self.parse_additive()?
        loop {
            let op = match self.cur().kind {
                TokKind::Lt => Some("<".to_string()),
                TokKind::Gt => Some(">".to_string()),
                TokKind::LtEq => Some("<=".to_string()),
                TokKind::GtEq => Some(">=".to_string()),
                _ => None,
            }
            if let Some(o) = op {
                self.advance();
                let rhs = self.parse_additive()?
                lhs = AExpr::Binary(o, Box::new(lhs), Box::new(rhs))
            } else { break }
        }
        Ok(lhs)
    }

    fn parse_additive(&mut self) -> Result<AExpr, String> {
        let mut lhs = self.parse_multiplicative()?
        loop {
            if self.cur_text() == "+".to_string() {
                self.advance();
                let rhs = self.parse_multiplicative()?
                lhs = AExpr::Binary("+".to_string(), Box::new(lhs), Box::new(rhs))
            } else if self.cur_text() == "-".to_string() {
                self.advance();
                let rhs = self.parse_multiplicative()?
                lhs = AExpr::Binary("-".to_string(), Box::new(lhs), Box::new(rhs))
            } else { break }
        }
        Ok(lhs)
    }

    fn parse_multiplicative(&mut self) -> Result<AExpr, String> {
        let mut lhs = self.parse_unary()?
        loop {
            if self.cur_text() == "*".to_string() {
                self.advance();
                let rhs = self.parse_unary()?
                lhs = AExpr::Binary("*".to_string(), Box::new(lhs), Box::new(rhs))
            } else if self.cur_text() == "/".to_string() {
                self.advance();
                let rhs = self.parse_unary()?
                lhs = AExpr::Binary("/".to_string(), Box::new(lhs), Box::new(rhs))
            } else { break }
        }
        Ok(lhs)
    }

    fn parse_unary(&mut self) -> Result<AExpr, String> {
        if self.cur_text() == "!".to_string() {
            self.advance();
            let e = self.parse_unary()?
            return Ok(AExpr::Not(Box::new(e)))
        }
        self.parse_primary()
    }

    fn parse_primary(&mut self) -> Result<AExpr, String> {
        let t = self.cur()
        match t.kind {
            TokKind::IntLit => { self.advance(); Ok(AExpr::IntLit(t.text.parse::<i64>().unwrap_or(0))) },
            TokKind::LParen => {
                self.advance();
                let e = self.parse_expr()?
                self.expect_text(")")?
                Ok(e)
            },
            TokKind::Ident => {
                let name = self.advance().text
                if self.cur_text() == "(".to_string() {
                    self.advance();
                    let mut args = Vec::new()
                    while self.cur_text() != ")".to_string() && !self.at_eof() {
                        args.push(self.parse_expr()?)
                        if self.cur_text() == ",".to_string() { self.advance(); }
                    }
                    self.expect_text(")")?
                    Ok(AExpr::Call(name, args))
                } else {
                    Ok(AExpr::Ident(name))
                }
            },
            _ => { self.advance(); Ok(AExpr::IntLit(0)) },
        }
    }
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// SMT-LIB2 EMITTER
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

pub fn expr_to_smt(e: &AExpr) -> String {
    match e {
        AExpr::IntLit(v) => format!("{}", v),
        AExpr::Ident(n) => n.clone(),
        AExpr::Binary(op, l, r) => {
            let smt_op = match op.as_str() {
                "=" => "=", "+" => "+", "-" => "-", "*" => "*", "/" => "div",
                "<" => "<", ">" => ">", "<=" => "<=", ">=" => ">=",
                "and" => "and", "or" => "or",
                _ => "=",
            }
            format!("({} {} {})", smt_op, expr_to_smt(l), expr_to_smt(r))
        },
        AExpr::Implies(l, r) => format!("(=> {} {})", expr_to_smt(l), expr_to_smt(r)),
        AExpr::Not(inner) => format!("(not {})", expr_to_smt(inner)),
        AExpr::Call(name, args) => {
            let mut parts = Vec::new()
            for a in args { parts.push(expr_to_smt(a)) }
            format!("({} {})", name, parts.join(" "))
        },
    }
}

fn collect_idents(e: &AExpr, out: &mut Vec<String>) {
    match e {
        AExpr::Ident(n) => { if !out.contains(n) { out.push(n.clone()) } },
        AExpr::Binary(_, l, r) => { collect_idents(l, out); collect_idents(r, out); },
        AExpr::Implies(l, r) => { collect_idents(l, out); collect_idents(r, out); },
        AExpr::Not(inner) => collect_idents(inner, out),
        AExpr::Call(_, args) => { for a in args { collect_idents(a, out) } },
        AExpr::IntLit(_) => {},
    }
}

pub fn generate_smt2(theorem: &TheoremDecl) -> String {
    let mut out = String::new()
    out.push_str(&format!("; theorem {}\n", theorem.name))

    let mut idents = Vec::new()
    collect_idents(&theorem.body, &mut idents)
    for q in &theorem.quantifiers { if !idents.contains(&q.var) { idents.push(q.var.clone()) } }

    for id in &idents {
        out.push_str(&format!("(declare-const {} Int)\n", id))
    }

    for q in &theorem.quantifiers {
        out.push_str(&format!("(assert (>= {} {}))\n", q.var, q.lo))
        out.push_str(&format!("(assert (< {} {}))\n", q.var, q.hi))
    }

    // Negate the goal: an SMT solver proves the theorem by showing the
    // negation is UNSAT over the declared/bounded domain.
    let body_smt = expr_to_smt(&theorem.body)
    out.push_str(&format!("(assert (not {}))\n", body_smt))
    out.push_str("(check-sat)\n")
    out
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// TITAN IR LOWERING (runtime-checked subset: invariants + assertions)
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

fn expr_to_titan_expr(e: &AExpr) -> String {
    match e {
        AExpr::IntLit(v) => format!("{}", v),
        AExpr::Ident(n) => n.clone(),
        AExpr::Binary(op, l, r) => {
            let titan_op = match op.as_str() {
                "=" => "==", "and" => "&&", "or" => "||",
                other => other,
            }
            format!("({} {} {})", expr_to_titan_expr(l), titan_op, expr_to_titan_expr(r))
        },
        AExpr::Implies(l, r) => format!("(!({}) || ({}))", expr_to_titan_expr(l), expr_to_titan_expr(r)),
        AExpr::Not(inner) => format!("!({})", expr_to_titan_expr(inner)),
        AExpr::Call(name, args) => {
            let mut parts = Vec::new()
            for a in args { parts.push(expr_to_titan_expr(a)) }
            format!("{}({})", name, parts.join(", "))
        },
    }
}

pub fn generate_titan_ir(theorem: &TheoremDecl) -> String {
    let cond = expr_to_titan_expr(&theorem.body)
    format!("assert_invariant(\"{}\", {})", theorem.name, cond)
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// COMPILER DRIVER
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

pub struct AxiomCompileResult {
    ast: TheoremAst,
    smt2_output: Vec<String>,
    titan_ir_output: Vec<String>,
}

pub fn compile_axiom_source(source: String) -> Result<AxiomCompileResult, String> {
    let mut lexer = AxiomLexer::new(source)
    let tokens = lexer.tokenize()
    let mut parser = AxiomParser::new(tokens)
    let ast = parser.parse()?

    let mut smt2_output = Vec::new()
    let mut titan_ir_output = Vec::new()
    for theorem in &ast.theorems {
        smt2_output.push(generate_smt2(theorem))
        titan_ir_output.push(generate_titan_ir(theorem))
    }

    Ok(AxiomCompileResult { ast, smt2_output, titan_ir_output })
}

pub fn test_axiom_compiler() -> Result<(), String> {
    let axiom_code = r#"
        theorem CommuteAdd forall x in 0..10, y in 0..10 {
            x + y == y + x
        }

        axiom BaseCase {
            0 + 0 == 0
        }

        invariant CounterNonNegative over states (
            { count: 0 },
            { count: 5 },
            { count: -1 }
        ) {
            count >= 0
        }
    "#.to_string()

    let result = compile_axiom_source(axiom_code)?
    if result.ast.theorems.len() != 3 {
        return Err(format!("Expected 3 declarations, got {}", result.ast.theorems.len()))
    }
    if !result.smt2_output[0].contains("(check-sat)") {
        return Err("Missing SMT-LIB2 check-sat".to_string())
    }
    if !result.titan_ir_output[0].contains("assert_invariant") {
        return Err("Missing Titan IR assert_invariant call".to_string())
    }
    Ok(())
}

pub fn main() {
    println!("AXIOM Frontend - Formal Verification Compiler (SMT-LIB2 + Titan IR) Ready");
}
