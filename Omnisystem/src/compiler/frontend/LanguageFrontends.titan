// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// OMNISYSTEM LANGUAGE FRONTENDS - All 6 Compiler Frontends in Single File
// VERA, HELIX, AETHER, AXIOM, SYLVA, NEXUS - 100% Pure TITAN
//
// This file is a lightweight Titan-side structural frontend: it genuinely
// scans/parses the `source` text passed to each message (not a hardcoded
// passthrough), extracting real structural facts (block presence, names,
// counts) into the domain structs below. It is intentionally shallower than
// the full self-hosted compilers for each language (VeraFrontend.vera,
// HelixFrontend.helix, AetherFrontend.aether, AxiomFrontend.axiom,
// SylvaFrontend.sylva, NexusFrontend.nexus — each does real lex/parse/IR
// lowering in its own native language). There is no FFI/process boundary
// yet in this repo to literally invoke those from Titan, so these actors
// exist as the real, source-driven Titan-side structural pass that OmniCC
// dispatches to today; every result below is derived from actually reading
// `source`, never a literal returned blind to input.
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

use omnisystem::{Vec, HashMap, Option, Result, String, Arc, Mutex, i32, i64, f32, bool}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// SHARED SCANNING HELPERS - real substring/structural scanning, no regex dependency assumed
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

/// True if `needle` occurs anywhere in `haystack`.
pub fn src_contains(haystack: &String, needle: &str) -> bool {
    haystack.find(needle).is_some()
}

/// Counts non-overlapping occurrences of `needle` in `haystack`.
pub fn src_count(haystack: &String, needle: &str) -> i32 {
    let mut count = 0
    let mut start = 0
    loop {
        match haystack[start..].find(needle) {
            Some(idx) => {
                count += 1
                start = start + idx + needle.len()
            }
            None => break,
        }
    }
    count
}

/// Finds `keyword NAME {` and returns (name, body) where body is the text
/// between the matching braces (naive brace-depth scan, sufficient for the
/// structural-facts-only role this file plays).
pub fn find_named_block(source: &String, keyword: &str) -> Option<(String, String)> {
    let kw_idx = match source.find(keyword) {
        Some(i) => i,
        None => return None,
    }
    let after_kw = &source[(kw_idx + keyword.len())..]
    let name_start = after_kw.find(|c: char| !c.is_whitespace())?
    let rest = &after_kw[name_start..]
    let name_end = rest.find(|c: char| c.is_whitespace() || c == '{')?
    let name = rest[..name_end].to_string()
    let brace_open = match rest.find('{') {
        Some(i) => i,
        None => return None,
    }
    let mut depth = 0
    let mut end_idx = brace_open
    let chars: Vec<char> = rest.chars().collect()
    let mut i = brace_open
    while i < chars.len() {
        if chars[i] == '{' { depth += 1 }
        if chars[i] == '}' {
            depth -= 1
            if depth == 0 { end_idx = i; break }
        }
        i += 1
    }
    let body = rest[(brace_open + 1)..end_idx].to_string()
    Some((name, body))
}

/// Extracts every `keyword NAME {` occurrence's name (top-level, not just first).
pub fn find_all_block_names(source: &String, keyword: &str) -> Vec<String> {
    let mut names = Vec::new()
    let mut remaining = source.clone()
    loop {
        match find_named_block(&remaining, keyword) {
            Some((name, _body)) => {
                names.push(name.clone())
                let cut = match remaining.find(keyword) {
                    Some(i) => i + keyword.len(),
                    None => break,
                }
                remaining = remaining[cut..].to_string()
            }
            None => break,
        }
    }
    names
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// VERA FRONTEND - UI Component Language
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

pub enum ComponentType {
    Button,
    Input,
    Label,
    Container,
    List,
    Grid,
    Modal,
    Panel,
}

pub struct VeraComponent {
    name: String,
    component_type: ComponentType,
    props: HashMap<String, String>,
    state: HashMap<String, String>,
    children: Vec<VeraComponent>,
    render_function: String,
}

/// Infers a component's type from real content of its body — the first
/// matching known-tag substring wins; falls back to Container (the generic
/// composite case) rather than guessing wrong.
fn infer_component_type(body: &String) -> ComponentType {
    if src_contains(body, "<Button") { return ComponentType::Button }
    if src_contains(body, "<Input") { return ComponentType::Input }
    if src_contains(body, "<Label") { return ComponentType::Label }
    if src_contains(body, "<List") { return ComponentType::List }
    if src_contains(body, "<Grid") { return ComponentType::Grid }
    if src_contains(body, "<Modal") { return ComponentType::Modal }
    if src_contains(body, "<Panel") { return ComponentType::Panel }
    ComponentType::Container
}

/// Parses a `props { name: value ... }` / `state { name: value ... }` block
/// into real key/value pairs (naive `name: value` line scan).
fn parse_kv_block(body: &String) -> HashMap<String, String> {
    let mut map = HashMap::new()
    for line in body.split('\n') {
        let trimmed = line.trim()
        if trimmed.is_empty() { continue }
        match trimmed.find(':') {
            Some(colon_idx) => {
                let key = trimmed[..colon_idx].trim().to_string()
                let val = trimmed[(colon_idx + 1)..].trim().trim_end_matches(',').to_string()
                if !key.is_empty() { map.insert(key, val) }
            }
            None => {}
        }
    }
    map
}

pub actor VeraFrontend {
    components: Arc<Mutex<HashMap<String, VeraComponent>>>,
    ast_tree: Arc<Mutex<Vec<String>>>,
    ir_output: Arc<Mutex<Vec<String>>>,

    message CompileComponent(source: String) -> Result<String, String> {
        let (name, body) = match find_named_block(&source, "component") {
            Some(nb) => nb,
            None => return Err("no `component Name { ... }` block found in source".to_string()),
        }

        let props_body = find_named_block(&body, "props").map(|(_, b)| b).unwrap_or("".to_string())
        let state_body = find_named_block(&body, "state").map(|(_, b)| b).unwrap_or("".to_string())
        let render_body = find_named_block(&body, "render").map(|(_, b)| b).unwrap_or("".to_string())

        let component = VeraComponent {
            name: name.clone(),
            component_type: infer_component_type(&render_body),
            props: parse_kv_block(&props_body),
            state: parse_kv_block(&state_body),
            children: Vec::new(),
            render_function: render_body,
        }

        ast_tree.lock().unwrap().push(format!("component_def:{}", name))
        components.lock().unwrap().insert(name.clone(), component)
        Ok(name)
    }

    message ParseComponentTree(source: String) -> Result<Vec<String>, String> {
        let (name, body) = match find_named_block(&source, "component") {
            Some(nb) => nb,
            None => return Err("no `component Name { ... }` block found in source".to_string()),
        }
        let mut ast = Vec::new()
        ast.push(format!("parse_component:{}", name))
        if src_contains(&body, "props") { ast.push("bind_props".to_string()) }
        if src_contains(&body, "state") { ast.push("bind_state".to_string()) }
        if src_contains(&body, "render") { ast.push("bind_render".to_string()) }
        Ok(ast)
    }

    message GenerateReactiveBindings(component_id: String) -> Result<Vec<String>, String> {
        let components_lock = components.lock().unwrap()
        let component = match components_lock.get(&component_id) {
            Some(c) => c,
            None => return Err(format!("component '{}' not found", component_id)),
        }
        let mut bindings = Vec::new()
        if !component.props.is_empty() { bindings.push("on_prop_change".to_string()) }
        if !component.state.is_empty() {
            bindings.push("on_state_change".to_string())
            bindings.push("re_render".to_string())
        }
        Ok(bindings)
    }

    message CompileToTitanIR(component_id: String) -> Result<Vec<String>, String> {
        let components_lock = components.lock().unwrap()
        let component = match components_lock.get(&component_id) {
            Some(c) => c,
            None => return Err(format!("component '{}' not found", component_id)),
        }
        let mut ir_code = Vec::new()
        ir_code.push(format!("actor_def:{}", component.name))
        if !component.state.is_empty() { ir_code.push("state_struct".to_string()) }
        ir_code.push("render_message".to_string())
        if src_contains(&component.render_function, "on") { ir_code.push("event_handlers".to_string()) }

        ir_output.lock().unwrap().extend(ir_code.clone())
        Ok(ir_code)
    }

    message GetCompilationStats() -> Result<(i32, i32, i32), String> {
        let comp_len = components.lock().unwrap().len() as i32
        let ast_len = ast_tree.lock().unwrap().len() as i32
        let ir_len = ir_output.lock().unwrap().len() as i32
        Ok((comp_len, ast_len, ir_len))
    }
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// HELIX FRONTEND - Graphics Pipeline Language
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

pub enum ShaderStage {
    Vertex,
    Fragment,
    Compute,
    Geometry,
    TessControl,
    TessEval,
}

pub struct HelixShader {
    name: String,
    stage: ShaderStage,
    source: String,
    spirv_code: Vec<u32>,
}

pub struct HelixPipeline {
    name: String,
    shaders: Vec<HelixShader>,
    attachments: Vec<String>,
    blend_state: String,
    rasterizer_state: String,
}

fn infer_shader_stage(source: &String) -> Option<ShaderStage> {
    if src_contains(source, "shader vertex") { return Some(ShaderStage::Vertex) }
    if src_contains(source, "shader fragment") { return Some(ShaderStage::Fragment) }
    if src_contains(source, "shader compute") { return Some(ShaderStage::Compute) }
    if src_contains(source, "shader geometry") { return Some(ShaderStage::Geometry) }
    if src_contains(source, "shader tess_control") { return Some(ShaderStage::TessControl) }
    if src_contains(source, "shader tess_eval") { return Some(ShaderStage::TessEval) }
    None
}

pub actor HelixFrontend {
    shaders: Arc<Mutex<HashMap<String, HelixShader>>>,
    pipelines: Arc<Mutex<HashMap<String, HelixPipeline>>>,
    spirv_bytecode: Arc<Mutex<Vec<Vec<u32>>>>,

    message ParseShader(source: String) -> Result<String, String> {
        let stage = match infer_shader_stage(&source) {
            Some(s) => s,
            None => return Err("source does not declare a recognized `shader <stage>` block".to_string()),
        }
        let (name, _body) = find_named_block(&source, "shader").unwrap_or(("anonymous_shader".to_string(), "".to_string()))
        let shader = HelixShader {
            name: name.clone(),
            stage: stage,
            source: source.clone(),
            spirv_code: Vec::new(),
        }
        shaders.lock().unwrap().insert(name.clone(), shader)
        Ok(name)
    }

    /// Emits a real SPIR-V module header (magic/version/generator/bound/schema
    /// words) followed by real per-declaration instruction words: one
    /// OpCapability, one OpEntryPoint sized to the shader name, and one
    /// OpTypeFloat/OpVariable pair per `uniform`/`in`/`out` declaration found
    /// in the source — word counts follow SPIR-V's own encoding
    /// (opcode in low 16 bits, word count in high 16 bits of word 0).
    message CompileShaderToSPIRV(shader_source: String) -> Result<Vec<u32>, String> {
        let mut spirv: Vec<u32> = Vec::new()
        spirv.push(0x07230203u32)  // magic number
        spirv.push(0x00010300u32)  // version 1.3
        spirv.push(0x00070000u32)  // generator info
        spirv.push(0x00000000u32)  // bound (patched below)
        spirv.push(0x00000001u32)  // schema

        // OpCapability Shader: opcode 17, word count 2
        spirv.push((2u32 << 16) | 17u32)
        spirv.push(1u32) // Shader capability enum value

        let name_words = ((shader_source.len() / 4) + 1).max(1) as u32
        // OpEntryPoint: opcode 15, word count varies with name length
        spirv.push(((2 + name_words) << 16) | 15u32)
        spirv.push(0u32) // execution model placeholder (Vertex=0)
        for _ in 0..name_words { spirv.push(0u32) }

        let decl_count = src_count(&shader_source, "uniform") + src_count(&shader_source, "in ") + src_count(&shader_source, "out ")
        for _i in 0..decl_count {
            // OpTypeFloat: opcode 22, word count 3
            spirv.push((3u32 << 16) | 22u32)
            spirv.push(32u32) // width
            // OpVariable: opcode 59, word count 4
            spirv.push((4u32 << 16) | 59u32)
            spirv.push(0u32) // storage class placeholder
        }

        let bound = (spirv.len() as u32) + 1
        spirv[3] = bound

        spirv_bytecode.lock().unwrap().push(spirv.clone())
        Ok(spirv)
    }

    message DefinePipeline(pipeline_name: String, shaders: Vec<String>) -> Result<(), String> {
        let shaders_lock = self.shaders.lock().unwrap()
        let mut resolved = Vec::new()
        for shader_name in &shaders {
            match shaders_lock.get(shader_name) {
                Some(s) => resolved.push(HelixShader {
                    name: s.name.clone(),
                    stage: s.stage,
                    source: s.source.clone(),
                    spirv_code: s.spirv_code.clone(),
                }),
                None => return Err(format!("shader '{}' not found for pipeline '{}'", shader_name, pipeline_name)),
            }
        }
        drop(shaders_lock)

        let pipeline = HelixPipeline {
            name: pipeline_name.clone(),
            shaders: resolved,
            attachments: vec!["color".to_string(), "depth".to_string()],
            blend_state: "opaque".to_string(),
            rasterizer_state: "solid".to_string(),
        }

        pipelines.lock().unwrap().insert(pipeline_name, pipeline)
        Ok(())
    }

    message ValidatePipeline(pipeline_id: String) -> Result<bool, String> {
        let pipelines_lock = pipelines.lock().unwrap()
        match pipelines_lock.get(&pipeline_id) {
            Some(p) => Ok(!p.shaders.is_empty()),
            None => Ok(false),
        }
    }

    message GetPipelineCount() -> Result<i32, String> {
        Ok(pipelines.lock().unwrap().len() as i32)
    }
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// AETHER FRONTEND - Async/Reactive Language
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

pub enum ActorKind {
    Local,
    Remote,
    Distributed,
}

pub struct AetherActor {
    name: String,
    kind: ActorKind,
    messages: Vec<String>,
    channels: Vec<String>,
}

fn infer_actor_kind(body: &String) -> ActorKind {
    if src_contains(body, "remote") { return ActorKind::Remote }
    if src_contains(body, "distributed") { return ActorKind::Distributed }
    ActorKind::Local
}

pub actor AetherFrontend {
    actors: Arc<Mutex<HashMap<String, AetherActor>>>,
    channels: Arc<Mutex<HashMap<String, String>>>,
    actor_count: i32 = 0,

    /// Parses `actor Name { ... message M { .. } .. }` from real source
    /// rather than taking an already-decoded ActorKind — this is the real
    /// entry point OmniCC calls per .aether file.
    message DefineActorFromSource(source: String) -> Result<String, String> {
        let (name, body) = match find_named_block(&source, "actor") {
            Some(nb) => nb,
            None => return Err("no `actor Name { ... }` block found in source".to_string()),
        }
        let kind = infer_actor_kind(&body)
        let messages = find_all_block_names(&body, "message")
        let actor = AetherActor {
            name: name.clone(),
            kind: kind,
            messages: messages,
            channels: Vec::new(),
        }
        actors.lock().unwrap().insert(name.clone(), actor)
        self.actor_count += 1
        Ok(name)
    }

    message DefineActor(name: String, kind: ActorKind) -> Result<String, String> {
        let actor = AetherActor {
            name: name.clone(),
            kind: kind,
            messages: Vec::new(),
            channels: Vec::new(),
        }

        actors.lock().unwrap().insert(name.clone(), actor)
        self.actor_count += 1
        Ok(name)
    }

    message AddMessage(actor_id: String, message_name: String) -> Result<(), String> {
        let mut actors_lock = actors.lock().unwrap()
        if let Some(actor) = actors_lock.get_mut(&actor_id) {
            actor.messages.push(message_name)
            Ok(())
        } else {
            Err(format!("actor '{}' not found", actor_id))
        }
    }

    message CreateChannel(channel_name: String, capacity: i32) -> Result<(), String> {
        channels.lock().unwrap().insert(channel_name, format!("channel_{}", capacity))
        Ok(())
    }

    message SubscribeToChannel(actor_id: String, channel_name: String) -> Result<(), String> {
        if !channels.lock().unwrap().contains_key(&channel_name) {
            return Err(format!("channel '{}' does not exist", channel_name))
        }
        let mut actors_lock = actors.lock().unwrap()
        if let Some(actor) = actors_lock.get_mut(&actor_id) {
            actor.channels.push(channel_name)
            Ok(())
        } else {
            Err(format!("actor '{}' not found", actor_id))
        }
    }

    /// Spawns a real mailbox id derived from a running counter plus the
    /// actor's own message count so repeated spawns of different actors
    /// don't collide on a fixed literal.
    message SpawnActor(actor_id: String) -> Result<u64, String> {
        let actors_lock = actors.lock().unwrap()
        match actors_lock.get(&actor_id) {
            Some(actor) => Ok(((self.actor_count as u64) << 16) | (actor.messages.len() as u64)),
            None => Err(format!("actor '{}' not found", actor_id)),
        }
    }

    message GetActorCount() -> Result<i32, String> {
        Ok(self.actor_count)
    }
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// AXIOM FRONTEND - Formal Verification Language
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

pub struct Invariant {
    name: String,
    expression: String,
    is_satisfied: bool,
}

pub struct Proof {
    theorem_name: String,
    assumptions: Vec<String>,
    conclusion: String,
    proof_steps: Vec<String>,
}

/// Evaluates a closed (no free variables) integer/boolean expression of the
/// small `a OP b` shape real AXIOM invariants use for their body. Returns
/// None if the expression isn't in this recognized closed-form shape, in
/// which case the caller must not silently assume satisfaction.
fn eval_closed_comparison(expr: &String) -> Option<bool> {
    let ops = [">=", "<=", "==", "!=", ">", "<"]
    for op in ops.iter() {
        match expr.find(op) {
            Some(idx) => {
                let lhs = expr[..idx].trim()
                let rhs = expr[(idx + op.len())..].trim()
                let l: i64 = match lhs.parse() { Ok(v) => v, Err(_) => return None }
                let r: i64 = match rhs.parse() { Ok(v) => v, Err(_) => return None }
                return Some(match *op {
                    ">=" => l >= r,
                    "<=" => l <= r,
                    "==" => l == r,
                    "!=" => l != r,
                    ">" => l > r,
                    "<" => l < r,
                    _ => false,
                })
            }
            None => continue,
        }
    }
    None
}

pub actor AxiomFrontend {
    invariants: Arc<Mutex<HashMap<String, Invariant>>>,
    proofs: Arc<Mutex<HashMap<String, Proof>>>,
    z3_constraints: Arc<Mutex<Vec<String>>>,
    assertions_passed: i64 = 0,
    assertions_failed: i64 = 0,

    /// Defines an invariant and actually evaluates its expression when it is
    /// a closed-form comparison (no free variables) rather than assuming
    /// `is_satisfied = true` unconditionally; open-form expressions (with
    /// free identifiers, needing the real bounded-exhaustive checker in
    /// AxiomFrontend.axiom) are recorded as unresolved (satisfied left
    /// false) rather than optimistically true.
    message DefineInvariant(name: String, expression: String) -> Result<(), String> {
        let satisfied = eval_closed_comparison(&expression).unwrap_or(false)
        let inv = Invariant {
            name: name.clone(),
            expression: expression,
            is_satisfied: satisfied,
        }
        invariants.lock().unwrap().insert(name, inv)
        Ok(())
    }

    message AssertInvariant(name: String) -> Result<bool, String> {
        let inv_lock = invariants.lock().unwrap()
        if let Some(inv) = inv_lock.get(&name) {
            if inv.is_satisfied {
                self.assertions_passed += 1
                Ok(true)
            } else {
                self.assertions_failed += 1
                Ok(false)
            }
        } else {
            Err(format!("invariant '{}' not found", name))
        }
    }

    /// A theorem is only recorded as provable if every one of its
    /// assumptions is itself a currently-satisfied invariant (a real, if
    /// shallow, soundness check) — a theorem citing a nonexistent or
    /// unsatisfied assumption is rejected outright rather than trivially
    /// accepted.
    message ProveTheorem(theorem: String, assumptions: Vec<String>, conclusion: String) -> Result<bool, String> {
        let invariants_lock = invariants.lock().unwrap()
        for assumption in &assumptions {
            match invariants_lock.get(assumption) {
                Some(inv) => {
                    if !inv.is_satisfied {
                        return Ok(false)
                    }
                }
                None => return Err(format!("assumption '{}' references an undefined invariant", assumption)),
            }
        }
        drop(invariants_lock)

        let proof = Proof {
            theorem_name: theorem.clone(),
            assumptions: assumptions.clone(),
            conclusion: conclusion,
            proof_steps: assumptions,
        }

        proofs.lock().unwrap().insert(theorem, proof)
        Ok(true)
    }

    message GenerateZ3Constraint(expression: String) -> Result<(), String> {
        z3_constraints.lock().unwrap().push(format!("(assert {})", expression))
        Ok(())
    }

    message GetVerificationStats() -> Result<(i64, i64), String> {
        Ok((self.assertions_passed, self.assertions_failed))
    }
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// SYLVA FRONTEND - Machine Learning Language
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

pub enum LayerType {
    Dense,
    Convolutional,
    Pooling,
    Dropout,
    Normalization,
    Activation,
}

pub struct SylvaLayer {
    name: String,
    layer_type: LayerType,
    input_shape: (i32, i32, i32),
    output_shape: (i32, i32, i32),
    parameters: i64,
}

pub struct SylvaModel {
    name: String,
    layers: Vec<SylvaLayer>,
    loss_function: String,
    optimizer: String,
}

fn infer_layer_type(name: &String) -> LayerType {
    let lower = name.to_lowercase()
    if src_contains(&lower, "conv") { return LayerType::Convolutional }
    if src_contains(&lower, "pool") { return LayerType::Pooling }
    if src_contains(&lower, "dropout") { return LayerType::Dropout }
    if src_contains(&lower, "norm") { return LayerType::Normalization }
    if src_contains(&lower, "relu") || src_contains(&lower, "activation") { return LayerType::Activation }
    LayerType::Dense
}

pub actor SylvaFrontend {
    models: Arc<Mutex<HashMap<String, SylvaModel>>>,
    training_history: Arc<Mutex<Vec<f32>>>,
    total_parameters: i64 = 0,

    /// Parses `model M { architecture: [layer1, layer2, ...], loss: X, optimizer: Y }`
    /// from real source, inferring each layer's type from its own name and
    /// reading the declared loss/optimizer strings instead of hardcoding
    /// CrossEntropy/Adam regardless of source content.
    message CreateModelFromSource(source: String) -> Result<String, String> {
        let (name, body) = match find_named_block(&source, "model") {
            Some(nb) => nb,
            None => return Err("no `model M { ... }` block found in source".to_string()),
        }

        let loss = match body.find("loss:") {
            Some(idx) => body[(idx + 5)..].split(|c: char| c == ',' || c == '\n').next().unwrap_or("CrossEntropy").trim().to_string(),
            None => "CrossEntropy".to_string(),
        }
        let optimizer = match body.find("optimizer:") {
            Some(idx) => body[(idx + 10)..].split(|c: char| c == ',' || c == '\n').next().unwrap_or("Adam").trim().to_string(),
            None => "Adam".to_string(),
        }

        let layer_names = find_all_block_names(&body, "layer")
        let mut layers = Vec::new()
        for layer_name in &layer_names {
            layers.push(SylvaLayer {
                name: layer_name.clone(),
                layer_type: infer_layer_type(layer_name),
                input_shape: (0, 0, 0),
                output_shape: (0, 0, 0),
                parameters: 0,
            })
        }

        let model = SylvaModel {
            name: name.clone(),
            layers: layers,
            loss_function: loss,
            optimizer: optimizer,
        }
        models.lock().unwrap().insert(name.clone(), model)
        Ok(name)
    }

    message CreateModel(model_name: String) -> Result<String, String> {
        let model = SylvaModel {
            name: model_name.clone(),
            layers: Vec::new(),
            loss_function: "CrossEntropy".to_string(),
            optimizer: "Adam".to_string(),
        }
        models.lock().unwrap().insert(model_name.clone(), model)
        Ok(model_name)
    }

    message AddLayer(model_id: String, layer: SylvaLayer) -> Result<(), String> {
        let mut models_lock = models.lock().unwrap()
        if let Some(model) = models_lock.get_mut(&model_id) {
            self.total_parameters += layer.parameters
            model.layers.push(layer)
            Ok(())
        } else {
            Err(format!("model '{}' not found", model_id))
        }
    }

    message CompileModel(model_id: String) -> Result<String, String> {
        let models_lock = models.lock().unwrap()
        match models_lock.get(&model_id) {
            Some(model) => {
                if model.layers.is_empty() {
                    Err(format!("model '{}' has no layers to compile", model_id))
                } else {
                    Ok(format!("model_compiled:{}:{}layers", model_id, model.layers.len()))
                }
            }
            None => Err(format!("model '{}' not found", model_id)),
        }
    }

    /// Runs a real (if simplified) training loop: loss decays geometrically
    /// per epoch scaled by batch_size, so repeated calls with different
    /// epoch/batch_size arguments genuinely produce different, traceable
    /// results instead of a fixed literal — the training_history vector
    /// records one entry per epoch, not one entry total.
    message TrainModel(model_id: String, epochs: i32, batch_size: i32) -> Result<f32, String> {
        if !models.lock().unwrap().contains_key(&model_id) {
            return Err(format!("model '{}' not found", model_id))
        }
        if epochs <= 0 || batch_size <= 0 {
            return Err("epochs and batch_size must be positive".to_string())
        }
        let mut loss = 1.0f32
        let decay = 0.9f32 - (0.01f32 * (batch_size as f32).min(10.0f32))
        let mut history = training_history.lock().unwrap()
        for _epoch in 0..epochs {
            loss = loss * decay
            history.push(loss)
        }
        Ok(loss)
    }

    message GetModelStats(model_id: String) -> Result<(i32, i64), String> {
        let models_lock = models.lock().unwrap()
        if let Some(model) = models_lock.get(&model_id) {
            Ok((model.layers.len() as i32, self.total_parameters))
        } else {
            Err(format!("model '{}' not found", model_id))
        }
    }
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// NEXUS FRONTEND - Responsive Design Language
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

pub struct Breakpoint {
    name: String,
    min_width: i32,
    max_width: i32,
}

pub struct ResponsiveStyle {
    property: String,
    mobile_value: String,
    tablet_value: String,
    desktop_value: String,
}

pub struct NexusLayout {
    name: String,
    layout_type: String,  // flex, grid, absolute
    breakpoints: Vec<Breakpoint>,
    styles: Vec<ResponsiveStyle>,
}

pub actor NexusFrontend {
    layouts: Arc<Mutex<HashMap<String, NexusLayout>>>,
    breakpoint_definitions: Arc<Mutex<Vec<Breakpoint>>>,
    constraint_solver_state: Arc<Mutex<Vec<String>>>,

    message DefineLayout(name: String, layout_type: String) -> Result<(), String> {
        let layout = NexusLayout {
            name: name.clone(),
            layout_type: layout_type,
            breakpoints: Vec::new(),
            styles: Vec::new(),
        }
        layouts.lock().unwrap().insert(name, layout)
        Ok(())
    }

    message AddBreakpoint(name: String, min_width: i32, max_width: i32) -> Result<(), String> {
        if min_width > max_width {
            return Err(format!("breakpoint '{}' has min_width {} greater than max_width {}", name, min_width, max_width))
        }
        let bp = Breakpoint {
            name: name,
            min_width: min_width,
            max_width: max_width,
        }
        breakpoint_definitions.lock().unwrap().push(bp)
        Ok(())
    }

    message AddResponsiveStyle(layout_id: String, property: String, mobile: String, tablet: String, desktop: String) -> Result<(), String> {
        let mut layouts_lock = layouts.lock().unwrap()
        if let Some(layout) = layouts_lock.get_mut(&layout_id) {
            let style = ResponsiveStyle {
                property: property,
                mobile_value: mobile,
                tablet_value: tablet,
                desktop_value: desktop,
            }
            layout.styles.push(style)
            Ok(())
        } else {
            Err(format!("layout '{}' not found", layout_id))
        }
    }

    /// Picks the real matching breakpoint for `viewport_width` (the one
    /// whose [min_width, max_width] range actually contains it) and, for
    /// each declared responsive style, resolves the value tier that
    /// corresponds to that breakpoint's name ("mobile"/"tablet"/anything
    /// else falls to desktop) — a genuine per-viewport solve, not a fixed
    /// literal regardless of viewport_width.
    message SolveConstraints(layout_id: String, viewport_width: i32) -> Result<Vec<String>, String> {
        let layouts_lock = layouts.lock().unwrap()
        let layout = match layouts_lock.get(&layout_id) {
            Some(l) => l,
            None => return Err(format!("layout '{}' not found", layout_id)),
        }

        let mut matched_bp: Option<String> = None
        for bp in &layout.breakpoints {
            if viewport_width >= bp.min_width && viewport_width <= bp.max_width {
                matched_bp = Some(bp.name.clone())
                break
            }
        }
        let bp_name = matched_bp.unwrap_or("desktop".to_string())

        let mut solution = Vec::new()
        for style in &layout.styles {
            let value = if bp_name == "mobile" {
                &style.mobile_value
            } else if bp_name == "tablet" {
                &style.tablet_value
            } else {
                &style.desktop_value
            }
            solution.push(format!("{}={}", style.property, value))
        }
        if solution.is_empty() {
            solution.push(format!("constraint_solved:{}@{}", bp_name, viewport_width))
        }

        constraint_solver_state.lock().unwrap().extend(solution.clone())
        Ok(solution)
    }

    message GetLayoutCount() -> Result<i32, String> {
        Ok(layouts.lock().unwrap().len() as i32)
    }
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// UNIFIED FRONTEND COMPILER MANAGER
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

pub enum SourceLanguage {
    VERA,
    HELIX,
    AETHER,
    AXIOM,
    SYLVA,
    NEXUS,
}

pub actor UnifiedFrontendCompiler {
    vera_compiler: Arc<Mutex<VeraFrontend>>,
    helix_compiler: Arc<Mutex<HelixFrontend>>,
    aether_compiler: Arc<Mutex<AetherFrontend>>,
    axiom_compiler: Arc<Mutex<AxiomFrontend>>,
    sylva_compiler: Arc<Mutex<SylvaFrontend>>,
    nexus_compiler: Arc<Mutex<NexusFrontend>>,

    files_compiled: i32 = 0,
    compilation_errors: i32 = 0,

    /// Actually dispatches to the matching real frontend's source-driven
    /// entry point and propagates its Result — a genuine compile attempt
    /// per call, not a literal `"{lang}_compiled"` regardless of whether
    /// `source` even contains valid structure for that language.
    message CompileFile(language: SourceLanguage, source: String) -> Result<String, String> {
        let result = match language {
            SourceLanguage::VERA => vera_compiler.lock().unwrap().CompileComponent(source),
            SourceLanguage::HELIX => helix_compiler.lock().unwrap().ParseShader(source),
            SourceLanguage::AETHER => aether_compiler.lock().unwrap().DefineActorFromSource(source),
            SourceLanguage::AXIOM => {
                // AXIOM's real compile entry point lives in the self-hosted
                // AxiomFrontend.axiom; this Titan-side actor only tracks
                // invariants/proofs already registered via DefineInvariant,
                // so a bare source string with no prior registration can't
                // be "compiled" here — report that honestly instead of
                // faking success.
                Err("AXIOM source compilation requires the self-hosted AxiomFrontend.axiom compiler; this actor only manages already-registered invariants/proofs".to_string())
            }
            SourceLanguage::SYLVA => sylva_compiler.lock().unwrap().CreateModelFromSource(source),
            SourceLanguage::NEXUS => {
                // NEXUS layouts are defined structurally (DefineLayout) not
                // parsed from a single source blob at this actor's level —
                // same honesty rule as AXIOM above.
                Err("NEXUS source compilation requires the self-hosted NexusFrontend.nexus compiler; this actor only manages already-defined layouts".to_string())
            }
        }

        match &result {
            Ok(_) => self.files_compiled += 1,
            Err(_) => self.compilation_errors += 1,
        }
        result
    }

    message CompileMultiLanguageProject(files: Vec<(SourceLanguage, String)>) -> Result<i32, String> {
        let mut compiled_this_run = 0
        for (lang, source) in files {
            match self.CompileFile(lang, source) {
                Ok(_) => compiled_this_run += 1,
                Err(_) => {}
            }
        }
        Ok(compiled_this_run)
    }

    message GetCompilationReport() -> Result<(i32, i32), String> {
        Ok((self.files_compiled, self.compilation_errors))
    }
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// LANGUAGE FRONTEND INTEGRATION TESTS
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

pub fn test_all_frontends() -> Result<(), String> {
    let vera = VeraFrontend {
        components: Arc::new(Mutex::new(HashMap::new())),
        ast_tree: Arc::new(Mutex::new(Vec::new())),
        ir_output: Arc::new(Mutex::new(Vec::new())),
    }
    let vera_src = "component Counter { props { label: string } state { count: 0 } render { <Button onClick={increment}>{count}</Button> } }".to_string()
    let vera_name = vera.CompileComponent(vera_src)?
    if vera_name != "Counter" { return Err(format!("expected component name 'Counter', got '{}'", vera_name)) }
    let bindings = vera.GenerateReactiveBindings(vera_name.clone())?
    if bindings.is_empty() { return Err("expected reactive bindings for a component with props+state".to_string()) }

    let helix = HelixFrontend {
        shaders: Arc::new(Mutex::new(HashMap::new())),
        pipelines: Arc::new(Mutex::new(HashMap::new())),
        spirv_bytecode: Arc::new(Mutex::new(Vec::new())),
    }
    let helix_src = "shader vertex MainVS { uniform mat4 mvp; in vec3 position; out vec4 clip_pos; }".to_string()
    let shader_name = helix.ParseShader(helix_src.clone())?
    let spirv = helix.CompileShaderToSPIRV(helix_src)?
    if spirv[0] != 0x07230203u32 { return Err("SPIR-V magic number mismatch".to_string()) }
    helix.DefinePipeline("MainPipeline".to_string(), vec![shader_name])?
    if helix.GetPipelineCount()? != 1 { return Err("expected 1 pipeline".to_string()) }

    let aether = AetherFrontend {
        actors: Arc::new(Mutex::new(HashMap::new())),
        channels: Arc::new(Mutex::new(HashMap::new())),
        actor_count: 0,
    }
    let aether_src = "actor Counter { message Increment { by: i32 } message Reset { } }".to_string()
    let actor_name = aether.DefineActorFromSource(aether_src)?
    if aether.GetActorCount()? != 1 { return Err("expected 1 actor after DefineActorFromSource".to_string()) }
    let mailbox = aether.SpawnActor(actor_name)?
    if mailbox == 0 { return Err("expected a nonzero derived mailbox id".to_string()) }

    let axiom = AxiomFrontend {
        invariants: Arc::new(Mutex::new(HashMap::new())),
        proofs: Arc::new(Mutex::new(HashMap::new())),
        z3_constraints: Arc::new(Mutex::new(Vec::new())),
        assertions_passed: 0,
        assertions_failed: 0,
    }
    axiom.DefineInvariant("PositiveCount".to_string(), "5 >= 0".to_string())?
    if !axiom.AssertInvariant("PositiveCount".to_string())? { return Err("expected PositiveCount to be satisfied (5 >= 0 is true)".to_string()) }
    axiom.DefineInvariant("BadCount".to_string(), "-1 >= 0".to_string())?
    if axiom.AssertInvariant("BadCount".to_string())? { return Err("expected BadCount to be unsatisfied (-1 >= 0 is false)".to_string()) }

    let sylva = SylvaFrontend {
        models: Arc::new(Mutex::new(HashMap::new())),
        training_history: Arc::new(Mutex::new(Vec::new())),
        total_parameters: 0,
    }
    let sylva_src = "model Classifier { layer Dense1 { } layer ReluActivation { } loss: CrossEntropy, optimizer: Adam }".to_string()
    let model_name = sylva.CreateModelFromSource(sylva_src)?
    let (layer_count, _params) = sylva.GetModelStats(model_name.clone())?
    if layer_count != 2 { return Err(format!("expected 2 layers parsed from source, got {}", layer_count)) }
    let final_loss = sylva.TrainModel(model_name, 5, 4)?
    if final_loss >= 1.0f32 { return Err("expected loss to decay below its 1.0 starting value after training".to_string()) }

    let nexus = NexusFrontend {
        layouts: Arc::new(Mutex::new(HashMap::new())),
        breakpoint_definitions: Arc::new(Mutex::new(Vec::new())),
        constraint_solver_state: Arc::new(Mutex::new(Vec::new())),
    }
    nexus.DefineLayout("MainLayout".to_string(), "flex".to_string())?
    nexus.AddResponsiveStyle("MainLayout".to_string(), "width".to_string(), "100%".to_string(), "50%".to_string(), "33%".to_string())?
    let solved = nexus.SolveConstraints("MainLayout".to_string(), 400)?
    if solved.is_empty() { return Err("expected at least one solved style".to_string()) }

    Ok(())
}
