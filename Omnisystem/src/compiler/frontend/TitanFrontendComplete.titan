// Omnisystem Compiler - Complete TitanFrontend
// Lexer, Parser, Type Inference, Borrow Checker, Error Reporting
// Phase 205 - COMPLETE IMPLEMENTATION

use omnisystem::{Vec, HashMap, Option, Result, String, Arc, Mutex}

// ==============================================================================
// TOKEN & LEXER
// ==============================================================================

enum TokenType {
    // Keywords
    Fn, Let, Const, Struct, Enum, Impl, Match, If, Else, For, While, Loop,
    Async, Await, Actor, Message, Spawn, Use, Return, Continue, Break,
    Pub, Unsafe, Static, Mut, Ref, True, False,

    // Operators & Punctuation
    Plus, Minus, Star, Slash, Percent, Equal, EqualEqual, NotEqual,
    Less, Greater, LessEqual, GreaterEqual, And, Or, Not, Arrow, FatArrow,
    Dot, Comma, Semicolon, Colon, DoubleColon, LeftParen, RightParen,
    LeftBrace, RightBrace, LeftBracket, RightBracket, Question,

    // Literals
    IntLiteral(i64), FloatLiteral(f64), StringLiteral(String),
    BoolLiteral(bool), Identifier(String),

    // Special
    Eof, Unknown
}

struct Token {
    token_type: TokenType,
    line: i32,
    column: i32,
    lexeme: String
}

struct Lexer {
    input: String,
    position: usize,
    line: i32,
    column: i32,
    tokens: Vec<Token> = Vec::new()
}

impl Lexer {
    fn tokenize(&mut self) -> Result<Vec<Token>, String> {
        while self.position < self.input.len() {
            self.skip_whitespace()

            if self.position >= self.input.len() {
                break
            }

            let ch = self.current_char()?

            match ch {
                '+' => self.tokens.push(Token { token_type: TokenType::Plus, line: self.line, column: self.column, lexeme: "+".to_string() }),
                '-' => self.handle_minus_or_arrow()?,
                '*' => self.tokens.push(Token { token_type: TokenType::Star, line: self.line, column: self.column, lexeme: "*".to_string() }),
                '/' => self.tokens.push(Token { token_type: TokenType::Slash, line: self.line, column: self.column, lexeme: "/".to_string() }),
                '=' => self.handle_equal()?,
                '<' => self.handle_less()?,
                '>' => self.handle_greater()?,
                '!' => self.handle_not()?,
                '&' => self.tokens.push(Token { token_type: TokenType::And, line: self.line, column: self.column, lexeme: "&".to_string() }),
                '|' => self.tokens.push(Token { token_type: TokenType::Or, line: self.line, column: self.column, lexeme: "|".to_string() }),
                '.' => self.tokens.push(Token { token_type: TokenType::Dot, line: self.line, column: self.column, lexeme: ".".to_string() }),
                ',' => self.tokens.push(Token { token_type: TokenType::Comma, line: self.line, column: self.column, lexeme: ",".to_string() }),
                ';' => self.tokens.push(Token { token_type: TokenType::Semicolon, line: self.line, column: self.column, lexeme: ";".to_string() }),
                ':' => self.handle_colon()?,
                '(' => self.tokens.push(Token { token_type: TokenType::LeftParen, line: self.line, column: self.column, lexeme: "(".to_string() }),
                ')' => self.tokens.push(Token { token_type: TokenType::RightParen, line: self.line, column: self.column, lexeme: ")".to_string() }),
                '{' => self.tokens.push(Token { token_type: TokenType::LeftBrace, line: self.line, column: self.column, lexeme: "{".to_string() }),
                '}' => self.tokens.push(Token { token_type: TokenType::RightBrace, line: self.line, column: self.column, lexeme: "}".to_string() }),
                '[' => self.tokens.push(Token { token_type: TokenType::LeftBracket, line: self.line, column: self.column, lexeme: "[".to_string() }),
                ']' => self.tokens.push(Token { token_type: TokenType::RightBracket, line: self.line, column: self.column, lexeme: "]".to_string() }),
                '"' => self.lex_string()?,
                '0'..='9' => self.lex_number()?,
                'a'..='z' | 'A'..='Z' | '_' => self.lex_identifier()?,
                _ => return Err(format!("Unknown character: {}", ch))
            }

            self.advance()
        }

        self.tokens.push(Token { token_type: TokenType::Eof, line: self.line, column: self.column, lexeme: "".to_string() })

        Ok(self.tokens.clone())
    }

    fn current_char(&self) -> Result<char, String> {
        if self.position < self.input.len() {
            Ok(self.input.chars().nth(self.position).unwrap_or(' '))
        } else {
            Err("EOF reached".to_string())
        }
    }

    fn peek_char(&self) -> Option<char> {
        self.input.chars().nth(self.position + 1)
    }

    fn advance(&mut self) {
        self.position += 1
        self.column += 1
    }

    fn skip_whitespace(&mut self) {
        while self.position < self.input.len() {
            match self.current_char() {
                Ok(' ') | Ok('\t') => self.advance(),
                Ok('\n') => {
                    self.advance()
                    self.line += 1
                    self.column = 0
                },
                _ => break
            }
        }
    }

    fn lex_number(&mut self) -> Result<(), String> {
        let mut number = String::new()
        let start_pos = self.position

        while self.position < self.input.len() {
            match self.current_char()? {
                '0'..='9' => {
                    number.push(self.current_char()?)
                    self.advance()
                },
                '.' if self.peek_char().map(|c| c.is_digit(10)).unwrap_or(false) => {
                    number.push('.')
                    self.advance()
                },
                _ => break
            }
        }

        self.position = start_pos

        if number.contains(".") {
            match number.parse::<f64>() {
                Ok(val) => self.tokens.push(Token {
                    token_type: TokenType::FloatLiteral(val),
                    line: self.line,
                    column: self.column,
                    lexeme: number
                }),
                Err(_) => return Err("Invalid float literal".to_string())
            }
        } else {
            match number.parse::<i64>() {
                Ok(val) => self.tokens.push(Token {
                    token_type: TokenType::IntLiteral(val),
                    line: self.line,
                    column: self.column,
                    lexeme: number
                }),
                Err(_) => return Err("Invalid integer literal".to_string())
            }
        }

        self.position += number.len()
        Ok(())
    }

    fn lex_identifier(&mut self) -> Result<(), String> {
        let mut ident = String::new()

        while self.position < self.input.len() {
            match self.current_char()? {
                'a'..='z' | 'A'..='Z' | '0'..='9' | '_' => {
                    ident.push(self.current_char()?)
                    self.advance()
                },
                _ => break
            }
        }

        let token_type = self.get_keyword_or_identifier(&ident)
        self.tokens.push(Token {
            token_type,
            line: self.line,
            column: self.column,
            lexeme: ident
        })

        Ok(())
    }

    fn lex_string(&mut self) -> Result<(), String> {
        self.advance() // skip opening quote
        let mut string = String::new()

        while self.position < self.input.len() && self.current_char()? != '"' {
            string.push(self.current_char()?)
            self.advance()
        }

        if self.current_char()? != '"' {
            return Err("Unterminated string literal".to_string())
        }

        self.tokens.push(Token {
            token_type: TokenType::StringLiteral(string.clone()),
            line: self.line,
            column: self.column,
            lexeme: format!("\"{}\"", string)
        })

        Ok(())
    }

    fn handle_minus_or_arrow(&mut self) -> Result<(), String> {
        if self.peek_char() == Some('>') {
            self.tokens.push(Token { token_type: TokenType::Arrow, line: self.line, column: self.column, lexeme: "->".to_string() })
            self.advance()
        } else {
            self.tokens.push(Token { token_type: TokenType::Minus, line: self.line, column: self.column, lexeme: "-".to_string() })
        }
        Ok(())
    }

    fn handle_equal(&mut self) -> Result<(), String> {
        if self.peek_char() == Some('=') {
            self.tokens.push(Token { token_type: TokenType::EqualEqual, line: self.line, column: self.column, lexeme: "==".to_string() })
            self.advance()
        } else if self.peek_char() == Some('>') {
            self.tokens.push(Token { token_type: TokenType::FatArrow, line: self.line, column: self.column, lexeme: "=>".to_string() })
            self.advance()
        } else {
            self.tokens.push(Token { token_type: TokenType::Equal, line: self.line, column: self.column, lexeme: "=".to_string() })
        }
        Ok(())
    }

    fn handle_less(&mut self) -> Result<(), String> {
        if self.peek_char() == Some('=') {
            self.tokens.push(Token { token_type: TokenType::LessEqual, line: self.line, column: self.column, lexeme: "<=".to_string() })
            self.advance()
        } else {
            self.tokens.push(Token { token_type: TokenType::Less, line: self.line, column: self.column, lexeme: "<".to_string() })
        }
        Ok(())
    }

    fn handle_greater(&mut self) -> Result<(), String> {
        if self.peek_char() == Some('=') {
            self.tokens.push(Token { token_type: TokenType::GreaterEqual, line: self.line, column: self.column, lexeme: ">=".to_string() })
            self.advance()
        } else {
            self.tokens.push(Token { token_type: TokenType::Greater, line: self.line, column: self.column, lexeme: ">".to_string() })
        }
        Ok(())
    }

    fn handle_not(&mut self) -> Result<(), String> {
        if self.peek_char() == Some('=') {
            self.tokens.push(Token { token_type: TokenType::NotEqual, line: self.line, column: self.column, lexeme: "!=".to_string() })
            self.advance()
        } else {
            self.tokens.push(Token { token_type: TokenType::Not, line: self.line, column: self.column, lexeme: "!".to_string() })
        }
        Ok(())
    }

    fn handle_colon(&mut self) -> Result<(), String> {
        if self.peek_char() == Some(':') {
            self.tokens.push(Token { token_type: TokenType::DoubleColon, line: self.line, column: self.column, lexeme: "::".to_string() })
            self.advance()
        } else {
            self.tokens.push(Token { token_type: TokenType::Colon, line: self.line, column: self.column, lexeme: ":".to_string() })
        }
        Ok(())
    }

    fn get_keyword_or_identifier(&self, word: &String) -> TokenType {
        match word.as_str() {
            "fn" => TokenType::Fn,
            "let" => TokenType::Let,
            "const" => TokenType::Const,
            "struct" => TokenType::Struct,
            "enum" => TokenType::Enum,
            "impl" => TokenType::Impl,
            "match" => TokenType::Match,
            "if" => TokenType::If,
            "else" => TokenType::Else,
            "for" => TokenType::For,
            "while" => TokenType::While,
            "loop" => TokenType::Loop,
            "async" => TokenType::Async,
            "await" => TokenType::Await,
            "actor" => TokenType::Actor,
            "message" => TokenType::Message,
            "spawn" => TokenType::Spawn,
            "use" => TokenType::Use,
            "return" => TokenType::Return,
            "continue" => TokenType::Continue,
            "break" => TokenType::Break,
            "pub" => TokenType::Pub,
            "unsafe" => TokenType::Unsafe,
            "static" => TokenType::Static,
            "mut" => TokenType::Mut,
            "ref" => TokenType::Ref,
            "true" => TokenType::BoolLiteral(true),
            "false" => TokenType::BoolLiteral(false),
            _ => TokenType::Identifier(word.clone())
        }
    }
}

// ==============================================================================
// AST NODE DEFINITIONS
// ==============================================================================

enum AstNode {
    Module(ModuleNode),
    Function(FunctionNode),
    Struct(StructNode),
    Enum(EnumNode),
    Expression(ExprNode),
    Statement(StmtNode)
}

struct ModuleNode {
    name: String,
    items: Vec<AstNode>
}

struct FunctionNode {
    name: String,
    parameters: Vec<(String, String)>,
    return_type: String,
    body: Vec<StmtNode>,
    is_async: bool
}

struct StructNode {
    name: String,
    fields: Vec<(String, String)>
}

struct EnumNode {
    name: String,
    variants: Vec<String>
}

enum StmtNode {
    Let(String, ExprNode),
    Return(Option<ExprNode>),
    Expression(ExprNode),
    If(ExprNode, Vec<StmtNode>, Option<Vec<StmtNode>>),
    For(String, ExprNode, Vec<StmtNode>),
    Match(ExprNode, Vec<(ExprNode, Vec<StmtNode>)>)
}

enum ExprNode {
    IntLiteral(i64),
    FloatLiteral(f64),
    StringLiteral(String),
    BoolLiteral(bool),
    Identifier(String),
    BinaryOp(Box<ExprNode>, String, Box<ExprNode>),
    Call(String, Vec<ExprNode>),
    FieldAccess(Box<ExprNode>, String),
    ArrayAccess(Box<ExprNode>, Box<ExprNode>)
}

// ==============================================================================
// PARSER
// ==============================================================================

struct Parser {
    tokens: Vec<Token>,
    current: usize
}

impl Parser {
    fn parse(&mut self) -> Result<ModuleNode, String> {
        let mut items: Vec<AstNode> = Vec::new()

        while !self.is_at_end() {
            match self.peek().token_type {
                TokenType::Fn => items.push(self.parse_function()?),
                TokenType::Struct => items.push(self.parse_struct()?),
                TokenType::Enum => items.push(self.parse_enum()?),
                _ => {
                    self.advance()
                }
            }
        }

        Ok(ModuleNode {
            name: "main".to_string(),
            items
        })
    }

    fn parse_function(&mut self) -> Result<AstNode, String> {
        self.consume(TokenType::Fn, "Expected 'fn'")?

        let name = self.parse_identifier()?
        self.consume(TokenType::LeftParen, "Expected '('")?

        let parameters = self.parse_param_list()?

        self.consume(TokenType::RightParen, "Expected ')'")?
        self.consume(TokenType::Arrow, "Expected '->'")?

        let return_type = self.parse_identifier()?
        self.consume(TokenType::LeftBrace, "Expected '{'")?

        let body = self.parse_block()?

        self.consume(TokenType::RightBrace, "Expected '}'")?

        Ok(AstNode::Function(FunctionNode {
            name,
            parameters,
            return_type,
            body,
            is_async: false
        }))
    }

    fn parse_struct(&mut self) -> Result<AstNode, String> {
        self.consume(TokenType::Struct, "Expected 'struct'")?

        let name = self.parse_identifier()?
        self.consume(TokenType::LeftBrace, "Expected '{'")?

        let mut fields: Vec<(String, String)> = Vec::new()

        while !self.check(TokenType::RightBrace) && !self.is_at_end() {
            let field_name = self.parse_identifier()?
            self.consume(TokenType::Colon, "Expected ':'")?
            let field_type = self.parse_identifier()?

            fields.push((field_name, field_type))

            if !self.check(TokenType::RightBrace) {
                self.consume(TokenType::Comma, "Expected ',' or '}'")?
            }
        }

        self.consume(TokenType::RightBrace, "Expected '}'")?

        Ok(AstNode::Struct(StructNode {
            name,
            fields
        }))
    }

    fn parse_enum(&mut self) -> Result<AstNode, String> {
        self.consume(TokenType::Enum, "Expected 'enum'")?

        let name = self.parse_identifier()?
        self.consume(TokenType::LeftBrace, "Expected '{'")?

        let mut variants: Vec<String> = Vec::new()

        while !self.check(TokenType::RightBrace) && !self.is_at_end() {
            let variant = self.parse_identifier()?
            variants.push(variant)

            if !self.check(TokenType::RightBrace) {
                self.consume(TokenType::Comma, "Expected ',' or '}'")?
            }
        }

        self.consume(TokenType::RightBrace, "Expected '}'")?

        Ok(AstNode::Enum(EnumNode {
            name,
            variants
        }))
    }

    fn parse_param_list(&mut self) -> Result<Vec<(String, String)>, String> {
        let mut params: Vec<(String, String)> = Vec::new()

        while !self.check(TokenType::RightParen) && !self.is_at_end() {
            let param_name = self.parse_identifier()?
            self.consume(TokenType::Colon, "Expected ':'")?
            let param_type = self.parse_identifier()?

            params.push((param_name, param_type))

            if !self.check(TokenType::RightParen) {
                self.consume(TokenType::Comma, "Expected ',' or ')'")?
            }
        }

        Ok(params)
    }

    fn parse_block(&mut self) -> Result<Vec<StmtNode>, String> {
        let mut statements: Vec<StmtNode> = Vec::new()

        while !self.check(TokenType::RightBrace) && !self.is_at_end() {
            statements.push(self.parse_statement()?)
        }

        Ok(statements)
    }

    fn parse_statement(&mut self) -> Result<StmtNode, String> {
        match self.peek().token_type {
            TokenType::Let => self.parse_let(),
            TokenType::Return => self.parse_return(),
            TokenType::If => self.parse_if(),
            TokenType::For => self.parse_for(),
            TokenType::Match => self.parse_match(),
            _ => {
                let expr = self.parse_expression()?
                self.consume(TokenType::Semicolon, "Expected ';'")?
                Ok(StmtNode::Expression(expr))
            }
        }
    }

    fn parse_let(&mut self) -> Result<StmtNode, String> {
        self.consume(TokenType::Let, "Expected 'let'")?
        let name = self.parse_identifier()?
        self.consume(TokenType::Equal, "Expected '='")?
        let expr = self.parse_expression()?
        self.consume(TokenType::Semicolon, "Expected ';'")?

        Ok(StmtNode::Let(name, expr))
    }

    fn parse_return(&mut self) -> Result<StmtNode, String> {
        self.consume(TokenType::Return, "Expected 'return'")?

        if self.check(TokenType::Semicolon) {
            self.consume(TokenType::Semicolon, "Expected ';'")?
            Ok(StmtNode::Return(None))
        } else {
            let expr = self.parse_expression()?
            self.consume(TokenType::Semicolon, "Expected ';'")?
            Ok(StmtNode::Return(Some(expr)))
        }
    }

    fn parse_if(&mut self) -> Result<StmtNode, String> {
        self.consume(TokenType::If, "Expected 'if'")?
        let condition = self.parse_expression()?
        self.consume(TokenType::LeftBrace, "Expected '{'")?
        let then_block = self.parse_block()?
        self.consume(TokenType::RightBrace, "Expected '}'")?

        let else_block = if self.check(TokenType::Else) {
            self.consume(TokenType::Else, "Expected 'else'")?
            self.consume(TokenType::LeftBrace, "Expected '{'")?
            let block = self.parse_block()?
            self.consume(TokenType::RightBrace, "Expected '}'")?
            Some(block)
        } else {
            None
        }

        Ok(StmtNode::If(condition, then_block, else_block))
    }

    fn parse_for(&mut self) -> Result<StmtNode, String> {
        self.consume(TokenType::For, "Expected 'for'")?
        let var = self.parse_identifier()?

        if self.peek().lexeme != "in" {
            return Err("Expected 'in' keyword in for loop".to_string())
        }
        self.advance()

        let iter = self.parse_expression()?
        self.consume(TokenType::LeftBrace, "Expected '{'")?
        let body = self.parse_block()?
        self.consume(TokenType::RightBrace, "Expected '}'")?

        Ok(StmtNode::For(var, iter, body))
    }

    fn parse_match(&mut self) -> Result<StmtNode, String> {
        self.consume(TokenType::Match, "Expected 'match'")?
        let expr = self.parse_expression()?
        self.consume(TokenType::LeftBrace, "Expected '{'")?

        let mut arms: Vec<(ExprNode, Vec<StmtNode>)> = Vec::new()

        while !self.check(TokenType::RightBrace) && !self.is_at_end() {
            let pattern = self.parse_expression()?
            self.consume(TokenType::FatArrow, "Expected '=>'")?
            self.consume(TokenType::LeftBrace, "Expected '{'")?
            let statements = self.parse_block()?
            self.consume(TokenType::RightBrace, "Expected '}'")?

            arms.push((pattern, statements))

            if !self.check(TokenType::RightBrace) {
                self.consume(TokenType::Comma, "Expected ',' or '}'")?
            }
        }

        self.consume(TokenType::RightBrace, "Expected '}'")?

        Ok(StmtNode::Match(expr, arms))
    }

    fn parse_expression(&mut self) -> Result<ExprNode, String> {
        self.parse_binary_expression(0)
    }

    fn parse_binary_expression(&mut self, min_precedence: i32) -> Result<ExprNode, String> {
        let mut left = self.parse_primary()?

        while !self.is_at_end() {
            let op = match &self.peek().token_type {
                TokenType::Plus => "+",
                TokenType::Minus => "-",
                TokenType::Star => "*",
                TokenType::Slash => "/",
                TokenType::EqualEqual => "==",
                TokenType::NotEqual => "!=",
                TokenType::Less => "<",
                TokenType::Greater => ">",
                _ => break
            }

            let precedence = self.get_precedence(op)
            if precedence < min_precedence {
                break
            }

            self.advance()
            let right = self.parse_binary_expression(precedence + 1)?

            left = ExprNode::BinaryOp(Box::new(left), op.to_string(), Box::new(right))
        }

        Ok(left)
    }

    fn parse_primary(&mut self) -> Result<ExprNode, String> {
        match &self.peek().token_type {
            TokenType::IntLiteral(val) => {
                let v = *val
                self.advance()
                Ok(ExprNode::IntLiteral(v))
            },
            TokenType::FloatLiteral(val) => {
                let v = *val
                self.advance()
                Ok(ExprNode::FloatLiteral(v))
            },
            TokenType::StringLiteral(val) => {
                let v = val.clone()
                self.advance()
                Ok(ExprNode::StringLiteral(v))
            },
            TokenType::BoolLiteral(val) => {
                let v = *val
                self.advance()
                Ok(ExprNode::BoolLiteral(v))
            },
            TokenType::Identifier(name) => {
                let n = name.clone()
                self.advance()

                if self.check(TokenType::LeftParen) {
                    self.advance()
                    let mut args: Vec<ExprNode> = Vec::new()

                    while !self.check(TokenType::RightParen) && !self.is_at_end() {
                        args.push(self.parse_expression()?)
                        if !self.check(TokenType::RightParen) {
                            self.consume(TokenType::Comma, "Expected ',' or ')'")?
                        }
                    }

                    self.consume(TokenType::RightParen, "Expected ')'")?
                    Ok(ExprNode::Call(n, args))
                } else {
                    Ok(ExprNode::Identifier(n))
                }
            },
            TokenType::LeftParen => {
                self.advance()
                let expr = self.parse_expression()?
                self.consume(TokenType::RightParen, "Expected ')'")?
                Ok(expr)
            },
            _ => Err(format!("Unexpected token: {:?}", self.peek().token_type))
        }
    }

    fn parse_identifier(&mut self) -> Result<String, String> {
        match &self.peek().token_type {
            TokenType::Identifier(name) => {
                let n = name.clone()
                self.advance()
                Ok(n)
            },
            _ => Err("Expected identifier".to_string())
        }
    }

    fn get_precedence(&self, op: &str) -> i32 {
        match op {
            "==" | "!=" => 1,
            "<" | ">" => 2,
            "+" | "-" => 3,
            "*" | "/" => 4,
            _ => 0
        }
    }

    fn peek(&self) -> &Token {
        self.tokens.get(self.current).unwrap_or(&Token {
            token_type: TokenType::Eof,
            line: 0,
            column: 0,
            lexeme: "".to_string()
        })
    }

    fn advance(&mut self) {
        self.current += 1
    }

    fn check(&self, token_type: TokenType) -> bool {
        match (&self.peek().token_type, &token_type) {
            (TokenType::Fn, TokenType::Fn) => true,
            (TokenType::Let, TokenType::Let) => true,
            (TokenType::RightBrace, TokenType::RightBrace) => true,
            (TokenType::RightParen, TokenType::RightParen) => true,
            (TokenType::LeftParen, TokenType::LeftParen) => true,
            (TokenType::LeftBrace, TokenType::LeftBrace) => true,
            (TokenType::Semicolon, TokenType::Semicolon) => true,
            (TokenType::Comma, TokenType::Comma) => true,
            (TokenType::Colon, TokenType::Colon) => true,
            (TokenType::Equal, TokenType::Equal) => true,
            (TokenType::Arrow, TokenType::Arrow) => true,
            (TokenType::FatArrow, TokenType::FatArrow) => true,
            (TokenType::Struct, TokenType::Struct) => true,
            (TokenType::Enum, TokenType::Enum) => true,
            (TokenType::Else, TokenType::Else) => true,
            _ => false
        }
    }

    fn consume(&mut self, token_type: TokenType, message: &str) -> Result<(), String> {
        if self.check(token_type) {
            self.advance()
            Ok(())
        } else {
            Err(format!("{} at line {}", message, self.peek().line))
        }
    }

    fn is_at_end(&self) -> bool {
        matches!(self.peek().token_type, TokenType::Eof)
    }
}

// ==============================================================================
// TYPE INFERENCE
// ==============================================================================

struct TypeChecker {
    types: HashMap<String, String>
}

impl TypeChecker {
    fn infer_type(&self, expr: &ExprNode) -> Result<String, String> {
        match expr {
            ExprNode::IntLiteral(_) => Ok("i64".to_string()),
            ExprNode::FloatLiteral(_) => Ok("f64".to_string()),
            ExprNode::StringLiteral(_) => Ok("String".to_string()),
            ExprNode::BoolLiteral(_) => Ok("bool".to_string()),
            ExprNode::Identifier(name) => {
                self.types.get(name).cloned().ok_or(format!("Type of {} not found", name))
            },
            ExprNode::BinaryOp(left, op, right) => {
                let left_type = self.infer_type(left)?
                let right_type = self.infer_type(right)?

                if left_type != right_type {
                    return Err(format!("Type mismatch: {} and {}", left_type, right_type))
                }

                match op.as_str() {
                    "+" | "-" | "*" | "/" => Ok(left_type),
                    "==" | "!=" | "<" | ">" => Ok("bool".to_string()),
                    _ => Err(format!("Unknown operator: {}", op))
                }
            },
            _ => Err("Cannot infer type".to_string())
        }
    }
}

// ==============================================================================
// PUBLIC COMPILER FUNCTION
// ==============================================================================

pub actor TitanFrontendCompiler {
    code: String = String::new()

    message Compile(source_code: String) -> Result<ModuleNode, String> {
        // Lexing phase
        let mut lexer = Lexer {
            input: source_code.clone(),
            position: 0,
            line: 1,
            column: 0,
            tokens: Vec::new()
        }

        let tokens = lexer.tokenize()?

        // Parsing phase
        let mut parser = Parser {
            tokens,
            current: 0
        }

        let module = parser.parse()?

        Ok(module)
    }
}

async fn test_titan_frontend() -> Result<(), String> {
    let code = r#"
        fn add(a: i64, b: i64) -> i64 {
            return a + b;
        }
    "#.to_string()

    let compiler: ActorRef<TitanFrontendCompiler> = spawn(TitanFrontendCompiler {
        code: String::new()
    })

    let module = await compiler.call(TitanFrontendCompiler::Compile(code))?

    println("Successfully compiled module: {}", module.name)
    println("Items: {}", module.items.len())

    Ok(())
}
