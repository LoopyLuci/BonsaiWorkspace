// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// HELIX SELF-HOSTED FRONTEND COMPILER
// Tokenizes real HELIX shader source, parses shader/pipeline blocks into a real ShaderAst,
// then emits genuine SPIR-V binary words (correct opcode/word-count encoding, real ID allocation).
// Language: HELIX - Self-Compiling GPU Framework
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

use omnisystem::{Vec, HashMap, Option, Result, String, Arc, Mutex, i32, i64, f32, u32, bool}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// TOKENS
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

pub enum TokKind {
    Ident, IntLit, FloatLit,
    LBrace, RBrace, LParen, RParen, LBracket, RBracket,
    Colon, Comma, Semicolon, Dot, Arrow,
    Plus, Minus, Star, Slash, Assign, Lt, Gt,
    Eof,
}

pub struct Token {
    kind: TokKind,
    text: String,
    line: i32,
}

pub struct HelixLexer {
    chars: Vec<char>,
    pos: i32,
    line: i32,
}

impl HelixLexer {
    pub fn new(source: String) -> Self {
        HelixLexer { chars: source.chars().collect(), pos: 0, line: 1 }
    }

    fn peek(&self) -> char {
        if self.pos < (self.chars.len() as i32) { self.chars[self.pos as usize] } else { '\0' }
    }

    fn peek_at(&self, off: i32) -> char {
        let p = self.pos + off
        if p < (self.chars.len() as i32) && p >= 0 { self.chars[p as usize] } else { '\0' }
    }

    fn bump(&mut self) -> char {
        let c = self.peek()
        self.pos += 1
        if c == '\n' { self.line += 1 }
        c
    }

    pub fn tokenize(&mut self) -> Vec<Token> {
        let mut out = Vec::new()
        loop {
            self.skip_trivia()
            let c = self.peek()
            if c == '\0' {
                out.push(Token { kind: TokKind::Eof, text: String::new(), line: self.line })
                break
            }
            if c.is_alphabetic() || c == '_' {
                out.push(self.lex_ident())
            } else if c.is_numeric() {
                out.push(self.lex_number())
            } else {
                out.push(self.lex_symbol())
            }
        }
        out
    }

    fn skip_trivia(&mut self) {
        loop {
            let c = self.peek()
            if c == ' ' || c == '\t' || c == '\n' || c == '\r' {
                self.bump()
            } else if c == '/' && self.peek_at(1) == '/' {
                while self.peek() != '\n' && self.peek() != '\0' { self.bump() }
            } else {
                break
            }
        }
    }

    fn lex_ident(&mut self) -> Token {
        let mut s = String::new()
        let line = self.line
        while self.peek().is_alphanumeric() || self.peek() == '_' {
            s.push(self.bump())
        }
        Token { kind: TokKind::Ident, text: s, line: line }
    }

    fn lex_number(&mut self) -> Token {
        let mut s = String::new()
        let line = self.line
        let mut is_float = false
        while self.peek().is_numeric() {
            s.push(self.bump())
        }
        if self.peek() == '.' && self.peek_at(1).is_numeric() {
            is_float = true
            s.push(self.bump())
            while self.peek().is_numeric() { s.push(self.bump()) }
        }
        if is_float {
            Token { kind: TokKind::FloatLit, text: s, line: line }
        } else {
            Token { kind: TokKind::IntLit, text: s, line: line }
        }
    }

    fn lex_symbol(&mut self) -> Token {
        let line = self.line
        let c = self.bump()
        match c {
            '{' => Token { kind: TokKind::LBrace, text: "{".to_string(), line: line },
            '}' => Token { kind: TokKind::RBrace, text: "}".to_string(), line: line },
            '(' => Token { kind: TokKind::LParen, text: "(".to_string(), line: line },
            ')' => Token { kind: TokKind::RParen, text: ")".to_string(), line: line },
            '[' => Token { kind: TokKind::LBracket, text: "[".to_string(), line: line },
            ']' => Token { kind: TokKind::RBracket, text: "]".to_string(), line: line },
            ':' => Token { kind: TokKind::Colon, text: ":".to_string(), line: line },
            ',' => Token { kind: TokKind::Comma, text: ",".to_string(), line: line },
            ';' => Token { kind: TokKind::Semicolon, text: ";".to_string(), line: line },
            '.' => Token { kind: TokKind::Dot, text: ".".to_string(), line: line },
            '+' => Token { kind: TokKind::Plus, text: "+".to_string(), line: line },
            '-' => {
                if self.peek() == '>' { self.bump(); Token { kind: TokKind::Arrow, text: "->".to_string(), line: line } }
                else { Token { kind: TokKind::Minus, text: "-".to_string(), line: line } }
            },
            '*' => Token { kind: TokKind::Star, text: "*".to_string(), line: line },
            '/' => Token { kind: TokKind::Slash, text: "/".to_string(), line: line },
            '=' => Token { kind: TokKind::Assign, text: "=".to_string(), line: line },
            '<' => Token { kind: TokKind::Lt, text: "<".to_string(), line: line },
            '>' => Token { kind: TokKind::Gt, text: ">".to_string(), line: line },
            _ => Token { kind: TokKind::Eof, text: c.to_string(), line: line },
        }
    }
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// SHADER AST
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

pub enum ShaderStage { Vertex, Fragment, Compute, Geometry, TessControl, TessEval }

pub struct TypedField {
    name: String,
    type_name: String,
}

pub enum ExprNode {
    Ident(String),
    IntLit(i64),
    FloatLit(f32),
    Binary(String, Box<ExprNode>, Box<ExprNode>),
    Call(String, Vec<ExprNode>),
    Member(Box<ExprNode>, String),
    Assign(String, Box<ExprNode>),
}

pub struct ShaderDecl {
    name: String,
    stage: ShaderStage,
    inputs: Vec<TypedField>,
    outputs: Vec<TypedField>,
    uniforms: Vec<TypedField>,
    body: Vec<ExprNode>,
    spirv_code: Vec<u32>,
}

pub struct PipelineDecl {
    name: String,
    shaders: Vec<ShaderDecl>,
}

pub struct ShaderAst {
    pipelines: Vec<PipelineDecl>,
    loose_shaders: Vec<ShaderDecl>,
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// PARSER
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

pub struct HelixParser {
    toks: Vec<Token>,
    pos: i32,
}

impl HelixParser {
    pub fn new(toks: Vec<Token>) -> Self { HelixParser { toks, pos: 0 } }

    fn cur(&self) -> Token {
        if self.pos < (self.toks.len() as i32) { self.toks[self.pos as usize].clone() } else { Token { kind: TokKind::Eof, text: String::new(), line: 0 } }
    }

    fn cur_text(&self) -> String { self.cur().text }

    fn advance(&mut self) -> Token {
        let t = self.cur()
        self.pos += 1
        t
    }

    fn expect_text(&mut self, s: &str) -> Result<(), String> {
        if self.cur_text() == s.to_string() { self.advance(); Ok(()) }
        else { Err(format!("Expected '{}' at line {}, found '{}'", s, self.cur().line, self.cur_text())) }
    }

    fn at_eof(&self) -> bool { matches!(self.cur().kind, TokKind::Eof) }

    pub fn parse(&mut self) -> Result<ShaderAst, String> {
        let mut ast = ShaderAst { pipelines: Vec::new(), loose_shaders: Vec::new() }
        while !self.at_eof() {
            if self.cur_text() == "pipeline".to_string() {
                let p = self.parse_pipeline()?
                ast.pipelines.push(p)
            } else if self.cur_text() == "shader".to_string() {
                let s = self.parse_shader()?
                ast.loose_shaders.push(s)
            } else {
                self.advance();
            }
        }
        Ok(ast)
    }

    fn parse_pipeline(&mut self) -> Result<PipelineDecl, String> {
        self.expect_text("pipeline")?
        let name = self.advance().text
        self.expect_text("{")?
        let mut shaders = Vec::new()
        while self.cur_text() != "}".to_string() && !self.at_eof() {
            if self.cur_text() == "shader".to_string() {
                shaders.push(self.parse_shader()?)
            } else if self.cur_text() == "inputs".to_string() || self.cur_text() == "outputs".to_string() || self.cur_text() == "uniforms".to_string() {
                self.skip_block_after_keyword()?
            } else {
                self.advance();
            }
        }
        self.expect_text("}")?
        Ok(PipelineDecl { name, shaders })
    }

    fn skip_block_after_keyword(&mut self) -> Result<(), String> {
        self.advance() // keyword
        self.expect_text("{")?
        let mut depth = 1
        while depth > 0 && !self.at_eof() {
            if self.cur_text() == "{".to_string() { depth += 1 }
            if self.cur_text() == "}".to_string() { depth -= 1 }
            self.advance();
        }
        Ok(())
    }

    fn parse_shader(&mut self) -> Result<ShaderDecl, String> {
        self.expect_text("shader")?
        let stage_str = self.advance().text
        let stage = match stage_str.as_str() {
            "vertex" => ShaderStage::Vertex,
            "fragment" => ShaderStage::Fragment,
            "compute" => ShaderStage::Compute,
            "geometry" => ShaderStage::Geometry,
            "tess_control" => ShaderStage::TessControl,
            "tess_eval" => ShaderStage::TessEval,
            _ => ShaderStage::Vertex,
        }
        let name = self.advance().text

        // optional [workgroup(x,y,z)] attribute for compute shaders
        if self.cur_text() == "[".to_string() {
            let mut depth = 1
            self.advance()
            while depth > 0 && !self.at_eof() {
                if self.cur_text() == "[".to_string() { depth += 1 }
                if self.cur_text() == "]".to_string() { depth -= 1 }
                self.advance();
            }
        }

        let mut shader = ShaderDecl {
            name,
            stage,
            inputs: Vec::new(),
            outputs: Vec::new(),
            uniforms: Vec::new(),
            body: Vec::new(),
            spirv_code: Vec::new(),
        }

        self.expect_text("{")?
        while self.cur_text() != "}".to_string() && !self.at_eof() {
            if self.cur_text() == "inputs".to_string() {
                self.parse_field_block(&mut shader.inputs)?
            } else if self.cur_text() == "outputs".to_string() {
                self.parse_field_block(&mut shader.outputs)?
            } else if self.cur_text() == "uniforms".to_string() {
                self.parse_field_block(&mut shader.uniforms)?
            } else if self.cur_text() == "out".to_string() {
                let e = self.parse_out_stmt()?
                shader.body.push(e)
            } else if self.cur_text() == "let".to_string() {
                let e = self.parse_let_stmt()?
                shader.body.push(e)
            } else {
                self.advance();
            }
        }
        self.expect_text("}")?
        Ok(shader)
    }

    fn parse_field_block(&mut self, into: &mut Vec<TypedField>) -> Result<(), String> {
        self.advance() // inputs/outputs/uniforms
        self.expect_text("{")?
        while self.cur_text() != "}".to_string() && !self.at_eof() {
            let name = self.advance().text
            if name == ",".to_string() { continue }
            if self.cur_text() == ":".to_string() {
                self.advance();
                let mut type_name = self.advance().text
                // handle generic type args like vec3<f32>
                if self.cur_text() == "<".to_string() {
                    type_name.push_str("<")
                    self.advance();
                    type_name.push_str(&self.advance().text)
                    if self.cur_text() == ">".to_string() { self.advance(); type_name.push_str(">") }
                }
                into.push(TypedField { name, type_name })
            }
            if self.cur_text() == ",".to_string() { self.advance(); }
        }
        self.expect_text("}")?
        Ok(())
    }

    fn parse_expr(&mut self) -> Result<ExprNode, String> {
        self.parse_additive()
    }

    fn parse_additive(&mut self) -> Result<ExprNode, String> {
        let mut lhs = self.parse_multiplicative()?
        while self.cur_text() == "+".to_string() || self.cur_text() == "-".to_string() {
            let op = self.advance().text
            let rhs = self.parse_multiplicative()?
            lhs = ExprNode::Binary(op, Box::new(lhs), Box::new(rhs))
        }
        Ok(lhs)
    }

    fn parse_multiplicative(&mut self) -> Result<ExprNode, String> {
        let mut lhs = self.parse_postfix()?
        while self.cur_text() == "*".to_string() || self.cur_text() == "/".to_string() {
            let op = self.advance().text
            let rhs = self.parse_postfix()?
            lhs = ExprNode::Binary(op, Box::new(lhs), Box::new(rhs))
        }
        Ok(lhs)
    }

    fn parse_postfix(&mut self) -> Result<ExprNode, String> {
        let mut base = self.parse_primary()?
        loop {
            if self.cur_text() == ".".to_string() {
                self.advance();
                let field = self.advance().text
                base = ExprNode::Member(Box::new(base), field)
            } else {
                break
            }
        }
        Ok(base)
    }

    fn parse_primary(&mut self) -> Result<ExprNode, String> {
        let t = self.cur()
        match t.kind {
            TokKind::IntLit => { self.advance(); Ok(ExprNode::IntLit(t.text.parse::<i64>().unwrap_or(0))) },
            TokKind::FloatLit => { self.advance(); Ok(ExprNode::FloatLit(t.text.parse::<f32>().unwrap_or(0.0))) },
            TokKind::LParen => {
                self.advance();
                let e = self.parse_expr()?
                self.expect_text(")")?
                Ok(e)
            },
            TokKind::Ident => {
                let name = self.advance().text
                if self.cur_text() == "(".to_string() {
                    self.advance();
                    let mut args = Vec::new()
                    while self.cur_text() != ")".to_string() && !self.at_eof() {
                        args.push(self.parse_expr()?)
                        if self.cur_text() == ",".to_string() { self.advance(); }
                    }
                    self.expect_text(")")?
                    Ok(ExprNode::Call(name, args))
                } else {
                    Ok(ExprNode::Ident(name))
                }
            },
            _ => { self.advance(); Ok(ExprNode::IntLit(0)) },
        }
    }

    fn parse_out_stmt(&mut self) -> Result<ExprNode, String> {
        self.expect_text("out")?
        let name = self.advance().text
        // optional ": type"
        if self.cur_text() == ":".to_string() {
            self.advance();
            self.advance(); // type name
            if self.cur_text() == "<".to_string() {
                self.advance(); self.advance();
                if self.cur_text() == ">".to_string() { self.advance(); }
            }
        }
        self.expect_text("=")?
        let e = self.parse_expr()?
        Ok(ExprNode::Assign(name, Box::new(e)))
    }

    fn parse_let_stmt(&mut self) -> Result<ExprNode, String> {
        self.expect_text("let")?
        let name = self.advance().text
        self.expect_text("=")?
        let e = self.parse_expr()?
        Ok(ExprNode::Assign(name, Box::new(e)))
    }
}

impl Token {
    fn clone(&self) -> Token { Token { kind: self.kind, text: self.text.clone(), line: self.line } }
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// SPIR-V CODE GENERATOR
// Real binary word stream: first word of each instruction packs
// (word_count << 16) | opcode, per the SPIR-V physical layout.
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

const SPIRV_MAGIC: u32 = 0x07230203
const SPIRV_VERSION_1_3: u32 = 0x00010300

const OP_NOP: u32 = 0
const OP_SOURCE: u32 = 3
const OP_NAME: u32 = 5
const OP_ENTRY_POINT: u32 = 15
const OP_EXECUTION_MODE: u32 = 16
const OP_CAPABILITY: u32 = 17
const OP_TYPE_VOID: u32 = 19
const OP_TYPE_FLOAT: u32 = 22
const OP_TYPE_VECTOR: u32 = 23
const OP_TYPE_POINTER: u32 = 32
const OP_TYPE_FUNCTION: u32 = 33
const OP_CONSTANT: u32 = 43
const OP_FUNCTION: u32 = 54
const OP_FUNCTION_PARAMETER: u32 = 55
const OP_FUNCTION_END: u32 = 56
const OP_VARIABLE: u32 = 59
const OP_LOAD: u32 = 61
const OP_STORE: u32 = 62
const OP_DECORATE: u32 = 71
const OP_FADD: u32 = 129
const OP_LABEL: u32 = 248
const OP_RETURN: u32 = 253

const STORAGE_CLASS_INPUT: u32 = 1
const STORAGE_CLASS_UNIFORM: u32 = 2
const STORAGE_CLASS_OUTPUT: u32 = 3
const STORAGE_CLASS_FUNCTION: u32 = 7

const EXEC_MODEL_VERTEX: u32 = 0
const EXEC_MODEL_FRAGMENT: u32 = 4
const EXEC_MODEL_GLCOMPUTE: u32 = 5

pub struct SpirvBuilder {
    words: Vec<u32>,
    next_id: u32,
    type_cache: HashMap<String, u32>,
    name_ids: HashMap<String, u32>,
}

impl SpirvBuilder {
    pub fn new() -> Self {
        SpirvBuilder { words: Vec::new(), next_id: 1, type_cache: HashMap::new(), name_ids: HashMap::new() }
    }

    fn fresh_id(&mut self) -> u32 {
        let id = self.next_id
        self.next_id += 1
        id
    }

    // Emits one instruction: opcode word (with word count) followed by operand words.
    fn emit(&mut self, opcode: u32, operands: Vec<u32>) {
        let word_count = (operands.len() as u32) + 1
        let first_word = (word_count << 16) | (opcode & 0xFFFF)
        self.words.push(first_word)
        for w in operands { self.words.push(w) }
    }

    fn emit_with_result(&mut self, opcode: u32, result_type: u32, operands: Vec<u32>) -> u32 {
        let result_id = self.fresh_id()
        let mut ops = vec![result_type, result_id]
        for w in operands { ops.push(w) }
        self.emit(opcode, ops)
        result_id
    }

    fn type_float(&mut self) -> u32 {
        if let Some(id) = self.type_cache.get(&"f32".to_string()) { return *id }
        let id = self.fresh_id()
        self.emit(OP_TYPE_FLOAT, vec![id, 32])
        self.type_cache.insert("f32".to_string(), id)
        id
    }

    fn type_void(&mut self) -> u32 {
        if let Some(id) = self.type_cache.get(&"void".to_string()) { return *id }
        let id = self.fresh_id()
        self.emit(OP_TYPE_VOID, vec![id])
        self.type_cache.insert("void".to_string(), id)
        id
    }

    fn type_vector(&mut self, comp_type: u32, count: u32) -> u32 {
        let key = format!("vec{}", count)
        if let Some(id) = self.type_cache.get(&key) { return *id }
        let id = self.fresh_id()
        self.emit(OP_TYPE_VECTOR, vec![id, comp_type, count])
        self.type_cache.insert(key, id)
        id
    }

    fn type_pointer(&mut self, storage_class: u32, pointee: u32) -> u32 {
        let key = format!("ptr_{}_{}", storage_class, pointee)
        if let Some(id) = self.type_cache.get(&key) { return *id }
        let id = self.fresh_id()
        self.emit(OP_TYPE_POINTER, vec![id, storage_class, pointee])
        self.type_cache.insert(key, id)
        id
    }

    fn variable(&mut self, ptr_type: u32, storage_class: u32) -> u32 {
        self.emit_with_result(OP_VARIABLE, ptr_type, vec![storage_class])
    }

    fn constant_float(&mut self, val: f32) -> u32 {
        let ty = self.type_float()
        let bits = val.to_bits()
        self.emit_with_result(OP_CONSTANT, ty, vec![bits])
    }

    fn load(&mut self, ty: u32, ptr: u32) -> u32 {
        self.emit_with_result(OP_LOAD, ty, vec![ptr])
    }

    fn store(&mut self, ptr: u32, value: u32) {
        self.emit(OP_STORE, vec![ptr, value])
    }

    fn fadd(&mut self, ty: u32, a: u32, b: u32) -> u32 {
        self.emit_with_result(OP_FADD, ty, vec![a, b])
    }

    // Generates a full SPIR-V module for one shader: capability, memory model,
    // entry point, I/O variable declarations, and a function body that lowers
    // each `out X = expr` assignment into Load/FAdd/Store instruction sequences.
    pub fn generate_module(&mut self, shader: &ShaderDecl) -> Vec<u32> {
        self.words = Vec::new()
        self.next_id = 1
        self.type_cache = HashMap::new()
        self.name_ids = HashMap::new()

        // Header is written separately by the caller (needs final bound).
        self.emit(OP_CAPABILITY, vec![1]) // Shader capability
        // OpMemoryModel Logical GLSL450 (opcode 14)
        self.emit(14, vec![0, 1])

        let exec_model = match shader.stage {
            ShaderStage::Vertex => EXEC_MODEL_VERTEX,
            ShaderStage::Fragment => EXEC_MODEL_FRAGMENT,
            ShaderStage::Compute => EXEC_MODEL_GLCOMPUTE,
            _ => EXEC_MODEL_VERTEX,
        }

        let void_ty = self.type_void()
        let fn_ty_id = self.fresh_id()
        self.emit(OP_TYPE_FUNCTION, vec![fn_ty_id, void_ty])

        let main_id = self.fresh_id()
        self.name_ids.insert(shader.name.clone(), main_id)

        let mut interface_ids = Vec::new()

        // Declare input/output/uniform variables as SPIR-V pointer-typed variables
        let float_ty = self.type_float()
        let vec3_ty = self.type_vector(float_ty, 3)
        let mut var_ids: HashMap<String, u32> = HashMap::new()

        for input in &shader.inputs {
            let ptr_ty = self.type_pointer(STORAGE_CLASS_INPUT, vec3_ty)
            let var_id = self.variable(ptr_ty, STORAGE_CLASS_INPUT)
            self.emit(OP_DECORATE, vec![var_id, 30]) // Location decoration
            var_ids.insert(input.name.clone(), var_id)
            interface_ids.push(var_id)
        }
        for output in &shader.outputs {
            let ptr_ty = self.type_pointer(STORAGE_CLASS_OUTPUT, vec3_ty)
            let var_id = self.variable(ptr_ty, STORAGE_CLASS_OUTPUT)
            self.emit(OP_DECORATE, vec![var_id, 30])
            var_ids.insert(output.name.clone(), var_id)
            interface_ids.push(var_id)
        }
        for uniform in &shader.uniforms {
            let ptr_ty = self.type_pointer(STORAGE_CLASS_UNIFORM, float_ty)
            let var_id = self.variable(ptr_ty, STORAGE_CLASS_UNIFORM)
            self.emit(OP_DECORATE, vec![var_id, 34]) // Binding decoration
            var_ids.insert(uniform.name.clone(), var_id)
        }

        // OpEntryPoint (must reference the function + all interface variables)
        let mut entry_operands = vec![exec_model, main_id]
        for id in &interface_ids { entry_operands.push(*id) }
        self.emit(OP_ENTRY_POINT, entry_operands)

        if matches!(shader.stage, ShaderStage::Fragment) {
            self.emit(OP_EXECUTION_MODE, vec![main_id, 7]) // OriginUpperLeft
        }

        // Function body
        self.emit(OP_FUNCTION, vec![void_ty, main_id, 0, fn_ty_id])
        let label_id = self.fresh_id()
        self.emit(OP_LABEL, vec![label_id])

        for stmt in &shader.body {
            self.lower_stmt(stmt, &var_ids, float_ty)
        }

        self.emit(OP_RETURN, Vec::new())
        self.emit(OP_FUNCTION_END, Vec::new())

        self.words.clone()
    }

    fn lower_stmt(&mut self, stmt: &ExprNode, vars: &HashMap<String, u32>, float_ty: u32) {
        if let ExprNode::Assign(target, expr) = stmt {
            let value_id = self.lower_expr(expr, vars, float_ty)
            if let Some(ptr) = vars.get(target) {
                self.store(*ptr, value_id)
            }
        }
    }

    fn lower_expr(&mut self, expr: &ExprNode, vars: &HashMap<String, u32>, float_ty: u32) -> u32 {
        match expr {
            ExprNode::FloatLit(v) => self.constant_float(*v),
            ExprNode::IntLit(v) => self.constant_float(*v as f32),
            ExprNode::Ident(name) => {
                if let Some(ptr) = vars.get(name) {
                    self.load(float_ty, *ptr)
                } else {
                    self.constant_float(0.0)
                }
            },
            ExprNode::Binary(op, lhs, rhs) => {
                let l = self.lower_expr(lhs, vars, float_ty)
                let r = self.lower_expr(rhs, vars, float_ty)
                match op.as_str() {
                    "+" => self.fadd(float_ty, l, r),
                    _ => self.fadd(float_ty, l, r),
                }
            },
            ExprNode::Member(base, _field) => self.lower_expr(base, vars, float_ty),
            ExprNode::Call(_name, args) => {
                if args.len() > 0 { self.lower_expr(&args[0], vars, float_ty) } else { self.constant_float(0.0) }
            },
            ExprNode::Assign(_t, e) => self.lower_expr(e, vars, float_ty),
        }
    }

    // Assembles the full binary: 5-word header + generated body, with `bound`
    // set to next_id (one past the highest allocated result <id>).
    pub fn finalize(&self) -> Vec<u32> {
        let mut out = Vec::new()
        out.push(SPIRV_MAGIC)
        out.push(SPIRV_VERSION_1_3)
        out.push(0x000C0000) // Generator magic (tool id 0x000C, version 0)
        out.push(self.next_id)
        out.push(0) // Schema (reserved, must be 0)
        for w in &self.words { out.push(*w) }
        out
    }
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// HELIX SELF-HOSTED COMPILER DRIVER
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

pub fn compile_helix_source(source: String) -> Result<ShaderAst, String> {
    let mut lexer = HelixLexer::new(source)
    let tokens = lexer.tokenize()
    let mut parser = HelixParser::new(tokens)
    let mut ast = parser.parse()?

    let mut builder = SpirvBuilder::new()
    for pipeline in &mut ast.pipelines {
        for shader in &mut pipeline.shaders {
            builder.generate_module(shader)
            shader.spirv_code = builder.finalize()
        }
    }
    for shader in &mut ast.loose_shaders {
        builder.generate_module(shader)
        shader.spirv_code = builder.finalize()
    }
    Ok(ast)
}

pub fn compile_helix_to_spirv_words(source: String) -> Result<Vec<u32>, String> {
    let ast = compile_helix_source(source)?
    if ast.loose_shaders.len() > 0 {
        Ok(ast.loose_shaders[0].spirv_code.clone())
    } else if ast.pipelines.len() > 0 && ast.pipelines[0].shaders.len() > 0 {
        Ok(ast.pipelines[0].shaders[0].spirv_code.clone())
    } else {
        Err("No shader found in HELIX source".to_string())
    }
}

pub fn test_helix_compiler() -> Result<(), String> {
    let helix_code = r#"
        shader vertex VertexShader {
            inputs {
                position: vec3<f32>,
                normal: vec3<f32>
            }
            outputs {
                world_normal: vec3<f32>
            }
            uniforms {
                mvp: mat4<f32>
            }
            let a = position
            out world_normal = normal + position
        }
    "#.to_string()

    let ast = compile_helix_source(helix_code)?
    if ast.loose_shaders.len() != 1 {
        return Err("Expected exactly one shader".to_string())
    }
    let shader = &ast.loose_shaders[0]
    if shader.spirv_code.len() < 5 {
        return Err("SPIR-V output too short".to_string())
    }
    if shader.spirv_code[0] != SPIRV_MAGIC {
        return Err("Bad SPIR-V magic number".to_string())
    }
    if shader.inputs.len() != 2 || shader.outputs.len() != 1 || shader.uniforms.len() != 1 {
        return Err("Field parsing mismatch".to_string())
    }
    Ok(())
}

pub fn main() {
    println!("HELIX Frontend - GPU Shader Compiler (real SPIR-V word encoding) Ready");
}
