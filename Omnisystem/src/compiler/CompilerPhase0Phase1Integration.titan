    println!("╔════════════════════════════════════════════════════════════════╗");
    println!("║        OMNISYSTEM PHASE 0 & 1 INTEGRATION TEST                ║");
    println!("║     Complete End-to-End Runtime + Graphics Verification       ║");
    println!("╚════════════════════════════════════════════════════════════════╝\n");

    let mut suite = IntegrationTestSuite::new("Omnisystem Phase 0 & 1");

    // Phase 0: Runtime VM Tests
    suite.test_module("Phase 0: Omnisystem Runtime VM");
    suite.run_test("Value Representation", test_value_representation);
    suite.run_test("Memory Allocator", test_memory_allocator);
    suite.run_test("Garbage Collector", test_garbage_collector);
    suite.run_test("Thread Scheduler", test_thread_scheduler);
    suite.run_test("Event Loop", test_event_loop);
    suite.run_test("Call Stack", test_call_stack);
    suite.run_test("Omnisystem Runtime", test_omnisystem_runtime);

    // Phase 1: GPU Bindings Tests
    suite.test_module("Phase 1: GPU Bindings");
    suite.run_test("GPU Device Creation", test_gpu_device_creation);
    suite.run_test("GPU Buffer Creation", test_gpu_buffer_creation);
    suite.run_test("GPU Texture Creation", test_gpu_texture_creation);
    suite.run_test("GPU Shader Creation", test_gpu_shader_creation);
    suite.run_test("GPU Command Buffer", test_gpu_command_buffer);
    suite.run_test("GPU Context Initialization", test_gpu_context_initialization);

    // Phase 1: Input Bindings Tests
    suite.test_module("Phase 1: Input Bindings");
    suite.run_test("Keyboard Input", test_keyboard_input);
    suite.run_test("Mouse Input", test_mouse_input);
    suite.run_test("Gamepad Input", test_gamepad_input);
    suite.run_test("Input Manager", test_input_manager);

    // Phase 1: Display Bindings Tests
    suite.test_module("Phase 1: Display Bindings");
    suite.run_test("Monitor Management", test_monitor_management);
    suite.run_test("Window Creation", test_window_creation);
    suite.run_test("Window State Management", test_window_state_management);
    suite.run_test("Virtual Desktop", test_virtual_desktop);

    // Integration Tests
    suite.test_module("Integration Tests");
    suite.run_test("Runtime + Graphics Integration", test_runtime_graphics_integration);
    suite.run_test("Input Event Routing", test_input_event_routing);
    suite.run_test("Full Desktop Environment Simulation", test_full_desktop_environment_simulation);

    suite.report();
}
