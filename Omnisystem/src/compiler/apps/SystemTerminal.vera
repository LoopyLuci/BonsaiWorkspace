use std::collections::VecDeque;

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum ShellType {
    Bash,
    Zsh,
    Fish,
    PowerShell,
}

#[derive(Clone, Debug)]
pub struct CommandResult {
    pub exit_code: i32,
    pub stdout: String,
    pub stderr: String,
}

pub struct CommandHistory {
    pub commands: VecDeque<String>,
    pub current_index: Option<usize>,
    pub max_size: usize,
}

impl CommandHistory {
    pub fn new(max_size: usize) -> Self {
        CommandHistory {
            commands: VecDeque::new(),
            current_index: None,
            max_size,
        }
    }

    pub fn add(&mut self, command: String) {
        self.commands.push_back(command);
        if self.commands.len() > self.max_size {
            self.commands.pop_front();
        }
        self.current_index = None;
    }

    pub fn previous(&mut self) -> Option<String> {
        if self.commands.is_empty() {
            return None;
        }

        let index = match self.current_index {
            None => self.commands.len() - 1,
            Some(i) if i > 0 => i - 1,
            Some(i) => i,
        };

        self.current_index = Some(index);
        self.commands.get(index).cloned()
    }

    pub fn next(&mut self) -> Option<String> {
        if let Some(index) = self.current_index {
            if index + 1 < self.commands.len() {
                self.current_index = Some(index + 1);
                self.commands.get(index + 1).cloned()
            } else {
                self.current_index = None;
                Some(String::new())
            }
        } else {
            None
        }
    }

    pub fn search(&self, pattern: &str) -> Vec<String> {
        self.commands.iter()
            .filter(|cmd| cmd.contains(pattern))
            .cloned()
            .collect()
    }
}

pub struct ShellSession {
    pub session_id: u32,
    pub shell: ShellType,
    pub current_dir: String,
    pub environment: std::collections::HashMap<String, String>,
    pub is_running: bool,
}

impl ShellSession {
    pub fn new(session_id: u32, shell: ShellType) -> Self {
        ShellSession {
            session_id,
            shell,
            current_dir: "/home/omnisystem".to_string(),
            environment: std::collections::HashMap::new(),
            is_running: true,
        }
    }

    pub fn execute_command(&self, command: &str) -> CommandResult {
        // Simulate command execution
        match command.trim() {
            "pwd" => CommandResult {
                exit_code: 0,
                stdout: self.current_dir.clone(),
                stderr: String::new(),
            },
            "ls" | "ls -la" => CommandResult {
                exit_code: 0,
                stdout: ".\n..\nDocuments\nDownloads\nDesktop".to_string(),
                stderr: String::new(),
            },
            "whoami" => CommandResult {
                exit_code: 0,
                stdout: "omnisystem".to_string(),
                stderr: String::new(),
            },
            "date" => CommandResult {
                exit_code: 0,
                stdout: "Wed Jun 25 14:30:00 UTC 2026".to_string(),
                stderr: String::new(),
            },
            "echo"  => {
                let arg = command.strip_prefix("echo ").unwrap_or("");
                CommandResult {
                    exit_code: 0,
                    stdout: arg.to_string(),
                    stderr: String::new(),
                }
            },
            "clear" => CommandResult {
                exit_code: 0,
                stdout: String::new(),
                stderr: String::new(),
            },
            _ => CommandResult {
                exit_code: 127,
                stdout: String::new(),
                stderr: format!("Command not found: {}", command),
            },
        }
    }

    pub fn change_directory(&mut self, path: &str) -> Result<(), String> {
        self.current_dir = path.to_string();
        Ok(())
    }

    pub fn set_env(&mut self, key: &str, value: &str) {
        self.environment.insert(key.to_string(), value.to_string());
    }

    pub fn get_env(&self, key: &str) -> Option<String> {
        self.environment.get(key).cloned()
    }

    pub fn prompt(&self) -> String {
        let shell_name = match self.shell {
            ShellType::Bash => "bash",
            ShellType::Zsh => "zsh",
            ShellType::Fish => "fish",
            ShellType::PowerShell => "pwsh",
        };

        format!("omnisystem@localhost:{}$ ", self.current_dir)
    }
}

pub struct TerminalApplication {
    pub app_id: String,
    pub sessions: std::collections::HashMap<u32, ShellSession>,
    pub current_session: u32,
    pub next_session_id: u32,
    pub output_buffer: VecDeque<String>,
    pub max_buffer_size: usize,
    pub history: CommandHistory,
    pub window_width: u32,
    pub window_height: u32,
    pub is_running: bool,
}

impl TerminalApplication {
    pub fn new() -> Self {
        let mut terminal = TerminalApplication {
            app_id: "terminal-1".to_string(),
            sessions: std::collections::HashMap::new(),
            current_session: 0,
            next_session_id: 1,
            output_buffer: VecDeque::new(),
            max_buffer_size: 10000,
            history: CommandHistory::new(1000),
            window_width: 120,
            window_height: 40,
            is_running: true,
        };

        // Create default session
        let session = ShellSession::new(0, ShellType::Bash);
        terminal.sessions.insert(0, session);

        terminal
    }

    pub fn new_session(&mut self, shell: ShellType) -> u32 {
        let session_id = self.next_session_id;
        self.next_session_id += 1;

        let session = ShellSession::new(session_id, shell);
        self.sessions.insert(session_id, session);

        println!("Created new session: {} ({:?})", session_id, shell);
        session_id
    }

    pub fn switch_session(&mut self, session_id: u32) -> Result<(), String> {
        if self.sessions.contains_key(&session_id) {
            self.current_session = session_id;
            println!("Switched to session: {}", session_id);
            Ok(())
        } else {
            Err(format!("Session not found: {}", session_id))
        }
    }

    pub fn close_session(&mut self, session_id: u32) -> Result<(), String> {
        if self.sessions.remove(&session_id).is_some() {
            if self.current_session == session_id {
                self.current_session = *self.sessions.keys().next().unwrap_or(&0);
            }
            println!("Closed session: {}", session_id);
            Ok(())
        } else {
            Err(format!("Session not found: {}", session_id))
        }
    }

    pub fn execute_command(&mut self, command: &str) -> Result<CommandResult, String> {
        if let Some(session) = self.sessions.get(&self.current_session) {
            let result = session.execute_command(command);

            // Add to output buffer
            self.add_output(&format!("> {}", command));
            self.add_output(&result.stdout);

            if result.exit_code != 0 && !result.stderr.is_empty() {
                self.add_output(&result.stderr);
            }

            // Add to history
            self.history.add(command.to_string());

            Ok(result)
        } else {
            Err("Current session not found".to_string())
        }
    }

    pub fn add_output(&mut self, text: &str) {
        for line in text.lines() {
            self.output_buffer.push_back(line.to_string());

            if self.output_buffer.len() > self.max_buffer_size {
                self.output_buffer.pop_front();
            }
        }
    }

    pub fn clear_output(&mut self) {
        self.output_buffer.clear();
    }

    pub fn get_output(&self, lines: usize) -> Vec<String> {
        let start = if self.output_buffer.len() > lines {
            self.output_buffer.len() - lines
        } else {
            0
        };

        self.output_buffer.iter()
            .skip(start)
            .cloned()
            .collect()
    }

    pub fn search_history(&self, pattern: &str) -> Vec<String> {
        self.history.search(pattern)
    }

    pub fn get_prompt(&self) -> String {
        if let Some(session) = self.sessions.get(&self.current_session) {
            session.prompt()
        } else {
            "$ ".to_string()
        }
    }

    pub fn get_current_dir(&self) -> Option<String> {
        self.sessions.get(&self.current_session).map(|s| s.current_dir.clone())
    }

    pub fn render_terminal(&self) {
        println!("╔════════════════════════════════════════════════════════════════╗");
        println!("║         OMNISYSTEM SYSTEM TERMINAL v3.0.0                     ║");
        println!("╚════════════════════════════════════════════════════════════════╝\n");

        println!("Terminal Info:");
        println!("  Size: {}x{}", self.window_width, self.window_height);
        println!("  Active Session: {}", self.current_session);
        println!("  Sessions: {}", self.sessions.len());
        println!("  Output Lines: {}", self.output_buffer.len());
        println!("  History Size: {}", self.history.commands.len());

        println!("\nRecent Output:");
        for line in self.get_output(10) {
            println!("  {}", line);
        }

        println!("\nPrompt: {}", self.get_prompt());
    }

    pub fn get_status(&self) -> String {
        format!(
            "Terminal\nSessions: {}\nBuffer Size: {}\nHistory: {}\nCurrent Dir: {}",
            self.sessions.len(),
            self.output_buffer.len(),
            self.history.commands.len(),
            self.get_current_dir().unwrap_or_default()
        )
    }
}

pub fn main() {
    println!("╔════════════════════════════════════════════════════════════════╗");
    println!("║       OMNISYSTEM SYSTEM TERMINAL v3.0.0                       ║");
    println!("║          Phase 3: Native Terminal Application                 ║");
    println!("╚════════════════════════════════════════════════════════════════╝\n");

    let mut terminal = TerminalApplication::new();

    println!("Initialized terminal with default Bash session\n");

    // Create additional sessions
    let zsh_session = terminal.new_session(ShellType::Zsh);
    let fish_session = terminal.new_session(ShellType::Fish);

    println!();

    // Execute commands
    terminal.execute_command("pwd").expect("Failed to execute pwd");
    terminal.execute_command("ls -la").expect("Failed to execute ls");
    terminal.execute_command("whoami").expect("Failed to execute whoami");
    terminal.execute_command("echo Hello OmniOS").expect("Failed to execute echo");

    println!();

    // Switch sessions
    terminal.switch_session(zsh_session).expect("Failed to switch session");
    terminal.execute_command("pwd").expect("Failed to execute pwd");

    println!();

    // Search history
    let results = terminal.search_history("ls");
    println!("Search results for 'ls': {} matches", results.len());

    println!();

    terminal.render_terminal();

    println!();
    println!("{}", terminal.get_status());

    println!("\n✓ System Terminal fully operational");
}
