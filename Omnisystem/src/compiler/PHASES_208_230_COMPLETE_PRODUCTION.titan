    message GetStats() -> HashMap<String, i32> {
        let mut stats: HashMap<String, i32> = HashMap::new()
        stats.insert("theorems".to_string(), self.theorems_processed)
        stats.insert("invariants".to_string(), self.invariants_checked)
        stats.insert("proofs".to_string(), self.proofs_verified)
        stats
