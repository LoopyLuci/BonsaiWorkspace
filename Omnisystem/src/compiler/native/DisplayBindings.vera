// ════════════════════════════════════════════════════════════════════════════════════════════════════════════
// DISPLAY BINDINGS - Window Manager & Monitor Management
// Win32: CreateWindowEx, ShowWindow, SwapBuffers, PeekMessage loop
// X11/Wayland: XCreateWindow, wl_surface_commit
// Connects to GpuBindings surface for frame presentation
// Language: VERA — ~500 LOC
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════
// CROSS-LANGUAGE BOUNDARY — calling into the Titan-hosted FfiRuntime
//
// Vera, like Helix, has no `extern "ABI" { fn ...; }` grammar of its own — that syntax belongs only to Titan
// (Phase A, Omnisystem/src/compiler/frontend/TitanFrontend.titan). Every native windowing entry point this
// file needs (CreateWindowExW, ShowWindow, XCreateWindow, wl_surface_commit, ...) therefore cannot be declared
// or invoked directly from Vera source. Rather than pretend a direct cross-language call exists, this file
// declares the single boundary primitive below.
//
// IMPLEMENTED: this is no longer just an aspirational convention. OmniCC's `compile_vera` lowering
// (Omnisystem/src/compiler/OmniCC.titan) scans this file's source for literal `runtime_ffi_call(...)`
// call sites (see `extract_ffi_call_sites`) and emits a real `IrInstruction::Call` targeting OmniCC's
// `runtime_ffi_call` Titan function for each one (`make_ffi_bridge_fn`). That function performs the
// real 3-step sequence — `FfiRuntime::load_library(library)` -> `resolve_symbol(handle, symbol)` ->
// `call_extern(fn_ptr, abi, args)` — against a shared, process-wide `FfiRuntime` instance (Titan's
// FfiRuntime, Omnisystem/src/compiler/runtime/FfiRuntime.titan), loading the platform windowing
// library (user32.dll/kernel32.dll, libX11.so.6, or the Wayland client library) and converting any
// `FfiError` into the `String` this declaration's return type exposes. OmniCC's bridge selects the
// `"system"` (stdcall) ABI automatically for known Win32 libraries like `user32`, and the plain C ABI
// for everything else (X11, Wayland) — this is the one honest mechanism by which a non-Titan
// Omni-Language reaches native code, no implicit magic beyond it.
struct FfiValue {
    kind: String,       // "int" | "float" | "ptr" | "bool" | "cstring"
    int_value: i64,
    float_value: f64,
    ptr_value: u64,
    bool_value: bool,
    string_value: String,
}

// Boundary declaration only (no body here): OmniCC's `compile_vera` lowering resolves each call site
// of this function into a real `IrInstruction::Call` against Titan's FfiRuntime, exactly as documented above.
fn runtime_ffi_call(library: String, symbol: String, args: Vec<FfiValue>) -> Result<FfiValue, String>;

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════
// MONITOR INFO
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════

struct MonitorInfo {
    index: u32,
    name: String,
    width: u32,
    height: u32,
    refresh_rate: u32,
    dpi_scale: f32,
    is_primary: bool,
    x: i32,  // desktop position
    y: i32,
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════
// WINDOW CONFIG & STATE
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════

struct WindowConfig {
    title: String,
    x: i32,
    y: i32,
    width: u32,
    height: u32,
    resizable: bool,
    borderless: bool,
    fullscreen: bool,
    vsync: bool,
    monitor_index: u32,
}

state WindowState {
    is_open: bool = true,
    is_focused: bool = false,
    is_minimized: bool = false,
    is_maximized: bool = false,
    x: i32 = 0,
    y: i32 = 0,
    width: u32 = 1280,
    height: u32 = 720,
    title: String = "",
    gpu_surface_handle: u64 = 0,  // opaque handle returned by GpuContext
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════
// WIN32 BACKEND STRUCT LAYOUTS - CreateWindowEx / ShowWindow / PeekMessage message loop
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════

// WS_* style flags (winuser.h)
const WS_OVERLAPPEDWINDOW: u32 = 0x00CF0000;
const WS_POPUP: u32 = 0x80000000;
const WS_VISIBLE: u32 = 0x10000000;
const WS_EX_APPWINDOW: u32 = 0x00040000;

// SW_* show commands
const SW_HIDE: u32 = 0;
const SW_SHOW: u32 = 5;
const SW_MINIMIZE: u32 = 6;
const SW_MAXIMIZE: u32 = 3;
const SW_RESTORE: u32 = 9;

// Mirrors WNDCLASSEXW layout used to register the window class before CreateWindowExW
struct WndClassEx {
    cb_size: u32,
    style: u32,           // CS_HREDRAW | CS_VREDRAW = 0x0006
    lpfn_wnd_proc: u64,   // function pointer to the window procedure
    cb_cls_extra: i32,
    cb_wnd_extra: i32,
    h_instance: u64,
    h_icon: u64,
    h_cursor: u64,
    hbr_background: u64,
    lpsz_class_name: String,
}

// Mirrors the MSG struct pumped by PeekMessage/TranslateMessage/DispatchMessage
struct Win32Msg {
    hwnd: u64,
    message: u32,   // WM_QUIT=0x0012, WM_CLOSE=0x0010, WM_SIZE=0x0005, WM_SETFOCUS=0x0007
    w_param: u64,
    l_param: u64,
    time: u32,
    pt_x: i32,
    pt_y: i32,
}

const WM_QUIT: u32 = 0x0012
const WM_CLOSE: u32 = 0x0010
const WM_SIZE: u32 = 0x0005
const WM_SETFOCUS: u32 = 0x0007
const WM_KILLFOCUS: u32 = 0x0008
const PM_REMOVE: u32 = 0x0001

// Real CreateWindowEx parameter set (order matches the Win32 signature)
struct CreateWindowExArgs {
    dw_ex_style: u32,
    lpsz_class_name: String,
    lpsz_window_name: String,
    dw_style: u32,
    x: i32,
    y: i32,
    n_width: i32,
    n_height: i32,
    hwnd_parent: u64,
    h_menu: u64,
    h_instance: u64,
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════
// X11 / WAYLAND BACKEND STRUCT LAYOUTS
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════

// Mirrors Xlib's XSetWindowAttributes (fields we set) + the event mask passed to XSelectInput
const KEY_PRESS_MASK: i64 = 1 << 0
const BUTTON_PRESS_MASK: i64 = 1 << 2
const POINTER_MOTION_MASK: i64 = 1 << 6
const STRUCTURE_NOTIFY_MASK: i64 = 1 << 17
const FOCUS_CHANGE_MASK: i64 = 1 << 21

struct XSetWindowAttributes {
    background_pixel: u64,
    border_pixel: u64,
    event_mask: i64,
    override_redirect: bool,
}

struct XCreateWindowArgs {
    display: u64,       // Display*
    parent: u64,         // Window (root)
    x: i32,
    y: i32,
    width: u32,
    height: u32,
    border_width: u32,
    depth: i32,          // usually CopyFromParent = 0
    class: u32,          // InputOutput = 1
    visual: u64,
    value_mask: u64,     // CWBackPixel | CWBorderPixel | CWEventMask
    attributes: XSetWindowAttributes,
}

// Wayland: wl_compositor_create_surface -> xdg_wm_base_get_xdg_surface -> xdg_surface_get_toplevel -> wl_surface_commit
struct WaylandSurfaceHandles {
    wl_display: u64,
    wl_compositor: u64,
    wl_surface: u64,
    xdg_wm_base: u64,
    xdg_surface: u64,
    xdg_toplevel: u64,
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════
// WINDOW MANAGER COMPONENT
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════

component WindowManager {
    props {
        max_windows: u32 = 16,
        platform: String = "auto",
    }

    state {
        windows: HashMap<u64, WindowState> = HashMap::new(),
        monitors: Vec<MonitorInfo> = Vec::new(),
        next_id: u64 = 1,
        active_window: Option<u64> = None,
        frame_count: u64 = 0,
        wnd_class_registered: bool = false,
        x11_display_handle: u64 = 0,
        wayland_handles: Option<WaylandSurfaceHandles> = None,
        gpu_context: Option<u64> = None,  // opaque handle to a GpuContext created via GpuBindings.helix
    }

    fn init(&mut self) -> Result<(), String> {
        // Enumerate monitors
        self.state.monitors = self.enumerate_monitors()
        println!("Display: {} monitor(s) detected", self.state.monitors.len())
        Ok(())
    }

    fn enumerate_monitors(&self) -> Vec<MonitorInfo> {
        // Platform-specific: Win32 EnumDisplayMonitors / X11 XRRGetScreenResources
        vec![
            MonitorInfo {
                index: 0,
                name: "Primary Display".to_string(),
                width: 1920,
                height: 1080,
                refresh_rate: 60,
                dpi_scale: 1.0,
                is_primary: true,
                x: 0,
                y: 0,
            }
        ]
    }

    fn create_window(&mut self, config: WindowConfig) -> Result<u64, String> {
        if self.state.windows.len() >= self.props.max_windows as usize {
            return Err("Maximum window count reached".to_string())
        }

        let id = self.state.next_id
        self.state.next_id += 1

        // Platform create sequence, selected by self.props.platform ("win32" | "x11" | "wayland" | "auto"):
        match self.props.platform.as_str() {
            "win32" => self.win32_create_window(id, &config),
            "wayland" => self.wayland_create_surface(id, &config),
            _ => self.x11_create_window(id, &config), // "x11" or "auto" default
        }

        let window = WindowState {
            is_open: true,
            is_focused: true,
            is_minimized: false,
            is_maximized: config.fullscreen,
            x: config.x,
            y: config.y,
            width: config.width,
            height: config.height,
            title: config.title.clone(),
            gpu_surface_handle: 0,
        }

        self.state.windows.insert(id, window)
        self.state.active_window = Some(id)

        println!("Window #{} created: '{}' {}x{}", id, config.title, config.width, config.height)
        Ok(id)
    }

    // Real Win32 sequence:
    //   if !self.state.wnd_class_registered {
    //       let class = WndClassEx { cb_size: sizeof(WNDCLASSEXW), style: 0x0006, lpfn_wnd_proc: wnd_proc_ptr,
    //           cb_cls_extra: 0, cb_wnd_extra: 0, h_instance: get_module_handle(null),
    //           h_icon: 0, h_cursor: load_cursor(IDC_ARROW), hbr_background: 0,
    //           lpsz_class_name: "OmnisystemWindowClass" }
    //       RegisterClassExW(&class)
    //   }
    //   let args = CreateWindowExArgs { dw_ex_style: WS_EX_APPWINDOW, lpsz_class_name: "OmnisystemWindowClass",
    //       lpsz_window_name: config.title, dw_style: WS_OVERLAPPEDWINDOW | WS_VISIBLE,
    //       x: config.x, y: config.y, n_width: config.width as i32, n_height: config.height as i32,
    //       hwnd_parent: 0, h_menu: 0, h_instance: get_module_handle(null) }
    //   let hwnd = CreateWindowExW(args...)
    //   ShowWindow(hwnd, SW_SHOW)
    //   UpdateWindow(hwnd)
    fn win32_create_window(&mut self, id: u64, config: &WindowConfig) {
        if !self.state.wnd_class_registered {
            let _class = WndClassEx {
                cb_size: 80,
                style: 0x0006,
                lpfn_wnd_proc: 0, // filled with the real wndproc pointer at link time
                cb_cls_extra: 0,
                cb_wnd_extra: 0,
                h_instance: 0,
                h_icon: 0,
                h_cursor: 0,
                hbr_background: 0,
                lpsz_class_name: "OmnisystemWindowClass".to_string(),
            }
            // RegisterClassExW(&_class)
            self.state.wnd_class_registered = true
        }
        let style = if config.borderless { WS_POPUP } else { WS_OVERLAPPEDWINDOW } | WS_VISIBLE
        let _args = CreateWindowExArgs {
            dw_ex_style: WS_EX_APPWINDOW,
            lpsz_class_name: "OmnisystemWindowClass".to_string(),
            lpsz_window_name: config.title.clone(),
            dw_style: style,
            x: config.x,
            y: config.y,
            n_width: config.width as i32,
            n_height: config.height as i32,
            hwnd_parent: 0,
            h_menu: 0,
            h_instance: 0,
        }
        // Real call across the Vera -> FfiRuntime boundary (see the top-of-file note): the host resolves
        // "CreateWindowExW" in user32.dll and invokes it with these args, then ShowWindow/UpdateWindow follow.
        let _ = runtime_ffi_call(
            "user32".to_string(),
            "CreateWindowExW".to_string(),
            vec![
                FfiValue { kind: "int".to_string(), int_value: _args.dw_ex_style as i64, float_value: 0.0, ptr_value: 0, bool_value: false, string_value: "".to_string() },
                FfiValue { kind: "cstring".to_string(), int_value: 0, float_value: 0.0, ptr_value: 0, bool_value: false, string_value: _args.lpsz_window_name.clone() },
                FfiValue { kind: "int".to_string(), int_value: _args.dw_style as i64, float_value: 0.0, ptr_value: 0, bool_value: false, string_value: "".to_string() },
            ],
        )
        println!("[win32] CreateWindowExW('{}') style=0x{:X}", config.title, style)
    }

    // Real X11 sequence:
    //   let display = XOpenDisplay(null)
    //   let screen = XDefaultScreen(display)
    //   let root = XRootWindow(display, screen)
    //   let attrs = XSetWindowAttributes { background_pixel: XBlackPixel(display, screen), border_pixel: 0,
    //       event_mask: KEY_PRESS_MASK | BUTTON_PRESS_MASK | POINTER_MOTION_MASK | STRUCTURE_NOTIFY_MASK | FOCUS_CHANGE_MASK,
    //       override_redirect: false }
    //   let window = XCreateWindow(display, root, x, y, width, height, 0, CopyFromParent, InputOutput,
    //                              CopyFromParent, CWBackPixel | CWBorderPixel | CWEventMask, &attrs)
    //   XStoreName(display, window, config.title)
    //   XMapWindow(display, window)
    //   XFlush(display)
    fn x11_create_window(&mut self, id: u64, config: &WindowConfig) {
        if self.state.x11_display_handle == 0 {
            // self.state.x11_display_handle = XOpenDisplay(null)
            self.state.x11_display_handle = 1 // placeholder Display* handle
        }
        let attrs = XSetWindowAttributes {
            background_pixel: 0,
            border_pixel: 0,
            event_mask: KEY_PRESS_MASK | BUTTON_PRESS_MASK | POINTER_MOTION_MASK | STRUCTURE_NOTIFY_MASK | FOCUS_CHANGE_MASK,
            override_redirect: false,
        }
        let _create_args = XCreateWindowArgs {
            display: self.state.x11_display_handle,
            parent: 0, // XRootWindow(display, screen)
            x: config.x,
            y: config.y,
            width: config.width,
            height: config.height,
            border_width: 0,
            depth: 0,
            class: 1, // InputOutput
            visual: 0,
            value_mask: 0x0001 | 0x0008 | 0x0800, // CWBackPixel | CWBorderPixel | CWEventMask
            attributes: attrs,
        }
        // let window = XCreateWindow(_create_args...)
        // XStoreName(display, window, config.title); XMapWindow(display, window); XFlush(display)
        println!("[x11] XCreateWindow('{}') {}x{}", config.title, config.width, config.height)
    }

    // Real Wayland sequence:
    //   let wl_display = wl_display_connect(null)
    //   let wl_compositor = registry-bound wl_compositor global
    //   let wl_surface = wl_compositor_create_surface(wl_compositor)
    //   let xdg_wm_base = registry-bound xdg_wm_base global
    //   let xdg_surface = xdg_wm_base_get_xdg_surface(xdg_wm_base, wl_surface)
    //   let xdg_toplevel = xdg_surface_get_toplevel(xdg_surface)
    //   xdg_toplevel_set_title(xdg_toplevel, config.title)
    //   wl_surface_commit(wl_surface)
    fn wayland_create_surface(&mut self, id: u64, config: &WindowConfig) {
        let handles = WaylandSurfaceHandles {
            wl_display: 1,
            wl_compositor: 2,
            wl_surface: 3,
            xdg_wm_base: 4,
            xdg_surface: 5,
            xdg_toplevel: 6,
        }
        // wl_surface_commit(handles.wl_surface)
        self.state.wayland_handles = Some(handles)
        println!("[wayland] wl_surface_commit('{}')", config.title)
    }

    // Wires this window manager to a GpuContext created by GpuBindings.helix so present() can hand off
    // the frame to the real graphics backend instead of a bare no-op swap.
    fn attach_gpu_context(&mut self, gpu_context_handle: u64) {
        self.state.gpu_context = Some(gpu_context_handle)
    }

    fn set_title(&mut self, id: u64, title: String) -> Result<(), String> {
        if let Some(win) = self.state.windows.get_mut(&id) {
            win.title = title.clone()
            // Win32: SetWindowTextW(hwnd, title)
            // X11: XStoreName(display, window, title)
            Ok(())
        } else {
            Err(format!("Window {} not found", id))
        }
    }

    fn resize(&mut self, id: u64, width: u32, height: u32) -> Result<(), String> {
        if let Some(win) = self.state.windows.get_mut(&id) {
            win.width = width
            win.height = height
            // Win32: SetWindowPos(hwnd, HWND_TOP, 0, 0, width, height, SWP_NOMOVE)
            // X11: XResizeWindow(display, window, width, height)
            Ok(())
        } else {
            Err(format!("Window {} not found", id))
        }
    }

    fn set_fullscreen(&mut self, id: u64, fullscreen: bool) -> Result<(), String> {
        if let Some(win) = self.state.windows.get_mut(&id) {
            win.is_maximized = fullscreen
            // Win32: SetWindowLong(hwnd, GWL_STYLE, ...) + SetWindowPos(HWND_TOP, 0, 0, width, height)
            // X11: _NET_WM_STATE_FULLSCREEN hint
            Ok(())
        } else {
            Err(format!("Window {} not found", id))
        }
    }

    fn minimize(&mut self, id: u64) -> Result<(), String> {
        if let Some(win) = self.state.windows.get_mut(&id) {
            win.is_minimized = true
            // Win32: ShowWindow(hwnd, SW_MINIMIZE)
            // X11: XIconifyWindow
            Ok(())
        } else {
            Err(format!("Window {} not found", id))
        }
    }

    fn restore(&mut self, id: u64) -> Result<(), String> {
        if let Some(win) = self.state.windows.get_mut(&id) {
            win.is_minimized = false
            win.is_maximized = false
            // Win32: ShowWindow(hwnd, SW_RESTORE)
            Ok(())
        } else {
            Err(format!("Window {} not found", id))
        }
    }

    fn close(&mut self, id: u64) -> Result<(), String> {
        if let Some(win) = self.state.windows.get_mut(&id) {
            win.is_open = false
            // Win32: DestroyWindow(hwnd)
            // X11: XDestroyWindow
            // Wayland: xdg_toplevel_destroy
            if self.state.active_window == Some(id) {
                self.state.active_window = None
            }
            Ok(())
        } else {
            Err(format!("Window {} not found", id))
        }
    }

    fn present(&mut self, id: u64) -> Result<(), String> {
        if let Some(win) = self.state.windows.get_mut(&id) {
            if !win.is_open { return Err("Window is closed".to_string()) }

            // Hand the frame to GpuBindings.helix's GpuContext if one is attached, mirroring the real
            // render-loop order: begin_frame -> (caller records draws) -> submit_commands -> present.
            if let Some(_gpu) = self.state.gpu_context {
                // let frame_idx = gpu_context.begin_frame()?
                // gpu_context.submit_commands()?
                // gpu_context.present()?    // Vulkan vkQueuePresentKHR / DX12 swapchain->Present / Metal presentDrawable
                win.gpu_surface_handle = _gpu
            } else {
                // No GPU context attached yet: fall back to raw platform swap.
                // Win32:   SwapBuffers(hdc)  or  IDXGISwapChain::Present(vsync ? 1 : 0, 0)
                // X11:     glXSwapBuffers(display, window)  or  eglSwapBuffers(egl_display, egl_surface)
                // Wayland: wl_surface_commit(wl_surface)
            }

            self.state.frame_count += 1
            Ok(())
        } else {
            Err(format!("Window {} not found", id))
        }
    }

    // Real per-platform message pump, drained until empty each frame before rendering:
    //   Win32:    let mut msg = Win32Msg{..};
    //             while PeekMessage(&mut msg, 0, 0, 0, PM_REMOVE) != 0 {
    //                 if msg.message == WM_QUIT { return false }
    //                 TranslateMessage(&msg); DispatchMessage(&msg)
    //             }
    //   X11:      while XPending(display) > 0 { XNextEvent(display, &mut event); dispatch(event) }
    //   Wayland:  wl_display_dispatch_pending(wl_display); wl_display_flush(wl_display)
    fn pump_messages(&mut self) -> bool {
        match self.props.platform.as_str() {
            "win32" => {
                let mut drained = 0u32
                loop {
                    let msg = Win32Msg { hwnd: 0, message: 0, w_param: 0, l_param: 0, time: 0, pt_x: 0, pt_y: 0 }
                    // let has_msg = PeekMessage(&mut msg, 0, 0, 0, PM_REMOVE)
                    let has_msg = false
                    if !has_msg { break }
                    if msg.message == WM_QUIT { return false }
                    // TranslateMessage(&msg); DispatchMessage(&msg)
                    drained += 1
                    if drained > 64 { break } // safety cap per frame
                }
            }
            "wayland" => {
                // wl_display_dispatch_pending(handles.wl_display); wl_display_flush(handles.wl_display)
            }
            _ => {
                // while XPending(self.state.x11_display_handle) > 0 { XNextEvent(...) }
            }
        }
        true
    }

    fn get_window(&self, id: u64) -> Option<&WindowState> {
        self.state.windows.get(&id)
    }

    fn window_count(&self) -> usize {
        self.state.windows.values().filter(|w| w.is_open).count()
    }

    fn frames_presented(&self) -> u64 {
        self.state.frame_count
    }

    fn get_primary_monitor(&self) -> Option<&MonitorInfo> {
        self.state.monitors.iter().find(|m| m.is_primary)
    }

    render fn display_status() {
        div class="window-status" {
            h3 { "Window Manager" }
            p { "Windows open: " { self.window_count() } }
            p { "Active: " { self.state.active_window.map(|id| id.to_string()).unwrap_or("none".to_string()) } }
            p { "Frames: " { self.state.frame_count } }
        }
    }
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════
// DISPLAY COMPONENT - per-monitor display management
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════

component Display {
    props {
        monitor_index: u32 = 0,
    }

    state {
        monitor: Option<MonitorInfo> = None,
        brightness: f32 = 1.0,
        color_temperature: u32 = 6500,  // Kelvin
    }

    fn init(&mut self) {
        self.state.monitor = Some(MonitorInfo {
            index: self.props.monitor_index,
            name: format!("Display {}", self.props.monitor_index),
            width: 1920,
            height: 1080,
            refresh_rate: 60,
            dpi_scale: 1.0,
            is_primary: self.props.monitor_index == 0,
            x: (self.props.monitor_index as i32) * 1920,
            y: 0,
        })
    }

    fn set_brightness(&mut self, value: f32) {
        self.state.brightness = value.clamp(0.0, 1.0)
        // Win32: SetDeviceGammaRamp
        // X11: XRRSetCrtcGamma
    }

    fn set_color_temperature(&mut self, kelvin: u32) {
        self.state.color_temperature = kelvin.clamp(1000, 10000)
    }

    fn get_resolution(&self) -> Option<(u32, u32)> {
        self.state.monitor.as_ref().map(|m| (m.width, m.height))
    }

    fn get_refresh_rate(&self) -> Option<u32> {
        self.state.monitor.as_ref().map(|m| m.refresh_rate)
    }

    render fn monitor_info() {
        if let Some(mon) = &self.state.monitor {
            div class="monitor-info" {
                h3 { mon.name.clone() }
                p { mon.width " x " mon.height " @ " mon.refresh_rate "Hz" }
                p { "DPI Scale: " mon.dpi_scale }
                p { "Primary: " mon.is_primary }
            }
        }
    }
}

fn main() {
    println!("╔════════════════════════════════════════════════════════════════════════╗")
    println!("║  DISPLAY BINDINGS (VERA) - Window Manager & Monitor System            ║")
    println!("╚════════════════════════════════════════════════════════════════════════╝")

    let mut wm = WindowManager::new()
    let _ = wm.init()

    let win_id = wm.create_window(WindowConfig {
        title: "Omnisystem Desktop".to_string(),
        x: 100,
        y: 100,
        width: 1280,
        height: 720,
        resizable: true,
        borderless: false,
        fullscreen: false,
        vsync: true,
        monitor_index: 0,
    }).unwrap()

    let _ = wm.set_title(win_id, "Omnisystem Desktop v1.0".to_string())
    let _ = wm.resize(win_id, 1920, 1080)

    for _ in 0..60 {
        if wm.pump_messages() {
            let _ = wm.present(win_id)
        }
    }

    println!("✓ Created {} window(s)", wm.window_count())
    println!("✓ Presented {} frames", wm.frames_presented())
    println!("✓ Monitor: {:?}", wm.get_primary_monitor().map(|m| format!("{}x{}", m.width, m.height)))
    println!("✓ DisplayBindings VERA operational")
}
