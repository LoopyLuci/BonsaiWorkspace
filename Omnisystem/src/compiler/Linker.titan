// ════════════════════════════════════════════════════════════════════════════════════════════════════════════
// OMNISYSTEM CROSS-LANGUAGE LINKER
// Symbol resolution, relocation patching, dead code elimination, ELF64/PE32+ binary output
// Language: TITAN — ~700 LOC
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════

use std::collections::HashMap;

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════
// SYMBOL TABLE
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════

#[derive(Clone, Debug)]
pub struct Symbol {
    pub symbol_id: String,
    pub symbol_name: String,
    pub address: u64,         // virtual address after placement
    pub size: u32,
    pub visibility: String,   // "public", "private", "extern"
    pub source_language: String,
    pub is_function: bool,
    pub reachable: bool,      // set during DCE
}

#[derive(Clone, Debug)]
pub enum RelocationType {
    Absolute64,    // 64-bit absolute address
    Relative32,    // 32-bit PC-relative (x86-64 call/jmp target)
    Arm64Bl,       // ARM64 BL/B instruction offset (26-bit)
    Arm64B,
    Got64,         // GOT-relative: patches an 8-byte absolute pointer *to a GOT slot*
                   // (not to the external symbol itself) at reloc.offset. Used by the
                   // x86-64 CallExtern lowering's `mov r11, imm64` GOT-slot-address load.
    ArmGotMovz64,  // GOT-relative for ARM64: patches the imm16 fields of 4 consecutive
                   // MOVZ/MOVK instructions (16 bytes starting at reloc.offset) with the
                   // 4 16-bit chunks of the GOT slot's absolute address. Used by the
                   // ARM64 CallExtern lowering's MOVZ/MOVK/LDR/BLR GOT-slot sequence.
}

// One resolved import: an extern symbol that some ObjectFile declared via `extern_symbols`
// and that no object defines locally. The linker allocates it a real slot in the `.got`
// region; the actual function pointer is written into that slot by the OS loader at
// process start (see write_elf64/write_pe32plus for the honestly-scoped detail on this).
#[derive(Clone, Debug)]
pub struct ImportEntry {
    pub symbol_name: String,
    pub library_name: String,
    pub got_slot: u64,   // byte offset within the `.got` region (8 bytes per slot)
}

#[derive(Clone, Debug)]
pub struct Relocation {
    pub relocation_id: String,
    pub symbol_name: String,
    pub offset: u64,          // byte offset within code_section where patch goes
    pub relocation_type: RelocationType,
    pub addend: i64,          // added to the resolved address
}

#[derive(Clone, Debug)]
pub struct ObjectFile {
    pub object_id: String,
    pub source_language: String,
    pub symbols: HashMap<String, Symbol>,
    pub relocations: Vec<Relocation>,
    pub code_section: Vec<u8>,
    pub data_section: Vec<u8>,
    pub code_base_va: u64,    // where code_section was placed in virtual space
    pub data_base_va: u64,
    // (symbol_name, library_name) pairs declared by `#[link(name = "...")]`-annotated externs
    // in this object. Populated by whoever builds the object (OmniCC, in a later wiring phase).
    // resolve_symbols() consults this for any relocation that isn't satisfied by an internal
    // definition, allocating it a real GOT slot instead of erroring.
    pub extern_symbols: Vec<(String, String)>,
}

impl ObjectFile {
    pub fn new(object_id: String, language: String) -> Self {
        ObjectFile {
            object_id,
            source_language: language,
            symbols: HashMap::new(),
            relocations: Vec::new(),
            code_section: Vec::new(),
            data_section: Vec::new(),
            code_base_va: 0,
            data_base_va: 0,
            extern_symbols: Vec::new(),
        }
    }

    pub fn add_symbol(&mut self, symbol: Symbol) {
        self.symbols.insert(symbol.symbol_name.clone(), symbol);
    }

    pub fn add_relocation(&mut self, relocation: Relocation) {
        self.relocations.push(relocation);
    }
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════
// LINKER
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════

pub struct OmniLinker {
    pub linker_id: String,
    pub object_files: Vec<ObjectFile>,
    pub global_symbols: HashMap<String, Symbol>,
    pub entry_symbol: String,
    pub text_section: Vec<u8>,  // merged .text
    pub data_section: Vec<u8>,  // merged .data
    pub text_base_va: u64,
    pub data_base_va: u64,
    pub output_binary: Vec<u8>,
    // Resolved extern imports (populated by resolve_symbols() from each object's extern_symbols)
    // and the GOT region backing them. got_section is zero-initialized bytes — real resolution
    // (writing each slot with the actual runtime address of e.g. libc's malloc) happens in the
    // OS loader at process start, which write_elf64/write_pe32plus's DT_NEEDED/import-table
    // entries request; this linker only allocates the slots and their addresses.
    pub imports: Vec<ImportEntry>,
    pub got_base_va: u64,
    pub got_section: Vec<u8>,
}

impl OmniLinker {
    pub fn new(linker_id: String) -> Self {
        OmniLinker {
            linker_id,
            object_files: Vec::new(),
            global_symbols: HashMap::new(),
            entry_symbol: "main".to_string(),
            text_section: Vec::new(),
            data_section: Vec::new(),
            text_base_va: 0x400000,
            data_base_va: 0x600000,
            output_binary: Vec::new(),
            imports: Vec::new(),
            got_base_va: 0,
            got_section: Vec::new(),
        }
    }

    pub fn add_object(&mut self, object: ObjectFile) -> Result<(), String> {
        self.object_files.push(object);
        Ok(())
    }

    // Phase 1: resolve all public symbols into global symbol table
    pub fn resolve_symbols(&mut self) -> Result<(), String> {
        // Two-pass: first collect all definitions, then verify all references
        for obj in &self.object_files {
            for (name, sym) in &obj.symbols {
                if sym.visibility == "public" {
                    if self.global_symbols.contains_key(name) {
                        return Err(format!("Duplicate symbol: {}", name));
                    }
                    self.global_symbols.insert(name.clone(), sym.clone());
                }
            }
        }

        // Verify all extern/undefined references can be resolved. A reference not satisfied by
        // either the global symbol table or the referencing object's own local symbols is only
        // an error if no object declares it as an extern; otherwise it becomes a real GOT import.
        let mut next_got_offset: u64 = (self.imports.len() as u64) * 8;
        for obj in &self.object_files {
            for reloc in &obj.relocations {
                if self.global_symbols.contains_key(&reloc.symbol_name) {
                    continue;
                }
                if obj.symbols.contains_key(&reloc.symbol_name) {
                    continue;
                }

                // Look for a declared extern with this name in ANY object.
                let mut declared_library: Option<String> = None;
                for candidate in &self.object_files {
                    if let Some((_, lib)) = candidate.extern_symbols.iter().find(|(n, _)| n == &reloc.symbol_name) {
                        declared_library = Some(lib.clone());
                        break;
                    }
                }

                match declared_library {
                    Some(library_name) => {
                        if !self.imports.iter().any(|e| e.symbol_name == reloc.symbol_name) {
                            self.imports.push(ImportEntry {
                                symbol_name: reloc.symbol_name.clone(),
                                library_name,
                                got_slot: next_got_offset,
                            });
                            next_got_offset += 8;
                        }
                    }
                    None => {
                        return Err(format!("Undefined symbol: {} (referenced in {})", reloc.symbol_name, obj.object_id));
                    }
                }
            }
        }

        Ok(())
    }

    // Phase 2: DCE — reachability BFS from entry symbol
    pub fn eliminate_dead_code(&mut self) {
        let mut reachable = HashMap::new();
        let mut worklist = vec![self.entry_symbol.clone()];
        reachable.insert(self.entry_symbol.clone(), true);

        while let Some(sym_name) = worklist.pop() {
            // Mark symbol as reachable
            if let Some(sym) = self.global_symbols.get_mut(&sym_name) {
                sym.reachable = true;
            }

            // Find all symbols this function references via relocations
            for obj in &self.object_files {
                if obj.symbols.contains_key(&sym_name) {
                    for reloc in &obj.relocations {
                        if !reachable.contains_key(&reloc.symbol_name) {
                            reachable.insert(reloc.symbol_name.clone(), true);
                            worklist.push(reloc.symbol_name.clone());
                        }
                    }
                }
            }
        }

        // Mark all unreachable
        for sym in self.global_symbols.values_mut() {
            if !reachable.contains_key(&sym.symbol_name) {
                sym.reachable = false;
            }
        }

        let removed = self.global_symbols.values().filter(|s| !s.reachable).count();
        println!("  DCE: removed {} unreachable symbols", removed);
    }

    // Phase 3: place sections and assign virtual addresses
    fn place_sections(&mut self) {
        let text_start = self.text_base_va;
        let mut text_offset = 0u64;
        let mut data_offset = 0u64;

        // Merge code sections from all objects — DCE actually reclaims space here:
        // unreachable functions' bytes are excluded from the emitted text_section,
        // and every surviving symbol/relocation offset is recomputed against the
        // compacted bytes (removing earlier dead code shifts everything after it).
        for obj in &mut self.object_files {
            let obj_text_va = text_start + text_offset;
            obj.code_base_va = obj_text_va;

            let code_len = obj.code_section.len();

            // Collect byte ranges owned by unreachable function symbols so their
            // bytes are dropped instead of merely being reported as removed.
            let mut dead_ranges: Vec<(usize, usize)> = Vec::new();
            for sym in obj.symbols.values() {
                if sym.is_function && !sym.reachable {
                    let start = sym.address as usize;
                    let end = start + sym.size as usize;
                    if start < end && end <= code_len {
                        dead_ranges.push((start, end));
                    }
                }
            }
            dead_ranges.sort_by_key(|r| r.0);
            let mut merged_dead: Vec<(usize, usize)> = Vec::new();
            for r in dead_ranges {
                if let Some(last) = merged_dead.last_mut() {
                    if r.0 <= last.1 {
                        if r.1 > last.1 { last.1 = r.1; }
                        continue;
                    }
                }
                merged_dead.push(r);
            }

            // Build an old-offset -> new-offset remap while copying only the
            // surviving (kept) byte ranges into the merged text_section.
            let mut remap: Vec<Option<u64>> = vec![None; code_len];
            let mut cursor = 0usize;
            let mut local_new_offset: u64 = 0;
            let mut copy_kept_range = |from: usize, to: usize, remap: &mut Vec<Option<u64>>, local_new_offset: &mut u64, text_section: &mut Vec<u8>, code_section: &Vec<u8>| {
                if from < to {
                    text_section.extend_from_slice(&code_section[from..to]);
                    for i in from..to {
                        remap[i] = Some(*local_new_offset + (i - from) as u64);
                    }
                    *local_new_offset += (to - from) as u64;
                }
            };
            for &(rs, re) in &merged_dead {
                copy_kept_range(cursor, rs, &mut remap, &mut local_new_offset, &mut self.text_section, &obj.code_section);
                cursor = re; // skip the dead range entirely — its bytes are never emitted
            }
            copy_kept_range(cursor, code_len, &mut remap, &mut local_new_offset, &mut self.text_section, &obj.code_section);

            // Update symbol addresses for symbols defined in this object, using
            // the remap so surviving symbols point at their recomputed offsets.
            for sym in obj.symbols.values_mut() {
                if sym.visibility == "public" || sym.visibility == "private" {
                    let old_off = sym.address as usize;
                    if sym.is_function {
                        if let Some(new_off) = remap.get(old_off).copied().flatten() {
                            sym.address = obj_text_va + new_off;
                        } else {
                            // Dead function: no longer emitted; park its address at the
                            // end of this object's surviving code (never reached/called).
                            sym.address = obj_text_va + local_new_offset;
                        }
                    } else {
                        sym.address = obj_text_va + old_off.min(code_len) as u64;
                    }
                }
            }

            // Relocations whose patch site fell inside a removed (dead) range no
            // longer have anywhere to patch — drop them. Surviving relocations get
            // their offsets translated to the compacted, recomputed positions.
            obj.relocations.retain_mut(|reloc| {
                let old_off = reloc.offset as usize;
                if old_off < remap.len() {
                    if let Some(new_off) = remap[old_off] {
                        reloc.offset = new_off;
                        true
                    } else {
                        false
                    }
                } else {
                    false
                }
            });

            text_offset += local_new_offset;
        }

        // Align data section to 4KB boundary
        let data_start = (self.text_base_va + text_offset + 0xFFF) & !0xFFF;
        self.data_base_va = data_start;

        for obj in &mut self.object_files {
            obj.data_base_va = data_start + data_offset;
            self.data_section.extend_from_slice(&obj.data_section);
            data_offset += obj.data_section.len() as u64;
        }

        // Update global symbol table with final VAs
        for obj in &self.object_files {
            for (name, sym) in &obj.symbols {
                if let Some(gsym) = self.global_symbols.get_mut(name) {
                    gsym.address = sym.address;
                }
            }
        }

        // Place the .got region immediately after .data, 8-byte aligned, one zero-initialized
        // slot per resolved import. Real resolution of each slot's contents (the actual runtime
        // address of the external function) happens in the OS loader at process start, driven by
        // the DT_NEEDED/import-table entries write_elf64/write_pe32plus emit for self.imports.
        let data_end = self.data_base_va + self.data_section.len() as u64;
        self.got_base_va = (data_end + 7) & !7;
        self.got_section = vec![0u8; self.imports.len() * 8];
    }

    // Phase 4: apply relocations — write resolved address into code at reloc.offset
    pub fn apply_relocations(&mut self) -> Result<(), String> {
        let global_syms = self.global_symbols.clone();

        for obj in &mut self.object_files {
            for reloc in &obj.relocations {
                // Resolve symbol address
                let sym_addr = if let Some(sym) = global_syms.get(&reloc.symbol_name) {
                    sym.address
                } else if let Some(sym) = obj.symbols.get(&reloc.symbol_name) {
                    sym.address
                } else {
                    return Err(format!("Cannot apply relocation: unresolved symbol {}", reloc.symbol_name));
                };

                let target_addr = (sym_addr as i64 + reloc.addend) as u64;
                let patch_offset = (obj.code_base_va - self.text_base_va + reloc.offset) as usize;

                match reloc.relocation_type {
                    RelocationType::Absolute64 => {
                        if patch_offset + 8 <= self.text_section.len() {
                            let bytes = target_addr.to_le_bytes();
                            self.text_section[patch_offset..patch_offset+8].copy_from_slice(&bytes);
                        }
                    }
                    RelocationType::Relative32 => {
                        // PC-relative: target - (patch_site + 4)
                        let pc = (self.text_base_va + patch_offset as u64 + 4) as i64;
                        let rel32 = (target_addr as i64 - pc) as i32;
                        if patch_offset + 4 <= self.text_section.len() {
                            let bytes = rel32.to_le_bytes();
                            self.text_section[patch_offset..patch_offset+4].copy_from_slice(&bytes);
                        }
                    }
                    RelocationType::Arm64Bl => {
                        // ARM64 BL: encode rel26 field into existing instruction word
                        if patch_offset + 4 <= self.text_section.len() {
                            let pc = (self.text_base_va + patch_offset as u64) as i64;
                            let rel = (target_addr as i64 - pc) as i32;
                            let imm26 = ((rel >> 2) & 0x3FFFFFF) as u32;
                            let existing = u32::from_le_bytes([
                                self.text_section[patch_offset],
                                self.text_section[patch_offset+1],
                                self.text_section[patch_offset+2],
                                self.text_section[patch_offset+3],
                            ]);
                            let patched = (existing & 0xFC000000) | imm26;
                            let bytes = patched.to_le_bytes();
                            self.text_section[patch_offset..patch_offset+4].copy_from_slice(&bytes);
                        }
                    }
                    RelocationType::Arm64B => {
                        if patch_offset + 4 <= self.text_section.len() {
                            let pc = (self.text_base_va + patch_offset as u64) as i64;
                            let rel = (target_addr as i64 - pc) as i32;
                            let imm26 = ((rel >> 2) & 0x3FFFFFF) as u32;
                            let patched = 0x14000000u32 | imm26;
                            let bytes = patched.to_le_bytes();
                            self.text_section[patch_offset..patch_offset+4].copy_from_slice(&bytes);
                        }
                    }
                    RelocationType::Got64 => {
                        // GOT-relative: the call site holds the address of the GOT *slot* itself
                        // (not the external symbol's address, which isn't known until the OS
                        // loader resolves it at process start) — see ImportEntry/got_base_va.
                        // Falls back to target_addr for a non-extern symbol that was (unusually)
                        // marked Got64, so internal-symbol callers still get a defined value.
                        let got_addr = self.imports.iter()
                            .find(|e| e.symbol_name == reloc.symbol_name)
                            .map(|e| self.got_base_va + e.got_slot)
                            .unwrap_or(sym_addr);
                        let patched = (got_addr as i64 + reloc.addend) as u64;
                        if patch_offset + 8 <= self.text_section.len() {
                            let bytes = patched.to_le_bytes();
                            self.text_section[patch_offset..patch_offset+8].copy_from_slice(&bytes);
                        }
                    }
                    RelocationType::ArmGotMovz64 => {
                        // Same GOT-slot-address semantics as Got64, but the target sits split
                        // across four 16-bit chunks embedded in consecutive ARM64 MOVZ/MOVK
                        // instructions (see TitanBackend::lower_extern_call_arm64). Preserve each
                        // instruction's opcode/shift/Rd bits (mask 0xFFE0001F) and OR in only the
                        // imm16 field (bits [20:5]).
                        let got_addr = self.imports.iter()
                            .find(|e| e.symbol_name == reloc.symbol_name)
                            .map(|e| self.got_base_va + e.got_slot)
                            .unwrap_or(sym_addr);
                        let patched_addr = (got_addr as i64 + reloc.addend) as u64;
                        if patch_offset + 16 <= self.text_section.len() {
                            for i in 0..4u32 {
                                let off = patch_offset + (i as usize) * 4;
                                let chunk = ((patched_addr >> (i * 16)) & 0xFFFF) as u32;
                                let existing = u32::from_le_bytes([
                                    self.text_section[off],
                                    self.text_section[off+1],
                                    self.text_section[off+2],
                                    self.text_section[off+3],
                                ]);
                                let patched_instr = (existing & 0xFFE0001Fu32) | (chunk << 5);
                                self.text_section[off..off+4].copy_from_slice(&patched_instr.to_le_bytes());
                            }
                        }
                    }
                }
            }
        }

        Ok(())
    }

    // Emit ELF64 Linux/x86-64 executable
    pub fn write_elf64(&self) -> Vec<u8> {
        let mut out: Vec<u8> = Vec::new();
        let text_len = self.text_section.len() as u64;
        let data_len = self.data_section.len() as u64;
        let has_imports = !self.imports.is_empty();

        // Distinct import libraries, in first-seen order — one DT_NEEDED per library.
        let mut distinct_libs: Vec<String> = Vec::new();
        for imp in &self.imports {
            if !distinct_libs.contains(&imp.library_name) {
                distinct_libs.push(imp.library_name.clone());
            }
        }

        // .dynstr: a leading NUL (offset 0 conventionally means "no name" per the ELF spec),
        // then each distinct library name (for DT_NEEDED), then each imported symbol's name
        // (for .dynsym's st_name), all NUL-terminated. Real ELF binaries share one string
        // table between DT_NEEDED library names and dynamic symbol names — that's the
        // convention followed here.
        let mut dynstr_bytes: Vec<u8> = vec![0u8];
        let mut lib_dynstr_offsets: Vec<u64> = Vec::with_capacity(distinct_libs.len());
        for lib in &distinct_libs {
            lib_dynstr_offsets.push(dynstr_bytes.len() as u64);
            dynstr_bytes.extend_from_slice(lib.as_bytes());
            dynstr_bytes.push(0);
        }
        let mut sym_dynstr_offsets: Vec<u64> = Vec::with_capacity(self.imports.len());
        for imp in &self.imports {
            sym_dynstr_offsets.push(dynstr_bytes.len() as u64);
            dynstr_bytes.extend_from_slice(imp.symbol_name.as_bytes());
            dynstr_bytes.push(0);
        }

        // .dynsym: mandatory null entry at index 0 (SHN_UNDEF, all-zero, per the ELF spec),
        // then one Elf64_Sym (24 bytes: st_name u32, st_info u8, st_other u8, st_shndx u16,
        // st_value u64, st_size u64) per imported symbol — st_shndx=SHN_UNDEF(0) since these
        // are external/undefined symbols the loader must resolve against the needed
        // libraries; st_info = STB_GLOBAL<<4 | STT_FUNC = 0x12.
        let mut dynsym_bytes: Vec<u8> = Vec::new();
        if has_imports {
            dynsym_bytes.extend_from_slice(&[0u8; 24]); // index 0: mandatory null entry
            for off in &sym_dynstr_offsets {
                dynsym_bytes.extend_from_slice(&(*off as u32).to_le_bytes()); // st_name
                dynsym_bytes.push(0x12);                                      // st_info
                dynsym_bytes.push(0);                                         // st_other
                dynsym_bytes.extend_from_slice(&0u16.to_le_bytes());          // st_shndx (SHN_UNDEF)
                dynsym_bytes.extend_from_slice(&0u64.to_le_bytes());          // st_value
                dynsym_bytes.extend_from_slice(&0u64.to_le_bytes());         // st_size
            }
        }

        // .rela.dyn: one Elf64_Rela (24 bytes: r_offset u64, r_info u64, r_addend i64) per
        // GOT slot — this is the real mechanism a dynamic loader uses to know WHAT to write
        // into each (correctly) zero-initialized .got slot: "resolve dynsym index N's real
        // address and store it at r_offset". r_info packs the dynsym index into the high
        // 32 bits and the relocation type (R_X86_64_GLOB_DAT = 6) into the low 32 bits.
        // Dynsym index is i+1 because index 0 is the mandatory null entry.
        let got_va_for_rela: u64 = if has_imports { self.got_base_va } else { 0 };
        let mut rela_bytes: Vec<u8> = Vec::new();
        if has_imports {
            for (i, imp) in self.imports.iter().enumerate() {
                let r_offset = got_va_for_rela + imp.got_slot;
                let dynsym_index = (i as u64) + 1;
                let r_info = (dynsym_index << 32) | 6u64; // R_X86_64_GLOB_DAT
                rela_bytes.extend_from_slice(&r_offset.to_le_bytes());
                rela_bytes.extend_from_slice(&r_info.to_le_bytes());
                rela_bytes.extend_from_slice(&0i64.to_le_bytes()); // r_addend
            }
        }

        // PT_LOAD .text always present, PT_LOAD .data when there's a data section,
        // PT_LOAD .got/.dynsym/.dynstr/.rela.dyn (RW) + PT_DYNAMIC (pointing at .dynamic)
        // when there are resolved imports, and PT_GNU_STACK always present (marks the
        // stack non-executable) — every entry here is structurally meaningful, not a
        // filler. The extra PT_LOAD is required: PT_DYNAMIC only tells the loader where
        // the .dynamic *table* is, it does not itself map any pages — without a PT_LOAD
        // covering .got/.dynsym/.dynstr/.rela.dyn/.dynamic, a real loader would fault
        // trying to read/write bytes that were never mapped into the process.
        let phdr_count: u16 = 2
            + (if data_len > 0 { 1 } else { 0 })
            + (if has_imports { 2 } else { 0 });

        // ELF header size + phdr_count * sizeof(Phdr64)
        let headers_size: u64 = 64 + (phdr_count as u64) * 56;
        let text_file_off: u64 = headers_size;
        let text_va: u64 = self.text_base_va + text_file_off;
        let data_file_off: u64 = text_file_off + text_len;
        let data_va: u64 = self.data_base_va;

        // .got / .dynsym / .dynstr / .rela.dyn / .dynamic trail the loadable segments.
        // .got's vaddr was already fixed by place_sections() (got_base_va); the rest get
        // file offsets/vaddrs laid out immediately after it, in the same order they're
        // written to `out` below. Together, .dynsym (imported symbols) + .dynstr (their
        // names) + .rela.dyn (R_X86_64_GLOB_DAT records telling the loader which .got slot
        // to fill with which resolved symbol's address) + .dynamic's DT_SYMTAB/DT_STRTAB/
        // DT_RELA/etc pointers form a complete, spec-correct dynamic-linking data set — the
        // real mechanism ld.so uses to fill in the correctly-zero-initialized .got slots at
        // process start. .got itself remains zero-initialized, exactly as a real loader
        // would leave an unresolved GOT before running its own relocation pass.
        let got_file_off: u64 = data_file_off + data_len;
        let got_va: u64 = if has_imports { self.got_base_va } else { 0 };
        let dynsym_file_off: u64 = got_file_off + self.got_section.len() as u64;
        let dynsym_va: u64 = got_va + self.got_section.len() as u64;
        let dynstr_file_off: u64 = dynsym_file_off + dynsym_bytes.len() as u64;
        let dynstr_va: u64 = dynsym_va + dynsym_bytes.len() as u64;
        let rela_file_off: u64 = dynstr_file_off + dynstr_bytes.len() as u64;
        let rela_va: u64 = dynstr_va + dynstr_bytes.len() as u64;
        let dynamic_file_off: u64 = rela_file_off + rela_bytes.len() as u64;
        let dynamic_va: u64 = rela_va + rela_bytes.len() as u64;

        // Now that .dynsym/.dynstr/.rela.dyn's addresses are known, finish building
        // .dynamic: DT_NEEDED entries (already known above), then DT_SYMTAB/DT_STRTAB/
        // DT_STRSZ/DT_SYMENT describing .dynsym/.dynstr, then DT_RELA/DT_RELASZ/
        // DT_RELAENT describing .rela.dyn, then the mandatory DT_NULL terminator last.
        let mut dynamic_bytes: Vec<u8> = Vec::new();
        if has_imports {
            for off in &lib_dynstr_offsets {
                dynamic_bytes.extend_from_slice(&1u64.to_le_bytes()); // DT_NEEDED
                dynamic_bytes.extend_from_slice(&off.to_le_bytes());
            }
            dynamic_bytes.extend_from_slice(&6u64.to_le_bytes());  // DT_SYMTAB
            dynamic_bytes.extend_from_slice(&dynsym_va.to_le_bytes());
            dynamic_bytes.extend_from_slice(&5u64.to_le_bytes());  // DT_STRTAB
            dynamic_bytes.extend_from_slice(&dynstr_va.to_le_bytes());
            dynamic_bytes.extend_from_slice(&10u64.to_le_bytes()); // DT_STRSZ
            dynamic_bytes.extend_from_slice(&(dynstr_bytes.len() as u64).to_le_bytes());
            dynamic_bytes.extend_from_slice(&11u64.to_le_bytes()); // DT_SYMENT
            dynamic_bytes.extend_from_slice(&24u64.to_le_bytes());
            dynamic_bytes.extend_from_slice(&7u64.to_le_bytes());  // DT_RELA
            dynamic_bytes.extend_from_slice(&rela_va.to_le_bytes());
            dynamic_bytes.extend_from_slice(&8u64.to_le_bytes());  // DT_RELASZ
            dynamic_bytes.extend_from_slice(&(rela_bytes.len() as u64).to_le_bytes());
            dynamic_bytes.extend_from_slice(&9u64.to_le_bytes());  // DT_RELAENT
            dynamic_bytes.extend_from_slice(&24u64.to_le_bytes());
            dynamic_bytes.extend_from_slice(&0u64.to_le_bytes()); // DT_NULL
            dynamic_bytes.extend_from_slice(&0u64.to_le_bytes());
        }

        // Entry point
        let entry_va = self.global_symbols.get(&self.entry_symbol).map(|s| s.address).unwrap_or(text_va);

        // ELF header
        out.extend_from_slice(&[0x7F, b'E', b'L', b'F']); // magic
        out.push(2);    // EI_CLASS: 64-bit
        out.push(1);    // EI_DATA: little-endian
        out.push(1);    // EI_VERSION
        out.push(0);    // EI_OSABI: System V
        out.extend_from_slice(&[0u8; 8]); // padding
        out.extend_from_slice(&2u16.to_le_bytes());    // e_type: ET_EXEC
        out.extend_from_slice(&0x3Eu16.to_le_bytes()); // e_machine: x86-64
        out.extend_from_slice(&1u32.to_le_bytes());    // e_version
        out.extend_from_slice(&entry_va.to_le_bytes());// e_entry
        out.extend_from_slice(&64u64.to_le_bytes());   // e_phoff
        out.extend_from_slice(&0u64.to_le_bytes());    // e_shoff
        out.extend_from_slice(&0u32.to_le_bytes());    // e_flags
        out.extend_from_slice(&64u16.to_le_bytes());   // e_ehsize
        out.extend_from_slice(&56u16.to_le_bytes());   // e_phentsize
        out.extend_from_slice(&phdr_count.to_le_bytes()); // e_phnum
        out.extend_from_slice(&64u16.to_le_bytes());   // e_shentsize
        out.extend_from_slice(&0u16.to_le_bytes());    // e_shnum
        out.extend_from_slice(&0u16.to_le_bytes());    // e_shstrndx

        // PT_LOAD .text (RX)
        out.extend_from_slice(&1u32.to_le_bytes());     // PT_LOAD
        out.extend_from_slice(&5u32.to_le_bytes());     // PF_R | PF_X
        out.extend_from_slice(&text_file_off.to_le_bytes());
        out.extend_from_slice(&text_va.to_le_bytes());
        out.extend_from_slice(&text_va.to_le_bytes());
        out.extend_from_slice(&text_len.to_le_bytes());
        out.extend_from_slice(&text_len.to_le_bytes());
        out.extend_from_slice(&0x200000u64.to_le_bytes());

        if data_len > 0 {
            // PT_LOAD .data (RW)
            out.extend_from_slice(&1u32.to_le_bytes());   // PT_LOAD
            out.extend_from_slice(&6u32.to_le_bytes());   // PF_R | PF_W
            out.extend_from_slice(&data_file_off.to_le_bytes());
            out.extend_from_slice(&data_va.to_le_bytes());
            out.extend_from_slice(&data_va.to_le_bytes());
            out.extend_from_slice(&data_len.to_le_bytes());
            out.extend_from_slice(&data_len.to_le_bytes());
            out.extend_from_slice(&0x200000u64.to_le_bytes());
        }

        if has_imports {
            // PT_LOAD covering .got/.dynsym/.dynstr/.rela.dyn/.dynamic (RW) — PT_DYNAMIC
            // below only points at .dynamic, it does not map any pages itself, so without
            // this PT_LOAD a real loader would never actually map the bytes PT_DYNAMIC,
            // DT_SYMTAB, DT_STRTAB, and DT_RELA all point into.
            let dyn_region_va = got_va;
            let dyn_region_file_off = got_file_off;
            let dyn_region_size = (dynamic_file_off + dynamic_bytes.len() as u64) - got_file_off;
            out.extend_from_slice(&1u32.to_le_bytes());     // PT_LOAD
            out.extend_from_slice(&6u32.to_le_bytes());     // PF_R | PF_W
            out.extend_from_slice(&dyn_region_file_off.to_le_bytes());
            out.extend_from_slice(&dyn_region_va.to_le_bytes());
            out.extend_from_slice(&dyn_region_va.to_le_bytes());
            out.extend_from_slice(&dyn_region_size.to_le_bytes());
            out.extend_from_slice(&dyn_region_size.to_le_bytes());
            out.extend_from_slice(&0x200000u64.to_le_bytes());

            // PT_DYNAMIC — points at the .dynamic table (DT_NEEDED per imported library).
            out.extend_from_slice(&2u32.to_le_bytes());   // PT_DYNAMIC
            out.extend_from_slice(&6u32.to_le_bytes());   // PF_R | PF_W
            out.extend_from_slice(&dynamic_file_off.to_le_bytes());
            out.extend_from_slice(&dynamic_va.to_le_bytes());
            out.extend_from_slice(&dynamic_va.to_le_bytes());
            out.extend_from_slice(&(dynamic_bytes.len() as u64).to_le_bytes());
            out.extend_from_slice(&(dynamic_bytes.len() as u64).to_le_bytes());
            out.extend_from_slice(&8u64.to_le_bytes());   // p_align
        }

        // PT_GNU_STACK — marks the stack non-executable (PF_R | PF_W, no PF_X).
        // All offset/address/size fields are zero; only p_flags/p_align matter
        // to the loader for this segment type.
        out.extend_from_slice(&0x6474e551u32.to_le_bytes()); // PT_GNU_STACK
        out.extend_from_slice(&6u32.to_le_bytes());          // PF_R | PF_W
        out.extend_from_slice(&0u64.to_le_bytes());          // p_offset
        out.extend_from_slice(&0u64.to_le_bytes());          // p_vaddr
        out.extend_from_slice(&0u64.to_le_bytes());          // p_paddr
        out.extend_from_slice(&0u64.to_le_bytes());          // p_filesz
        out.extend_from_slice(&0u64.to_le_bytes());          // p_memsz
        out.extend_from_slice(&16u64.to_le_bytes());         // p_align

        out.extend_from_slice(&self.text_section);
        out.extend_from_slice(&self.data_section);
        if has_imports {
            out.extend_from_slice(&self.got_section);
            out.extend_from_slice(&dynsym_bytes);
            out.extend_from_slice(&dynstr_bytes);
            out.extend_from_slice(&rela_bytes);
            out.extend_from_slice(&dynamic_bytes);
        }
        out
    }

    // Emit PE32+ Windows x86-64 executable
    pub fn write_pe32plus(&self) -> Vec<u8> {
        let mut out: Vec<u8> = Vec::new();
        let text_len = self.text_section.len() as u32;
        let data_len = self.data_section.len() as u32;
        let has_imports = !self.imports.is_empty();

        // Group imports by library, preserving first-seen order — one IMAGE_IMPORT_DESCRIPTOR
        // per distinct library, one ILT/IAT/hint-name entry per imported symbol.
        let mut distinct_libs: Vec<String> = Vec::new();
        let mut lib_syms: Vec<Vec<String>> = Vec::new();
        for imp in &self.imports {
            if let Some(idx) = distinct_libs.iter().position(|l| l == &imp.library_name) {
                lib_syms[idx].push(imp.symbol_name.clone());
            } else {
                distinct_libs.push(imp.library_name.clone());
                lib_syms.push(vec![imp.symbol_name.clone()]);
            }
        }

        // Real PE32+ import table binary layout, built into a synthetic `.idata` section:
        //   [Import Directory Table] (IMAGE_IMPORT_DESCRIPTOR[libs+1], null-terminated)
        //   [ILT entries per lib]  (u64[syms+1] each, null-terminated, import-by-name)
        //   [IAT entries per lib]  (identical initial contents to the ILT; the OS loader
        //                           overwrites these in place with resolved addresses)
        //   [Hint/Name table]      (u16 hint=0 + NUL-terminated name, padded to even length)
        //   [DLL name strings]     (NUL-terminated)
        let idata_rva: u32 = if data_len > 0 { 0x3000 } else { 0x2000 };
        let import_dir_size: u32 = ((distinct_libs.len() + 1) * 20) as u32;
        let mut cursor: u32 = import_dir_size;

        let mut ilt_offsets: Vec<u32> = Vec::with_capacity(distinct_libs.len());
        for syms in &lib_syms {
            ilt_offsets.push(cursor);
            cursor += ((syms.len() + 1) * 8) as u32;
        }
        let mut iat_offsets: Vec<u32> = Vec::with_capacity(distinct_libs.len());
        for syms in &lib_syms {
            iat_offsets.push(cursor);
            cursor += ((syms.len() + 1) * 8) as u32;
        }
        let mut hint_name_offsets: Vec<Vec<u32>> = Vec::with_capacity(distinct_libs.len());
        for syms in &lib_syms {
            let mut offs: Vec<u32> = Vec::with_capacity(syms.len());
            for sym in syms {
                offs.push(cursor);
                let mut entry_len = 2 + sym.len() + 1;
                if entry_len % 2 != 0 { entry_len += 1; }
                cursor += entry_len as u32;
            }
            hint_name_offsets.push(offs);
        }
        let mut dll_name_offsets: Vec<u32> = Vec::with_capacity(distinct_libs.len());
        for lib in &distinct_libs {
            dll_name_offsets.push(cursor);
            cursor += (lib.len() + 1) as u32;
        }
        let idata_total_size: u32 = cursor;

        let mut idata: Vec<u8> = vec![0u8; idata_total_size as usize];
        for (i, lib) in distinct_libs.iter().enumerate() {
            let dir_off = (i * 20) as usize;
            let ilt_rva = idata_rva + ilt_offsets[i];
            let name_rva = idata_rva + dll_name_offsets[i];
            let iat_rva = idata_rva + iat_offsets[i];
            idata[dir_off..dir_off+4].copy_from_slice(&ilt_rva.to_le_bytes());       // OriginalFirstThunk
            idata[dir_off+4..dir_off+8].copy_from_slice(&0u32.to_le_bytes());        // TimeDateStamp
            idata[dir_off+8..dir_off+12].copy_from_slice(&0u32.to_le_bytes());       // ForwarderChain
            idata[dir_off+12..dir_off+16].copy_from_slice(&name_rva.to_le_bytes());  // Name
            idata[dir_off+16..dir_off+20].copy_from_slice(&iat_rva.to_le_bytes());   // FirstThunk

            for (j, _sym) in lib_syms[i].iter().enumerate() {
                let hint_name_rva = (idata_rva + hint_name_offsets[i][j]) as u64; // bit 63 clear: import by name
                let ilt_entry_off = ilt_offsets[i] as usize + j * 8;
                let iat_entry_off = iat_offsets[i] as usize + j * 8;
                idata[ilt_entry_off..ilt_entry_off+8].copy_from_slice(&hint_name_rva.to_le_bytes());
                idata[iat_entry_off..iat_entry_off+8].copy_from_slice(&hint_name_rva.to_le_bytes());

                let hn_off = hint_name_offsets[i][j] as usize;
                // hint (u16) left as 0; name follows immediately
                let name_bytes = lib_syms[i][j].as_bytes();
                idata[hn_off+2..hn_off+2+name_bytes.len()].copy_from_slice(name_bytes);
                // trailing NUL (and optional padding byte) already zero from vec init
            }

            let dn_off = dll_name_offsets[i] as usize;
            let lib_bytes = lib.as_bytes();
            idata[dn_off..dn_off+lib_bytes.len()].copy_from_slice(lib_bytes);
        }

        // MZ header (64 bytes, e_lfanew points to PE signature)
        out.extend_from_slice(b"MZ");
        out.extend_from_slice(&[0u8; 58]);
        out.extend_from_slice(&64u32.to_le_bytes()); // e_lfanew

        // PE signature + COFF header
        out.extend_from_slice(b"PE\0\0");
        out.extend_from_slice(&0x8664u16.to_le_bytes()); // AMD64
        let num_sections: u16 = 1
            + (if data_len > 0 { 1 } else { 0 })
            + (if has_imports { 1 } else { 0 });
        out.extend_from_slice(&num_sections.to_le_bytes());
        out.extend_from_slice(&0u32.to_le_bytes()); // timestamp
        out.extend_from_slice(&0u32.to_le_bytes()); // symbol table
        out.extend_from_slice(&0u32.to_le_bytes()); // num symbols
        out.extend_from_slice(&240u16.to_le_bytes()); // size of optional header
        out.extend_from_slice(&0x22u16.to_le_bytes()); // characteristics

        // Optional header (PE32+, 240 bytes)
        out.extend_from_slice(&0x20Bu16.to_le_bytes()); // PE32+ magic
        out.extend_from_slice(&[14u8, 0u8]);
        out.extend_from_slice(&text_len.to_le_bytes());
        out.extend_from_slice(&data_len.to_le_bytes());
        out.extend_from_slice(&0u32.to_le_bytes()); // uninitialized data size

        // Entry point RVA (first byte of .text)
        let entry_rva = 0x1000u32;
        out.extend_from_slice(&entry_rva.to_le_bytes());
        out.extend_from_slice(&entry_rva.to_le_bytes()); // base of code

        // Image base 0x140000000
        out.extend_from_slice(&0x140000000u64.to_le_bytes());
        out.extend_from_slice(&0x1000u32.to_le_bytes()); // section alignment
        out.extend_from_slice(&0x200u32.to_le_bytes());  // file alignment
        out.extend_from_slice(&6u16.to_le_bytes()); out.extend_from_slice(&0u16.to_le_bytes()); // OS version
        out.extend_from_slice(&0u16.to_le_bytes()); out.extend_from_slice(&0u16.to_le_bytes()); // image version
        out.extend_from_slice(&6u16.to_le_bytes()); out.extend_from_slice(&0u16.to_le_bytes()); // subsystem version
        out.extend_from_slice(&0u32.to_le_bytes()); // Win32VersionValue
        let base_image_size = 0x3000u32;
        let image_size = if has_imports {
            let end = idata_rva + idata_total_size;
            (((end + 0xFFF) / 0x1000) * 0x1000).max(base_image_size)
        } else {
            base_image_size
        };
        out.extend_from_slice(&image_size.to_le_bytes()); // SizeOfImage
        out.extend_from_slice(&512u32.to_le_bytes()); // SizeOfHeaders
        out.extend_from_slice(&0u32.to_le_bytes()); // CheckSum
        out.extend_from_slice(&3u16.to_le_bytes()); // Subsystem: CUI
        out.extend_from_slice(&0u16.to_le_bytes()); // DllCharacteristics
        out.extend_from_slice(&0x100000u64.to_le_bytes()); // stack reserve
        out.extend_from_slice(&0x1000u64.to_le_bytes());   // stack commit
        out.extend_from_slice(&0x100000u64.to_le_bytes()); // heap reserve
        out.extend_from_slice(&0x1000u64.to_le_bytes());   // heap commit
        out.extend_from_slice(&0u32.to_le_bytes()); // loader flags
        out.extend_from_slice(&16u32.to_le_bytes()); // RVA/sizes count
        // DataDirectory (16 x 8 bytes). Entry 1 = Import Table (RVA, size); all others
        // (including entry 12, IAT) are left zero — see write_pe32plus's honest-scope note.
        if has_imports {
            out.extend_from_slice(&idata_rva.to_le_bytes());
            out.extend_from_slice(&import_dir_size.to_le_bytes());
            out.extend_from_slice(&[0u8; 112]); // remaining 14 directory entries
        } else {
            out.extend_from_slice(&[0u8; 128]);
        }

        // Section: .text
        out.extend_from_slice(b".text\0\0\0");
        out.extend_from_slice(&text_len.to_le_bytes());
        out.extend_from_slice(&0x1000u32.to_le_bytes()); // VirtualAddress
        let file_text = if text_len % 512 == 0 { text_len } else { (text_len / 512 + 1) * 512 };
        out.extend_from_slice(&file_text.to_le_bytes()); // SizeOfRawData
        out.extend_from_slice(&512u32.to_le_bytes());    // PointerToRawData
        out.extend_from_slice(&[0u8; 12]);
        out.extend_from_slice(&0x60000020u32.to_le_bytes()); // CODE|EXEC|READ

        let file_data = if data_len % 512 == 0 { data_len } else { (data_len / 512 + 1) * 512 };
        if data_len > 0 {
            // Section: .data
            out.extend_from_slice(b".data\0\0\0");
            out.extend_from_slice(&data_len.to_le_bytes());
            out.extend_from_slice(&0x2000u32.to_le_bytes());
            out.extend_from_slice(&file_data.to_le_bytes());
            out.extend_from_slice(&(512u32 + file_text).to_le_bytes());
            out.extend_from_slice(&[0u8; 12]);
            out.extend_from_slice(&0xC0000040u32.to_le_bytes()); // INIT_DATA|READ|WRITE
        }

        let idata_file_off: u32 = 512 + file_text + (if data_len > 0 { file_data } else { 0 });
        let file_idata = if idata_total_size % 512 == 0 { idata_total_size } else { (idata_total_size / 512 + 1) * 512 };
        if has_imports {
            // Section: .idata (Import Directory Table + ILT/IAT + hint/name + DLL names)
            out.extend_from_slice(b".idata\0\0");
            out.extend_from_slice(&idata_total_size.to_le_bytes());
            out.extend_from_slice(&idata_rva.to_le_bytes());
            out.extend_from_slice(&file_idata.to_le_bytes());
            out.extend_from_slice(&idata_file_off.to_le_bytes());
            out.extend_from_slice(&[0u8; 12]);
            out.extend_from_slice(&0xC0000040u32.to_le_bytes()); // INIT_DATA|READ|WRITE
        }

        // Pad to 512 (file alignment)
        while out.len() % 512 != 0 { out.push(0); }
        out.extend_from_slice(&self.text_section);
        while out.len() % 512 != 0 { out.push(0); }
        if data_len > 0 {
            out.extend_from_slice(&self.data_section);
            while out.len() % 512 != 0 { out.push(0); }
        }
        if has_imports {
            out.extend_from_slice(&idata);
            while out.len() % 512 != 0 { out.push(0); }
        }
        out
    }

    // Top-level link driver
    pub fn link_and_emit(&mut self, target: &str) -> Result<Vec<u8>, String> {
        println!("  [Linker] Resolving symbols...");
        self.resolve_symbols()?;

        println!("  [Linker] Dead code elimination...");
        self.eliminate_dead_code();

        println!("  [Linker] Placing sections...");
        self.place_sections();

        println!("  [Linker] Applying relocations...");
        self.apply_relocations()?;

        println!("  [Linker] Writing binary ({})...", target);
        let binary = match target {
            "elf64"    => self.write_elf64(),
            "pe32plus" => self.write_pe32plus(),
            _          => return Err(format!("Unknown target: {}", target)),
        };

        self.output_binary = binary.clone();

        println!("  [Linker] Binary: {} bytes", self.output_binary.len());
        println!("  [Linker] Symbols: {} global", self.global_symbols.len());
        println!("  [Linker] .text: {} bytes, .data: {} bytes", self.text_section.len(), self.data_section.len());

        Ok(binary)
    }

    pub fn print_status(&self) {
        println!("╔════════════════════════════════════════════════════╗");
        println!("║          OMNISYSTEM LINKER STATUS                  ║");
        println!("╠════════════════════════════════════════════════════╣");
        println!("║  Object files:      {}                             ║", self.object_files.len());
        println!("║  Global symbols:    {}                             ║", self.global_symbols.len());
        println!("║  .text size:        {} bytes                       ║", self.text_section.len());
        println!("║  .data size:        {} bytes                       ║", self.data_section.len());
        println!("║  Output binary:     {} bytes                       ║", self.output_binary.len());
        println!("╚════════════════════════════════════════════════════╝");
    }
}

fn main() -> Result<(), String> {
    println!("╔════════════════════════════════════════════════════════════════════════╗");
    println!("║  OMNISYSTEM CROSS-LANGUAGE LINKER                                     ║");
    println!("║  Symbol Resolution | Relocation | DCE | ELF64/PE32+                  ║");
    println!("╚════════════════════════════════════════════════════════════════════════╝");
    println!("");

    let mut linker = OmniLinker::new("omnisystem_linker".to_string());

    // Object 1: TITAN main module
    let mut obj1 = ObjectFile::new("obj_titan_main".to_string(), "TITAN".to_string());
    obj1.code_section = vec![
        0x48, 0x89, 0xC0,  // mov rax, rax
        0x48, 0x31, 0xC0,  // xor rax, rax
        0xC3,              // ret
    ];
    obj1.add_symbol(Symbol {
        symbol_id: "s1".to_string(),
        symbol_name: "main".to_string(),
        address: 0,
        size: 7,
        visibility: "public".to_string(),
        source_language: "TITAN".to_string(),
        is_function: true,
        reachable: false,
    });

    // Object 2: VERA UI module
    let mut obj2 = ObjectFile::new("obj_vera_ui".to_string(), "VERA".to_string());
    obj2.code_section = vec![
        0x90, 0x90, 0x90, 0xC3  // nop nop nop ret
    ];
    obj2.add_symbol(Symbol {
        symbol_id: "s2".to_string(),
        symbol_name: "render_ui".to_string(),
        address: 0,
        size: 4,
        visibility: "public".to_string(),
        source_language: "VERA".to_string(),
        is_function: true,
        reachable: false,
    });
    obj2.add_relocation(Relocation {
        relocation_id: "r1".to_string(),
        symbol_name: "main".to_string(),
        offset: 0,
        relocation_type: RelocationType::Relative32,
        addend: 0,
    });

    linker.add_object(obj1)?;
    linker.add_object(obj2)?;

    let binary = linker.link_and_emit("elf64")?;

    println!("");
    linker.print_status();

    // Verify ELF magic
    let elf_magic = binary.len() >= 4 && binary[0] == 0x7F && binary[1] == b'E' && binary[2] == b'L' && binary[3] == b'F';
    println!("\n✓ ELF64 magic bytes: {}", elf_magic);
    println!("✓ Binary first 8 bytes: {:02X?}", &binary[..8.min(binary.len())]);
    println!("✓ OmniLinker operational — cross-language linking complete");

    Ok(())
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_symbol_resolution() {
        let mut linker = OmniLinker::new("test".to_string());
        let mut obj = ObjectFile::new("obj1".to_string(), "TITAN".to_string());
        obj.code_section = vec![0xC3];
        obj.add_symbol(Symbol {
            symbol_id: "s1".to_string(),
            symbol_name: "test_fn".to_string(),
            address: 0,
            size: 1,
            visibility: "public".to_string(),
            source_language: "TITAN".to_string(),
            is_function: true,
            reachable: false,
        });
        let _ = linker.add_object(obj);
        assert!(linker.resolve_symbols().is_ok());
        assert!(linker.global_symbols.contains_key("test_fn"));
    }

    #[test]
    fn test_elf64_magic_bytes() {
        let linker = OmniLinker::new("test".to_string());
        let elf = linker.write_elf64();
        assert_eq!(&elf[0..4], &[0x7F, b'E', b'L', b'F']);
    }

    #[test]
    fn test_pe32plus_mz_header() {
        let linker = OmniLinker::new("test".to_string());
        let pe = linker.write_pe32plus();
        assert_eq!(&pe[0..2], b"MZ");
    }

    #[test]
    fn test_duplicate_symbol_error() {
        let mut linker = OmniLinker::new("test".to_string());
        let mut obj1 = ObjectFile::new("o1".to_string(), "TITAN".to_string());
        let mut obj2 = ObjectFile::new("o2".to_string(), "TITAN".to_string());
        for obj in [&mut obj1, &mut obj2] {
            obj.add_symbol(Symbol {
                symbol_id: "dup".to_string(),
                symbol_name: "duplicate_fn".to_string(),
                address: 0, size: 1,
                visibility: "public".to_string(),
                source_language: "TITAN".to_string(),
                is_function: true,
                reachable: false,
            });
        }
        let _ = linker.add_object(obj1);
        let _ = linker.add_object(obj2);
        assert!(linker.resolve_symbols().is_err());
    }
}
