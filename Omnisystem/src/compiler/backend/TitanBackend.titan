// ─────────────────────────────────────────────────────────────────────────────────────────────────────────
// X86-64 INSTRUCTION ENCODER
// ─────────────────────────────────────────────────────────────────────────────────────────────────────────

pub struct X86_64Encoder {
    code: Vec<u8>,
}

impl X86_64Encoder {
    pub fn new() -> Self {
        X86_64Encoder { code: Vec::new() }
    }

    fn emit_modrm(&mut self, mode: u8, reg: u8, rm: u8) {
        self.code.push((mode << 6) | (reg << 3) | rm);
    }

    fn emit_sib(&mut self, scale: u8, index: u8, base: u8) {
        self.code.push((scale << 6) | (index << 3) | base);
    }

    fn emit_rex(&mut self, w: bool, r: bool, x: bool, b: bool) {
        let mut byte = 0x40u8;
        if w { byte |= 0x08; }
        if r { byte |= 0x04; }
        if x { byte |= 0x02; }
        if b { byte |= 0x01; }
        self.code.push(byte);
    }

    // MOV reg64, reg64: 48 89 /r
    pub fn encode_mov_reg_reg(&mut self, dst: X86_64Reg, src: X86_64Reg) {
        self.emit_rex(true, false, false, false);
        self.code.push(0x89);
        self.emit_modrm(3, src.encoding(), dst.encoding());
    }

    // MOV reg64, imm64: 48 B8 /imm64
    pub fn encode_mov_reg_imm(&mut self, dst: X86_64Reg, imm: i64) {
        self.emit_rex(true, false, false, false);
        self.code.push(0xB8 + dst.encoding());
        for i in 0..8 {
            self.code.push((imm >> (i * 8)) as u8);
        }
    }

    // ADD reg64, reg64: 48 01 /r
    pub fn encode_add_reg_reg(&mut self, dst: X86_64Reg, src: X86_64Reg) {
        self.emit_rex(true, false, false, false);
        self.code.push(0x01);
        self.emit_modrm(3, src.encoding(), dst.encoding());
    }

    // SUB reg64, reg64: 48 29 /r
    pub fn encode_sub_reg_reg(&mut self, dst: X86_64Reg, src: X86_64Reg) {
        self.emit_rex(true, false, false, false);
        self.code.push(0x29);
        self.emit_modrm(3, src.encoding(), dst.encoding());
    }

    // IMUL reg64, reg64, imm32: 48 69 /r id
    pub fn encode_imul_reg_reg_imm(&mut self, dst: X86_64Reg, src: X86_64Reg, imm: i32) {
        self.emit_rex(true, false, false, false);
        self.code.push(0x69);
        self.emit_modrm(3, dst.encoding(), src.encoding());
        for i in 0..4 {
            self.code.push((imm >> (i * 8)) as u8);
        }
    }

    // XOR reg64, reg64: 48 31 /r
    pub fn encode_xor_reg_reg(&mut self, dst: X86_64Reg, src: X86_64Reg) {
        self.emit_rex(true, false, false, false);
        self.code.push(0x31);
        self.emit_modrm(3, src.encoding(), dst.encoding());
    }

    // CMP reg64, reg64: 48 39 /r
    pub fn encode_cmp_reg_reg(&mut self, dst: X86_64Reg, src: X86_64Reg) {
        self.emit_rex(true, false, false, false);
        self.code.push(0x39);
        self.emit_modrm(3, src.encoding(), dst.encoding());
    }

    // JMP rel32: E9 cd
    pub fn encode_jmp(&mut self, offset: i32) {
        self.code.push(0xE9);
        for i in 0..4 {
            self.code.push((offset >> (i * 8)) as u8);
        }
    }

    // JZ rel32: 0F 84 cd
    pub fn encode_jz(&mut self, offset: i32) {
        self.code.push(0x0F);
        self.code.push(0x84);
        for i in 0..4 {
            self.code.push((offset >> (i * 8)) as u8);
        }
    }

    // RET: C3
    pub fn encode_ret(&mut self) {
        self.code.push(0xC3);
    }

    // PUSH reg64: 50 +r
    pub fn encode_push(&mut self, reg: X86_64Reg) {
        self.code.push(0x50 + reg.encoding());
    }

    // POP reg64: 58 +r
    pub fn encode_pop(&mut self, reg: X86_64Reg) {
        self.code.push(0x58 + reg.encoding());
    }

    pub fn get_code(&self) -> Vec<u8> {
        self.code.clone()
    }
}

// ─────────────────────────────────────────────────────────────────────────────────────────────────────────
// ARM64 INSTRUCTION ENCODER
// ─────────────────────────────────────────────────────────────────────────────────────────────────────────

pub struct ARM64Encoder {
    code: Vec<u32>,
}

impl ARM64Encoder {
    pub fn new() -> Self {
        ARM64Encoder { code: Vec::new() }
    }

    // MOV (register): 0xAA000000 | (shift << 22) | (src << 16) | (dst << 0)
    pub fn encode_mov_reg_reg(&mut self, dst: ARM64Reg, src: ARM64Reg) {
        let instr = 0xAA000000u32 | ((src.encoding() as u32) << 16) | (dst.encoding() as u32);
        self.code.push(instr);
    }

    // MOV (immediate): 0xD2800000 | (imm << 5) | (dst << 0)
    pub fn encode_mov_reg_imm(&mut self, dst: ARM64Reg, imm: u16) {
        let instr = 0xD2800000u32 | ((imm as u32) << 5) | (dst.encoding() as u32);
        self.code.push(instr);
    }

    // ADD: 0x8B000000 | (src2 << 16) | (src1 << 5) | (dst << 0)
    pub fn encode_add_reg_reg(&mut self, dst: ARM64Reg, src1: ARM64Reg, src2: ARM64Reg) {
        let instr = 0x8B000000u32 | ((src2.encoding() as u32) << 16) | ((src1.encoding() as u32) << 5) | (dst.encoding() as u32);
        self.code.push(instr);
    }

    // SUB: 0xCB000000 | (src2 << 16) | (src1 << 5) | (dst << 0)
    pub fn encode_sub_reg_reg(&mut self, dst: ARM64Reg, src1: ARM64Reg, src2: ARM64Reg) {
        let instr = 0xCB000000u32 | ((src2.encoding() as u32) << 16) | ((src1.encoding() as u32) << 5) | (dst.encoding() as u32);
        self.code.push(instr);
    }

    // MUL: 0x9B007C00 | (src2 << 16) | (src1 << 5) | (dst << 0)
    pub fn encode_mul_reg_reg(&mut self, dst: ARM64Reg, src1: ARM64Reg, src2: ARM64Reg) {
        let instr = 0x9B007C00u32 | ((src2.encoding() as u32) << 16) | ((src1.encoding() as u32) << 5) | (dst.encoding() as u32);
        self.code.push(instr);
    }

    // B (Branch): 0x14000000 | (offset << 0)
    pub fn encode_b(&mut self, offset: i32) {
        let instr = 0x14000000u32 | ((offset as u32) & 0x3FFFFFF);
        self.code.push(instr);
    }

    // BL (Branch with Link): 0x94000000 | (offset << 0)
    pub fn encode_bl(&mut self, offset: i32) {
        let instr = 0x94000000u32 | ((offset as u32) & 0x3FFFFFF);
        self.code.push(instr);
    }

    // RET: 0xD65F03C0 (RET X30)
    pub fn encode_ret(&mut self) {
        self.code.push(0xD65F03C0u32);
    }

    // LDR: 0xF8400000 | (src << 16) | (dst << 0)
    pub fn encode_ldr(&mut self, dst: ARM64Reg, src: ARM64Reg) {
        let instr = 0xF8400000u32 | ((src.encoding() as u32) << 16) | (dst.encoding() as u32);
        self.code.push(instr);
    }

    // STR: 0xF8000000 | (src << 16) | (dst << 0)
    pub fn encode_str(&mut self, src: ARM64Reg, dst: ARM64Reg) {
        let instr = 0xF8000000u32 | ((src.encoding() as u32) << 16) | (dst.encoding() as u32);
        self.code.push(instr);
    }

    pub fn get_code(&self) -> Vec<u32> {
        self.code.clone()
    }
}

// ─────────────────────────────────────────────────────────────────────────────────────────────────────────
// REGISTER ALLOCATOR
// ─────────────────────────────────────────────────────────────────────────────────────────────────────────

pub struct RegisterAllocator {
    free_registers: Vec<X86_64Reg>,
    var_to_register: HashMap<String, X86_64Reg>,
}

impl RegisterAllocator {
    pub fn new() -> Self {
        RegisterAllocator {
            free_registers: vec![
                X86_64Reg::Rax, X86_64Reg::Rbx, X86_64Reg::Rcx, X86_64Reg::Rdx,
                X86_64Reg::Rsi, X86_64Reg::Rdi, X86_64Reg::R8, X86_64Reg::R9,
                X86_64Reg::R10, X86_64Reg::R11,
            ],
            var_to_register: HashMap::new(),
        }
    }

    pub fn allocate(&mut self, var: String) -> Option<X86_64Reg> {
        if !self.free_registers.is_empty() {
            let reg = self.free_registers.remove(0);
            self.var_to_register.insert(var, reg);
            Some(reg)
        } else {
            None
        }
    }

    pub fn get_register(&self, var: &str) -> Option<X86_64Reg> {
        self.var_to_register.get(var).copied()
    }

    pub fn free(&mut self, var: &str) -> Option<X86_64Reg> {
        if let Some(reg) = self.var_to_register.remove(var) {
            self.free_registers.push(reg);
            Some(reg)
        } else {
            None
        }
    }
}

// ─────────────────────────────────────────────────────────────────────────────────────────────────────────
// BACKEND COMPILER
// ─────────────────────────────────────────────────────────────────────────────────────────────────────────

pub struct TitanBackend {
    ir_module: IrModule,
}

impl TitanBackend {
    pub fn new(ir_module: IrModule) -> Self {
        TitanBackend { ir_module }
    }

    pub fn lower_to_x86_64(&self) -> Result<Vec<u8>, String> {
        let mut encoder = X86_64Encoder::new();
        let mut allocator = RegisterAllocator::new();

        for (func_name, func) in &self.ir_module.functions {
            for instr in &func.instructions {
                match instr.opcode {
                    IrOpcode::Mov => {
                        if let (Some(dst_reg), Some(src_reg)) = (
                            allocator.get_register(&instr.dest),
                            allocator.get_register(&instr.src1),
                        ) {
                            encoder.encode_mov_reg_reg(dst_reg, src_reg);
                        }
                    }
                    IrOpcode::Add => {
                        if let (Some(dst_reg), Some(src_reg)) = (
                            allocator.get_register(&instr.dest),
                            allocator.get_register(&instr.src1),
                        ) {
                            encoder.encode_add_reg_reg(dst_reg, src_reg);
                        }
                    }
                    IrOpcode::Sub => {
                        if let (Some(dst_reg), Some(src_reg)) = (
                            allocator.get_register(&instr.dest),
                            allocator.get_register(&instr.src1),
                        ) {
                            encoder.encode_sub_reg_reg(dst_reg, src_reg);
                        }
                    }
                    IrOpcode::Ret => {
                        encoder.encode_ret();
                    }
                    _ => {}
                }
            }
        }

        Ok(encoder.get_code())
    }

    pub fn lower_to_arm64(&self) -> Result<Vec<u32>, String> {
        let mut encoder = ARM64Encoder::new();

        for (func_name, func) in &self.ir_module.functions {
            for instr in &func.instructions {
                match instr.opcode {
                    IrOpcode::Mov => {
                        if let Some(imm) = instr.immediate {
                            encoder.encode_mov_reg_imm(ARM64Reg::X0, imm as u16);
                        }
                    }
                    IrOpcode::Add => {
                        encoder.encode_add_reg_reg(ARM64Reg::X0, ARM64Reg::X1, ARM64Reg::X2);
                    }
                    IrOpcode::Ret => {
                        encoder.encode_ret();
                    }
                    _ => {}
                }
            }
        }

        Ok(encoder.get_code())
    }
}

pub fn main() {
    println!("╔════════════════════════════════════════════════════════════════╗");
    println!("║              TITAN BACKEND COMPILER v1.0                      ║");
    println!("║        SSA IR | x86-64 Encoding | ARM64 Encoding              ║");
    println!("╚════════════════════════════════════════════════════════════════╝\n");

    // Create sample IR module
    let mut module = IrModule::new();
    let mut func = IrFunction::new("main".to_string(), "i32".to_string());

    let mut instr1 = IrInstruction::new(IrOpcode::Mov);
    instr1.dest = "x".to_string();
    instr1.immediate = Some(42);
    func.instructions.push(instr1);

    let mut instr2 = IrInstruction::new(IrOpcode::Mov);
    instr2.dest = "y".to_string();
    instr2.immediate = Some(10);
    func.instructions.push(instr2);

    let mut instr3 = IrInstruction::new(IrOpcode::Add);
    instr3.dest = "result".to_string();
    instr3.src1 = "x".to_string();
    instr3.src2 = Some("y".to_string());
    func.instructions.push(instr3);

    let mut instr4 = IrInstruction::new(IrOpcode::Ret);
    instr4.src1 = "result".to_string();
    func.instructions.push(instr4);

    module.functions.insert("main".to_string(), func);

    let backend = TitanBackend::new(module);

    match backend.lower_to_x86_64() {
        Ok(code) => {
            println!("✓ x86-64 code generation successful");
            println!("✓ Generated {} bytes of machine code", code.len());
        }
        Err(e) => println!("✗ Error: {}", e),
    }

    match backend.lower_to_arm64() {
        Ok(code) => {
            println!("✓ ARM64 code generation successful");
            println!("✓ Generated {} instructions", code.len());
        }
        Err(e) => println!("✗ Error: {}", e),
    }

    println!("\n✓ TitanBackend operational - machine code generation complete");
}
