use std::collections::HashMap;

// ─────────────────────────────────────────────────────────────────────────────────────────────────────────
// INTERMEDIATE REPRESENTATION (IR) TYPES
// ─────────────────────────────────────────────────────────────────────────────────────────────────────────

#[derive(Clone, Copy, Debug, PartialEq)]
pub enum IrOpcode {
    Add,
    Sub,
    Mul,
    Div,
    Mod,
    And,
    Or,
    Xor,
    Shl,
    Shr,
    Mov,
    Ld,
    St,
    Call,
    Ret,
    Jmp,
    Jz,
    Jnz,
    Cmp,
    Phi,
}

impl IrOpcode {
    pub fn name(&self) -> &str {
        match self {
            IrOpcode::Add => "add",
            IrOpcode::Sub => "sub",
            IrOpcode::Mul => "mul",
            IrOpcode::Div => "div",
            IrOpcode::Mod => "mod",
            IrOpcode::And => "and",
            IrOpcode::Or => "or",
            IrOpcode::Xor => "xor",
            IrOpcode::Shl => "shl",
            IrOpcode::Shr => "shr",
            IrOpcode::Mov => "mov",
            IrOpcode::Ld => "ld",
            IrOpcode::St => "st",
            IrOpcode::Call => "call",
            IrOpcode::Ret => "ret",
            IrOpcode::Jmp => "jmp",
            IrOpcode::Jz => "jz",
            IrOpcode::Jnz => "jnz",
            IrOpcode::Cmp => "cmp",
            IrOpcode::Phi => "phi",
        }
    }
}

#[derive(Clone, Debug)]
pub struct IrInstruction {
    pub opcode: IrOpcode,
    pub dest: String,
    pub src1: String,
    pub src2: Option<String>,
    pub immediate: Option<i64>,
    pub block_label: String,
}

impl IrInstruction {
    pub fn new(opcode: IrOpcode) -> Self {
        IrInstruction {
            opcode,
            dest: String::new(),
            src1: String::new(),
            src2: None,
            immediate: None,
            block_label: String::new(),
        }
    }
}

#[derive(Clone, Debug)]
pub struct IrFunction {
    pub name: String,
    pub instructions: Vec<IrInstruction>,
    pub basic_blocks: Vec<String>,
    pub return_type: String,
}

impl IrFunction {
    pub fn new(name: String, return_type: String) -> Self {
        IrFunction {
            name,
            instructions: Vec::new(),
            basic_blocks: Vec::new(),
            return_type,
        }
    }
}

#[derive(Clone, Debug)]
pub struct IrModule {
    pub functions: HashMap<String, IrFunction>,
    pub globals: HashMap<String, String>,
}

impl IrModule {
    pub fn new() -> Self {
        IrModule {
            functions: HashMap::new(),
            globals: HashMap::new(),
        }
    }
}

// ─────────────────────────────────────────────────────────────────────────────────────────────────────────
// MACHINE CODE ENCODING
// ─────────────────────────────────────────────────────────────────────────────────────────────────────────

#[derive(Clone, Copy, Debug, PartialEq)]
pub enum X86_64Reg {
    Rax,
    Rbx,
    Rcx,
    Rdx,
    Rsi,
    Rdi,
    Rbp,
    Rsp,
    R8,
    R9,
    R10,
    R11,
    R12,
    R13,
    R14,
    R15,
}

impl X86_64Reg {
    pub fn encoding(&self) -> u8 {
        match self {
            X86_64Reg::Rax => 0,
            X86_64Reg::Rcx => 1,
            X86_64Reg::Rdx => 2,
            X86_64Reg::Rbx => 3,
            X86_64Reg::Rsp => 4,
            X86_64Reg::Rbp => 5,
            X86_64Reg::Rsi => 6,
            X86_64Reg::Rdi => 7,
            X86_64Reg::R8 => 8,
            X86_64Reg::R9 => 9,
            X86_64Reg::R10 => 10,
            X86_64Reg::R11 => 11,
            X86_64Reg::R12 => 12,
            X86_64Reg::R13 => 13,
            X86_64Reg::R14 => 14,
            X86_64Reg::R15 => 15,
        }
    }

    pub fn name(&self) -> &str {
        match self {
            X86_64Reg::Rax => "rax",
            X86_64Reg::Rbx => "rbx",
            X86_64Reg::Rcx => "rcx",
            X86_64Reg::Rdx => "rdx",
            X86_64Reg::Rsi => "rsi",
            X86_64Reg::Rdi => "rdi",
            X86_64Reg::Rbp => "rbp",
            X86_64Reg::Rsp => "rsp",
            X86_64Reg::R8 => "r8",
            X86_64Reg::R9 => "r9",
            X86_64Reg::R10 => "r10",
            X86_64Reg::R11 => "r11",
            X86_64Reg::R12 => "r12",
            X86_64Reg::R13 => "r13",
            X86_64Reg::R14 => "r14",
            X86_64Reg::R15 => "r15",
        }
    }
}

