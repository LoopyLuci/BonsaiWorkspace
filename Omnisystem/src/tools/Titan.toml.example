# TITAN PROJECT MANIFEST - Example for TitanBuild
# Location: Titan.toml
# Format: TOML (Tom's Obvious, Minimal Language)
# This file defines your Titan project's metadata, dependencies, and build configuration

[package]
name = "my-awesome-app"
version = "1.0.0"
edition = "2026"
authors = ["Luci <rechargedideas@gmail.com>"]
description = "A professional application built with Titan"
license = "MIT"
repository = "https://github.com/user/my-awesome-app"
homepage = "https://my-awesome-app.dev"
documentation = "https://docs.my-awesome-app.dev"
keywords = ["app", "productivity", "titan"]
categories = ["applications", "productivity"]

# ============================================================================
# DEPENDENCIES - Production dependencies
# Version specifications:
#   "1.0"      - Exact version
#   "^1.0"     - Compatible version (1.x, not 2.0)
#   "~1.0"     - Approximately version (1.0.x)
#   "1.0.*"    - Wildcard version
#   ">=1.0,<2" - Range
# ============================================================================

[dependencies]
# Core framework dependencies
serde = "1.0"                    # Serialization/deserialization
serde_json = "^1.0"              # JSON support
tokio = { version = "1.0", features = ["full"] }  # Async runtime
# Multiple features: comma-separated in features array
uuid = { version = "1.0", features = ["v4", "serde"] }

# Database and storage
sqlx = { version = "0.7", features = ["postgres", "runtime-tokio"] }
redis = "0.24"
sqlite = "^3.0"

# HTTP and networking
reqwest = { version = "0.11", features = ["json"] }
axum = "0.7"                     # Web framework
tower = "0.4"
tower-http = { version = "0.5", features = ["cors"] }

# Utilities
anyhow = "1.0"                   # Error handling
thiserror = "1.0"
log = "0.4"
env_logger = "0.10"
chrono = "0.4"

# UI and Graphics (Omnisystem integration)
bonsai-ui = "1.0"                # Bonsai UI components
sylva = "1.0"                    # Graphics/visualization
aether = "1.0"                   # Audio/multimedia
axiom = "1.0"                    # Mathematical/cryptographic

# Configuration and file handling
toml = "0.8"
yaml = "0.9"
dotenv = "0.15"

# Testing utilities (available in dev)
mockito = "1.2"
rand = "0.8"

# ============================================================================
# DEV-DEPENDENCIES - Used only in testing and development
# ============================================================================

[dev-dependencies]
criterion = "0.5"                # Benchmarking framework
proptest = "1.0"                 # Property-based testing
tokio-test = "0.4"
test-case = "2.0"
fake = { version = "2.4", features = ["chrono"] }

# ============================================================================
# BUILD-DEPENDENCIES - Used in build.titan scripts
# ============================================================================

[build-dependencies]
titan-build-tools = "1.0"        # Build script utilities
serde_json = "1.0"
walkdir = "2.4"

# ============================================================================
# FEATURES - Feature flags for conditional compilation
# Format: feature_name = ["optional_dependencies"]
# ============================================================================

[features]
default = ["web", "database"]
all = ["web", "database", "analytics", "mobile"]

# Feature combinations
web = ["axum", "tower-http"]
database = ["sqlx", "sqlite"]
analytics = ["serde", "serde_json"]
mobile = ["bonsai-ui"]
performance = ["tokio/rt-multi-thread"]
experimental = ["uuid/serde"]

# ============================================================================
# BUILD PROFILES
# ============================================================================

[profile.dev]
opt-level = 0          # No optimization
debug = true           # Include debug symbols
lto = false            # No link-time optimization
codegen-units = 256    # Faster compilation, larger binary
split-debuginfo = "packed"
incremental = true

[profile.release]
opt-level = 3          # Maximum optimization
debug = false          # Strip debug symbols
lto = true             # Enable link-time optimization
codegen-units = 1      # Slower compilation, smaller/faster binary
strip = true           # Strip symbols
split-debuginfo = "packed"

[profile.bench]
inherits = "release"
lto = "thin"

# ============================================================================
# WORKSPACE CONFIGURATION (for monorepos)
# ============================================================================

[workspace]
members = [
    "crates/core",
    "crates/ui",
    "crates/api",
    "tools/cli"
]
exclude = ["target"]
resolver = "2"

# Workspace-wide dependencies
[workspace.dependencies]
serde = { version = "1.0", features = ["derive"] }
tokio = { version = "1", features = ["full"] }

# ============================================================================
# CUSTOM METADATA
# ============================================================================

[package.metadata]
docs-rs = { features = ["web", "database"] }

[package.metadata.docs.rs]
all-features = true
rustdoc-args = ["--cfg", "docsrs"]

# ============================================================================
# BINARY TARGETS (executables and libraries)
# These are auto-detected but can be explicitly configured
# ============================================================================

[[bin]]
name = "my-app"           # Executable name
path = "src/main.titan"   # Source file
required-features = []    # Features required to build

[[lib]]
name = "my_awesome_app"   # Library name
path = "src/lib.titan"    # Source file
crate-type = ["rlib"]     # Rust lib, can also be ["dylib", "staticlib"]

# ============================================================================
# INTEGRATION TESTS
# ============================================================================

[[test]]
name = "integration_tests"
path = "tests/integration.titan"

[[test]]
name = "api_tests"
path = "tests/api.titan"

# ============================================================================
# BENCHMARKS
# ============================================================================

[[bench]]
name = "performance"
path = "benches/performance.titan"
harness = true

# ============================================================================
# BUILD CONFIGURATION
# ============================================================================

[build-system]
build-backend = "titan-build"
requires = ["titan-build >= 3.0"]

# ============================================================================
# PUBLISHING CONFIGURATION
# ============================================================================

[publish]
registry = "https://registry.titanlang.org"
exclude = [
    ".git",
    ".gitignore",
    "target/",
    "*.swp",
    ".DS_Store"
]

# ============================================================================
# EXAMPLE USAGE WITH TITAN COMMAND LINE
# ============================================================================

# Create new project:
#   $ titan new my-awesome-app
#
# Build project:
#   $ titan build                          # Dev mode
#   $ titan build --release                # Release mode
#
# Run project:
#   $ titan run                            # Compile and run
#   $ titan run -- arg1 arg2               # With arguments
#
# Add dependencies:
#   $ titan add serde ^1.0
#   $ titan add tokio --features full
#
# Remove dependencies:
#   $ titan remove unused-crate
#
# Testing:
#   $ titan test                           # All tests
#   $ titan test unit_tests                # Specific test
#   $ titan test --doc                     # Doc tests only
#
# Benchmarking:
#   $ titan bench                          # Run all benchmarks
#   $ titan bench performance              # Specific benchmark
#
# Documentation:
#   $ titan doc                            # Generate docs
#   $ titan doc --open                     # Generate and open in browser
#
# Publishing:
#   $ titan publish                        # Publish to registry
#   $ titan search my-package              # Search registry
#
# Update and check:
#   $ titan update                         # Update lock file
#   $ titan check                          # Type check
#   $ titan clean                          # Remove build artifacts
