// OmniLint Rules Database
// Comprehensive lint rules for impossible-to-compile patterns
// Phase 205

use omnisystem::{Vec, HashMap, Option, Result, String}

struct RuleCategory {
    name: String,
    rules: Vec<String>
}

struct DetailedRule {
    id: String,
    category: String,
    name: String,
    description: String,
    severity: String,
    applicable_to: Vec<String>,
    code_example_bad: String,
    code_example_good: String,
    auto_fixable: bool,
    fix_explanation: String
}

// OMNISYSTEM LANGUAGE RULES
// These rules apply to all Omnisystem languages

pub const OMNISYSTEM_RULES: Vec<DetailedRule> = vec![
    // Error Handling Rules
    DetailedRule {
        id: "OMNI_001".to_string(),
        category: "error_handling".to_string(),
        name: "Unhandled Result Type".to_string(),
        description: "All Result types must be explicitly matched or handled".to_string(),
        severity: "error".to_string(),
        applicable_to: vec!["titan", "vera", "helix", "aether", "sylva", "axiom", "nexus"].iter().map(|s| s.to_string()).collect(),
        code_example_bad: "let data = load_file(\"config.json\")\nprintln(data)".to_string(),
        code_example_good: "match load_file(\"config.json\") {\n    Ok(data) => println(data),\n    Err(e) => handle_error(e)\n}".to_string(),
        auto_fixable: false,
        fix_explanation: "Add explicit error handling with match statement".to_string()
    },

    DetailedRule {
        id: "OMNI_002".to_string(),
        category: "error_handling".to_string(),
        name: "Forbidden unwrap() Call".to_string(),
        description: "unwrap(), expect(), panic() are not allowed in language".to_string(),
        severity: "error".to_string(),
        applicable_to: vec!["titan", "vera", "helix", "aether", "sylva", "axiom", "nexus"].iter().map(|s| s.to_string()).collect(),
        code_example_bad: "let data = result.unwrap()".to_string(),
        code_example_good: "let data = result?".to_string(),
        auto_fixable: true,
        fix_explanation: "Replace unwrap() with ? operator for error propagation".to_string()
    },

    // Pattern Matching Rules
    DetailedRule {
        id: "OMNI_003".to_string(),
        category: "pattern_matching".to_string(),
        name: "Non-Exhaustive Pattern Match".to_string(),
        description: "All match statements must cover all enum variants".to_string(),
        severity: "error".to_string(),
        applicable_to: vec!["titan", "vera", "helix", "aether", "sylva", "axiom", "nexus"].iter().map(|s| s.to_string()).collect(),
        code_example_bad: "match status {\n    Status::Pending => {},\n    Status::Running => {}\n}".to_string(),
        code_example_good: "match status {\n    Status::Pending => {},\n    Status::Running => {},\n    Status::Complete => {}\n}".to_string(),
        auto_fixable: false,
        fix_explanation: "Add match arm for missing variant or use catch-all pattern".to_string()
    },

    // Type Safety Rules
    DetailedRule {
        id: "OMNI_004".to_string(),
        category: "type_safety".to_string(),
        name: "Missing Type Annotation".to_string(),
        description: "Types must be explicit in public function signatures".to_string(),
        severity: "error".to_string(),
        applicable_to: vec!["titan", "vera", "helix", "aether", "sylva", "axiom", "nexus"].iter().map(|s| s.to_string()).collect(),
        code_example_bad: "pub fn process(data) -> ? { }".to_string(),
        code_example_good: "pub fn process(data: Vec<String>) -> Result<ProcessedData, Error> { }".to_string(),
        auto_fixable: false,
        fix_explanation: "Add explicit type annotations to function parameters and return type".to_string()
    },

    DetailedRule {
        id: "OMNI_005".to_string(),
        category: "type_safety".to_string(),
        name: "Implicit Type Coercion".to_string(),
        description: "Implicit type coercion is not allowed".to_string(),
        severity: "error".to_string(),
        applicable_to: vec!["titan", "vera", "helix", "aether", "sylva", "axiom", "nexus"].iter().map(|s| s.to_string()).collect(),
        code_example_bad: "let x: i32 = \"5\"".to_string(),
        code_example_good: "let x: i32 = \"5\".parse::<i32>()?".to_string(),
        auto_fixable: false,
        fix_explanation: "Use explicit type conversion functions".to_string()
    },

    // Null Safety Rules
    DetailedRule {
        id: "OMNI_006".to_string(),
        category: "null_safety".to_string(),
        name: "Dereferencing Option Without Match".to_string(),
        description: "Option<T> values must be matched before use".to_string(),
        severity: "error".to_string(),
        applicable_to: vec!["titan", "vera", "helix", "aether", "sylva", "axiom", "nexus"].iter().map(|s| s.to_string()).collect(),
        code_example_bad: "let value = optional_value.get()".to_string(),
        code_example_good: "match optional_value {\n    Some(v) => use_value(v),\n    None => {}\n}".to_string(),
        auto_fixable: false,
        fix_explanation: "Always match Option before using the contained value".to_string()
    },

    // Lifetime Rules
    DetailedRule {
        id: "OMNI_007".to_string(),
        category: "lifetime".to_string(),
        name: "Dangling Reference".to_string(),
        description: "References must not outlive the values they reference".to_string(),
        severity: "error".to_string(),
        applicable_to: vec!["titan", "vera", "helix", "aether", "sylva", "axiom", "nexus"].iter().map(|s| s.to_string()).collect(),
        code_example_bad: "fn get_ref() -> &'static String {\n    let s = \"temp\".to_string();\n    &s\n}".to_string(),
        code_example_good: "fn get_string() -> String {\n    \"owned\".to_string()\n}".to_string(),
        auto_fixable: false,
        fix_explanation: "Return owned values or adjust lifetime bounds".to_string()
    },

    // Thread Safety Rules
    DetailedRule {
        id: "OMNI_008".to_string(),
        category: "thread_safety".to_string(),
        name: "Unsynchronized Shared Mutation".to_string(),
        description: "Mutable data accessed from multiple threads requires Mutex".to_string(),
        severity: "error".to_string(),
        applicable_to: vec!["titan", "vera", "helix", "aether", "sylva", "axiom", "nexus"].iter().map(|s| s.to_string()).collect(),
        code_example_bad: "let data = vec![1, 2, 3]\nspawn_thread(|| { data[0] = 5 })".to_string(),
        code_example_good: "let data = Arc::new(Mutex::new(vec![1, 2, 3]))\nlet lock = data.lock()\nlock[0] = 5".to_string(),
        auto_fixable: false,
        fix_explanation: "Wrap shared mutable data with Arc<Mutex<T>>".to_string()
    },

    // Memory Safety Rules
    DetailedRule {
        id: "OMNI_009".to_string(),
        category: "memory_safety".to_string(),
        name: "Bounds Check Required".to_string(),
        description: "Array access on non-const indices must be checked".to_string(),
        severity: "error".to_string(),
        applicable_to: vec!["titan", "vera", "helix", "aether", "sylva", "axiom", "nexus"].iter().map(|s| s.to_string()).collect(),
        code_example_bad: "let value = array[unknown_index]".to_string(),
        code_example_good: "let value = array.get(unknown_index)?".to_string(),
        auto_fixable: true,
        fix_explanation: "Use bounds-safe access like .get() or verify index at compile time".to_string()
    },

    // Side Effect Rules
    DetailedRule {
        id: "OMNI_010".to_string(),
        category: "side_effects".to_string(),
        name: "Hidden Side Effects".to_string(),
        description: "Functions with side effects must be marked as impure or use actor model".to_string(),
        severity: "warning".to_string(),
        applicable_to: vec!["titan", "vera", "helix", "aether", "sylva", "axiom", "nexus"].iter().map(|s| s.to_string()).collect(),
        code_example_bad: "fn process(x: i32) -> i32 {\n    GLOBAL_COUNTER += 1\n    x * 2\n}".to_string(),
        code_example_good: "actor Counter { count: i32\n    message Increment() { count += 1 }\n}\nfn process(x: i32) -> i32 { x * 2 }".to_string(),
        auto_fixable: false,
        fix_explanation: "Move side effects into actor messages or mark function as impure".to_string()
    },

    // Documentation Rules
    DetailedRule {
        id: "OMNI_011".to_string(),
        category: "documentation".to_string(),
        name: "Missing Documentation".to_string(),
        description: "All public items must have doc comments".to_string(),
        severity: "warning".to_string(),
        applicable_to: vec!["titan", "vera", "helix", "aether", "sylva", "axiom", "nexus"].iter().map(|s| s.to_string()).collect(),
        code_example_bad: "pub fn calculate(x: i32) -> i32 { x * 2 }".to_string(),
        code_example_good: "/// Doubles the input value\npub fn calculate(x: i32) -> i32 { x * 2 }".to_string(),
        auto_fixable: true,
        fix_explanation: "Add /// doc comment explaining public function purpose".to_string()
    },

    // Unreachable Code Rules
    DetailedRule {
        id: "OMNI_012".to_string(),
        category: "control_flow".to_string(),
        name: "Unreachable Code".to_string(),
        description: "Code that can never execute is a compile error".to_string(),
        severity: "error".to_string(),
        applicable_to: vec!["titan", "vera", "helix", "aether", "sylva", "axiom", "nexus"].iter().map(|s| s.to_string()).collect(),
        code_example_bad: "return 42\nprintln(\"never\")\n".to_string(),
        code_example_good: "println(\"always\")\nreturn 42".to_string(),
        auto_fixable: true,
        fix_explanation: "Remove unreachable code after return/break/continue".to_string()
    }
];

// RUST CROSS-LANGUAGE RULES
// Additional rules when linting Rust code to match Omnisystem standards

pub const RUST_ADDITIONAL_RULES: Vec<DetailedRule> = vec![
    DetailedRule {
        id: "RUST_001".to_string(),
        category: "rust_specific".to_string(),
        name: "Forbidden unsafe Block".to_string(),
        description: "unsafe blocks should only be used with explicit justification".to_string(),
        severity: "warning".to_string(),
        applicable_to: vec!["rust".to_string()],
        code_example_bad: "unsafe { ptr::read(addr) }".to_string(),
        code_example_good: "// SAFETY: addr is valid and aligned\nunsafe { ptr::read(addr) }".to_string(),
        auto_fixable: false,
        fix_explanation: "Add SAFETY comment explaining why unsafe is necessary".to_string()
    },

    DetailedRule {
        id: "RUST_002".to_string(),
        category: "rust_specific".to_string(),
        name: "Unwrap Without Justification".to_string(),
        description: "unwrap() calls should have explicit comments".to_string(),
        severity: "warning".to_string(),
        applicable_to: vec!["rust".to_string()],
        code_example_bad: "result.unwrap()".to_string(),
        code_example_good: "// We know this will always succeed because X\nresult.unwrap()".to_string(),
        auto_fixable: false,
        fix_explanation: "Add comment explaining why unwrap is safe or use ? instead".to_string()
    }
];

// PYTHON CROSS-LANGUAGE RULES
pub const PYTHON_ADDITIONAL_RULES: Vec<DetailedRule> = vec![
    DetailedRule {
        id: "PY_001".to_string(),
        category: "python_specific".to_string(),
        name: "Missing Type Hints".to_string(),
        description: "All functions should have type hints for Omnisystem compatibility".to_string(),
        severity: "warning".to_string(),
        applicable_to: vec!["python".to_string()],
        code_example_bad: "def process(data):\n    return data".to_string(),
        code_example_good: "def process(data: List[str]) -> List[str]:\n    return data".to_string(),
        auto_fixable: true,
        fix_explanation: "Add type hints to function signature".to_string()
    },

    DetailedRule {
        id: "PY_002".to_string(),
        category: "python_specific".to_string(),
        name: "Bare except Clause".to_string(),
        description: "Bare except clauses hide errors".to_string(),
        severity: "error".to_string(),
        applicable_to: vec!["python".to_string()],
        code_example_bad: "try:\n    x = 1/0\nexcept:\n    pass".to_string(),
        code_example_good: "try:\n    x = 1/0\nexcept ZeroDivisionError as e:\n    handle_error(e)".to_string(),
        auto_fixable: false,
        fix_explanation: "Catch specific exception types".to_string()
    }
];

// JAVASCRIPT/TYPESCRIPT CROSS-LANGUAGE RULES
pub const JAVASCRIPT_ADDITIONAL_RULES: Vec<DetailedRule> = vec![
    DetailedRule {
        id: "JS_001".to_string(),
        category: "javascript_specific".to_string(),
        name: "Missing Type Annotations".to_string(),
        description: "Use TypeScript strict mode for type safety".to_string(),
        severity: "warning".to_string(),
        applicable_to: vec!["javascript".to_string(), "typescript".to_string()],
        code_example_bad: "function process(data) {\n    return data.map(x => x * 2)\n}".to_string(),
        code_example_good: "function process(data: number[]): number[] {\n    return data.map(x => x * 2)\n}".to_string(),
        auto_fixable: false,
        fix_explanation: "Add TypeScript type annotations".to_string()
    },

    DetailedRule {
        id: "JS_002".to_string(),
        category: "javascript_specific".to_string(),
        name: "Null/Undefined Not Handled".to_string(),
        description: "Potential null/undefined access must be guarded".to_string(),
        severity: "error".to_string(),
        applicable_to: vec!["javascript".to_string(), "typescript".to_string()],
        code_example_bad: "const val = obj.prop\nconsole.log(val.toString())".to_string(),
        code_example_good: "const val = obj.prop\nif (val != null) {\n    console.log(val.toString())\n}".to_string(),
        auto_fixable: false,
        fix_explanation: "Add null/undefined checks before accessing properties".to_string()
    }
];

pub const ALL_RULES: Vec<DetailedRule> = vec![
    // OMNISYSTEM RULES
    OMNISYSTEM_RULES.iter().cloned().collect(),
    // RUST ADDITIONAL
    RUST_ADDITIONAL_RULES.iter().cloned().collect(),
    // PYTHON ADDITIONAL
    PYTHON_ADDITIONAL_RULES.iter().cloned().collect(),
    // JAVASCRIPT ADDITIONAL
    JAVASCRIPT_ADDITIONAL_RULES.iter().cloned().collect()
];

pub actor LintRuleDatabase {
    rules: Vec<DetailedRule> = ALL_RULES,
    rule_count: i32 = 0

    message GetRuleCount() -> i32 {
        rules.len() as i32
    }

    message GetRulesByCategory(category: String) -> Vec<DetailedRule> {
        rules.iter()
            .filter(|r| r.category == category)
            .cloned()
            .collect()
    }

    message GetRulesByLanguage(language: String) -> Vec<DetailedRule> {
        rules.iter()
            .filter(|r| r.applicable_to.contains(&language))
            .cloned()
            .collect()
    }

    message GetAutoFixableRules() -> Vec<DetailedRule> {
        rules.iter()
            .filter(|r| r.auto_fixable)
            .cloned()
            .collect()
    }

    message SearchRulesByName(query: String) -> Vec<DetailedRule> {
        rules.iter()
            .filter(|r| r.name.contains(&query) || r.description.contains(&query))
            .cloned()
            .collect()
    }

    message GetRuleById(id: String) -> Option<DetailedRule> {
        rules.iter()
            .find(|r| r.id == id)
            .cloned()
    }
}
