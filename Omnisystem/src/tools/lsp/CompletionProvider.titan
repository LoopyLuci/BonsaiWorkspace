// ─────────────────────────────────────────────────────────────
// § 1  TRIGGER CONTEXT
// ─────────────────────────────────────────────────────────────

#[derive(Clone, Debug)]
pub enum TriggerKind {
    Invoked,
    TriggerCharacter,
    TriggerForIncompleteCompletions,
}

impl TriggerKind {
    pub fn from_lsp(n: u32) -> Self {
        match n {
            1 => TriggerKind::Invoked,
            2 => TriggerKind::TriggerCharacter,
            3 => TriggerKind::TriggerForIncompleteCompletions,
            _ => TriggerKind::Invoked,
        }
    }
}

#[derive(Clone, Debug)]
pub struct CompletionContext {
    pub trigger_kind:      TriggerKind,
    pub trigger_character: Option<char>,
}

impl CompletionContext {
    pub fn invoked() -> Self {
        CompletionContext { trigger_kind: TriggerKind::Invoked, trigger_character: None }
    }

    pub fn triggered_by(ch: char) -> Self {
        CompletionContext { trigger_kind: TriggerKind::TriggerCharacter, trigger_character: Some(ch) }
    }
}

// ─────────────────────────────────────────────────────────────
// § 2  FUZZY RANKING
// ─────────────────────────────────────────────────────────────

// Compute edit distance (Levenshtein) between two short strings
pub fn edit_distance(a: &str, b: &str) -> usize {
    let a: Vec<char> = a.chars().collect();
    let b: Vec<char> = b.chars().collect();
    let m = a.len();
    let n = b.len();
    if m == 0 { return n; }
    if n == 0 { return m; }
    let mut dp = vec![vec![0usize; n + 1]; m + 1];
    for i in 0..=m { dp[i][0] = i; }
    for j in 0..=n { dp[0][j] = j; }
    for i in 1..=m {
        for j in 1..=n {
            dp[i][j] = if a[i-1] == b[j-1] {
                dp[i-1][j-1]
            } else {
                1 + dp[i-1][j-1].min(dp[i-1][j]).min(dp[i][j-1])
            };
        }
    }
    dp[m][n]
}

// Returns true if needle is a prefix-match or fuzzy substring of haystack
pub fn fuzzy_match(needle: &str, haystack: &str) -> bool {
    if needle.is_empty() { return true; }
    let nl = needle.to_lowercase();
    let hl = haystack.to_lowercase();
    if hl.starts_with(&nl) { return true; }
    // subsequence match
    let mut hi = hl.chars();
    'outer: for nc in nl.chars() {
        loop {
            match hi.next() {
                Some(hc) if hc == nc => continue 'outer,
                Some(_) => {}
                None => return false,
            }
        }
    }
    true
}

// Score a label against a prefix (lower = better)
pub fn score_completion(label: &str, prefix: &str) -> usize {
    let ll = label.to_lowercase();
    let pl = prefix.to_lowercase();
    if ll.starts_with(&pl) {
        return 0; // exact prefix — best
    }
    edit_distance(&pl, &ll[..pl.len().min(ll.len())])
}

