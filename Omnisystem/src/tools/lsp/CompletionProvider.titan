// ─────────────────────────────────────────────────────────────
// § 6  CONTEXT DETECTION
// ─────────────────────────────────────────────────────────────

#[derive(Debug, PartialEq)]
enum CompletionKind {
    Keyword,
    MemberAccess { object: String },
    UseStatement,
    TypePosition,
    General,
}

fn detect_context(prefix: &str) -> CompletionKind {
    let trimmed = prefix.trim_end();

    // Member access: ends with '.' possibly after an identifier
    if trimmed.ends_with('.') {
        // Extract the object name before the dot
        let before_dot = &trimmed[..trimmed.len() - 1];
        let obj = before_dot.split_whitespace().last()
            .unwrap_or("").to_string();
        return CompletionKind::MemberAccess { object: obj };
    }

    // Use statement
    if trimmed.starts_with("use ") || trimmed.contains("use ") {
        return CompletionKind::UseStatement;
    }

    // Type position: after ':' or '->' or 'impl' or '<'
    if trimmed.ends_with(':') || trimmed.ends_with("->") ||
       trimmed.ends_with("impl ") || trimmed.ends_with('<') {
        return CompletionKind::TypePosition;
    }

    // After a keyword that starts a declaration
    let last_word = trimmed.split_whitespace().last().unwrap_or("");
    if matches!(last_word, "fn" | "struct" | "enum" | "let" | "const" | "mod") {
        return CompletionKind::Keyword;
    }

    CompletionKind::General
}

// ─────────────────────────────────────────────────────────────
// § 7  MEMBER ACCESS COMPLETIONS
// ─────────────────────────────────────────────────────────────

fn get_member_completions(
    type_name: &str,
    symbols: &SymbolTable,
    uri: &str,
) -> Vec<CompletionItem> {
    let mut items = Vec::new();

    // Look up struct fields for the type
    for sym in symbols.all_symbols() {
        if sym.scope_depth > 0 {
            // Fields are at depth 1; check if they belong to this type
            if let SymbolKindEx::Field = sym.kind {
                let mut item = CompletionItem::new(
                    &sym.name,
                    CompletionItemKind::Field,
                );
                item.detail = Some(sym.type_str.clone());
                if !sym.doc_comment.is_empty() {
                    item.documentation = Some(sym.doc_comment.clone());
                }
                items.push(item);
            }
        }
    }

    // Standard method completions based on common types
    let std_methods: &[(&str, &[(&str, &str, &str)])] = &[
        ("String", &[
            ("len",        "(&self) -> usize",     "Returns length in bytes"),
            ("is_empty",   "(&self) -> bool",      "Returns true if length is zero"),
            ("to_uppercase","(&self) -> String",   "Convert to uppercase"),
            ("to_lowercase","(&self) -> String",   "Convert to lowercase"),
            ("trim",       "(&self) -> &str",      "Trim whitespace"),
            ("contains",   "(&self, pat: &str) -> bool", "Check if string contains pattern"),
            ("starts_with","(&self, pat: &str) -> bool", "Check prefix"),
            ("ends_with",  "(&self, pat: &str) -> bool", "Check suffix"),
            ("split",      "(&self, sep: char) -> Split", "Split by separator"),
            ("replace",    "(&self, from: &str, to: &str) -> String", "Replace substrings"),
            ("push_str",   "(&mut self, s: &str)", "Append string slice"),
            ("push",       "(&mut self, ch: char)", "Append character"),
            ("clone",      "(&self) -> String",    "Clone the string"),
            ("as_str",     "(&self) -> &str",      "Convert to string slice"),
            ("chars",      "(&self) -> Chars",     "Iterator over characters"),
        ]),
        ("Vec", &[
            ("len",      "(&self) -> usize",          "Number of elements"),
            ("is_empty", "(&self) -> bool",            "True if no elements"),
            ("push",     "(&mut self, value: T)",      "Append element"),
            ("pop",      "(&mut self) -> Option<T>",   "Remove and return last"),
            ("get",      "(&self, index: usize) -> Option<&T>", "Get by index"),
            ("iter",     "(&self) -> Iter<T>",         "Iterator over references"),
            ("iter_mut", "(&mut self) -> IterMut<T>",  "Mutable iterator"),
            ("contains", "(&self, x: &T) -> bool",    "Check membership"),
            ("sort",     "(&mut self)",                "Sort in place"),
            ("reverse",  "(&mut self)",                "Reverse in place"),
            ("clear",    "(&mut self)",                "Remove all elements"),
            ("extend",   "(&mut self, iter: impl IntoIterator<Item=T>)", "Extend from iterator"),
            ("retain",   "(&mut self, f: impl FnMut(&T) -> bool)", "Keep matching elements"),
            ("clone",    "(&self) -> Vec<T>",          "Clone the vector"),
        ]),
        ("Option", &[
            ("is_some",   "(&self) -> bool",           "True if Some"),
            ("is_none",   "(&self) -> bool",           "True if None"),
            ("unwrap",    "(self) -> T",                "Unwrap or panic"),
            ("unwrap_or", "(self, default: T) -> T",   "Unwrap or default"),
            ("map",       "(self, f: FnOnce(T) -> U) -> Option<U>", "Transform inner value"),
            ("and_then",  "(self, f: FnOnce(T) -> Option<U>) -> Option<U>", "Flat-map"),
            ("or",        "(self, other: Option<T>) -> Option<T>", "Return self or other"),
            ("clone",     "(&self) -> Option<T>",      "Clone the option"),
        ]),
        ("HashMap", &[
            ("get",      "(&self, key: &K) -> Option<&V>", "Lookup by key"),
            ("insert",   "(&mut self, key: K, value: V) -> Option<V>", "Insert key-value"),
            ("remove",   "(&mut self, key: &K) -> Option<V>", "Remove by key"),
            ("contains_key","(&self, key: &K) -> bool", "Check key existence"),
            ("len",      "(&self) -> usize",            "Number of entries"),
            ("is_empty", "(&self) -> bool",             "True if no entries"),
            ("keys",     "(&self) -> Keys<K,V>",        "Iterator over keys"),
            ("values",   "(&self) -> Values<K,V>",      "Iterator over values"),
            ("iter",     "(&self) -> Iter<K,V>",        "Iterator over key-value pairs"),
            ("entry",    "(&mut self, key: K) -> Entry<K,V>", "Entry API for upsert"),
            ("clear",    "(&mut self)",                 "Remove all entries"),
        ]),
    ];

    for (ty, methods) in std_methods {
        if type_name == *ty || type_name.starts_with(ty) {
            for (meth, sig, doc) in *methods {
                let mut item = CompletionItem::new(meth, CompletionItemKind::Method);
                item.detail = Some(sig.to_string());
                item.documentation = Some(doc.to_string());
                item.insert_text = Some(format!("{}(${{}}})", meth));
                items.push(item);
            }
        }
    }

    items
}

