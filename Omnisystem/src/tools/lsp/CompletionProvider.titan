        ("std::io::Write",              "Write trait"),
        ("std::fmt",                    "Formatting utilities"),
        ("std::str",                    "String utilities"),
        ("std::string::String",         "Owned string type"),
        ("std::vec::Vec",               "Growable array"),
        ("std::option::Option",         "Optional value"),
        ("std::result::Result",         "Result type"),
        ("LspProtocol",                 "LSP protocol types"),
        ("LanguageAnalyzer",            "Language analysis engine"),
        ("CompletionProvider",          "Auto-completion provider"),
        ("DiagnosticsProvider",         "Diagnostics engine"),
        ("Omnisystem::core",            "Core Omnisystem APIs"),
        ("Omnisystem::runtime",         "Runtime APIs"),
        ("Omnisystem::desktop",         "Desktop environment APIs"),
        ("Omnisystem::graphics",        "Graphics/HELIX APIs"),
        ("Omnisystem::network",         "Networking APIs"),
        ("Omnisystem::security",        "Security APIs"),
        ("Omnisystem::analytics",       "Analytics APIs"),
    ];
    modules.into_iter().map(|(path, doc)| {
        let mut item = CompletionItem::new(path, CompletionItemKind::Module);
        item.documentation = Some(doc.to_string());
        item
    }).collect()
}

// ─────────────────────────────────────────────────────────────
// § 9  SYMBOL COMPLETIONS FROM SYMBOL TABLE
// ─────────────────────────────────────────────────────────────

fn symbol_kind_to_completion_kind(kind: &SymbolKindEx) -> CompletionItemKind {
    match kind {
        SymbolKindEx::Function    => CompletionItemKind::Function,
        SymbolKindEx::Struct      => CompletionItemKind::Struct,
        SymbolKindEx::Enum        => CompletionItemKind::Enum,
        SymbolKindEx::EnumVariant => CompletionItemKind::EnumMember,
        SymbolKindEx::Field       => CompletionItemKind::Field,
        SymbolKindEx::Variable    => CompletionItemKind::Variable,
        SymbolKindEx::Parameter   => CompletionItemKind::Variable,
        SymbolKindEx::Constant    => CompletionItemKind::Constant,
        SymbolKindEx::Module      => CompletionItemKind::Module,
        SymbolKindEx::Trait       => CompletionItemKind::Interface,
        SymbolKindEx::TypeAlias   => CompletionItemKind::TypeParameter,
        SymbolKindEx::Component   => CompletionItemKind::Class,
        SymbolKindEx::Prop        => CompletionItemKind::Property,
        SymbolKindEx::State       => CompletionItemKind::Variable,
        SymbolKindEx::Pipeline    => CompletionItemKind::Module,
        SymbolKindEx::Shader      => CompletionItemKind::Function,
        SymbolKindEx::Uniform     => CompletionItemKind::Variable,
        SymbolKindEx::StorageBuffer => CompletionItemKind::Variable,
        SymbolKindEx::Actor       => CompletionItemKind::Class,
        SymbolKindEx::Message     => CompletionItemKind::Struct,
        SymbolKindEx::Handler     => CompletionItemKind::Method,
        SymbolKindEx::Layer       => CompletionItemKind::Class,
        SymbolKindEx::Model       => CompletionItemKind::Class,
        SymbolKindEx::Theorem     => CompletionItemKind::Function,
        SymbolKindEx::Precondition| SymbolKindEx::Postcondition |
        SymbolKindEx::Invariant   => CompletionItemKind::Keyword,
        SymbolKindEx::Layout      => CompletionItemKind::Module,
        SymbolKindEx::Breakpoint  => CompletionItemKind::Constant,
    }
}

fn completions_from_symbols(symbols: &SymbolTable, prefix: &str) -> Vec<CompletionItem> {
    let mut items = Vec::new();
    for sym in symbols.all_symbols() {
        if !fuzzy_match(prefix, &sym.name) { continue; }
        let ck = symbol_kind_to_completion_kind(&sym.kind);
        let mut item = CompletionItem::new(&sym.name, ck);
        if !sym.type_str.is_empty() {
            item.detail = Some(sym.type_str.clone());
        }
        if !sym.doc_comment.is_empty() {
            item.documentation = Some(sym.doc_comment.clone());
        }
        let score = score_completion(&sym.name, prefix);
        item.sort_text = Some(format!("{:04}", score));
        items.push(item);
    }
    items
}

// ─────────────────────────────────────────────────────────────
// § 10  MAIN ENTRY POINT
// ─────────────────────────────────────────────────────────────

pub fn get_completions(
    source:  &str,
    pos:     &Position,
    symbols: &SymbolTable,
    lang:    &str,
    ctx:     &CompletionContext,
) -> Vec<CompletionItem> {
    let prefix_line = line_prefix(source, pos);
    let context     = detect_context(&prefix_line);
    let word_prefix = prefix_line.split(|c: char| !c.is_alphanumeric() && c != '_')
        .last().unwrap_or("").to_string();

    let mut items: Vec<CompletionItem> = Vec::new();

    match context {
        CompletionKind::MemberAccess { ref object } => {
            // Try to resolve type of the object from symbol table
            let type_name = if let Some(sym) = symbols.lookup(object) {
                sym.type_str.trim().to_string()
            } else {
                object.clone()
            };
            let mut member_items = get_member_completions(&type_name, symbols, "");
            // Filter by word_prefix if any (e.g., "obj.le" → filter to "len")
            member_items.retain(|i| fuzzy_match(&word_prefix, &i.label));
            items.extend(member_items);
        }

        CompletionKind::UseStatement => {
            let mut use_items = get_use_completions();
            use_items.retain(|i| fuzzy_match(&word_prefix, &i.label));
            items.extend(use_items);
        }

        CompletionKind::TypePosition => {
            // Type names: primitives + user types
            for (name, doc) in primitive_types() {
                if !fuzzy_match(&word_prefix, name) { continue; }
                let mut item = CompletionItem::new(name, CompletionItemKind::TypeParameter);
                item.documentation = Some(doc.to_string());
                let score = score_completion(name, &word_prefix);
                item.sort_text = Some(format!("{:04}", score));
                items.push(item);
            }
            items.extend(completions_from_symbols(symbols, &word_prefix));
        }

        CompletionKind::Keyword | CompletionKind::General => {
            // 1. Keywords
            for (kw, doc) in keywords_for_lang(lang) {
                if !fuzzy_match(&word_prefix, kw) { continue; }
                let mut item = CompletionItem::new(kw, CompletionItemKind::Keyword);
                item.documentation = Some(doc.to_string());
                let score = score_completion(kw, &word_prefix);
                item.sort_text = Some(format!("0{:04}", score)); // keywords first
                items.push(item);
            }

            // 2. Snippets
            for (trigger, label, body) in snippets_for_lang(lang) {
                if !fuzzy_match(&word_prefix, trigger) { continue; }
                let mut item = CompletionItem::new(label, CompletionItemKind::Snippet);
                item.insert_text = Some(body.to_string());
                item.documentation = Some(format!("Snippet: {}", label));
                item.sort_text = Some(format!("1{}", label));
                items.push(item);
            }

            // 3. User symbols
            let mut sym_items = completions_from_symbols(symbols, &word_prefix);
            for i in sym_items.iter_mut() {
                if let Some(ref s) = i.sort_text.clone() {
                    i.sort_text = Some(format!("2{}", s));
                }
            }
            items.extend(sym_items);

            // 4. Primitives (in general context)
            if word_prefix.len() >= 1 {
                for (name, doc) in primitive_types() {
                    if !fuzzy_match(&word_prefix, name) { continue; }
                    let mut item = CompletionItem::new(name, CompletionItemKind::TypeParameter);
                    item.documentation = Some(doc.to_string());
                    item.sort_text = Some(format!("3{}", name));
                    items.push(item);
                }
            }
        }
    }

    // Deduplicate by label
    let mut seen = std::collections::HashSet::new();
    items.retain(|i| seen.insert(i.label.clone()));

    // Sort by sort_text
    items.sort_by(|a, b| {
        a.sort_text.as_deref().unwrap_or(&a.label)
         .cmp(b.sort_text.as_deref().unwrap_or(&b.label))
    });

    // Cap at 100 items to avoid overwhelming the client
    items.truncate(100);
    items
}

// ─────────────────────────────────────────────────────────────
// § 11  UNIT TESTS
// ─────────────────────────────────────────────────────────────

#[cfg(test)]
mod tests {
    use super::*;
    use LanguageAnalyzer::SymbolTable;

    fn empty_table() -> SymbolTable { SymbolTable::new() }

    #[test]
    fn test_edit_distance_identity() {
        assert_eq!(edit_distance("hello", "hello"), 0);
    }

    #[test]
    fn test_edit_distance_basic() {
        assert_eq!(edit_distance("kitten", "sitting"), 3);
    }

    #[test]
    fn test_fuzzy_match_prefix() {
        assert!(fuzzy_match("fn",    "fn"));
        assert!(fuzzy_match("fn",    "function"));
        assert!(fuzzy_match("stru",  "struct"));
        assert!(!fuzzy_match("xyz",  "struct"));
    }

    #[test]
    fn test_fuzzy_match_subsequence() {
        assert!(fuzzy_match("sc", "struct"));  // s..c in struct
        assert!(fuzzy_match("sm", "some_method"));
    }

    #[test]
    fn test_keyword_completions_titan() {
        let table = empty_table();
        let ctx   = CompletionContext::invoked();
        let items = get_completions("fn ", &Position::new(0, 3), &table, "titan", &ctx);
        let labels: Vec<&str> = items.iter().map(|i| i.label.as_str()).collect();
        // "fn" snippet/keyword should be present when prefix is empty
        assert!(!items.is_empty());
    }

    #[test]
    fn test_keyword_completions_filtered() {
        let table = empty_table();
        let ctx   = CompletionContext::invoked();
        // prefix "stru" should return struct-related completions
        let items = get_completions("stru", &Position::new(0, 4), &table, "titan", &ctx);
        assert!(items.iter().any(|i| i.label.contains("struct")));
    }

    #[test]
    fn test_member_access_context() {
        let ctx = detect_context("my_string.");
        assert!(matches!(ctx, CompletionKind::MemberAccess { .. }));
    }

    #[test]
    fn test_use_statement_context() {
        let ctx = detect_context("use std::");
        assert!(matches!(ctx, CompletionKind::UseStatement));
    }

    #[test]
    fn test_type_position_context() {
        let ctx = detect_context("fn foo() ->");
        assert!(matches!(ctx, CompletionKind::TypePosition));
    }

    #[test]
    fn test_member_completions_string() {
        let table = empty_table();
        let items = get_member_completions("String", &table, "");
        assert!(items.iter().any(|i| i.label == "len"));
        assert!(items.iter().any(|i| i.label == "push_str"));
        assert!(items.iter().any(|i| i.label == "trim"));
    }

    #[test]
    fn test_member_completions_vec() {
        let table = empty_table();
        let items = get_member_completions("Vec", &table, "");
        assert!(items.iter().any(|i| i.label == "push"));
        assert!(items.iter().any(|i| i.label == "len"));
        assert!(items.iter().any(|i| i.label == "iter"));
    }

    #[test]
    fn test_snippets_for_vera() {
        let snips = snippets_for_lang("vera");
        assert!(snips.iter().any(|(t, _, _)| *t == "component"));
    }

    #[test]
    fn test_snippets_for_helix() {
        let snips = snippets_for_lang("helix");
        assert!(snips.iter().any(|(t, _, _)| *t == "pipeline"));
    }

    #[test]
    fn test_deduplication() {
        let table = empty_table();
        let ctx   = CompletionContext::invoked();
        let items = get_completions("", &Position::new(0, 0), &table, "titan", &ctx);
        let mut labels: Vec<String> = items.iter().map(|i| i.label.clone()).collect();
        let orig_len = labels.len();
        labels.dedup();
        // No duplicates
        assert_eq!(orig_len, labels.len());
    }

    #[test]
    fn test_capped_at_100() {
        let table = empty_table();
        let ctx   = CompletionContext::invoked();
        let items = get_completions("", &Position::new(0, 0), &table, "titan", &ctx);
        assert!(items.len() <= 100);
    }

    #[test]
    fn test_aether_completions() {
        let table = empty_table();
        let ctx   = CompletionContext::invoked();
        let items = get_completions("act", &Position::new(0, 3), &table, "aether", &ctx);
        assert!(items.iter().any(|i| i.label.contains("actor")));
    }

    #[test]
    fn test_axiom_theorem_snippet() {
        let snips = snippets_for_lang("axiom");
        assert!(snips.iter().any(|(_, label, body)| label.contains("theorem") && body.contains("precondition")));
    }
}
