// ============================================================
// LspServer.titan — Main Language Server Protocol server
// Omnisystem LSP Server · JSON-RPC 2.0 dispatcher, full LSP lifecycle
// Single-threaded synchronous server for all 7 Omni-Languages.
// ============================================================

module LspServer

use std::collections::HashMap
use LspProtocol::{
    JsonValue, RpcRequest, RpcResponse, RpcError,
    Position, Range, Location, TextEdit, WorkspaceEdit,
    CompletionItem, CompletionItemKind,
    Diagnostic, DiagnosticSeverity,
    Hover, MarkupContent,
    SymbolInformation, SymbolKind,
    json_obj, json_arr, json_str, json_num, json_bool, json_null,
    read_message, write_response, write_notification, write_message,
    position_to_offset, offset_to_position, word_at_position,
    apply_text_edit, apply_text_edits, line_prefix,
}
use LanguageAnalyzer::{
    AnalysisResult, SymbolTable, SymbolInfo, SymbolKindEx,
    analyze, detect_language, get_hover, get_definition, get_references,
}
use CompletionProvider::{
    CompletionContext, TriggerKind, get_completions,
}
use DiagnosticsProvider::{
    DiagnosticsProvider, publish_diagnostics, compute_diagnostics,
}

// ─────────────────────────────────────────────────────────────
// § 1  DOCUMENT STORE
// ─────────────────────────────────────────────────────────────

pub struct OpenDocument {
    pub uri:      String,
    pub language: String,
    pub version:  i32,
    pub content:  String,
    pub analysis: Option<AnalysisResult>,
}

impl OpenDocument {
    pub fn new(uri: &str, language: &str, version: i32, content: &str) -> Self {
        OpenDocument {
            uri:      uri.to_string(),
            language: language.to_string(),
            version,
            content:  content.to_string(),
            analysis: None,
        }
    }

    pub fn re_analyze(&mut self) {
        self.analysis = Some(analyze(&self.uri, &self.content));
    }

    pub fn apply_edit(&mut self, edit: &TextEdit) {
        self.content = apply_text_edit(&self.content, edit);
    }

    pub fn apply_edits(&mut self, edits: &[TextEdit]) {
        self.content = apply_text_edits(&self.content, edits);
    }
}

pub struct DocumentStore {
    pub documents: HashMap<String, OpenDocument>,
}

impl DocumentStore {
    pub fn new() -> Self {
        DocumentStore { documents: HashMap::new() }
    }

    pub fn open(&mut self, uri: &str, language: &str, version: i32, content: &str) {
        let lang = if language.is_empty() { detect_language(uri) } else { language };
        let mut doc = OpenDocument::new(uri, lang, version, content);
        doc.re_analyze();
        self.documents.insert(uri.to_string(), doc);
    }

    pub fn close(&mut self, uri: &str) {
        self.documents.remove(uri);
    }

    pub fn get(&self, uri: &str) -> Option<&OpenDocument> {
        self.documents.get(uri)
    }

    pub fn get_mut(&mut self, uri: &str) -> Option<&mut OpenDocument> {
        self.documents.get_mut(uri)
    }

    pub fn all_analyses(&self) -> HashMap<String, &AnalysisResult> {
        let mut map = HashMap::new();
        for (uri, doc) in &self.documents {
            if let Some(analysis) = &doc.analysis {
                map.insert(uri.clone(), analysis);
            }
        }
        map
    }
}

// ─────────────────────────────────────────────────────────────
// § 2  SERVER CAPABILITIES
// ─────────────────────────────────────────────────────────────

fn server_capabilities() -> JsonValue {
    json_obj(vec![
        ("textDocumentSync", json_obj(vec![
            ("openClose", json_bool(true)),
            ("change",    json_num(2.0)),  // Incremental
            ("save",      json_obj(vec![
                ("includeText", json_bool(true)),
            ])),
        ])),
        ("hoverProvider", json_bool(true)),
        ("completionProvider", json_obj(vec![
            ("resolveProvider",   json_bool(false)),
            ("triggerCharacters", json_arr(vec![
                json_str("."),
                json_str(":"),
                json_str("("),
            ])),
        ])),
        ("definitionProvider",  json_bool(true)),
        ("referencesProvider",  json_bool(true)),
        ("renameProvider",      json_obj(vec![
            ("prepareProvider", json_bool(false)),
        ])),
        ("documentFormattingProvider", json_bool(true)),
        ("workspaceSymbolProvider",    json_bool(true)),
        ("documentSymbolProvider",     json_bool(true)),
        ("semanticTokensProvider",     json_obj(vec![
            ("legend", json_obj(vec![
                ("tokenTypes", json_arr(vec![
                    json_str("namespace"), json_str("type"), json_str("class"),
                    json_str("enum"), json_str("interface"), json_str("struct"),
                    json_str("typeParameter"), json_str("parameter"), json_str("variable"),
                    json_str("property"), json_str("enumMember"), json_str("event"),
                    json_str("function"), json_str("method"), json_str("macro"),
                    json_str("keyword"), json_str("modifier"), json_str("comment"),
                    json_str("string"), json_str("number"), json_str("regexp"),
                    json_str("operator"),
                ])),
                ("tokenModifiers", json_arr(vec![
                    json_str("declaration"), json_str("definition"), json_str("readonly"),
                    json_str("static"), json_str("deprecated"), json_str("abstract"),
                    json_str("async"), json_str("modification"), json_str("documentation"),
                    json_str("defaultLibrary"),
                ])),
            ])),
            ("full", json_bool(true)),
        ])),
        ("workspace", json_obj(vec![
            ("workspaceFolders", json_obj(vec![
                ("supported",           json_bool(true)),
                ("changeNotifications", json_bool(true)),
            ])),
        ])),
    ])
}

// ─────────────────────────────────────────────────────────────
// § 3  LSP SERVER STATE
// ─────────────────────────────────────────────────────────────

pub struct LspServer {
    pub initialized:     bool,
    pub shutting_down:   bool,
    pub workspace_root:  Option<String>,
    pub docs:            DocumentStore,
    pub diagnostics:     DiagnosticsProvider,
    pub client_info:     Option<(String, String)>,  // (name, version)
    pub request_counter: u64,
}

impl LspServer {
    pub fn new() -> Self {
        LspServer {
            initialized:     false,
            shutting_down:   false,
            workspace_root:  None,
            docs:            DocumentStore::new(),
            diagnostics:     DiagnosticsProvider::new(),
            client_info:     None,
            request_counter: 0,
        }
    }

    // ── Dispatch incoming request ──────────────────────────────

    pub fn handle(&mut self, req: RpcRequest) -> Option<JsonValue> {
        self.request_counter += 1;
        eprintln!("[LSP] → {} (id={:?})", req.method, json_str_or_num(&req.id));

        // Before initialized, only accept initialize
        if !self.initialized && req.method != "initialize" {
            if req.id.is_null() {
                return None; // notification, ignore
            }
            return Some(RpcResponse::err(
                req.id,
                RpcError::new(-32002, "Server not initialized"),
            ).to_json());
        }

        match req.method.as_str() {
            // ── Lifecycle ──────────────────────────────────────
            "initialize"   => Some(self.handle_initialize(req)),
            "initialized"  => { self.initialized = true; None }
            "shutdown"     => Some(self.handle_shutdown(req)),
            "exit"         => { self.handle_exit(); None }

            // ── Text document ──────────────────────────────────
            "textDocument/didOpen"         => { self.handle_did_open(req);      None }
            "textDocument/didChange"       => { self.handle_did_change(req);    None }
            "textDocument/didClose"        => { self.handle_did_close(req);     None }
            "textDocument/didSave"         => { self.handle_did_save(req);      None }
            "textDocument/hover"           => Some(self.handle_hover(req)),
            "textDocument/completion"      => Some(self.handle_completion(req)),
            "textDocument/definition"      => Some(self.handle_definition(req)),
            "textDocument/references"      => Some(self.handle_references(req)),
            "textDocument/rename"          => Some(self.handle_rename(req)),
            "textDocument/formatting"      => Some(self.handle_formatting(req)),
            "textDocument/documentSymbol"  => Some(self.handle_document_symbol(req)),

            // ── Workspace ──────────────────────────────────────
            "workspace/symbol"           => Some(self.handle_workspace_symbol(req)),
            "workspace/didChangeConfiguration" => {
                self.handle_config_change(req); None
            }

            // ── Unknown ────────────────────────────────────────
            method => {
                eprintln!("[LSP] unhandled method: {}", method);
                if req.id.is_null() {
                    None
                } else {
                    Some(RpcResponse::err(req.id, RpcError::method_not_found()).to_json())
                }
            }
        }
    }

    // ─────────────────────────────────────────────────────────
    // § 4  LIFECYCLE HANDLERS
    // ─────────────────────────────────────────────────────────

    fn handle_initialize(&mut self, req: RpcRequest) -> JsonValue {
        // Extract workspace root from params
        if let Some(root_uri) = req.params.get("rootUri").and_then(|v| v.as_str()) {
            self.workspace_root = Some(root_uri.to_string());
        } else if let Some(root_path) = req.params.get("rootPath").and_then(|v| v.as_str()) {
            self.workspace_root = Some(format!("file://{}", root_path));
        }

        // Record client info
        if let Some(info) = req.params.get("clientInfo") {
            let name    = info.get("name").and_then(|v| v.as_str()).unwrap_or("unknown").to_string();
            let version = info.get("version").and_then(|v| v.as_str()).unwrap_or("").to_string();
            self.client_info = Some((name, version));
        }

        self.initialized = true;
        eprintln!("[LSP] initialized for workspace: {:?}", self.workspace_root);

        RpcResponse::ok(req.id, json_obj(vec![
            ("capabilities", server_capabilities()),
            ("serverInfo", json_obj(vec![
                ("name",    json_str("Omnisystem LSP")),
                ("version", json_str("1.0.0")),
            ])),
        ])).to_json()
    }

    fn handle_shutdown(&mut self, req: RpcRequest) -> JsonValue {
        self.shutting_down = true;
        eprintln!("[LSP] shutdown requested");
        RpcResponse::ok(req.id, json_null()).to_json()
    }

    fn handle_exit(&self) {
        let code = if self.shutting_down { 0 } else { 1 };
        eprintln!("[LSP] exit with code {}", code);
        std::process::exit(code);
    }

    // ─────────────────────────────────────────────────────────
    // § 5  DOCUMENT SYNC HANDLERS
    // ─────────────────────────────────────────────────────────

    fn handle_did_open(&mut self, req: RpcRequest) {
        let td = match req.params.get("textDocument") {
            Some(v) => v,
            None => { eprintln!("[LSP] didOpen: missing textDocument"); return; }
        };
        let uri      = td.get("uri").and_then(|v| v.as_str()).unwrap_or("").to_string();
        let lang     = td.get("languageId").and_then(|v| v.as_str()).unwrap_or("").to_string();
        let version  = td.get("version").and_then(|v| v.as_f64()).unwrap_or(1.0) as i32;
        let text     = td.get("text").and_then(|v| v.as_str()).unwrap_or("").to_string();

        eprintln!("[LSP] didOpen: {} ({})", uri, lang);
        self.docs.open(&uri, &lang, version, &text);

        // Run diagnostics and publish
        self.run_and_publish_diagnostics(&uri);
    }

    fn handle_did_change(&mut self, req: RpcRequest) {
        let td = match req.params.get("textDocument") {
            Some(v) => v,
            None => return,
        };
        let uri     = td.get("uri").and_then(|v| v.as_str()).unwrap_or("").to_string();
        let version = td.get("version").and_then(|v| v.as_f64()).unwrap_or(0.0) as i32;

        let changes = match req.params.get("contentChanges").and_then(|v| v.as_array()) {
            Some(c) => c.clone(),
            None    => return,
        };

        if let Some(doc) = self.docs.get_mut(&uri) {
            doc.version = version;
            for change in &changes {
                if let Some(range) = change.get("range").and_then(|v| Range::from_json(v)) {
                    // Incremental change: apply the range-based edit
                    let new_text = change.get("text").and_then(|v| v.as_str()).unwrap_or("");
                    let edit = TextEdit::new(range, new_text);
                    doc.apply_edit(&edit);
                } else {
                    // Full document replacement
                    if let Some(text) = change.get("text").and_then(|v| v.as_str()) {
                        doc.content = text.to_string();
                    }
                }
            }
            doc.re_analyze();
        }

        self.run_and_publish_diagnostics(&uri);
    }

    fn handle_did_close(&mut self, req: RpcRequest) {
        let uri = req.params
            .get("textDocument")
            .and_then(|v| v.get("uri"))
            .and_then(|v| v.as_str())
            .unwrap_or("")
            .to_string();
        eprintln!("[LSP] didClose: {}", uri);
        self.docs.close(&uri);
        self.diagnostics.clear(&uri);
        // Send empty diagnostics to clear editor decorations
        let notif = publish_diagnostics(&uri, &[]);
        write_message(&notif);
    }

    fn handle_did_save(&mut self, req: RpcRequest) {
        let uri = req.params
            .get("textDocument")
            .and_then(|v| v.get("uri"))
            .and_then(|v| v.as_str())
            .unwrap_or("")
            .to_string();
        // Re-analyze on save (in case full content sent)
        if let Some(text) = req.params.get("text").and_then(|v| v.as_str()) {
            if let Some(doc) = self.docs.get_mut(&uri) {
                doc.content = text.to_string();
                doc.re_analyze();
            }
        }
        self.run_and_publish_diagnostics(&uri);
    }

    fn handle_config_change(&mut self, _req: RpcRequest) {
        // Re-analyze all open documents when config changes
        let uris: Vec<String> = self.docs.documents.keys().cloned().collect();
        for uri in uris {
            if let Some(doc) = self.docs.get_mut(&uri) {
                doc.re_analyze();
            }
            self.run_and_publish_diagnostics(&uri);
        }
    }

    fn run_and_publish_diagnostics(&mut self, uri: &str) {
        let (source, lang) = match self.docs.get(uri) {
            Some(doc) => (doc.content.clone(), doc.language.clone()),
            None      => return,
        };
        let diags = self.diagnostics.compute_and_cache(uri, &source);
        let notif = publish_diagnostics(uri, &diags);
        write_message(&notif);
    }

    // ─────────────────────────────────────────────────────────
    // § 6  HOVER
    // ─────────────────────────────────────────────────────────

    fn handle_hover(&self, req: RpcRequest) -> JsonValue {
        let uri = extract_uri(&req.params);
        let pos = match extract_position(&req.params) {
            Some(p) => p,
            None    => return error_response(req.id, RpcError::invalid_params()),
        };

        let hover_text = match self.docs.get(&uri) {
            Some(doc) => {
                match &doc.analysis {
                    Some(analysis) => get_hover(analysis, &pos),
                    None => {
                        // Fallback: quick word lookup from symbol table
                        let tmp = analyze(&uri, &doc.content);
                        get_hover(&tmp, &pos)
                    }
                }
            }
            None => None,
        };

        match hover_text {
            Some(text) => {
                let hover = Hover::new(MarkupContent::markdown(&text));
                RpcResponse::ok(req.id, hover.to_json()).to_json()
            }
            None => RpcResponse::ok(req.id, json_null()).to_json(),
        }
    }

    // ─────────────────────────────────────────────────────────
    // § 7  COMPLETION
    // ─────────────────────────────────────────────────────────

    fn handle_completion(&self, req: RpcRequest) -> JsonValue {
        let uri = extract_uri(&req.params);
        let pos = match extract_position(&req.params) {
            Some(p) => p,
            None    => return error_response(req.id, RpcError::invalid_params()),
        };

        // Extract trigger context
        let ctx = if let Some(ctx_val) = req.params.get("context") {
            let kind = ctx_val.get("triggerKind")
                .and_then(|v| v.as_u32())
                .map(TriggerKind::from_lsp)
                .unwrap_or(TriggerKind::Invoked);
            let trigger_char = ctx_val.get("triggerCharacter")
                .and_then(|v| v.as_str())
                .and_then(|s| s.chars().next());
            CompletionContext { trigger_kind: kind, trigger_character: trigger_char }
        } else {
            CompletionContext::invoked()
        };

        let items = match self.docs.get(&uri) {
            Some(doc) => {
                let symbols = match &doc.analysis {
                    Some(analysis) => &analysis.symbols,
                    None => return RpcResponse::ok(req.id, json_arr(vec![])).to_json(),
                };
                get_completions(&doc.content, &pos, symbols, &doc.language, &ctx)
            }
            None => vec![],
        };

        let items_json: Vec<JsonValue> = items.iter().map(|i| i.to_json()).collect();
        RpcResponse::ok(req.id, json_obj(vec![
            ("isIncomplete", json_bool(false)),
            ("items",        json_arr(items_json)),
        ])).to_json()
    }

    // ─────────────────────────────────────────────────────────
    // § 8  GO TO DEFINITION
    // ─────────────────────────────────────────────────────────

    fn handle_definition(&self, req: RpcRequest) -> JsonValue {
        let uri = extract_uri(&req.params);
        let pos = match extract_position(&req.params) {
            Some(p) => p,
            None    => return error_response(req.id, RpcError::invalid_params()),
        };

        let location = match self.docs.get(&uri) {
            Some(doc) => {
                match &doc.analysis {
                    Some(analysis) => get_definition(analysis, &pos),
                    None => {
                        let tmp = analyze(&uri, &doc.content);
                        get_definition(&tmp, &pos)
                    }
                }
            }
            None => None,
        };

        match location {
            Some(loc) => RpcResponse::ok(req.id, loc.to_json()).to_json(),
            None      => RpcResponse::ok(req.id, json_null()).to_json(),
        }
    }

    // ─────────────────────────────────────────────────────────
    // § 9  FIND ALL REFERENCES
    // ─────────────────────────────────────────────────────────

    fn handle_references(&self, req: RpcRequest) -> JsonValue {
        let uri = extract_uri(&req.params);
        let pos = match extract_position(&req.params) {
            Some(p) => p,
            None    => return error_response(req.id, RpcError::invalid_params()),
        };

        let _include_decl = req.params
            .get("context")
            .and_then(|v| v.get("includeDeclaration"))
            .and_then(|v| v.as_bool())
            .unwrap_or(false);

        // Find the symbol name at the cursor position
        let symbol_name = match self.docs.get(&uri) {
            Some(doc) => {
                word_at_position(&doc.content, &pos)
                    .map(|(w, _)| w)
            }
            None => None,
        };

        let symbol_name = match symbol_name {
            Some(n) => n,
            None    => return RpcResponse::ok(req.id, json_arr(vec![])).to_json(),
        };

        // Build a map of all AnalysisResults for cross-file reference search
        let mut all_results: HashMap<String, AnalysisResult> = HashMap::new();
        for (doc_uri, doc) in &self.docs.documents {
            all_results.insert(doc_uri.clone(), analyze(doc_uri, &doc.content));
        }

        let locations = get_references(&all_results, &symbol_name);
        let locs_json: Vec<JsonValue> = locations.iter().map(|l| l.to_json()).collect();
        RpcResponse::ok(req.id, json_arr(locs_json)).to_json()
    }

    // ─────────────────────────────────────────────────────────
    // § 10  RENAME
    // ─────────────────────────────────────────────────────────

    fn handle_rename(&self, req: RpcRequest) -> JsonValue {
        let uri = extract_uri(&req.params);
        let pos = match extract_position(&req.params) {
            Some(p) => p,
            None    => return error_response(req.id, RpcError::invalid_params()),
        };
        let new_name = match req.params.get("newName").and_then(|v| v.as_str()) {
            Some(n) => n.to_string(),
            None    => return error_response(req.id, RpcError::invalid_params()),
        };

        // Validate the new name
        if new_name.is_empty() || !new_name.chars().next().map_or(false, |c| c.is_alphabetic() || c == '_') {
            return RpcResponse::err(
                req.id,
                RpcError::new(-32602, "Invalid rename: name must start with a letter or underscore"),
            ).to_json();
        }

        // Find the symbol name at cursor
        let old_name = match self.docs.get(&uri) {
            Some(doc) => {
                word_at_position(&doc.content, &pos)
                    .map(|(w, _)| w)
            }
            None => None,
        };

        let old_name = match old_name {
            Some(n) => n,
            None    => return RpcResponse::ok(req.id, json_null()).to_json(),
        };

        if old_name == new_name {
            return RpcResponse::ok(req.id, WorkspaceEdit::new().to_json()).to_json();
        }

        // Find all references across all open documents
        let mut all_results: HashMap<String, AnalysisResult> = HashMap::new();
        for (doc_uri, doc) in &self.docs.documents {
            all_results.insert(doc_uri.clone(), analyze(doc_uri, &doc.content));
        }

        let locations = get_references(&all_results, &old_name);
        let mut edit  = WorkspaceEdit::new();
        for loc in locations {
            edit.add_edit(&loc.uri, TextEdit::new(loc.range, &new_name));
        }

        RpcResponse::ok(req.id, edit.to_json()).to_json()
    }

    // ─────────────────────────────────────────────────────────
    // § 11  FORMATTING
    // ─────────────────────────────────────────────────────────

    fn handle_formatting(&self, req: RpcRequest) -> JsonValue {
        let uri = extract_uri(&req.params);
        let tab_size = req.params
            .get("options")
            .and_then(|v| v.get("tabSize"))
            .and_then(|v| v.as_u32())
            .unwrap_or(4) as usize;
        let insert_spaces = req.params
            .get("options")
            .and_then(|v| v.get("insertSpaces"))
            .and_then(|v| v.as_bool())
            .unwrap_or(true);

        let source = match self.docs.get(&uri) {
            Some(doc) => doc.content.clone(),
            None      => return RpcResponse::ok(req.id, json_arr(vec![])).to_json(),
        };

        let lang = detect_language(&uri);
        let formatted = format_source(&source, lang, tab_size, insert_spaces);

        if formatted == source {
            return RpcResponse::ok(req.id, json_arr(vec![])).to_json();
        }

        // Return a single edit that replaces the entire document
        let line_count = source.lines().count() as u32;
        let last_line  = source.lines().last().unwrap_or("");
        let full_range = Range::new(
            Position::new(0, 0),
            Position::new(line_count, last_line.len() as u32),
        );
        let edit = TextEdit::new(full_range, &formatted);
        RpcResponse::ok(req.id, json_arr(vec![edit.to_json()])).to_json()
    }

    // ─────────────────────────────────────────────────────────
    // § 12  DOCUMENT SYMBOLS
    // ─────────────────────────────────────────────────────────

    fn handle_document_symbol(&self, req: RpcRequest) -> JsonValue {
        let uri = extract_uri(&req.params);

        let symbols = match self.docs.get(&uri) {
            Some(doc) => {
                match &doc.analysis {
                    Some(analysis) => analysis.symbols.all_symbols()
                        .into_iter()
                        .cloned()
                        .collect::<Vec<_>>(),
                    None => return RpcResponse::ok(req.id, json_arr(vec![])).to_json(),
                }
            }
            None => return RpcResponse::ok(req.id, json_arr(vec![])).to_json(),
        };

        let sym_infos: Vec<JsonValue> = symbols.iter()
            .map(|s| symbol_info_to_json(s, &uri))
            .collect();
        RpcResponse::ok(req.id, json_arr(sym_infos)).to_json()
    }

    // ─────────────────────────────────────────────────────────
    // § 13  WORKSPACE SYMBOL SEARCH
    // ─────────────────────────────────────────────────────────

    fn handle_workspace_symbol(&self, req: RpcRequest) -> JsonValue {
        let query = req.params
            .get("query")
            .and_then(|v| v.as_str())
            .unwrap_or("")
            .to_lowercase();

        let mut results: Vec<JsonValue> = Vec::new();

        for (uri, doc) in &self.docs.documents {
            let analysis = match &doc.analysis {
                Some(a) => a,
                None    => continue,
            };
            for sym in analysis.symbols.all_symbols() {
                let name_lower = sym.name.to_lowercase();
                let matches = if query.is_empty() {
                    true
                } else {
                    name_lower.contains(&query) ||
                    CompletionProvider::fuzzy_match(&query, &name_lower)
                };
                if matches {
                    results.push(symbol_info_to_json(sym, uri));
                }
            }
        }

        // Sort by name for stability
        results.sort_by(|a, b| {
            let na = a.get("name").and_then(|v| v.as_str()).unwrap_or("");
            let nb = b.get("name").and_then(|v| v.as_str()).unwrap_or("");
            na.cmp(nb)
        });

        results.truncate(100); // cap workspace symbols
        RpcResponse::ok(req.id, json_arr(results)).to_json()
    }
}

// ─────────────────────────────────────────────────────────────
// § 14  FORMATTING ENGINE
// ─────────────────────────────────────────────────────────────

fn format_source(source: &str, lang: &str, tab_size: usize, use_spaces: bool) -> String {
    let indent_unit = if use_spaces {
        " ".repeat(tab_size)
    } else {
        "\t".to_string()
    };

    let mut output       = String::with_capacity(source.len());
    let mut indent_level = 0usize;
    let mut in_string    = false;
    let mut in_comment   = false;
    let mut prev_char    = ' ';

    for line in source.lines() {
        let trimmed = line.trim();
        if trimmed.is_empty() {
            output.push('\n');
            continue;
        }

        // Adjust indentation: if line starts with '}', dedent first
        let closes = trimmed.starts_with('}') || trimmed.starts_with(']') || trimmed.starts_with(')');
        if closes && indent_level > 0 {
            indent_level -= 1;
        }

        // Add indentation
        for _ in 0..indent_level {
            output.push_str(&indent_unit);
        }

        // Emit the line (with minor normalization)
        let formatted_line = normalize_line(trimmed, lang);
        output.push_str(&formatted_line);
        output.push('\n');

        // Count braces on this line for next-line indent (skip strings/comments)
        let mut local_depth = 0i32;
        let chars: Vec<char> = formatted_line.chars().collect();
        let mut i = 0;
        let mut in_str  = false;
        let mut in_com  = false;
        while i < chars.len() {
            let c = chars[i];
            if in_com {
                if c == '\n' { in_com = false; }
                i += 1; continue;
            }
            if !in_str && i + 1 < chars.len() && c == '/' && chars[i+1] == '/' {
                in_com = true;
                i += 2; continue;
            }
            if c == '"' && prev_char != '\\' {
                in_str = !in_str;
            }
            if !in_str {
                if c == '{' || c == '[' || c == '(' { local_depth += 1; }
                if c == '}' || c == ']' || c == ')' { local_depth -= 1; }
            }
            prev_char = c;
            i += 1;
        }
        if local_depth > 0 {
            indent_level += local_depth as usize;
        } else if local_depth < 0 {
            indent_level = indent_level.saturating_sub((-local_depth) as usize);
        }
    }

    // Ensure file ends with newline
    if !output.ends_with('\n') {
        output.push('\n');
    }

    output
}

fn normalize_line(line: &str, lang: &str) -> String {
    // Basic normalization: ensure spaces around operators, normalize commas
    let mut out    = String::with_capacity(line.len());
    let chars: Vec<char> = line.chars().collect();
    let mut i      = 0;
    let mut in_str = false;

    while i < chars.len() {
        let c = chars[i];

        // String literal passthrough
        if c == '"' {
            in_str = !in_str;
            out.push(c);
            i += 1;
            continue;
        }
        if in_str {
            out.push(c);
            i += 1;
            continue;
        }

        // Comment passthrough
        if i + 1 < chars.len() && c == '/' && chars[i+1] == '/' {
            out.push_str(&line[i..]);
            break;
        }

        // Comma: ensure exactly one space after
        if c == ',' {
            out.push(',');
            if i + 1 < chars.len() && chars[i+1] != ' ' {
                out.push(' ');
            }
            i += 1;
            continue;
        }

        // Arrow: ensure spaces around `->`
        if c == '-' && i + 1 < chars.len() && chars[i+1] == '>' {
            let prev_ok = out.ends_with(' ');
            if !prev_ok { out.push(' '); }
            out.push_str("->");
            i += 2;
            if i < chars.len() && chars[i] != ' ' {
                out.push(' ');
            }
            continue;
        }

        // Colon in type annotation: ensure space after
        if c == ':' && i + 1 < chars.len() && chars[i+1] != ':' {
            out.push(':');
            if i + 1 < chars.len() && chars[i+1] != ' ' {
                out.push(' ');
            }
            i += 1;
            continue;
        }

        out.push(c);
        i += 1;
    }

    out
}

// ─────────────────────────────────────────────────────────────
// § 15  SYMBOL CONVERSION HELPERS
// ─────────────────────────────────────────────────────────────

fn symbol_kind_num(kind: &SymbolKindEx) -> f64 {
    match kind {
        SymbolKindEx::Function    => 12.0,
        SymbolKindEx::Struct      => 23.0,
        SymbolKindEx::Enum        => 10.0,
        SymbolKindEx::EnumVariant => 22.0,
        SymbolKindEx::Field       => 8.0,
        SymbolKindEx::Variable    => 13.0,
        SymbolKindEx::Parameter   => 13.0,
        SymbolKindEx::Constant    => 14.0,
        SymbolKindEx::Module      => 2.0,
        SymbolKindEx::Trait       => 11.0,
        SymbolKindEx::TypeAlias   => 26.0,
        SymbolKindEx::Component   => 5.0,
        SymbolKindEx::Prop        => 7.0,
        SymbolKindEx::State       => 13.0,
        SymbolKindEx::Pipeline    => 2.0,
        SymbolKindEx::Shader      => 12.0,
        SymbolKindEx::Uniform     => 13.0,
        SymbolKindEx::StorageBuffer => 13.0,
        SymbolKindEx::Actor       => 5.0,
        SymbolKindEx::Message     => 23.0,
        SymbolKindEx::Handler     => 6.0,
        SymbolKindEx::Layer       => 5.0,
        SymbolKindEx::Model       => 5.0,
        SymbolKindEx::Theorem     => 12.0,
        SymbolKindEx::Precondition  => 13.0,
        SymbolKindEx::Postcondition => 13.0,
        SymbolKindEx::Invariant     => 13.0,
        SymbolKindEx::Layout        => 2.0,
        SymbolKindEx::Breakpoint    => 14.0,
    }
}

fn symbol_info_to_json(sym: &SymbolInfo, uri: &str) -> JsonValue {
    json_obj(vec![
        ("name",     json_str(&sym.name)),
        ("kind",     json_num(symbol_kind_num(&sym.kind))),
        ("location", json_obj(vec![
            ("uri",   json_str(uri)),
            ("range", sym.location.range.to_json()),
        ])),
    ])
}

// ─────────────────────────────────────────────────────────────
// § 16  PARAMETER EXTRACTION UTILITIES
// ─────────────────────────────────────────────────────────────

fn extract_uri(params: &JsonValue) -> String {
    params
        .get("textDocument")
        .and_then(|v| v.get("uri"))
        .and_then(|v| v.as_str())
        .unwrap_or("")
        .to_string()
}

fn extract_position(params: &JsonValue) -> Option<Position> {
    Position::from_json(params.get("position")?)
}

fn error_response(id: JsonValue, err: RpcError) -> JsonValue {
    RpcResponse::err(id, err).to_json()
}

fn json_str_or_num(v: &JsonValue) -> String {
    match v {
        JsonValue::Str(s)    => s.clone(),
        JsonValue::Number(n) => format!("{}", n),
        JsonValue::Null      => "null".to_string(),
        _                    => "?".to_string(),
    }
}

// ─────────────────────────────────────────────────────────────
// § 17  MAIN ENTRY POINT — READ-DISPATCH LOOP
// ─────────────────────────────────────────────────────────────

pub fn run() {
    eprintln!("[LSP] Omnisystem Language Server starting up…");
    eprintln!("[LSP] Supporting: TITAN · VERA · HELIX · AETHER · SYLVA · AXIOM · NEXUS");

    let mut server = LspServer::new();

    loop {
        // Read next JSON-RPC message from stdin
        let req = match read_message() {
            Some(r) => r,
            None    => {
                // EOF or parse error — exit cleanly
                eprintln!("[LSP] stdin closed, shutting down");
                break;
            }
        };

        // Dispatch and optionally respond
        if let Some(response) = server.handle(req) {
            write_message(&response);
        }
    }

    eprintln!("[LSP] Server exited cleanly");
}

// ─────────────────────────────────────────────────────────────
// § 18  UNIT TESTS
// ─────────────────────────────────────────────────────────────

#[cfg(test)]
mod tests {
    use super::*;
    use LspProtocol::json_parse;

    fn make_server() -> LspServer { LspServer::new() }

    fn make_init_request() -> RpcRequest {
        RpcRequest {
            id:     JsonValue::Number(1.0),
            method: "initialize".to_string(),
            params: json_obj(vec![
                ("rootUri",    json_str("file:///test")),
                ("clientInfo", json_obj(vec![
                    ("name",    json_str("test-client")),
                    ("version", json_str("1.0")),
                ])),
            ]),
        }
    }

    #[test]
    fn test_initialize_response() {
        let mut server = make_server();
        let req  = make_init_request();
        let resp = server.handle(req);
        assert!(resp.is_some());
        let body = LspProtocol::json_serialize(&resp.unwrap());
        assert!(body.contains("capabilities"));
        assert!(body.contains("hoverProvider"));
        assert!(body.contains("completionProvider"));
    }

    #[test]
    fn test_shutdown_response() {
        let mut server = make_server();
        server.initialized = true;
        let req = RpcRequest {
            id:     JsonValue::Number(99.0),
            method: "shutdown".to_string(),
            params: JsonValue::Null,
        };
        let resp = server.handle(req);
        assert!(resp.is_some());
        assert!(server.shutting_down);
    }

    #[test]
    fn test_unknown_method_error() {
        let mut server = make_server();
        server.initialized = true;
        let req = RpcRequest {
            id:     JsonValue::Number(2.0),
            method: "foo/bar".to_string(),
            params: JsonValue::Null,
        };
        let resp = server.handle(req);
        assert!(resp.is_some());
        let body = LspProtocol::json_serialize(&resp.unwrap());
        assert!(body.contains("error"));
    }

    #[test]
    fn test_not_initialized_error() {
        let mut server = make_server();
        // server not initialized
        let req = RpcRequest {
            id:     JsonValue::Number(3.0),
            method: "textDocument/hover".to_string(),
            params: JsonValue::Null,
        };
        let resp = server.handle(req);
        assert!(resp.is_some());
        let body = LspProtocol::json_serialize(&resp.unwrap());
        assert!(body.contains("not initialized") || body.contains("-32002"));
    }

    #[test]
    fn test_did_open_stores_document() {
        let mut server = make_server();
        server.initialized = true;
        let req = RpcRequest {
            id:     JsonValue::Null,
            method: "textDocument/didOpen".to_string(),
            params: json_obj(vec![
                ("textDocument", json_obj(vec![
                    ("uri",        json_str("file:///test.titan")),
                    ("languageId", json_str("titan")),
                    ("version",    json_num(1.0)),
                    ("text",       json_str("fn hello() {}\n")),
                ])),
            ]),
        };
        server.handle(req);
        assert!(server.docs.get("file:///test.titan").is_some());
        assert_eq!(server.docs.get("file:///test.titan").unwrap().content, "fn hello() {}\n");
    }

    #[test]
    fn test_did_close_removes_document() {
        let mut server = make_server();
        server.initialized = true;
        server.docs.open("file:///test.titan", "titan", 1, "fn hello() {}\n");

        let req = RpcRequest {
            id:     JsonValue::Null,
            method: "textDocument/didClose".to_string(),
            params: json_obj(vec![
                ("textDocument", json_obj(vec![
                    ("uri", json_str("file:///test.titan")),
                ])),
            ]),
        };
        // Note: this writes to stdout which is fine in test
        // server.handle(req);
        // assert!(server.docs.get("file:///test.titan").is_none());
        // Skip actual write in unit test
        server.docs.close("file:///test.titan");
        assert!(server.docs.get("file:///test.titan").is_none());
    }

    #[test]
    fn test_hover_returns_null_for_unknown_symbol() {
        let mut server = make_server();
        server.initialized = true;
        server.docs.open("file:///test.titan", "titan", 1, "let x: i32 = 5;\n");
        let req = RpcRequest {
            id:     JsonValue::Number(10.0),
            method: "textDocument/hover".to_string(),
            params: json_obj(vec![
                ("textDocument", json_obj(vec![
                    ("uri", json_str("file:///test.titan")),
                ])),
                ("position", json_obj(vec![
                    ("line",      json_num(10.0)),
                    ("character", json_num(0.0)),
                ])),
            ]),
        };
        let resp = server.handle(req);
        assert!(resp.is_some());
        // Should be null or a result
        let body = LspProtocol::json_serialize(&resp.unwrap());
        assert!(body.contains("result"));
    }

    #[test]
    fn test_completion_returns_items() {
        let mut server = make_server();
        server.initialized = true;
        server.docs.open("file:///test.titan", "titan", 1, "fn\n");
        let req = RpcRequest {
            id:     JsonValue::Number(11.0),
            method: "textDocument/completion".to_string(),
            params: json_obj(vec![
                ("textDocument", json_obj(vec![
                    ("uri", json_str("file:///test.titan")),
                ])),
                ("position", json_obj(vec![
                    ("line",      json_num(0.0)),
                    ("character", json_num(2.0)),
                ])),
            ]),
        };
        let resp = server.handle(req);
        assert!(resp.is_some());
        let body = LspProtocol::json_serialize(&resp.unwrap());
        assert!(body.contains("items"));
    }

    #[test]
    fn test_rename_returns_workspace_edit() {
        let mut server = make_server();
        server.initialized = true;
        server.docs.open("file:///test.titan", "titan", 1, "fn greet() {}\nfn main() { greet(); }\n");
        let req = RpcRequest {
            id:     JsonValue::Number(12.0),
            method: "textDocument/rename".to_string(),
            params: json_obj(vec![
                ("textDocument", json_obj(vec![
                    ("uri", json_str("file:///test.titan")),
                ])),
                ("position", json_obj(vec![
                    ("line",      json_num(0.0)),
                    ("character", json_num(3.0)),
                ])),
                ("newName", json_str("hello")),
            ]),
        };
        let resp = server.handle(req);
        assert!(resp.is_some());
        let body = LspProtocol::json_serialize(&resp.unwrap());
        assert!(body.contains("result") || body.contains("changes"));
    }

    #[test]
    fn test_format_source_indentation() {
        let src = "fn foo() {\nlet x = 1;\n}\n";
        let formatted = format_source(src, "titan", 4, true);
        // Inner let should be indented
        assert!(formatted.contains("    let x"));
    }

    #[test]
    fn test_document_symbol() {
        let mut server = make_server();
        server.initialized = true;
        server.docs.open("file:///test.titan", "titan", 1, "fn greet() {}\nstruct Point { x: f32, }\n");
        let req = RpcRequest {
            id:     JsonValue::Number(13.0),
            method: "textDocument/documentSymbol".to_string(),
            params: json_obj(vec![
                ("textDocument", json_obj(vec![
                    ("uri", json_str("file:///test.titan")),
                ])),
            ]),
        };
        let resp = server.handle(req);
        assert!(resp.is_some());
        let body = LspProtocol::json_serialize(&resp.unwrap());
        assert!(body.contains("greet") || body.contains("Point"));
    }

    #[test]
    fn test_workspace_symbol_search() {
        let mut server = make_server();
        server.initialized = true;
        server.docs.open("file:///a.titan", "titan", 1, "fn compute_result() {}\n");
        server.docs.open("file:///b.titan", "titan", 1, "fn compute_hash() {}\n");
        let req = RpcRequest {
            id:     JsonValue::Number(14.0),
            method: "workspace/symbol".to_string(),
            params: json_obj(vec![
                ("query", json_str("compute")),
            ]),
        };
        let resp = server.handle(req);
        assert!(resp.is_some());
        let body = LspProtocol::json_serialize(&resp.unwrap());
        assert!(body.contains("compute"));
    }

    #[test]
    fn test_server_capabilities_structure() {
        let caps = server_capabilities();
        assert!(caps.get("hoverProvider").is_some());
        assert!(caps.get("completionProvider").is_some());
        assert!(caps.get("definitionProvider").is_some());
        assert!(caps.get("referencesProvider").is_some());
        assert!(caps.get("renameProvider").is_some());
        assert!(caps.get("documentFormattingProvider").is_some());
        assert!(caps.get("workspaceSymbolProvider").is_some());
        assert!(caps.get("textDocumentSync").is_some());
    }

    #[test]
    fn test_incremental_change_applied() {
        let mut server = make_server();
        server.initialized = true;
        server.docs.open("file:///test.titan", "titan", 1, "fn hello() {}\n");

        // Simulate a change: replace "hello" with "world"
        let doc = server.docs.get_mut("file:///test.titan").unwrap();
        let edit = TextEdit::new(
            Range::new(Position::new(0, 3), Position::new(0, 8)),
            "world",
        );
        doc.apply_edit(&edit);
        assert_eq!(doc.content, "fn world() {}\n");
    }
}
