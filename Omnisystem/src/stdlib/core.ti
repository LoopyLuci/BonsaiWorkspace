// stdlib/core.ti — Core primitives and foundational types
// Provides the most essential building blocks for all Titan programs

extern "titan" {
    fn heap_alloc_term() -> i64;
    fn heap_set_tag(a: i64, b: i64);
    fn heap_get_tag(a: i64) -> i64;
    fn heap_set_body(a: i64, b: i64);
    fn heap_get_body(a: i64) -> i64;
    fn heap_set_arg(a: i64, b: i64);
    fn heap_get_arg(a: i64) -> i64;
    fn heap_set_domain(a: i64, b: i64);
    fn heap_get_domain(a: i64) -> i64;
    fn heap_free(a: i64);
    fn system_exit(code: i64);
    fn system_panic(msg: i64);
}

// ── Tag definitions ──────────────────────────────────────────────────────
const TAG_NONE:      i64 = 0;
const TAG_BOOL:      i64 = 1;
const TAG_INT:       i64 = 2;
const TAG_FLOAT:     i64 = 3;
const TAG_CHAR:      i64 = 4;
const TAG_STRING:    i64 = 5;
const TAG_VEC:       i64 = 6;
const TAG_OPTION:    i64 = 7;
const TAG_RESULT:    i64 = 8;
const TAG_REF:       i64 = 9;
const TAG_PTR:       i64 = 10;

// ── Option type ──────────────────────────────────────────────────────────
// Some(v): body = v, arg = 1 (marker)
// None:    body = 0, arg = 0

pub fn option_some(v: i64) -> i64 {
    let opt = heap_alloc_term();
    heap_set_tag(opt, TAG_OPTION);
    heap_set_body(opt, v);
    heap_set_arg(opt, 1);
    return opt;
}

pub fn option_none() -> i64 {
    let opt = heap_alloc_term();
    heap_set_tag(opt, TAG_OPTION);
    heap_set_body(opt, 0);
    heap_set_arg(opt, 0);
    return opt;
}

pub fn option_is_some(opt: i64) -> i64 {
    if heap_get_arg(opt) == 1 {
        return 1;
    }
    return 0;
}

pub fn option_is_none(opt: i64) -> i64 {
    if heap_get_arg(opt) == 0 {
        return 1;
    }
    return 0;
}

pub fn option_unwrap(opt: i64) -> i64 {
    if option_is_none(opt) == 1 {
        system_panic(heap_alloc_term());
    }
    return heap_get_body(opt);
}

pub fn option_unwrap_or(opt: i64, default: i64) -> i64 {
    if option_is_some(opt) == 1 {
        return heap_get_body(opt);
    }
    return default;
}

pub fn option_map(opt: i64, f: fn(i64) -> i64) -> i64 {
    if option_is_some(opt) == 1 {
        let val = heap_get_body(opt);
        return option_some(f(val));
    }
    return option_none();
}

// ── Result type ──────────────────────────────────────────────────────────
// Ok(v):  body = v, arg = 1 (marker)
// Err(e): body = e, arg = 0 (marker)

pub fn result_ok(v: i64) -> i64 {
    let res = heap_alloc_term();
    heap_set_tag(res, TAG_RESULT);
    heap_set_body(res, v);
    heap_set_arg(res, 1);
    return res;
}

pub fn result_err(e: i64) -> i64 {
    let res = heap_alloc_term();
    heap_set_tag(res, TAG_RESULT);
    heap_set_body(res, e);
    heap_set_arg(res, 0);
    return res;
}

pub fn result_is_ok(res: i64) -> i64 {
    if heap_get_arg(res) == 1 {
        return 1;
    }
    return 0;
}

pub fn result_is_err(res: i64) -> i64 {
    if heap_get_arg(res) == 0 {
        return 1;
    }
    return 0;
}

pub fn result_unwrap(res: i64) -> i64 {
    if result_is_err(res) == 1 {
        system_panic(heap_alloc_term());
    }
    return heap_get_body(res);
}

pub fn result_unwrap_err(res: i64) -> i64 {
    if result_is_ok(res) == 1 {
        system_panic(heap_alloc_term());
    }
    return heap_get_body(res);
}

pub fn result_unwrap_or(res: i64, default: i64) -> i64 {
    if result_is_ok(res) == 1 {
        return heap_get_body(res);
    }
    return default;
}

// ── Boolean logic ────────────────────────────────────────────────────────
pub fn bool_and(a: i64, b: i64) -> i64 {
    if a != 0 && b != 0 {
        return 1;
    }
    return 0;
}

pub fn bool_or(a: i64, b: i64) -> i64 {
    if a != 0 || b != 0 {
        return 1;
    }
    return 0;
}

pub fn bool_not(a: i64) -> i64 {
    if a == 0 {
        return 1;
    }
    return 0;
}

pub fn bool_xor(a: i64, b: i64) -> i64 {
    let a_bool = if a != 0 { 1 } else { 0 };
    let b_bool = if b != 0 { 1 } else { 0 };
    if a_bool != b_bool {
        return 1;
    }
    return 0;
}

// ── Reference counting (Rc) ──────────────────────────────────────────────
// tag = TAG_REF
// body = value, arg = refcount, domain = next_ref

pub fn rc_new(v: i64) -> i64 {
    let rc = heap_alloc_term();
    heap_set_tag(rc, TAG_REF);
    heap_set_body(rc, v);
    heap_set_arg(rc, 1);
    heap_set_domain(rc, 0);
    return rc;
}

pub fn rc_clone(rc: i64) -> i64 {
    let count = heap_get_arg(rc);
    heap_set_arg(rc, count + 1);
    return rc;
}

pub fn rc_release(rc: i64) -> i64 {
    let count = heap_get_arg(rc);
    if count <= 1 {
        heap_free(rc);
        return 0;
    }
    heap_set_arg(rc, count - 1);
    return rc;
}

pub fn rc_deref(rc: i64) -> i64 {
    return heap_get_body(rc);
}

pub fn rc_count(rc: i64) -> i64 {
    return heap_get_arg(rc);
}

// ── Panic and assertions ─────────────────────────────────────────────────
pub fn panic(msg: i64) {
    system_panic(msg);
}

pub fn assert(cond: i64, msg: i64) {
    if cond == 0 {
        system_panic(msg);
    }
}

pub fn assert_eq(a: i64, b: i64, msg: i64) {
    if a != b {
        system_panic(msg);
    }
}

pub fn assert_ne(a: i64, b: i64, msg: i64) {
    if a == b {
        system_panic(msg);
    }
}

// ── Comparison helpers ───────────────────────────────────────────────────
pub fn min(a: i64, b: i64) -> i64 {
    if a < b {
        return a;
    }
    return b;
}

pub fn max(a: i64, b: i64) -> i64 {
    if a > b {
        return a;
    }
    return b;
}

pub fn clamp(v: i64, min_v: i64, max_v: i64) -> i64 {
    let clamped = max(v, min_v);
    return min(clamped, max_v);
}

pub fn abs(v: i64) -> i64 {
    if v < 0 {
        return -v;
    }
    return v;
}

// ── Sign and comparison ──────────────────────────────────────────────────
pub fn sign(v: i64) -> i64 {
    if v > 0 {
        return 1;
    }
    if v < 0 {
        return -1;
    }
    return 0;
}

pub fn cmp_eq(a: i64, b: i64) -> i64 {
    if a == b { return 1; }
    return 0;
}

pub fn cmp_ne(a: i64, b: i64) -> i64 {
    if a != b { return 1; }
    return 0;
}

pub fn cmp_lt(a: i64, b: i64) -> i64 {
    if a < b { return 1; }
    return 0;
}

pub fn cmp_le(a: i64, b: i64) -> i64 {
    if a <= b { return 1; }
    return 0;
}

pub fn cmp_gt(a: i64, b: i64) -> i64 {
    if a > b { return 1; }
    return 0;
}

pub fn cmp_ge(a: i64, b: i64) -> i64 {
    if a >= b { return 1; }
    return 0;
}
