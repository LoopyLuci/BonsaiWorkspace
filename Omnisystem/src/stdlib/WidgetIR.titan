// Widget Intermediate Representation — Titan type system
// Shared IR used by the live widget conversion engine

pub enum WidgetKind {
    Button,
    Input,
    Textarea,
    Checkbox,
    Radio,
    Toggle,
    Select,
    Slider,
    Card,
    Panel,
    Modal,
    Drawer,
    Tab,
    TabGroup,
    Accordion,
    List,
    ListItem,
    Table,
    Grid,
    Form,
    Label,
    Badge,
    Tag,
    Progress,
    Spinner,
    Icon,
    Image,
    Avatar,
    Divider,
    Container,
    NavBar,
    Sidebar,
    Tooltip,
    Toast,
    Alert,
    Chart,
    Breadcrumb,
    Pagination,
    Stepper,
    Rating,
    Chip,
    Unknown,
}

pub enum WidgetVariant {
    Primary,
    Secondary,
    Danger,
    Warning,
    Success,
    Ghost,
    Outline,
    Link,
    Flat,
    Filled,
    Tonal,
}

pub enum WidgetSize {
    Xs,
    Sm,
    Md,
    Lg,
    Xl,
}

pub enum ConversionConfidence {
    High,
    Medium,
    Low,
}

pub struct WidgetStyle {
    color:         Option<String>,
    background:    Option<String>,
    border:        Option<String>,
    border_radius: Option<String>,
    padding:       Option<String>,
    margin:        Option<String>,
    width:         Option<String>,
    height:        Option<String>,
    font_size:     Option<String>,
    font_weight:   Option<String>,
    display:       Option<String>,
    flex_dir:      Option<String>,
    gap:           Option<String>,
    align_items:   Option<String>,
    justify:       Option<String>,
    box_shadow:    Option<String>,
    cursor:        Option<String>,
    transition:    Option<String>,
}

pub struct WidgetEvent {
    name:    String,
    handler: String,
    params:  Vec<String>,
}

pub struct WidgetProp {
    name:        String,
    prop_type:   String,
    value:       Option<String>,
    required:    bool,
    description: Option<String>,
}

pub struct WidgetNode {
    id:           String,
    kind:         WidgetKind,
    name:         Option<String>,
    label:        Option<String>,
    placeholder:  Option<String>,
    value:        Option<String>,
    disabled:     bool,
    checked:      bool,
    required:     bool,
    variant:      Option<WidgetVariant>,
    size:         Option<WidgetSize>,
    icon:         Option<String>,
    style:        Option<WidgetStyle>,
    class_name:   Option<String>,
    props:        Vec<WidgetProp>,
    events:       Vec<WidgetEvent>,
    children:     Vec<WidgetNode>,
    options:      Vec<SelectOption>,
    raw:          Option<String>,
}

pub struct SelectOption {
    value: String,
    label: String,
}

pub struct WidgetIR {
    name:            String,
    description:     Option<String>,
    root_widget:     WidgetNode,
    imports:         Vec<String>,
    source_language: SourceLanguage,
    confidence:      ConversionConfidence,
    notes:           Vec<String>,
}

pub enum SourceLanguage {
    JavaScript,
    TypeScript,
    Css,
    Tauri,
    Python,
    Vera,
    Nexus,
    Titan,
}

pub enum TargetLanguage {
    Vera,
    Nexus,
    Titan,
    JavaScript,
    TypeScript,
    Css,
    Tauri,
    Python,
}

pub fn make_id(seed: &str) -> String {
    let mut id = String::new();
    for ch in seed.chars() {
        if ch.is_alphanumeric() {
            id.push(ch.to_ascii_lowercase());
        } else if ch == ' ' || ch == '-' || ch == '_' {
            if !id.ends_with('_') { id.push('_'); }
        }
    }
    id.trim_matches('_').to_string()
}

pub fn confidence_label(c: &ConversionConfidence) -> &'static str {
    match c {
        ConversionConfidence::High   => "High",
        ConversionConfidence::Medium => "Medium",
        ConversionConfidence::Low    => "Low",
    }
}

pub fn widget_kind_label(k: &WidgetKind) -> &'static str {
    match k {
        WidgetKind::Button    => "Button",
        WidgetKind::Input     => "Input",
        WidgetKind::Textarea  => "Textarea",
        WidgetKind::Checkbox  => "Checkbox",
        WidgetKind::Radio     => "Radio",
        WidgetKind::Toggle    => "Toggle",
        WidgetKind::Select    => "Select",
        WidgetKind::Slider    => "Slider",
        WidgetKind::Card      => "Card",
        WidgetKind::Panel     => "Panel",
        WidgetKind::Modal     => "Modal",
        WidgetKind::Form      => "Form",
        WidgetKind::List      => "List",
        WidgetKind::Table     => "Table",
        WidgetKind::Badge     => "Badge",
        WidgetKind::Progress  => "Progress",
        WidgetKind::Spinner   => "Spinner",
        WidgetKind::Container => "Container",
        WidgetKind::NavBar    => "NavBar",
        WidgetKind::Sidebar   => "Sidebar",
        WidgetKind::Toast     => "Toast",
        WidgetKind::Alert     => "Alert",
        _                     => "Widget",
    }
}
