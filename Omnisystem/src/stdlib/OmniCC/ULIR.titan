// OmniCC Universal Language Intermediate Representation — Titan source
// This is the canonical IR definition that backs the TypeScript ULIR.ts.
// All language parsers write ULIRModule; all generators read it.
// Supports 1000+ languages via 17 language families.

use std::collections::{Vec, HashMap, Option};

// ─── Core Enumerations ───────────────────────────────────────────────────────

pub enum LanguageFamily {
    CFamily,         // C, C++, Java, JS, TS, C#, Go, Kotlin, Swift, Dart
    PythonFamily,    // Python, Ruby, Lua, Perl, PHP, Groovy, Crystal, Nim
    Functional,      // Haskell, OCaml, F#, Elm, PureScript, Clojure, Scala
    Lisp,            // Common Lisp, Scheme, Racket, Clojure, Fennel
    Shell,           // Bash, Zsh, Fish, PowerShell, Batch, Dash
    Data,            // SQL, JSON, YAML, TOML, XML, CSV, HCL
    Web,             // HTML, CSS, SCSS, React/JSX, Vue, Svelte, Astro
    Systems,         // Rust, Zig, Odin, Carbon, D, Assembly, WASM
    MlScientific,    // R, Julia, MATLAB, Octave, Wolfram, APL, J, K
    Concurrent,      // Erlang, Elixir, Pony, Io, Oz, Chapel
    Logic,           // Prolog, Datalog, Alloy, MiniZinc, Mercury
    Legacy,          // COBOL, Fortran, BASIC, Pascal, Ada, ALGOL
    Template,        // Jinja, Handlebars, Mustache, Liquid, ERB
    Query,           // GraphQL, SPARQL, Cypher, OQL
    Omni,            // Titan, Vera, Nexus, Helix, Aether, Axiom, Sylva
    Esoteric,        // Brainfuck, Befunge, Whitespace, INTERCAL
    Unknown,
}

pub enum Paradigm {
    Imperative,
    Declarative,
    Functional,
    Oop,
    Logic,
    Reactive,
    Concurrent,
    Dataflow,
    Meta,
    Array,
    Stack,
    EventDriven,
    Agent,
    Scripting,
    Systems,
    Data,
    Unknown,
}

pub enum TypeSystem {
    StaticStrong,   // Java, Rust, Haskell
    StaticWeak,     // C, C++
    DynamicStrong,  // Python, Ruby
    DynamicWeak,    // JavaScript, PHP
    DynamicDuck,    // Lua, older Ruby
    Gradual,        // TypeScript, Python with hints
    Inferred,       // Haskell, OCaml, Rust
    Dependent,      // Idris, Agda, Coq
    Structural,     // Go, TypeScript interfaces
    Nominal,        // Java, C#, Kotlin
    None,           // Assembly, COBOL
    Unknown,
}

pub enum MemoryModel {
    Gc,             // Java, Go, C#, Python
    Manual,         // C, C++
    Ownership,      // Rust
    Arc,            // Swift, Objective-C
    Stack,          // Most languages for locals
    Region,         // Zig, arena allocators
    Managed,        // .NET runtime
    None,           // Scripting/declarative
    Unknown,
}

pub enum Visibility {
    Public,
    Private,
    Protected,
    Internal,
    Package,
    Module,
}

pub enum ConversionConfidence {
    Exact,
    High,
    Medium,
    Low,
    Partial,
}

// ─── ULIRType — Represents any type in any language ──────────────────────────

pub struct ULIRType {
    pub name: String,
    pub nullable: Bool,
    pub optional: Bool,
    pub generic: Vec<ULIRType>,
    pub is_array: Bool,
    pub array_dims: Int,
    pub is_function: Bool,
    pub params: Option<Vec<ULIRType>>,
    pub returns: Option<ULIRType>,
    pub is_union: Bool,
    pub union_members: Option<Vec<ULIRType>>,
    pub is_intersection: Bool,
    pub is_tuple: Bool,
    pub is_literal: Bool,
    pub literal_value: Option<String>,
    pub is_primitive: Bool,
    pub is_mapped: Bool,
    pub original_src: String,
}

// Primitive type constants
pub const VOID_TYPE:    ULIRType = ULIRType { name: "void",    nullable: false, optional: false, generic: [], is_array: false, array_dims: 0, is_function: false, params: None, returns: None, is_union: false, union_members: None, is_intersection: false, is_tuple: false, is_literal: false, literal_value: None, is_primitive: true,  is_mapped: false, original_src: "void" };
pub const STRING_TYPE:  ULIRType = ULIRType { name: "String",  nullable: false, optional: false, generic: [], is_array: false, array_dims: 0, is_function: false, params: None, returns: None, is_union: false, union_members: None, is_intersection: false, is_tuple: false, is_literal: false, literal_value: None, is_primitive: true,  is_mapped: false, original_src: "String" };
pub const INT_TYPE:     ULIRType = ULIRType { name: "Int",     nullable: false, optional: false, generic: [], is_array: false, array_dims: 0, is_function: false, params: None, returns: None, is_union: false, union_members: None, is_intersection: false, is_tuple: false, is_literal: false, literal_value: None, is_primitive: true,  is_mapped: false, original_src: "Int" };
pub const FLOAT_TYPE:   ULIRType = ULIRType { name: "Float",   nullable: false, optional: false, generic: [], is_array: false, array_dims: 0, is_function: false, params: None, returns: None, is_union: false, union_members: None, is_intersection: false, is_tuple: false, is_literal: false, literal_value: None, is_primitive: true,  is_mapped: false, original_src: "Float" };
pub const BOOL_TYPE:    ULIRType = ULIRType { name: "Bool",    nullable: false, optional: false, generic: [], is_array: false, array_dims: 0, is_function: false, params: None, returns: None, is_union: false, union_members: None, is_intersection: false, is_tuple: false, is_literal: false, literal_value: None, is_primitive: true,  is_mapped: false, original_src: "Bool" };
pub const ANY_TYPE:     ULIRType = ULIRType { name: "Any",     nullable: true,  optional: true,  generic: [], is_array: false, array_dims: 0, is_function: false, params: None, returns: None, is_union: false, union_members: None, is_intersection: false, is_tuple: false, is_literal: false, literal_value: None, is_primitive: false, is_mapped: false, original_src: "any" };
pub const UNKNOWN_TYPE: ULIRType = ULIRType { name: "Unknown", nullable: true,  optional: true,  generic: [], is_array: false, array_dims: 0, is_function: false, params: None, returns: None, is_union: false, union_members: None, is_intersection: false, is_tuple: false, is_literal: false, literal_value: None, is_primitive: false, is_mapped: false, original_src: "?" };

// ─── ULIRParam — Function parameters ─────────────────────────────────────────

pub struct ULIRParam {
    pub name: String,
    pub type_: ULIRType,
    pub default_value: Option<ULIRExpression>,
    pub is_variadic: Bool,
    pub is_keyword: Bool,    // Python **kwargs style
    pub is_ref: Bool,
    pub is_mut: Bool,
    pub label: Option<String>,  // Swift external label
}

// ─── ULIRGeneric — Generic type parameters ────────────────────────────────────

pub struct ULIRGeneric {
    pub name: String,
    pub bounds: Vec<ULIRType>,
    pub default_type: Option<ULIRType>,
    pub is_variadic: Bool,
}

// ─── ULIRSignature — Function signatures ─────────────────────────────────────

pub struct ULIRSignature {
    pub params: Vec<ULIRParam>,
    pub returns: ULIRType,
    pub throws: Vec<ULIRType>,
    pub self_param: Option<String>,  // 'self', 'this', '@'
}

// ─── ULIRUnit — A semantic unit (function, class, struct, etc.) ───────────────

pub enum ULIRUnitKind {
    Function, Method, Constructor, Destructor, Accessor,
    Lambda, Closure, Generator, Coroutine, Macro,
    Class, Struct, Interface, Trait, Mixin, Protocol,
    Enum, Union, TaggedUnion, Record, TupleType,
    TypeAlias, Newtype, OpaqueType,
    Actor, Channel, Thread, CoroutineDef,
    Variable, Constant, Field, Property, Parameter,
    Namespace, ModuleDecl, PackageDecl,
    Theorem, Proof, AxiomDecl, Invariant,
    Test, Benchmark, Fixture,
    WidgetComponent, WidgetLayout, WidgetStyle, WidgetEvent,
    Table, View, Schema, QueryUnit,
}

pub struct ULIRUnit {
    pub kind: ULIRUnitKind,
    pub name: String,
    pub visibility: Visibility,
    pub signature: ULIRSignature,
    pub body: Vec<ULIRStatement>,
    pub attributes: Vec<String>,
    pub doc_comment: String,
    pub source_lines: (Int, Int),
    pub is_async: Bool,
    pub is_static: Bool,
    pub is_abstract: Bool,
    pub is_final: Bool,
    pub is_override: Bool,
    pub is_extern: Bool,
    pub generics: Vec<ULIRGeneric>,
    pub extends_: Vec<String>,
    pub implements_: Vec<String>,
    pub children: Vec<ULIRUnit>,
    pub original_source: String,
    pub confidence: ConversionConfidence,
}

// ─── ULIRImport ───────────────────────────────────────────────────────────────

pub struct ULIRImport {
    pub path: String,
    pub alias: Option<String>,
    pub names: Vec<String>,
    pub is_default: Bool,
    pub is_wildcard: Bool,
    pub kind: String,   // 'module' | 'package' | 'relative' | 'stdlib' | 'external'
    pub original_syntax: String,
}

// ─── ULIRMetadata ─────────────────────────────────────────────────────────────

pub struct ULIRMetadata {
    pub source_lines: Int,
    pub paradigms: Vec<Paradigm>,
    pub type_system: TypeSystem,
    pub memory_model: MemoryModel,
    pub uses_async: Bool,
    pub uses_generics: Bool,
    pub uses_reflection: Bool,
    pub uses_metaprogramming: Bool,
    pub has_tests: Bool,
    pub has_ui: Bool,
    pub has_side_effects: Bool,
    pub entry_point: Option<String>,
}

// ─── ULIRModule — Top-level compilation unit ──────────────────────────────────

pub struct ULIRModule {
    pub name: String,
    pub source_language: String,
    pub source_family: LanguageFamily,
    pub units: Vec<ULIRUnit>,
    pub imports: Vec<ULIRImport>,
    pub exports: Vec<String>,
    pub doc_comment: String,
    pub metadata: ULIRMetadata,
    pub confidence: ConversionConfidence,
    pub notes: Vec<String>,
    pub widget_units: Option<Vec<ULIRUnit>>,
}

// ─── ULIRExpression ───────────────────────────────────────────────────────────

pub enum ULIRExpressionKind {
    Literal, Identifier, Call, MethodCall, New,
    FieldAccess, Index, BinaryOp, UnaryOp, Ternary,
    Cast, Instanceof, Typeof, Await, YieldExpr,
    LambdaExpr, ArrayLit, ObjectLit, TupleLit,
    TemplateLit, Spread, Destructure, MatchExpr, IfExpr,
    Range, ClosureExpr, RawExpr,
}

pub struct ULIRExpression {
    pub kind: ULIRExpressionKind,
    pub raw: String,          // ALWAYS set — fallback for generators
    pub type_: Option<ULIRType>,
    pub callee: Option<String>,
    pub args: Option<Vec<ULIRExpression>>,
    pub op: Option<String>,
    pub left: Option<ULIRExpression>,
    pub right: Option<ULIRExpression>,
    pub literal_kind: Option<String>,
    pub literal_value: Option<String>,
    pub object: Option<ULIRExpression>,
    pub field: Option<String>,
    pub elements: Option<Vec<ULIRExpression>>,
}

pub fn raw_expr(raw: String) -> ULIRExpression {
    ULIRExpression { kind: ULIRExpressionKind::RawExpr, raw, type_: None, callee: None, args: None, op: None, left: None, right: None, literal_kind: None, literal_value: None, object: None, field: None, elements: None }
}

pub fn lit_expr(kind: String, value: String) -> ULIRExpression {
    ULIRExpression { kind: ULIRExpressionKind::Literal, raw: value.clone(), literal_kind: Some(kind), literal_value: Some(value), type_: None, callee: None, args: None, op: None, left: None, right: None, object: None, field: None, elements: None }
}

// ─── ULIRStatement ────────────────────────────────────────────────────────────

pub enum ULIRStatementKind {
    Assign, Declare, Return, Yield, Throw, Break, Continue,
    If, ElseIf, Else, Switch, Case, Match,
    For, ForIn, ForOf, While, DoWhile, Loop,
    Try, Catch, Finally,
    ExpressionStmt, Block, Comment, Label, Goto,
    Defer, With, Using, AsyncStmt, AwaitStmt,
    Assert, Print, Raw,
}

pub struct ULIRStatement {
    pub kind: ULIRStatementKind,
    pub condition: Option<ULIRExpression>,
    pub target: Option<ULIRExpression>,
    pub value: Option<ULIRExpression>,
    pub type_: Option<ULIRType>,
    pub is_mut: Option<Bool>,
    pub is_const: Option<Bool>,
    pub body: Option<Vec<ULIRStatement>>,
    pub else_body: Option<Vec<ULIRStatement>>,
    pub iter_var: Option<String>,
    pub iter_source: Option<ULIRExpression>,
    pub raw: Option<String>,
    pub comment: Option<String>,
    pub line_number: Option<Int>,
}

// ─── Conversion Request / Result ──────────────────────────────────────────────

pub struct OmniCCConversionRequest {
    pub source: String,
    pub source_lang: Option<String>,  // None = auto-detect
    pub target_lang: String,
    pub filename: Option<String>,
    pub widget_name_hint: Option<String>,
    pub project_mode: Option<Bool>,
    pub project_files: Option<Vec<ProjectFile>>,
    pub options: Option<ConversionOptions>,
}

pub struct ProjectFile {
    pub path: String,
    pub content: String,
    pub relative_path: Option<String>,
    pub detected_lang: Option<String>,
}

pub struct ConversionOptions {
    pub preserve_comments: Bool,
    pub preserve_formatting: Bool,
    pub idiomatic_target: Bool,
    pub include_tests: Bool,
    pub strict_types: Bool,
    pub target_runtime: Option<String>,
    pub encoding: String,
    pub line_endings: String,   // "lf" | "crlf" | "cr"
    pub enable_widget_bridge: Option<Bool>,
    pub merge_widget_bridge: Option<Bool>,
}

pub const DEFAULT_OPTIONS: ConversionOptions = ConversionOptions {
    preserve_comments: true,
    preserve_formatting: false,
    idiomatic_target: true,
    include_tests: false,
    strict_types: true,
    target_runtime: None,
    encoding: "utf-8",
    line_endings: "lf",
    enable_widget_bridge: Some(true),
    merge_widget_bridge: Some(true),
};

pub struct WidgetBridgeSummary {
    pub detected: Bool,
    pub widget_count: Int,
    pub converted_count: Int,
    pub confidence: Int,
    pub preview_html: String,
}

pub struct ProjectFileResult {
    pub path: Option<String>,
    pub target_path: Option<String>,
    pub output: Option<String>,
    pub source_lang_id: Option<String>,
    pub target_lang_id: Option<String>,
    pub lines_in: Option<Int>,
    pub lines_out: Option<Int>,
    pub duration_ms: Option<Int>,
    pub confidence: Int,
    pub notes: Option<Vec<String>>,
    pub error: Option<String>,
}

pub struct OmniCCConversionResult {
    pub success: Bool,
    pub output: String,
    pub source_language: String,
    pub target_language: String,
    pub confidence: Int,   // 0–100
    pub detection_signals: Option<Vec<String>>,
    pub notes: Vec<String>,
    pub ir: Option<ULIRModule>,
    pub widget_bridge: Option<WidgetBridgeSummary>,
    pub lines_converted: Int,
    pub duration_ms: Int,
    pub project_results: Option<Vec<ProjectFileResult>>,
}
