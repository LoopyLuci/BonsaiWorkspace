// crypto.titan — Omnisystem Standard Library: Cryptographic Primitives
// Language: TITAN  |  Part of the 7-language Omni-Languages ecosystem
// Provides: SHA3-256/512, AES-GCM, Ed25519, ChaCha20, Poly1305, HMAC, PBKDF2, SecureRandom

module stdlib::crypto

use core::mem
use stdlib::io::IoError

// ============================================================
// SECTION 1: SHA3 / Keccak-f[1600] Sponge
// ============================================================

// Keccak round constants
const KECCAK_ROUNDS: usize = 24
const KECCAK_RC: [u64; 24] = [
    0x0000000000000001, 0x0000000000008082, 0x800000000000808A, 0x8000000080008000,
    0x000000000000808B, 0x0000000080000001, 0x8000000080008081, 0x8000000000008009,
    0x000000000000008A, 0x0000000000000088, 0x0000000080008009, 0x000000008000000A,
    0x000000008000808B, 0x800000000000008B, 0x8000000000008089, 0x8000000000008003,
    0x8000000000008002, 0x8000000000000080, 0x000000000000800A, 0x800000008000000A,
    0x8000000080008081, 0x8000000000008080, 0x0000000080000001, 0x8000000080008008,
]

// Rotation offsets (r[x][y] for the rho step)
const KECCAK_RHO: [[u32; 5]; 5] = [
    [ 0, 36,  3, 41, 18],
    [ 1, 44, 10, 45,  2],
    [62,  6, 43, 15, 61],
    [28, 55, 25, 21, 56],
    [27, 20, 39,  8, 14],
]

// Pi permutation indices
const KECCAK_PI: [(usize, usize); 25] = [
    (0,0),(1,0),(2,0),(3,0),(4,0),
    (0,1),(1,1),(2,1),(3,1),(4,1),
    (0,2),(1,2),(2,2),(3,2),(4,2),
    (0,3),(1,3),(2,3),(3,3),(4,3),
    (0,4),(1,4),(2,4),(3,4),(4,4),
]

fn rotl64(x: u64, n: u32) -> u64 {
    (x << n) | (x >> (64 - n))
}

// Keccak state is 5×5 array of u64 = 1600 bits
fn keccak_f(state: &mut [u64; 25]) {
    for round in 0..KECCAK_ROUNDS {
        // Theta
        let mut c = [0u64; 5]
        for x in 0..5 {
            c[x] = state[x] ^ state[x+5] ^ state[x+10] ^ state[x+15] ^ state[x+20]
        }
        let mut d = [0u64; 5]
        for x in 0..5 {
            d[x] = c[(x + 4) % 5] ^ rotl64(c[(x + 1) % 5], 1)
        }
        for i in 0..25 {
            state[i] ^= d[i % 5]
        }

        // Rho and Pi combined
        let mut b = [0u64; 25]
        for x in 0..5 {
            for y in 0..5 {
                let src = x + 5 * y
                let rot = KECCAK_RHO[x][y]
                let dst = y + 5 * ((2 * x + 3 * y) % 5)
                b[dst] = rotl64(state[src], rot)
            }
        }

        // Chi
        for x in 0..5 {
            for y in 0..5 {
                state[x + 5*y] = b[x + 5*y] ^ ((!b[(x+1)%5 + 5*y]) & b[(x+2)%5 + 5*y])
            }
        }

        // Iota
        state[0] ^= KECCAK_RC[round]
    }
}

fn keccak_absorb(state: &mut [u64; 25], rate_bytes: usize, data: &[u8]) {
    let rate_words = rate_bytes / 8
    let mut offset = 0
    while offset + rate_bytes <= data.len() {
        for i in 0..rate_words {
            let chunk = &data[offset + i*8..offset + i*8 + 8]
            state[i] ^= u64::from_le_bytes([
                chunk[0], chunk[1], chunk[2], chunk[3],
                chunk[4], chunk[5], chunk[6], chunk[7],
            ])
        }
        keccak_f(state)
        offset += rate_bytes
    }
    // Remaining bytes — handled by caller via padding
}

fn sha3_hash(rate_bytes: usize, output_bytes: usize, input: &[u8]) -> Vec<u8> {
    let mut state = [0u64; 25]
    let mut buf   = Vec::from(input)

    // SHA3 padding: 0x06 ... 0x80
    buf.push(0x06)
    while buf.len() % rate_bytes != 0 {
        buf.push(0x00)
    }
    *buf.last_mut().unwrap() |= 0x80

    keccak_absorb(&mut state, rate_bytes, &buf)

    // Squeeze output
    let mut out = Vec::with_capacity(output_bytes)
    let rate_words = rate_bytes / 8
    let mut needed = output_bytes
    loop {
        for i in 0..rate_words {
            if needed == 0 { break }
            let word = state[i].to_le_bytes()
            let take = needed.min(8)
            out.extend_from_slice(&word[..take])
            needed -= take
        }
        if needed == 0 { break }
        keccak_f(&mut state)
    }

    out
}

// --- Sha3_256 ---
pub struct Sha3_256 {
    state:      [u64; 25],
    buf:        Vec<u8>,
    absorbed:   usize,
    finalized:  bool,
}

const SHA3_256_RATE: usize = 136  // (1600 - 256*2) / 8

impl Sha3_256 {
    pub fn new() -> Self {
        Sha3_256 {
            state:     [0u64; 25],
            buf:       Vec::new(),
            absorbed:  0,
            finalized: false,
        }
    }

    pub fn update(&mut self, data: &[u8]) {
        assert!(!self.finalized, "Cannot update finalized hash")
        self.buf.extend_from_slice(data)

        while self.buf.len() - self.absorbed >= SHA3_256_RATE {
            let rate_words = SHA3_256_RATE / 8
            for i in 0..rate_words {
                let base = self.absorbed + i * 8
                let chunk = &self.buf[base..base + 8]
                self.state[i] ^= u64::from_le_bytes([
                    chunk[0], chunk[1], chunk[2], chunk[3],
                    chunk[4], chunk[5], chunk[6], chunk[7],
                ])
            }
            keccak_f(&mut self.state)
            self.absorbed += SHA3_256_RATE
        }
    }

    pub fn finalize(mut self) -> [u8; 32] {
        self.finalized = true
        let remaining = &self.buf[self.absorbed..]
        let mut pad = Vec::from(remaining)
        pad.push(0x06)
        while pad.len() % SHA3_256_RATE != 0 { pad.push(0x00) }
        *pad.last_mut().unwrap() |= 0x80

        let rate_words = SHA3_256_RATE / 8
        let mut offset = 0
        while offset < pad.len() {
            for i in 0..rate_words {
                let base = offset + i * 8
                let chunk = &pad[base..base + 8]
                self.state[i] ^= u64::from_le_bytes([
                    chunk[0], chunk[1], chunk[2], chunk[3],
                    chunk[4], chunk[5], chunk[6], chunk[7],
                ])
            }
            keccak_f(&mut self.state)
            offset += SHA3_256_RATE
        }

        let mut out = [0u8; 32]
        for i in 0..4 {
            let bytes = self.state[i].to_le_bytes()
            out[i*8..i*8+8].copy_from_slice(&bytes)
        }
        out
    }

    // One-shot convenience
    pub fn digest(data: &[u8]) -> [u8; 32] {
        let mut h = Sha3_256::new()
        h.update(data)
        h.finalize()
    }
}

// --- Sha3_512 ---
pub struct Sha3_512 {
    state:     [u64; 25],
    buf:       Vec<u8>,
    absorbed:  usize,
    finalized: bool,
}

const SHA3_512_RATE: usize = 72   // (1600 - 512*2) / 8

impl Sha3_512 {
    pub fn new() -> Self {
        Sha3_512 { state: [0u64; 25], buf: Vec::new(), absorbed: 0, finalized: false }
    }

    pub fn update(&mut self, data: &[u8]) {
        self.buf.extend_from_slice(data)
        while self.buf.len() - self.absorbed >= SHA3_512_RATE {
            let rate_words = SHA3_512_RATE / 8
            for i in 0..rate_words {
                let base = self.absorbed + i * 8
                let chunk = &self.buf[base..base + 8]
                self.state[i] ^= u64::from_le_bytes([
                    chunk[0], chunk[1], chunk[2], chunk[3],
                    chunk[4], chunk[5], chunk[6], chunk[7],
                ])
            }
            keccak_f(&mut self.state)
            self.absorbed += SHA3_512_RATE
        }
    }

    pub fn finalize(mut self) -> [u8; 64] {
        let remaining = &self.buf[self.absorbed..]
        let mut pad = Vec::from(remaining)
        pad.push(0x06)
        while pad.len() % SHA3_512_RATE != 0 { pad.push(0x00) }
        *pad.last_mut().unwrap() |= 0x80

        let rate_words = SHA3_512_RATE / 8
        let mut offset = 0
        while offset < pad.len() {
            for i in 0..rate_words {
                let base = offset + i * 8
                let chunk = &pad[base..base + 8]
                self.state[i] ^= u64::from_le_bytes([
                    chunk[0], chunk[1], chunk[2], chunk[3],
                    chunk[4], chunk[5], chunk[6], chunk[7],
                ])
            }
            keccak_f(&mut self.state)
            offset += SHA3_512_RATE
        }

        let mut out = [0u8; 64]
        for i in 0..8 {
            let bytes = self.state[i].to_le_bytes()
            out[i*8..i*8+8].copy_from_slice(&bytes)
        }
        out
    }

    pub fn digest(data: &[u8]) -> [u8; 64] {
        let mut h = Sha3_512::new()
        h.update(data)
        h.finalize()
    }
}

