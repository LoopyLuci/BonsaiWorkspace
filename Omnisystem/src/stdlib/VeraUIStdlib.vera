// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// PART 7: ADVANCED COMPONENTS - Table, Form, Modal, Tooltip, Dialog
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

actor Table {
    id: String,
    columns: Vec<String>,
    rows: Vec<HashMap<String, String>>,
    selected_row: i32,
    is_sortable: bool,
    sort_column: String,
    sort_ascending: bool,

    message AddColumn(column_name: String) -> Result<(), String> {
        self.columns.push(column_name)
        Ok(())
    }

    message AddRow(row: HashMap<String, String>) -> Result<(), String> {
        self.rows.push(row)
        Ok(())
    }

    message SelectRow(row_index: i32) -> Result<(), String> {
        if (row_index as usize) < self.rows.len() {
            self.selected_row = row_index
            Ok(())
        } else {
            Err("Invalid row index".to_string())
        }
    }

    message SortBy(column: String) -> Result<(), String> {
        self.sort_column = column
        self.sort_ascending = !self.sort_ascending
        Ok(())
    }

    message GetRowCount() -> Result<i32, String> {
        Ok(self.rows.len() as i32)
    }

    message GetColumnCount() -> Result<i32, String> {
        Ok(self.columns.len() as i32)
    }

    message GetSelectedRow() -> Result<i32, String> {
        Ok(self.selected_row)
    }
}

actor Form {
    id: String,
    fields: HashMap<String, String>,
    submitted: bool,
    validation_errors: HashMap<String, String>,

    message AddField(name: String, field_type: String) -> Result<(), String> {
        self.fields.insert(name, field_type)
        Ok(())
    }

    message SetFieldValue(name: String, value: String) -> Result<(), String> {
        self.fields.insert(name, value)
        Ok(())
    }

    message GetFieldValue(name: String) -> Result<String, String> {
        if let Some(value) = self.fields.get(&name) {
            Ok(value.clone())
        } else {
            Err("Field not found".to_string())
        }
    }

    message Submit() -> Result<(), String> {
        self.submitted = true
        Ok(())
    }

    message Reset() -> Result<(), String> {
        self.fields.clear()
        self.submitted = false
        self.validation_errors.clear()
        Ok(())
    }

    message AddValidationError(field: String, error: String) -> Result<(), String> {
        self.validation_errors.insert(field, error)
        Ok(())
    }

    message IsValid() -> Result<bool, String> {
        Ok(self.validation_errors.is_empty())
    }
}

actor Modal {
    id: String,
    title: String,
    content: String,
    is_open: bool,
    buttons: Vec<String>,
    backdrop_dismissible: bool,

    message Open() -> Result<(), String> {
        self.is_open = true
        Ok(())
    }

    message Close() -> Result<(), String> {
        self.is_open = false
        Ok(())
    }

    message SetTitle(title: String) -> Result<(), String> {
        self.title = title
        Ok(())
    }

    message SetContent(content: String) -> Result<(), String> {
        self.content = content
        Ok(())
    }

    message AddButton(label: String) -> Result<(), String> {
        self.buttons.push(label)
        Ok(())
    }

    message IsOpen() -> Result<bool, String> {
        Ok(self.is_open)
    }
}

actor Dialog {
    id: String,
    title: String,
    message: String,
    dialog_type: String,  // info, warning, error, success
    is_visible: bool,

    message Show(title: String, message: String) -> Result<(), String> {
        self.title = title
        self.message = message
        self.is_visible = true
        Ok(())
    }

    message Hide() -> Result<(), String> {
        self.is_visible = false
        Ok(())
    }

    message SetType(dialog_type: String) -> Result<(), String> {
        self.dialog_type = dialog_type
        Ok(())
    }
}

struct Tooltip {
    text: String,
    position: String,  // top, bottom, left, right
    delay_ms: i32,
    background_color: String,
    text_color: String,
}

impl Tooltip {
    pub fn new(text: String) -> Self {
        Tooltip {
            text: text,
            position: "top".to_string(),
            delay_ms: 300,
            background_color: "#333333".to_string(),
            text_color: "#FFFFFF".to_string(),
        }
    }

    pub fn set_position(&mut self, position: String) {
        self.position = position
    }

    pub fn set_delay(&mut self, delay_ms: i32) {
        self.delay_ms = delay_ms
    }
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// PART 8: STATE MANAGEMENT & REACTIVE UPDATES
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

struct State<T> {
    value: T,
    subscribers: Vec<String>,
}

impl State<String> {
    pub fn new(value: String) -> Self {
        State {
            value: value,
            subscribers: Vec::new(),
        }
    }

    pub fn get(&self) -> String {
        self.value.clone()
    }

    pub fn set(&mut self, value: String) {
        self.value = value
    }

    pub fn subscribe(&mut self, component_id: String) {
        self.subscribers.push(component_id)
    }

    pub fn notify_subscribers(&self) -> Vec<String> {
        self.subscribers.clone()
    }
}

actor StateManager {
    state_store: Arc<Mutex<HashMap<String, String>>>,
    watchers: HashMap<String, Vec<String>>,

    message SetState(key: String, value: String) -> Result<(), String> {
        state_store.lock().unwrap().insert(key, value)
        Ok(())
    }

    message GetState(key: String) -> Result<Option<String>, String> {
        let store = state_store.lock().unwrap()
        Ok(store.get(&key).cloned())
    }

    message Watch(key: String, watcher_id: String) -> Result<(), String> {
        if let Some(watchers_list) = self.watchers.get_mut(&key) {
            watchers_list.push(watcher_id)
        } else {
            self.watchers.insert(key, vec![watcher_id])
        }
        Ok(())
    }

    message GetWatchers(key: String) -> Result<Vec<String>, String> {
        Ok(self.watchers.get(&key).cloned().unwrap_or(vec![]))
    }
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// PART 9: LAYOUT UTILITIES & HELPERS
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

struct Box {
    width: i32,
    height: i32,
    padding: Spacing,
    margin: Spacing,
    background_color: String,
    border: Option<String>,
}

impl Box {
    pub fn new(width: i32, height: i32) -> Self {
        Box {
            width: width,
            height: height,
            padding: Spacing { top: 0, right: 0, bottom: 0, left: 0 },
            margin: Spacing { top: 0, right: 0, bottom: 0, left: 0 },
            background_color: "#FFFFFF".to_string(),
            border: None,
        }
    }

    pub fn with_padding(&mut self, top: i32, right: i32, bottom: i32, left: i32) -> &mut Self {
        self.padding = Spacing { top: top, right: right, bottom: bottom, left: left }
        self
    }

    pub fn with_margin(&mut self, top: i32, right: i32, bottom: i32, left: i32) -> &mut Self {
        self.margin = Spacing { top: top, right: right, bottom: bottom, left: left }
        self
    }

    pub fn with_background(&mut self, color: String) -> &mut Self {
        self.background_color = color
        self
    }
}

struct Spacer {
    width: i32,
    height: i32,
}

impl Spacer {
    pub fn new(width: i32, height: i32) -> Self {
        Spacer { width: width, height: height }
    }

    pub fn horizontal(width: i32) -> Self {
        Spacer { width: width, height: 0 }
    }

    pub fn vertical(height: i32) -> Self {
        Spacer { width: 0, height: height }
    }
}

struct Divider {
    color: String,
    thickness: i32,
    direction: String,  // horizontal, vertical
}

impl Divider {
    pub fn new() -> Self {
        Divider {
            color: "#CCCCCC".to_string(),
            thickness: 1,
            direction: "horizontal".to_string(),
        }
    }

    pub fn horizontal() -> Self {
        Divider {
            color: "#CCCCCC".to_string(),
            thickness: 1,
            direction: "horizontal".to_string(),
        }
    }

    pub fn vertical() -> Self {
        Divider {
            color: "#CCCCCC".to_string(),
            thickness: 1,
            direction: "vertical".to_string(),
        }
    }
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// PART 10: DIALOG & NOTIFICATION UTILITIES
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

pub struct Toast {
    message: String,
    toast_type: String,  // success, error, warning, info
    duration_ms: i32,
}

impl Toast {
    pub fn success(message: String) -> Self {
        Toast {
            message: message,
            toast_type: "success".to_string(),
            duration_ms: 3000,
        }
    }

    pub fn error(message: String) -> Self {
        Toast {
            message: message,
            toast_type: "error".to_string(),
            duration_ms: 5000,
        }
    }

    pub fn warning(message: String) -> Self {
        Toast {
            message: message,
            toast_type: "warning".to_string(),
            duration_ms: 4000,
        }
    }

    pub fn info(message: String) -> Self {
        Toast {
            message: message,
            toast_type: "info".to_string(),
            duration_ms: 3000,
        }
    }
}

pub struct Snackbar {
    message: String,
    action_label: String,
    duration_ms: i32,
    position: String,  // top, bottom
}

impl Snackbar {
    pub fn new(message: String) -> Self {
        Snackbar {
            message: message,
            action_label: "Dismiss".to_string(),
            duration_ms: 4000,
            position: "bottom".to_string(),
        }
    }
}

pub struct Alert {
    title: String,
    message: String,
    alert_type: String,  // primary, success, warning, danger
}

impl Alert {
    pub fn new(title: String, message: String) -> Self {
        Alert {
            title: title,
            message: message,
            alert_type: "primary".to_string(),
        }
    }

    pub fn danger(title: String, message: String) -> Self {
        Alert {
            title: title,
            message: message,
            alert_type: "danger".to_string(),
        }
    }

    pub fn success(title: String, message: String) -> Self {
        Alert {
            title: title,
            message: message,
            alert_type: "success".to_string(),
        }
    }
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// VERA UI TESTS
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

pub fn test_vera_ui() -> Result<(), String> {
    // Test Tooltip
    let tooltip = Tooltip::new("Helpful text".to_string())
    if tooltip.text != "Helpful text" {
        return Err("Tooltip test failed".to_string())
    }

    // Test Toast
    let toast = Toast::success("Operation completed".to_string())
    if toast.toast_type != "success" {
        return Err("Toast test failed".to_string())
    }

    // Test Alert
    let alert = Alert::new("Title".to_string(), "Message".to_string())
    if alert.title != "Title" {
        return Err("Alert test failed".to_string())
    }

    Ok(())
}
