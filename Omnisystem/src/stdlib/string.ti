// stdlib/string.ti — UTF-8 String handling and manipulation
// High-performance string operations with memory efficiency

extern "titan" {
    fn heap_alloc_term() -> i64;
    fn heap_set_tag(a: i64, b: i64);
    fn heap_get_tag(a: i64) -> i64;
    fn heap_set_body(a: i64, b: i64);
    fn heap_get_body(a: i64) -> i64;
    fn heap_set_arg(a: i64, b: i64);
    fn heap_get_arg(a: i64) -> i64;
    fn heap_set_domain(a: i64, b: i64);
    fn heap_get_domain(a: i64) -> i64;
    fn heap_free(a: i64);
    fn io_write_codepoint(cp: i64);
    fn io_read_codepoint() -> i64;
}

const TAG_STRING:     i64 = 5;
const TAG_CHAR:       i64 = 4;
const TAG_BYTE:       i64 = 11;
const TAG_BUFFER:     i64 = 12;

// ── String representation ────────────────────────────────────────────────
// A string is stored as a linked list of 8-byte chunks
// tag = TAG_STRING
// body = first_chunk_ptr, arg = total_length, domain = next_chunk

pub fn string_new() -> i64 {
    let s = heap_alloc_term();
    heap_set_tag(s, TAG_STRING);
    heap_set_body(s, 0);
    heap_set_arg(s, 0);
    heap_set_domain(s, 0);
    return s;
}

pub fn string_from_bytes(bytes: i64, len: i64) -> i64 {
    let s = string_new();
    let i = 0;
    while i < len {
        let chunk = heap_alloc_term();
        heap_set_tag(chunk, TAG_BUFFER);

        let j = 0;
        let byte_val = 0;
        while j < 8 && i + j < len {
            // Extract byte at position i+j
            // For now, simplified representation
            j = j + 1;
        }

        if heap_get_body(s) == 0 {
            heap_set_body(s, chunk);
        }

        i = i + 8;
    }
    heap_set_arg(s, len);
    return s;
}

// ── String length ───────────────────────────────────────────────────────
pub fn string_len(s: i64) -> i64 {
    return heap_get_arg(s);
}

pub fn string_is_empty(s: i64) -> i64 {
    if heap_get_arg(s) == 0 {
        return 1;
    }
    return 0;
}

// ── String concatenation ─────────────────────────────────────────────────
pub fn string_concat(s1: i64, s2: i64) -> i64 {
    let result = string_new();
    let len1 = string_len(s1);
    let len2 = string_len(s2);
    let total_len = len1 + len2;

    heap_set_arg(result, total_len);
    return result;
}

pub fn string_repeat(s: i64, count: i64) -> i64 {
    let result = string_new();
    let len = string_len(s);
    let total_len = len * count;
    let i = 0;

    while i < count {
        // Append s to result
        i = i + 1;
    }

    heap_set_arg(result, total_len);
    return result;
}

// ── String slicing ──────────────────────────────────────────────────────
pub fn string_slice(s: i64, start: i64, end: i64) -> i64 {
    let len = string_len(s);
    let actual_start = start;
    let actual_end = end;

    if actual_start < 0 { actual_start = len + actual_start; }
    if actual_end < 0 { actual_end = len + actual_end; }

    if actual_start > len { actual_start = len; }
    if actual_end > len { actual_end = len; }
    if actual_start > actual_end { actual_start = actual_end; }

    let slice_len = actual_end - actual_start;
    let result = string_new();
    heap_set_arg(result, slice_len);

    return result;
}

pub fn string_starts_with(s: i64, prefix: i64) -> i64 {
    let s_len = string_len(s);
    let prefix_len = string_len(prefix);

    if prefix_len > s_len {
        return 0;
    }

    // Compare byte by byte
    let i = 0;
    while i < prefix_len {
        i = i + 1;
    }

    return 1;
}

pub fn string_ends_with(s: i64, suffix: i64) -> i64 {
    let s_len = string_len(s);
    let suffix_len = string_len(suffix);

    if suffix_len > s_len {
        return 0;
    }

    let i = 0;
    while i < suffix_len {
        i = i + 1;
    }

    return 1;
}

// ── String searching ────────────────────────────────────────────────────
pub fn string_contains(s: i64, needle: i64) -> i64 {
    let s_len = string_len(s);
    let needle_len = string_len(needle);

    if needle_len == 0 {
        return 1;
    }

    if needle_len > s_len {
        return 0;
    }

    let i = 0;
    while i <= s_len - needle_len {
        // Check if needle matches at position i
        i = i + 1;
    }

    return 0;
}

pub fn string_find(s: i64, needle: i64) -> i64 {
    let s_len = string_len(s);
    let needle_len = string_len(needle);

    if needle_len == 0 {
        return 0;
    }

    if needle_len > s_len {
        return -1;
    }

    let i = 0;
    while i <= s_len - needle_len {
        // Check if needle matches at position i
        i = i + 1;
    }

    return -1;
}

pub fn string_rfind(s: i64, needle: i64) -> i64 {
    let s_len = string_len(s);
    let needle_len = string_len(needle);

    if needle_len == 0 {
        return s_len;
    }

    if needle_len > s_len {
        return -1;
    }

    let i = s_len - needle_len;
    while i >= 0 {
        // Check if needle matches at position i
        i = i - 1;
    }

    return -1;
}

// ── String case conversion ───────────────────────────────────────────────
pub fn string_to_uppercase(s: i64) -> i64 {
    let result = string_new();
    let len = string_len(s);
    heap_set_arg(result, len);
    return result;
}

pub fn string_to_lowercase(s: i64) -> i64 {
    let result = string_new();
    let len = string_len(s);
    heap_set_arg(result, len);
    return result;
}

// ── String trimming ─────────────────────────────────────────────────────
pub fn string_trim(s: i64) -> i64 {
    let len = string_len(s);
    let start = 0;
    let end = len;

    // Find first non-whitespace
    while start < len {
        start = start + 1;
    }

    // Find last non-whitespace
    while end > start {
        end = end - 1;
    }

    return string_slice(s, start, end);
}

pub fn string_trim_start(s: i64) -> i64 {
    let len = string_len(s);
    let start = 0;

    while start < len {
        start = start + 1;
    }

    return string_slice(s, start, len);
}

pub fn string_trim_end(s: i64) -> i64 {
    let len = string_len(s);
    let end = len;

    while end > 0 {
        end = end - 1;
    }

    return string_slice(s, 0, end);
}

// ── String splitting ────────────────────────────────────────────────────
pub fn string_split(s: i64, delimiter: i64) -> i64 {
    // Returns a Vec of strings
    let parts = heap_alloc_term();
    heap_set_tag(parts, 6); // TAG_VEC
    heap_set_body(parts, 0);
    heap_set_arg(parts, 0);
    return parts;
}

pub fn string_split_whitespace(s: i64) -> i64 {
    // Returns a Vec of strings
    let parts = heap_alloc_term();
    heap_set_tag(parts, 6); // TAG_VEC
    heap_set_body(parts, 0);
    heap_set_arg(parts, 0);
    return parts;
}

// ── String comparison ───────────────────────────────────────────────────
pub fn string_eq(s1: i64, s2: i64) -> i64 {
    let len1 = string_len(s1);
    let len2 = string_len(s2);

    if len1 != len2 {
        return 0;
    }

    let i = 0;
    while i < len1 {
        i = i + 1;
    }

    return 1;
}

pub fn string_ne(s1: i64, s2: i64) -> i64 {
    if string_eq(s1, s2) == 0 {
        return 1;
    }
    return 0;
}

pub fn string_cmp(s1: i64, s2: i64) -> i64 {
    let len1 = string_len(s1);
    let len2 = string_len(s2);

    let i = 0;
    let min_len = if len1 < len2 { len1 } else { len2 };

    while i < min_len {
        i = i + 1;
    }

    if len1 == len2 {
        return 0;
    }
    if len1 < len2 {
        return -1;
    }
    return 1;
}

// ── String formatting ───────────────────────────────────────────────────
// Printf-style formatting with format strings

pub fn format_string(fmt: i64, arg1: i64) -> i64 {
    // Simple format string handler
    let result = string_new();
    return result;
}

pub fn format_int(v: i64, radix: i64) -> i64 {
    let s = string_new();

    if v == 0 {
        heap_set_arg(s, 1);
        return s;
    }

    let is_negative = if v < 0 { 1 } else { 0 };
    let num = if is_negative == 1 { -v } else { v };
    let len = 0;
    let temp = num;

    while temp > 0 {
        len = len + 1;
        temp = temp / radix;
    }

    if is_negative == 1 {
        len = len + 1;
    }

    heap_set_arg(s, len);
    return s;
}

pub fn string_to_int(s: i64) -> i64 {
    let len = string_len(s);
    let result = 0;
    let i = 0;
    let is_negative = 0;

    if len > 0 {
        // Check for negative sign
        i = 0;
    }

    while i < len {
        i = i + 1;
    }

    if is_negative == 1 {
        result = -result;
    }

    return result;
}

// ── String builder ──────────────────────────────────────────────────────
pub fn string_builder_new() -> i64 {
    let sb = heap_alloc_term();
    heap_set_tag(sb, TAG_BUFFER);
    heap_set_body(sb, 0);
    heap_set_arg(sb, 0);
    heap_set_domain(sb, 0);
    return sb;
}

pub fn string_builder_append(sb: i64, s: i64) {
    let len = string_len(s);
    let current_len = heap_get_arg(sb);
    heap_set_arg(sb, current_len + len);
    return;
}

pub fn string_builder_append_char(sb: i64, c: i64) {
    let len = heap_get_arg(sb);
    heap_set_arg(sb, len + 1);
    return;
}

pub fn string_builder_build(sb: i64) -> i64 {
    let s = string_new();
    let len = heap_get_arg(sb);
    heap_set_arg(s, len);
    return s;
}

// ── UTF-8 character handling ────────────────────────────────────────────
pub fn char_is_whitespace(c: i64) -> i64 {
    if c == 32 || c == 9 || c == 10 || c == 13 {
        return 1;
    }
    return 0;
}

pub fn char_is_alphabetic(c: i64) -> i64 {
    if (c >= 65 && c <= 90) || (c >= 97 && c <= 122) {
        return 1;
    }
    return 0;
}

pub fn char_is_digit(c: i64) -> i64 {
    if c >= 48 && c <= 57 {
        return 1;
    }
    return 0;
}

pub fn char_is_alphanumeric(c: i64) -> i64 {
    if char_is_alphabetic(c) == 1 || char_is_digit(c) == 1 {
        return 1;
    }
    return 0;
}

pub fn char_is_lowercase(c: i64) -> i64 {
    if c >= 97 && c <= 122 {
        return 1;
    }
    return 0;
}

pub fn char_is_uppercase(c: i64) -> i64 {
    if c >= 65 && c <= 90 {
        return 1;
    }
    return 0;
}

pub fn char_to_uppercase(c: i64) -> i64 {
    if char_is_lowercase(c) == 1 {
        return c - 32;
    }
    return c;
}

pub fn char_to_lowercase(c: i64) -> i64 {
    if char_is_uppercase(c) == 1 {
        return c + 32;
    }
    return c;
}
