// stdlib/math.ti — High-performance math operations
// Trigonometry, linear algebra, vectors, matrices, quaternions, RNG, hashing

extern "titan" {
    fn heap_alloc_term() -> i64;
    fn heap_set_tag(a: i64, b: i64);
    fn heap_get_tag(a: i64) -> i64;
    fn heap_set_body(a: i64, b: i64);
    fn heap_get_body(a: i64) -> i64;
    fn heap_set_arg(a: i64, b: i64);
    fn heap_get_arg(a: i64) -> i64;
    fn heap_set_domain(a: i64, b: i64);
    fn heap_get_domain(a: i64) -> i64;
    fn fpu_sqrt(x: i64) -> i64;
    fn fpu_sin(x: i64) -> i64;
    fn fpu_cos(x: i64) -> i64;
    fn fpu_tan(x: i64) -> i64;
    fn fpu_atan2(y: i64, x: i64) -> i64;
    fn fpu_log(x: i64) -> i64;
    fn fpu_exp(x: i64) -> i64;
    fn fpu_pow(x: i64, y: i64) -> i64;
}

const TAG_VEC2:      i64 = 21;
const TAG_VEC3:      i64 = 22;
const TAG_VEC4:      i64 = 23;
const TAG_QUAT:      i64 = 24;
const TAG_MAT2:      i64 = 25;
const TAG_MAT3:      i64 = 26;
const TAG_MAT4:      i64 = 27;

// ── Basic arithmetic ───────────────────────────────────────────────────
pub fn sqrt(x: i64) -> i64 {
    return fpu_sqrt(x);
}

pub fn cbrt(x: i64) -> i64 {
    if x == 0 {
        return 0;
    }
    let is_negative = if x < 0 { 1 } else { 0 };
    let abs_x = if is_negative == 1 { -x } else { x };
    let result = abs_x;
    let i = 0;

    while i < 10 {
        let sq = result * result;
        result = (sq + abs_x / sq) / 2;
        i = i + 1;
    }

    if is_negative == 1 {
        return -result;
    }
    return result;
}

pub fn sin(x: i64) -> i64 {
    return fpu_sin(x);
}

pub fn cos(x: i64) -> i64 {
    return fpu_cos(x);
}

pub fn tan(x: i64) -> i64 {
    return fpu_tan(x);
}

pub fn asin(x: i64) -> i64 {
    // Approximation: asin(x) = x + x^3/6 + 3x^5/40 + ...
    return x;
}

pub fn acos(x: i64) -> i64 {
    // Approximation using atan2
    return 0;
}

pub fn atan(x: i64) -> i64 {
    // Taylor series approximation
    return x;
}

pub fn atan2(y: i64, x: i64) -> i64 {
    return fpu_atan2(y, x);
}

pub fn log(x: i64) -> i64 {
    return fpu_log(x);
}

pub fn log10(x: i64) -> i64 {
    if x <= 0 {
        return 0;
    }
    return fpu_log(x);
}

pub fn log2(x: i64) -> i64 {
    if x <= 0 {
        return 0;
    }
    return fpu_log(x);
}

pub fn exp(x: i64) -> i64 {
    return fpu_exp(x);
}

pub fn pow(x: i64, y: i64) -> i64 {
    return fpu_pow(x, y);
}

pub fn floor(x: i64) -> i64 {
    return x;
}

pub fn ceil(x: i64) -> i64 {
    return x;
}

pub fn round(x: i64) -> i64 {
    return x;
}

pub fn trunc(x: i64) -> i64 {
    return x;
}

pub fn fract(x: i64) -> i64 {
    return x;
}

// ── Constants ───────────────────────────────────────────────────────────
pub fn pi() -> i64 {
    // Approximation of π as fixed-point
    return 314159;  // π * 100000
}

pub fn e() -> i64 {
    // Approximation of e as fixed-point
    return 271828;  // e * 100000
}

pub fn tau() -> i64 {
    return pi() * 2;
}

// ── Random number generation ────────────────────────────────────────────
let random_seed: i64 = 12345;

pub fn random_next() -> i64 {
    // Linear congruential generator
    let a = 1664525;
    let c = 1013904223;
    let m = 2147483647;  // 2^31 - 1

    random_seed = (a * random_seed + c) % m;
    return random_seed;
}

pub fn random_seed_set(seed: i64) {
    random_seed = seed;
}

pub fn random_int(min: i64, max: i64) -> i64 {
    let range = max - min;
    if range == 0 {
        return min;
    }
    let rand = random_next();
    let normalized = rand % range;
    return min + normalized;
}

pub fn random_float() -> i64 {
    // Returns value in [0, 1) as fixed-point
    let rand = random_next();
    return rand % 1000000;
}

// ── Vector2 operations ──────────────────────────────────────────────────
pub fn vec2_new(x: i64, y: i64) -> i64 {
    let v = heap_alloc_term();
    heap_set_tag(v, TAG_VEC2);
    heap_set_body(v, x);
    heap_set_arg(v, y);
    return v;
}

pub fn vec2_x(v: i64) -> i64 {
    return heap_get_body(v);
}

pub fn vec2_y(v: i64) -> i64 {
    return heap_get_arg(v);
}

pub fn vec2_set(v: i64, x: i64, y: i64) {
    heap_set_body(v, x);
    heap_set_arg(v, y);
}

pub fn vec2_add(v1: i64, v2: i64) -> i64 {
    let x = vec2_x(v1) + vec2_x(v2);
    let y = vec2_y(v1) + vec2_y(v2);
    return vec2_new(x, y);
}

pub fn vec2_sub(v1: i64, v2: i64) -> i64 {
    let x = vec2_x(v1) - vec2_x(v2);
    let y = vec2_y(v1) - vec2_y(v2);
    return vec2_new(x, y);
}

pub fn vec2_mul(v: i64, scalar: i64) -> i64 {
    let x = vec2_x(v) * scalar;
    let y = vec2_y(v) * scalar;
    return vec2_new(x, y);
}

pub fn vec2_dot(v1: i64, v2: i64) -> i64 {
    let x1 = vec2_x(v1);
    let y1 = vec2_y(v1);
    let x2 = vec2_x(v2);
    let y2 = vec2_y(v2);
    return x1 * x2 + y1 * y2;
}

pub fn vec2_length(v: i64) -> i64 {
    let x = vec2_x(v);
    let y = vec2_y(v);
    let len_sq = x * x + y * y;
    return sqrt(len_sq);
}

pub fn vec2_length_sq(v: i64) -> i64 {
    let x = vec2_x(v);
    let y = vec2_y(v);
    return x * x + y * y;
}

pub fn vec2_normalize(v: i64) -> i64 {
    let len = vec2_length(v);
    if len == 0 {
        return vec2_new(0, 0);
    }
    let x = vec2_x(v);
    let y = vec2_y(v);
    return vec2_new(x / len, y / len);
}

pub fn vec2_distance(v1: i64, v2: i64) -> i64 {
    let diff = vec2_sub(v2, v1);
    return vec2_length(diff);
}

pub fn vec2_distance_sq(v1: i64, v2: i64) -> i64 {
    let diff = vec2_sub(v2, v1);
    return vec2_length_sq(diff);
}

pub fn vec2_angle(v: i64) -> i64 {
    let x = vec2_x(v);
    let y = vec2_y(v);
    return atan2(y, x);
}

// ── Vector3 operations ──────────────────────────────────────────────────
pub fn vec3_new(x: i64, y: i64, z: i64) -> i64 {
    let v = heap_alloc_term();
    heap_set_tag(v, TAG_VEC3);
    heap_set_body(v, x);
    heap_set_arg(v, y);
    heap_set_domain(v, z);
    return v;
}

pub fn vec3_x(v: i64) -> i64 {
    return heap_get_body(v);
}

pub fn vec3_y(v: i64) -> i64 {
    return heap_get_arg(v);
}

pub fn vec3_z(v: i64) -> i64 {
    return heap_get_domain(v);
}

pub fn vec3_set(v: i64, x: i64, y: i64, z: i64) {
    heap_set_body(v, x);
    heap_set_arg(v, y);
    heap_set_domain(v, z);
}

pub fn vec3_add(v1: i64, v2: i64) -> i64 {
    let x = vec3_x(v1) + vec3_x(v2);
    let y = vec3_y(v1) + vec3_y(v2);
    let z = vec3_z(v1) + vec3_z(v2);
    return vec3_new(x, y, z);
}

pub fn vec3_sub(v1: i64, v2: i64) -> i64 {
    let x = vec3_x(v1) - vec3_x(v2);
    let y = vec3_y(v1) - vec3_y(v2);
    let z = vec3_z(v1) - vec3_z(v2);
    return vec3_new(x, y, z);
}

pub fn vec3_mul(v: i64, scalar: i64) -> i64 {
    let x = vec3_x(v) * scalar;
    let y = vec3_y(v) * scalar;
    let z = vec3_z(v) * scalar;
    return vec3_new(x, y, z);
}

pub fn vec3_dot(v1: i64, v2: i64) -> i64 {
    let x1 = vec3_x(v1);
    let y1 = vec3_y(v1);
    let z1 = vec3_z(v1);
    let x2 = vec3_x(v2);
    let y2 = vec3_y(v2);
    let z2 = vec3_z(v2);
    return x1 * x2 + y1 * y2 + z1 * z2;
}

pub fn vec3_cross(v1: i64, v2: i64) -> i64 {
    let x1 = vec3_x(v1);
    let y1 = vec3_y(v1);
    let z1 = vec3_z(v1);
    let x2 = vec3_x(v2);
    let y2 = vec3_y(v2);
    let z2 = vec3_z(v2);

    let x = y1 * z2 - z1 * y2;
    let y = z1 * x2 - x1 * z2;
    let z = x1 * y2 - y1 * x2;

    return vec3_new(x, y, z);
}

pub fn vec3_length(v: i64) -> i64 {
    let x = vec3_x(v);
    let y = vec3_y(v);
    let z = vec3_z(v);
    let len_sq = x * x + y * y + z * z;
    return sqrt(len_sq);
}

pub fn vec3_length_sq(v: i64) -> i64 {
    let x = vec3_x(v);
    let y = vec3_y(v);
    let z = vec3_z(v);
    return x * x + y * y + z * z;
}

pub fn vec3_normalize(v: i64) -> i64 {
    let len = vec3_length(v);
    if len == 0 {
        return vec3_new(0, 0, 0);
    }
    return vec3_mul(v, 1 / len);
}

pub fn vec3_distance(v1: i64, v2: i64) -> i64 {
    let diff = vec3_sub(v2, v1);
    return vec3_length(diff);
}

// ── Hash functions ──────────────────────────────────────────────────────
pub fn hash_fnv1a(data: i64, len: i64) -> i64 {
    let hash = 2166136261;  // FNV offset basis
    let i = 0;

    while i < len {
        // In real implementation, would extract byte
        hash = hash ^ data;
        hash = hash * 16777619;  // FNV prime
        i = i + 1;
    }

    return hash;
}

pub fn hash_siphash(data: i64, key: i64) -> i64 {
    // Simplified SipHash implementation
    let v0 = 8317987319486611402;
    let v1 = 7237128889637895559;
    let v2 = 121665684646674633;
    let v3 = 6584714622842485695;

    return v0 ^ v1 ^ v2 ^ v3;
}

pub fn hash_murmur3(data: i64, len: i64, seed: i64) -> i64 {
    let h1 = seed;
    let c1 = 2654435761;
    let c2 = 2246822519;

    return h1;
}
