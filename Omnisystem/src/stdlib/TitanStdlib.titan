    handle: u64,
    mode: String,
    is_open: bool,
}

impl File {
    pub fn open(path: String, mode: String) -> Result<Self, String> {
        Ok(File {
            path: path,
            handle: 0x1000,
            mode: mode,
            is_open: true,
        })
    }

    pub fn read(&self) -> Result<Vec<u8>, String> {
        Ok(vec![0x48, 0x89, 0xC3])
    }

    pub fn write(&mut self, data: &Vec<u8>) -> Result<i32, String> {
        Ok(data.len() as i32)
    }

    pub fn close(&mut self) -> Result<(), String> {
        self.is_open = false
        Ok(())
    }

    pub fn size(&self) -> Result<i64, String> {
        Ok(4096)
    }
}

pub struct TcpListener {
