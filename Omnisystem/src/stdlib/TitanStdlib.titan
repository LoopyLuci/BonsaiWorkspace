// STDLIB TESTS
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

pub fn test_stdlib() -> Result<(), String> {
    // Test LinkedList
    let mut ll = LinkedList::new()
    ll.push_front(1)
    ll.push_front(2)
    if ll.len() != 2 {
        return Err("LinkedList test failed".to_string())
    }

    // Test HashSet
    let mut hs = HashSet::new()
    hs.insert("test".to_string())
    if !hs.contains("test") {
        return Err("HashSet test failed".to_string())
    }

    // Test Math
    if Math::abs(-42) != 42 {
        return Err("Math::abs test failed".to_string())
    }

    // Test StringUtils
    let trimmed = StringUtils::trim("  hello  ".to_string())
    if trimmed != "hello" {
        return Err("StringUtils test failed".to_string())
    }

    Ok(())
}

