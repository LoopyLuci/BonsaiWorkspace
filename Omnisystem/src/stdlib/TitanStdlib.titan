use omnisystem::{Vec, HashMap, Option, Result, String, Arc, Mutex, i32, i64, f32, f64, bool, u8, u32, u64}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// PART 1: COLLECTIONS - Vec, HashMap, LinkedList, Deque, HashSet
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

pub struct LinkedList<T> {
    head: Option<Box<LinkedListNode<T>>>,
    len: i32,
}

pub struct LinkedListNode<T> {
    value: T,
    next: Option<Box<LinkedListNode<T>>>,
}

impl LinkedList<i32> {
    pub fn new() -> Self {
        LinkedList {
            head: None,
            len: 0,
        }
    }

    pub fn push_front(&mut self, value: i32) {
        let new_node = Box::new(LinkedListNode {
            value: value,
            next: self.head.take(),
        })
        self.head = Some(new_node)
        self.len += 1
    }

    pub fn pop_front(&mut self) -> Option<i32> {
        match self.head.take() {
            None => None,
            Some(node) => {
                self.head = node.next
                self.len -= 1
                Some(node.value)
            }
        }
    }

    pub fn len(&self) -> i32 {
        self.len
    }

    pub fn is_empty(&self) -> bool {
        self.len == 0
    }
}

pub struct Deque<T> {
    front: Vec<T>,
    back: Vec<T>,
}

impl Deque<i32> {
    pub fn new() -> Self {
        Deque {
            front: Vec::new(),
            back: Vec::new(),
        }
    }

    pub fn push_front(&mut self, value: i32) {
        self.front.push(value)
    }

    pub fn push_back(&mut self, value: i32) {
        self.back.push(value)
    }

    pub fn pop_front(&mut self) -> Option<i32> {
        if !self.front.is_empty() {
            Some(self.front.pop().unwrap())
        } else if !self.back.is_empty() {
            Some(self.back.remove(0))
        } else {
            None
        }
    }

    pub fn pop_back(&mut self) -> Option<i32> {
        if !self.back.is_empty() {
            Some(self.back.pop().unwrap())
        } else if !self.front.is_empty() {
            Some(self.front.remove(0))
        } else {
            None
        }
    }

    pub fn len(&self) -> i32 {
        (self.front.len() + self.back.len()) as i32
    }
}

pub struct HashSet {
    items: HashMap<String, bool>,
}

impl HashSet {
    pub fn new() -> Self {
        HashSet {
            items: HashMap::new(),
        }
    }

    pub fn insert(&mut self, item: String) -> bool {
        !self.items.insert(item, true).is_some()
    }

    pub fn contains(&self, item: &str) -> bool {
        self.items.contains_key(item)
    }

    pub fn remove(&mut self, item: &str) -> bool {
        self.items.remove(item).is_some()
    }

    pub fn len(&self) -> i32 {
        self.items.len() as i32
    }

    pub fn is_empty(&self) -> bool {
        self.items.is_empty()
    }

    pub fn clear(&mut self) {
        self.items.clear()
    }
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// PART 2: ALGORITHMS - Sorting, Searching, Graph Traversal
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

pub struct Sorting;

impl Sorting {
    pub fn quicksort(arr: &mut Vec<i32>, low: i32, high: i32) {
        if low < high {
            let pi = Self::partition(arr, low, high)
            Self::quicksort(arr, low, pi - 1)
            Self::quicksort(arr, pi + 1, high)
        }
    }

    pub fn partition(arr: &mut Vec<i32>, low: i32, high: i32) -> i32 {
        let pivot = arr[high as usize]
        let mut i = low - 1

        for j in low..high {
            if arr[j as usize] < pivot {
                i += 1
                let temp = arr[i as usize]
                arr[i as usize] = arr[j as usize]
                arr[j as usize] = temp
            }
        }

        let temp = arr[(i + 1) as usize]
        arr[(i + 1) as usize] = arr[high as usize]
        arr[high as usize] = temp

        i + 1
    }

    pub fn mergesort(arr: &mut Vec<i32>, left: i32, right: i32) {
        if left < right {
            let mid = (left + right) / 2
            Self::mergesort(arr, left, mid)
            Self::mergesort(arr, mid + 1, right)
            Self::merge(arr, left, mid, right)
        }
    }

    pub fn merge(arr: &mut Vec<i32>, left: i32, mid: i32, right: i32) {
        let left_size = (mid - left + 1) as usize
        let right_size = (right - mid) as usize

        let mut left_arr = Vec::new()
        let mut right_arr = Vec::new()

        for i in 0..left_size {
            left_arr.push(arr[(left as usize) + i])
        }

        for i in 0..right_size {
            right_arr.push(arr[((mid + 1) as usize) + i])
        }

        let mut i = 0
        let mut j = 0
        let mut k = left as usize

        while i < left_size && j < right_size {
            if left_arr[i] <= right_arr[j] {
                arr[k] = left_arr[i]
                i += 1
            } else {
                arr[k] = right_arr[j]
                j += 1
            }
            k += 1
        }

        while i < left_size {
            arr[k] = left_arr[i]
            i += 1
            k += 1
        }

        while j < right_size {
            arr[k] = right_arr[j]
            j += 1
            k += 1
        }
    }
}

pub struct Searching;

impl Searching {
    pub fn binary_search(arr: &Vec<i32>, target: i32) -> Option<i32> {
        let mut low = 0
        let mut high = (arr.len() as i32) - 1

        while low <= high {
            let mid = (low + high) / 2
            let mid_val = arr[mid as usize]

            if mid_val == target {
                return Some(mid)
            } else if mid_val < target {
                low = mid + 1
            } else {
                high = mid - 1
            }
        }

        None
    }

    pub fn linear_search(arr: &Vec<i32>, target: i32) -> Option<i32> {
        for (i, &val) in arr.iter().enumerate() {
            if val == target {
                return Some(i as i32)
            }
        }
        None
    }
}

