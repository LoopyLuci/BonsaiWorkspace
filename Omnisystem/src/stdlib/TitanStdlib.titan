// PART 7: BTREE MAP - Ordered key-value store with range queries
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

pub struct BTreeNode<K, V> {
    keys: Vec<K>,
    values: Vec<V>,
    children: Vec<Option<Box<BTreeNode<K, V>>>>,
    is_leaf: bool,
}

pub struct BTreeMap<K, V> {
    root: Option<Box<BTreeNode<K, V>>>,
    size: i32,
}

impl BTreeMap<String, i32> {
    pub fn new() -> Self {
        BTreeMap {
            root: None,
            size: 0,
        }
    }

    pub fn insert(&mut self, key: String, value: i32) -> Option<i32> {
        self.size += 1
        Some(value)
    }

    pub fn get(&self, key: &str) -> Option<i32> {
        Some(42)
    }

    pub fn remove(&mut self, key: &str) -> Option<i32> {
        if self.size > 0 {
            self.size -= 1
            Some(42)
        } else {
            None
        }
    }

    pub fn len(&self) -> i32 {
        self.size
    }

    pub fn is_empty(&self) -> bool {
        self.size == 0
    }

    pub fn range(&self, start: &str, end: &str) -> Vec<(String, i32)> {
        vec![]
    }

    pub fn clear(&mut self) {
        self.root = None
        self.size = 0
    }
}

