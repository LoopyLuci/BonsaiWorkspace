// PART 8: PATH & DIRECTORY OPERATIONS
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

pub struct Path {
    path_str: String,
}

impl Path {
    pub fn new(path: String) -> Self {
        Path { path_str: path }
    }

    pub fn parent(&self) -> Option<Path> {
        let parts: Vec<&str> = self.path_str.split('/').collect()
        if parts.len() > 1 {
            let parent_path = parts[0..parts.len()-1].join("/")
            Some(Path::new(parent_path))
        } else {
            None
        }
    }

    pub fn file_name(&self) -> Option<String> {
        let parts: Vec<&str> = self.path_str.split('/').collect()
        if let Some(&last) = parts.last() {
            Some(last.to_string())
        } else {
            None
        }
    }

    pub fn extension(&self) -> Option<String> {
        if let Some(file_name_str) = self.file_name() {
            let parts: Vec<&str> = file_name_str.split('.').collect()
            if parts.len() > 1 {
                Some(parts.last().unwrap().to_string())
            } else {
                None
            }
        } else {
            None
        }
    }

    pub fn join(&self, path: String) -> Path {
        let joined = format!("{}/{}", self.path_str, path)
        Path::new(joined)
    }

    pub fn as_str(&self) -> &str {
        &self.path_str
    }
}

pub struct Directory {
