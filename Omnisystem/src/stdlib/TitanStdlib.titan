        Ok(TcpStream {
            remote_addr: address,
            connected: true,
        })
    }

    pub fn read(&self) -> Result<Vec<u8>, String> {
        Ok(vec![])
    }

    pub fn write(&mut self, data: &Vec<u8>) -> Result<i32, String> {
        Ok(data.len() as i32)
