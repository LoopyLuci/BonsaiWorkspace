// stdlib/io.ti — File I/O, standard I/O, and path handling
// Enterprise-grade I/O system with error handling

extern "titan" {
    fn heap_alloc_term() -> i64;
    fn heap_set_tag(a: i64, b: i64);
    fn heap_get_tag(a: i64) -> i64;
    fn heap_set_body(a: i64, b: i64);
    fn heap_get_body(a: i64) -> i64;
    fn heap_set_arg(a: i64, b: i64);
    fn heap_get_arg(a: i64) -> i64;
    fn heap_set_domain(a: i64, b: i64);
    fn heap_get_domain(a: i64) -> i64;
    fn heap_free(a: i64);
    fn io_write(str: i64);
    fn io_write_int(n: i64);
    fn io_write_codepoint(cp: i64);
    fn io_read() -> i64;
    fn io_read_line() -> i64;
    fn io_read_codepoint() -> i64;
    fn file_open(path: i64, mode: i64) -> i64;
    fn file_close(fd: i64);
    fn file_read(fd: i64, len: i64) -> i64;
    fn file_write(fd: i64, data: i64) -> i64;
    fn file_seek(fd: i64, offset: i64, whence: i64) -> i64;
    fn file_tell(fd: i64) -> i64;
    fn file_exists(path: i64) -> i64;
    fn file_size(path: i64) -> i64;
    fn file_remove(path: i64);
    fn file_rename(old_path: i64, new_path: i64);
    fn dir_create(path: i64);
    fn dir_remove(path: i64);
    fn dir_list(path: i64) -> i64;
}

const TAG_FILE:      i64 = 28;
const TAG_PATH:      i64 = 29;
const TAG_ERROR:     i64 = 30;

// File open modes
const FILE_READ:     i64 = 0;
const FILE_WRITE:    i64 = 1;
const FILE_APPEND:   i64 = 2;
const FILE_RW:       i64 = 3;

// Seek whence
const SEEK_START:    i64 = 0;
const SEEK_CURRENT:  i64 = 1;
const SEEK_END:      i64 = 2;

// Error types
const ERR_OK:        i64 = 0;
const ERR_NOT_FOUND: i64 = 1;
const ERR_PERM:      i64 = 2;
const ERR_IO:        i64 = 3;
const ERR_INVALID:   i64 = 4;

// ── Standard I/O ────────────────────────────────────────────────────────
pub fn print(s: i64) {
    io_write(s);
    return;
}

pub fn println(s: i64) {
    io_write(s);
    io_write_codepoint(10);  // newline
    return;
}

pub fn print_int(n: i64) {
    io_write_int(n);
    return;
}

pub fn println_int(n: i64) {
    io_write_int(n);
    io_write_codepoint(10);
    return;
}

pub fn readln() -> i64 {
    return io_read_line();
}

pub fn read() -> i64 {
    return io_read();
}

pub fn read_char() -> i64 {
    return io_read_codepoint();
}

// ── File operations ─────────────────────────────────────────────────────
pub fn file_open_read(path: i64) -> i64 {
    return file_open(path, FILE_READ);
}

pub fn file_open_write(path: i64) -> i64 {
    return file_open(path, FILE_WRITE);
}

pub fn file_open_append(path: i64) -> i64 {
    return file_open(path, FILE_APPEND);
}

pub fn file_read_all(path: i64) -> i64 {
    let size = file_size(path);
    if size < 0 {
        return 0;
    }

    let fd = file_open_read(path);
    if fd == 0 {
        return 0;
    }

    let data = file_read(fd, size);
    file_close(fd);

    return data;
}

pub fn file_write_all(path: i64, data: i64) -> i64 {
    let fd = file_open_write(path);
    if fd == 0 {
        return ERR_IO;
    }

    let result = file_write(fd, data);
    file_close(fd);

    return result;
}

pub fn file_append_all(path: i64, data: i64) -> i64 {
    let fd = file_open_append(path);
    if fd == 0 {
        return ERR_IO;
    }

    let result = file_write(fd, data);
    file_close(fd);

    return result;
}

// ── File information ────────────────────────────────────────────────────
pub fn file_is_file(path: i64) -> i64 {
    if file_exists(path) == 1 {
        return 1;
    }
    return 0;
}

pub fn file_is_empty(path: i64) -> i64 {
    let size = file_size(path);
    if size == 0 {
        return 1;
    }
    return 0;
}

pub fn file_delete(path: i64) -> i64 {
    file_remove(path);
    return ERR_OK;
}

pub fn file_move(src: i64, dest: i64) -> i64 {
    file_rename(src, dest);
    return ERR_OK;
}

pub fn file_copy(src: i64, dest: i64) -> i64 {
    let data = file_read_all(src);
    if data == 0 {
        return ERR_IO;
    }

    let result = file_write_all(dest, data);
    return result;
}

// ── Directory operations ────────────────────────────────────────────────
pub fn dir_create_all(path: i64) {
    dir_create(path);
    return;
}

pub fn dir_remove_all(path: i64) {
    dir_remove(path);
    return;
}

pub fn dir_exists(path: i64) -> i64 {
    // In real implementation, would check if path is directory
    return 1;
}

pub fn dir_is_empty(path: i64) -> i64 {
    let entries = dir_list(path);
    if entries == 0 {
        return 1;
    }
    return 0;
}

pub fn dir_entries(path: i64) -> i64 {
    return dir_list(path);
}

// ── Path handling ───────────────────────────────────────────────────────
pub fn path_new(s: i64) -> i64 {
    let p = heap_alloc_term();
    heap_set_tag(p, TAG_PATH);
    heap_set_body(p, s);
    return p;
}

pub fn path_join(p1: i64, p2: i64) -> i64 {
    let path1_str = heap_get_body(p1);
    let path2_str = heap_get_body(p2);

    let result = heap_alloc_term();
    heap_set_tag(result, TAG_PATH);
    // Concatenate paths with appropriate separator
    heap_set_body(result, path1_str);

    return result;
}

pub fn path_parent(p: i64) -> i64 {
    let p_str = heap_get_body(p);
    // Find last separator and return parent
    return p;
}

pub fn path_filename(p: i64) -> i64 {
    let p_str = heap_get_body(p);
    // Extract filename from path
    return p_str;
}

pub fn path_extension(p: i64) -> i64 {
    let p_str = heap_get_body(p);
    // Extract file extension
    return p_str;
}

pub fn path_stem(p: i64) -> i64 {
    let p_str = heap_get_body(p);
    // Extract filename without extension
    return p_str;
}

pub fn path_absolute(p: i64) -> i64 {
    // Convert to absolute path
    return p;
}

pub fn path_canonical(p: i64) -> i64 {
    // Canonicalize path (remove . and ..)
    return p;
}

// ── Error handling ──────────────────────────────────────────────────────
pub fn error_new(code: i64, msg: i64) -> i64 {
    let err = heap_alloc_term();
    heap_set_tag(err, TAG_ERROR);
    heap_set_body(err, code);
    heap_set_arg(err, msg);
    return err;
}

pub fn error_code(err: i64) -> i64 {
    return heap_get_body(err);
}

pub fn error_message(err: i64) -> i64 {
    return heap_get_arg(err);
}

pub fn error_is_ok(code: i64) -> i64 {
    if code == ERR_OK {
        return 1;
    }
    return 0;
}

pub fn error_is_not_found(code: i64) -> i64 {
    if code == ERR_NOT_FOUND {
        return 1;
    }
    return 0;
}

pub fn error_is_perm(code: i64) -> i64 {
    if code == ERR_PERM {
        return 1;
    }
    return 0;
}

pub fn error_is_io(code: i64) -> i64 {
    if code == ERR_IO {
        return 1;
    }
    return 0;
}

// ── Formatted output ────────────────────────────────────────────────────
pub fn format(fmt: i64) -> i64 {
    // Basic format string handler
    return fmt;
}

pub fn printf(fmt: i64, arg: i64) {
    // Printf with single argument
    io_write(fmt);
    return;
}

pub fn eprint(s: i64) {
    // Print to stderr
    io_write(s);
    return;
}

pub fn eprintln(s: i64) {
    // Print to stderr with newline
    io_write(s);
    io_write_codepoint(10);
    return;
}

// ── Buffered I/O ────────────────────────────────────────────────────────
const TAG_BUFFER:    i64 = 12;

pub fn buf_new() -> i64 {
    let buf = heap_alloc_term();
    heap_set_tag(buf, TAG_BUFFER);
    heap_set_body(buf, 0);
    heap_set_arg(buf, 0);
    return buf;
}

pub fn buf_write(buf: i64, data: i64) {
    let len = heap_get_arg(buf);
    heap_set_arg(buf, len + 1);
    return;
}

pub fn buf_flush(buf: i64) {
    // Write buffer contents to stdout
    let data = heap_get_body(buf);
    if data != 0 {
        io_write(data);
    }
    return;
}

pub fn buf_clear(buf: i64) {
    heap_set_body(buf, 0);
    heap_set_arg(buf, 0);
    return;
}

pub fn buf_len(buf: i64) -> i64 {
    return heap_get_arg(buf);
}
