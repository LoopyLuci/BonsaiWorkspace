import VeraUIStdlib::{ Component, Props, State, Event, RenderTree, Node, Style }
import TitanStdlib::{ Vec, HashMap, Option, String, i32, f32, bool }

// ── Design Token System ───────────────────────────────────────────────────────

struct OwTokens {
  bg:           String,
  bg_card:      String,
  bg_raise:     String,
  glass:        String,
  accent:       String,
  accent_dim:   String,
  accent_glow:  String,
  success:      String,
  warning:      String,
  danger:       String,
  purple:       String,
  text:         String,
  text_dim:     String,
  text_muted:   String,
  border:       String,
  border_focus: String,
  shadow:       String,
  shadow_glow:  String,
}

enum OmniTheme {
  OmniDark,
  OmniLight,
  OmniNeon,
  OmniForest,
  OmniAurora,
  OmniSunset,
}

fn theme_tokens(theme: OmniTheme) -> OwTokens {
  match theme {
    OmniTheme::OmniDark => OwTokens {
      bg: "#050D1A", bg_card: "rgba(10,20,42,0.86)", bg_raise: "rgba(0,20,50,0.52)",
      glass: "rgba(8,18,36,0.72)", accent: "#00D4FF", accent_dim: "rgba(0,212,255,0.13)",
      accent_glow: "rgba(0,212,255,0.24)", success: "#00FF88", warning: "#FFB800",
      danger: "#FF4466", purple: "#BF88FF", text: "#E8F4FF",
      text_dim: "rgba(232,244,255,0.52)", text_muted: "rgba(232,244,255,0.28)",
      border: "rgba(0,212,255,0.18)", border_focus: "rgba(0,212,255,0.62)",
      shadow: "0 3px 16px rgba(0,212,255,0.08)", shadow_glow: "0 0 22px rgba(0,212,255,0.28)",
    },
    OmniTheme::OmniLight => OwTokens {
      bg: "#EEF2FF", bg_card: "rgba(255,255,255,0.92)", bg_raise: "rgba(220,230,255,0.62)",
      glass: "rgba(240,245,255,0.80)", accent: "#1A6CF0", accent_dim: "rgba(26,108,240,0.12)",
      accent_glow: "rgba(26,108,240,0.22)", success: "#0DA84E", warning: "#D07A00",
      danger: "#D62B4A", purple: "#7C3AED", text: "#0A1230",
      text_dim: "rgba(10,18,48,0.55)", text_muted: "rgba(10,18,48,0.32)",
      border: "rgba(26,108,240,0.22)", border_focus: "rgba(26,108,240,0.72)",
      shadow: "0 3px 16px rgba(0,0,80,0.08)", shadow_glow: "0 0 22px rgba(26,108,240,0.22)",
    },
    OmniTheme::OmniNeon => OwTokens {
      bg: "#000000", bg_card: "rgba(0,18,4,0.90)", bg_raise: "rgba(0,30,8,0.64)",
      glass: "rgba(0,12,2,0.82)", accent: "#00FF41", accent_dim: "rgba(0,255,65,0.12)",
      accent_glow: "rgba(0,255,65,0.28)", success: "#00FF41", warning: "#FFFF00",
      danger: "#FF003C", purple: "#BF00FF", text: "#CCFFDD",
      text_dim: "rgba(200,255,220,0.52)", text_muted: "rgba(200,255,220,0.28)",
      border: "rgba(0,255,65,0.22)", border_focus: "rgba(0,255,65,0.72)",
      shadow: "0 3px 16px rgba(0,255,65,0.06)", shadow_glow: "0 0 22px rgba(0,255,65,0.32)",
    },
    OmniTheme::OmniForest => OwTokens {
      bg: "#050F07", bg_card: "rgba(8,22,10,0.88)", bg_raise: "rgba(12,32,15,0.58)",
      glass: "rgba(6,16,8,0.76)", accent: "#3CFF7E", accent_dim: "rgba(60,255,126,0.12)",
      accent_glow: "rgba(60,255,126,0.24)", success: "#7EFF58", warning: "#AAFF00",
      danger: "#FF4D4D", purple: "#99AAFF", text: "#DDFAE6",
      text_dim: "rgba(220,250,230,0.52)", text_muted: "rgba(220,250,230,0.28)",
      border: "rgba(60,255,126,0.18)", border_focus: "rgba(60,255,126,0.62)",
      shadow: "0 3px 16px rgba(60,255,126,0.06)", shadow_glow: "0 0 22px rgba(60,255,126,0.26)",
    },
    OmniTheme::OmniAurora => OwTokens {
      bg: "#0B071E", bg_card: "rgba(18,12,38,0.88)", bg_raise: "rgba(28,16,52,0.54)",
      glass: "rgba(14,10,28,0.76)", accent: "#C07AFF", accent_dim: "rgba(192,122,255,0.13)",
      accent_glow: "rgba(192,122,255,0.26)", success: "#4AFFC8", warning: "#FFD060",
      danger: "#FF4488", purple: "#C07AFF", text: "#F0EAFF",
      text_dim: "rgba(240,234,255,0.52)", text_muted: "rgba(240,234,255,0.28)",
      border: "rgba(192,122,255,0.18)", border_focus: "rgba(192,122,255,0.62)",
      shadow: "0 3px 16px rgba(192,122,255,0.08)", shadow_glow: "0 0 22px rgba(192,122,255,0.30)",
    },
    OmniTheme::OmniSunset => OwTokens {
      bg: "#160700", bg_card: "rgba(30,12,0,0.88)", bg_raise: "rgba(44,16,0,0.54)",
      glass: "rgba(22,8,0,0.76)", accent: "#FF8C00", accent_dim: "rgba(255,140,0,0.13)",
      accent_glow: "rgba(255,140,0,0.26)", success: "#AAFF44", warning: "#FFD700",
      danger: "#FF2244", purple: "#FF88CC", text: "#FFF0E0",
      text_dim: "rgba(255,240,224,0.52)", text_muted: "rgba(255,240,224,0.28)",
      border: "rgba(255,140,0,0.18)", border_focus: "rgba(255,140,0,0.62)",
      shadow: "0 3px 16px rgba(255,140,0,0.08)", shadow_glow: "0 0 22px rgba(255,140,0,0.28)",
    },
  }
}

// ── Button Component ──────────────────────────────────────────────────────────

enum BtnVariant {
  Primary, Solid, Ghost, Link, Danger, Success, Warning, Purple, Icon,
}

enum BtnSize {
  Xxs, Xs, Sm, Md, Lg, Xl,
}

struct BtnProps {
  label:    String,
  icon:     Option<String>,
  variant:  BtnVariant,
  size:     BtnSize,
  disabled: bool,
}

component OmniButton {
  props: BtnProps,
  state: { hovered: bool, pressed: bool },

  fn variant_class(v: BtnVariant) -> String {
    match v {
      BtnVariant::Primary => "ow-btn-primary",
      BtnVariant::Solid   => "ow-btn-solid",
      BtnVariant::Ghost   => "ow-btn-ghost",
      BtnVariant::Link    => "ow-btn-link",
      BtnVariant::Danger  => "ow-btn-danger",
      BtnVariant::Success => "ow-btn-success",
      BtnVariant::Warning => "ow-btn-warning",
      BtnVariant::Purple  => "ow-btn-purple",
      BtnVariant::Icon    => "ow-btn-icon",
    }
  }

  fn size_class(s: BtnSize) -> String {
    match s {
      BtnSize::Xxs => "ow-btn-2xs",
      BtnSize::Xs  => "ow-btn-xs",
      BtnSize::Sm  => "ow-btn-sm",
      BtnSize::Md  => "",
      BtnSize::Lg  => "ow-btn-lg",
      BtnSize::Xl  => "ow-btn-xl",
    }
  }

  render {
    let vcls = Self::variant_class(props.variant)
    let scls = Self::size_class(props.size)
    let cls  = format!("ow-btn {} {}", vcls, scls)
    node("button", [attr("class", cls), attr("disabled", props.disabled.to_string())]) {
      if let Some(icon) = props.icon {
        node("span", [attr("class", "ow-btn-icon-glyph")]) { text(icon) }
      }
      node("span", [attr("class", "ow-btn-label")]) { text(props.label) }
    }
  }
}

// ── Card Components ───────────────────────────────────────────────────────────

enum CardVariant { Basic, Glass, Flat, Glow }

struct CardProps {
  title:       Option<String>,
  subtitle:    Option<String>,
  icon:        Option<String>,
  body_html:   Option<String>,
  variant:     CardVariant,
  interactive: bool,
}

component OmniCard {
  props: CardProps,

  fn variant_class(v: CardVariant) -> String {
    match v {
      CardVariant::Basic => "ow-card",
      CardVariant::Glass => "ow-card ow-card-glass",
      CardVariant::Flat  => "ow-card ow-card-flat",
      CardVariant::Glow  => "ow-card ow-card-glow",
    }
  }

  render {
    let mut cls = Self::variant_class(props.variant)
    if props.interactive { cls = format!("{} ow-card-interactive", cls) }
    node("div", [attr("class", cls)]) {
      if props.title.is_some() || props.icon.is_some() {
        node("div", [attr("class", "ow-card-hd")]) {
          if let Some(icon) = props.icon {
            node("span", [attr("class", "ow-card-icon")]) { text(icon) }
          }
          if let Some(title) = props.title {
            node("div", [attr("class", "ow-card-hd-title")]) { text(title) }
          }
          if let Some(sub) = props.subtitle {
            node("div", [attr("class", "ow-card-hd-sub")]) { text(sub) }
          }
        }
      }
      if let Some(body) = props.body_html {
        node("div", [attr("class", "ow-card-body")]) { html(body) }
      }
    }
  }
}

// ── Stat Card ─────────────────────────────────────────────────────────────────

struct StatCardProps {
  value: String,
  label: Option<String>,
  delta: Option<f32>,
  bar:   Option<f32>,
  color: Option<String>,
}

component OmniStatCard {
  props: StatCardProps,

  render {
    let mut style = String::new()
    if let Some(c) = props.color { style = format!("--ow-accent:{}", c) }
    node("div", [attr("class", "ow-stat"), attr("style", style)]) {
      node("div", [attr("class", "ow-stat-val")]) { text(props.value) }
      if let Some(lbl) = props.label {
        node("div", [attr("class", "ow-stat-label")]) { text(lbl) }
      }
      if let Some(d) = props.delta {
        let cls = if d > 0.0 { "ow-stat-sub ow-stat-up" } else if d < 0.0 { "ow-stat-sub ow-stat-dn" } else { "ow-stat-sub ow-stat-flat" }
        let sign = if d > 0.0 { "▲ +" } else if d < 0.0 { "▼ " } else { "→ " }
        node("div", [attr("class", cls)]) { text(format!("{}{:.1}%", sign, d.abs())) }
      }
      if let Some(pct) = props.bar {
        node("div", [attr("class", "ow-stat-bar")]) {
          node("div", [attr("class", "ow-stat-bar-fill"), attr("style", format!("width:{}%", pct.min(100.0).max(0.0)))]) {}
        }
      }
    }
  }
}

// ── Badge ─────────────────────────────────────────────────────────────────────

enum BadgeVariant { Default, Success, Warning, Danger, Info, Muted }

component OmniBadge {
  props: { text: String, variant: BadgeVariant, pulse: bool },

  fn variant_cls(v: BadgeVariant) -> String {
    match v {
      BadgeVariant::Default => "ow-badge",
      BadgeVariant::Success => "ow-badge ow-badge-success",
      BadgeVariant::Warning => "ow-badge ow-badge-warning",
      BadgeVariant::Danger  => "ow-badge ow-badge-danger",
      BadgeVariant::Info    => "ow-badge ow-badge-info",
      BadgeVariant::Muted   => "ow-badge ow-badge-muted",
    }
  }

  render {
    let cls = Self::variant_cls(props.variant)
    if props.pulse {
      node("span", [attr("class", format!("{} ow-badge-pulse", cls))]) {
        node("span", [attr("class", "ow-badge-dot")]) {}
        text(format!(" {}", props.text))
      }
    } else {
      node("span", [attr("class", cls)]) { text(props.text) }
    }
  }
}

// ── Progress Bar ──────────────────────────────────────────────────────────────

enum ProgressVariant { Default, Success, Warning, Danger }
enum ProgressSize    { Sm, Md, Lg }

struct ProgressProps {
  value:   f32,
  label:   Option<String>,
  show_pct:bool,
  variant: ProgressVariant,
  size:    ProgressSize,
  striped: bool,
  color:   Option<String>,
}

component OmniProgress {
  props: ProgressProps,

  fn size_cls(s: ProgressSize) -> String {
    match s {
      ProgressSize::Sm => "ow-progress ow-progress-sm",
      ProgressSize::Md => "ow-progress",
      ProgressSize::Lg => "ow-progress ow-progress-lg",
    }
  }

  fn fill_cls(v: ProgressVariant, striped: bool) -> String {
    let base = match v {
      ProgressVariant::Default => "ow-progress-fill",
      ProgressVariant::Success => "ow-progress-fill ow-success",
      ProgressVariant::Warning => "ow-progress-fill ow-warning",
      ProgressVariant::Danger  => "ow-progress-fill ow-danger",
    }
    if striped { format!("{} ow-progress-strip", base) } else { base.to_string() }
  }

  render {
    let pct  = props.value.min(100.0).max(0.0)
    let pcls = Self::size_cls(props.size)
    let fcls = Self::fill_cls(props.variant, props.striped)
    let mut fstyle = format!("width:{}%", pct)
    if let Some(c) = props.color { fstyle = format!("{}; background:{}", fstyle, c) }

    node("div", []) {
      if props.label.is_some() || props.show_pct {
        node("div", [attr("class", "ow-progress-hd")]) {
          if let Some(lbl) = props.label { node("span", []) { text(lbl) } }
          if props.show_pct { node("span", []) { text(format!("{:.0}%", pct)) } }
        }
      }
      node("div", [attr("class", pcls)]) {
        node("div", [attr("class", fcls), attr("style", fstyle),
          attr("role", "progressbar"), attr("aria-valuenow", format!("{:.0}", pct)),
          attr("aria-valuemin", "0"), attr("aria-valuemax", "100")]) {}
      }
    }
  }
}

// ── Toggle ────────────────────────────────────────────────────────────────────

component OmniToggle {
  props: { label: Option<String>, on: bool, size: Option<String> },
  state: { active: bool },

  fn init_state(props) -> Self::State {
    { active: props.on }
  }

  fn toggle(&mut self) {
    self.state.active = !self.state.active
  }

  render {
    let kcls = if self.state.active { "ow-toggle on" } else { "ow-toggle" }
    let size_part = props.size.map(|s| format!(" ow-toggle-{}", s)).unwrap_or_default()
    node("label", [attr("class", "ow-toggle-wrap")]) {
      node("div", [attr("class", format!("{}{}", kcls, size_part)),
        attr("role", "switch"), attr("aria-checked", self.state.active.to_string())]) {}
      if let Some(lbl) = props.label {
        node("span", [attr("class", "ow-toggle-label")]) { text(lbl) }
      }
    }
  }
}

// ── Chip ─────────────────────────────────────────────────────────────────────

component OmniChip {
  props: { label: String, icon: Option<String>, active: bool, dismissible: bool },

  render {
    let cls = if props.active { "ow-chip ow-active" } else { "ow-chip" }
    node("span", [attr("class", cls)]) {
      if let Some(icon) = props.icon {
        node("span", [attr("class", "ow-chip-icon")]) { text(icon) }
      }
      text(props.label)
      if props.dismissible {
        node("button", [attr("class", "ow-chip-close"), attr("aria-label", "Remove")]) {
          text("✕")
        }
      }
    }
  }
}

// ── Spinner ───────────────────────────────────────────────────────────────────

enum SpinnerSize { Xs, Sm, Md, Lg, Xl }

component OmniSpinner {
  props: { size: SpinnerSize },

  fn size_cls(s: SpinnerSize) -> String {
    match s {
      SpinnerSize::Xs => "ow-spin ow-spin-xs",
      SpinnerSize::Sm => "ow-spin ow-spin-sm",
      SpinnerSize::Md => "ow-spin",
      SpinnerSize::Lg => "ow-spin ow-spin-lg",
      SpinnerSize::Xl => "ow-spin ow-spin-xl",
    }
  }

  render {
    node("div", [attr("class", Self::size_cls(props.size)),
      attr("role", "status"), attr("aria-label", "Loading")]) {}
  }
}

// ── Alert ─────────────────────────────────────────────────────────────────────

enum AlertVariant { Info, Success, Warning, Danger }

struct AlertProps {
  msg:      String,
  title:    Option<String>,
  icon:     Option<String>,
  variant:  AlertVariant,
  closable: bool,
}

component OmniAlert {
  props: AlertProps,
  state: { dismissed: bool },

  fn variant_cls(v: AlertVariant) -> String {
    match v {
      AlertVariant::Info    => "ow-alert",
      AlertVariant::Success => "ow-alert ow-alert-success",
      AlertVariant::Warning => "ow-alert ow-alert-warning",
      AlertVariant::Danger  => "ow-alert ow-alert-danger",
    }
  }

  fn default_icon(v: AlertVariant) -> String {
    match v {
      AlertVariant::Info    => "💡",
      AlertVariant::Success => "✅",
      AlertVariant::Warning => "⚠️",
      AlertVariant::Danger  => "❌",
    }
  }

  render {
    if !self.state.dismissed {
      let cls  = Self::variant_cls(props.variant)
      let icon = props.icon.clone().unwrap_or_else(|| Self::default_icon(props.variant))
      node("div", [attr("class", cls), attr("role", "alert")]) {
        node("div", [attr("class", "ow-alert-icon")]) { text(icon) }
        node("div", [attr("class", "ow-alert-body")]) {
          if let Some(t) = props.title {
            node("div", [attr("class", "ow-alert-title")]) { text(t) }
          }
          node("div", [attr("class", "ow-alert-msg")]) { text(props.msg) }
        }
        if props.closable {
          node("button", [attr("class", "ow-alert-close"), attr("aria-label", "Dismiss")]) {
            text("✕")
          }
        }
      }
    }
  }
}

// ── Health Ring ───────────────────────────────────────────────────────────────

struct HealthRingProps {
  value:    f32,
  size:     i32,
  stroke_w: i32,
  unit:     String,
}

component OmniHealthRing {
  props: HealthRingProps,

  render {
    let sz     = props.size
    let sw     = props.stroke_w
    let r      = (sz / 2) - sw
    let circ   = 2.0 * 3.14159265 * (r as f32)
    let pct    = props.value.min(100.0).max(0.0)
    let offset = circ - (pct / 100.0) * circ
    let color  = if pct > 80.0 { "var(--ow-success)" }
                 else if pct > 50.0 { "var(--ow-warning)" }
                 else { "var(--ow-danger)" }
    let cx     = sz / 2
    let cy     = sz / 2
    node("div", [attr("class", "ow-ring")]) {
      html(format!(
        "<svg width=\"{}\" height=\"{}\" viewBox=\"0 0 {} {}\" aria-label=\"{:.0}{}\">\
           <circle class=\"ow-ring-track\" cx=\"{}\" cy=\"{}\" r=\"{}\" stroke-width=\"{}\"/>\
           <circle class=\"ow-ring-fill\" cx=\"{}\" cy=\"{}\" r=\"{}\" stroke-width=\"{}\"\
             stroke-dasharray=\"{:.2}\" stroke-dashoffset=\"{:.2}\" stroke=\"{}\" stroke-linecap=\"round\"/>\
         </svg>",
        sz, sz, sz, sz, pct, props.unit,
        cx, cy, r, sw,
        cx, cy, r, sw, circ, offset, color
      ))
      node("div", [attr("class", "ow-ring-val"),
        attr("style", format!("font-size:{}px; color:{}", sz / 5, color))]) {
        text(format!("{:.0}{}", pct, props.unit))
      }
    }
  }
}

// ── Theme Picker ──────────────────────────────────────────────────────────────

struct ThemePickerProps {
  current_theme: OmniTheme,
}

component OmniThemePicker {
  props: ThemePickerProps,

  fn theme_swatch(id: String, label: String, grad: String, active: bool) -> Node {
    let cls = if active { "ow-theme-swatch ow-active" } else { "ow-theme-swatch" }
    node("div", [attr("class", "ow-theme-tile")]) {
      node("div", [attr("class", cls), attr("data-theme", id),
        attr("style", format!("background:{}", grad)),
        attr("role", "radio"), attr("aria-checked", active.to_string()),
        attr("aria-label", label.clone())]) {}
      node("div", [attr("class", "ow-theme-label")]) { text(label) }
    }
  }

  render {
    node("div", []) {
      node("div", [attr("class", "ow-section-lbl")]) { text("Theme") }
      node("div", [attr("class", "ow-themes")]) {
        Self::theme_swatch("omni-dark",   "OmniDark",   "linear-gradient(135deg,#050D1A,#00D4FF)", matches!(props.current_theme, OmniTheme::OmniDark))
        Self::theme_swatch("omni-light",  "OmniLight",  "linear-gradient(135deg,#EEF2FF,#1A6CF0)", matches!(props.current_theme, OmniTheme::OmniLight))
        Self::theme_swatch("omni-neon",   "OmniNeon",   "linear-gradient(135deg,#000000,#00FF41)", matches!(props.current_theme, OmniTheme::OmniNeon))
        Self::theme_swatch("omni-forest", "OmniForest", "linear-gradient(135deg,#050F07,#3CFF7E)", matches!(props.current_theme, OmniTheme::OmniForest))
        Self::theme_swatch("omni-aurora", "OmniAurora", "linear-gradient(135deg,#0B071E,#C07AFF)", matches!(props.current_theme, OmniTheme::OmniAurora))
        Self::theme_swatch("omni-sunset", "OmniSunset", "linear-gradient(135deg,#160700,#FF8C00)", matches!(props.current_theme, OmniTheme::OmniSunset))
      }
    }
  }
}

// ── Tabs ──────────────────────────────────────────────────────────────────────

struct TabDef {
  label: String,
  count: Option<i32>,
}

struct TabsProps {
  tabs:   Vec<TabDef>,
  pill:   bool,
}

component OmniTabs {
  props: TabsProps,
  state: { active: i32 },

  render {
    let bar_cls  = if props.pill { "ow-tabs ow-tabs-pill" } else { "ow-tabs" }
    let tab_cls0 = if props.pill { "ow-tab ow-tab-pill" } else { "ow-tab" }
    node("div", [attr("class", bar_cls)]) {
      for (i, tab) in props.tabs.iter().enumerate() {
        let cls = if i as i32 == self.state.active {
          format!("{} ow-active", tab_cls0)
        } else { tab_cls0.to_string() }
        node("button", [attr("class", cls), attr("data-tab", i.to_string())]) {
          text(tab.label.clone())
          if let Some(cnt) = tab.count {
            node("span", [attr("class", "ow-tab-count")]) { text(cnt.to_string()) }
          }
        }
      }
    }
  }
}

// ── Metric Display ────────────────────────────────────────────────────────────

component OmniMetric {
  props: { value: String, unit: Option<String>, label: Option<String>, trend: Option<f32>, color: Option<String> },

  render {
    let cstyle = props.color.map(|c| format!("color:{}", c)).unwrap_or_default()
    node("div", [attr("class", "ow-metric")]) {
      node("div", [attr("class", "ow-metric-val"), attr("style", cstyle)]) {
        text(props.value)
        if let Some(u) = props.unit {
          node("span", [attr("class", "ow-metric-unit")]) { text(u) }
        }
      }
      if let Some(lbl) = props.label {
        node("div", [attr("class", "ow-metric-lbl")]) { text(lbl) }
      }
      if let Some(t) = props.trend {
        let sign  = if t > 0.0 { "▲ +" } else if t < 0.0 { "▼ " } else { "→ " }
        let color = if t > 0.0 { "var(--ow-success)" } else if t < 0.0 { "var(--ow-danger)" } else { "var(--ow-text-muted)" }
        node("div", [attr("class", "ow-metric-trend"),
          attr("style", format!("color:{}", color))]) {
          text(format!("{}{:.1}%", sign, t.abs()))
        }
      }
    }
  }
}

// ── Widget Registry ────────────────────────────────────────────────────────────

struct WidgetEntry {
  id:    String,
  label: String,
  cat:   String,
  desc:  String,
}

struct WidgetRegistry {
  widgets: Vec<WidgetEntry>,
}

impl WidgetRegistry {
  fn new() -> WidgetRegistry {
    let mut r = WidgetRegistry { widgets: Vec::new() }
    r.register_defaults()
    r
  }

  fn register(&mut self, id: String, label: String, cat: String, desc: String) {
    self.widgets.push(WidgetEntry { id, label, cat, desc })
  }

  fn register_defaults(&mut self) {
    self.register("btn-primary",  "Primary Button",  "Buttons",    "Main call-to-action")
    self.register("btn-solid",    "Solid Button",    "Buttons",    "High-contrast filled")
    self.register("btn-ghost",    "Ghost Button",    "Buttons",    "Borderless subtle")
    self.register("btn-danger",   "Danger Button",   "Buttons",    "Destructive action")
    self.register("btn-success",  "Success Button",  "Buttons",    "Confirmation action")
    self.register("btn-fab",      "FAB",             "Buttons",    "Floating action button")
    self.register("card-basic",   "Basic Card",      "Cards",      "Container with border")
    self.register("card-glass",   "Glass Card",      "Cards",      "Frosted glass with blur")
    self.register("card-stat",    "Stat Card",       "Cards",      "KPI metric display")
    self.register("input-text",   "Text Input",      "Inputs",     "Single-line text field")
    self.register("input-toggle", "Toggle Switch",   "Inputs",     "On/off binary toggle")
    self.register("input-slider", "Slider",          "Inputs",     "Range input")
    self.register("nav-tabs",     "Tabs",            "Navigation", "Horizontal tab bar")
    self.register("nav-sidebar",  "Sidebar Nav",     "Navigation", "Vertical navigation")
    self.register("fb-badge",     "Badge",           "Feedback",   "Status label")
    self.register("fb-chip",      "Chip",            "Feedback",   "Dismissible tag")
    self.register("fb-progress",  "Progress Bar",    "Feedback",   "Animated fill")
    self.register("fb-spinner",   "Spinner",         "Feedback",   "Loading indicator")
    self.register("fb-alert",     "Alert",           "Feedback",   "Banner notification")
    self.register("data-table",   "Data Table",      "Data",       "Sortable rows")
    self.register("data-metric",  "Metric",          "Data",       "Large KPI display")
    self.register("ol-modal",     "Modal",           "Overlays",   "Centered dialog")
    self.register("ol-dropdown",  "Dropdown",        "Overlays",   "Contextual menu")
    self.register("sp-health",    "Health Ring",     "Special",    "Circular progress")
    self.register("sp-theme",     "Theme Picker",    "Special",    "Color theme switcher")
  }

  fn by_category(&self, cat: &str) -> Vec<&WidgetEntry> {
    self.widgets.iter().filter(|w| w.cat == cat).collect()
  }

  fn search(&self, q: &str) -> Vec<&WidgetEntry> {
    let q_lo = q.to_lowercase()
    self.widgets.iter().filter(|w| {
      w.label.to_lowercase().contains(&q_lo) ||
      w.desc.to_lowercase().contains(&q_lo) ||
      w.cat.to_lowercase().contains(&q_lo)
    }).collect()
  }
}

