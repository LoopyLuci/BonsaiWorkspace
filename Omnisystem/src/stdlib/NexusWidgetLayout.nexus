// ═══════════════════════════════════════════════════════════════════════════════
// NexusWidgetLayout — Responsive Layout System for UI Widgets
// Nexus language · Omnisystem · Breakpoints, flex, grid, container queries
// ═══════════════════════════════════════════════════════════════════════════════

import NexusResponsiveDesign::{ Layout, Breakpoint, FlexRule, GridRule, ContainerQuery }
import TitanStdlib::{ Vec, HashMap, String, i32, f32, bool, Option }

// ── Breakpoint Registry ───────────────────────────────────────────────────────

breakpoints {
  xs:  320px,   // Tiny phone portrait
  sm:  480px,   // Phone landscape
  md:  768px,   // Tablet portrait
  lg: 1024px,   // Tablet landscape / small desktop
  xl: 1280px,   // Desktop
  xxl:1600px,   // Wide desktop
}

// ── Design Space (8-pt grid) ──────────────────────────────────────────────────

design-space {
  unit: 4px,       // Base unit (1 = 4px)
  grid: 8px,       // Standard spacing grid
  columns: 12,     // Layout grid columns
  gutter: 16px,    // Default gutter
  container-max: 1200px,
}

// ── Widget Container Queries ──────────────────────────────────────────────────

container widget-container {
  query narrow  when width < 300px  { columns: 1, gutter: 8px  }
  query compact when width < 480px  { columns: 2, gutter: 12px }
  query default when width < 768px  { columns: 3, gutter: 16px }
  query wide    when width >= 768px { columns: 4, gutter: 24px }
}

container card-grid {
  query single when width < 400px  { columns: 1 }
  query dual   when width < 700px  { columns: 2 }
  query triple when width < 1000px { columns: 3 }
  query quad   when width >= 1000px{ columns: 4 }
}

container stat-row {
  query mobile  when width < 480px  { columns: 2, gap: 8px  }
  query tablet  when width < 800px  { columns: 3, gap: 12px }
  query desktop when width >= 800px { columns: 5, gap: 16px }
}

// ── Flex Layout Rules ─────────────────────────────────────────────────────────

layout row {
  display:     flex,
  direction:   row,
  wrap:        wrap,
  align-items: center,
  gap:         var(--ow-s2),
}

layout row-tight {
  display:     flex,
  direction:   row,
  align-items: center,
  gap:         var(--ow-s1),
}

layout row-between {
  display:         flex,
  direction:       row,
  align-items:     center,
  justify-content: space-between,
  gap:             var(--ow-s2),
}

layout col {
  display:   flex,
  direction: column,
  gap:       var(--ow-s2),
}

layout col-tight {
  display:   flex,
  direction: column,
  gap:       var(--ow-s1),
}

layout center {
  display:         flex,
  align-items:     center,
  justify-content: center,
}

layout stack {
  display:   flex,
  direction: column,
  gap:       var(--ow-s3),
  flex:      1,
}

// ── Grid Layout Rules ─────────────────────────────────────────────────────────

layout grid-auto {
  display:               grid,
  template-columns:      repeat(auto-fill, minmax(200px, 1fr)),
  gap:                   var(--ow-s2),
}

layout grid-auto-sm {
  display:               grid,
  template-columns:      repeat(auto-fill, minmax(140px, 1fr)),
  gap:                   var(--ow-s2),
}

layout grid-auto-lg {
  display:               grid,
  template-columns:      repeat(auto-fill, minmax(280px, 1fr)),
  gap:                   var(--ow-s3),
}

layout grid-2 {
  display:               grid,
  template-columns:      repeat(2, 1fr),
  gap:                   var(--ow-s2),
  responsive {
    at xs { template-columns: 1fr }
    at sm { template-columns: 1fr }
  }
}

layout grid-3 {
  display:               grid,
  template-columns:      repeat(3, 1fr),
  gap:                   var(--ow-s2),
  responsive {
    at xs { template-columns: 1fr }
    at sm { template-columns: repeat(2, 1fr) }
  }
}

layout grid-4 {
  display:               grid,
  template-columns:      repeat(4, 1fr),
  gap:                   var(--ow-s2),
  responsive {
    at xs { template-columns: 1fr }
    at sm { template-columns: repeat(2, 1fr) }
    at md { template-columns: repeat(3, 1fr) }
  }
}

layout grid-stat {
  display:               grid,
  template-columns:      repeat(auto-fill, minmax(120px, 1fr)),
  gap:                   var(--ow-s2),
}

// ── Panel & Section Layouts ───────────────────────────────────────────────────

layout panel {
  display:        flex,
  direction:      column,
  flex:           1,
  overflow:       hidden,
  min-height:     0,
}

layout panel-scrollable {
  extends: panel,
  overflow-y: auto,
  scroll-behavior: smooth,
}

layout sidebar-layout {
  display:    grid,
  template:   "sidebar main" / 220px 1fr,
  gap:        var(--ow-s2),
  height:     100%,
  responsive {
    at md { template: "sidebar" "main" / 1fr }
  }
}

layout header-body {
  display:    grid,
  template:   "header" auto "body" 1fr / 1fr,
  height:     100%,
  gap:        0,
}

layout header-body-footer {
  display:    grid,
  template:   "header" auto "body" 1fr "footer" auto / 1fr,
  height:     100%,
}

// ── Widget-Specific Layouts ───────────────────────────────────────────────────

// Card layouts
layout card-body {
  padding:   var(--ow-s3),
  flex:      1,
  overflow:  hidden,
}

layout card-header {
  display:         flex,
  align-items:     center,
  justify-content: space-between,
  padding:         var(--ow-s2) var(--ow-s3),
  border-bottom:   1px solid var(--ow-border),
  gap:             var(--ow-s2),
}

layout card-footer {
  display:         flex,
  align-items:     center,
  justify-content: flex-end,
  gap:             var(--ow-s2),
  padding:         var(--ow-s2) var(--ow-s3),
  border-top:      1px solid var(--ow-border),
}

// Button layouts
layout btn-group {
  display:    inline-flex,
  align-items:center,
}

layout btn-toolbar {
  display:    flex,
  flex-wrap:  wrap,
  gap:        var(--ow-s2),
  align-items:center,
}

// Modal layout
layout modal-content {
  display:    flex,
  direction:  column,
  max-height: calc(100vh - 80px),
  width:      min(560px, calc(100vw - 32px)),
}

layout modal-body {
  flex:      1,
  overflow-y:auto,
  padding:   var(--ow-s4),
}

layout modal-footer {
  display:         flex,
  align-items:     center,
  justify-content: flex-end,
  gap:             var(--ow-s2),
  padding:         var(--ow-s3) var(--ow-s4),
}

// Sidebar nav layout
layout sidenav-item {
  display:         flex,
  align-items:     center,
  gap:             var(--ow-s2),
  padding:         var(--ow-s2) var(--ow-s3),
  cursor:          pointer,
  border-radius:   var(--ow-r-md),
  transition:      background var(--ow-t),
}

// Table layout
layout table-wrapper {
  overflow-x:  auto,
  overflow-y:  auto,
  max-height:  400px,
  border-radius: var(--ow-r-lg),
  border:      1px solid var(--ow-border),
}

// Input field layout
layout field-group {
  display:   flex,
  direction: column,
  gap:       var(--ow-s1),
}

layout field-row {
  display:    flex,
  align-items:center,
  gap:        var(--ow-s2),
}

// Progress layout
layout progress-header {
  display:         flex,
  align-items:     center,
  justify-content: space-between,
  margin-bottom:   var(--ow-s1),
  font-size:       var(--ow-f-xs),
  color:           var(--ow-text-dim),
}

// Toast container layout
layout toast-container {
  position:  fixed,
  bottom:    var(--ow-s4),
  right:     var(--ow-s4),
  z-index:   9999,
  display:   flex,
  direction: column,
  gap:       var(--ow-s2),
  max-width: 320px,
  pointer-events: none,
}

// Alert layout
layout alert-body {
  display:    flex,
  align-items:flex-start,
  gap:        var(--ow-s2),
  flex:       1,
}

// Dropdown layout
layout dropdown-menu {
  position:      absolute,
  z-index:       1000,
  top:           calc(100% + 4px),
  left:          0,
  min-width:     180px,
  max-height:    320px,
  overflow-y:    auto,
  border-radius: var(--ow-r-xl),
  border:        1px solid var(--ow-border),
  background:    var(--ow-glass),
  backdrop-filter: blur(12px),
  box-shadow:    var(--ow-shadow),
}

// Sparkline layout
layout sparkline {
  display:     flex,
  align-items: flex-end,
  gap:         2px,
  height:      24px,
}

// Health ring overlay
layout ring-overlay {
  position: relative,
  display:  inline-flex,
  align-items: center,
  justify-content: center,
}

layout ring-val {
  position:  absolute,
  top:       50%,
  left:      50%,
  transform: translate(-50%, -50%),
  font-weight: 700,
  line-height: 1,
  text-align:  center,
}

// Widget database browser layout
layout wdb-browser {
  display:   flex,
  direction: column,
  gap:       var(--ow-s3),
  height:    100%,
}

layout wdb-grid {
  display:             grid,
  template-columns:    repeat(auto-fill, minmax(180px, 1fr)),
  gap:                 var(--ow-s2),
  overflow-y:          auto,
  flex:                1,
}

layout wdb-card-inner {
  display:   flex,
  direction: column,
  gap:       var(--ow-s2),
}

// ── Spacing Utilities ─────────────────────────────────────────────────────────

spacing {
  gap-0:  0,
  gap-1:  4px,
  gap-2:  8px,
  gap-3: 12px,
  gap-4: 16px,
  gap-5: 20px,
  gap-6: 24px,
  gap-8: 32px,

  p-0:  0,
  p-1:  4px,
  p-2:  8px,
  p-3: 12px,
  p-4: 16px,
  p-5: 20px,
  p-6: 24px,

  m-0:  0,
  m-1:  4px,
  m-2:  8px,
  m-3: 12px,
  m-4: 16px,
  m-auto: auto,
}

// ── Size Utilities ────────────────────────────────────────────────────────────

sizing {
  w-full:  100%,
  h-full:  100%,
  w-auto:  auto,
  h-auto:  auto,
  w-fit:   fit-content,
  h-fit:   fit-content,
  flex-1:  1,
  flex-auto: auto,
  min-w-0: 0,
  min-h-0: 0,
  max-w-xs: 320px,
  max-w-sm: 480px,
  max-w-md: 640px,
  max-w-lg: 800px,
  max-w-xl: 1024px,
}

// ── Overflow Utilities ────────────────────────────────────────────────────────

overflow {
  scroll:   auto,
  scroll-x: { overflow-x: auto, overflow-y: hidden },
  scroll-y: { overflow-x: hidden, overflow-y: auto },
  hidden:   hidden,
  clip:     clip,
}

// ── Visibility Utilities ──────────────────────────────────────────────────────

visibility {
  hidden:  none,
  visible: block,
  inline:  inline,
  flex:    flex,
  grid:    grid,
}

// ── Layout Composition ────────────────────────────────────────────────────────

// Compose common UI patterns from primitives
layout app-shell {
  display:  grid,
  template: "taskbar" auto "desktop" 1fr / 1fr,
  height:   100vh,
  overflow: hidden,
}

layout desktop-area {
  position: relative,
  overflow: hidden,
  flex:     1,
}

layout window-chrome {
  display:  flex,
  direction:column,
  position: absolute,
  border-radius: var(--ow-r-xl),
  border:   1px solid var(--ow-border),
  box-shadow: var(--ow-shadow-glow),
  background: var(--ow-glass),
  backdrop-filter: blur(18px),
  overflow: hidden,
}

layout window-titlebar {
  display:         flex,
  align-items:     center,
  justify-content: space-between,
  padding:         var(--ow-s2) var(--ow-s3),
  border-bottom:   1px solid var(--ow-border),
  cursor:          move,
  user-select:     none,
}

layout window-body {
  flex:      1,
  overflow:  auto,
  padding:   var(--ow-s3),
}

// ── Module Export ─────────────────────────────────────────────────────────────

pub mod nexus_widget_layout {
  pub use super::{
    row, col, stack, center, grid_auto, grid_2, grid_3, grid_4, grid_stat,
    panel, panel_scrollable, sidebar_layout, header_body, header_body_footer,
    card_body, card_header, card_footer, btn_group, btn_toolbar,
    modal_content, modal_body, modal_footer, sidenav_item, table_wrapper,
    field_group, field_row, toast_container, alert_body, dropdown_menu,
    sparkline, ring_overlay, ring_val, wdb_browser, wdb_grid, app_shell,
    desktop_area, window_chrome, window_titlebar, window_body,
  }
}
