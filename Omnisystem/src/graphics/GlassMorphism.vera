// Glass Morphism & Frosted Glass Effects
// Backdrop blur, semi-transparency, used for navigation/floating panels
// Phase 168

use omnisystem::{Vec, HashMap, Option, Result, String, f64}

struct GlassConfig {
    blur_amount: f64,
    transparency: f64,
    tint_color: String,
    border_opacity: f64
}

actor GlassMorphismEngine {
    config: GlassConfig = GlassConfig {
        blur_amount: 10.0,
        transparency: 0.8,
        tint_color: "rgba(255,255,255,0.1)".to_string(),
        border_opacity: 0.2
    }

    message SetBlurAmount(amount: f64) -> Result<(), String> {
        if amount < 0.0 || amount > 50.0 {
            return Err("Blur must be 0-50px".to_string())
        }
        config.blur_amount = amount
        Ok(())
    }

    message SetTransparency(alpha: f64) -> Result<(), String> {
        if alpha < 0.0 || alpha > 1.0 {
            return Err("Transparency must be 0-1".to_string())
        }
        config.transparency = alpha
        Ok(())
    }

    message GenerateGlassStyle() -> String {
        format!(r#"{{
            "background": "rgba(255, 255, 255, {})",
            "backdrop-filter": "blur({}px)",
            "border": "1px solid rgba(255, 255, 255, {})",
            "border-radius": "12px"
        }}"#, config.transparency, config.blur_amount, config.border_opacity)
    }
}

component GlassPanel {
    state {}

    props {
        blur: f64 = 10.0,
        opacity: f64 = 0.8
    }

    render {
        div {
            class: "glass-panel",
            style: {
                "background": format!("rgba(255, 255, 255, {})", opacity),
                "backdrop-filter": format!("blur({}px)", blur),
                "border": format!("1px solid rgba(255, 255, 255, {})", opacity * 0.5),
                "border-radius": "12px",
                "padding": "16px"
            },
            slot: {}
        }
    }
}
