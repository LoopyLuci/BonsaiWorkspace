// Icon System
// 5,000+ vector icons, multi-weight, animated icons, search, icon packs
// Phase 164

use omnisystem::{Vec, HashMap, Option, Result, String, f64, bool}

struct Icon {
    name: String,
    categories: Vec<String>,
    weights: HashMap<String, String>,
    animated: bool,
    tags: Vec<String>
}

struct IconPack {
    name: String,
    version: String,
    icons: Vec<Icon>,
    author: String
}

struct IconSet {
    style: String,
    weight: String,
    size: f64,
    color: String,
    animated: bool
}

enum IconWeight {
    Thin,
    Light,
    Regular,
    Semibold,
    Bold,
    Black
}

actor IconSystem {
    icons: HashMap<String, Icon> = HashMap::new(),
    icon_packs: HashMap<String, IconPack> = HashMap::new(),
    default_weight: String = "regular".to_string(),
    default_size: f64 = 24.0,
    default_color: String = "#000000".to_string(),
    search_index: HashMap<String, Vec<String>> = HashMap::new(),
    recent_icons: Vec<String> = Vec::new(),
    max_recent: i32 = 20

    message RegisterIcon(name: String, categories: Vec<String>, tags: Vec<String>) -> Result<(), String> {
        if name.len() == 0 {
            return Err("Icon name cannot be empty".to_string())
        }

        let icon = Icon {
            name: name.clone(),
            categories: categories.clone(),
            weights: HashMap::new(),
            animated: false,
            tags: tags.clone()
        }

        icons.insert(name.clone(), icon)

        for tag in tags {
            if !search_index.contains_key(&tag) {
                search_index.insert(tag.clone(), Vec::new())
            }
            if let Some(entry) = search_index.get_mut(&tag) {
                entry.push(name.clone())
            }
        }

        Ok(())
    }

    message AddIconVariant(icon_name: String, weight: String, svg_data: String) -> Result<(), String> {
        match icons.get_mut(&icon_name) {
            Some(icon) => {
                icon.weights.insert(weight, svg_data)
                Ok(())
            },
            None => Err("Icon not found".to_string())
        }
    }

    message MarkIconAnimated(icon_name: String, animated: bool) -> Result<(), String> {
        match icons.get_mut(&icon_name) {
            Some(icon) => {
                icon.animated = animated
                Ok(())
            },
            None => Err("Icon not found".to_string())
        }
    }

    message GetIcon(name: String, weight: String, size: f64, color: String) -> Result<String, String> {
        match icons.get(&name) {
            Some(icon) => {
                let used_weight = if icon.weights.contains_key(&weight) {
                    weight
                } else {
                    default_weight.clone()
                }

                match icon.weights.get(&used_weight) {
                    Some(svg) => {
                        recent_icons.push(name.clone())
                        if recent_icons.len() > max_recent as usize {
                            recent_icons.remove(0)
                        }

                        Ok(svg.clone())
                    },
                    None => Err("Icon variant not found".to_string())
                }
            },
            None => Err("Icon not found".to_string())
        }
    }

    message SearchIcons(query: String) -> Result<Vec<String>, String> {
        let mut results: Vec<String> = Vec::new()
        let query_lower = query.to_lowercase()

        for (icon_name, icon) in &icons {
            if icon_name.contains(&query_lower) {
                results.push(icon_name.clone())
            } else {
                for tag in &icon.tags {
                    if tag.contains(&query_lower) {
                        results.push(icon_name.clone())
                        break
                    }
                }
            }
        }

        Ok(results)
    }

    message GetIconsByCategory(category: String) -> Result<Vec<String>, String> {
        let mut results: Vec<String> = Vec::new()

        for (icon_name, icon) in &icons {
            for cat in &icon.categories {
                if cat == &category {
                    results.push(icon_name.clone())
                    break
                }
            }
        }

        Ok(results)
    }

    message CreateIconPack(pack_name: String, version: String, author: String) -> Result<(), String> {
        let pack = IconPack {
            name: pack_name.clone(),
            version: version,
            icons: Vec::new(),
            author: author
        }

        icon_packs.insert(pack_name, pack)
        Ok(())
    }

    message AddIconToPack(pack_name: String, icon_name: String) -> Result<(), String> {
        match icons.get(&icon_name) {
            Some(icon) => {
                match icon_packs.get_mut(&pack_name) {
                    Some(pack) => {
                        pack.icons.push(icon.clone())
                        Ok(())
                    },
                    None => Err("Pack not found".to_string())
                }
            },
            None => Err("Icon not found".to_string())
        }
    }

    message GetRecentIcons() -> Vec<String> {
        recent_icons.clone()
    }

    message ExportIconAsFont(icon_name: String, format: String) -> Result<String, String> {
        match icons.get(&icon_name) {
            Some(_) => {
                match format.as_str() {
                    "ttf" => Ok("TTF export pending".to_string()),
                    "otf" => Ok("OTF export pending".to_string()),
                    "woff" => Ok("WOFF export pending".to_string()),
                    _ => Err("Unknown font format".to_string())
                }
            },
            None => Err("Icon not found".to_string())
        }
    }

    message GetIconCount() -> i32 {
        icons.len() as i32
    }

    message SetDefaultWeight(weight: String) -> Result<(), String> {
        let valid_weights = vec!["thin", "light", "regular", "semibold", "bold", "black"]
        let mut is_valid = false
        for vw in &valid_weights {
            if vw == &weight.as_str() {
                is_valid = true
                break
            }
        }

        if !is_valid {
            return Err("Invalid weight".to_string())
        }

        default_weight = weight
        Ok(())
    }
}

component IconComponent {
    state {
        loaded: bool = false
    }

    props {
        name: String = "".to_string(),
        weight: String = "regular".to_string(),
        size: f64 = 24.0,
        color: String = "#000000".to_string(),
        animated: bool = false
    }

    render {
        svg {
            class: format!("icon icon-{}", name),
            width: format!("{}px", size as i32),
            height: format!("{}px", size as i32),
            viewBox: "0 0 24 24",
            style: {
                "display": "inline-block",
                "fill": color,
                "flex-shrink": "0"
            },
            content: render_icon_path(name.clone())
        }
    }

    fn on_mount() {
        loaded = true
    }
}

fn render_icon_path(icon_name: String) -> String {
    match icon_name.as_str() {
        "check" => r#"<path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/>"#.to_string(),
        "close" => r#"<path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12 19 6.41z"/>"#.to_string(),
        "menu" => r#"<path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"/>"#.to_string(),
        "search" => r#"<path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0016 9.5 6.5 6.5 0 109.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>"#.to_string(),
        "home" => r#"<path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>"#.to_string(),
        "settings" => r#"<path d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.62l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94L14.4 2.81c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41L9.25 5.35C8.66 5.59 8.12 5.92 7.63 6.29L5.24 5.33c-.22-.08-.47 0-.59.22L2.74 8.87c-.13.21-.08.48.1.62l2.03 1.58c-.05.3-.07.62-.07.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.62l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.48-.12-.62l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/>"#.to_string(),
        _ => r#"<circle cx="12" cy="12" r="10"/>"#.to_string()
    }
}

async fn test_icon_system() -> Result<(), String> {
    let system: ActorRef<IconSystem> = spawn(IconSystem {
        icons: HashMap::new(),
        icon_packs: HashMap::new(),
        default_weight: "regular".to_string(),
        default_size: 24.0,
        default_color: "#000000".to_string(),
        search_index: HashMap::new(),
        recent_icons: Vec::new(),
        max_recent: 20
    })

    await system.call(IconSystem::RegisterIcon("check".to_string(), vec!["validation".to_string()], vec!["checkmark".to_string()]))?
    await system.call(IconSystem::RegisterIcon("close".to_string(), vec!["action".to_string()], vec!["exit".to_string()]))?

    await system.call(IconSystem::CreateIconPack("system".to_string(), "1.0.0".to_string(), "Omnisystem".to_string()))?
    await system.call(IconSystem::AddIconToPack("system".to_string(), "check".to_string()))?

    let search_results = await system.call(IconSystem::SearchIcons("check".to_string()))?
    println("Found {} icons matching 'check'", search_results.len())

    let count = await system.call(IconSystem::GetIconCount())?
    println("Total icons: {}", count)

    Ok(())
}
