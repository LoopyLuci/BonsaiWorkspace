        return Ok(devices)
    }

    fn create_buffer(size: i64, usage: String) -> Result<GpuBuffer, String> {
        // ID3D12Device::CreateCommittedResource with D3D12_RESOURCE_STATE_COMMON

        return Ok(GpuBuffer {
            id: 1,
            size: size,
            usage: usage,
            memory_type: "default".to_string(),
            gpu_address: 0x2000
        })
    }

    fn create_render_target_view(image: &GpuImage) -> Result<i32, String> {
        // ID3D12Device::CreateRenderTargetView

        return Ok(0)
    }

    fn reset_command_allocator() -> Result<(), String> {
        // ID3D12CommandAllocator::Reset

        return Ok(())
    }

    fn wait_for_idle() -> Result<(), String> {
        // Wait on fence via command_queue::Signal

        println("DirectX 12: Waiting for GPU idle")
        return Ok(())
    }
}

// Metal backend (macOS/iOS)
#[cfg(target_gpu = "metal")]
struct MetalContext {
    device: *mut void,
    command_queue: *mut void,
    library: *mut void
}

impl MetalContext {
    fn initialize() -> Result<Self, String> {
        println("Metal: Initializing Metal context")

        // MTLCreateSystemDefaultDevice
        // [device newCommandQueue]
        // [device newLibraryWithSource:options:error:]

        return Ok(MetalContext {
            device: std::ptr::null_mut(),
            command_queue: std::ptr::null_mut(),
            library: std::ptr::null_mut()
        })
    }

    fn enumerate_devices() -> Result<Vec<GpuDevice>, String> {
        println("Metal: Enumerating GPU devices")

        let devices = vec![
            GpuDevice {
                backend: GpuBackend::Metal,
                device_id: 0,
                name: "Apple M2 Max GPU".to_string(),
                vendor: "Apple".to_string(),
                memory_total: 16 * 1024 * 1024 * 1024,
                memory_available: 16 * 1024 * 1024 * 1024,
                compute_capability: "apple_m2".to_string()
            }
        ]

        return Ok(devices)
    }

    fn create_buffer(size: i64) -> Result<GpuBuffer, String> {
        // [device newBufferWithLength:options:]

        return Ok(GpuBuffer {
            id: 1,
            size: size,
            usage: "storage".to_string(),
            memory_type: "shared".to_string(),
            gpu_address: 0x3000
        })
    }

    fn create_texture(width: i32, height: i32, format: String) -> Result<GpuImage, String> {
        // MTLTextureDescriptor
        // [device newTextureWithDescriptor:]

        return Ok(GpuImage {
            id: 1,
            width: width,
            height: height,
            depth: 1,
            format: format,
            usage: "color".to_string(),
            mip_levels: 1
        })
    }

    fn wait_for_idle() -> Result<(), String> {
        println("Metal: Waiting for GPU idle")
        return Ok(())
    }
}

// Unified GPU surface abstraction
struct GpuSurface {
    backend: GpuBackend,
    device: GpuDevice,
    width: i32,
    height: i32,
    color_image: GpuImage,
    depth_image: Option<GpuImage>,
    render_pass: GpuRenderPass
}

impl GpuSurface {
    fn new(backend: GpuBackend, width: i32, height: i32) -> Result<Self, String> {
        println("GpuSurface: Creating surface for {} backend", match backend {
            GpuBackend::Vulkan => "Vulkan",
            GpuBackend::DirectX12 => "DirectX 12",
            GpuBackend::Metal => "Metal",
            GpuBackend::WebGPU => "WebGPU"
        })

        let color_image = GpuImage {
            id: 0,
            width: width,
            height: height,
            depth: 1,
            format: "RGBA8".to_string(),
            usage: "color".to_string(),
            mip_levels: 1
        }

        let depth_image = GpuImage {
            id: 1,
            width: width,
            height: height,
            depth: 1,
            format: "D32F".to_string(),
            usage: "depth".to_string(),
            mip_levels: 1
        }

        let render_pass = GpuRenderPass {
            id: 0,
            color_attachments: vec![color_image.clone()],
            depth_attachment: Some(depth_image.clone()),
            width: width,
            height: height
        }

        return Ok(GpuSurface {
            backend: backend,
            device: GpuDevice {
                backend: backend,
                device_id: 0,
                name: "Default GPU".to_string(),
                vendor: "Unknown".to_string(),
                memory_total: 0,
                memory_available: 0,
                compute_capability: "unknown".to_string()
            },
            width: width,
            height: height,
            color_image: color_image,
            depth_image: Some(depth_image),
            render_pass: render_pass
        })
    }

    fn present() -> Result<(), String> {
        println("GpuSurface: Presenting frame")
        return Ok(())
    }

    fn resize(new_width: i32, new_height: i32) -> Result<(), String> {
        println("GpuSurface: Resizing to {}x{}", new_width, new_height)
        return Ok(())
    }

    fn wait_idle() -> Result<(), String> {
        println("GpuSurface: Synchronizing with GPU")
        return Ok(())
    }
}

// Integration test
fn test_gpu_bindings() -> Result<(), String> {
    println("Starting GPU Bindings test")

    // Auto-detect best GPU
    #[cfg(target_gpu = "vulkan")]
    {
        let vulkan = VulkanContext::initialize()?
        let devices = VulkanContext::enumerate_devices()?
        println("Vulkan detected {} GPU device(s)", devices.len())

        for device in devices {
            println("  - {}: {} ({} GB VRAM)",
                device.device_id,
                device.name,
                device.memory_total / (1024 * 1024 * 1024)
            )
        }

        let buffer = VulkanContext::create_buffer(1024 * 1024, "vertex".to_string())?
        println("Created Vulkan buffer: {} bytes at {:#x}", buffer.size, buffer.gpu_address)
    }

    #[cfg(target_gpu = "directx12")]
    {
        let dx12 = DirectX12Context::initialize()?
        let devices = DirectX12Context::enumerate_devices()?
        println("DirectX 12 detected {} GPU device(s)", devices.len())
    }

    #[cfg(target_gpu = "metal")]
    {
        let metal = MetalContext::initialize()?
        let devices = MetalContext::enumerate_devices()?
        println("Metal detected {} GPU device(s)", devices.len())

        let buffer = MetalContext::create_buffer(512 * 1024)?
        println("Created Metal buffer: {} bytes at {:#x}", buffer.size, buffer.gpu_address)
    }

    // Create unified surface
    let surface = GpuSurface::new(GpuBackend::Vulkan, 1920, 1080)?
    println("GPU surface created: {}x{}", surface.width, surface.height)

    surface.present()?
    surface.resize(2560, 1440)?
    surface.wait_idle()?

    println("GPU Bindings test complete")
    return Ok(())
}
