// Typography Scale Editor
// Define font scales, line height controls, responsive typography breakpoints, export
// Phase 177

use omnisystem::{Vec, HashMap, Option, Result, String, f64}

struct TypographyScale {
    name: String,
    font_size: f64,
    line_height: f64,
    letter_spacing: f64,
    responsive_sizes: HashMap<String, f64>
}

actor TypographyScaleEditor {
    scales: HashMap<String, TypographyScale> = HashMap::new()

    message CreateScale(name: String, size: f64, line_height: f64) -> Result<(), String> {
        let scale = TypographyScale {
            name: name.clone(),
            font_size: size,
            line_height: line_height,
            letter_spacing: 0.0,
            responsive_sizes: HashMap::new()
        }
        scales.insert(name, scale)
        Ok(())
    }

    message SetResponsiveSize(scale_name: String, breakpoint: String, size: f64) -> Result<(), String> {
        if let Some(scale) = scales.get_mut(&scale_name) {
            scale.responsive_sizes.insert(breakpoint, size)
            Ok(())
        } else {
            Err("Scale not found".to_string())
        }
    }

    message ExportScales(format: String) -> Result<String, String> {
        Ok("Scales exported".to_string())
    }
}
