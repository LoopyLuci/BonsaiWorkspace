// ThreatDetection.titan - TIER 4: Advanced threat detection with ML-based anomaly detection
// Insider threat prevention, malware detection, behavioral analysis

use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

// ============================================================================
// BEHAVIORAL BASELINE & ANOMALY DETECTION
// ============================================================================

pub struct UserBehaviorProfile {
    pub user_id: String,
    pub typical_login_hours: (u32, u32), // (start_hour, end_hour)
    pub typical_data_access_gb_per_day: f32,
    pub typical_file_operations_per_day: u32,
    pub typical_locations: Vec<String>,
    pub typical_devices: Vec<String>,
    pub risk_score: u8,
}

impl UserBehaviorProfile {
    pub fn new(user_id: String) -> Self {
        UserBehaviorProfile {
            user_id,
            typical_login_hours: (9, 17),
            typical_data_access_gb_per_day: 5.0,
            typical_file_operations_per_day: 100,
            typical_locations: vec!["office".to_string()],
            typical_devices: vec!["laptop".to_string()],
            risk_score: 0,
        }
    }

    pub fn calculate_anomaly_score(
        &self,
        current_hour: u32,
        data_accessed_gb: f32,
        file_ops: u32,
        location: &str,
        device: &str,
    ) -> u8 {
        let mut anomaly_score = 0u8;

        // Check login hour anomaly
        if current_hour < self.typical_login_hours.0 || current_hour > self.typical_login_hours.1 {
            anomaly_score += 25;
        }

        // Check data access anomaly (accessing 3x typical amount)
        if data_accessed_gb > self.typical_data_access_gb_per_day * 3.0 {
            anomaly_score += 30;
        }

        // Check file operations anomaly
        if file_ops > self.typical_file_operations_per_day * 2 {
            anomaly_score += 20;
        }

        // Check location anomaly
        if !self.typical_locations.contains(&location.to_string()) {
            anomaly_score += 15;
        }

        // Check device anomaly
        if !self.typical_devices.contains(&device.to_string()) {
            anomaly_score += 10;
        }

        anomaly_score.min(100)
    }
}

// ============================================================================
// INSIDER THREAT DETECTION
// ============================================================================

pub enum ThreatLevel {
    Low,
    Medium,
    High,
    Critical,
}

pub struct InsiderThreatIndicator {
    pub indicator_type: String,
    pub description: String,
    pub severity: ThreatLevel,
    pub timestamp: u64,
}

impl InsiderThreatIndicator {
    pub fn new(indicator_type: String, description: String, severity: ThreatLevel) -> Self {
        InsiderThreatIndicator {
            indicator_type,
            description,
            severity,
            timestamp: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
        }
    }

    pub fn severity_score(&self) -> u8 {
        match self.severity {
            ThreatLevel::Low => 25,
            ThreatLevel::Medium => 50,
            ThreatLevel::High => 75,
            ThreatLevel::Critical => 100,
        }
    }
}

pub struct InsiderThreatDetector {
    pub user_profiles: HashMap<String, UserBehaviorProfile>,
    pub detected_threats: Vec<InsiderThreatIndicator>,
}

impl InsiderThreatDetector {
    pub fn new() -> Self {
        InsiderThreatDetector {
            user_profiles: HashMap::new(),
            detected_threats: vec![],
        }
    }

    pub fn register_user(&mut self, user_id: String) -> Result<(), String> {
        self.user_profiles.insert(user_id, UserBehaviorProfile::new(user_id));
        Ok(())
    }

    pub fn detect_insider_threat(
        &mut self,
        user_id: &str,
        current_hour: u32,
        data_accessed_gb: f32,
        file_ops: u32,
        location: &str,
        device: &str,
        is_exfiltrating: bool,
    ) -> Result<u8, String> {
        let profile = self
            .user_profiles
            .get(user_id)
            .ok_or("User profile not found")?;

        let mut threat_score = profile.calculate_anomaly_score(
            current_hour,
            data_accessed_gb,
            file_ops,
            location,
            device,
        );

        // Check for data exfiltration attempts
        if is_exfiltrating {
            threat_score += 50;
        }

        // Log threat if detected
        if threat_score > 50 {
            let severity = match threat_score {
                75..=100 => ThreatLevel::Critical,
                50..=74 => ThreatLevel::High,
                25..=49 => ThreatLevel::Medium,
                _ => ThreatLevel::Low,
            };

            let indicator = InsiderThreatIndicator::new(
                format!("User behavior anomaly detected for {}", user_id),
                format!(
                    "Threat score: {}, Data: {} GB, Ops: {}, Location: {}, Device: {}",
                    threat_score, data_accessed_gb, file_ops, location, device
                ),
                severity,
            );

            self.detected_threats.push(indicator);
            println!(
                "⚠️  Insider threat detected for {}: score={}",
                user_id, threat_score
            );
        }

        Ok(threat_score)
    }
}

// ============================================================================
// MALWARE DETECTION
// ============================================================================

pub struct MalwareSignature {
    pub signature_id: String,
    pub pattern: String,
    pub threat_name: String,
    pub severity: ThreatLevel,
}

impl MalwareSignature {
    pub fn new(threat_name: String, pattern: String, severity: ThreatLevel) -> Self {
        MalwareSignature {
            signature_id: format!("sig_{}", std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs()),
            pattern,
            threat_name,
            severity,
        }
    }
}

pub struct MalwareDetector {
    pub signatures: Vec<MalwareSignature>,
    pub detections: Vec<(String, String, u64)>, // (file, threat, timestamp)
}

impl MalwareDetector {
    pub fn new() -> Self {
        MalwareDetector {
            signatures: vec![],
            detections: vec![],
        }
    }

    pub fn register_signature(&mut self, signature: MalwareSignature) -> Result<(), String> {
        self.signatures.push(signature);
        Ok(())
    }

    pub fn scan_file(&mut self, file_path: &str, file_content: &str) -> Result<bool, String> {
        for signature in &self.signatures {
            if file_content.contains(&signature.pattern) {
                self.detections.push((
                    file_path.to_string(),
                    signature.threat_name.clone(),
                    std::time::SystemTime::now()
                        .duration_since(std::time::UNIX_EPOCH)
                        .unwrap()
                        .as_secs(),
                ));

                println!("🛑 Malware detected: {} in {}", signature.threat_name, file_path);
                return Ok(true);
            }
        }

        Ok(false)
    }

    pub fn get_detections(&self) -> Vec<String> {
        self.detections
            .iter()
            .map(|(file, threat, time)| {
                format!("File: {}, Threat: {}, Time: {}", file, threat, time)
            })
            .collect()
    }
}

// ============================================================================
// NETWORK ANOMALY DETECTION
// ============================================================================

pub struct NetworkAnomaly {
    pub source_ip: String,
    pub destination_ip: String,
    pub port: u16,
    pub anomaly_type: String,
    pub severity: u8,
    pub timestamp: u64,
}

impl NetworkAnomaly {
    pub fn new(
        source_ip: String,
        destination_ip: String,
        port: u16,
        anomaly_type: String,
    ) -> Self {
        NetworkAnomaly {
            source_ip,
            destination_ip,
            port,
            anomaly_type,
            severity: 50,
            timestamp: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
        }
    }
}

pub struct NetworkAnomalyDetector {
    pub known_ips: Vec<String>,
    pub anomalies: Vec<NetworkAnomaly>,
}

impl NetworkAnomalyDetector {
    pub fn new() -> Self {
        NetworkAnomalyDetector {
            known_ips: vec![
                "10.0.0.1".to_string(),
                "10.0.0.2".to_string(),
                "10.0.0.3".to_string(),
            ],
            anomalies: vec![],
        }
    }

    pub fn check_connection(
        &mut self,
        source_ip: &str,
        dest_ip: &str,
        port: u16,
    ) -> Result<bool, String> {
        // Check if destination is suspicious
        let is_suspicious = port > 10000 && !self.known_ips.contains(&dest_ip.to_string());

        if is_suspicious {
            let anomaly = NetworkAnomaly::new(
                source_ip.to_string(),
                dest_ip.to_string(),
                port,
                "suspicious_connection".to_string(),
            );

            self.anomalies.push(anomaly);
            println!(
                "⚠️  Suspicious network connection: {} → {}:{}",
                source_ip, dest_ip, port
            );
            Ok(true)
        } else {
            Ok(false)
        }
    }

    pub fn get_anomalies(&self) -> Vec<String> {
        self.anomalies
            .iter()
            .map(|a| {
                format!(
                    "{} → {}:{} ({})",
                    a.source_ip, a.destination_ip, a.port, a.anomaly_type
                )
            })
            .collect()
    }
}

// ============================================================================
// INTEGRATED THREAT DETECTION SYSTEM
// ============================================================================

pub struct ThreatDetectionSystem {
    pub insider_detector: InsiderThreatDetector,
    pub malware_detector: MalwareDetector,
    pub network_detector: NetworkAnomalyDetector,
    pub total_threats: u32,
    pub critical_threats: u32,
}

impl ThreatDetectionSystem {
    pub fn new() -> Self {
        ThreatDetectionSystem {
            insider_detector: InsiderThreatDetector::new(),
            malware_detector: MalwareDetector::new(),
            network_detector: NetworkAnomalyDetector::new(),
            total_threats: 0,
            critical_threats: 0,
        }
    }

    pub fn initialize(&mut self) -> Result<(), String> {
        // Register default users
        self.insider_detector.register_user("user@corp.com".to_string())?;
        self.insider_detector.register_user("admin@corp.com".to_string())?;

        // Register malware signatures
        let ransomware_sig = MalwareSignature::new(
            "Ransomware.Wannacry".to_string(),
            "encrypt_files()".to_string(),
            ThreatLevel::Critical,
        );
        self.malware_detector.register_signature(ransomware_sig)?;

        let trojan_sig = MalwareSignature::new(
            "Trojan.Generic".to_string(),
            "cmd_execute()".to_string(),
            ThreatLevel::High,
        );
        self.malware_detector.register_signature(trojan_sig)?;

        Ok(())
    }

    pub fn print_status(&self) {
        println!("\n╔════════════════════════════════════════════════════╗");
        println!("║         THREAT DETECTION STATUS                    ║");
        println!("╚════════════════════════════════════════════════════╝\n");

        println!("🎯 INSIDER THREATS:");
        println!("   Detected: {}", self.insider_detector.detected_threats.len());

        println!("\n🛑 MALWARE:");
        println!("   Signatures loaded: {}", self.malware_detector.signatures.len());
        println!("   Detections: {}", self.malware_detector.detections.len());

        println!("\n🌐 NETWORK ANOMALIES:");
        println!("   Detected: {}", self.network_detector.anomalies.len());

        println!("\n📊 OVERALL:");
        println!("   Total threats: {}", self.total_threats);
        println!("   Critical threats: {}", self.critical_threats);

        println!("\n");
    }
}

// ============================================================================
// MAIN TEST
// ============================================================================

fn main() -> Result<(), String> {
    println!("=== THREAT DETECTION SYSTEM ===\n");

    let mut system = ThreatDetectionSystem::new();
    system.initialize()?;

    // Test Insider Threat Detection
    println!("--- Insider Threat Detection ---");
    let threat_score = system.insider_detector.detect_insider_threat(
        "user@corp.com",
        22, // 10 PM (outside hours)
        25.0, // 5x typical data access
        500, // 5x typical file ops
        "unknown",
        "unknown_device",
        false,
    )?;
    println!("Threat score: {}\n", threat_score);

    // Test Malware Detection
    println!("--- Malware Detection ---");
    let suspicious_file = "script.exe";
    let file_content = "fn encrypt_files() { /* dangerous */ }";
    system.malware_detector.scan_file(suspicious_file, file_content)?;

    // Test Network Anomaly
    println!("\n--- Network Anomaly Detection ---");
    system.network_detector.check_connection(
        "10.0.0.5",
        "203.0.113.42",
        65432,
    )?;

    system.print_status();

    println!("✓✓✓ Threat Detection System operational ✓✓✓");
    Ok(())
}
