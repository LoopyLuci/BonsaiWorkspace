// OMNISYSTEM CQRS PATTERN SYSTEM
// Command Query Responsibility Segregation
// Separate Read and Write Models, Eventual Consistency, Optimized Performance
// 100% Pure TITAN - Enterprise Grade Architecture Pattern

use omnisystem::{Vec, HashMap, Option, Result, String, Arc, Mutex, i32, i64, f32, bool}

// ============================================================================
// CQRS TYPES
// ============================================================================

pub enum CommandType {
    Create,
    Update,
    Delete,
    Transition,
}

pub struct Command {
    id: String,
    command_type: CommandType,
    aggregate_id: String,
    version: i64,
    data: HashMap<String, String>,
    timestamp: i64,
    user_id: String,
    correlation_id: String,
}

pub struct CommandResult {
    command_id: String,
    success: bool,
    aggregate_id: String,
    version: i64,
    error: Option<String>,
}

pub struct Query {
    id: String,
    query_type: String,
    filters: HashMap<String, String>,
    sort_by: Option<String>,
    page: i32,
    page_size: i32,
    timestamp: i64,
}

pub struct QueryResult {
    query_id: String,
    records: Vec<HashMap<String, String>>,
    total_count: i64,
    execution_time_ms: i64,
}

pub struct WriteModel {
    id: String,
    aggregates: Arc<Mutex<HashMap<String, AggregateWriteState>>>,
    event_log: Arc<Mutex<Vec<Command>>>,
}

pub struct AggregateWriteState {
    id: String,
    version: i64,
    state: HashMap<String, String>,
    last_modified: i64,
}

pub struct ReadModel {
    id: String,
    name: String,
    data: Arc<Mutex<Vec<HashMap<String, String>>>>,
    indexes: Arc<Mutex<HashMap<String, Vec<usize>>>>,  // field -> record indices
    last_updated: i64,
    consistency_lag_ms: i64,
}

pub struct ProjectionSynchronizer {
    write_model_id: String,
    read_models: Vec<String>,
    sync_interval_ms: i32,
    is_syncing: bool,
}

// ============================================================================
// COMMAND HANDLER ACTOR
// ============================================================================

pub actor CommandHandler {
    write_model: WriteModel,
    command_queue: Arc<Mutex<Vec<Command>>>,
    command_results: Arc<Mutex<HashMap<String, CommandResult>>>,

    total_commands: i64 = 0,
    successful_commands: i64 = 0,
    failed_commands: i64 = 0,
    avg_processing_time_ms: i64 = 0,
}

impl CommandHandler {
    message HandleCommand(command: Command) -> Result<CommandResult, String> {
        let start_time = current_time_ms()
        let command_id = command.id.clone()
        let aggregate_id = command.aggregate_id.clone()

        // Validate command
        validate_command(&command)?

        // Get current aggregate state
        let mut aggregates = write_model.aggregates.lock().unwrap()
        let current_version = aggregates.get(&aggregate_id)
            .map(|a| a.version)
            .unwrap_or(0)

        // Verify version (optimistic locking)
        if command.version != current_version {
            return Ok(CommandResult {
                command_id: command_id,
                success: false,
                aggregate_id: aggregate_id,
                version: current_version,
                error: Some("Version conflict - optimistic lock failed".to_string()),
            })
        }

        // Execute command
        match execute_command(&command, &mut aggregates) {
            Ok(new_version) => {
                // Log command to event log
                write_model.event_log.lock().unwrap().push(command.clone())

                self.total_commands += 1
                self.successful_commands += 1

                let processing_time = current_time_ms() - start_time
                self.avg_processing_time_ms = ((self.avg_processing_time_ms * (self.total_commands - 1)) + processing_time) / self.total_commands

                let result = CommandResult {
                    command_id: command_id.clone(),
                    success: true,
                    aggregate_id: aggregate_id,
                    version: new_version,
                    error: None,
                }

                command_results.lock().unwrap().insert(command_id, result.clone())

                Ok(result)
            },
            Err(e) => {
                self.total_commands += 1
                self.failed_commands += 1

                let result = CommandResult {
                    command_id: command_id.clone(),
                    success: false,
                    aggregate_id: aggregate_id,
                    version: current_version,
                    error: Some(e),
                }

                command_results.lock().unwrap().insert(command_id, result.clone())

                Ok(result)
            }
        }
    }

    message GetCommandResult(command_id: String) -> Result<Option<CommandResult>, String> {
        Ok(command_results.lock().unwrap().get(&command_id).cloned())
    }

    message GetWriteModelState(aggregate_id: String) -> Result<Option<AggregateWriteState>, String> {
        Ok(write_model.aggregates.lock().unwrap().get(&aggregate_id).cloned())
    }

    message GetCommandStatistics() -> Result<CommandStatistics, String> {
        Ok(CommandStatistics {
            total_commands: self.total_commands,
            successful_commands: self.successful_commands,
            failed_commands: self.failed_commands,
            success_rate: (self.successful_commands as f32) / (self.total_commands as f32),
            avg_processing_time_ms: self.avg_processing_time_ms,
        })
    }
}

// ============================================================================
// QUERY HANDLER ACTOR
// ============================================================================

pub actor QueryHandler {
    read_models: Arc<Mutex<HashMap<String, ReadModel>>>,
    query_cache: Arc<Mutex<HashMap<String, QueryResult>>>,
    cache_ttl_ms: i32 = 5000,

    total_queries: i64 = 0,
    cache_hits: i64 = 0,
    cache_misses: i64 = 0,
    avg_query_time_ms: i64 = 0,
}

impl QueryHandler {
    message RegisterReadModel(read_model: ReadModel) -> Result<(), String> {
        read_models.lock().unwrap().insert(read_model.id.clone(), read_model)
        Ok(())
    }

    message HandleQuery(query: Query) -> Result<QueryResult, String> {
        let start_time = current_time_ms()
        let query_id = query.id.clone()

        // Check cache first
        let cache = query_cache.lock().unwrap()
        if let Some(cached_result) = cache.get(&query_id) {
            if (current_time_ms() - cached_result.execution_time_ms) < (self.cache_ttl_ms as i64) {
                self.cache_hits += 1
                return Ok(cached_result.clone())
            }
        }

        drop(cache)

        self.cache_misses += 1
        self.total_queries += 1

        // Execute query on read model
        let read_models_lock = read_models.lock().unwrap()

        // Get appropriate read model based on query type
        let read_model = read_models_lock.values().next()
            .ok_or("No read models available".to_string())?

        let records = read_model.data.lock().unwrap().clone()

        // Apply filters
        let mut filtered = records.iter()
            .filter(|record| apply_filters(record, &query.filters))
            .cloned()
            .collect::<Vec<_>>()

        // Apply sorting
        if let Some(sort_field) = &query.sort_by {
            filtered.sort_by(|a, b| {
                let a_val = a.get(sort_field).unwrap_or(&"".to_string())
                let b_val = b.get(sort_field).unwrap_or(&"".to_string())
                a_val.cmp(b_val)
            })
        }

        // Apply pagination
        let total_count = filtered.len() as i64
        let start_idx = ((query.page - 1) * query.page_size) as usize
        let end_idx = (start_idx + query.page_size as usize).min(filtered.len())

        let paginated = filtered[start_idx..end_idx].to_vec()

        let execution_time = current_time_ms() - start_time
        self.avg_query_time_ms = ((self.avg_query_time_ms * (self.total_queries - 1)) + execution_time) / self.total_queries

        let result = QueryResult {
            query_id: query_id.clone(),
            records: paginated,
            total_count: total_count,
            execution_time_ms: execution_time,
        }

        // Cache result
        query_cache.lock().unwrap().insert(query_id, result.clone())

        Ok(result)
    }

    message InvalidateCache(pattern: String) -> Result<i32, String> {
        let mut cache = query_cache.lock().unwrap()

        let before_count = cache.len()
        cache.retain(|k, _| !k.contains(&pattern))
        let after_count = cache.len()

        Ok((before_count - after_count) as i32)
    }

    message GetQueryStatistics() -> Result<QueryStatistics, String> {
        let total_accesses = self.cache_hits + self.cache_misses

        Ok(QueryStatistics {
            total_queries: self.total_queries,
            cache_hits: self.cache_hits,
            cache_misses: self.cache_misses,
            hit_rate: if total_accesses > 0 {
                (self.cache_hits as f32) / (total_accesses as f32)
            } else {
                0.0
            },
            avg_query_time_ms: self.avg_query_time_ms,
        })
    }
}

// ============================================================================
// PROJECTION SYNCHRONIZER ACTOR
// ============================================================================

pub actor ProjectionSynchronizer {
    write_model_id: String,
    read_models: Vec<String>,
    sync_interval_ms: i32 = 1000,
    last_sync_time: i64 = 0,

    total_syncs: i32 = 0,
    successful_syncs: i32 = 0,
    failed_syncs: i32 = 0,
    total_events_synchronized: i64 = 0,
}

impl ProjectionSynchronizer {
    message SynchronizeProjections() -> Result<SynchronizationReport, String> {
        let now = current_time_ms()

        // Only sync if enough time has passed
        if (now - self.last_sync_time) < (self.sync_interval_ms as i64) {
            return Ok(SynchronizationReport {
                syncs_performed: 0,
                events_processed: 0,
                duration_ms: 0,
            })
        }

        self.last_sync_time = now
        self.total_syncs += 1

        let mut total_events = 0i64

        // For each read model, synchronize from write model
        for read_model_id in &self.read_models {
            match synchronize_read_model(&self.write_model_id, read_model_id) {
                Ok(events_count) => {
                    self.successful_syncs += 1
                    total_events += events_count as i64
                },
                Err(_) => {
                    self.failed_syncs += 1
                }
            }
        }

        self.total_events_synchronized += total_events

        Ok(SynchronizationReport {
            syncs_performed: 1,
            events_processed: total_events as i32,
            duration_ms: current_time_ms() - now,
        })
    }

    message GetConsistencyLag() -> Result<ConsistencyMetrics, String> {
        let lag_ms = current_time_ms() - self.last_sync_time

        Ok(ConsistencyMetrics {
            lag_ms: lag_ms,
            is_eventually_consistent: lag_ms > 0,
            last_sync_time: self.last_sync_time,
            total_events_synced: self.total_events_synchronized,
        })
    }

    message GetSynchronizationStatistics() -> Result<SynchronizationStatistics, String> {
        Ok(SynchronizationStatistics {
            total_syncs: self.total_syncs,
            successful_syncs: self.successful_syncs,
            failed_syncs: self.failed_syncs,
            total_events_synchronized: self.total_events_synchronized,
            avg_events_per_sync: if self.total_syncs > 0 {
                (self.total_events_synchronized as i32) / self.total_syncs
            } else {
                0
            },
        })
    }
}

// ============================================================================
// HELPER STRUCTURES
// ============================================================================

pub struct CommandStatistics {
    total_commands: i64,
    successful_commands: i64,
    failed_commands: i64,
    success_rate: f32,
    avg_processing_time_ms: i64,
}

pub struct QueryStatistics {
    total_queries: i64,
    cache_hits: i64,
    cache_misses: i64,
    hit_rate: f32,
    avg_query_time_ms: i64,
}

pub struct SynchronizationReport {
    syncs_performed: i32,
    events_processed: i32,
    duration_ms: i64,
}

pub struct ConsistencyMetrics {
    lag_ms: i64,
    is_eventually_consistent: bool,
    last_sync_time: i64,
    total_events_synced: i64,
}

pub struct SynchronizationStatistics {
    total_syncs: i32,
    successful_syncs: i32,
    failed_syncs: i32,
    total_events_synchronized: i64,
    avg_events_per_sync: i32,
}

pub struct CQRSMetrics {
    write_model_stats: CommandStatistics,
    read_model_stats: QueryStatistics,
    synchronization_stats: SynchronizationStatistics,
    consistency_metrics: ConsistencyMetrics,
}

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================

fn validate_command(command: &Command) -> Result<(), String> {
    if command.aggregate_id.is_empty() {
        return Err("Aggregate ID required".to_string())
    }

    if command.id.is_empty() {
        return Err("Command ID required".to_string())
    }

    Ok(())
}

fn execute_command(
    command: &Command,
    aggregates: &mut HashMap<String, AggregateWriteState>
) -> Result<i64, String> {
    let aggregate_id = command.aggregate_id.clone()
    let current_version = aggregates.get(&aggregate_id)
        .map(|a| a.version)
        .unwrap_or(0)

    let new_version = current_version + 1

    let mut state = aggregates.get(&aggregate_id)
        .map(|a| a.state.clone())
        .unwrap_or_default()

    // Apply command to state
    for (k, v) in &command.data {
        state.insert(k.clone(), v.clone())
    }

    aggregates.insert(aggregate_id, AggregateWriteState {
        id: command.aggregate_id.clone(),
        version: new_version,
        state: state,
        last_modified: current_time_ms(),
    })

    Ok(new_version)
}

fn apply_filters(record: &HashMap<String, String>, filters: &HashMap<String, String>) -> bool {
    for (key, filter_value) in filters {
        if let Some(record_value) = record.get(key) {
            if !record_value.contains(filter_value) {
                return false
            }
        } else {
            return false
        }
    }
    true
}

// File-based event log synchronization: reads serialized commands from
// `omnisystem_cqrs_<write_model_id>.log` and projects them to
// `omnisystem_cqrs_<read_model_id>.proj` as key=value lines.
fn synchronize_read_model(write_model_id: &str, read_model_id: &str) -> Result<i32, String> {
    let event_log_path = format!("omnisystem_cqrs_{}.log", write_model_id)
    let projection_path = format!("omnisystem_cqrs_{}.proj", read_model_id)

    // Read all events from the write model event log file
    let log_bytes = match read_file_bytes(&event_log_path) {
        Ok(b)  => b,
        Err(_) => return Ok(0),  // no log yet — nothing to sync
    }

    // Read current projection watermark (last synced byte offset)
    let watermark: usize = match read_file_bytes(&format!("{}.wm", projection_path)) {
        Ok(wm_bytes) => {
            let s = String::from_utf8_lossy(&wm_bytes);
            s.trim().parse::<usize>().unwrap_or(0)
        },
        Err(_) => 0,
    }

    let new_bytes = &log_bytes[watermark.min(log_bytes.len())..];
    if new_bytes.is_empty() {
        return Ok(0)
    }

    // Parse new event lines — each line: "aggregate_id\tfield=value\tfield=value\n"
    let text = String::from_utf8_lossy(new_bytes)
    let mut events_applied = 0i32

    // Load existing projection
    let mut projection: HashMap<String, String> = HashMap::new()
    if let Ok(proj_bytes) = read_file_bytes(&projection_path) {
        let proj_text = String::from_utf8_lossy(&proj_bytes)
        for line in proj_text.lines() {
            if let Some(eq_pos) = line.find('=') {
                let k = line[..eq_pos].to_string()
                let v = line[eq_pos + 1..].to_string()
                projection.insert(k, v)
            }
        }
    }

    for line in text.lines() {
        if line.is_empty() { continue }
        let mut parts = line.splitn(2, '\t')
        let aggregate_id = match parts.next() {
            Some(id) => id.to_string(),
            None => continue,
        }
        if let Some(fields_str) = parts.next() {
            for kv in fields_str.split('\t') {
                if let Some(eq) = kv.find('=') {
                    let k = format!("{}.{}", aggregate_id, &kv[..eq])
                    let v = kv[eq + 1..].to_string()
                    projection.insert(k, v)
                }
            }
        }
        events_applied += 1
    }

    // Write updated projection
    let mut proj_out = String::new()
    for (k, v) in &projection {
        proj_out.push_str(k)
        proj_out.push('=')
        proj_out.push_str(v)
        proj_out.push('\n')
    }
    write_file_bytes(&projection_path, proj_out.as_bytes())?

    // Update watermark
    let new_watermark = format!("{}", log_bytes.len())
    write_file_bytes(&format!("{}.wm", projection_path), new_watermark.as_bytes())?

    Ok(events_applied)
}

extern "Win32" {
    fn CreateFileA(path: *const u8, access: u32, share: u32, sec: *mut u8, disp: u32, flags: u32, tmpl: *mut u8) -> *mut u8
    fn GetFileSize(h: *mut u8, high: *mut u32) -> u32
    fn ReadFile(h: *mut u8, buf: *mut u8, n: u32, read: *mut u32, ov: *mut u8) -> i32
    fn WriteFile(h: *mut u8, buf: *const u8, n: u32, written: *mut u32, ov: *mut u8) -> i32
    fn CloseHandle(h: *mut u8) -> i32
}
extern "POSIX" {
    fn open_rdonly(path: *const u8) -> i32
    fn open_wronly_creat_trunc(path: *const u8) -> i32
    fn lseek_end(fd: i32) -> i64
    fn lseek_set(fd: i32, off: i64)
    fn read_fd(fd: i32, buf: *mut u8, n: usize) -> isize
    fn write_fd(fd: i32, buf: *const u8, n: usize) -> isize
    fn close_fd(fd: i32)
}

fn read_file_bytes(path: &str) -> Result<Vec<u8>, String> {
    let path_bytes: Vec<u8> = path.bytes().chain(std::iter::once(0u8)).collect()
    #[cfg(target_os = "windows")]
    unsafe {
        let h = CreateFileA(path_bytes.as_ptr(), 0x80000000u32, 1, std::ptr::null_mut(), 3, 0x80, std::ptr::null_mut())
        if h as usize == usize::MAX { return Err("open failed".to_string()) }
        let sz = GetFileSize(h, std::ptr::null_mut()) as usize
        let mut buf = vec![0u8; sz]
        let mut nread = 0u32
        ReadFile(h, buf.as_mut_ptr(), sz as u32, &mut nread, std::ptr::null_mut())
        CloseHandle(h)
        buf.truncate(nread as usize)
        Ok(buf)
    }
    #[cfg(not(target_os = "windows"))]
    unsafe {
        let fd = open_rdonly(path_bytes.as_ptr())
        if fd < 0 { return Err("open failed".to_string()) }
        let sz = lseek_end(fd) as usize
        lseek_set(fd, 0)
        let mut buf = vec![0u8; sz]
        let n = read_fd(fd, buf.as_mut_ptr(), sz)
        close_fd(fd)
        if n < 0 { return Err("read failed".to_string()) }
        buf.truncate(n as usize)
        Ok(buf)
    }
}

fn write_file_bytes(path: &str, data: &[u8]) -> Result<(), String> {
    let path_bytes: Vec<u8> = path.bytes().chain(std::iter::once(0u8)).collect()
    #[cfg(target_os = "windows")]
    unsafe {
        let h = CreateFileA(path_bytes.as_ptr(), 0x40000000u32, 0, std::ptr::null_mut(), 2, 0x80, std::ptr::null_mut())
        if h as usize == usize::MAX { return Err("create failed".to_string()) }
        let mut nwritten = 0u32
        WriteFile(h, data.as_ptr(), data.len() as u32, &mut nwritten, std::ptr::null_mut())
        CloseHandle(h)
        Ok(())
    }
    #[cfg(not(target_os = "windows"))]
    unsafe {
        let fd = open_wronly_creat_trunc(path_bytes.as_ptr())
        if fd < 0 { return Err("create failed".to_string()) }
        write_fd(fd, data.as_ptr(), data.len())
        close_fd(fd)
        Ok(())
    }
}


extern "Win32"  { fn GetTickCount64() -> u64 }
extern "POSIX"  { fn clock_gettime_mono(out_sec: *mut i64, out_nsec: *mut i64) -> i32 }

fn current_time_ms() -> i64 {
    #[cfg(target_os = "windows")]
    { return unsafe { GetTickCount64() } as i64 }
    #[cfg(not(target_os = "windows"))]
    { let mut s = 0i64; let mut n = 0i64; unsafe { clock_gettime_mono(&mut s, &mut n) }; s * 1000 + n / 1_000_000 }
}
