// Transaction Manager
// ACID transaction coordination
// System 65

use omnisystem::{HashMap, Vec, String, Option, Result}

struct Transaction {
    id: String,
    status: String,
    operations: Vec<String>
}

actor TransactionManager {
    transactions: HashMap<String, Transaction> = HashMap::new(),
    active_count: i32 = 0

    message BeginTransaction() -> Result<String, String> {
        let tx = Transaction {
            id: "tx_".to_string() + &(transactions.len() as u32).to_string(),
            status: "active".to_string(),
            operations: Vec::new()
        }
        let tx_id = tx.id.clone()
        transactions.insert(tx_id.clone(), tx)
        active_count = active_count + 1
        println("TransactionManager: Started transaction {}", tx_id)
        Ok(tx_id)
    }

    message AddOperation(tx_id: String, operation: String) -> Result<(), String> {
        match transactions.get_mut(&tx_id) {
            Some(tx) => {
                tx.operations.push(operation)
                Ok(())
            },
            None => Err("Transaction not found".to_string())
        }
    }

    message CommitTransaction(tx_id: String) -> Result<(), String> {
        match transactions.get_mut(&tx_id) {
            Some(tx) => {
                tx.status = "committed".to_string()
                active_count = active_count - 1
                println("TransactionManager: Committed transaction {}", tx_id)
                Ok(())
            },
            None => Err("Transaction not found".to_string())
        }
    }

    message GetActiveCount() -> i32 {
        active_count
    }
}

async fn test_transaction_manager() -> Result<(), String> {
    let tm: ActorRef<TransactionManager> = spawn(TransactionManager {
        transactions: HashMap::new(),
        active_count: 0
    })

    let tx1 = await tm.call(TransactionManager::BeginTransaction())?
    await tm.call(TransactionManager::AddOperation(tx1.clone(), "insert".to_string()))?
    await tm.call(TransactionManager::CommitTransaction(tx1))?

    Ok(())
}
