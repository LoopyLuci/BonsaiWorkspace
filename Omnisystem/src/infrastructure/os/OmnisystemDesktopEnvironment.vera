                ethernet_enabled: true,
                bluetooth_enabled: true,
                dns_servers: vec!["8.8.8.8".to_string(), "8.8.4.4".to_string()],
            },
            about: SystemInfo {
                os_name: "Omnisystem".to_string(),
                os_version: "3.0".to_string(),
                kernel_version: "6.0".to_string(),
                system_uptime_seconds: 0,
                total_memory_gb: 16,
