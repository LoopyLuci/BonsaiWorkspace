                cpu_cores: 8,
                cpu_model: "Intel Core i7".to_string(),
            },
        },
        theme: Theme {
            theme_id: "omnisystem-dark-1".to_string(),
            theme_name: "Omnisystem Dark".to_string(),
            primary_color: Color { r: 25, g: 118, b: 210, a: 255 },
            secondary_color: Color { r: 67, g: 160, b: 71, a: 255 },
            background_color: Color { r: 18, g: 18, b: 18, a: 255 },
            text_color: Color { r: 255, g: 255, b: 255, a: 255 },
            accent_color: Color { r: 255, g: 87, b: 34, a: 255 },
            dark_mode: true,
            font_family: "Roboto".to_string(),
