    println!("╔═══════════════════════════════════════════════════════════════╗");
    println!("║  OMNISYSTEM DESKTOP ENVIRONMENT v2.0.0                       ║");
    println!("║      Complete Graphical Desktop Shell & Environment           ║");
    println!("╚═══════════════════════════════════════════════════════════════╝\n");

    let mut desktop = OmnisystemDesktop {
