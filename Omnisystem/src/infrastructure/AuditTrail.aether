// Audit Trail
// Comprehensive action logging for compliance
// System 72

use omnisystem::{HashMap, Vec, String, Option, Result}

struct AuditLog {
    id: String,
    actor: String,
    action: String,
    resource: String,
    timestamp: i64,
    details: String
}

actor AuditTrail {
    logs: Vec<AuditLog> = Vec::new(),
    by_actor: HashMap<String, Vec<String>> = HashMap::new()

    message LogAction(actor: String, action: String, resource: String, details: String) -> Result<String, String> {
        let log = AuditLog {
            id: "audit_".to_string() + &(logs.len() as u32).to_string(),
            actor: actor.clone(),
            action: action.clone(),
            resource: resource.clone(),
            timestamp: SystemTime::now().secs(),
            details: details
        }

        let log_id = log.id.clone()
        logs.push(log)

        match by_actor.get_mut(&actor) {
            Some(ids) => ids.push(log_id.clone()),
            None => {
                let mut ids = Vec::new()
                ids.push(log_id.clone())
                by_actor.insert(actor, ids)
            }
        }

        Ok(log_id)
    }

    message QueryByActor(actor: String) -> Result<i32, String> {
        match by_actor.get(&actor) {
            Some(ids) => Ok(ids.len() as i32),
            None => Ok(0)
        }
    }

    message GetLogCount() -> i32 {
        logs.len() as i32
    }
}

async fn test_audit_trail() -> Result<(), String> {
    let trail: ActorRef<AuditTrail> = spawn(AuditTrail {
        logs: Vec::new(),
        by_actor: HashMap::new()
    })

    await trail.call(AuditTrail::LogAction("user1".to_string(), "DELETE".to_string(), "user:2".to_string(), "Deleted user".to_string()))?
    await trail.call(AuditTrail::LogAction("user1".to_string(), "CREATE".to_string(), "role:admin".to_string(), "Created role".to_string()))?

    let user1_actions = await trail.call(AuditTrail::QueryByActor("user1".to_string()))?
    println("User1 actions: {}", user1_actions)

    Ok(())
}
