// DNS Resolver
// Domain name resolution and caching
// System 57

use omnisystem::{HashMap, Vec, String, Option, Result}

struct DNSRecord {
    domain: String,
    ip_address: String,
    ttl: i64,
    created_at: i64
}

struct DNSResolver {
    cache: HashMap<String, DNSRecord>
}

impl DNSResolver {
    fn new() -> Self {
        return DNSResolver {
            cache: HashMap::new()
        }
    }

    fn resolve(&mut self, domain: String) -> Result<String, String> {
        match self.cache.get(&domain) {
            Some(record) => {
                println("DNSResolver: Cache hit for {}", domain)
                Ok(record.ip_address.clone())
            },
            None => {
                let record = DNSRecord {
                    domain: domain.clone(),
                    ip_address: "192.168.1.1".to_string(),
                    ttl: 3600,
                    created_at: SystemTime::now().secs()
                }
                let ip = record.ip_address.clone()
                self.cache.insert(domain.clone(), record)
                println("DNSResolver: Resolved {} to {}", domain, ip)
                Ok(ip)
            }
        }
    }

    fn clear_cache(&mut self) -> Result<(), String> {
        self.cache.clear()
        println("DNSResolver: Cache cleared")
        Ok(())
    }

    fn get_cache_size(&self) -> i32 {
        return self.cache.len() as i32
    }
}

fn test_dns_resolver() -> Result<(), String> {
    let mut resolver = DNSResolver::new()

    let ip1 = resolver.resolve("example.com".to_string())?
    let ip2 = resolver.resolve("example.com".to_string())?

    println("Cache size: {}", resolver.get_cache_size())
    Ok(())
}
