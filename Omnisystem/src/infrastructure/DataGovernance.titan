// Data Governance
// Data quality, lineage, and masking
// System 74

use omnisystem::{HashMap, Vec, String, Option, Result}

struct DataAsset {
    id: String,
    owner: String,
    classification: String,
    is_sensitive: bool
}

struct DataGovernance {
    assets: HashMap<String, DataAsset>,
    data_lineage: HashMap<String, Vec<String>>
}

impl DataGovernance {
    fn new() -> Self {
        return DataGovernance {
            assets: HashMap::new(),
            data_lineage: HashMap::new()
        }
    }

    fn register_asset(&mut self, id: String, owner: String, classification: String) -> Result<(), String> {
        let asset = DataAsset {
            id: id.clone(),
            owner: owner,
            classification: classification,
            is_sensitive: false
        }
        self.assets.insert(id.clone(), asset)
        println("DataGovernance: Registered asset {}", id)
        Ok(())
    }

    fn mark_sensitive(&mut self, asset_id: String) -> Result<(), String> {
        match self.assets.get_mut(&asset_id) {
            Some(asset) => {
                asset.is_sensitive = true
                println("DataGovernance: Marked {} as sensitive", asset_id)
                Ok(())
            },
            None => Err("Asset not found".to_string())
        }
    }

    fn get_asset_count(&self) -> i32 {
        return self.assets.len() as i32
    }
}

fn test_data_governance() -> Result<(), String> {
    let mut dg = DataGovernance::new()

    dg.register_asset("customer_data".to_string(), "data_team".to_string(), "confidential".to_string())?
    dg.register_asset("public_data".to_string(), "marketing".to_string(), "public".to_string())?

    dg.mark_sensitive("customer_data".to_string())?

    println("Assets: {}", dg.get_asset_count())
    Ok(())
}
