// MVCC
// Multi-version concurrency control
// System 66

use omnisystem::{HashMap, Vec, String, Option, Result}

struct Version {
    version_id: i32,
    data: Vec<u8>,
    creator_tx: String
}

struct MVCCRecord {
    key: String,
    versions: Vec<Version>
}

struct MVCCEngine {
    records: HashMap<String, MVCCRecord>,
    next_version: i32
}

impl MVCCEngine {
    fn new() -> Self {
        return MVCCEngine {
            records: HashMap::new(),
            next_version: 1
        }
    }

    fn write(&mut self, key: String, data: Vec<u8>, tx_id: String) -> Result<(), String> {
        let version = Version {
            version_id: self.next_version,
            data: data,
            creator_tx: tx_id
        }
        self.next_version = self.next_version + 1

        match self.records.get_mut(&key) {
            Some(record) => {
                record.versions.push(version)
                Ok(())
            },
            None => {
                let mut record = MVCCRecord {
                    key: key.clone(),
                    versions: Vec::new()
                }
                record.versions.push(version)
                self.records.insert(key, record)
                Ok(())
            }
        }
    }

    fn read(&self, key: String, version: i32) -> Result<Vec<u8>, String> {
        match self.records.get(&key) {
            Some(record) => {
                for v in &record.versions {
                    if v.version_id == version {
                        return Ok(v.data.clone())
                    }
                }
                Err("Version not found".to_string())
            },
            None => Err("Key not found".to_string())
        }
    }
}

fn test_mvcc() -> Result<(), String> {
    let mut mvcc = MVCCEngine::new()

    mvcc.write("key1".to_string(), b"value1".to_vec(), "tx1".to_string())?
    mvcc.write("key1".to_string(), b"value2".to_vec(), "tx2".to_string())?

    let data = mvcc.read("key1".to_string(), 1)?
    println("Read version 1: {} bytes", data.len())

    Ok(())
}
