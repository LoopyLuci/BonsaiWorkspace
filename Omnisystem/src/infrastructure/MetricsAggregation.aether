// Metrics Aggregation
// Multi-metric collection and aggregation
// System 50

use omnisystem::{HashMap, Vec, String, Option, Result}

struct Metric {
    name: String,
    value: f64,
    timestamp: i64,
    tags: Vec<String>
}

actor MetricsAggregator {
    metrics: Vec<Metric> = Vec::new(),
    aggregates: HashMap<String, f64> = HashMap::new()

    message RecordMetric(name: String, value: f64, tags: Vec<String>) -> Result<(), String> {
        let metric = Metric {
            name: name.clone(),
            value: value,
            timestamp: SystemTime::now().secs(),
            tags: tags
        }
        metrics.push(metric)
        println("MetricsAggregator: Recorded {} = {}", name, value)
        Ok(())
    }

    message AggregateSum(metric_name: String) -> Result<f64, String> {
        let mut sum = 0.0
        for m in &metrics {
            if m.name == metric_name {
                sum = sum + m.value
            }
        }
        Ok(sum)
    }

    message AggregateAvg(metric_name: String) -> Result<f64, String> {
        let mut sum = 0.0
        let mut count = 0
        for m in &metrics {
            if m.name == metric_name {
                sum = sum + m.value
                count = count + 1
            }
        }
        if count == 0 {
            return Err("No metrics found".to_string())
        }
        Ok(sum / (count as f64))
    }

    message GetMetricCount() -> i32 {
        metrics.len() as i32
    }
}

async fn test_metrics_aggregation() -> Result<(), String> {
    let agg: ActorRef<MetricsAggregator> = spawn(MetricsAggregator {
        metrics: Vec::new(),
        aggregates: HashMap::new()
    })

    await agg.call(MetricsAggregator::RecordMetric("latency".to_string(), 45.5, vec![]))?
    await agg.call(MetricsAggregator::RecordMetric("latency".to_string(), 52.3, vec![]))?
    await agg.call(MetricsAggregator::RecordMetric("latency".to_string(), 48.9, vec![]))?

    let total = await agg.call(MetricsAggregator::AggregateSum("latency".to_string()))?
    let avg = await agg.call(MetricsAggregator::AggregateAvg("latency".to_string()))?
    println("Total: {}, Avg: {}", total, avg)

    Ok(())
}
