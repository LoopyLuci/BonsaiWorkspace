// Permission System
// Role-based access control
// System 71

use omnisystem::{HashMap, Vec, String, Option, Result}

struct Permission {
    name: String,
    resource: String
}

struct Role {
    name: String,
    permissions: Vec<Permission>
}

struct PermissionSystem {
    roles: HashMap<String, Role>,
    user_roles: HashMap<String, Vec<String>>
}

impl PermissionSystem {
    fn new() -> Self {
        return PermissionSystem {
            roles: HashMap::new(),
            user_roles: HashMap::new()
        }
    }

    fn create_role(&mut self, role_name: String) -> Result<(), String> {
        let role = Role {
            name: role_name.clone(),
            permissions: Vec::new()
        }
        self.roles.insert(role_name.clone(), role)
        println("PermissionSystem: Created role {}", role_name)
        Ok(())
    }

    fn grant_permission(&mut self, role_name: String, resource: String, action: String) -> Result<(), String> {
        match self.roles.get_mut(&role_name) {
            Some(role) => {
                let perm = Permission {
                    name: action,
                    resource: resource
                }
                role.permissions.push(perm)
                Ok(())
            },
            None => Err("Role not found".to_string())
        }
    }

    fn assign_user_role(&mut self, user_id: String, role_name: String) -> Result<(), String> {
        match self.user_roles.get_mut(&user_id) {
            Some(roles) => {
                roles.push(role_name)
                Ok(())
            },
            None => {
                let mut roles = Vec::new()
                roles.push(role_name)
                self.user_roles.insert(user_id, roles)
                Ok(())
            }
        }
    }

    fn get_role_count(&self) -> i32 {
        return self.roles.len() as i32
    }
}

fn test_permission_system() -> Result<(), String> {
    let mut ps = PermissionSystem::new()

    ps.create_role("admin".to_string())?
    ps.create_role("user".to_string())?
    ps.grant_permission("admin".to_string(), "users".to_string(), "delete".to_string())?
    ps.assign_user_role("alice".to_string(), "admin".to_string())?

    println("Roles: {}", ps.get_role_count())
    Ok(())
}
