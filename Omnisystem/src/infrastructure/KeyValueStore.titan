// Key-Value Store
// High-performance KV storage
// System 61

use omnisystem::{HashMap, Vec, String, Option, Result}

struct KeyValueStore {
    data: HashMap<String, Vec<u8>>,
    access_count: HashMap<String, i32>
}

impl KeyValueStore {
    fn new() -> Self {
        return KeyValueStore {
            data: HashMap::new(),
            access_count: HashMap::new()
        }
    }

    fn set(&mut self, key: String, value: Vec<u8>) -> Result<(), String> {
        self.data.insert(key.clone(), value)
        println("KeyValueStore: Set {}", key)
        Ok(())
    }

    fn get(&mut self, key: String) -> Result<Vec<u8>, String> {
        match self.data.get(&key) {
            Some(value) => {
                match self.access_count.get_mut(&key) {
                    Some(count) => *count = *count + 1,
                    None => { self.access_count.insert(key.clone(), 1); }
                }
                Ok(value.clone())
            },
            None => Err("Key not found".to_string())
        }
    }

    fn delete(&mut self, key: String) -> Result<(), String> {
        match self.data.remove(&key) {
            Some(_) => {
                println("KeyValueStore: Deleted {}", key)
                Ok(())
            },
            None => Err("Key not found".to_string())
        }
    }

    fn get_size(&self) -> i32 {
        return self.data.len() as i32
    }
}

fn test_key_value_store() -> Result<(), String> {
    let mut store = KeyValueStore::new()

    store.set("key1".to_string(), b"value1".to_vec())?
    store.set("key2".to_string(), b"value2".to_vec())?

    let val = store.get("key1".to_string())?
    println("Retrieved {} bytes", val.len())

    println("Store size: {}", store.get_size())
    Ok(())
}
