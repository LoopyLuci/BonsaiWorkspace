// Lock Manager
// Pessimistic locking for concurrent access
// System 67

use omnisystem::{HashMap, Vec, String, Option, Result}

struct LockInfo {
    resource: String,
    holder: String,
    lock_type: String
}

actor LockManager {
    locks: HashMap<String, LockInfo> = HashMap::new(),
    waiters: HashMap<String, Vec<String>> = HashMap::new()

    message AcquireLock(resource: String, holder: String, lock_type: String) -> Result<(), String> {
        if locks.contains_key(&resource) {
            match waiters.get_mut(&resource) {
                Some(w) => {
                    w.push(holder.clone())
                },
                None => {
                    let mut w = Vec::new()
                    w.push(holder)
                    waiters.insert(resource.clone(), w)
                }
            }
            return Err("Resource locked".to_string())
        }

        let lock = LockInfo {
            resource: resource.clone(),
            holder: holder.clone(),
            lock_type: lock_type
        }
        locks.insert(resource.clone(), lock)
        println("LockManager: Acquired lock on {} by {}", resource, holder)
        Ok(())
    }

    message ReleaseLock(resource: String) -> Result<(), String> {
        match locks.remove(&resource) {
            Some(_) => {
                println("LockManager: Released lock on {}", resource)
                Ok(())
            },
            None => Err("No lock found".to_string())
        }
    }

    message GetLockCount() -> i32 {
        locks.len() as i32
    }
}

async fn test_lock_manager() -> Result<(), String> {
    let lm: ActorRef<LockManager> = spawn(LockManager {
        locks: HashMap::new(),
        waiters: HashMap::new()
    })

    await lm.call(LockManager::AcquireLock("resource1".to_string(), "tx1".to_string(), "exclusive".to_string()))?
    await lm.call(LockManager::ReleaseLock("resource1".to_string()))?

    Ok(())
}
