// Log Aggregation
// Centralized log collection and indexing
// System 51

use omnisystem::{HashMap, Vec, String, Option, Result}

struct LogEntry {
    id: String,
    source: String,
    level: String,
    message: String,
    timestamp: i64
}

actor LogAggregator {
    logs: Vec<LogEntry> = Vec::new(),
    by_level: HashMap<String, Vec<String>> = HashMap::new()

    message AppendLog(source: String, level: String, message: String) -> Result<String, String> {
        let entry = LogEntry {
            id: "log_".to_string() + &SystemTime::now().secs().to_string(),
            source: source.clone(),
            level: level.clone(),
            message: message.clone(),
            timestamp: SystemTime::now().secs()
        }

        let entry_id = entry.id.clone()
        logs.push(entry)

        match by_level.get_mut(&level) {
            Some(ids) => ids.push(entry_id.clone()),
            None => {
                let mut ids = Vec::new()
                ids.push(entry_id.clone())
                by_level.insert(level, ids)
            }
        }

        println("LogAggregator: [{}] {} - {}", level, source, message)
        Ok(entry_id)
    }

    message QueryByLevel(level: String) -> Result<i32, String> {
        match by_level.get(&level) {
            Some(ids) => Ok(ids.len() as i32),
            None => Ok(0)
        }
    }

    message GetLogCount() -> i32 {
        logs.len() as i32
    }
}

async fn test_log_aggregation() -> Result<(), String> {
    let agg: ActorRef<LogAggregator> = spawn(LogAggregator {
        logs: Vec::new(),
        by_level: HashMap::new()
    })

    await agg.call(LogAggregator::AppendLog("api_server".to_string(), "INFO".to_string(), "Server started".to_string()))?
    await agg.call(LogAggregator::AppendLog("db_client".to_string(), "ERROR".to_string(), "Connection failed".to_string()))?
    await agg.call(LogAggregator::AppendLog("api_server".to_string(), "WARN".to_string(), "Slow query detected".to_string()))?

    let error_count = await agg.call(LogAggregator::QueryByLevel("ERROR".to_string()))?
    let total = await agg.call(LogAggregator::GetLogCount())?
    println("Errors: {}, Total logs: {}", error_count, total)

    Ok(())
}
