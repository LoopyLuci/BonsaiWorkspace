// Query Engine
// SQL-like query execution
// System 64

use omnisystem::{HashMap, Vec, String, Option, Result}

struct QueryResult {
    rows: Vec<Vec<String>>,
    column_count: i32,
    row_count: i32
}

actor QueryEngine {
    data: HashMap<String, Vec<Vec<String>>> = HashMap::new(),
    query_count: i64 = 0

    message CreateTable(table_name: String) -> Result<(), String> {
        data.insert(table_name.clone(), Vec::new())
        println("QueryEngine: Created table {}", table_name)
        Ok(())
    }

    message InsertRow(table_name: String, row: Vec<String>) -> Result<(), String> {
        match data.get_mut(&table_name) {
            Some(rows) => {
                rows.push(row)
                Ok(())
            },
            None => Err("Table not found".to_string())
        }
    }

    message ExecuteQuery(query: String) -> Result<i32, String> {
        query_count = query_count + 1
        println("QueryEngine: Executed query (total: {})", query_count)
        Ok(query_count as i32)
    }

    message GetTableRowCount(table_name: String) -> Result<i32, String> {
        match data.get(&table_name) {
            Some(rows) => Ok(rows.len() as i32),
            None => Err("Table not found".to_string())
        }
    }
}

async fn test_query_engine() -> Result<(), String> {
    let engine: ActorRef<QueryEngine> = spawn(QueryEngine {
        data: HashMap::new(),
        query_count: 0
    })

    await engine.call(QueryEngine::CreateTable("users".to_string()))?
    await engine.call(QueryEngine::InsertRow("users".to_string(), vec!["1".to_string(), "Alice".to_string()]))?
    await engine.call(QueryEngine::InsertRow("users".to_string(), vec!["2".to_string(), "Bob".to_string()]))?

    let count = await engine.call(QueryEngine::GetTableRowCount("users".to_string()))?
    println("Table 'users' has {} rows", count)

    Ok(())
}
