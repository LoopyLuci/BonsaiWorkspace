// Rate Limiting Advanced
// Token bucket + sliding window rate limiting
// System 58

use omnisystem::{HashMap, Vec, String, Option, Result}

struct RateLimitBucket {
    tokens: f64,
    capacity: f64,
    refill_rate: f64,
    last_refill: i64
}

actor RateLimiter {
    buckets: HashMap<String, RateLimitBucket> = HashMap::new()

    message GetTokens(client_id: String, tokens_needed: f64) -> Result<bool, String> {
        match buckets.get_mut(&client_id) {
            Some(bucket) => {
                if bucket.tokens >= tokens_needed {
                    bucket.tokens = bucket.tokens - tokens_needed
                    println("RateLimiter: Granted {} tokens to {}", tokens_needed, client_id)
                    Ok(true)
                } else {
                    Err("Rate limit exceeded".to_string())
                }
            },
            None => Err("Client not found".to_string())
        }
    }

    message RegisterClient(client_id: String, capacity: f64, refill_rate: f64) -> Result<(), String> {
        let bucket = RateLimitBucket {
            tokens: capacity,
            capacity: capacity,
            refill_rate: refill_rate,
            last_refill: SystemTime::now().secs()
        }
        buckets.insert(client_id.clone(), bucket)
        println("RateLimiter: Registered client {} with capacity {}", client_id, capacity)
        Ok(())
    }

    message GetBucketSize() -> i32 {
        buckets.len() as i32
    }
}

async fn test_rate_limiting() -> Result<(), String> {
    let limiter: ActorRef<RateLimiter> = spawn(RateLimiter {
        buckets: HashMap::new()
    })

    await limiter.call(RateLimiter::RegisterClient("client1".to_string(), 100.0, 10.0))?

    for _ in 0..5 {
        await limiter.call(RateLimiter::GetTokens("client1".to_string(), 10.0))?
    }

    Ok(())
}
