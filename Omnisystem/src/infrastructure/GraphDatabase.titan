// Graph Database
// Graph storage with traversal
// System 59

use omnisystem::{HashMap, Vec, String, Option, Result}

struct Node {
    id: String,
    label: String,
    properties: HashMap<String, String>
}

struct Edge {
    from: String,
    to: String,
    rel_type: String
}

struct GraphDatabase {
    nodes: HashMap<String, Node>,
    edges: Vec<Edge>
}

impl GraphDatabase {
    fn new() -> Self {
        return GraphDatabase {
            nodes: HashMap::new(),
            edges: Vec::new()
        }
    }

    fn add_node(&mut self, id: String, label: String) -> Result<(), String> {
        let node = Node {
            id: id.clone(),
            label: label.clone(),
            properties: HashMap::new()
        }
        self.nodes.insert(id.clone(), node)
        println("GraphDatabase: Added node {}", id)
        Ok(())
    }

    fn add_edge(&mut self, from: String, to: String, rel_type: String) -> Result<(), String> {
        let edge = Edge {
            from: from,
            to: to,
            rel_type: rel_type
        }
        self.edges.push(edge)
        println("GraphDatabase: Added edge")
        Ok(())
    }

    fn get_neighbors(&self, node_id: String) -> Result<Vec<String>, String> {
        let mut neighbors = Vec::new()
        for edge in &self.edges {
            if edge.from == node_id {
                neighbors.push(edge.to.clone())
            }
        }
        Ok(neighbors)
    }

    fn get_node_count(&self) -> i32 {
        return self.nodes.len() as i32
    }
}

fn test_graph_database() -> Result<(), String> {
    let mut db = GraphDatabase::new()

    db.add_node("user1".to_string(), "User".to_string())?
    db.add_node("user2".to_string(), "User".to_string())?
    db.add_edge("user1".to_string(), "user2".to_string(), "follows".to_string())?

    let neighbors = db.get_neighbors("user1".to_string())?
    println("User1 neighbors: {}", neighbors.len())

    Ok(())
}
