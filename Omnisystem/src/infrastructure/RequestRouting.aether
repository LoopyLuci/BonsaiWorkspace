// Request Routing
// Dynamic request routing and load balancing
// System 56

use omnisystem::{HashMap, Vec, String, Option, Result}

struct Route {
    id: String,
    pattern: String,
    target: String,
    weight: i32
}

actor RequestRouter {
    routes: Vec<Route> = Vec::new(),
    request_count: i64 = 0

    message AddRoute(pattern: String, target: String, weight: i32) -> Result<String, String> {
        let route = Route {
            id: "route_".to_string() + &(routes.len() as u32).to_string(),
            pattern: pattern,
            target: target,
            weight: weight
        }
        let route_id = route.id.clone()
        routes.push(route)
        println("RequestRouter: Added route {} -> target", route_id)
        Ok(route_id)
    }

    message RouteRequest(path: String) -> Result<String, String> {
        request_count = request_count + 1

        for route in &routes {
            if path.contains(&route.pattern) {
                println("RequestRouter: Route {} to {}", path, route.target)
                return Ok(route.target.clone())
            }
        }

        Err("No matching route".to_string())
    }

    message GetRouteCount() -> i32 {
        routes.len() as i32
    }

    message GetRequestCount() -> i64 {
        request_count
    }
}

async fn test_request_routing() -> Result<(), String> {
    let router: ActorRef<RequestRouter> = spawn(RequestRouter {
        routes: Vec::new(),
        request_count: 0
    })

    await router.call(RequestRouter::AddRoute("/api".to_string(), "api_server".to_string(), 1))?
    await router.call(RequestRouter::AddRoute("/static".to_string(), "cdn".to_string(), 1))?

    let target1 = await router.call(RequestRouter::RouteRequest("/api/users".to_string()))?
    let target2 = await router.call(RequestRouter::RouteRequest("/static/index.html".to_string()))?

    let count = await router.call(RequestRouter::GetRequestCount())?
    println("Routed {} requests", count)

    Ok(())
}
