// Index Management
// B-tree and hash index creation/maintenance
// System 63

use omnisystem::{HashMap, Vec, String, Option, Result}

struct Index {
    name: String,
    index_type: String,
    columns: Vec<String>,
    entries: i64
}

struct IndexManager {
    indexes: HashMap<String, Index>
}

impl IndexManager {
    fn new() -> Self {
        return IndexManager {
            indexes: HashMap::new()
        }
    }

    fn create_index(&mut self, name: String, index_type: String, columns: Vec<String>) -> Result<(), String> {
        let index = Index {
            name: name.clone(),
            index_type: index_type,
            columns: columns,
            entries: 0
        }
        self.indexes.insert(name.clone(), index)
        println("IndexManager: Created index {}", name)
        Ok(())
    }

    fn insert_entry(&mut self, index_name: String) -> Result<(), String> {
        match self.indexes.get_mut(&index_name) {
            Some(idx) => {
                idx.entries = idx.entries + 1
                Ok(())
            },
            None => Err("Index not found".to_string())
        }
    }

    fn get_index_size(&self, index_name: String) -> Result<i64, String> {
        match self.indexes.get(&index_name) {
            Some(idx) => Ok(idx.entries),
            None => Err("Index not found".to_string())
        }
    }

    fn get_index_count(&self) -> i32 {
        return self.indexes.len() as i32
    }
}

fn test_index_management() -> Result<(), String> {
    let mut mgr = IndexManager::new()

    mgr.create_index("idx_user_id".to_string(), "btree".to_string(), vec!["user_id".to_string()])?
    mgr.create_index("idx_email".to_string(), "hash".to_string(), vec!["email".to_string()])?

    for _ in 0..100 {
        mgr.insert_entry("idx_user_id".to_string())?
    }

    let size = mgr.get_index_size("idx_user_id".to_string())?
    println("Index size: {}", size)

    Ok(())
}
