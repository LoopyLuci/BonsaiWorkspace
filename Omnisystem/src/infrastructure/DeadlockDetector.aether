// Deadlock Detector
// Wait-for graph based deadlock detection
// System 68

use omnisystem::{HashMap, Vec, String, Option, Result}

struct Waiter {
    waiter_tx: String,
    holder_tx: String
}

actor DeadlockDetector {
    wait_graph: Vec<Waiter> = Vec::new(),
    detected_count: i32 = 0

    message AddWaitEdge(waiter: String, holder: String) -> Result<(), String> {
        let edge = Waiter {
            waiter_tx: waiter,
            holder_tx: holder
        }
        wait_graph.push(edge)
        Ok(())
    }

    message DetectCycle() -> Result<bool, String> {
        let mut has_cycle = false
        for waiter in &wait_graph {
            for other in &wait_graph {
                if waiter.holder_tx == other.waiter_tx && other.holder_tx == waiter.waiter_tx {
                    has_cycle = true
                }
            }
        }

        if has_cycle {
            detected_count = detected_count + 1
            println("DeadlockDetector: Detected cycle (total: {})", detected_count)
        }

        Ok(has_cycle)
    }

    message GetDetectedCount() -> i32 {
        detected_count
    }
}

async fn test_deadlock_detector() -> Result<(), String> {
    let dd: ActorRef<DeadlockDetector> = spawn(DeadlockDetector {
        wait_graph: Vec::new(),
        detected_count: 0
    })

    await dd.call(DeadlockDetector::AddWaitEdge("tx1".to_string(), "tx2".to_string()))?
    await dd.call(DeadlockDetector::AddWaitEdge("tx2".to_string(), "tx1".to_string()))?

    let has_cycle = await dd.call(DeadlockDetector::DetectCycle())?
    println("Cycle detected: {}", has_cycle)

    Ok(())
}
