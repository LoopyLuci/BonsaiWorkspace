// Document Store
// Semi-structured document storage
// System 60

use omnisystem::{HashMap, Vec, String, Option, Result}

struct Document {
    id: String,
    content: String,
    version: i32,
    tags: Vec<String>
}

struct DocumentStore {
    documents: HashMap<String, Document>
}

impl DocumentStore {
    fn new() -> Self {
        return DocumentStore {
            documents: HashMap::new()
        }
    }

    fn insert_doc(&mut self, id: String, content: String, tags: Vec<String>) -> Result<(), String> {
        let doc = Document {
            id: id.clone(),
            content: content,
            version: 1,
            tags: tags
        }
        self.documents.insert(id.clone(), doc)
        println("DocumentStore: Inserted document {}", id)
        Ok(())
    }

    fn get_doc(&self, id: String) -> Result<String, String> {
        match self.documents.get(&id) {
            Some(doc) => Ok(doc.content.clone()),
            None => Err("Document not found".to_string())
        }
    }

    fn update_doc(&mut self, id: String, content: String) -> Result<(), String> {
        match self.documents.get_mut(&id) {
            Some(doc) => {
                doc.content = content
                doc.version = doc.version + 1
                println("DocumentStore: Updated document {} (v{})", id, doc.version)
                Ok(())
            },
            None => Err("Document not found".to_string())
        }
    }

    fn get_doc_count(&self) -> i32 {
        return self.documents.len() as i32
    }
}

fn test_document_store() -> Result<(), String> {
    let mut store = DocumentStore::new()

    store.insert_doc("doc1".to_string(), "Hello World".to_string(), vec![])?
    store.insert_doc("doc2".to_string(), "Test Content".to_string(), vec![])?

    let content = store.get_doc("doc1".to_string())?
    println("Retrieved: {}", content)

    println("Total docs: {}", store.get_doc_count())
    Ok(())
}
