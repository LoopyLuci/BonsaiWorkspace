// Columnar Store
// Column-oriented storage for analytics
// System 62

use omnisystem::{HashMap, Vec, String, Option, Result}

struct Column {
    name: String,
    data: Vec<String>
}

struct ColumnarStore {
    columns: HashMap<String, Column>,
    row_count: i32
}

impl ColumnarStore {
    fn new() -> Self {
        return ColumnarStore {
            columns: HashMap::new(),
            row_count: 0
        }
    }

    fn add_column(&mut self, name: String) -> Result<(), String> {
        let col = Column {
            name: name.clone(),
            data: Vec::new()
        }
        self.columns.insert(name.clone(), col)
        println("ColumnarStore: Added column {}", name)
        Ok(())
    }

    fn append_value(&mut self, col_name: String, value: String) -> Result<(), String> {
        match self.columns.get_mut(&col_name) {
            Some(col) => {
                col.data.push(value)
                Ok(())
            },
            None => Err("Column not found".to_string())
        }
    }

    fn get_column_data(&self, col_name: String) -> Result<i32, String> {
        match self.columns.get(&col_name) {
            Some(col) => Ok(col.data.len() as i32),
            None => Err("Column not found".to_string())
        }
    }

    fn get_column_count(&self) -> i32 {
        return self.columns.len() as i32
    }
}

fn test_columnar_store() -> Result<(), String> {
    let mut store = ColumnarStore::new()

    store.add_column("id".to_string())?
    store.add_column("name".to_string())?
    store.add_column("age".to_string())?

    store.append_value("id".to_string(), "1".to_string())?
    store.append_value("name".to_string(), "Alice".to_string())?
    store.append_value("age".to_string(), "30".to_string())?

    let col_size = store.get_column_data("id".to_string())?
    println("Column 'id' has {} rows", col_size)

    Ok(())
}
