// Encryption Engine
// Data encryption and decryption
// System 70

use omnisystem::{HashMap, Vec, String, Option, Result}

struct EncryptedData {
    cipher_text: Vec<u8>,
    key_id: String
}

struct EncryptionEngine {
    keys: HashMap<String, Vec<u8>>
}

impl EncryptionEngine {
    fn new() -> Self {
        return EncryptionEngine {
            keys: HashMap::new()
        }
    }

    fn generate_key(&mut self, key_id: String) -> Result<(), String> {
        let mut key = Vec::new()
        for i in 0..32 {
            key.push((i as u8) ^ 0xFF)
        }
        self.keys.insert(key_id.clone(), key)
        println("EncryptionEngine: Generated key {}", key_id)
        Ok(())
    }

    fn encrypt(&self, key_id: String, plain_text: Vec<u8>) -> Result<Vec<u8>, String> {
        match self.keys.get(&key_id) {
            Some(key) => {
                let mut cipher = Vec::new()
                for byte in &plain_text {
                    cipher.push(*byte ^ key[0])
                }
                println("EncryptionEngine: Encrypted {} bytes", plain_text.len())
                Ok(cipher)
            },
            None => Err("Key not found".to_string())
        }
    }

    fn decrypt(&self, key_id: String, cipher_text: Vec<u8>) -> Result<Vec<u8>, String> {
        match self.keys.get(&key_id) {
            Some(key) => {
                let mut plain = Vec::new()
                for byte in &cipher_text {
                    plain.push(*byte ^ key[0])
                }
                println("EncryptionEngine: Decrypted {} bytes", cipher_text.len())
                Ok(plain)
            },
            None => Err("Key not found".to_string())
        }
    }
}

fn test_encryption_engine() -> Result<(), String> {
    let mut engine = EncryptionEngine::new()

    engine.generate_key("key1".to_string())?

    let plaintext = b"Secret message".to_vec()
    let encrypted = engine.encrypt("key1".to_string(), plaintext.clone())?
    let decrypted = engine.decrypt("key1".to_string(), encrypted)?

    println("Decrypted: {} bytes", decrypted.len())
    Ok(())
}
