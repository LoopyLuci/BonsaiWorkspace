// Consensus Protocol
// Distributed consensus with Raft-like guarantees
// System 53

use omnisystem::{HashMap, Vec, String, Option, Result}

struct ConsensusNode {
    id: String,
    state: String,
    term: i64,
    voted_for: Option<String>
}

actor ConsensusManager {
    nodes: HashMap<String, ConsensusNode> = HashMap::new(),
    current_term: i64 = 0,
    leader: Option<String> = None

    message RegisterNode(id: String) -> Result<(), String> {
        let node = ConsensusNode {
            id: id.clone(),
            state: "follower".to_string(),
            term: 0,
            voted_for: None
        }
        nodes.insert(id.clone(), node)
        println("ConsensusManager: Registered node {}", id)
        Ok(())
    }

    message ElectLeader() -> Result<String, String> {
        current_term = current_term + 1
        match nodes.values_mut().next() {
            Some(node) => {
                node.state = "leader".to_string()
                node.term = current_term
                leader = Some(node.id.clone())
                println("ConsensusManager: Elected leader {}, term {}", node.id, current_term)
                Ok(node.id.clone())
            },
            None => Err("No nodes available".to_string())
        }
    }

    message CommitLog(entry: String) -> Result<(), String> {
        match &leader {
            Some(l) => {
                println("ConsensusManager: Leader {} commits {}", l, entry)
                Ok(())
            },
            None => Err("No leader elected".to_string())
        }
    }

    message GetNodeCount() -> i32 {
        nodes.len() as i32
    }
}

async fn test_consensus() -> Result<(), String> {
    let cons: ActorRef<ConsensusManager> = spawn(ConsensusManager {
        nodes: HashMap::new(),
        current_term: 0,
        leader: None
    })

    for i in 0..3 {
        await cons.call(ConsensusManager::RegisterNode(format!("node{}", i)))?
    }

    let leader = await cons.call(ConsensusManager::ElectLeader())?
    await cons.call(ConsensusManager::CommitLog("entry1".to_string()))?

    println("Leader elected: {}", leader)
    Ok(())
}
