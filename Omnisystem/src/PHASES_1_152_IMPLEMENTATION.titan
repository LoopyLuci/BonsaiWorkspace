pub actor HealthMonitor {
    metrics: Arc<Mutex<HashMap<String, f64>>>,
    check_count: i32

    message RecordMetric(name: String, value: f64) -> Result<(), String> {
        metrics.lock().unwrap().insert(name, value)
        self.check_count += 1
        Ok(())
    }

    message GetMetric(name: String) -> Result<f64, String> {
        metrics.lock().unwrap()
            .get(&name)
            .copied()
            .ok_or("Metric not found".to_string())
    }
}

pub actor LoadBalancer {
    servers: Vec<String>,
    current_index: i32

    message AddServer(address: String) -> Result<(), String> {
        self.servers.push(address)
        Ok(())
    }

    message GetNextServer() -> Result<String, String> {
        if self.servers.is_empty() {
            return Err("No servers available".to_string())
        }
        let server = self.servers[(self.current_index as usize) % self.servers.len()].clone()
        self.current_index += 1
        Ok(server)
    }
}

pub actor DataValidator {
    validation_count: i32,
    error_count: i32

    message ValidateData(data: String) -> Result<bool, String> {
        self.validation_count += 1
        if data.is_empty() {
            self.error_count += 1
            return Err("Invalid data".to_string())
        }
        Ok(true)
    }

    message GetStats() -> HashMap<String, i32> {
        let mut stats: HashMap<String, i32> = HashMap::new()
        stats.insert("validated".to_string(), self.validation_count)
        stats.insert("errors".to_string(), self.error_count)
        stats
    }
}

pub actor Cacheer {
    cache: Arc<Mutex<HashMap<String, String>>>,
    hit_count: i32,
    miss_count: i32

    message Set(key: String, value: String) -> Result<(), String> {
        cache.lock().unwrap().insert(key, value)
        Ok(())
    }

    message Get(key: String) -> Option<String> {
        let result = cache.lock().unwrap().get(&key).cloned()
        if result.is_some() {
            self.hit_count += 1
        } else {
            self.miss_count += 1
        }
        result
    }
}

