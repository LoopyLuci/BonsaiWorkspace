pub actor WindowManager {
    windows: Arc<Mutex<Vec<String>>>,
    window_count: i32,
    focused_window: Option<String>

    message CreateWindow(title: String) -> Result<String, String> {
        let window_id = format!("window_{}", self.window_count)
        windows.lock().unwrap().push(window_id.clone())
        self.window_count += 1
        Ok(window_id)
    }

    message FocusWindow(window_id: String) -> Result<(), String> {
        self.focused_window = Some(window_id)
        Ok(())
    }

    message GetFocusedWindow() -> Option<String> {
        self.focused_window.clone()
    }
}

