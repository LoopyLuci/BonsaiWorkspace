pub actor RateLimiter {
    request_count: i32,
    limit: i32 = 1000

    message CheckLimit() -> Result<bool, String> {
        if self.request_count >= self.limit {
            return Err("Rate limit exceeded".to_string())
        }
        self.request_count += 1
        Ok(true)
    }

    message Reset() -> Result<(), String> {
        self.request_count = 0
        Ok(())
    }
}

pub actor CircuitBreaker {
    state: String = "closed".to_string(),
    failure_count: i32 = 0,
    failure_threshold: i32 = 5

    message RecordFailure() -> Result<(), String> {
        self.failure_count += 1
        if self.failure_count >= self.failure_threshold {
            self.state = "open".to_string()
        }
        Ok(())
    }

    message CanExecute() -> Result<bool, String> {
        Ok(self.state == "closed")
    }

    message Reset() -> Result<(), String> {
        self.state = "closed".to_string()
        self.failure_count = 0
        Ok(())
    }
}

pub actor ServiceRegistry {
    services: Arc<Mutex<HashMap<String, String>>>,
    service_count: i32

    message RegisterService(name: String, address: String) -> Result<(), String> {
        services.lock().unwrap().insert(name, address)
        self.service_count += 1
        Ok(())
    }

    message GetService(name: String) -> Result<String, String> {
        services.lock().unwrap()
            .get(&name)
            .cloned()
            .ok_or("Service not found".to_string())
    }

    message ListServices() -> Vec<String> {
        services.lock().unwrap()
            .keys()
            .cloned()
            .collect()
    }
}

