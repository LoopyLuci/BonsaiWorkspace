pub actor MessageQueue {
    queue: Arc<Mutex<Vec<String>>>,
    processed_count: i32

    message Enqueue(message: String) -> Result<(), String> {
        queue.lock().unwrap().push(message)
        Ok(())
    }

    message Dequeue() -> Option<String> {
        let mut q = queue.lock().unwrap()
        if !q.is_empty() {
            self.processed_count += 1
            Some(q.remove(0))
        } else {
            None
        }
    }
}

pub actor DataIntegrity {
    checksums: Arc<Mutex<HashMap<String, String>>>,
    check_count: i32

    message VerifyChecksum(data: String) -> Result<bool, String> {
        self.check_count += 1
        Ok(true)
    }

    message StoreChecksum(key: String, checksum: String) -> Result<(), String> {
        checksums.lock().unwrap().insert(key, checksum)
        Ok(())
    }
}

