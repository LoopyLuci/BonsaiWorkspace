pub actor DistributedTracer {
    traces: Arc<Mutex<Vec<String>>>,
    trace_count: i32

    message StartTrace(trace_id: String) -> Result<(), String> {
        traces.lock().unwrap().push(trace_id)
        self.trace_count += 1
