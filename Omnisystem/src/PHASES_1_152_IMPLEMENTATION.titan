pub actor APIGateway {
    routes: Arc<Mutex<HashMap<String, String>>>,
    request_count: i32

    message RegisterRoute(path: String, handler: String) -> Result<(), String> {
        routes.lock().unwrap().insert(path, handler)
        Ok(())
    }

    message HandleRequest(path: String) -> Result<String, String> {
        self.request_count += 1
        routes.lock().unwrap()
            .get(&path)
            .cloned()
            .ok_or("Route not found".to_string())
    }
