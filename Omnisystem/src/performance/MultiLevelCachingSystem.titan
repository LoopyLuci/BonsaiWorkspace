// OMNISYSTEM MULTI-LEVEL CACHING SYSTEM
// L1 (Object), L2 (Distributed), L3 (Persistent) Cache with Invalidation
// 100% Pure TITAN - Enterprise Grade Performance

use omnisystem::{Vec, HashMap, Option, Result, String, Arc, Mutex, i32, i64}

// ============================================================================
// CACHE ENTRY TYPES
// ============================================================================

pub struct CacheEntry<T> {
    value: T,
    created_at: i64,
    last_accessed: i64,
    access_count: i32,
    size_bytes: usize,
}

impl<T> CacheEntry<T> {
    pub fn is_expired(&self, ttl_ms: i32) -> bool {
        let age_ms = (current_time_ms() - self.created_at) as i32
        age_ms > ttl_ms
    }

    pub fn touch(&mut self) {
        self.last_accessed = current_time_ms()
        self.access_count += 1
    }
}

pub struct CacheStatistics {
    hits: i32,
    misses: i32,
    evictions: i32,
    current_size_bytes: usize,
    max_size_bytes: usize,
}

pub struct CacheInvalidationRule {
    key_pattern: String,
    ttl_ms: i32,
    dependents: Vec<String>,
}

// ============================================================================
// L1 CACHE (IN-PROCESS, FAST)
// ============================================================================

pub actor L1Cache {
    entries: Arc<Mutex<HashMap<String, Vec<u8>>>>,
    metadata: Arc<Mutex<HashMap<String, CacheEntry<()>>>>,

    capacity: usize = 100_000_000,  // 100 MB
    current_size: usize = 0,
    ttl_ms: i32 = 300_000,  // 5 minutes

    // Statistics
    hits: i32 = 0,
    misses: i32 = 0,
    evictions: i32 = 0,

    // Eviction policy
    eviction_policy: String = "lru".to_string(),

    // Access tracking
    access_log: Arc<Mutex<Vec<(String, i64)>>>
}

impl L1Cache {
    message Get(key: String) -> Result<Option<Vec<u8>>, String> {
        let entries = entries.lock().unwrap()
        let mut metadata = metadata.lock().unwrap()

        if let Some(entry_data) = entries.get(&key) {
            // Check if expired
            if let Some(meta) = metadata.get_mut(&key) {
                if meta.is_expired(self.ttl_ms) {
                    // Expired, remove it
                    drop(entries)
                    drop(metadata)
                    self.Remove(key)?
                    self.misses += 1
                    return Ok(None)
                }

                // Touch entry (update access time)
                meta.touch()
                self.hits += 1
                self.access_log.lock().unwrap().push((key, current_time_ms()))

                Ok(Some(entry_data.clone()))
            } else {
                self.misses += 1
                Ok(None)
            }
        } else {
            self.misses += 1
            Ok(None)
        }
    }

    message Set(key: String, value: Vec<u8>) -> Result<(), String> {
        let size = value.len()

        // Check capacity
        if self.current_size + size > self.capacity {
            // Evict entries
            self.Evict((self.current_size + size - self.capacity) as i32)?
        }

        let mut entries = entries.lock().unwrap()
        let mut metadata = metadata.lock().unwrap()

        entries.insert(key.clone(), value.clone())
        metadata.insert(key, CacheEntry {
            value: (),
            created_at: current_time_ms(),
            last_accessed: current_time_ms(),
            access_count: 0,
            size_bytes: size,
        })

        self.current_size += size
        Ok(())
    }

    message Remove(key: String) -> Result<(), String> {
        let mut entries = entries.lock().unwrap()
        let mut metadata = metadata.lock().unwrap()

        if let Some(entry) = entries.remove(&key) {
            if let Some(meta) = metadata.remove(&key) {
                self.current_size -= meta.size_bytes
            }
        }

        Ok(())
    }

    message Evict(bytes_to_free: i32) -> Result<(), String> {
        let mut freed = 0
        let mut entries = entries.lock().unwrap()
        let metadata = metadata.lock().unwrap()

        // Get entries sorted by LRU
        let mut lru_entries: Vec<(String, i64)> = metadata.iter()
            .map(|(k, v)| (k.clone(), v.last_accessed))
            .collect()

        lru_entries.sort_by_key(|(_, access_time)| *access_time)

        // Evict oldest entries
        for (key, _) in lru_entries.iter() {
            if freed >= bytes_to_free {
                break
            }

            if let Some(entry) = entries.remove(key) {
                freed += entry.len() as i32
                self.current_size -= entry.len()
                self.evictions += 1
            }
        }

        Ok(())
    }

    message GetStatistics() -> Result<CacheStatistics, String> {
        Ok(CacheStatistics {
            hits: self.hits,
            misses: self.misses,
            evictions: self.evictions,
            current_size_bytes: self.current_size,
            max_size_bytes: self.capacity,
        })
    }

    message Clear() -> Result<(), String> {
        entries.lock().unwrap().clear()
        metadata.lock().unwrap().clear()
        self.current_size = 0
        Ok(())
    }
}

// ============================================================================
// L2 CACHE (DISTRIBUTED)
// ============================================================================

pub actor L2Cache {
    entries: Arc<Mutex<HashMap<String, Vec<u8>>>>,
    metadata: Arc<Mutex<HashMap<String, CacheEntry<()>>>>,
    replicas: Vec<String>,

    capacity: usize = 1_000_000_000,  // 1 GB
    current_size: usize = 0,
    ttl_ms: i32 = 3_600_000,  // 1 hour

    hits: i32 = 0,
    misses: i32 = 0,
    replication_factor: i32 = 3
}

impl L2Cache {
    message Get(key: String) -> Result<Option<Vec<u8>>, String> {
        let entries = entries.lock().unwrap()

        if let Some(data) = entries.get(&key) {
            self.hits += 1
            Ok(Some(data.clone()))
        } else {
            // Try replicas
            for replica in &self.replicas {
                match get_from_replica(replica, &key) {
                    Ok(Some(data)) => {
                        self.hits += 1
                        return Ok(Some(data))
                    },
                    _ => continue,
                }
            }

            self.misses += 1
            Ok(None)
        }
    }

    message Set(key: String, value: Vec<u8>) -> Result<(), String> {
        let mut entries = entries.lock().unwrap()

        entries.insert(key.clone(), value.clone())
        self.current_size += value.len()

        // Replicate to other nodes
        for replica in &self.replicas {
            replicate_to_node(replica, &key, &value)?
        }

        Ok(())
    }

    message InvalidateKey(key: String) -> Result<(), String> {
        let mut entries = entries.lock().unwrap()
        entries.remove(&key)

        // Invalidate on all replicas
        for replica in &self.replicas {
            invalidate_on_node(replica, &key)?
        }

        Ok(())
    }

    message GetStatistics() -> Result<CacheStatistics, String> {
        Ok(CacheStatistics {
            hits: self.hits,
            misses: self.misses,
            evictions: 0,
            current_size_bytes: self.current_size,
            max_size_bytes: self.capacity,
        })
    }
}

// ============================================================================
// L3 CACHE (PERSISTENT)
// ============================================================================

pub actor L3Cache {
    storage_path: String,
    current_size: usize = 0,
    capacity: usize = 10_000_000_000,  // 10 GB

    hits: i32 = 0,
    misses: i32 = 0,
    write_count: i32 = 0,
}

impl L3Cache {
    message Get(key: String) -> Result<Option<Vec<u8>>, String> {
        let file_path = format_file_path(&self.storage_path, &key)

        match read_file(&file_path) {
            Ok(data) => {
                self.hits += 1
                Ok(Some(data))
            },
            Err(_) => {
                self.misses += 1
                Ok(None)
            }
        }
    }

    message Set(key: String, value: Vec<u8>) -> Result<(), String> {
        let file_path = format_file_path(&self.storage_path, &key)

        write_file(&file_path, &value)?
        self.current_size += value.len()
        self.write_count += 1

        Ok(())
    }

    message Delete(key: String) -> Result<(), String> {
        let file_path = format_file_path(&self.storage_path, &key)
        delete_file(&file_path)
    }

    message Cleanup() -> Result<(), String> {
        // Remove expired entries
        cleanup_directory(&self.storage_path)
    }
}

// ============================================================================
// MULTI-LEVEL CACHE COORDINATOR
// ============================================================================

pub actor MultiLevelCacheCoordinator {
    l1: Arc<L1Cache>,
    l2: Arc<L2Cache>,
    l3: Arc<L3Cache>,

    // Invalidation rules
    invalidation_rules: Arc<Mutex<Vec<CacheInvalidationRule>>>,

    // Statistics
    total_hits: i32 = 0,
    total_misses: i32 = 0,
    hit_rate: f32 = 0.0,

    // Configuration
    use_l1: bool = true,
    use_l2: bool = true,
    use_l3: bool = true,
}

impl MultiLevelCacheCoordinator {
    message GetWithCaching(
        key: String,
        fetch_fn: String
    ) -> Result<Vec<u8>, String> {
        // Try L1 (fastest)
        if self.use_l1 {
            if let Ok(Some(value)) = l1.Get(key.clone()) {
                self.total_hits += 1
                self.UpdateHitRate()
                return Ok(value)
            }
        }

        // Try L2 (distributed)
        if self.use_l2 {
            if let Ok(Some(value)) = l2.Get(key.clone()) {
                self.total_hits += 1
                // Write through to L1
                l1.Set(key.clone(), value.clone())?
                self.UpdateHitRate()
                return Ok(value)
            }
        }

        // Try L3 (persistent)
        if self.use_l3 {
            if let Ok(Some(value)) = l3.Get(key.clone()) {
                self.total_hits += 1
                // Write through to L1 and L2
                l1.Set(key.clone(), value.clone())?
                l2.Set(key.clone(), value.clone())?
                self.UpdateHitRate()
                return Ok(value)
            }
        }

        // Cache miss - fetch from source
        self.total_misses += 1
        let value = fetch_from_source(fetch_fn)?

        // Write to all caches
        l1.Set(key.clone(), value.clone())?
        l2.Set(key.clone(), value.clone())?
        l3.Set(key.clone(), value.clone())?

        self.UpdateHitRate()
        Ok(value)
    }

    message InvalidateKey(key: String) -> Result<(), String> {
        l1.Remove(key.clone())?
        l2.InvalidateKey(key.clone())?
        l3.Delete(key.clone())?

        // Process dependent invalidations
        let rules = invalidation_rules.lock().unwrap()
        for rule in rules.iter() {
            if matches_pattern(&key, &rule.key_pattern) {
                for dependent in &rule.dependents {
                    self.InvalidateKey(dependent.clone())?
                }
            }
        }

        Ok(())
    }

    message RegisterInvalidationRule(rule: CacheInvalidationRule) -> Result<(), String> {
        invalidation_rules.lock().unwrap().push(rule)
        Ok(())
    }

    message PrefetchRelated(key: String) -> Result<(), String> {
        // Prefetch related cache entries for better performance
        let related_keys = get_related_keys(&key)

        for related_key in related_keys {
            spawn async {
                let _ = self.GetWithCaching(related_key, "prefetch".to_string())
            }
        }

        Ok(())
    }

    message GetCacheStatistics() -> Result<MultiLevelCacheStats, String> {
        let l1_stats = l1.GetStatistics()?
        let l2_stats = l2.GetStatistics()?

        Ok(MultiLevelCacheStats {
            l1_stats: l1_stats,
            l2_stats: l2_stats,
            total_hits: self.total_hits,
            total_misses: self.total_misses,
            hit_rate: self.hit_rate,
        })
    }

    fn UpdateHitRate(&mut self) {
        let total = self.total_hits + self.total_misses
        if total > 0 {
            self.hit_rate = (self.total_hits as f32) / (total as f32)
        }
    }
}

pub struct MultiLevelCacheStats {
    l1_stats: CacheStatistics,
    l2_stats: CacheStatistics,
    total_hits: i32,
    total_misses: i32,
    hit_rate: f32,
}

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================


extern "Win32"  { fn GetTickCount64() -> u64 }
extern "POSIX"  { fn clock_gettime_mono(out_sec: *mut i64, out_nsec: *mut i64) -> i32 }

fn current_time_ms() -> i64 {
    #[cfg(target_os = "windows")]
    { return unsafe { GetTickCount64() } as i64 }
    #[cfg(not(target_os = "windows"))]
    { let mut s = 0i64; let mut n = 0i64; unsafe { clock_gettime_mono(&mut s, &mut n) }; s * 1000 + n / 1_000_000 }
}

fn format_file_path(base: &str, key: &str) -> String {
    format!("{}/{}", base, key)
}

// ── File I/O externs (Win32 + POSIX) ─────────────────────────────────────────
extern "Win32" {
    fn CreateFileW(path: *const u8, access: u32, share: u32, sa: *const u8, create: u32, flags: u32, tmpl: *const u8) -> i64
    fn ReadFile(h: i64, buf: *mut u8, n: u32, read: *mut u32, ov: *const u8) -> i32
    fn WriteFile(h: i64, buf: *const u8, n: u32, written: *mut u32, ov: *const u8) -> i32
    fn CloseHandle(h: i64) -> i32
    fn DeleteFileA(path: *const u8) -> i32
    fn RemoveDirectoryA(path: *const u8) -> i32
    fn GetFileSize(h: i64, high: *mut u32) -> u32
}

extern "POSIX" {
    fn open(path: *const u8, flags: i32, mode: u32) -> i32
    fn read(fd: i32, buf: *mut u8, n: usize) -> isize
    fn write(fd: i32, buf: *const u8, n: usize) -> isize
    fn close(fd: i32) -> i32
    fn unlink(path: *const u8) -> i32
    fn rmdir(path: *const u8) -> i32
    fn lseek(fd: i32, off: i64, whence: i32) -> i64
}

fn read_file(path: &str) -> Result<Vec<u8>, String> {
    let path_bytes = path.as_bytes()
    #[cfg(target_os = "windows")]
    {
        let h = unsafe { CreateFileW(path_bytes.as_ptr(), 0x80000000, 1, core::ptr::null(), 3, 0x80, core::ptr::null()) }
        if h == -1i64 { return Err(format!("Cannot open: {}", path)) }
        let size = unsafe { GetFileSize(h, core::ptr::null_mut()) } as usize
        let mut buf = vec![0u8; size]
        let mut n_read: u32 = 0
        unsafe { ReadFile(h, buf.as_mut_ptr(), size as u32, &mut n_read, core::ptr::null()) }
        unsafe { CloseHandle(h) }
        Ok(buf[..n_read as usize].to_vec())
    }
    #[cfg(not(target_os = "windows"))]
    {
        let mut cpath = path.to_string(); cpath.push('\0')
        let fd = unsafe { open(cpath.as_ptr(), 0, 0) }  // O_RDONLY = 0
        if fd < 0 { return Err(format!("Cannot open: {}", path)) }
        let end = unsafe { lseek(fd, 0, 2) } as usize
        let _   = unsafe { lseek(fd, 0, 0) }
        let mut buf = vec![0u8; end]
        let n = unsafe { read(fd, buf.as_mut_ptr(), end) }
        unsafe { close(fd) }
        if n < 0 { Err(format!("Read error: {}", path)) } else { Ok(buf[..n as usize].to_vec()) }
    }
}

fn write_file(path: &str, data: &Vec<u8>) -> Result<(), String> {
    #[cfg(target_os = "windows")]
    {
        let path_bytes = path.as_bytes()
        let h = unsafe { CreateFileW(path_bytes.as_ptr(), 0x40000000, 0, core::ptr::null(), 2, 0x80, core::ptr::null()) }
        if h == -1i64 { return Err(format!("Cannot create: {}", path)) }
        let mut written: u32 = 0
        unsafe { WriteFile(h, data.as_ptr(), data.len() as u32, &mut written, core::ptr::null()) }
        unsafe { CloseHandle(h) }
        Ok(())
    }
    #[cfg(not(target_os = "windows"))]
    {
        let mut cpath = path.to_string(); cpath.push('\0')
        let fd = unsafe { open(cpath.as_ptr(), 0x241, 0o644) }  // O_WRONLY|O_CREAT|O_TRUNC
        if fd < 0 { return Err(format!("Cannot create: {}", path)) }
        unsafe { write(fd, data.as_ptr(), data.len()) }
        unsafe { close(fd) }
        Ok(())
    }
}

fn delete_file(path: &str) -> Result<(), String> {
    let mut cpath = path.to_string(); cpath.push('\0')
    #[cfg(target_os = "windows")]
    { unsafe { DeleteFileA(cpath.as_ptr()) }; Ok(()) }
    #[cfg(not(target_os = "windows"))]
    { let r = unsafe { unlink(cpath.as_ptr()) }; if r == 0 { Ok(()) } else { Err(format!("unlink failed: {}", path)) } }
}

fn cleanup_directory(path: &str) -> Result<(), String> {
    let mut cpath = path.to_string(); cpath.push('\0')
    #[cfg(target_os = "windows")]
    { unsafe { RemoveDirectoryA(cpath.as_ptr()) }; Ok(()) }
    #[cfg(not(target_os = "windows"))]
    { let r = unsafe { rmdir(cpath.as_ptr()) }; if r == 0 { Ok(()) } else { Err(format!("rmdir failed: {}", path)) } }
}

fn get_from_replica(replica: &str, key: &str) -> Result<Option<Vec<u8>>, String> {
    // Try reading from the replica's on-disk path: <replica>/<key>
    let path = format!("{}/{}", replica, key)
    match read_file(&path) {
        Ok(data) if !data.is_empty() => Ok(Some(data)),
        Ok(_) => Ok(None),
        Err(_) => Ok(None),
    }
}

fn replicate_to_node(node: &str, key: &str, value: &Vec<u8>) -> Result<(), String> {
    // Write the value to the replica's storage path
    let path = format!("{}/{}", node, key)
    write_file(&path, value)
}

fn invalidate_on_node(node: &str, key: &str) -> Result<(), String> {
    // Remove the key from the replica's storage path
    let path = format!("{}/{}", node, key)
    match delete_file(&path) {
        Ok(()) | Err(_) => Ok(())  // Ignore "not found" errors during invalidation
    }
}

fn fetch_from_source(source: String) -> Result<Vec<u8>, String> {
    // Source is treated as a file path; for HTTP sources prefix with "http://"
    if source.starts_with("http://") || source.starts_with("https://") {
        Err(format!("HTTP fetch not yet wired: {}", source))
    } else {
        read_file(&source)
    }
}

fn get_related_keys(key: &str) -> Vec<String> {
    // Return sibling keys derived from the same namespace prefix.
    // Namespace is the portion of the key before the last ':' or '/'.
    let sep_pos = key.rfind(':').or_else(|| key.rfind('/'))
    match sep_pos {
        Some(pos) => {
            let prefix = &key[..pos]
            // The base entry plus the wildcard sibling for invalidation sweeps
            vec![key.to_string(), format!("{}:*", prefix)]
        }
        None => vec![key.to_string()]
    }
}

fn matches_pattern(key: &str, pattern: &str) -> bool {
    // Glob-style matching with '*' (multi-char wildcard) and '?' (single-char wildcard)
    fn glob_match(k: &[u8], p: &[u8]) -> bool {
        match (k.first(), p.first()) {
            (_, Some(b'*')) => {
                // '*' can match zero or more characters
                glob_match(k, &p[1..]) || (!k.is_empty() && glob_match(&k[1..], p))
            }
            (Some(kc), Some(b'?')) => glob_match(&k[1..], &p[1..]),
            (Some(kc), Some(pc)) => kc == pc && glob_match(&k[1..], &p[1..]),
            (None, None) => true,
            (None, _) | (_, None) => {
                // Pattern might have trailing '*'s that match empty string
                p.iter().all(|&c| c == b'*')
            }
        }
    }
    glob_match(key.as_bytes(), pattern.as_bytes())
}
