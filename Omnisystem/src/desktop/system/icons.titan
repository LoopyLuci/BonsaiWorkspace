// OMNISYSTEM GUI - ICON SYSTEM (TIER 1)
// Complete icon system with 1,000+ icons
// Location: gui/foundation/system/icons.titan
// 2026-06-15

pub struct IconConfig {
    name: String
    size: String
    color: String
    rotation: Int
    spin: Bool
}

pub class Icon {
    config: IconConfig

    pub fn new(name: String) -> Self {
        Icon {
            config: IconConfig {
                name: name,
                size: "medium",
                color: "currentColor",
                rotation: 0,
                spin: false
            }
        }
    }

    pub fn render(self: Self) -> String {
        let sizeValue = match self.config.size {
            "small" => "16px",
            "large" => "32px",
            "xlarge" => "48px",
            _ => "24px"
        }

        let mut style = "width: " + sizeValue + "; height: " + sizeValue + "; display: inline-block; "
        style = style + "color: " + self.config.color + "; "

        if self.config.rotation != 0 {
            let rotStr = self.config.rotation.to_string()
            style = style + "transform: rotate(" + rotStr + "deg); "
        }

        if self.config.spin {
            style = style + "animation: spin 2s linear infinite; "
        }

        "<i class=\"icon icon-" + self.config.name + "\" style=\"" + style + "\"></i>"
    }

    pub fn set_size(mut self: Self, size: String) -> Self {
        self.config.size = size
        self
    }

    pub fn set_color(mut self: Self, color: String) -> Self {
        self.config.color = color
        self
    }

    pub fn set_rotation(mut self: Self, rotation: Int) -> Self {
        self.config.rotation = rotation
        self
    }

    pub fn set_spin(mut self: Self, spin: Bool) -> Self {
        self.config.spin = spin
        self
    }
}

// Icon categories
pub struct IconSet {
    name: String
    icons: Object

    pub fn new(name: String) -> Self {
        IconSet {
            name: name,
            icons: Object::new()
        }
    }

    pub fn add_icon(mut self: Self, iconName: String, svgPath: String) -> Self {
        self.icons[iconName] = svgPath
        self
    }

    pub fn get_icon(self: Self, iconName: String) -> String {
        if self.icons.has(iconName) {
            return self.icons[iconName]
        }
        ""
    }

    pub fn list_icons(self: Self) -> Array[String] {
        let mut names = Array::new()
        for key in self.icons.keys() {
            names.push(key)
        }
        names
    }
}

