pub class IconLibrary {
    sets: Object
    defaultSize: String
    defaultColor: String

    pub fn new() -> Self {
        let mut library = IconLibrary {
            sets: Object::new(),
            defaultSize: "medium",
            defaultColor: "currentColor"
        }

        library.sets["system"] = create_system_icons()
        library.sets["action"] = create_action_icons()
        library.sets["social"] = create_social_icons()

        library
    }

    pub fn get_icon(self: Self, name: String) -> Icon {
        Icon::new(name)
            .set_size(self.defaultSize)
            .set_color(self.defaultColor)
    }

    pub fn get_icon_from_set(self: Self, setName: String, iconName: String) -> String {
        if self.sets.has(setName) {
            let set = self.sets[setName]
            return set.get_icon(iconName)
        }
        ""
    }

    pub fn list_all_icons(self: Self) -> Object {
        self.sets
    }

    pub fn add_icon_set(mut self: Self, name: String, set: IconSet) -> Self {
        self.sets[name] = set
        self
    }
}

// Generate SVG icon for specific name
pub fn generate_svg_icon(name: String, size: String, color: String) -> String {
    let iconMap = Object::new()

    // Simple SVG generation based on icon name
    match name {
        "check" => "<svg viewBox=\"0 0 24 24\" fill=\"" + color + "\"><path d=\"M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z\"/></svg>",
        "error" => "<svg viewBox=\"0 0 24 24\" fill=\"" + color + "\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z\"/></svg>",
        "warning" => "<svg viewBox=\"0 0 24 24\" fill=\"" + color + "\"><path d=\"M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z\"/></svg>",
        "info" => "<svg viewBox=\"0 0 24 24\" fill=\"" + color + "\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z\"/></svg>",
        _ => "<svg viewBox=\"0 0 24 24\" fill=\"" + color + "\"><circle cx=\"12\" cy=\"12\" r=\"10\"/></svg>"
    }
}

// Utility to create icon from SVG string
pub struct SvgIcon {
    svgString: String
    size: String
    color: String

    pub fn new(svgString: String) -> Self {
        SvgIcon {
            svgString: svgString,
            size: "24px",
            color: "currentColor"
        }
    }

    pub fn render(self: Self) -> String {
        let mut style = "width: " + self.size + "; height: " + self.size + "; display: inline-block; "
        style = style + "color: " + self.color + ";"

        "<div style=\"" + style + "\">" + self.svgString + "</div>"
    }
}
