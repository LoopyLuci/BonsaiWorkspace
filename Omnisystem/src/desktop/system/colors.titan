// OMNISYSTEM GUI - COLOR THEME SYSTEM
// Foundation theming using Omni Design Tokens
// Location: gui/foundation/theming/colors.titan
// 2026-06-15

pub struct Color {
    hex: String
    rgb: String
    hsl: String
    name: String
}

pub struct ColorPalette {
    primary: Color
    secondary: Color
    tertiary: Color
    success: Color
    warning: Color
    error: Color
    info: Color
    neutral: Color
}

pub struct Theme {
    name: String
    palette: ColorPalette
    background: Color
    foreground: Color
    surface: Color
    surfaceVariant: Color
    outline: Color
    shadow: String
}

pub class ThemeManager {
    themes: Object
    currentTheme: String

    pub fn new() -> Self {
        let mut manager = ThemeManager {
            themes: Object::new(),
            currentTheme: "light"
        }

        manager.register_default_themes()
        manager
    }

    fn register_default_themes(mut self: Self) -> () {
        self.themes["light"] = create_light_theme()
        self.themes["dark"] = create_dark_theme()
        self.themes["high-contrast"] = create_high_contrast_theme()
        self.themes["colorblind"] = create_colorblind_theme()
    }

    pub fn get_theme(self: Self, name: String) -> Theme {
        if self.themes.has(name) {
            return self.themes[name]
        }
        self.themes[self.currentTheme]
    }

    pub fn set_current_theme(mut self: Self, name: String) -> () {
        if self.themes.has(name) {
            self.currentTheme = name
        }
    }

    pub fn register_theme(mut self: Self, name: String, theme: Theme) -> () {
        self.themes[name] = theme
    }

    pub fn get_current_theme(self: Self) -> Theme {
        self.get_theme(self.currentTheme)
    }

    pub fn export_css(self: Self) -> String {
        let theme = self.get_current_theme()
        generate_css_variables(theme)
    }
}

