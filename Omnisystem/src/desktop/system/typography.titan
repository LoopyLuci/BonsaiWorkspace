// OMNISYSTEM GUI - TYPOGRAPHY SYSTEM (TIER 1)
// Typography components and styles using Omni Assets
// Location: gui/foundation/theming/typography.titan
// 2026-06-15

pub enum HeadingLevel {
    H1,
    H2,
    H3,
    H4,
    H5,
    H6
}

pub enum TextAlign {
    Left,
    Center,
    Right,
    Justify
}

pub enum TextWeight {
    Light,
    Normal,
    Medium,
    SemiBold,
    Bold,
    ExtraBold
}

pub struct TypographyConfig {
    fontFamily: String
    fontSize: String
    fontWeight: String
    lineHeight: String
    letterSpacing: String
    color: String
    textAlign: String
}

pub class Heading {
    level: HeadingLevel
    text: String
    config: TypographyConfig

    pub fn new(level: HeadingLevel, text: String) -> Self {
        let fontSize = match level {
            HeadingLevel::H1 => "2.5rem",
            HeadingLevel::H2 => "2rem",
            HeadingLevel::H3 => "1.75rem",
            HeadingLevel::H4 => "1.5rem",
            HeadingLevel::H5 => "1.25rem",
            HeadingLevel::H6 => "1rem"
        }

        Heading {
            level: level,
            text: text,
            config: TypographyConfig {
                fontFamily: "'Inter', 'Segoe UI', sans-serif",
                fontSize: fontSize,
                fontWeight: "bold",
                lineHeight: "1.2",
                letterSpacing: "-0.5px",
                color: "#1F2937",
                textAlign: "left"
            }
        }
    }

    pub fn render(self: Self) -> String {
        let tag = self.get_tag()
        let style = self.get_style()
        "<" + tag + " style=\"" + style + "\">" + self.text + "</" + tag + ">"
    }

    fn get_tag(self: Self) -> String {
        match self.level {
            HeadingLevel::H1 => "h1",
            HeadingLevel::H2 => "h2",
            HeadingLevel::H3 => "h3",
            HeadingLevel::H4 => "h4",
            HeadingLevel::H5 => "h5",
            HeadingLevel::H6 => "h6"
        }
    }

    fn get_style(self: Self) -> String {
        let mut style = ""
        style = style + "font-family: " + self.config.fontFamily + "; "
        style = style + "font-size: " + self.config.fontSize + "; "
        style = style + "font-weight: " + self.config.fontWeight + "; "
        style = style + "line-height: " + self.config.lineHeight + "; "
        style = style + "letter-spacing: " + self.config.letterSpacing + "; "
        style = style + "color: " + self.config.color + "; "
        style = style + "text-align: " + self.config.textAlign + "; "
        style = style + "margin: 0; "
        style
    }

    pub fn set_color(mut self: Self, color: String) -> Self {
        self.config.color = color
        self
    }

    pub fn set_text_align(mut self: Self, align: TextAlign) -> Self {
        self.config.textAlign = align.to_string().to_lowercase()
        self
    }
}

pub class Paragraph {
    text: String
    config: TypographyConfig
    lineClamp: Int

    pub fn new(text: String) -> Self {
        Paragraph {
            text: text,
            config: TypographyConfig {
                fontFamily: "'Inter', 'Segoe UI', sans-serif",
                fontSize: "1rem",
                fontWeight: "normal",
                lineHeight: "1.6",
                letterSpacing: "0",
                color: "#4B5563",
                textAlign: "left"
            },
            lineClamp: 0
        }
    }

    pub fn render(self: Self) -> String {
        let style = self.get_style()
        "<p style=\"" + style + "\">" + self.text + "</p>"
    }

    fn get_style(self: Self) -> String {
        let mut style = ""
        style = style + "font-family: " + self.config.fontFamily + "; "
        style = style + "font-size: " + self.config.fontSize + "; "
        style = style + "font-weight: " + self.config.fontWeight + "; "
        style = style + "line-height: " + self.config.lineHeight + "; "
        style = style + "color: " + self.config.color + "; "
        style = style + "text-align: " + self.config.textAlign + "; "
        style = style + "margin: 0; "

        if self.lineClamp > 0 {
            let clampStr = self.lineClamp.to_string()
            style = style + "display: -webkit-box; "
            style = style + "-webkit-line-clamp: " + clampStr + "; "
            style = style + "-webkit-box-orient: vertical; "
            style = style + "overflow: hidden; "
        }

        style
    }

    pub fn set_size(mut self: Self, size: String) -> Self {
        self.config.fontSize = size
        self
    }

    pub fn set_weight(mut self: Self, weight: TextWeight) -> Self {
        self.config.fontWeight = match weight {
            TextWeight::Light => "300",
            TextWeight::Normal => "400",
            TextWeight::Medium => "500",
            TextWeight::SemiBold => "600",
            TextWeight::Bold => "700",
            TextWeight::ExtraBold => "800"
        }
        self
    }

    pub fn set_line_clamp(mut self: Self, lines: Int) -> Self {
        self.lineClamp = lines
        self
    }
}

pub class Label {
    text: String
    htmlFor: String
    required: Bool
    config: TypographyConfig

    pub fn new(text: String) -> Self {
        Label {
            text: text,
            htmlFor: "",
            required: false,
            config: TypographyConfig {
                fontFamily: "'Inter', 'Segoe UI', sans-serif",
                fontSize: "0.875rem",
                fontWeight: "500",
                lineHeight: "1.4",
                letterSpacing: "0",
                color: "#1F2937",
                textAlign: "left"
            }
        }
    }

    pub fn render(self: Self) -> String {
        let style = self.get_style()
        let mut html = "<label style=\"" + style + "\""

        if !self.htmlFor.is_empty() {
            html = html + " for=\"" + self.htmlFor + "\""
        }

        html = html + ">" + self.text

        if self.required {
            html = html + " <span style=\"color: #EF4444;\">*</span>"
        }

        html = html + "</label>"
        html
    }

    fn get_style(self: Self) -> String {
        let mut style = ""
        style = style + "font-family: " + self.config.fontFamily + "; "
        style = style + "font-size: " + self.config.fontSize + "; "
        style = style + "font-weight: " + self.config.fontWeight + "; "
        style = style + "color: " + self.config.color + "; "
        style = style + "display: block; "
        style = style + "margin-bottom: 4px; "
        style
    }

    pub fn set_for(mut self: Self, id: String) -> Self {
        self.htmlFor = id
        self
    }

    pub fn set_required(mut self: Self, required: Bool) -> Self {
        self.required = required
        self
    }
}

pub class Badge {
    text: String
    variant: String
    size: String

    pub fn new(text: String) -> Self {
        Badge {
            text: text,
            variant: "default",
            size: "medium"
        }
    }

    pub fn render(self: Self) -> String {
        let mut style = "display: inline-block; "
        style = style + "padding: 4px 8px; "
        style = style + "border-radius: 4px; "
        style = style + "font-size: 0.75rem; "
        style = style + "font-weight: 600; "

        style = match self.variant {
            "primary" => style + "background-color: #2563EB; color: white; ",
            "success" => style + "background-color: #10B981; color: white; ",
            "warning" => style + "background-color: #F59E0B; color: white; ",
            "error" => style + "background-color: #EF4444; color: white; ",
            _ => style + "background-color: #E5E7EB; color: #1F2937; "
        }

        "<span style=\"" + style + "\">" + self.text + "</span>"
    }

    pub fn set_variant(mut self: Self, variant: String) -> Self {
        self.variant = variant
        self
    }
}

pub class Code {
    text: String
    inline: Bool
    language: String

    pub fn new(text: String) -> Self {
        Code {
            text: text,
            inline: true,
            language: ""
        }
    }

    pub fn render(self: Self) -> String {
        if self.inline {
            "<code style=\"background-color: #F3F4F6; padding: 2px 6px; border-radius: 3px; font-family: 'Courier New', monospace; font-size: 0.875em;\">" + self.text + "</code>"
        } else {
            "<pre style=\"background-color: #1F2937; color: #E5E7EB; padding: 16px; border-radius: 8px; overflow-x: auto;\"><code>" + self.text + "</code></pre>"
        }
    }

    pub fn set_language(mut self: Self, language: String) -> Self {
        self.language = language
        self
    }
}

pub fn generate_typography_css() -> String {
    let css = "
body {
    font-family: 'Inter', 'Segoe UI', sans-serif;
    font-size: 1rem;
    line-height: 1.6;
    color: #1F2937;
}

h1 { font-size: 2.5rem; font-weight: bold; line-height: 1.2; }
h2 { font-size: 2rem; font-weight: bold; line-height: 1.2; }
h3 { font-size: 1.75rem; font-weight: bold; line-height: 1.3; }
h4 { font-size: 1.5rem; font-weight: 600; line-height: 1.4; }
h5 { font-size: 1.25rem; font-weight: 600; line-height: 1.4; }
h6 { font-size: 1rem; font-weight: 600; line-height: 1.5; }

p { margin: 0 0 1rem 0; }
small { font-size: 0.875rem; }
strong { font-weight: 600; }
em { font-style: italic; }

.text-primary { color: #2563EB; }
.text-success { color: #10B981; }
.text-warning { color: #F59E0B; }
.text-error { color: #EF4444; }
.text-muted { color: #6B7280; }

.text-left { text-align: left; }
.text-center { text-align: center; }
.text-right { text-align: right; }
.text-justify { text-align: justify; }

.font-light { font-weight: 300; }
.font-normal { font-weight: 400; }
.font-medium { font-weight: 500; }
.font-semibold { font-weight: 600; }
.font-bold { font-weight: 700; }
.font-extrabold { font-weight: 800; }
"
    css
}
