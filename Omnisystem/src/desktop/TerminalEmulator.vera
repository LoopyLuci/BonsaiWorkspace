        }
    }

    pub fn monokai_theme() -> Self {
        TerminalTheme {
            theme_name: "monokai".to_string(),
            foreground_color: (248, 248, 242),
            background_color: (39, 40, 34),
            cursor_color: (249, 38, 114),
            selection_color: (73, 72, 61),
            ansi_colors: vec![
                (39, 40, 34), (249, 38, 114), (166, 226, 46), (253, 151, 31),
                (102, 217, 239), (174, 129, 255), (161, 239, 228), (248, 248, 242),
