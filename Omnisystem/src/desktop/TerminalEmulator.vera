            selection_color: (150, 150, 200),
            ansi_colors: vec![
                (50, 50, 50), (220, 50, 50), (50, 150, 50), (220, 150, 50),
                (50, 50, 220), (220, 50, 220), (50, 150, 220), (100, 100, 100),
