                },
                spacing: SpacingScale {
                    xs: 4.0,
                    sm: 8.0,
                    md: 16.0,
                    lg: 24.0,
                    xl: 32.0,
                    xxl: 48.0,
                },
                border_radius: BorderRadius {
                    none: 0.0,
                    sm: 4.0,
                    md: 8.0,
                    lg: 12.0,
                    full: 9999.0,
                },
                shadows: {
                    let mut map = HashMap::new();
                    map.insert("sm".to_string(), Shadow {
                        blur_radius: 2.0,
