    // ============================================================================
    // COMPONENT STATE MANAGEMENT
    // ============================================================================

    /// Reactive state container
    pub struct ComponentState {
        pub values: HashMap<String, String>,
        pub listeners: Vec<Box<dyn Fn(StateChange) + Send>>,
    }

    impl ComponentState {
        pub fn new() -> Self {
            Self {
                values: HashMap::new(),
                listeners: Vec::new(),
            }
        }

        pub fn set(&mut self, key: &str, value: String, component_id: String) {
            let old_value = self.values.get(key).cloned().unwrap_or_default();
            self.values.insert(key.to_string(), value.clone());

            let change = StateChange {
                component_id,
                property: key.to_string(),
                old_value,
                new_value: value,
            };

            for listener in &self.listeners {
                listener(change.clone());
            }
        }

        pub fn get(&self, key: &str) -> Option<String> {
            self.values.get(key).cloned()
        }

        pub fn subscribe<F>(&mut self, callback: F)
        where
            F: Fn(StateChange) + Send + 'static,
        {
            self.listeners.push(Box::new(callback));
        }
    }

    /// Data binding descriptor
    #[derive(Clone, Debug)]
    pub struct DataBinding {
        pub source: String,      // Path to data source
        pub target: String,      // Component property
        pub mode: String,        // "one-way", "two-way"
        pub transform: Option<String>, // Transform function
    }

    // ============================================================================
    // ANIMATION FRAMEWORK
    // ============================================================================

    /// Animation keyframe
    #[derive(Clone, Debug)]
    pub struct Keyframe {
        pub time_percent: f32,
        pub values: HashMap<String, f32>,
    }

    /// Animation definition
    #[derive(Clone, Debug)]
    pub struct Animation {
        pub id: String,
        pub name: String,
        pub duration_ms: u32,
        pub delay_ms: u32,
        pub iteration_count: i32,     // -1 for infinite
        pub fill_mode: String,        // "none", "forwards", "backwards", "both"
        pub direction: String,        // "normal", "reverse", "alternate"
        pub easing: String,           // "linear", "ease", "ease-in", "ease-out", "ease-in-out"
        pub keyframes: Vec<Keyframe>,
        pub auto_play: bool,
    }

    impl Animation {
        pub fn new(name: &str, duration_ms: u32) -> Self {
            Self {
                id: format!("anim-{}", uuid::Uuid::new_v4()),
                name: name.to_string(),
                duration_ms,
                delay_ms: 0,
                iteration_count: 1,
                fill_mode: "both".to_string(),
                direction: "normal".to_string(),
                easing: "ease".to_string(),
                keyframes: vec![
                    Keyframe { time_percent: 0.0, values: HashMap::new() },
                    Keyframe { time_percent: 100.0, values: HashMap::new() },
                ],
                auto_play: false,
            }
        }

        pub fn add_keyframe(&mut self, time_percent: f32, values: HashMap<String, f32>) {
            self.keyframes.push(Keyframe { time_percent, values });
            self.keyframes.sort_by(|a, b| a.time_percent.partial_cmp(&b.time_percent).unwrap());
        }
    }

    /// Transition effect
    #[derive(Clone, Debug)]
    pub struct Transition {
        pub property: String,
        pub duration_ms: u32,
        pub delay_ms: u32,
        pub easing: String,
        pub enabled: bool,
    }

    // ============================================================================
    // BASE COMPONENT TRAIT AND IMPLEMENTATION
    // ============================================================================

    /// Base component trait for all UI elements
    pub trait UIComponent: Send + Sync {
        fn get_id(&self) -> String;
        fn get_type(&self) -> String;
        fn render(&self) -> String;
        fn handle_event(&mut self, event: &UIEvent) -> bool;
        fn update_state(&mut self, change: StateChange);
        fn get_state(&self) -> &ComponentState;
        fn get_layout(&self) -> &LayoutConstraint;
        fn set_visible(&mut self, visible: bool);
        fn is_visible(&self) -> bool;
        fn get_bounds(&self) -> (f32, f32, f32, f32); // x, y, width, height
    }

    /// Base component struct
    pub struct Component {
        pub id: String,
        pub component_type: String,
        pub visible: bool,
        pub state: ComponentState,
        pub layout: LayoutConstraint,
        pub theme: Theme,
        pub x: f32,
        pub y: f32,
        pub width: f32,
        pub height: f32,
        pub bindings: Vec<DataBinding>,
        pub animations: Vec<Animation>,
        pub transitions: Vec<Transition>,
        pub disabled: bool,
        pub opacity: f32,
        pub z_index: i32,
        pub cursor: String,
        pub tooltip: Option<String>,
    }

    impl Component {
        pub fn new(id: &str, component_type: &str) -> Self {
            Self {
                id: id.to_string(),
                component_type: component_type.to_string(),
                visible: true,
                state: ComponentState::new(),
                layout: LayoutConstraint {
                    layout_type: LayoutType::Flex,
                    width: LayoutValue::Auto,
                    height: LayoutValue::Auto,
                    padding: Spacing::new(0.0),
                    margin: Spacing::new(0.0),
                    gap: 0.0,
                    flex_direction: FlexDirection::Row,
                    align_items: Alignment::Stretch,
                    justify_content: Alignment::Start,
                    flex_grow: 0.0,
                    flex_shrink: 1.0,
                    flex_basis: LayoutValue::Auto,
                },
                theme: Theme::light(),
                x: 0.0,
                y: 0.0,
                width: 100.0,
                height: 100.0,
                bindings: Vec::new(),
                animations: Vec::new(),
                transitions: Vec::new(),
                disabled: false,
                opacity: 1.0,
                z_index: 0,
                cursor: "default".to_string(),
                tooltip: None,
            }
        }

        pub fn with_size(mut self, width: f32, height: f32) -> Self {
            self.width = width;
            self.height = height;
            self
        }

        pub fn with_position(mut self, x: f32, y: f32) -> Self {
            self.x = x;
            self.y = y;
            self
        }

        pub fn with_layout(mut self, layout: LayoutConstraint) -> Self {
            self.layout = layout;
            self
        }

        pub fn add_binding(mut self, binding: DataBinding) -> Self {
            self.bindings.push(binding);
            self
        }

        pub fn add_animation(mut self, animation: Animation) -> Self {
            self.animations.push(animation);
            self
        }

        pub fn with_tooltip(mut self, tooltip: &str) -> Self {
            self.tooltip = Some(tooltip.to_string());
            self
        }
    }

    // ============================================================================
    // BUILT-IN UI COMPONENTS
    // ============================================================================

    /// Button component
    #[derive(Clone)]
    pub struct Button {
        pub base: Component,
        pub label: String,
        pub variant: String, // "primary", "secondary", "danger", "ghost"
        pub size: String,    // "sm", "md", "lg"
        pub icon: Option<String>,
        pub icon_position: String, // "left", "right"
        pub on_click: Option<Box<dyn Fn() + Send>>,
    }

    impl Button {
        pub fn new(id: &str, label: &str) -> Self {
            Self {
                base: Component::new(id, "Button"),
                label: label.to_string(),
                variant: "primary".to_string(),
                size: "md".to_string(),
                icon: None,
                icon_position: "left".to_string(),
                on_click: None,
            }
        }

        pub fn with_variant(mut self, variant: &str) -> Self {
            self.variant = variant.to_string();
            self
        }

        pub fn with_size(mut self, size: &str) -> Self {
            self.size = size.to_string();
            self
        }

        pub fn with_icon(mut self, icon: &str) -> Self {
            self.icon = Some(icon.to_string());
            self
        }
    }

    impl UIComponent for Button {
        fn get_id(&self) -> String { self.base.id.clone() }
        fn get_type(&self) -> String { "Button".to_string() }
        fn render(&self) -> String {
            format!(
                "<button id=\"{}\" class=\"btn btn-{} btn-{}\" disabled=\"{}\">{}</button>",
                self.base.id,
                self.variant,
                self.size,
                self.base.disabled,
                self.label
            )
        }
        fn handle_event(&mut self, event: &UIEvent) -> bool {
            if event.target_id == self.base.id && event.event_type == EventType::MouseClick {
                if let Some(handler) = &self.on_click {
                    handler();
                }
                return true;
            }
            false
        }
        fn update_state(&mut self, change: StateChange) {
            self.base.state.values.insert(change.property, change.new_value);
        }
        fn get_state(&self) -> &ComponentState { &self.base.state }
        fn get_layout(&self) -> &LayoutConstraint { &self.base.layout }
        fn set_visible(&mut self, visible: bool) { self.base.visible = visible; }
        fn is_visible(&self) -> bool { self.base.visible }
        fn get_bounds(&self) -> (f32, f32, f32, f32) {
            (self.base.x, self.base.y, self.base.width, self.base.height)
        }
    }

    /// TextBox component (input field)
    #[derive(Clone)]
    pub struct TextBox {
        pub base: Component,
        pub placeholder: String,
        pub value: String,
        pub input_type: String, // "text", "password", "email", "number", "url"
        pub max_length: i32,
        pub read_only: bool,
        pub on_change: Option<Box<dyn Fn(String) + Send>>,
    }

    impl TextBox {
        pub fn new(id: &str, placeholder: &str) -> Self {
            Self {
                base: Component::new(id, "TextBox"),
                placeholder: placeholder.to_string(),
                value: String::new(),
                input_type: "text".to_string(),
                max_length: 255,
                read_only: false,
                on_change: None,
            }
        }

        pub fn with_input_type(mut self, input_type: &str) -> Self {
            self.input_type = input_type.to_string();
            self
        }
    }

    impl UIComponent for TextBox {
        fn get_id(&self) -> String { self.base.id.clone() }
        fn get_type(&self) -> String { "TextBox".to_string() }
        fn render(&self) -> String {
            format!(
                "<input id=\"{}\" type=\"{}\" placeholder=\"{}\" value=\"{}\" maxlength=\"{}\" readonly=\"{}\"/>",
                self.base.id, self.input_type, self.placeholder, self.value, self.max_length, self.read_only
            )
        }
        fn handle_event(&mut self, event: &UIEvent) -> bool {
            if event.target_id == self.base.id && event.event_type == EventType::Change {
                if let Some(value) = event.data.get("value") {
                    self.value = value.clone();
                    if let Some(handler) = &self.on_change {
                        handler(value.clone());
                    }
                }
                return true;
            }
            false
        }
        fn update_state(&mut self, change: StateChange) {
            if change.property == "value" {
                self.value = change.new_value;
            }
        }
        fn get_state(&self) -> &ComponentState { &self.base.state }
        fn get_layout(&self) -> &LayoutConstraint { &self.base.layout }
        fn set_visible(&mut self, visible: bool) { self.base.visible = visible; }
        fn is_visible(&self) -> bool { self.base.visible }
        fn get_bounds(&self) -> (f32, f32, f32, f32) {
            (self.base.x, self.base.y, self.base.width, self.base.height)
        }
    }

    /// Label component
    #[derive(Clone)]
    pub struct Label {
        pub base: Component,
        pub text: String,
        pub font_size: f32,
        pub font_weight: i32,
        pub color: String,
        pub text_align: String,
    }

    impl Label {
        pub fn new(id: &str, text: &str) -> Self {
            Self {
                base: Component::new(id, "Label"),
                text: text.to_string(),
                font_size: 14.0,
                font_weight: 400,
                color: "#000000".to_string(),
                text_align: "left".to_string(),
            }
        }
    }

    impl UIComponent for Label {
        fn get_id(&self) -> String { self.base.id.clone() }
        fn get_type(&self) -> String { "Label".to_string() }
        fn render(&self) -> String {
            format!(
                "<label id=\"{}\" style=\"font-size:{}px;font-weight:{};color:{};text-align:{}\">{}</label>",
                self.base.id, self.font_size, self.font_weight, self.color, self.text_align, self.text
            )
        }
        fn handle_event(&mut self, _event: &UIEvent) -> bool { false }
        fn update_state(&mut self, change: StateChange) {
            if change.property == "text" {
                self.text = change.new_value;
            }
        }
        fn get_state(&self) -> &ComponentState { &self.base.state }
        fn get_layout(&self) -> &LayoutConstraint { &self.base.layout }
        fn set_visible(&mut self, visible: bool) { self.base.visible = visible; }
        fn is_visible(&self) -> bool { self.base.visible }
        fn get_bounds(&self) -> (f32, f32, f32, f32) {
            (self.base.x, self.base.y, self.base.width, self.base.height)
        }
    }

    /// Checkbox component
    #[derive(Clone)]
    pub struct Checkbox {
        pub base: Component,
        pub label: String,
        pub checked: bool,
        pub on_change: Option<Box<dyn Fn(bool) + Send>>,
    }

    impl Checkbox {
        pub fn new(id: &str, label: &str) -> Self {
            Self {
                base: Component::new(id, "Checkbox"),
                label: label.to_string(),
                checked: false,
                on_change: None,
            }
        }
    }

    impl UIComponent for Checkbox {
        fn get_id(&self) -> String { self.base.id.clone() }
        fn get_type(&self) -> String { "Checkbox".to_string() }
        fn render(&self) -> String {
            format!(
                "<input id=\"{}\" type=\"checkbox\" checked=\"{}\" /><label for=\"{}\">{}</label>",
                self.base.id, self.checked, self.base.id, self.label
            )
        }
        fn handle_event(&mut self, event: &UIEvent) -> bool {
            if event.target_id == self.base.id && event.event_type == EventType::Change {
                self.checked = !self.checked;
                if let Some(handler) = &self.on_change {
                    handler(self.checked);
                }
                return true;
            }
            false
        }
        fn update_state(&mut self, change: StateChange) {
            if change.property == "checked" {
                self.checked = change.new_value == "true";
            }
        }
        fn get_state(&self) -> &ComponentState { &self.base.state }
        fn get_layout(&self) -> &LayoutConstraint { &self.base.layout }
