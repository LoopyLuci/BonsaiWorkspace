    pub struct ListBox {
        pub base: Component,
        pub items: Vec<String>,
        pub selected_indices: Vec<i32>,
        pub multiple: bool,
        pub on_selection_change: Option<Box<dyn Fn(Vec<i32>) + Send>>,
    }

    impl ListBox {
        pub fn new(id: &str) -> Self {
            Self {
                base: Component::new(id, "ListBox"),
                items: Vec::new(),
                selected_indices: Vec::new(),
                multiple: true,
                on_selection_change: None,
            }
        }

        pub fn add_item(mut self, item: String) -> Self {
            self.items.push(item);
            self
        }
    }

    impl UIComponent for ListBox {
        fn get_id(&self) -> String { self.base.id.clone() }
        fn get_type(&self) -> String { "ListBox".to_string() }
        fn render(&self) -> String {
            format!(
                "<select id=\"{}\" multiple=\"{}\" style=\"width:{}px;height:{}px\">{}</select>",
                self.base.id,
                self.multiple,
                self.base.width,
                self.base.height,
                self.items.iter().enumerate()
                    .map(|(i, item)| format!(
                        "<option selected=\"{}\">{}</option>",
                        self.selected_indices.contains(&(i as i32)),
                        item
                    ))
                    .collect::<Vec<_>>()
                    .join("")
            )
        }
        fn handle_event(&mut self, event: &UIEvent) -> bool {
            if event.target_id == self.base.id && event.event_type == EventType::Change {
                // In real implementation, parse selected indices from event
                return true;
            }
            false
        }
        fn update_state(&mut self, change: StateChange) {
            if change.property == "selected" {
                self.selected_indices = change.new_value
                    .split(',')
                    .filter_map(|s| s.trim().parse().ok())
                    .collect();
            }
        }
        fn get_state(&self) -> &ComponentState { &self.base.state }
        fn get_layout(&self) -> &LayoutConstraint { &self.base.layout }
        fn set_visible(&mut self, visible: bool) { self.base.visible = visible; }
        fn is_visible(&self) -> bool { self.base.visible }
        fn get_bounds(&self) -> (f32, f32, f32, f32) {
            (self.base.x, self.base.y, self.base.width, self.base.height)
        }
    }

