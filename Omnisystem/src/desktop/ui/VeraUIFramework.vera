        fn is_visible(&self) -> bool { self.base.visible }
        fn get_bounds(&self) -> (f32, f32, f32, f32) {
            (self.base.x, self.base.y, self.base.width, self.base.height)
        }
    }

    /// Image component
    #[derive(Clone)]
    pub struct Image {
        pub base: Component,
        pub source: String,
        pub alt_text: String,
        pub fit: String, // "cover", "contain", "fill", "scale-down"
        pub loading: String, // "lazy", "eager"
    }

    impl Image {
        pub fn new(id: &str, source: &str) -> Self {
            Self {
                base: Component::new(id, "Image"),
                source: source.to_string(),
                alt_text: String::new(),
                fit: "cover".to_string(),
                loading: "lazy".to_string(),
            }
        }
    }

    impl UIComponent for Image {
        fn get_id(&self) -> String { self.base.id.clone() }
        fn get_type(&self) -> String { "Image".to_string() }
        fn render(&self) -> String {
            format!(
                "<img id=\"{}\" src=\"{}\" alt=\"{}\" style=\"width:{}px;height:{}px;object-fit:{}\" loading=\"{}\" />",
                self.base.id, self.source, self.alt_text, self.base.width, self.base.height, self.fit, self.loading
            )
        }
        fn handle_event(&mut self, _event: &UIEvent) -> bool { false }
        fn update_state(&mut self, change: StateChange) {
            if change.property == "source" {
                self.source = change.new_value;
            }
        }
        fn get_state(&self) -> &ComponentState { &self.base.state }
        fn get_layout(&self) -> &LayoutConstraint { &self.base.layout }
        fn set_visible(&mut self, visible: bool) { self.base.visible = visible; }
        fn is_visible(&self) -> bool { self.base.visible }
        fn get_bounds(&self) -> (f32, f32, f32, f32) {
            (self.base.x, self.base.y, self.base.width, self.base.height)
        }
    }

    // ============================================================================
    // LAYOUT ENGINE - FLEX AND GRID SYSTEMS
    // ============================================================================

    pub struct LayoutEngine {
        pub viewport_width: f32,
        pub viewport_height: f32,
        pub dpi_scale: f32,
    }

    impl LayoutEngine {
        pub fn new(width: f32, height: f32) -> Self {
            Self {
                viewport_width: width,
                viewport_height: height,
                dpi_scale: 1.0,
            }
        }

        pub fn calculate_layout(&self, constraint: &LayoutConstraint) -> (f32, f32) {
            let width = match &constraint.width {
                LayoutValue::Pixels(px) => *px,
                LayoutValue::Percent(pct) => self.viewport_width * (pct / 100.0),
                LayoutValue::Auto => 100.0,
                LayoutValue::Fit => 100.0,
                LayoutValue::Grow(_) => self.viewport_width,
            };

            let height = match &constraint.height {
                LayoutValue::Pixels(px) => *px,
                LayoutValue::Percent(pct) => self.viewport_height * (pct / 100.0),
                LayoutValue::Auto => 100.0,
                LayoutValue::Fit => 100.0,
                LayoutValue::Grow(_) => self.viewport_height,
            };

            (width, height)
        }

        pub fn set_dpi_scale(&mut self, scale: f32) {
            self.dpi_scale = scale;
        }

        pub fn scale_to_dpi(&self, value: f32) -> f32 {
            value * self.dpi_scale
        }
    }

    // ============================================================================
    // EVENT DISPATCHER
    // ============================================================================

    pub struct EventDispatcher {
        pub listeners: HashMap<String, Vec<Box<dyn Fn(&UIEvent) + Send>>>,
    }

    impl EventDispatcher {
        pub fn new() -> Self {
            Self {
                listeners: HashMap::new(),
            }
        }

        pub fn on<F>(&mut self, event_type: &str, callback: F)
        where
            F: Fn(&UIEvent) + Send + 'static,
        {
            self.listeners
                .entry(event_type.to_string())
                .or_insert_with(Vec::new)
                .push(Box::new(callback));
        }

        pub fn dispatch(&self, event: &UIEvent) {
            let event_key = format!("{:?}", event.event_type);
            if let Some(callbacks) = self.listeners.get(&event_key) {
                for callback in callbacks {
                    callback(event);
                }
            }
        }
    }

    // ============================================================================
    // VERA UI FRAMEWORK MAIN CLASS
    // ============================================================================

    pub struct VeraUIFramework {
        pub version: String,
        pub theme: Theme,
        pub layout_engine: LayoutEngine,
        pub event_dispatcher: EventDispatcher,
        pub components: HashMap<String, Box<dyn UIComponent>>,
        pub root_component: Option<Box<dyn UIComponent>>,
        pub accessibility_enabled: bool,
        pub dpi_aware: bool,
    }

    impl VeraUIFramework {
        pub fn new(version: &str) -> Self {
            Self {
                version: version.to_string(),
                theme: Theme::light(),
                layout_engine: LayoutEngine::new(1920.0, 1080.0),
                event_dispatcher: EventDispatcher::new(),
                components: HashMap::new(),
                root_component: None,
                accessibility_enabled: true,
                dpi_aware: true,
            }
        }

        pub fn set_theme(&mut self, theme: Theme) {
            self.theme = theme;
        }

        pub fn get_theme(&self) -> &Theme {
            &self.theme
        }

        pub fn register_component(&mut self, component: Box<dyn UIComponent>) {
            let id = component.get_id();
            self.components.insert(id, component);
        }

        pub fn set_viewport(&mut self, width: f32, height: f32) {
            self.layout_engine.viewport_width = width;
            self.layout_engine.viewport_height = height;
        }

        pub fn set_dpi_scale(&mut self, scale: f32) {
            self.layout_engine.set_dpi_scale(scale);
            self.theme.dpi_scale = scale;
        }

        pub fn handle_event(&mut self, event: UIEvent) {
            self.event_dispatcher.dispatch(&event);

            if let Some(root) = &mut self.root_component {
                root.handle_event(&event);
            }
        }

        pub fn render(&self) -> String {
            if let Some(root) = &self.root_component {
                root.render()
            } else {
                "<div>No root component</div>".to_string()
            }
        }

        pub fn enable_accessibility(&mut self, enabled: bool) {
            self.accessibility_enabled = enabled;
            self.theme.accessibility_enabled = enabled;
        }

        pub fn create_animation(&self, name: &str, duration_ms: u32) -> Animation {
            Animation::new(name, duration_ms)
        }
    }

    // ============================================================================
    // ACCESSIBILITY SUPPORT
    // ============================================================================

    pub struct AccessibilityContext {
        pub screen_reader_enabled: bool,
        pub high_contrast_enabled: bool,
        pub reduced_motion_enabled: bool,
        pub font_size_multiplier: f32,
        pub keyboard_navigation_enabled: bool,
    }

    impl AccessibilityContext {
        pub fn new() -> Self {
            Self {
                screen_reader_enabled: false,
                high_contrast_enabled: false,
                reduced_motion_enabled: false,
                font_size_multiplier: 1.0,
                keyboard_navigation_enabled: true,
            }
        }

        pub fn apply_wcag_aaa_compliance(&mut self) {
            self.screen_reader_enabled = true;
            self.keyboard_navigation_enabled = true;
            self.high_contrast_enabled = true;
        }
    }

