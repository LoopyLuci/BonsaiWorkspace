                "<div id=\"{}\" style=\"background-color:{};border:{} {}px;border-radius:{}px\" class=\"panel\"></div>",
                self.base.id,
                self.background_color,
                self.border_color,
                self.border_width,
                self.border_radius
            )
        }
        fn handle_event(&mut self, event: &UIEvent) -> bool {
            for child in &mut self.children {
                if child.handle_event(event) {
                    return true;
                }
            }
            false
        }
        fn update_state(&mut self, change: StateChange) {
            self.base.state.values.insert(change.property, change.new_value);
