    /// RadioButton component
    #[derive(Clone)]
    pub struct RadioButton {
        pub base: Component,
        pub label: String,
        pub selected: bool,
        pub group: String,
        pub value: String,
        pub on_change: Option<Box<dyn Fn(bool) + Send>>,
    }

    impl RadioButton {
        pub fn new(id: &str, label: &str, group: &str, value: &str) -> Self {
            Self {
                base: Component::new(id, "RadioButton"),
                label: label.to_string(),
                selected: false,
                group: group.to_string(),
                value: value.to_string(),
                on_change: None,
            }
        }
    }

    impl UIComponent for RadioButton {
        fn get_id(&self) -> String { self.base.id.clone() }
        fn get_type(&self) -> String { "RadioButton".to_string() }
        fn render(&self) -> String {
            format!(
                "<input id=\"{}\" type=\"radio\" name=\"{}\" value=\"{}\" checked=\"{}\" /><label for=\"{}\">{}</label>",
                self.base.id, self.group, self.value, self.selected, self.base.id, self.label
            )
        }
        fn handle_event(&mut self, event: &UIEvent) -> bool {
            if event.target_id == self.base.id && event.event_type == EventType::Change {
                self.selected = true;
                if let Some(handler) = &self.on_change {
                    handler(self.selected);
                }
                return true;
            }
            false
        }
        fn update_state(&mut self, change: StateChange) {
            if change.property == "selected" {
                self.selected = change.new_value == "true";
            }
        }
        fn get_state(&self) -> &ComponentState { &self.base.state }
        fn get_layout(&self) -> &LayoutConstraint { &self.base.layout }
        fn set_visible(&mut self, visible: bool) { self.base.visible = visible; }
        fn is_visible(&self) -> bool { self.base.visible }
        fn get_bounds(&self) -> (f32, f32, f32, f32) {
            (self.base.x, self.base.y, self.base.width, self.base.height)
        }
    }

    /// Dropdown/ComboBox component
    #[derive(Clone)]
    pub struct Dropdown {
        pub base: Component,
        pub items: Vec<String>,
        pub selected_index: i32,
        pub placeholder: String,
        pub is_open: bool,
        pub on_change: Option<Box<dyn Fn(i32, String) + Send>>,
    }

    impl Dropdown {
        pub fn new(id: &str, placeholder: &str) -> Self {
            Self {
                base: Component::new(id, "Dropdown"),
                items: Vec::new(),
                selected_index: -1,
                placeholder: placeholder.to_string(),
                is_open: false,
                on_change: None,
            }
        }

        pub fn add_item(mut self, item: String) -> Self {
            self.items.push(item);
            self
        }
    }

    impl UIComponent for Dropdown {
        fn get_id(&self) -> String { self.base.id.clone() }
        fn get_type(&self) -> String { "Dropdown".to_string() }
        fn render(&self) -> String {
            let selected = if self.selected_index >= 0 && (self.selected_index as usize) < self.items.len() {
                self.items[self.selected_index as usize].clone()
            } else {
                self.placeholder.clone()
            };
            format!(
                "<select id=\"{}\" style=\"width:{}px;height:{}px\">{}</select>",
                self.base.id,
                self.base.width,
                self.base.height,
                self.items.iter().enumerate()
                    .map(|(i, item)| format!(
                        "<option value=\"{}\" selected=\"{}\">{}</option>",
                        i, i as i32 == self.selected_index, item
                    ))
                    .collect::<Vec<_>>()
                    .join("")
            )
        }
        fn handle_event(&mut self, event: &UIEvent) -> bool {
            if event.target_id == self.base.id && event.event_type == EventType::Change {
                if let Some(value) = event.data.get("value") {
                    if let Ok(index) = value.parse::<i32>() {
                        let old_index = self.selected_index;
                        self.selected_index = index;
                        if old_index != index && index >= 0 && (index as usize) < self.items.len() {
                            if let Some(handler) = &self.on_change {
                                handler(index, self.items[index as usize].clone());
                            }
                        }
                        return true;
                    }
                }
            }
            false
        }
        fn update_state(&mut self, change: StateChange) {
            if change.property == "selected" {
                if let Ok(index) = change.new_value.parse::<i32>() {
                    self.selected_index = index;
                }
            }
        }
        fn get_state(&self) -> &ComponentState { &self.base.state }
        fn get_layout(&self) -> &LayoutConstraint { &self.base.layout }
        fn set_visible(&mut self, visible: bool) { self.base.visible = visible; }
        fn is_visible(&self) -> bool { self.base.visible }
        fn get_bounds(&self) -> (f32, f32, f32, f32) {
            (self.base.x, self.base.y, self.base.width, self.base.height)
        }
    }

