        pub size_xs: f32,
        pub size_sm: f32,
        pub size_base: f32,
        pub size_lg: f32,
        pub size_xl: f32,
        pub size_2xl: f32,
        pub weight_light: i32,
        pub weight_normal: i32,
        pub weight_semibold: i32,
        pub weight_bold: i32,
        pub line_height_tight: f32,
        pub line_height_normal: f32,
        pub line_height_relaxed: f32,
    }

    /// Spacing scale
    #[derive(Clone, Debug)]
    pub struct SpacingScale {
        pub xs: f32,
        pub sm: f32,
        pub md: f32,
        pub lg: f32,
        pub xl: f32,
        pub xxl: f32,
    }

    /// Border radius values
    #[derive(Clone, Debug)]
    pub struct BorderRadius {
        pub none: f32,
        pub sm: f32,
        pub md: f32,
        pub lg: f32,
        pub full: f32,
    }

    /// Shadow definitions
    #[derive(Clone, Debug)]
    pub struct Shadow {
        pub blur_radius: f32,
        pub spread_radius: f32,
        pub offset_x: f32,
        pub offset_y: f32,
        pub color: String,
        pub opacity: f32,
    }

    /// Complete theme definition
    #[derive(Clone, Debug)]
    pub struct Theme {
        pub name: String,
        pub mode: String, // "light", "dark", "auto"
        pub colors: ColorPalette,
        pub typography: Typography,
        pub spacing: SpacingScale,
        pub border_radius: BorderRadius,
        pub shadows: HashMap<String, Shadow>,
        pub transitions: HashMap<String, String>,
        pub dpi_scale: f32,
        pub accessibility_enabled: bool,
    }

