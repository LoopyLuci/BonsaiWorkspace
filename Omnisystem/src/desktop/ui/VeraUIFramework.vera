    /// TabControl component
    #[derive(Clone)]
    pub struct TabControl {
        pub base: Component,
        pub tabs: Vec<Tab>,
        pub active_tab: i32,
        pub on_tab_change: Option<Box<dyn Fn(i32) + Send>>,
    }

    #[derive(Clone)]
    pub struct Tab {
        pub id: String,
        pub label: String,
        pub icon: Option<String>,
        pub content: String,
        pub closeable: bool,
    }

    impl TabControl {
        pub fn new(id: &str) -> Self {
            Self {
                base: Component::new(id, "TabControl"),
                tabs: Vec::new(),
                active_tab: 0,
                on_tab_change: None,
            }
        }

        pub fn add_tab(mut self, tab: Tab) -> Self {
            self.tabs.push(tab);
            self
        }
    }

    impl UIComponent for TabControl {
        fn get_id(&self) -> String { self.base.id.clone() }
        fn get_type(&self) -> String { "TabControl".to_string() }
        fn render(&self) -> String {
            format!(
                "<div id=\"{}\" class=\"tabs\"><div class=\"tab-headers\">{}</div><div class=\"tab-content\">{}</div></div>",
                self.base.id,
                self.tabs.iter().enumerate()
                    .map(|(i, tab)| format!(
                        "<button class=\"tab-header {}\" data-tab=\"{}\">{}</button>",
                        if i as i32 == self.active_tab { "active" } else { "" },
                        i,
                        tab.label
                    ))
                    .collect::<Vec<_>>()
                    .join(""),
                self.tabs.get(self.active_tab as usize)
                    .map(|tab| tab.content.clone())
                    .unwrap_or_default()
            )
        }
        fn handle_event(&mut self, event: &UIEvent) -> bool {
            if event.target_id == self.base.id && event.event_type == EventType::MouseClick {
                if let Some(tab_str) = event.data.get("tab") {
                    if let Ok(index) = tab_str.parse::<i32>() {
                        if index >= 0 && (index as usize) < self.tabs.len() {
                            self.active_tab = index;
                            if let Some(handler) = &self.on_tab_change {
                                handler(index);
                            }
                            return true;
                        }
                    }
                }
            }
            false
        }
        fn update_state(&mut self, change: StateChange) {
            if change.property == "active_tab" {
                if let Ok(index) = change.new_value.parse::<i32>() {
                    self.active_tab = index;
                }
            }
        }
        fn get_state(&self) -> &ComponentState { &self.base.state }
        fn get_layout(&self) -> &LayoutConstraint { &self.base.layout }
        fn set_visible(&mut self, visible: bool) { self.base.visible = visible; }
        fn is_visible(&self) -> bool { self.base.visible }
        fn get_bounds(&self) -> (f32, f32, f32, f32) {
            (self.base.x, self.base.y, self.base.width, self.base.height)
        }
    }

