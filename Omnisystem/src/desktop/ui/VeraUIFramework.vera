    /// Slider component
    #[derive(Clone)]
    pub struct Slider {
        pub base: Component,
        pub min: f32,
        pub max: f32,
        pub value: f32,
        pub step: f32,
        pub orientation: String, // "horizontal", "vertical"
        pub on_change: Option<Box<dyn Fn(f32) + Send>>,
    }

    impl Slider {
        pub fn new(id: &str, min: f32, max: f32) -> Self {
            Self {
                base: Component::new(id, "Slider"),
                min,
                max,
                value: (min + max) / 2.0,
                step: 1.0,
                orientation: "horizontal".to_string(),
                on_change: None,
            }
        }
    }

    impl UIComponent for Slider {
        fn get_id(&self) -> String { self.base.id.clone() }
        fn get_type(&self) -> String { "Slider".to_string() }
        fn render(&self) -> String {
            format!(
                "<input id=\"{}\" type=\"range\" min=\"{}\" max=\"{}\" value=\"{}\" step=\"{}\" />",
                self.base.id, self.min, self.max, self.value, self.step
            )
        }
        fn handle_event(&mut self, event: &UIEvent) -> bool {
            if event.target_id == self.base.id && event.event_type == EventType::Change {
                if let Some(value_str) = event.data.get("value") {
                    if let Ok(value) = value_str.parse::<f32>() {
                        self.value = value;
                        if let Some(handler) = &self.on_change {
                            handler(value);
                        }
                        return true;
                    }
                }
            }
            false
        }
        fn update_state(&mut self, change: StateChange) {
            if change.property == "value" {
                if let Ok(value) = change.new_value.parse::<f32>() {
                    self.value = value;
                }
            }
        }
        fn get_state(&self) -> &ComponentState { &self.base.state }
        fn get_layout(&self) -> &LayoutConstraint { &self.base.layout }
        fn set_visible(&mut self, visible: bool) { self.base.visible = visible; }
        fn is_visible(&self) -> bool { self.base.visible }
        fn get_bounds(&self) -> (f32, f32, f32, f32) {
            (self.base.x, self.base.y, self.base.width, self.base.height)
        }
    }

