// Phase 1: Event Bus System
// Distributed event publishing and subscription
// Replaces: src/desktop/phase1_event_bus.aether (100% rewrite in AETHER)

use omnisystem::{HashMap, Vec, String, Option, Result}
use omnisystem::time::SystemTime

struct Event {
    event_type: String,
    source: String,
    data: Vec<u8>,
    timestamp: i64,
    priority: i32
}

struct EventSubscription {
    subscriber_id: String,
    event_type: String,
    handler: ActorRef<EventHandler>
}

// Event handler actor (receives events)
actor EventHandler {
    id: String,

    message ProcessEvent(event: Event) -> Result<(), String> {
        println("EventHandler {} received event: {}", id, event.event_type)
        return Ok(())
    }
}

// Main event bus (pub/sub coordinator)
actor EventBus {
    subscriptions: Vec<EventSubscription> = Vec::new(),
    event_queue: Vec<Event> = Vec::new(),
    handlers: HashMap<String, Vec<ActorRef<EventHandler>>> = HashMap::new()

    message Subscribe(event_type: String, handler: ActorRef<EventHandler>) -> Result<(), String> {
        println("Subscription added for event type: {}", event_type)

        if !handlers.contains_key(&event_type) {
            handlers.insert(event_type.clone(), Vec::new())
        }

        handlers.get_mut(&event_type).push(handler)
        return Ok(())
    }

    message Unsubscribe(event_type: String, handler_id: String) -> Result<(), String> {
        if let Some(handlers_list) = handlers.get_mut(&event_type) {
            // Note: Would need handler equality check in real implementation
            println("Handler removed from event type: {}", event_type)
        }
        return Ok(())
    }

    message Publish(event: Event) -> Result<(), String> {
        let event_type = event.event_type.clone()

        match handlers.get(&event_type) {
            Some(handlers_list) => {
                // Distribute event to all handlers
                for handler in handlers_list {
                    handler.send(EventHandler::ProcessEvent(event.clone()))
                }
                println("Event published to {} handlers", handlers_list.len())
                return Ok(())
            },
            None => {
                println("No handlers for event type: {}", event_type)
                return Ok(())
            }
        }
    }

    message PublishPriority(event: Event, priority: i32) -> Result<(), String> {
        let mut prioritized_event = event.clone()
        prioritized_event.priority = priority

        // Enqueue and sort by priority
        event_queue.push(prioritized_event)

        return Ok(())
    }

    message ProcessQueue() -> Result<(), String> {
        // Sort by priority (higher first)
        event_queue.sort_by_key(|e| -e.priority)

        for event in event_queue.clone() {
            let event_type = event.event_type.clone()

            match handlers.get(&event_type) {
                Some(handlers_list) => {
                    for handler in handlers_list {
                        handler.send(EventHandler::ProcessEvent(event.clone()))
                    }
                },
                None => {}
            }
        }

        event_queue.clear()
        return Ok(())
    }

    message GetSubscriptionCount(event_type: String) -> i32 {
        return handlers.get(&event_type)
            .map(|handlers| handlers.len())
            .unwrap_or(0)
    }
}

// Test harness
async fn test_event_bus() -> Result<(), String> {
    println("Starting Event Bus test")

    let bus: ActorRef<EventBus> = spawn(EventBus)

    // Create handlers
    let handler1: ActorRef<EventHandler> = spawn(EventHandler {
        id: "handler1".to_string()
    })

    let handler2: ActorRef<EventHandler> = spawn(EventHandler {
        id: "handler2".to_string()
    })

    // Subscribe to events
    await bus.call(EventBus::Subscribe(
        "window_created".to_string(),
        handler1
    ))?

    await bus.call(EventBus::Subscribe(
        "window_created".to_string(),
        handler2
    ))?

    // Publish events
    for i in 0..3 {
        let event = Event {
            event_type: "window_created".to_string(),
            source: "desktop".to_string(),
            data: vec![i as u8],
            timestamp: SystemTime::now().secs(),
            priority: 1
        }

        await bus.call(EventBus::Publish(event))?
    }

    // Check subscription count
    let count = await bus.call(EventBus::GetSubscriptionCount("window_created".to_string()))?
    println("Total subscribers: {}", count)

    return Ok(())
}

fn main() -> Result<(), String> {
    test_event_bus().await
}
