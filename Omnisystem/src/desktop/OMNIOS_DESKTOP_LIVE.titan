    message OpenApplication(app_name: String) -> Result<(), String> {
        println!("\n🚀 Opening {}...\n", app_name);

        open_windows.lock().unwrap().push(app_name.clone())

        match app_name.as_str() {
            "Terminal" => self.OpenTerminal()?,
            "FileManager" => self.OpenFileManager()?,
            "TextEditor" => self.OpenTextEditor()?,
            "Browser" => self.OpenBrowser()?,
            "IDE" => self.OpenIDE()?,
            _ => {
                println!("✅ {} is now open", app_name);
            }
        }

        Ok(())
    }

