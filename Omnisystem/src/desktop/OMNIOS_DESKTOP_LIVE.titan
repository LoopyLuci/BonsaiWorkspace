    message GetSystemStats() -> HashMap<String, String> {
        let mut stats: HashMap<String, String> = HashMap::new()
        stats.insert("os".to_string(), "OmniOS v1.0".to_string())
        stats.insert("cpu_usage".to_string(), format!("{}%", self.cpu_usage as i32))
        stats.insert("gpu_usage".to_string(), format!("{}%", self.gpu_usage as i32))
        stats.insert("memory".to_string(), format!("{}MB", self.memory_usage_mb))
        stats.insert("fps".to_string(), format!("{}", self.current_fps as i32))
        stats.insert("status".to_string(), "RUNNING".to_string())
        stats
    }
}

async fn run_omnios_desktop() -> Result<(), String> {
    let mut desktop = OmniOSDesktopEnvironment {
        display_width: 1920,
        display_height: 1080,
        gpu_renderer: "Vulkan".to_string(),
        fps_target: 60,
        current_fps: 62.5,
        desktop_active: false,
        theme: "dark".to_string(),
        taskbar_open: true,
        open_windows: Arc::new(Mutex::new(Vec::new())),
        cpu_usage: 15.0,
        memory_usage_mb: 1800,
        gpu_usage: 25.0,
        uptime_seconds: 0
    }

    // Initialize and run desktop
    desktop.InitializeDesktop()?
    desktop.RenderDesktopUI()?
    desktop.ShowSystemInfo()?
    desktop.RunLiveTerminalSession()?

    // Keep desktop running
    println!("\n✅ OmniOS Desktop is now running");
    println!("   All systems operational");
    println!("   Ready for user interaction");
    println!("\n   Applications available: Terminal, File Manager, Text Editor, Browser, IDE, and more");
    println!("   Type commands in the terminal or click applications to interact");

    Ok(())
}
