fn main() {
    let mut launcher = OmnisystemAppLauncher::new();

    match launcher.launch() {
        Ok(_) => {
            println!("✓ Omnisystem Desktop Environment execution complete.\n");
            std::process::exit(0);
        }
        Err(e) => {
            println!("✗ Fatal error: {}\n", e);
            std::process::exit(1);
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_launcher_creation() {
        let launcher = OmnisystemAppLauncher::new();
        assert_eq!(launcher.version, "32.0.0");
        assert_eq!(launcher.resolution, (1400, 900));
    }
}
