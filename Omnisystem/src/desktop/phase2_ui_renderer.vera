// Phase 2: UI Renderer Component System
// Foundational UI rendering and component framework
// Replaces: phase 2 UI rendering (100% rewrite in VERA)

component Window {
    title: String = "Omnisystem Window",
    width: i32 = 800,
    height: i32 = 600,
    is_visible: State<bool> = true,

    fn close() -> void {
        is_visible = false
    }

    view {
        <Window title={ title } width={ width } height={ height } visible={ is_visible }>
            <slot />
        </Window>
    }
}

component Button {
    label: String,
    onClick: fn() -> void,
    is_disabled: bool = false,

    fn handle_click() -> void {
        if !is_disabled {
            onClick()
        }
    }

    view {
        <button
            onClick={ handle_click }
            disabled={ is_disabled }
        >
            { label }
        </button>
    }
}

component TextField {
    placeholder: String = "",
    value: State<String> = "",
    onChange: fn(String) -> void = |s| {},

    fn handle_change(new_value: String) -> void {
        value = new_value
        onChange(new_value)
    }

    view {
        <input
            type="text"
            placeholder={ placeholder }
            value={ value }
            onChange={ handle_change }
        />
    }
}

component Text {
    content: String,
    color: String = "inherit",
    size: String = "16px",

    view {
        <span style={ "color: " + color + "; font-size: " + size }>
            { content }
        </span>
    }
}

component VStack {
    gap: String = "8px",

    view {
        <div style={ "display: flex; flex-direction: column; gap: " + gap }>
            <slot />
        </div>
    }
}

component HStack {
    gap: String = "8px",

    view {
        <div style={ "display: flex; flex-direction: row; gap: " + gap }>
            <slot />
        </div>
    }
}

component Grid {
    columns: i32 = 3,
    gap: String = "16px",

    fn column_template() -> String {
        let mut template = "repeat("
        template.push_str(columns.to_string())
        template.push_str(", 1fr)")
        return template
    }

    view {
        <div style={ "display: grid; grid-template-columns: " + column_template() + "; gap: " + gap }>
            <slot />
        </div>
    }
}

component Card {
    title: String = "",
    padding: String = "16px",

    view {
        <div style={ "border: 1px solid #ccc; border-radius: 4px; padding: " + padding }>
            {if title.len() > 0 {
                <h3>{ title }</h3>
            }}
            <slot />
        </div>
    }
}

component Modal {
    is_open: State<bool> = false,
    title: String = "Modal",

    fn close() -> void {
        is_open = false
    }

    view {
        {if is_open {
            <div style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5);">
                <div style="position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); background: white; padding: 20px; border-radius: 8px; min-width: 400px;">
                    <h2>{ title }</h2>
                    <slot />
                    <Button label="Close" onClick={ close } />
                </div>
            </div>
        }}
    }
}

component ProgressBar {
    value: i32 = 0,
    max: i32 = 100,

    fn percentage() -> i32 {
        return (value * 100) / max
    }

    view {
        <div style="width: 100%; height: 20px; background: #eee; border-radius: 4px; overflow: hidden;">
            <div style={ "width: " + percentage().to_string() + "%; height: 100%; background: #4CAF50; transition: width 200ms" }></div>
        </div>
    }
}

component Dropdown {
    label: String,
    options: [String] = [],
    selected: State<String> = "",
    onChange: fn(String) -> void = |s| {},

    fn handle_select(value: String) -> void {
        selected = value
        onChange(value)
    }

    view {
        <select onChange={ handle_select }>
            {for option in options {
                <option value={ option } selected={ selected == option }>
                    { option }
                </option>
            }}
        </select>
    }
}

component Tabs {
    tabs: [(String, String)] = [],
    active_tab: State<i32> = 0,

    fn switch_tab(index: i32) -> void {
        active_tab = index
    }

    view {
        <div>
            <div style="display: flex; border-bottom: 1px solid #ccc;">
                {for (i, (label, _)) in tabs.enumerate() {
                    <button
                        style={ if i == active_tab { "border-bottom: 2px solid blue;" } else { "" } }
                        onClick={ || switch_tab(i) }
                    >
                        { label }
                    </button>
                }}
            </div>
            {if active_tab >= 0 && active_tab < tabs.len() {
                <div>
                    { tabs[active_tab].1 }
                </div>
            }}
        </div>
    }
}

// Integration test component
component RenderTest {
    counter: State<i32> = 0,
    name: State<String> = "",

    fn increment() -> void {
        counter = counter + 1
    }

    fn update_name(new_name: String) -> void {
        name = new_name
    }

    view {
        <Window title="Omnisystem Renderer Test" width={ 600 } height={ 500 }>
            <VStack gap="16px">
                <Text content={ "Welcome to Omnisystem UI Renderer" } size="24px" />

                <Card title="Counter Demo">
                    <Text content={ "Count: " + counter.to_string() } />
                    <Button label="Increment" onClick={ increment } />
                </Card>

                <Card title="Text Input">
                    <TextField
                        placeholder="Enter your name"
                        value={ name }
                        onChange={ update_name }
                    />
                    {if name.len() > 0 {
                        <Text content={ "Hello, " + name + "!" } />
                    }}
                </Card>

                <Card title="Progress">
                    <ProgressBar value={ counter } max={ 10 } />
                </Card>

                <Grid columns={ 2 }>
                    <Card title="Card 1">Content A</Card>
                    <Card title="Card 2">Content B</Card>
                    <Card title="Card 3">Content C</Card>
                    <Card title="Card 4">Content D</Card>
                </Grid>
            </VStack>
        </Window>
    }
}

fn main() -> Result<(), String> {
    println("Rendering UI test component")
    return Ok(())
}
