// OMNISYSTEM GUI - DROPDOWN & MENU COMPONENTS (TIER 1)
// Dropdown, select, and menu components
// Location: gui/foundation/components/dropdowns.titan
// 2026-06-15

pub struct DropdownItem {
    label: String
    value: String
    icon: String
    disabled: Bool
    divider: Bool
}

pub struct DropdownConfig {
    isOpen: Bool
    position: String
    size: String
    searchable: Bool
    multiple: Bool
}

pub class Dropdown {
    config: DropdownConfig
    items: Array[DropdownItem]
    selectedItems: Array[String]
    placeholder: String
    onSelect: String

    pub fn new() -> Self {
        Dropdown {
            config: DropdownConfig {
                isOpen: false,
                position: "bottom",
                size: "medium",
                searchable: false,
                multiple: false
            },
            items: Array::new(),
            selectedItems: Array::new(),
            placeholder: "Select an option",
            onSelect: ""
        }
    }

    pub fn render(self: Self) -> String {
        let mut html = "<div class=\"dropdown dropdown-" + self.config.size + "\">"

        html = html + "<button class=\"dropdown-trigger\" onclick=\"toggleDropdown()\">"
        html = html + if self.selectedItems.is_empty() { self.placeholder } else { self.selectedItems[0] }
        html = html + "<i class=\"dropdown-icon\">▼</i>"
        html = html + "</button>"

        if self.config.isOpen {
            html = html + self.render_menu()
        }

        html = html + "</div>"
        html
    }

    fn render_menu(self: Self) -> String {
        let mut html = "<div class=\"dropdown-menu\">"

        if self.config.searchable {
            html = html + "<input type=\"text\" class=\"dropdown-search\" placeholder=\"Search...\">"
        }

        for item in self.items {
            if item.divider {
                html = html + "<div class=\"dropdown-divider\"></div>"
            } else {
                let mut itemHtml = "<div class=\"dropdown-item"
                if item.disabled {
                    itemHtml = itemHtml + " disabled"
                }
                itemHtml = itemHtml + "\" onclick=\"selectItem('" + item.value + "')\">"

                if !item.icon.is_empty() {
                    itemHtml = itemHtml + "<i class=\"dropdown-item-icon icon-" + item.icon + "\"></i>"
                }

                itemHtml = itemHtml + "<span class=\"dropdown-item-label\">" + item.label + "</span>"

                if self.config.multiple && self.selectedItems.contains(item.value) {
                    itemHtml = itemHtml + "<i class=\"dropdown-item-check\">✓</i>"
                }

                itemHtml = itemHtml + "</div>"
                html = html + itemHtml
            }
        }

        html = html + "</div>"
        html
    }

    pub fn add_item(mut self: Self, item: DropdownItem) -> Self {
        self.items.push(item)
        self
    }

    pub fn set_open(mut self: Self, open: Bool) -> Self {
        self.config.isOpen = open
        self
    }

    pub fn set_multiple(mut self: Self, multiple: Bool) -> Self {
        self.config.multiple = multiple
        self
    }

    pub fn select_item(mut self: Self, value: String) -> Self {
        if self.config.multiple {
            if self.selectedItems.contains(value) {
                self.selectedItems.remove(value)
            } else {
                self.selectedItems.push(value)
            }
        } else {
            self.selectedItems = [value]
        }
        self
    }
}

pub struct MenuItem {
    label: String
    icon: String
    onClick: String
    disabled: Bool
    submenu: Array[MenuItem]
}

pub struct Menu {
    items: Array[MenuItem]
    orientation: String

    pub fn new() -> Self {
        Menu {
            items: Array::new(),
            orientation: "vertical"
        }
    }

    pub fn render(self: Self) -> String {
        let mut html = "<menu class=\"menu menu-" + self.orientation + "\">"

        for item in self.items {
            html = html + self.render_menu_item(item)
        }

        html = html + "</menu>"
        html
    }

    fn render_menu_item(self: Self, item: MenuItem) -> String {
        let mut html = "<li class=\"menu-item"
        if item.disabled {
            html = html + " disabled"
        }
        html = html + "\">"

        html = html + "<button onclick=\"" + item.onClick + "\">"

        if !item.icon.is_empty() {
            html = html + "<i class=\"menu-icon icon-" + item.icon + "\"></i>"
        }

        html = html + "<span>" + item.label + "</span>"

        if !item.submenu.is_empty() {
            html = html + "<i class=\"menu-arrow\">›</i>"
        }

        html = html + "</button>"

        if !item.submenu.is_empty() {
            html = html + "<ul class=\"menu-submenu\">"
            for subitem in item.submenu {
                html = html + self.render_menu_item(subitem)
            }
            html = html + "</ul>"
        }

        html = html + "</li>"
        html
    }

    pub fn add_item(mut self: Self, item: MenuItem) -> Self {
        self.items.push(item)
        self
    }
}

pub struct ContextMenu {
    items: Array[MenuItem]
    x: Float
    y: Float
    isVisible: Bool

    pub fn new() -> Self {
        ContextMenu {
            items: Array::new(),
            x: 0.0,
            y: 0.0,
            isVisible: false
        }
    }

    pub fn render(self: Self) -> String {
        if !self.isVisible {
            return ""
        }

        let xStr = self.x.to_string()
        let yStr = self.y.to_string()

        let style = "position: fixed; top: " + yStr + "px; left: " + xStr + "px; z-index: 9999;"

        let mut html = "<div class=\"context-menu\" style=\"" + style + "\">"

        for item in self.items {
            let mut itemHtml = "<div class=\"context-menu-item\" onclick=\"" + item.onClick + "\">"

            if !item.icon.is_empty() {
                itemHtml = itemHtml + "<i class=\"context-icon icon-" + item.icon + "\"></i>"
            }

            itemHtml = itemHtml + "<span>" + item.label + "</span>"
            itemHtml = itemHtml + "</div>"

            html = html + itemHtml
        }

        html = html + "</div>"
        html
    }

    pub fn show_at(mut self: Self, x: Float, y: Float) -> Self {
        self.x = x
        self.y = y
        self.isVisible = true
        self
    }

    pub fn hide(mut self: Self) -> Self {
        self.isVisible = false
        self
    }

    pub fn add_item(mut self: Self, item: MenuItem) -> Self {
        self.items.push(item)
        self
    }
}

pub struct SelectComponent {
    options: Array[String]
    selectedOption: String
    multiple: Bool
    disabled: Bool

    pub fn new() -> Self {
        SelectComponent {
            options: Array::new(),
            selectedOption: "",
            multiple: false,
            disabled: false
        }
    }

    pub fn render(self: Self) -> String {
        let mut html = "<select class=\"select\""
        if self.multiple {
            html = html + " multiple"
        }
        if self.disabled {
            html = html + " disabled"
        }
        html = html + ">"

        for option in self.options {
            html = html + "<option value=\"" + option + "\">" + option + "</option>"
        }

        html = html + "</select>"
        html
    }

    pub fn add_option(mut self: Self, option: String) -> Self {
        self.options.push(option)
        self
    }
}
