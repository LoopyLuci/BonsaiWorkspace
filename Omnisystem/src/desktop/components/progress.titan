// OMNISYSTEM GUI - PROGRESS & INDICATOR COMPONENTS (TIER 1)
// Progress bars, spinners, skeletons, and loading states
// Location: gui/foundation/components/progress.titan
// 2026-06-15

pub struct ProgressBarConfig {
    value: Float
    max: Float
    variant: String
    size: String
    showLabel: Bool
    animated: Bool
}

pub class ProgressBar {
    config: ProgressBarConfig

    pub fn new(value: Float, max: Float) -> Self {
        ProgressBar {
            config: ProgressBarConfig {
                value: value,
                max: max,
                variant: "primary",
                size: "medium",
                showLabel: false,
                animated: true
            }
        }
    }

    pub fn render(self: Self) -> String {
        let percentage = (self.config.value / self.config.max) * 100.0
        let percentStr = percentage.to_string()

        let mut style = "width: " + percentStr + "%; "
        style = style + "height: 100%; "
        style = style + "background-color: var(--color-" + self.config.variant + "); "
        style = style + "border-radius: 4px; "
        style = style + "transition: width 0.3s ease; "

        if self.config.animated {
            style = style + "animation: progress-pulse 1.5s ease-in-out infinite; "
        }

        let mut html = "<div class=\"progress-bar progress-" + self.config.size + "\" style=\"height: 8px; background-color: #E5E7EB; border-radius: 4px; overflow: hidden;\">"
        html = html + "<div style=\"" + style + "\"></div>"
        html = html + "</div>"

        if self.config.showLabel {
            html = html + "<span class=\"progress-label\">" + percentStr + "%</span>"
        }

        html
    }

    pub fn set_value(mut self: Self, value: Float) -> Self {
        self.config.value = value
        self
    }

    pub fn set_variant(mut self: Self, variant: String) -> Self {
        self.config.variant = variant
        self
    }

    pub fn set_show_label(mut self: Self, show: Bool) -> Self {
        self.config.showLabel = show
        self
    }
}

pub struct LinearProgress {
    value: Float
    indeterminate: Bool
    color: String

    pub fn new() -> Self {
        LinearProgress {
            value: 0.0,
            indeterminate: false,
            color: "primary"
        }
    }

    pub fn render(self: Self) -> String {
        let mut style = "width: 100%; height: 4px; "
        style = style + "background-color: #E5E7EB; "
        style = style + "border-radius: 2px; "
        style = style + "overflow: hidden; "

        let mut html = "<div style=\"" + style + "\">"

        if self.indeterminate {
            html = html + "<div style=\"height: 100%; background-color: var(--color-" + self.color + "); animation: progress-indeterminate 1.5s infinite;\"></div>"
        } else {
            let percentStr = self.value.to_string()
            html = html + "<div style=\"height: 100%; width: " + percentStr + "%; background-color: var(--color-" + self.color + "); transition: width 0.3s ease;\"></div>"
        }

        html = html + "</div>"
        html
    }

    pub fn set_value(mut self: Self, value: Float) -> Self {
        self.value = value
        self
    }

    pub fn set_indeterminate(mut self: Self, indeterminate: Bool) -> Self {
        self.indeterminate = indeterminate
        self
    }
}

pub struct CircularProgress {
    value: Float
    size: String
    indeterminate: Bool

    pub fn new() -> Self {
        CircularProgress {
            value: 0.0,
            size: "medium",
            indeterminate: false
        }
    }

    pub fn render(self: Self) -> String {
        let sizeValue = match self.size {
            "small" => "24",
            "large" => "64",
            _ => "40"
        }

        let mut html = "<svg class=\"circular-progress\" width=\"" + sizeValue + "\" height=\"" + sizeValue + "\" viewBox=\"0 0 40 40\" style=\"transform: rotate(-90deg);\">"
        html = html + "<circle cx=\"20\" cy=\"20\" r=\"18\" fill=\"none\" stroke=\"#E5E7EB\" stroke-width=\"2\"/>"

        if self.indeterminate {
            html = html + "<circle cx=\"20\" cy=\"20\" r=\"18\" fill=\"none\" stroke=\"var(--color-primary)\" stroke-width=\"2\" stroke-dasharray=\"56.5 113\" animation=\"progress-rotate 2s linear infinite\"/>"
        } else {
            let circumference = 113.0
            let offset = circumference - (self.value / 100.0) * circumference
            html = html + "<circle cx=\"20\" cy=\"20\" r=\"18\" fill=\"none\" stroke=\"var(--color-primary)\" stroke-width=\"2\" stroke-dasharray=\"" + circumference.to_string() + "\" stroke-dashoffset=\"" + offset.to_string() + "\"/>"
        }

        html = html + "</svg>"
        html
    }

    pub fn set_value(mut self: Self, value: Float) -> Self {
        self.value = value
        self
    }
}

pub struct Spinner {
    size: String
    color: String

    pub fn new() -> Self {
        Spinner {
            size: "medium",
            color: "primary"
        }
    }

    pub fn render(self: Self) -> String {
        let sizeValue = match self.size {
            "small" => "20px",
            "large" => "40px",
            _ => "32px"
        }

        let style = "width: " + sizeValue + "; height: " + sizeValue + "; border: 3px solid rgba(0,0,0,0.1); border-top-color: var(--color-" + self.color + "); border-radius: 50%; animation: spinner-rotate 0.8s linear infinite;"

        "<div class=\"spinner\" style=\"" + style + "\"></div>"
    }

    pub fn set_size(mut self: Self, size: String) -> Self {
        self.size = size
        self
    }
}

pub struct Skeleton {
    width: String
    height: String
    circle: Bool
    count: Int
    spacing: String

    pub fn new(width: String, height: String) -> Self {
        Skeleton {
            width: width,
            height: height,
            circle: false,
            count: 1,
            spacing: "8px"
        }
    }

    pub fn render(self: Self) -> String {
        let mut html = ""

        for i in 0..self.count {
            let style = "width: " + self.width + "; height: " + self.height + "; background: linear-gradient(90deg, #E5E7EB 25%, #F3F4F6 50%, #E5E7EB 75%); background-size: 200% 100%; animation: skeleton-pulse 1.5s infinite; border-radius: " + if self.circle { "50%" } else { "4px" } + "; margin-bottom: " + self.spacing + ";"

            html = html + "<div style=\"" + style + "\"></div>"
        }

        html
    }

    pub fn set_circle(mut self: Self, circle: Bool) -> Self {
        self.circle = circle
        self
    }

    pub fn set_count(mut self: Self, count: Int) -> Self {
        self.count = count
        self
    }
}

pub struct Badge {
    text: String
    variant: String
    icon: String

    pub fn new(text: String) -> Self {
        Badge {
            text: text,
            variant: "primary",
            icon: ""
        }
    }

    pub fn render(self: Self) -> String {
        let mut style = "display: inline-flex; align-items: center; gap: 4px; padding: 4px 8px; border-radius: 12px; font-size: 0.75rem; font-weight: 600; "

        style = match self.variant {
            "success" => style + "background-color: #D1FAE5; color: #065F46; ",
            "warning" => style + "background-color: #FEF3C7; color: #78350F; ",
            "error" => style + "background-color: #FEE2E2; color: #7F1D1D; ",
            "info" => style + "background-color: #DBEAFE; color: #0C2340; ",
            _ => style + "background-color: #DBEAFE; color: #1E40AF; "
        }

        let mut html = "<span style=\"" + style + "\">"

        if !self.icon.is_empty() {
            html = html + "<i class=\"badge-icon icon-" + self.icon + "\"></i>"
        }

        html = html + self.text + "</span>"
        html
    }

    pub fn set_variant(mut self: Self, variant: String) -> Self {
        self.variant = variant
        self
    }
}

pub struct LoadingOverlay {
    isVisible: Bool
    message: String
    blur: Bool

    pub fn new() -> Self {
        LoadingOverlay {
            isVisible: false,
            message: "Loading...",
            blur: true
        }
    }

    pub fn render(self: Self) -> String {
        if !self.isVisible {
            return ""
        }

        let mut style = "position: fixed; top: 0; left: 0; right: 0; bottom: 0; display: flex; align-items: center; justify-content: center; z-index: 9999; background-color: rgba(0,0,0,0.5); "

        if self.blur {
            style = style + "backdrop-filter: blur(4px); "
        }

        let mut html = "<div style=\"" + style + "\">"
        html = html + "<div style=\"text-align: center;\">"
        html = html + "<div class=\"spinner\" style=\"width: 40px; height: 40px; margin: 0 auto 16px;\"></div>"
        html = html + "<p style=\"color: white; margin: 0;\">" + self.message + "</p>"
        html = html + "</div>"
        html = html + "</div>"
        html
    }

    pub fn set_visible(mut self: Self, visible: Bool) -> Self {
        self.isVisible = visible
        self
    }

    pub fn set_message(mut self: Self, message: String) -> Self {
        self.message = message
        self
    }
}
