// OMNISYSTEM GUI - CARD COMPONENTS (TIER 1)
// Card component system using Omni Assets
// Location: gui/foundation/components/cards.titan
// 2026-06-15

pub enum CardVariant {
    Default,
    Elevated,
    Outlined,
    Filled,
    Interactive,
    Featured
}

pub enum CardSize {
    Small,
    Medium,
    Large,
    XLarge,
    Full
}

pub struct CardConfig {
    variant: CardVariant
    size: CardSize
    title: String
    description: String
    image: String
    footer: String
    clickable: Bool
    hoverable: Bool
    selected: Bool
    disabled: Bool
}

pub class CardComponent {
    config: CardConfig
    content: String
    actions: Array[String]
    onClick: String

    pub fn new(title: String) -> Self {
        CardComponent {
            config: CardConfig {
                variant: CardVariant::Default,
                size: CardSize::Medium,
                title: title,
                description: "",
                image: "",
                footer: "",
                clickable: false,
                hoverable: true,
                selected: false,
                disabled: false
            },
            content: "",
            actions: Array::new(),
            onClick: ""
        }
    }

    pub fn render(self: Self) -> String {
        let className = self.get_class_name()
        let mut html = "<div class=\"card " + className + "\">"

        if !self.config.image.is_empty() {
            html = html + "<div class=\"card-image\"><img src=\"" + self.config.image + "\" alt=\"\"></div>"
        }

        html = html + "<div class=\"card-content\">"

        if !self.config.title.is_empty() {
            html = html + "<h3 class=\"card-title\">" + self.config.title + "</h3>"
        }

        if !self.config.description.is_empty() {
            html = html + "<p class=\"card-description\">" + self.config.description + "</p>"
        }

        if !self.content.is_empty() {
            html = html + "<div class=\"card-body\">" + self.content + "</div>"
        }

        html = html + "</div>"

        if !self.actions.is_empty() {
            html = html + "<div class=\"card-actions\">"
            for action in self.actions {
                html = html + "<button class=\"card-action\">" + action + "</button>"
            }
            html = html + "</div>"
        }

        if !self.config.footer.is_empty() {
            html = html + "<div class=\"card-footer\">" + self.config.footer + "</div>"
        }

        html = html + "</div>"
        html
    }

    fn get_class_name(self: Self) -> String {
        let mut classes = Array::new()

        classes.push("card-" + self.config.variant.to_string().to_lowercase())
        classes.push("card-" + self.config.size.to_string().to_lowercase())

        if self.config.clickable {
            classes.push("card-clickable")
        }

        if self.config.hoverable {
            classes.push("card-hoverable")
        }

        if self.config.selected {
            classes.push("card-selected")
        }

        if self.config.disabled {
            classes.push("card-disabled")
        }

        join_classes(classes)
    }

    pub fn set_description(mut self: Self, description: String) -> Self {
        self.config.description = description
        self
    }

    pub fn set_image(mut self: Self, image: String) -> Self {
        self.config.image = image
        self
    }

    pub fn set_content(mut self: Self, content: String) -> Self {
        self.content = content
        self
    }

    pub fn add_action(mut self: Self, action: String) -> Self {
        self.actions.push(action)
        self
    }

    pub fn set_footer(mut self: Self, footer: String) -> Self {
        self.config.footer = footer
        self
    }

    pub fn set_clickable(mut self: Self, clickable: Bool) -> Self {
        self.config.clickable = clickable
        self
    }

    pub fn set_variant(mut self: Self, variant: CardVariant) -> Self {
        self.config.variant = variant
        self
    }

    pub fn on_click(mut self: Self, handler: String) -> Self {
        self.onClick = handler
        self.config.clickable = true
        self
    }
}

// Card grid for displaying multiple cards
pub struct CardGrid {
    cards: Array[CardComponent]
    columns: Int
    gap: String

    pub fn new() -> Self {
        CardGrid {
            cards: Array::new(),
            columns: 3,
            gap: "16px"
        }
    }

    pub fn add_card(mut self: Self, card: CardComponent) -> Self {
        self.cards.push(card)
        self
    }

    pub fn set_columns(mut self: Self, columns: Int) -> Self {
        self.columns = columns
        self
    }

    pub fn render(self: Self) -> String {
        let colsStr = self.columns.to_string()
        let mut html = "<div class=\"card-grid\" style=\"display: grid; grid-template-columns: repeat(" + colsStr + ", 1fr); gap: " + self.gap + ";\">"

        for card in self.cards {
            html = html + card.render()
        }

        html = html + "</div>"
        html
    }
}

// Statistics card (specific use case)
pub struct StatsCard {
    label: String
    value: String
    metric: String
    trend: String
    icon: String

    pub fn new(label: String, value: String) -> Self {
        StatsCard {
            label: label,
            value: value,
            metric: "",
            trend: "",
            icon: ""
        }
    }

    pub fn render(self: Self) -> String {
        let mut html = "<div class=\"stats-card\">"

        if !self.icon.is_empty() {
            html = html + "<i class=\"stats-icon icon-" + self.icon + "\"></i>"
        }

        html = html + "<div class=\"stats-content\">"
        html = html + "<p class=\"stats-label\">" + self.label + "</p>"
        html = html + "<h3 class=\"stats-value\">" + self.value + "</h3>"

        if !self.metric.is_empty() {
            html = html + "<p class=\"stats-metric\">" + self.metric + "</p>"
        }

        if !self.trend.is_empty() {
            html = html + "<span class=\"stats-trend\">" + self.trend + "</span>"
        }

        html = html + "</div>"
        html = html + "</div>"
        html
    }
}

// User card (specific use case)
pub struct UserCard {
    name: String
    role: String
    avatar: String
    email: String
    online: Bool

    pub fn new(name: String, role: String) -> Self {
        UserCard {
            name: name,
            role: role,
            avatar: "",
            email: "",
            online: false
        }
    }

    pub fn render(self: Self) -> String {
        let mut html = "<div class=\"user-card\">"

        if !self.avatar.is_empty() {
            html = html + "<img class=\"user-avatar\" src=\"" + self.avatar + "\" alt=\"\">"
        }

        html = html + "<div class=\"user-info\">"
        html = html + "<h4 class=\"user-name\">" + self.name + "</h4>"
        html = html + "<p class=\"user-role\">" + self.role + "</p>"

        if !self.email.is_empty() {
            html = html + "<p class=\"user-email\">" + self.email + "</p>"
        }

        if self.online {
            html = html + "<span class=\"user-status online\"></span>"
        }

        html = html + "</div>"
        html = html + "</div>"
        html
    }
}

fn join_classes(classes: Array[String]) -> String {
    let mut result = ""
    for i in 0..classes.len() {
        if i > 0 {
            result = result + " "
        }
        result = result + classes[i]
    }
    result
}
