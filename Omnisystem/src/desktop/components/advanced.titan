pub struct AccordionItem {
    title: String
    content: String
    icon: String
    expanded: Bool
    disabled: Bool
}

pub class Accordion {
    items: Array[AccordionItem]
    allowMultiple: Bool
    variant: String

    pub fn new() -> Self {
        Accordion {
            items: Array::new(),
            allowMultiple: false,
            variant: "default"
        }
    }

    pub fn render(self: Self) -> String {
        let mut html = "<div class=\"accordion accordion-" + self.variant + "\">"

        for i in 0..self.items.len() {
            let item = self.items[i]

            html = html + "<div class=\"accordion-item"
            if item.expanded {
                html = html + " expanded"
            }
            if item.disabled {
                html = html + " disabled"
            }
            html = html + "\">"

            html = html + "<button class=\"accordion-trigger\" onclick=\"toggleAccordion(" + i.to_string() + ")\">"

            if !item.icon.is_empty() {
                html = html + "<i class=\"accordion-icon icon-" + item.icon + "\"></i>"
            }

            html = html + "<span class=\"accordion-title\">" + item.title + "</span>"
            html = html + "<i class=\"accordion-chevron\">›</i>"
            html = html + "</button>"

            if item.expanded {
                html = html + "<div class=\"accordion-content\">" + item.content + "</div>"
            }

            html = html + "</div>"
        }

        html = html + "</div>"
        html
    }

    pub fn add_item(mut self: Self, item: AccordionItem) -> Self {
        self.items.push(item)
        self
    }

    pub fn toggle_item(mut self: Self, index: Int) -> Self {
        if index < self.items.len() {
            if !self.allowMultiple {
                for i in 0..self.items.len() {
                    self.items[i].expanded = false
                }
            }
            self.items[index].expanded = !self.items[index].expanded
        }
        self
    }
}

pub struct Tooltip {
    content: String
    position: String
    trigger: String
    isVisible: Bool

    pub fn new(content: String) -> Self {
        Tooltip {
            content: content,
            position: "top",
            trigger: "hover",
            isVisible: false
        }
    }

    pub fn render(self: Self) -> String {
        if !self.isVisible {
            return ""
        }

        let posClass = "tooltip-" + self.position

        "<div class=\"tooltip " + posClass + "\">" + self.content + "</div>"
    }

    pub fn set_position(mut self: Self, position: String) -> Self {
        self.position = position
        self
    }

    pub fn show(mut self: Self) -> Self {
        self.isVisible = true
        self
    }

    pub fn hide(mut self: Self) -> Self {
        self.isVisible = false
        self
    }
}

pub struct Popover {
    title: String
    content: String
    position: String
    isVisible: Bool
    trigger: String

    pub fn new(title: String, content: String) -> Self {
        Popover {
            title: title,
            content: content,
            position: "bottom",
            isVisible: false,
            trigger: "click"
        }
    }

    pub fn render(self: Self) -> String {
        if !self.isVisible {
            return ""
        }

        let posClass = "popover-" + self.position

        let mut html = "<div class=\"popover " + posClass + "\">"
        html = html + "<div class=\"popover-header\">" + self.title + "</div>"
        html = html + "<div class=\"popover-body\">" + self.content + "</div>"
        html = html + "<div class=\"popover-arrow\"></div>"
        html = html + "</div>"

        html
    }

    pub fn set_position(mut self: Self, position: String) -> Self {
        self.position = position
        self
    }

    pub fn show(mut self: Self) -> Self {
        self.isVisible = true
        self
    }

    pub fn hide(mut self: Self) -> Self {
        self.isVisible = false
        self
    }
}

pub struct TableColumn {
    header: String
    key: String
    width: String
    sortable: Bool
    render: String
}

pub struct TableConfig {
    striped: Bool
    bordered: Bool
    hoverable: Bool
    compact: Bool
    sortable: Bool
}

pub class Table {
    config: TableConfig
    columns: Array[TableColumn]
    rows: Array[Object]
    pageSize: Int
    currentPage: Int

    pub fn new() -> Self {
        Table {
            config: TableConfig {
                striped: true,
                bordered: false,
                hoverable: true,
                compact: false,
                sortable: true
            },
            columns: Array::new(),
            rows: Array::new(),
            pageSize: 10,
            currentPage: 1
        }
    }

    pub fn render(self: Self) -> String {
        let mut className = "table"
        if self.config.striped {
            className = className + " table-striped"
        }
        if self.config.bordered {
            className = className + " table-bordered"
        }
        if self.config.hoverable {
            className = className + " table-hoverable"
        }

        let mut html = "<table class=\"" + className + "\">"

        html = html + "<thead>"
        html = html + "<tr>"

        for column in self.columns {
            let mut headerHtml = "<th"
            if !column.width.is_empty() {
                headerHtml = headerHtml + " style=\"width: " + column.width + ";\""
            }
            headerHtml = headerHtml + ">"

            if column.sortable {
                headerHtml = headerHtml + "<button class=\"table-sort\">" + column.header + " ⇅</button>"
            } else {
                headerHtml = headerHtml + column.header
            }

            headerHtml = headerHtml + "</th>"
            html = html + headerHtml
        }

        html = html + "</tr>"
        html = html + "</thead>"

        html = html + "<tbody>"

        let start = (self.currentPage - 1) * self.pageSize
        let end = start + self.pageSize

        for i in start..end {
            if i < self.rows.len() {
                let row = self.rows[i]
                html = html + "<tr>"

                for column in self.columns {
                    html = html + "<td>" + row[column.key] + "</td>"
                }

                html = html + "</tr>"
            }
        }

        html = html + "</tbody>"
        html = html + "</table>"

        html
    }

    pub fn add_column(mut self: Self, column: TableColumn) -> Self {
        self.columns.push(column)
        self
    }

    pub fn add_row(mut self: Self, row: Object) -> Self {
        self.rows.push(row)
        self
    }

    pub fn set_page_size(mut self: Self, pageSize: Int) -> Self {
        self.pageSize = pageSize
        self
    }
}

pub struct Alert {
    title: String
    message: String
    type: String
    closeable: Bool
    icon: String

    pub fn new(message: String) -> Self {
        Alert {
            title: "",
            message: message,
            type: "info",
            closeable: true,
            icon: "info"
        }
    }

    pub fn render(self: Self) -> String {
        let mut className = "alert alert-" + self.type

        let mut html = "<div class=\"" + className + "\">"

        if !self.icon.is_empty() {
            html = html + "<i class=\"alert-icon icon-" + self.icon + "\"></i>"
        }

        html = html + "<div class=\"alert-content\">"

        if !self.title.is_empty() {
            html = html + "<h4 class=\"alert-title\">" + self.title + "</h4>"
        }

        html = html + "<p class=\"alert-message\">" + self.message + "</p>"
        html = html + "</div>"

        if self.closeable {
            html = html + "<button class=\"alert-close\">×</button>"
        }

        html = html + "</div>"

        html
    }

    pub fn set_type(mut self: Self, type: String) -> Self {
        self.type = type
        self
    }

    pub fn set_title(mut self: Self, title: String) -> Self {
        self.title = title
        self
    }
}

pub struct Toast {
    message: String
    type: String
    duration: Int
    position: String

    pub fn new(message: String) -> Self {
        Toast {
            message: message,
            type: "info",
            duration: 3000,
            position: "bottom-right"
        }
    }

    pub fn render(self: Self) -> String {
        let mut html = "<div class=\"toast toast-" + self.type + " toast-" + self.position + "\">"
        html = html + "<p class=\"toast-message\">" + self.message + "</p>"
        html = html + "</div>"
        html
    }

    pub fn set_type(mut self: Self, type: String) -> Self {
        self.type = type
        self
    }

    pub fn set_position(mut self: Self, position: String) -> Self {
        self.position = position
        self
    }
}
