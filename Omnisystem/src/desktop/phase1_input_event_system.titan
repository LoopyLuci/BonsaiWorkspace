// Phase 1: Input Event System
// Unified input handling across platforms (keyboard, mouse, gamepad)
// Replaces: src/desktop/phase1_input_event_system.titan (100% rewrite)

use omnisystem::{HashMap, Vec, String, Option}
use omnisystem::time::SystemTime

enum InputEventType {
    KeyDown,
    KeyUp,
    KeyPress,
    MouseMove,
    MouseDown,
    MouseUp,
    MouseScroll,
    GamepadButtonDown,
    GamepadButtonUp,
    GamepadAxisMotion
}

struct InputEvent {
    event_type: InputEventType,
    timestamp: i64,
    source_device: String,

    // Keyboard fields
    key_code: Option<i32>,
    key_char: Option<char>,

    // Mouse fields
    mouse_x: Option<i32>,
    mouse_y: Option<i32>,
    mouse_button: Option<i32>,
    scroll_delta: Option<(f32, f32)>,

    // Gamepad fields
    gamepad_id: Option<i32>,
    gamepad_button: Option<i32>,
    gamepad_axis: Option<(f32, f32, f32)>
}

struct InputDevice {
    id: String,
    device_type: String,
    is_connected: bool,
    last_event_time: i64
}

struct InputEventSystem {
    devices: HashMap<String, InputDevice>,
    event_history: Vec<InputEvent>,
    max_history: i32,
    is_polling: bool
}

impl InputEventSystem {
    fn new() -> Self {
        return InputEventSystem {
            devices: HashMap::new(),
            event_history: Vec::new(),
            max_history: 1000,
            is_polling: false
        }
    }

    fn register_device(&mut self, id: String, device_type: String) -> Result<(), String> {
        let device = InputDevice {
            id: id.clone(),
            device_type: device_type.clone(),
            is_connected: true,
            last_event_time: 0
        }

        self.devices.insert(id.clone(), device)
        println("Device registered: {} ({})", id, device_type)
        return Ok(())
    }

    fn unregister_device(&mut self, id: String) -> Result<(), String> {
        match self.devices.remove(&id) {
            Some(_) => {
                println("Device unregistered: {}", id)
                Ok(())
            },
            None => {
                Err("Device not found".to_string())
            }
        }
    }

    fn process_input_event(&mut self, event: InputEvent) -> Result<(), String> {
        let timestamp = SystemTime::now().secs()

        // Update device timestamp
        if let Some(device) = self.devices.get_mut(&event.source_device) {
            device.last_event_time = timestamp
        }

        // Add to history
        if self.event_history.len() >= self.max_history as usize {
            self.event_history.remove(0)
        }
        self.event_history.push(event.clone())

        // Process based on type
        match event.event_type {
            InputEventType::KeyDown => {
                println("Key down: {:?} (device: {})", event.key_code, event.source_device)
            },
            InputEventType::KeyUp => {
                println("Key up: {:?} (device: {})", event.key_code, event.source_device)
            },
            InputEventType::MouseMove => {
                println("Mouse move: ({}, {}) (device: {})",
                    event.mouse_x.unwrap_or(0),
                    event.mouse_y.unwrap_or(0),
                    event.source_device
                )
            },
            InputEventType::MouseDown => {
                println("Mouse down: button {} (device: {})",
                    event.mouse_button.unwrap_or(-1),
                    event.source_device
                )
            },
            InputEventType::MouseScroll => {
                if let Some((dx, dy)) = event.scroll_delta {
                    println("Scroll: ({}, {}) (device: {})", dx, dy, event.source_device)
                }
            },
            InputEventType::GamepadButtonDown => {
                println("Gamepad {} button {}",
                    event.gamepad_id.unwrap_or(-1),
                    event.gamepad_button.unwrap_or(-1)
                )
            },
            _ => {}
        }

        return Ok(())
    }

    fn poll_devices(&mut self) -> Result<Vec<InputEvent>, String> {
        let mut events = Vec::new()

        for (device_id, device) in self.devices.iter() {
            if device.is_connected {
                // Simulate device polling (in real implementation, would read from OS APIs)
                // Windows: GetAsyncKeyState, GetCursorPos, XInput
                // Linux: /dev/input/event*, XInput2, udev
                // macOS: IOHIDManager, NSEvent
            }
        }

        return Ok(events)
    }

    fn get_event_history(&self) -> Vec<InputEvent> {
        return self.event_history.clone()
    }

    fn clear_history(&mut self) -> void {
        self.event_history.clear()
    }

    fn get_device_status(&self) -> HashMap<String, bool> {
        let mut status = HashMap::new()

        for (device_id, device) in self.devices.iter() {
            status.insert(device_id.clone(), device.is_connected)
        }

        return status
    }
}

// Platform-specific input helpers
#[cfg(target_os = "windows")]
fn create_keyboard_event(key_code: i32) -> InputEvent {
    return InputEvent {
        event_type: InputEventType::KeyDown,
        timestamp: SystemTime::now().secs(),
        source_device: "keyboard".to_string(),
        key_code: Some(key_code),
        key_char: None,
        mouse_x: None,
        mouse_y: None,
        mouse_button: None,
        scroll_delta: None,
        gamepad_id: None,
        gamepad_button: None,
        gamepad_axis: None
    }
}

#[cfg(target_os = "linux")]
fn create_mouse_event(x: i32, y: i32) -> InputEvent {
    return InputEvent {
        event_type: InputEventType::MouseMove,
        timestamp: SystemTime::now().secs(),
        source_device: "mouse".to_string(),
        key_code: None,
        key_char: None,
        mouse_x: Some(x),
        mouse_y: Some(y),
        mouse_button: None,
        scroll_delta: None,
        gamepad_id: None,
        gamepad_button: None,
        gamepad_axis: None
    }
}

#[cfg(target_os = "macos")]
fn create_gamepad_event(pad_id: i32, axis_x: f32, axis_y: f32) -> InputEvent {
    return InputEvent {
        event_type: InputEventType::GamepadAxisMotion,
        timestamp: SystemTime::now().secs(),
        source_device: "gamepad".to_string(),
        key_code: None,
        key_char: None,
        mouse_x: None,
        mouse_y: None,
        mouse_button: None,
        scroll_delta: None,
        gamepad_id: Some(pad_id),
        gamepad_button: None,
        gamepad_axis: Some((axis_x, axis_y, 0.0))
    }
}

// Integration test
fn test_input_system() -> Result<(), String> {
    let mut input_system = InputEventSystem::new()

    // Register devices
    input_system.register_device("keyboard".to_string(), "keyboard".to_string())?
    input_system.register_device("mouse".to_string(), "mouse".to_string())?
    input_system.register_device("gamepad_1".to_string(), "gamepad".to_string())?

    // Simulate keyboard input
    let key_event = InputEvent {
        event_type: InputEventType::KeyDown,
        timestamp: SystemTime::now().secs(),
        source_device: "keyboard".to_string(),
        key_code: Some(65),  // 'A' key
        key_char: Some('a'),
        mouse_x: None,
        mouse_y: None,
        mouse_button: None,
        scroll_delta: None,
        gamepad_id: None,
        gamepad_button: None,
        gamepad_axis: None
    }

    input_system.process_input_event(key_event)?

    // Simulate mouse input
    let mouse_event = InputEvent {
        event_type: InputEventType::MouseMove,
        timestamp: SystemTime::now().secs(),
        source_device: "mouse".to_string(),
        key_code: None,
        key_char: None,
        mouse_x: Some(100),
        mouse_y: Some(200),
        mouse_button: None,
        scroll_delta: None,
        gamepad_id: None,
        gamepad_button: None,
        gamepad_axis: None
    }

    input_system.process_input_event(mouse_event)?

    // Check history
    let history = input_system.get_event_history()
    println("Input events processed: {}", history.len())

    // Check device status
    let status = input_system.get_device_status()
    println("Connected devices: {}", status.len())

    return Ok(())
}
