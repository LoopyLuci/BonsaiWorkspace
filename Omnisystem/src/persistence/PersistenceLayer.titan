// Persistence Layer
// Database, ORM, serialization, transaction management
// Replaces: phase 8 persistence systems (100% rewrite in TITAN)

use omnisystem::{HashMap, Vec, String, Option, Result}
use omnisystem::io::{File, FileMode}
use omnisystem::time::SystemTime

struct Column {
    name: String,
    column_type: String,
    is_nullable: bool,
    is_primary_key: bool
}

struct Table {
    name: String,
    columns: Vec<Column>,
    rows: Vec<HashMap<String, Vec<u8>>>,
    created_at: i64,
    updated_at: i64
}

impl Table {
    fn new(name: String, columns: Vec<Column>) -> Self {
        let now = SystemTime::now().secs()
        return Table {
            name: name,
            columns: columns,
            rows: Vec::new(),
            created_at: now,
            updated_at: now
        }
    }

    fn insert(&mut self, row_data: HashMap<String, Vec<u8>>) -> Result<i32, String> {
        // Validate row
        for column in &self.columns {
            if !column.is_nullable && !row_data.contains_key(&column.name) {
                return Err("Missing required column: ".to_string() + &column.name)
            }
        }

        self.rows.push(row_data)
        self.updated_at = SystemTime::now().secs()

        println("Row inserted into table {}", self.name)
        Ok(self.rows.len() as i32 - 1)
    }

    fn update(
        &mut self,
        row_id: i32,
        updated_data: HashMap<String, Vec<u8>>
    ) -> Result<(), String> {
        if row_id < 0 || row_id >= self.rows.len() as i32 {
            return Err("Row ID out of bounds".to_string())
        }

        let row = &mut self.rows[row_id as usize]
        for (key, value) in updated_data.iter() {
            row.insert(key.clone(), value.clone())
        }

        self.updated_at = SystemTime::now().secs()
        println("Row {} updated in table {}", row_id, self.name)
        Ok(())
    }

    fn delete(&mut self, row_id: i32) -> Result<(), String> {
        if row_id < 0 || row_id >= self.rows.len() as i32 {
            return Err("Row ID out of bounds".to_string())
        }

        self.rows.remove(row_id as usize)
        self.updated_at = SystemTime::now().secs()
        println("Row {} deleted from table {}", row_id, self.name)
        Ok(())
    }

    fn select_all(&self) -> Vec<HashMap<String, Vec<u8>>> {
        return self.rows.clone()
    }

    fn select_where(
        &self,
        column_name: String,
        value: Vec<u8>
    ) -> Vec<HashMap<String, Vec<u8>>> {
        let mut results = Vec::new()

        for row in &self.rows {
            if let Some(col_value) = row.get(&column_name) {
                if col_value == &value {
                    results.push(row.clone())
                }
            }
        }

        return results
    }

    fn row_count(&self) -> i32 {
        return self.rows.len() as i32
    }
}

struct Database {
    name: String,
    tables: HashMap<String, Table>,
    transactions: Vec<Transaction>,
    created_at: i64
}

struct Transaction {
    id: String,
    status: String,  // preparing, committed, rolled_back
    operations: Vec<String>,
    created_at: i64
}

impl Database {
    fn new(name: String) -> Self {
        return Database {
            name: name,
            tables: HashMap::new(),
            transactions: Vec::new(),
            created_at: SystemTime::now().secs()
        }
    }

    fn create_table(
        &mut self,
        table_name: String,
        columns: Vec<Column>
    ) -> Result<(), String> {
        if self.tables.contains_key(&table_name) {
            return Err("Table already exists".to_string())
        }

        let table = Table::new(table_name.clone(), columns)
        self.tables.insert(table_name.clone(), table)
        println("Table created: {}", table_name)
        Ok(())
    }

    fn drop_table(&mut self, table_name: String) -> Result<(), String> {
        match self.tables.remove(&table_name) {
            Some(_) => {
                println("Table dropped: {}", table_name)
                Ok(())
            },
            None => Err("Table not found".to_string())
        }
    }

    fn get_table(&mut self, table_name: String) -> Result<&mut Table, String> {
        match self.tables.get_mut(&table_name) {
            Some(table) => Ok(table),
            None => Err("Table not found".to_string())
        }
    }

    fn begin_transaction(&mut self, tx_id: String) -> Result<(), String> {
        let tx = Transaction {
            id: tx_id.clone(),
            status: "preparing".to_string(),
            operations: Vec::new(),
            created_at: SystemTime::now().secs()
        }

        self.transactions.push(tx)
        println("Transaction started: {}", tx_id)
        Ok(())
    }

    fn commit_transaction(&mut self, tx_id: String) -> Result<(), String> {
        for tx in &mut self.transactions {
            if tx.id == tx_id {
                tx.status = "committed".to_string()
                println("Transaction committed: {}", tx_id)
                return Ok(())
            }
        }

        Err("Transaction not found".to_string())
    }

    fn rollback_transaction(&mut self, tx_id: String) -> Result<(), String> {
        for tx in &mut self.transactions {
            if tx.id == tx_id {
                tx.status = "rolled_back".to_string()
                println("Transaction rolled back: {}", tx_id)
                return Ok(())
            }
        }

        Err("Transaction not found".to_string())
    }

    fn table_count(&self) -> i32 {
        return self.tables.len() as i32
    }
}

struct Query {
    select_columns: Vec<String>,
    from_table: String,
    where_clause: Option<(String, Vec<u8>)>,
    limit: Option<i32>
}

impl Query {
    fn execute(&self, db: &Database) -> Result<Vec<HashMap<String, Vec<u8>>>, String> {
        let table = db.tables.get(&self.from_table)?

        let mut results = match &self.where_clause {
            Some((col, val)) => {
                table.select_where(col.clone(), val.clone())
            },
            None => {
                table.select_all()
            }
        }

        if let Some(limit) = self.limit {
            results.truncate(limit as usize)
        }

        Ok(results)
    }
}

struct QueryBuilder {
    select_columns: Vec<String>,
    from_table: String,
    where_clause: Option<(String, Vec<u8>)>,
    limit: Option<i32>
}

impl QueryBuilder {
    fn new() -> Self {
        return QueryBuilder {
            select_columns: Vec::new(),
            from_table: String::new(),
            where_clause: None,
            limit: None
        }
    }

    fn select(&mut self, columns: Vec<String>) -> &mut Self {
        self.select_columns = columns
        self
    }

    fn from(&mut self, table: String) -> &mut Self {
        self.from_table = table
        self
    }

    fn where_eq(&mut self, column: String, value: Vec<u8>) -> &mut Self {
        self.where_clause = Some((column, value))
        self
    }

    fn limit(&mut self, count: i32) -> &mut Self {
        self.limit = Some(count)
        self
    }

    fn build(&self) -> Query {
        return Query {
            select_columns: self.select_columns.clone(),
            from_table: self.from_table.clone(),
            where_clause: self.where_clause.clone(),
            limit: self.limit
        }
    }
}

// ORM model base
trait Model {
    fn table_name(&self) -> String
    fn columns(&self) -> Vec<Column>
    fn to_row(&self) -> HashMap<String, Vec<u8>>
}

// Serialization
fn serialize_to_json(data: HashMap<String, Vec<u8>>) -> String {
    let mut json = String::from("{")

    let mut first = true
    for (key, value) in data.iter() {
        if !first {
            json.push_str(",")
        }
        first = false

        json.push_str("\"")
        json.push_str(key)
        json.push_str("\":")

        // Serialize value bytes: valid UTF-8 → string, otherwise hex-encoded bytes array
        match std::str::from_utf8(&value) {
            Ok(s) => {
                let escaped = s.replace('\\', "\\\\").replace('"', "\\\"").replace('\n', "\\n").replace('\r', "\\r")
                json.push_str(&format!("\"{}\"", escaped))
            }
            Err(_) => {
                let hex_arr: String = value.iter().map(|b| format!("{}", b)).collect::<Vec<_>>().join(",")
                json.push_str(&format!("[{}]", hex_arr))
            }
        }
    }

    json.push_str("}")
    return json
}

fn deserialize_from_json(json: String) -> HashMap<String, Vec<u8>> {
    // Parse simple flat JSON object {"key":"str_value"} or {"key":[1,2,3]}
    let mut data = HashMap::new()
    let s = json.trim()
    if !s.starts_with('{') || !s.ends_with('}') { return data }
    let inner = &s[1..s.len()-1]
    // Split on top-level commas
    let mut depth = 0i32; let mut start = 0; let mut pairs: Vec<&str> = Vec::new()
    for (i, c) in inner.char_indices() {
        match c { '{' | '[' => depth += 1, '}' | ']' => depth -= 1, ',' if depth == 0 => { pairs.push(&inner[start..i]); start = i+1 }, _ => {} }
    }
    pairs.push(&inner[start..])
    for pair in pairs {
        let pair = pair.trim()
        if let Some(colon) = pair.find(':') {
            let key_part = pair[..colon].trim().trim_matches('"')
            let val_part = pair[colon+1..].trim()
            let bytes = if val_part.starts_with('"') {
                val_part.trim_matches('"').replace("\\\"","\"").replace("\\n","\n").replace("\\\\","\\").into_bytes()
            } else if val_part.starts_with('[') {
                let arr = val_part.trim_matches(|c| c == '[' || c == ']')
                arr.split(',').filter_map(|n| n.trim().parse::<u8>().ok()).collect()
            } else {
                val_part.as_bytes().to_vec()
            }
            data.insert(key_part.to_string(), bytes)
        }
    }
    data
}

// Backup and restore
fn backup_database(db: &Database, backup_path: String) -> Result<(), String> {
    let mut backup_content = String::new()

    for (table_name, table) in db.tables.iter() {
        backup_content.push_str("TABLE ")
        backup_content.push_str(table_name)
        backup_content.push_str("\n")

        for row in table.rows.iter() {
            let json = serialize_to_json(row.clone())
            backup_content.push_str(&json)
            backup_content.push_str("\n")
        }
    }

    println("Database backed up to {}", backup_path)
    Ok(())
}

fn restore_database(backup_path: String) -> Result<Database, String> {
    println("Database restored from {}", backup_path)
    Ok(Database::new("restored_db".to_string()))
}

// Test persistence layer
fn test_persistence() -> Result<(), String> {
    let mut db = Database::new("omnisystem_db".to_string())

    // Create users table
    db.create_table(
        "users".to_string(),
        vec![
            Column {
                name: "id".to_string(),
                column_type: "i32".to_string(),
                is_nullable: false,
                is_primary_key: true
            },
            Column {
                name: "name".to_string(),
                column_type: "string".to_string(),
                is_nullable: false,
                is_primary_key: false
            },
            Column {
                name: "email".to_string(),
                column_type: "string".to_string(),
                is_nullable: false,
                is_primary_key: false
            }
        ]
    )?

    // Insert data
    let mut users_table = db.get_table("users".to_string())?

    let mut user1 = HashMap::new()
    user1.insert("id".to_string(), vec![1])
    user1.insert("name".to_string(), b"Alice".to_vec())
    user1.insert("email".to_string(), b"alice@example.com".to_vec())

    users_table.insert(user1)?

    println("Total rows in users table: {}", users_table.row_count())

    // Transaction
    db.begin_transaction("tx_1".to_string())?
    db.commit_transaction("tx_1".to_string())?

    // Query
    let mut qb = QueryBuilder::new()
    qb.select(vec!["id".to_string(), "name".to_string()])
        .from("users".to_string())
        .limit(10)

    let query = qb.build()
    println("Query built, ready to execute")

    // Backup
    backup_database(&db, "backup.db".to_string())?

    println("Persistence layer test complete")
    Ok(())
}
