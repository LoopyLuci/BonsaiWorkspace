// TITAN WINDOW MANAGER - INTEGRATION TESTS & EXAMPLES
// Comprehensive testing suite for window manager functionality
// Location: system/WindowManager.Tests.titan
// 2026-06-24

module WindowManagerTests {

    use TitanWindowManager::*;
    use WindowManagerPlatformIntegration::*;

    // ========================================================================
    // UNIT TEST HELPERS
    // ========================================================================

    pub struct TestResult {
        pub name: String,
        pub passed: bool,
        pub message: String,
        pub duration_ms: u64,
    }

    impl TestResult {
        pub fn passed(name: &str, duration_ms: u64) -> Self {
            TestResult {
                name: name.to_string(),
                passed: true,
                message: "✅ PASSED".to_string(),
                duration_ms,
            }
        }

        pub fn failed(name: &str, message: &str, duration_ms: u64) -> Self {
            TestResult {
                name: name.to_string(),
                passed: false,
                message: format!("❌ FAILED: {}", message),
                duration_ms,
            }
        }

        pub fn report(&self) {
            println!(
                "  {} {} ({}ms)",
                self.message, self.name, self.duration_ms
            );
        }
    }

    // ========================================================================
    // CORE FUNCTIONALITY TESTS
    // ========================================================================

    pub fn test_window_creation() -> TestResult {
        let wm = create_window_manager(256);
        let start = get_time_ms();

        match wm.create_window("Test Window".into(), 100, 100, 800, 600) {
            Ok(window_id) => {
                if window_id > 0 {
                    let _ = wm.destroy_window(window_id);
                    TestResult::passed("Window Creation", get_time_ms() - start)
                } else {
                    TestResult::failed("Window Creation", "Invalid window ID", get_time_ms() - start)
                }
            }
            Err(e) => TestResult::failed("Window Creation", &e, get_time_ms() - start),
        }
    }

    pub fn test_window_destruction() -> TestResult {
        let wm = create_window_manager(256);
        let start = get_time_ms();

        let window_id = match wm.create_window("Test".into(), 0, 0, 100, 100) {
            Ok(id) => id,
            Err(_) => return TestResult::failed("Window Destruction", "Failed to create", get_time_ms() - start),
        };

        match wm.destroy_window(window_id) {
            Ok(_) => {
                if wm.get_window(window_id).ok().flatten().is_none() {
                    TestResult::passed("Window Destruction", get_time_ms() - start)
                } else {
                    TestResult::failed("Window Destruction", "Window still exists", get_time_ms() - start)
                }
            }
            Err(e) => TestResult::failed("Window Destruction", &e, get_time_ms() - start),
        }
    }

    pub fn test_window_movement() -> TestResult {
        let wm = create_window_manager(256);
        let start = get_time_ms();

        let window_id = match wm.create_window("Test".into(), 0, 0, 100, 100) {
            Ok(id) => id,
            Err(_) => return TestResult::failed("Window Movement", "Failed to create", get_time_ms() - start),
        };

        match wm.move_window(window_id, 500, 500) {
            Ok(_) => {
                if let Ok(Some(window)) = wm.get_window(window_id) {
                    if window.position.x == 500 && window.position.y == 500 {
                        let _ = wm.destroy_window(window_id);
                        TestResult::passed("Window Movement", get_time_ms() - start)
                    } else {
                        TestResult::failed("Window Movement", "Position mismatch", get_time_ms() - start)
                    }
                } else {
                    TestResult::failed("Window Movement", "Window not found", get_time_ms() - start)
                }
            }
            Err(e) => TestResult::failed("Window Movement", &e, get_time_ms() - start),
        }
    }

    pub fn test_window_resizing() -> TestResult {
        let wm = create_window_manager(256);
        let start = get_time_ms();

        let window_id = match wm.create_window("Test".into(), 0, 0, 100, 100) {
            Ok(id) => id,
            Err(_) => return TestResult::failed("Window Resizing", "Failed to create", get_time_ms() - start),
        };

        match wm.resize_window(window_id, 1024, 768) {
            Ok(_) => {
                if let Ok(Some(window)) = wm.get_window(window_id) {
                    if window.dimensions.width == 1024 && window.dimensions.height == 768 {
                        let _ = wm.destroy_window(window_id);
                        TestResult::passed("Window Resizing", get_time_ms() - start)
                    } else {
                        TestResult::failed("Window Resizing", "Dimensions mismatch", get_time_ms() - start)
                    }
                } else {
                    TestResult::failed("Window Resizing", "Window not found", get_time_ms() - start)
                }
            }
            Err(e) => TestResult::failed("Window Resizing", &e, get_time_ms() - start),
        }
    }

    pub fn test_focus_management() -> TestResult {
        let wm = create_window_manager(256);
        let start = get_time_ms();

        let win1 = match wm.create_window("Win1".into(), 0, 0, 100, 100) {
            Ok(id) => id,
            Err(_) => return TestResult::failed("Focus Management", "Failed to create window 1", get_time_ms() - start),
        };

        let win2 = match wm.create_window("Win2".into(), 200, 200, 100, 100) {
            Ok(id) => id,
            Err(_) => return TestResult::failed("Focus Management", "Failed to create window 2", get_time_ms() - start),
        };

        if wm.focus_window(win1).is_err() {
            return TestResult::failed("Focus Management", "Failed to focus window 1", get_time_ms() - start);
        }

        match wm.get_focused_window() {
            Ok(Some(focused)) => {
                if focused == win1 {
                    let _ = wm.destroy_window(win1);
                    let _ = wm.destroy_window(win2);
                    TestResult::passed("Focus Management", get_time_ms() - start)
                } else {
                    TestResult::failed("Focus Management", "Wrong window focused", get_time_ms() - start)
                }
            }
            _ => TestResult::failed("Focus Management", "Focus query failed", get_time_ms() - start),
        }
    }

    pub fn test_window_state_changes() -> TestResult {
        let wm = create_window_manager(256);
        let start = get_time_ms();

        let window_id = match wm.create_window("Test".into(), 0, 0, 100, 100) {
            Ok(id) => id,
            Err(_) => return TestResult::failed("State Changes", "Failed to create", get_time_ms() - start),
        };

        if wm.minimize_window(window_id).is_err() {
            return TestResult::failed("State Changes", "Minimize failed", get_time_ms() - start);
        }

        if wm.maximize_window(window_id).is_err() {
            return TestResult::failed("State Changes", "Maximize failed", get_time_ms() - start);
        }

        if wm.restore_window(window_id).is_err() {
            return TestResult::failed("State Changes", "Restore failed", get_time_ms() - start);
        }

        let _ = wm.destroy_window(window_id);
        TestResult::passed("State Changes", get_time_ms() - start)
    }

    // ========================================================================
    // EVENT HANDLING TESTS
    // ========================================================================

    pub fn test_event_queue() -> TestResult {
        let wm = create_window_manager(256);
        let start = get_time_ms();

        let event = InputEvent::MouseMove {
            x: 100, y: 100,
            delta_x: 5, delta_y: 5,
        };

        match wm.push_input_event(event.clone()) {
            Ok(_) => {
                if wm.pending_events() > 0 {
                    match wm.pop_event() {
                        Some(Event::Input(_)) => TestResult::passed("Event Queue", get_time_ms() - start),
                        _ => TestResult::failed("Event Queue", "Wrong event type", get_time_ms() - start),
                    }
                } else {
                    TestResult::failed("Event Queue", "No events pending", get_time_ms() - start)
                }
            }
            Err(e) => TestResult::failed("Event Queue", &e, get_time_ms() - start),
        }
    }

    pub fn test_input_state_tracking() -> TestResult {
        let wm = create_window_manager(256);
        let start = get_time_ms();

        let event = InputEvent::MouseMove {
            x: 400, y: 300,
            delta_x: 0, delta_y: 0,
        };

        if wm.process_input_event(event).is_err() {
            return TestResult::failed("Input State", "Process failed", get_time_ms() - start);
        }

        match wm.get_input_state() {
            Ok(state) => {
                if state.mouse_x == 400 && state.mouse_y == 300 {
                    TestResult::passed("Input State", get_time_ms() - start)
                } else {
                    TestResult::failed("Input State", "Mouse position mismatch", get_time_ms() - start)
                }
            }
            Err(e) => TestResult::failed("Input State", &e, get_time_ms() - start),
        }
    }

    pub fn test_keyboard_events() -> TestResult {
        let wm = create_window_manager(256);
        let start = get_time_ms();

        let key_down = InputEvent::KeyDown {
            code: KeyCode::Char('A'),
            modifiers: 0x02,  // Ctrl
        };

        if wm.process_input_event(key_down).is_err() {
            return TestResult::failed("Keyboard Events", "Process failed", get_time_ms() - start);
        }

        match wm.get_input_state() {
            Ok(state) => {
                if state.is_ctrl_pressed() {
                    TestResult::passed("Keyboard Events", get_time_ms() - start)
                } else {
                    TestResult::failed("Keyboard Events", "Modifier not set", get_time_ms() - start)
                }
            }
            Err(e) => TestResult::failed("Keyboard Events", &e, get_time_ms() - start),
        }
    }

    // ========================================================================
    // DISPLAY MANAGEMENT TESTS
    // ========================================================================

    pub fn test_display_registration() -> TestResult {
        let wm = create_window_manager(256);
        let start = get_time_ms();

        let display = Display {
            id: 0,
            name: "Test Display".into(),
            x: 0, y: 0,
            width: 1920, height: 1080,
            dpi: 96,
            refresh_rate: 60,
            is_primary: true,
        };

        match wm.register_display(display) {
            Ok(_) => {
                match wm.get_primary_display() {
                    Ok(Some(d)) => {
                        if d.name == "Test Display" {
                            TestResult::passed("Display Registration", get_time_ms() - start)
                        } else {
                            TestResult::failed("Display Registration", "Name mismatch", get_time_ms() - start)
                        }
                    }
                    _ => TestResult::failed("Display Registration", "Display not found", get_time_ms() - start),
                }
            }
            Err(e) => TestResult::failed("Display Registration", &e, get_time_ms() - start),
        }
    }

    // ========================================================================
    // QUERY TESTS
    // ========================================================================

    pub fn test_window_lookup() -> TestResult {
        let wm = create_window_manager(256);
        let start = get_time_ms();

        let window_id = match wm.create_window("Test".into(), 100, 100, 200, 200) {
            Ok(id) => id,
            Err(_) => return TestResult::failed("Window Lookup", "Failed to create", get_time_ms() - start),
        };

        match wm.get_window_at_point(150, 150) {
            Ok(Some(found_id)) => {
                if found_id == window_id {
                    let _ = wm.destroy_window(window_id);
                    TestResult::passed("Window Lookup", get_time_ms() - start)
                } else {
                    TestResult::failed("Window Lookup", "Wrong window found", get_time_ms() - start)
                }
            }
            _ => TestResult::failed("Window Lookup", "Window not found", get_time_ms() - start),
        }
    }

    pub fn test_z_order() -> TestResult {
        let wm = create_window_manager(256);
        let start = get_time_ms();

        let win1 = wm.create_window("Win1".into(), 0, 0, 100, 100).unwrap();
        let win2 = wm.create_window("Win2".into(), 50, 50, 100, 100).unwrap();

        match wm.get_z_order() {
            Ok(order) => {
                if order.len() == 2 && order[1] == win2 {
                    let _ = wm.destroy_window(win1);
                    let _ = wm.destroy_window(win2);
                    TestResult::passed("Z-Order", get_time_ms() - start)
                } else {
                    TestResult::failed("Z-Order", "Order incorrect", get_time_ms() - start)
                }
            }
            Err(e) => TestResult::failed("Z-Order", &e, get_time_ms() - start),
        }
    }

    // ========================================================================
    // PERFORMANCE TESTS
    // ========================================================================

    pub fn test_event_latency() -> TestResult {
        let wm = create_window_manager(256);
        let start = get_time_ms();

        let event_start = get_time_ns();
        let _ = wm.push_input_event(InputEvent::MouseMove {
            x: 100, y: 100,
            delta_x: 0, delta_y: 0,
        });
        let event_end = get_time_ns();

        let latency_us = (event_end - event_start) / 1000;

        if latency_us < 1000 {  // Less than 1ms
            TestResult::passed("Event Latency", get_time_ms() - start)
        } else {
            TestResult::failed(
                "Event Latency",
                &format!("Latency too high: {} us", latency_us),
                get_time_ms() - start,
            )
        }
    }

    pub fn test_high_frequency_events() -> TestResult {
        let wm = create_window_manager(512);
        let start = get_time_ms();

        let mut count = 0;
        for i in 0..100 {
            match wm.push_input_event(InputEvent::MouseMove {
                x: i * 10, y: i * 10,
                delta_x: 10, delta_y: 10,
            }) {
                Ok(_) => count += 1,
                Err(_) => break,
            }
        }

        if count == 100 {
            TestResult::passed("High Frequency Events", get_time_ms() - start)
        } else {
            TestResult::failed(
                "High Frequency Events",
                &format!("Only {} events processed", count),
                get_time_ms() - start,
            )
        }
    }

    // ========================================================================
    // PLATFORM INTEGRATION TESTS
    // ========================================================================

    pub fn test_platform_detection() -> TestResult {
        let start = get_time_ms();
        let platform_info = detect_platform();

        if platform_info.platform != Platform::Unknown {
            TestResult::passed("Platform Detection", get_time_ms() - start)
        } else {
            TestResult::failed("Platform Detection", "Unknown platform", get_time_ms() - start)
        }
    }

    pub fn test_windows_integration() -> TestResult {
        let start = get_time_ms();
        let wm = WindowsWindowManager::new();

        match wm.create_native_window("Test", 100, 100, 800, 600) {
            Ok(handle) => {
                if handle.hwnd > 0 {
                    TestResult::passed("Windows Integration", get_time_ms() - start)
                } else {
                    TestResult::failed("Windows Integration", "Invalid HWND", get_time_ms() - start)
                }
            }
            Err(e) => TestResult::failed("Windows Integration", &e, get_time_ms() - start),
        }
    }

    pub fn test_macos_integration() -> TestResult {
        let start = get_time_ms();
        let wm = MacOSWindowManager::new();

        match wm.create_native_window("Test", 100, 100, 800, 600) {
            Ok(handle) => {
                if handle.nswindow > 0 {
                    TestResult::passed("macOS Integration", get_time_ms() - start)
                } else {
                    TestResult::failed("macOS Integration", "Invalid NSWindow", get_time_ms() - start)
                }
            }
            Err(e) => TestResult::failed("macOS Integration", &e, get_time_ms() - start),
        }
    }

    pub fn test_linux_integration() -> TestResult {
        let start = get_time_ms();
        let wm = LinuxWindowManager::new();

        match wm.create_native_window("Test", 100, 100, 800, 600) {
            Ok(handle) => {
                if handle.window_id > 0 {
                    TestResult::passed("Linux Integration", get_time_ms() - start)
                } else {
                    TestResult::failed("Linux Integration", "Invalid Window ID", get_time_ms() - start)
                }
            }
            Err(e) => TestResult::failed("Linux Integration", &e, get_time_ms() - start),
        }
    }

    // ========================================================================
    // TEST SUITE RUNNER
    // ========================================================================

    pub fn run_all_tests() {
        println!("\n🧪 TITAN Window Manager - Test Suite");
        println!("====================================\n");

        let mut results = Vec::new();

        // Core tests
        println!("📋 Core Functionality Tests:");
        results.push(test_window_creation());
        results.push(test_window_destruction());
        results.push(test_window_movement());
        results.push(test_window_resizing());
        results.push(test_focus_management());
        results.push(test_window_state_changes());

        // Event tests
        println!("\n📨 Event Handling Tests:");
        results.push(test_event_queue());
        results.push(test_input_state_tracking());
        results.push(test_keyboard_events());

        // Display tests
        println!("\n📺 Display Management Tests:");
        results.push(test_display_registration());

        // Query tests
        println!("\n🔍 Query Tests:");
        results.push(test_window_lookup());
        results.push(test_z_order());

        // Performance tests
        println!("\n⚡ Performance Tests:");
        results.push(test_event_latency());
        results.push(test_high_frequency_events());

        // Platform tests
        println!("\n🖥️  Platform Integration Tests:");
        results.push(test_platform_detection());
        results.push(test_windows_integration());
        results.push(test_macos_integration());
        results.push(test_linux_integration());

        // Print results
        println!("\n📊 Test Results:");
        println!("================\n");

        let mut passed = 0;
        let mut failed = 0;

        for result in &results {
            result.report();
            if result.passed {
                passed += 1;
            } else {
                failed += 1;
            }
        }

        println!("\n✅ Passed: {}", passed);
        println!("❌ Failed: {}", failed);
        println!("📈 Total:  {}", results.len());
        println!("\n{:.1}% Success Rate", (passed as f32 / results.len() as f32) * 100.0);
    }

    // ========================================================================
    // TIME UTILITIES
    // ========================================================================

    fn get_time_ms() -> u64 {
        use std::time::{SystemTime, UNIX_EPOCH};
        SystemTime::now()
            .duration_since(UNIX_EPOCH)
            .unwrap()
            .as_millis() as u64
    }

    fn get_time_ns() -> u64 {
        use std::time::{SystemTime, UNIX_EPOCH};
        SystemTime::now()
            .duration_since(UNIX_EPOCH)
            .unwrap()
            .as_nanos() as u64
    }

}

// ========================================================================
// TEST ENTRY POINT
// ========================================================================

pub fn run_window_manager_tests() {
    WindowManagerTests::run_all_tests();
}
