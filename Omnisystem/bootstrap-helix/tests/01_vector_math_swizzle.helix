// @ expect-stdout: 0.0000
// @ expect-stdout: vec3(0.0000, 0.0000, 1.0000)
// @ expect-stdout: 5.0000
// @ expect-stdout: vec3(1.0000, 2.0000, 3.0000)
// @ expect-stdout: 4.0000
// @ expect-stdout: vec3(1.0000, 2.0000, 3.0000)
// @ expect-stdout: 1.0000
let a = vec3(1.0, 0.0, 0.0)
let b = vec3(0.0, 1.0, 0.0)
puts(dot(a, b))
puts(cross(a, b))
puts(length(vec3(3.0, 4.0, 0.0)))

let v = vec4(1.0, 2.0, 3.0, 4.0)
puts(v.xyz)
puts(v.w)
puts(v.rgb)

let n = normalize(vec3(3.0, 4.0, 0.0))
puts(length(n))
