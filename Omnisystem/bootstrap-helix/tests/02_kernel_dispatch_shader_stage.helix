// @ expect-stdout: [2.0000, 4.0000, 6.0000, 8.0000]
// @ expect-stdout: [vec4(1.0000, 0.0000, 0.0000, 1.0000), vec4(2.0000, 1.0000, 1.0000, 1.0000)]
kernel Double(id, buf) {
  buf[id] = buf[id] * 2.0
}

let data = buffer(1.0, 2.0, 3.0, 4.0)
dispatch(Double, data, 4)
puts(data)

shader vertex Transform(pos) {
  return vec4(pos.x + 1.0, pos.y, pos.z, 1.0)
}

let verts = buffer(vec3(0.0, 0.0, 0.0), vec3(1.0, 1.0, 1.0))
let out = run_stage(Transform, verts)
puts(out)
