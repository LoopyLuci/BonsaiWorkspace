pub struct IDEScreenFactory {
    language: String
}

impl IDEScreenFactory {
    pub fn new(language: String) -> Self {
        IDEScreenFactory {
            language: language
        }
    }

    pub fn render_all_screens(self: Self) -> Object {
        let screens = Object::new()

        match self.language {
            "TITAN" => {
                screens["editor"] = TitanIDE::render_editor_screen()
                screens["console"] = TitanIDE::render_console_screen()
                screens["debugger"] = TitanIDE::render_debugger_screen()
                screens["output"] = TitanIDE::render_output_screen()
                screens["project"] = TitanIDE::render_project_manager_screen()
                screens["packages"] = TitanIDE::render_package_manager_screen()
                screens["settings"] = TitanIDE::render_settings_screen()
                screens["theme"] = TitanIDE::render_theme_selector_screen()
            },
            "SYLVA" => {
                screens["editor"] = SylvaIDE::render_editor_screen()
                screens["notebook"] = SylvaIDE::render_notebook_screen()
                screens["training"] = SylvaIDE::render_training_screen()
                screens["data"] = SylvaIDE::render_data_explorer_screen()
                screens["gallery"] = SylvaIDE::render_model_gallery_screen()
                screens["metrics"] = SylvaIDE::render_metrics_screen()
                screens["viz"] = SylvaIDE::render_visualization_screen()
            },
            "AETHER" => {
                screens["editor"] = AetherIDE::render_editor_screen()
                screens["network"] = AetherIDE::render_network_screen()
                screens["replication"] = AetherIDE::render_replication_screen()
                screens["actors"] = AetherIDE::render_actor_monitor_screen()
                screens["sync"] = AetherIDE::render_sync_explorer_screen()
                screens["dist"] = AetherIDE::render_distribution_screen()
                screens["cluster"] = AetherIDE::render_clustering_screen()
                screens["failover"] = AetherIDE::render_failover_screen()
            },
            "AXIOM" => {
                screens["editor"] = AxiomIDE::render_editor_screen()
                screens["prover"] = AxiomIDE::render_prover_screen()
                screens["verify"] = AxiomIDE::render_verification_screen()
                screens["types"] = AxiomIDE::render_type_checker_screen()
                screens["invariants"] = AxiomIDE::render_invariant_screen()
                screens["security"] = AxiomIDE::render_security_proofs_screen()
                screens["perf"] = AxiomIDE::render_performance_bounds_screen()
                screens["coverage"] = AxiomIDE::render_coverage_screen()
            },
            _ => {}
        }

        screens
    }

    pub fn count_screens(self: Self) -> Int {
        match self.language {
            "TITAN" => 8,
            "SYLVA" => 7,
            "AETHER" => 8,
            "AXIOM" => 8,
            _ => 0
        }
    }
}

pub fn get_all_ide_screens() -> Object {
    let mut all_screens = Object::new()

    let titan = IDEScreenFactory::new("TITAN")
    all_screens["TITAN"] = titan.render_all_screens()

    let sylva = IDEScreenFactory::new("SYLVA")
    all_screens["SYLVA"] = sylva.render_all_screens()

    let aether = IDEScreenFactory::new("AETHER")
    all_screens["AETHER"] = aether.render_all_screens()

    let axiom = IDEScreenFactory::new("AXIOM")
    all_screens["AXIOM"] = axiom.render_all_screens()

    all_screens
}

pub fn count_total_ide_screens() -> Int {
    8 + 7 + 8 + 8  // 31 IDE screens total
}
