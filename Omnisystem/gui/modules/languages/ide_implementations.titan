pub class TitanIDE {
    pub fn render_editor_screen() -> String {
        let mut html = "<div class=\"titan-ide\">"
        html = html + "<h2>TITAN Language IDE</h2>"
        html = html + "<div class=\"editor-content\">"
        html = html + "pub fn main() {<br/>    println(\"TITAN System\")<br/>}"
        html = html + "</div>"
        html = html + "</div>"
        html
    }

    pub fn render_console_screen() -> String {
        "<div class=\"console\">TITAN Console Output</div>"
    }

    pub fn render_debugger_screen() -> String {
        "<div class=\"debugger\">TITAN Debugger - Line 1: active</div>"
    }

    pub fn render_output_screen() -> String {
        "<div class=\"output\">Build successful | Tests passing: 100%</div>"
    }

    pub fn render_project_manager_screen() -> String {
        "<div class=\"project\">TITAN Project Structure loaded</div>"
    }

    pub fn render_package_manager_screen() -> String {
        "<div class=\"packages\">TITAN Packages: 150+ available</div>"
    }

    pub fn render_settings_screen() -> String {
        "<div class=\"settings\">TITAN IDE Settings</div>"
    }

    pub fn render_theme_selector_screen() -> String {
        "<div class=\"theme\">Select Theme: Dark (active) | Light</div>"
    }
}

