// OMNISYSTEM GUI - LAYOUT SYSTEM (TIER 1)
// Responsive layout components using Omni Assets
// Location: gui/foundation/layout/layout.titan
// 2026-06-15

pub enum DisplayType {
    Flex,
    Grid,
    Block,
    Inline,
    InlineBlock
}

pub enum FlexDirection {
    Row,
    Column,
    RowReverse,
    ColumnReverse
}

pub enum JustifyContent {
    Start,
    End,
    Center,
    Between,
    Around,
    Evenly
}

pub enum AlignItems {
    Start,
    End,
    Center,
    Stretch,
    Baseline
}

pub struct LayoutConfig {
    display: DisplayType
    padding: String
    margin: String
    width: String
    height: String
    backgroundColor: String
    borderRadius: String
}

pub class Container {
    config: LayoutConfig
    children: Array[String]
    responsive: Bool
    maxWidth: String

    pub fn new() -> Self {
        Container {
            config: LayoutConfig {
                display: DisplayType::Block,
                padding: "16px",
                margin: "0",
                width: "100%",
                height: "auto",
                backgroundColor: "transparent",
                borderRadius: "0"
            },
            children: Array::new(),
            responsive: true,
            maxWidth: "1200px"
        }
    }

    pub fn render(self: Self) -> String {
        let style = self.get_style()
        let mut html = "<div class=\"container\" style=\"" + style + "\">"

        for child in self.children {
            html = html + child
        }

        html = html + "</div>"
        html
    }

    fn get_style(self: Self) -> String {
        let mut style = ""
        style = style + "padding: " + self.config.padding + "; "
        style = style + "margin: " + self.config.margin + "; "
        style = style + "width: " + self.config.width + "; "
        style = style + "max-width: " + self.maxWidth + "; "
        style = style + "background-color: " + self.config.backgroundColor + "; "
        style = style + "border-radius: " + self.config.borderRadius + "; "
        style
    }

    pub fn add_child(mut self: Self, child: String) -> Self {
        self.children.push(child)
        self
    }

    pub fn set_padding(mut self: Self, padding: String) -> Self {
        self.config.padding = padding
        self
    }

    pub fn set_background_color(mut self: Self, color: String) -> Self {
        self.config.backgroundColor = color
        self
    }
}

pub class FlexBox {
    config: LayoutConfig
    direction: FlexDirection
    justifyContent: JustifyContent
    alignItems: AlignItems
    gap: String
    wrap: Bool
    children: Array[String]

    pub fn new() -> Self {
        FlexBox {
            config: LayoutConfig {
                display: DisplayType::Flex,
                padding: "0",
                margin: "0",
                width: "100%",
                height: "auto",
                backgroundColor: "transparent",
                borderRadius: "0"
            },
            direction: FlexDirection::Row,
            justifyContent: JustifyContent::Start,
            alignItems: AlignItems::Start,
            gap: "8px",
            wrap: false,
            children: Array::new()
        }
    }

    pub fn render(self: Self) -> String {
        let style = self.get_style()
        let mut html = "<div class=\"flexbox\" style=\"" + style + "\">"

        for child in self.children {
            html = html + child
        }

        html = html + "</div>"
        html
    }

    fn get_style(self: Self) -> String {
        let mut style = "display: flex; "
        style = style + "flex-direction: " + self.direction.to_string().to_lowercase() + "; "
        style = style + "justify-content: " + self.justifyContent.to_string().to_lowercase() + "; "
        style = style + "align-items: " + self.alignItems.to_string().to_lowercase() + "; "
        style = style + "gap: " + self.gap + "; "
        if self.wrap {
            style = style + "flex-wrap: wrap; "
        }
        style = style + "width: " + self.config.width + "; "
        style = style + "padding: " + self.config.padding + "; "
        style
    }

    pub fn add_child(mut self: Self, child: String) -> Self {
        self.children.push(child)
        self
    }

    pub fn set_direction(mut self: Self, direction: FlexDirection) -> Self {
        self.direction = direction
        self
    }

    pub fn set_justify_content(mut self: Self, justify: JustifyContent) -> Self {
        self.justifyContent = justify
        self
    }

    pub fn set_align_items(mut self: Self, align: AlignItems) -> Self {
        self.alignItems = align
        self
    }

    pub fn set_gap(mut self: Self, gap: String) -> Self {
        self.gap = gap
        self
    }

    pub fn set_wrap(mut self: Self, wrap: Bool) -> Self {
        self.wrap = wrap
        self
    }
}

pub class GridBox {
    config: LayoutConfig
    columns: Int
    rows: Int
    gap: String
    autoFlow: String
    children: Array[String]

    pub fn new(columns: Int) -> Self {
        GridBox {
            config: LayoutConfig {
                display: DisplayType::Grid,
                padding: "0",
                margin: "0",
                width: "100%",
                height: "auto",
                backgroundColor: "transparent",
                borderRadius: "0"
            },
            columns: columns,
            rows: 0,
            gap: "16px",
            autoFlow: "row",
            children: Array::new()
        }
    }

    pub fn render(self: Self) -> String {
        let style = self.get_style()
        let mut html = "<div class=\"gridbox\" style=\"" + style + "\">"

        for child in self.children {
            html = html + child
        }

        html = html + "</div>"
        html
    }

    fn get_style(self: Self) -> String {
        let colsStr = self.columns.to_string()
        let mut style = "display: grid; "
        style = style + "grid-template-columns: repeat(" + colsStr + ", 1fr); "
        style = style + "gap: " + self.gap + "; "
        style = style + "width: " + self.config.width + "; "
        style = style + "padding: " + self.config.padding + "; "
        style
    }

    pub fn add_child(mut self: Self, child: String) -> Self {
        self.children.push(child)
        self
    }

    pub fn set_columns(mut self: Self, columns: Int) -> Self {
        self.columns = columns
        self
    }

    pub fn set_gap(mut self: Self, gap: String) -> Self {
        self.gap = gap
        self
    }
}

pub class Stack {
    direction: String
    spacing: String
    children: Array[String]

    pub fn new(direction: String) -> Self {
        Stack {
            direction: direction,
            spacing: "16px",
            children: Array::new()
        }
    }

    pub fn render(self: Self) -> String {
        let mut style = "display: flex; "
        if self.direction == "vertical" {
            style = style + "flex-direction: column; "
        } else {
            style = style + "flex-direction: row; "
        }
        style = style + "gap: " + self.spacing + "; "

        let mut html = "<div style=\"" + style + "\">"

        for child in self.children {
            html = html + child
        }

        html = html + "</div>"
        html
    }

    pub fn add_child(mut self: Self, child: String) -> Self {
        self.children.push(child)
        self
    }

    pub fn set_spacing(mut self: Self, spacing: String) -> Self {
        self.spacing = spacing
        self
    }
}

pub class Row {
    columns: Int
    gap: String
    children: Array[String]

    pub fn new() -> Self {
        Row {
            columns: 12,
            gap: "16px",
            children: Array::new()
        }
    }

    pub fn render(self: Self) -> String {
        let colsStr = self.columns.to_string()
        let mut html = "<div class=\"row\" style=\"display: grid; grid-template-columns: repeat(" + colsStr + ", 1fr); gap: " + self.gap + ";\">"

        for child in self.children {
            html = html + child
        }

        html = html + "</div>"
        html
    }

    pub fn add_child(mut self: Self, child: String) -> Self {
        self.children.push(child)
        self
    }
}

pub class Column {
    span: Int
    children: Array[String]

    pub fn new(span: Int) -> Self {
        Column {
            span: span,
            children: Array::new()
        }
    }

    pub fn render(self: Self) -> String {
        let spanStr = self.span.to_string()
        let mut html = "<div class=\"column\" style=\"grid-column: span " + spanStr + ";\">"

        for child in self.children {
            html = html + child
        }

        html = html + "</div>"
        html
    }

    pub fn add_child(mut self: Self, child: String) -> Self {
        self.children.push(child)
        self
    }
}

// Spacer component for consistent spacing
pub struct Spacer {
    size: String

    pub fn new(size: String) -> Self {
        Spacer {
            size: size
        }
    }

    pub fn render(self: Self) -> String {
        "<div style=\"height: " + self.size + "; width: 100%;\"></div>"
    }
}

// Divider component
pub struct Divider {
    color: String
    thickness: String
    orientation: String

    pub fn new() -> Self {
        Divider {
            color: "#E0E0E0",
            thickness: "1px",
            orientation: "horizontal"
        }
    }

    pub fn render(self: Self) -> String {
        if self.orientation == "vertical" {
            "<div style=\"border-left: " + self.thickness + " solid " + self.color + "; height: 100%;\"></div>"
        } else {
            "<div style=\"border-top: " + self.thickness + " solid " + self.color + "; width: 100%;\"></div>"
        }
    }
}
