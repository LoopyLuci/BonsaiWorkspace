// OMNISYSTEM GUI - INPUT COMPONENTS (TIER 1)
// Foundation input components using Omni Assets
// Location: gui/foundation/components/inputs.titan
// 2026-06-15

pub enum InputType {
    Text,
    Email,
    Password,
    Number,
    Date,
    Time,
    DateTime,
    Search,
    Textarea,
    Select,
    Checkbox,
    Radio,
    Toggle,
    Range,
    File,
    Color
}

pub enum InputSize {
    Small,
    Medium,
    Large,
    XLarge
}

pub enum InputState {
    Default,
    Focused,
    Filled,
    Error,
    Success,
    Warning,
    Disabled,
    Loading
}

pub struct InputConfig {
    inputType: InputType
    size: InputSize
    state: InputState
    label: String
    placeholder: String
    value: String
    disabled: Bool
    readonly: Bool
    required: Bool
    error: String
    helper: String
    icon: String
    iconPosition: String
    min: String
    max: String
    pattern: String
}

pub class InputComponent {
    config: InputConfig
    onChange: String
    onFocus: String
    onBlur: String
    validation: Object

    pub fn new(inputType: InputType) -> Self {
        InputComponent {
            config: InputConfig {
                inputType: inputType,
                size: InputSize::Medium,
                state: InputState::Default,
                label: "",
                placeholder: "",
                value: "",
                disabled: false,
                readonly: false,
                required: false,
                error: "",
                helper: "",
                icon: "",
                iconPosition: "left",
                min: "",
                max: "",
                pattern: ""
            },
            onChange: "",
            onFocus: "",
            onBlur: "",
            validation: Object::new()
        }
    }

    pub fn render(self: Self) -> String {
        let className = self.get_class_name()
        let mut html = "<div class=\"input-wrapper " + className + "\">"

        if !self.config.label.is_empty() {
            html = html + "<label class=\"input-label\">" + self.config.label
            if self.config.required {
                html = html + " <span class=\"required\">*</span>"
            }
            html = html + "</label>"
        }

        html = html + self.render_input_element()

        if !self.config.helper.is_empty() {
            html = html + "<span class=\"input-helper\">" + self.config.helper + "</span>"
        }

        if !self.config.error.is_empty() {
            html = html + "<span class=\"input-error\">" + self.config.error + "</span>"
        }

        html = html + "</div>"
        html
    }

    fn render_input_element(self: Self) -> String {
        match self.config.inputType {
            InputType::Textarea => self.render_textarea(),
            InputType::Select => self.render_select(),
            InputType::Checkbox => self.render_checkbox(),
            InputType::Radio => self.render_radio(),
            InputType::Toggle => self.render_toggle(),
            InputType::Range => self.render_range(),
            InputType::File => self.render_file(),
            _ => self.render_text_input()
        }
    }

    fn render_text_input(self: Self) -> String {
        let mut html = "<div class=\"input-container\">"

        if !self.config.icon.is_empty() && self.config.iconPosition == "left" {
            html = html + "<i class=\"input-icon icon-" + self.config.icon + "\"></i>"
        }

        let inputType = match self.config.inputType {
            InputType::Text => "text",
            InputType::Email => "email",
            InputType::Password => "password",
            InputType::Number => "number",
            InputType::Date => "date",
            InputType::Time => "time",
            InputType::DateTime => "datetime-local",
            InputType::Search => "search",
            InputType::Color => "color",
            _ => "text"
        }

        html = html + "<input type=\"" + inputType + "\" class=\"input-field\""
        html = html + " placeholder=\"" + self.config.placeholder + "\""
        html = html + " value=\"" + self.config.value + "\""

        if self.config.disabled {
            html = html + " disabled"
        }

        if self.config.readonly {
            html = html + " readonly"
        }

        if self.config.required {
            html = html + " required"
        }

        if !self.config.min.is_empty() {
            html = html + " min=\"" + self.config.min + "\""
        }

        if !self.config.max.is_empty() {
            html = html + " max=\"" + self.config.max + "\""
        }

        if !self.config.pattern.is_empty() {
            html = html + " pattern=\"" + self.config.pattern + "\""
        }

        if !self.onChange.is_empty() {
            html = html + " onchange=\"" + self.onChange + "\""
        }

        if !self.onFocus.is_empty() {
            html = html + " onfocus=\"" + self.onFocus + "\""
        }

        if !self.onBlur.is_empty() {
            html = html + " onblur=\"" + self.onBlur + "\""
        }

        html = html + ">"

        if !self.config.icon.is_empty() && self.config.iconPosition == "right" {
            html = html + "<i class=\"input-icon icon-" + self.config.icon + "\"></i>"
        }

        html = html + "</div>"
        html
    }

    fn render_textarea(self: Self) -> String {
        "<textarea class=\"input-field input-textarea\" placeholder=\"" + self.config.placeholder + "\">" + self.config.value + "</textarea>"
    }

    fn render_select(self: Self) -> String {
        "<select class=\"input-field input-select\"><option>" + self.config.placeholder + "</option></select>"
    }

    fn render_checkbox(self: Self) -> String {
        "<input type=\"checkbox\" class=\"input-checkbox\">"
    }

    fn render_radio(self: Self) -> String {
        "<input type=\"radio\" class=\"input-radio\">"
    }

    fn render_toggle(self: Self) -> String {
        "<div class=\"input-toggle\"><input type=\"checkbox\" class=\"toggle-input\"></div>"
    }

    fn render_range(self: Self) -> String {
        "<input type=\"range\" class=\"input-range\">"
    }

    fn render_file(self: Self) -> String {
        "<input type=\"file\" class=\"input-file\">"
    }

    fn get_class_name(self: Self) -> String {
        let mut classes = Array::new()

        classes.push("input")
        classes.push("input-" + self.config.inputType.to_string().to_lowercase())
        classes.push("input-" + self.config.size.to_string().to_lowercase())
        classes.push("input-" + self.config.state.to_string().to_lowercase())

        if self.config.disabled {
            classes.push("input-disabled")
        }

        if self.config.readonly {
            classes.push("input-readonly")
        }

        if self.config.required {
            classes.push("input-required")
        }

        if !self.config.error.is_empty() {
            classes.push("input-error-state")
        }

        join_classes(classes)
    }

    pub fn set_label(mut self: Self, label: String) -> Self {
        self.config.label = label
        self
    }

    pub fn set_placeholder(mut self: Self, placeholder: String) -> Self {
        self.config.placeholder = placeholder
        self
    }

    pub fn set_value(mut self: Self, value: String) -> Self {
        self.config.value = value
        self
    }

    pub fn set_error(mut self: Self, error: String) -> Self {
        self.config.error = error
        self.config.state = InputState::Error
        self
    }

    pub fn set_helper(mut self: Self, helper: String) -> Self {
        self.config.helper = helper
        self
    }

    pub fn set_disabled(mut self: Self, disabled: Bool) -> Self {
        self.config.disabled = disabled
        self
    }

    pub fn set_readonly(mut self: Self, readonly: Bool) -> Self {
        self.config.readonly = readonly
        self
    }

    pub fn set_required(mut self: Self, required: Bool) -> Self {
        self.config.required = required
        self
    }

    pub fn set_icon(mut self: Self, icon: String, position: String) -> Self {
        self.config.icon = icon
        self.config.iconPosition = position
        self
    }

    pub fn on_change(mut self: Self, handler: String) -> Self {
        self.onChange = handler
        self
    }

    pub fn on_focus(mut self: Self, handler: String) -> Self {
        self.onFocus = handler
        self
    }

    pub fn on_blur(mut self: Self, handler: String) -> Self {
        self.onBlur = handler
        self
    }
}

// Factory functions for common input types
pub fn create_text_input() -> InputComponent {
    InputComponent::new(InputType::Text)
}

pub fn create_email_input() -> InputComponent {
    InputComponent::new(InputType::Email).set_pattern("[a-z0-9._%+\\-]+@[a-z0-9.\\-]+\\.[a-z]{2,}$")
}

pub fn create_password_input() -> InputComponent {
    InputComponent::new(InputType::Password)
}

pub fn create_number_input() -> InputComponent {
    InputComponent::new(InputType::Number)
}

pub fn create_search_input() -> InputComponent {
    let input = InputComponent::new(InputType::Search)
    input.set_icon("search", "left")
}

pub fn create_textarea_input() -> InputComponent {
    InputComponent::new(InputType::Textarea)
}

pub fn create_date_input() -> InputComponent {
    InputComponent::new(InputType::Date)
}

pub fn create_time_input() -> InputComponent {
    InputComponent::new(InputType::Time)
}

// Input group for multiple inputs
pub struct InputGroup {
    inputs: Array[InputComponent]
    orientation: String
}

impl InputGroup {
    pub fn new() -> Self {
        InputGroup {
            inputs: Array::new(),
            orientation: "vertical"
        }
    }

    pub fn add_input(mut self: Self, input: InputComponent) -> Self {
        self.inputs.push(input)
        self
    }

    pub fn set_orientation(mut self: Self, orientation: String) -> Self {
        self.orientation = orientation
        self
    }

    pub fn render(self: Self) -> String {
        let mut html = "<div class=\"input-group input-group-" + self.orientation + "\">"

        for input in self.inputs {
            html = html + input.render()
        }

        html = html + "</div>"
        html
    }
}

// Form validation helper
pub struct FormValidator {
    rules: Object
    errors: Object

    pub fn new() -> Self {
        FormValidator {
            rules: Object::new(),
            errors: Object::new()
        }
    }

    pub fn add_rule(mut self: Self, field: String, rule: String, message: String) -> Self {
        self.rules[field] = rule
        self
    }

    pub fn validate(mut self: Self, formData: Object) -> Bool {
        self.errors = Object::new()

        for field in formData.keys() {
            if self.rules.has(field) {
                let isValid = validate_field(formData[field], self.rules[field])
                if !isValid {
                    self.errors[field] = "Validation failed"
                }
            }
        }

        self.errors.is_empty()
    }

    pub fn get_errors(self: Self) -> Object {
        self.errors
    }
}

fn join_classes(classes: Array[String]) -> String {
    let mut result = ""
    for i in 0..classes.len() {
        if i > 0 {
            result = result + " "
        }
        result = result + classes[i]
    }
    result
}

fn validate_field(value: String, rule: String) -> Bool {
    !value.is_empty()
}
