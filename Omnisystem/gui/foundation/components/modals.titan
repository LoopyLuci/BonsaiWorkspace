// OMNISYSTEM GUI - MODAL/DIALOG COMPONENTS (TIER 1)
// Modal and dialog component system using Omni Assets
// Location: gui/foundation/components/modals.titan
// 2026-06-15

pub enum ModalSize {
    Small,
    Medium,
    Large,
    XLarge,
    Fullscreen
}

pub enum ModalType {
    Dialog,
    Alert,
    Confirmation,
    Form,
    Drawer,
    Notification
}

pub struct ModalConfig {
    modalType: ModalType
    size: ModalSize
    title: String
    content: String
    isOpen: Bool
    closeable: Bool
    backdropCloseable: Bool
    position: String
}

pub class ModalComponent {
    config: ModalConfig
    primaryAction: String
    secondaryAction: String
    onPrimaryClick: String
    onSecondaryClick: String
    onClose: String

    pub fn new(title: String) -> Self {
        ModalComponent {
            config: ModalConfig {
                modalType: ModalType::Dialog,
                size: ModalSize::Medium,
                title: title,
                content: "",
                isOpen: false,
                closeable: true,
                backdropCloseable: false,
                position: "center"
            },
            primaryAction: "",
            secondaryAction: "",
            onPrimaryClick: "",
            onSecondaryClick: "",
            onClose: ""
        }
    }

    pub fn render(self: Self) -> String {
        if !self.config.isOpen {
            return ""
        }

        let className = self.get_class_name()
        let mut html = "<div class=\"modal-backdrop " + className + "\">"

        html = html + "<div class=\"modal-container\">"
        html = html + "<div class=\"modal-header\">"
        html = html + "<h2 class=\"modal-title\">" + self.config.title + "</h2>"

        if self.config.closeable {
            html = html + "<button class=\"modal-close\" onclick=\"" + self.onClose + "\">×</button>"
        }

        html = html + "</div>"

        html = html + "<div class=\"modal-body\">"
        html = html + self.config.content
        html = html + "</div>"

        if !self.primaryAction.is_empty() || !self.secondaryAction.is_empty() {
            html = html + "<div class=\"modal-footer\">"

            if !self.secondaryAction.is_empty() {
                html = html + "<button class=\"btn btn-secondary\" onclick=\"" + self.onSecondaryClick + "\">" + self.secondaryAction + "</button>"
            }

            if !self.primaryAction.is_empty() {
                html = html + "<button class=\"btn btn-primary\" onclick=\"" + self.onPrimaryClick + "\">" + self.primaryAction + "</button>"
            }

            html = html + "</div>"
        }

        html = html + "</div>"
        html = html + "</div>"

        html
    }

    fn get_class_name(self: Self) -> String {
        let mut classes = Array::new()

        classes.push("modal-" + self.config.modalType.to_string().to_lowercase())
        classes.push("modal-" + self.config.size.to_string().to_lowercase())

        if self.config.backdropCloseable {
            classes.push("modal-backdrop-closeable")
        }

        join_classes(classes)
    }

    pub fn set_content(mut self: Self, content: String) -> Self {
        self.config.content = content
        self
    }

    pub fn set_type(mut self: Self, modalType: ModalType) -> Self {
        self.config.modalType = modalType
        self
    }

    pub fn set_size(mut self: Self, size: ModalSize) -> Self {
        self.config.size = size
        self
    }

    pub fn set_open(mut self: Self, isOpen: Bool) -> Self {
        self.config.isOpen = isOpen
        self
    }

    pub fn add_primary_action(mut self: Self, action: String) -> Self {
        self.primaryAction = action
        self
    }

    pub fn add_secondary_action(mut self: Self, action: String) -> Self {
        self.secondaryAction = action
        self
    }

    pub fn on_primary_click(mut self: Self, handler: String) -> Self {
        self.onPrimaryClick = handler
        self
    }

    pub fn on_secondary_click(mut self: Self, handler: String) -> Self {
        self.onSecondaryClick = handler
        self
    }

    pub fn on_close(mut self: Self, handler: String) -> Self {
        self.onClose = handler
        self
    }
}

// Alert dialog (common use case)
pub struct AlertDialog {
    title: String
    message: String
    type: String
    isOpen: Bool

    pub fn new(title: String, message: String) -> Self {
        AlertDialog {
            title: title,
            message: message,
            type: "info",
            isOpen: false
        }
    }

    pub fn render(self: Self) -> String {
        if !self.isOpen {
            return ""
        }

        let mut html = "<div class=\"alert-dialog alert-" + self.type + "\">"
        html = html + "<div class=\"alert-header\">"
        html = html + "<h3>" + self.title + "</h3>"
        html = html + "</div>"
        html = html + "<div class=\"alert-message\">" + self.message + "</div>"
        html = html + "<div class=\"alert-actions\">"
        html = html + "<button class=\"btn btn-primary\">OK</button>"
        html = html + "</div>"
        html = html + "</div>"
        html
    }
}

// Confirmation dialog (common use case)
pub struct ConfirmationDialog {
    title: String
    message: String
    confirmText: String
    cancelText: String
    isOpen: Bool
    onConfirm: String
    onCancel: String

    pub fn new(title: String, message: String) -> Self {
        ConfirmationDialog {
            title: title,
            message: message,
            confirmText: "Confirm",
            cancelText: "Cancel",
            isOpen: false,
            onConfirm: "",
            onCancel: ""
        }
    }

    pub fn render(self: Self) -> String {
        if !self.isOpen {
            return ""
        }

        let mut html = "<div class=\"confirmation-dialog\">"
        html = html + "<div class=\"dialog-header\">"
        html = html + "<h3>" + self.title + "</h3>"
        html = html + "</div>"
        html = html + "<div class=\"dialog-message\">" + self.message + "</div>"
        html = html + "<div class=\"dialog-actions\">"
        html = html + "<button class=\"btn btn-secondary\" onclick=\"" + self.onCancel + "\">" + self.cancelText + "</button>"
        html = html + "<button class=\"btn btn-primary\" onclick=\"" + self.onConfirm + "\">" + self.confirmText + "</button>"
        html = html + "</div>"
        html = html + "</div>"
        html
    }
}

// Toast notification (non-blocking)
pub struct ToastNotification {
    message: String
    type: String
    duration: Int
    isVisible: Bool

    pub fn new(message: String) -> Self {
        ToastNotification {
            message: message,
            type: "info",
            duration: 3000,
            isVisible: true
        }
    }

    pub fn render(self: Self) -> String {
        if !self.isVisible {
            return ""
        }

        let mut html = "<div class=\"toast toast-" + self.type + "\">"
        html = html + "<p class=\"toast-message\">" + self.message + "</p>"
        html = html + "</div>"
        html
    }
}

// Sidebar drawer
pub struct DrawerComponent {
    title: String
    content: String
    width: String
    isOpen: Bool
    position: String
    onClose: String

    pub fn new(title: String) -> Self {
        DrawerComponent {
            title: title,
            content: "",
            width: "300px",
            isOpen: false,
            position: "left",
            onClose: ""
        }
    }

    pub fn render(self: Self) -> String {
        if !self.isOpen {
            return ""
        }

        let mut html = "<div class=\"drawer drawer-" + self.position + "\" style=\"width: " + self.width + ";\">"
        html = html + "<div class=\"drawer-header\">"
        html = html + "<h3>" + self.title + "</h3>"
        html = html + "<button class=\"drawer-close\" onclick=\"" + self.onClose + "\">×</button>"
        html = html + "</div>"
        html = html + "<div class=\"drawer-content\">" + self.content + "</div>"
        html = html + "</div>"
        html
    }
}

fn join_classes(classes: Array[String]) -> String {
    let mut result = ""
    for i in 0..classes.len() {
        if i > 0 {
            result = result + " "
        }
        result = result + classes[i]
    }
    result
}
