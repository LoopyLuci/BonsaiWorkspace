pub struct Avatar {
    name: String
    src: String
    size: String
    online: Bool
    badge: String

    pub fn new(name: String) -> Self {
        Avatar {
            name: name,
            src: "",
            size: "medium",
            online: false,
            badge: ""
        }
    }

    pub fn render(self: Self) -> String {
        let sizeClass = match self.size {
            "small" => "32px",
            "large" => "56px",
            _ => "40px"
        }

        let mut html = "<div class=\"avatar\" style=\"width: " + sizeClass + "; height: " + sizeClass + "; position: relative;\">"

        if !self.src.is_empty() {
            html = html + "<img src=\"" + self.src + "\" alt=\"" + self.name + "\" style=\"width: 100%; height: 100%; border-radius: 50%; object-fit: cover;\">"
        } else {
            let initials = get_initials(self.name)
            html = html + "<div style=\"width: 100%; height: 100%; border-radius: 50%; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); display: flex; align-items: center; justify-content: center; color: white; font-weight: bold;\">" + initials + "</div>"
        }

        if self.online {
            html = html + "<span style=\"position: absolute; bottom: 0; right: 0; width: 12px; height: 12px; background-color: #10B981; border: 2px solid white; border-radius: 50%;\"></span>"
        }

        if !self.badge.is_empty() {
            html = html + "<span style=\"position: absolute; top: -4px; right: -4px; background-color: #EF4444; color: white; border-radius: 50%; width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; font-size: 12px;\">" + self.badge + "</span>"
        }

        html = html + "</div>"
        html
    }

    pub fn set_src(mut self: Self, src: String) -> Self {
        self.src = src
        self
    }

    pub fn set_online(mut self: Self, online: Bool) -> Self {
        self.online = online
        self
    }
}

pub struct Rating {
    value: Float
    maxValue: Int
    readonly: Bool
    interactive: Bool

    pub fn new(value: Float) -> Self {
        Rating {
            value: value,
            maxValue: 5,
            readonly: true,
            interactive: false
        }
    }

    pub fn render(self: Self) -> String {
        let mut html = "<div class=\"rating\">"

        for i in 1..self.maxValue + 1 {
            let iFloat = i.to_string().to_float()
            let filled = iFloat <= self.value

            let star = if filled { "★" } else { "☆" }
            let color = if filled { "color: #F59E0B;" } else { "color: #D1D5DB;" }

            html = html + "<span style=\"font-size: 20px; " + color + " cursor: " + if self.interactive { "pointer" } else { "default" } + ";\">" + star + "</span>"
        }

        html = html + "</div>"
        html
    }

    pub fn set_interactive(mut self: Self, interactive: Bool) -> Self {
        self.interactive = interactive
        self
    }
}

pub struct Tag {
    label: String
    icon: String
    closeable: Bool
    variant: String

    pub fn new(label: String) -> Self {
        Tag {
            label: label,
            icon: "",
            closeable: false,
            variant: "default"
        }
    }

    pub fn render(self: Self) -> String {
        let mut style = "display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; border-radius: 16px; font-size: 0.875rem; "

        style = match self.variant {
            "primary" => style + "background-color: #DBEAFE; color: #1E40AF; ",
            "success" => style + "background-color: #D1FAE5; color: #065F46; ",
            "warning" => style + "background-color: #FEF3C7; color: #78350F; ",
            "error" => style + "background-color: #FEE2E2; color: #7F1D1D; ",
            _ => style + "background-color: #E5E7EB; color: #374151; "
        }

        let mut html = "<span style=\"" + style + "\">"

        if !self.icon.is_empty() {
            html = html + "<i class=\"tag-icon icon-" + self.icon + "\"></i>"
        }

        html = html + self.label

        if self.closeable {
            html = html + "<button style=\"background: none; border: none; cursor: pointer; font-size: 18px; padding: 0;\">×</button>"
        }

        html = html + "</span>"
        html
    }

    pub fn set_variant(mut self: Self, variant: String) -> Self {
        self.variant = variant
        self
    }

    pub fn set_closeable(mut self: Self, closeable: Bool) -> Self {
        self.closeable = closeable
        self
    }
}

pub struct FileUpload {
    accept: String
    multiple: Bool
    dragDrop: Bool
    maxSize: Int
    uploaded: Array[String]

    pub fn new() -> Self {
        FileUpload {
            accept: "",
            multiple: false,
            dragDrop: true,
            maxSize: 10485760,
            uploaded: Array::new()
        }
    }

    pub fn render(self: Self) -> String {
        let mut html = "<div class=\"file-upload\">"

        html = html + "<input type=\"file\" class=\"file-input\" hidden"
        if !self.accept.is_empty() {
            html = html + " accept=\"" + self.accept + "\""
        }
        if self.multiple {
            html = html + " multiple"
        }
        html = html + ">"

        if self.dragDrop {
            html = html + "<div class=\"file-drop-zone\" style=\"border: 2px dashed #D1D5DB; border-radius: 8px; padding: 40px; text-align: center; cursor: pointer;\">"
            html = html + "<i class=\"file-icon\" style=\"font-size: 32px;\">📁</i>"
            html = html + "<p style=\"margin: 16px 0 0 0;\">Drag files here or click to upload</p>"
            html = html + "</div>"
        } else {
            html = html + "<button class=\"btn btn-secondary\">Choose Files</button>"
        }

        if !self.uploaded.is_empty() {
            html = html + "<div class=\"file-list\" style=\"margin-top: 16px;\">"
            for file in self.uploaded {
                html = html + "<div class=\"file-item\" style=\"padding: 8px; background: #F3F4F6; border-radius: 4px; margin: 8px 0;\">✓ " + file + "</div>"
            }
            html = html + "</div>"
        }

        html = html + "</div>"
        html
    }

    pub fn set_accept(mut self: Self, accept: String) -> Self {
        self.accept = accept
        self
    }

    pub fn set_multiple(mut self: Self, multiple: Bool) -> Self {
        self.multiple = multiple
        self
    }
}

pub struct Chip {
    label: String
    icon: String
    selectable: Bool
    selected: Bool
    deletable: Bool

    pub fn new(label: String) -> Self {
        Chip {
            label: label,
            icon: "",
            selectable: false,
            selected: false,
            deletable: false
        }
    }

    pub fn render(self: Self) -> String {
        let mut classes = "chip"
        if self.selected {
            classes = classes + " selected"
        }

        let mut html = "<div class=\"" + classes + "\">"

        if !self.icon.is_empty() {
            html = html + "<i class=\"chip-icon icon-" + self.icon + "\"></i>"
        }

        html = html + "<span>" + self.label + "</span>"

        if self.deletable {
            html = html + "<button class=\"chip-delete\">×</button>"
        }

        html = html + "</div>"
        html
    }

    pub fn set_selected(mut self: Self, selected: Bool) -> Self {
        self.selected = selected
        self
    }
}

pub struct Divider {
    text: String
    orientation: String

    pub fn new() -> Self {
        Divider {
            text: "",
            orientation: "horizontal"
        }
    }

    pub fn render(self: Self) -> String {
        if self.orientation == "vertical" {
            "<div style=\"border-left: 1px solid #E5E7EB; height: 24px; margin: 0 8px;\"></div>"
        } else {
            if !self.text.is_empty() {
                "<div style=\"display: flex; align-items: center; gap: 16px; margin: 16px 0;\"><div style=\"flex: 1; border-top: 1px solid #E5E7EB;\"></div><span style=\"color: #6B7280; font-size: 0.875rem;\">" + self.text + "</span><div style=\"flex: 1; border-top: 1px solid #E5E7EB;\"></div></div>"
            } else {
                "<div style=\"border-top: 1px solid #E5E7EB; margin: 16px 0;\"></div>"
            }
        }
    }
}

pub struct Link {
    href: String
    text: String
    external: Bool
    icon: String
    underline: Bool

    pub fn new(text: String, href: String) -> Self {
        Link {
            href: href,
            text: text,
            external: false,
            icon: "",
            underline: true
        }
    }

    pub fn render(self: Self) -> String {
        let mut html = "<a href=\"" + self.href + "\" style=\"color: #2563EB; text-decoration: " + if self.underline { "underline" } else { "none" } + "; cursor: pointer;\">"

        if !self.icon.is_empty() {
            html = html + "<i class=\"link-icon icon-" + self.icon + "\"></i> "
        }

        html = html + self.text

        if self.external {
            html = html + " ↗"
        }

        html = html + "</a>"
        html
    }

    pub fn set_external(mut self: Self, external: Bool) -> Self {
        self.external = external
        self
    }
}

pub struct List {
    items: Array[String]
    ordered: Bool
    size: String

    pub fn new() -> Self {
        List {
            items: Array::new(),
            ordered: false,
            size: "medium"
        }
    }

    pub fn render(self: Self) -> String {
        let tag = if self.ordered { "ol" } else { "ul" }

        let mut html = "<" + tag + ">"

        for item in self.items {
            html = html + "<li>" + item + "</li>"
        }

        html = html + "</" + tag + ">"
        html
    }

    pub fn add_item(mut self: Self, item: String) -> Self {
        self.items.push(item)
        self
    }
}

fn get_initials(name: String) -> String {
    if name.is_empty() {
        return "?"
    }

    let parts = name.split(" ")
    let mut initials = ""

    if parts.len() > 0 {
        initials = initials + parts[0].substring(0, 1).to_uppercase()
    }
    if parts.len() > 1 {
        initials = initials + parts[parts.len() - 1].substring(0, 1).to_uppercase()
    }

    initials
}
