// OMNISYSTEM GUI - BUTTON COMPONENTS (TIER 1)
// Foundation component library using Omni Assets
// Location: gui/foundation/components/buttons.titan
// 2026-06-15

pub enum ButtonVariant {
    Primary,
    Secondary,
    Tertiary,
    Ghost,
    Danger,
    Success,
    Warning,
    Info
}

pub enum ButtonSize {
    XSmall,
    Small,
    Medium,
    Large,
    XLarge
}

pub enum ButtonState {
    Default,
    Hover,
    Active,
    Disabled,
    Loading
}

pub struct ButtonConfig {
    label: String
    variant: ButtonVariant
    size: ButtonSize
    state: ButtonState
    icon: String
    iconPosition: String
    disabled: Bool
    loading: Bool
    fullWidth: Bool
    rounded: Bool
}

pub class ButtonComponent {
    config: ButtonConfig
    onClick: String
    onHover: String
    style: Object

    pub fn new(label: String, variant: ButtonVariant) -> Self {
        ButtonComponent {
            config: ButtonConfig {
                label: label,
                variant: variant,
                size: ButtonSize::Medium,
                state: ButtonState::Default,
                icon: "",
                iconPosition: "left",
                disabled: false,
                loading: false,
                fullWidth: false,
                rounded: false
            },
            onClick: "",
            onHover: "",
            style: Object::new()
        }
    }

    pub fn render(self: Self) -> String {
        let className = self.get_class_name()
        let innerHTML = self.get_inner_html()
        let attributes = self.get_attributes()

        "<button " + attributes + " class=\"" + className + "\">" + innerHTML + "</button>"
    }

    fn get_class_name(self: Self) -> String {
        let mut classes = Array::new()

        classes.push("btn")
        classes.push("btn-" + self.variant.to_string().to_lowercase())
        classes.push("btn-" + self.size.to_string().to_lowercase())
        classes.push("btn-" + self.state.to_string().to_lowercase())

        if self.config.disabled {
            classes.push("btn-disabled")
        }

        if self.config.loading {
            classes.push("btn-loading")
        }

        if self.config.fullWidth {
            classes.push("btn-full-width")
        }

        if self.config.rounded {
            classes.push("btn-rounded")
        }

        join_classes(classes)
    }

    fn get_inner_html(self: Self) -> String {
        let mut html = ""

        if self.config.loading {
            html = html + "<span class=\"spinner\"></span>"
        }

        if !self.config.icon.is_empty() && self.config.iconPosition == "left" {
            html = html + "<i class=\"icon icon-" + self.config.icon + "\"></i>"
        }

        html = html + "<span class=\"label\">" + self.config.label + "</span>"

        if !self.config.icon.is_empty() && self.config.iconPosition == "right" {
            html = html + "<i class=\"icon icon-" + self.config.icon + "\"></i>"
        }

        html
    }

    fn get_attributes(self: Self) -> String {
        let mut attrs = ""

        if self.config.disabled || self.config.loading {
            attrs = attrs + " disabled"
        }

        if !self.onClick.is_empty() {
            attrs = attrs + " onclick=\"" + self.onClick + "\""
        }

        if !self.onHover.is_empty() {
            attrs = attrs + " onhover=\"" + self.onHover + "\""
        }

        attrs
    }

    pub fn set_size(mut self: Self, size: ButtonSize) -> Self {
        self.config.size = size
        self
    }

    pub fn set_state(mut self: Self, state: ButtonState) -> Self {
        self.config.state = state
        self
    }

    pub fn set_icon(mut self: Self, icon: String, position: String) -> Self {
        self.config.icon = icon
        self.config.iconPosition = position
        self
    }

    pub fn set_disabled(mut self: Self, disabled: Bool) -> Self {
        self.config.disabled = disabled
        self
    }

    pub fn set_loading(mut self: Self, loading: Bool) -> Self {
        self.config.loading = loading
        self
    }

    pub fn set_full_width(mut self: Self, fullWidth: Bool) -> Self {
        self.config.fullWidth = fullWidth
        self
    }

    pub fn set_rounded(mut self: Self, rounded: Bool) -> Self {
        self.config.rounded = rounded
        self
    }

    pub fn on_click(mut self: Self, handler: String) -> Self {
        self.onClick = handler
        self
    }

    pub fn on_hover(mut self: Self, handler: String) -> Self {
        self.onHover = handler
        self
    }
}

// Component variations using factory methods
pub fn create_primary_button(label: String) -> ButtonComponent {
    ButtonComponent::new(label, ButtonVariant::Primary)
}

pub fn create_secondary_button(label: String) -> ButtonComponent {
    ButtonComponent::new(label, ButtonVariant::Secondary)
}

pub fn create_danger_button(label: String) -> ButtonComponent {
    ButtonComponent::new(label, ButtonVariant::Danger)
}

pub fn create_success_button(label: String) -> ButtonComponent {
    ButtonComponent::new(label, ButtonVariant::Success)
}

pub fn create_icon_button(icon: String) -> ButtonComponent {
    let mut btn = ButtonComponent::new("", ButtonVariant::Ghost)
    btn = btn.set_icon(icon, "center")
    btn = btn.set_size(ButtonSize::Small)
    btn
}

pub fn create_button_group(buttons: Array[ButtonComponent]) -> String {
    let mut html = "<div class=\"button-group\">"

    for button in buttons {
        html = html + button.render()
    }

    html = html + "</div>"
    html
}

fn join_classes(classes: Array[String]) -> String {
    let mut result = ""
    for i in 0..classes.len() {
        if i > 0 {
            result = result + " "
        }
        result = result + classes[i]
    }
    result
}

// Button group component
pub struct ButtonGroup {
    buttons: Array[ButtonComponent]
    orientation: String
    size: String
}

impl ButtonGroup {
    pub fn new() -> Self {
        ButtonGroup {
            buttons: Array::new(),
            orientation: "horizontal",
            size: "medium"
        }
    }

    pub fn add_button(mut self: Self, button: ButtonComponent) -> Self {
        self.buttons.push(button)
        self
    }

    pub fn set_orientation(mut self: Self, orientation: String) -> Self {
        self.orientation = orientation
        self
    }

    pub fn render(self: Self) -> String {
        let mut html = "<div class=\"button-group button-group-" + self.orientation + "\">"

        for button in self.buttons {
            html = html + button.render()
        }

        html = html + "</div>"
        html
    }
}

// Button loading animation
pub struct LoadingButton {
    button: ButtonComponent
    isLoading: Bool
}

impl LoadingButton {
    pub fn new(label: String) -> Self {
        LoadingButton {
            button: ButtonComponent::new(label, ButtonVariant::Primary),
            isLoading: false
        }
    }

    pub fn set_loading(mut self: Self, loading: Bool) -> Self {
        self.isLoading = loading
        self.button = self.button.set_loading(loading)
        self
    }

    pub fn render(self: Self) -> String {
        self.button.render()
    }
}
