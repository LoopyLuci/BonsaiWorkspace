// OMNISYSTEM GUI - NAVIGATION COMPONENTS (TIER 1)
// Navigation component system using Omni Assets
// Location: gui/foundation/components/navigation.titan
// 2026-06-15

pub struct NavItem {
    label: String
    icon: String
    href: String
    active: Bool
    disabled: Bool
    badge: String
}

pub struct NavigationBarConfig {
    orientation: String
    sticky: Bool
    transparent: Bool
    bordered: Bool
}

pub class NavigationBar {
    config: NavigationBarConfig
    items: Array[NavItem]
    logo: String
    brand: String

    pub fn new() -> Self {
        NavigationBar {
            config: NavigationBarConfig {
                orientation: "horizontal",
                sticky: false,
                transparent: false,
                bordered: true
            },
            items: Array::new(),
            logo: "",
            brand: ""
        }
    }

    pub fn render(self: Self) -> String {
        let mut html = "<nav class=\"navbar navbar-" + self.config.orientation + "\">"

        if !self.logo.is_empty() || !self.brand.is_empty() {
            html = html + "<div class=\"navbar-brand\">"
            if !self.logo.is_empty() {
                html = html + "<img src=\"" + self.logo + "\" alt=\"logo\" class=\"navbar-logo\">"
            }
            if !self.brand.is_empty() {
                html = html + "<span class=\"navbar-text\">" + self.brand + "</span>"
            }
            html = html + "</div>"
        }

        html = html + "<div class=\"navbar-items\">"

        for item in self.items {
            html = html + self.render_nav_item(item)
        }

        html = html + "</div>"
        html = html + "</nav>"
        html
    }

    fn render_nav_item(self: Self, item: NavItem) -> String {
        let mut classes = "nav-item"
        if item.active {
            classes = classes + " active"
        }
        if item.disabled {
            classes = classes + " disabled"
        }

        let mut html = "<a class=\"" + classes + "\" href=\"" + item.href + "\">"

        if !item.icon.is_empty() {
            html = html + "<i class=\"nav-icon icon-" + item.icon + "\"></i>"
        }

        html = html + "<span class=\"nav-label\">" + item.label + "</span>"

        if !item.badge.is_empty() {
            html = html + "<span class=\"nav-badge\">" + item.badge + "</span>"
        }

        html = html + "</a>"
        html
    }

    pub fn add_item(mut self: Self, item: NavItem) -> Self {
        self.items.push(item)
        self
    }

    pub fn set_brand(mut self: Self, brand: String) -> Self {
        self.brand = brand
        self
    }

    pub fn set_logo(mut self: Self, logo: String) -> Self {
        self.logo = logo
        self
    }

    pub fn set_sticky(mut self: Self, sticky: Bool) -> Self {
        self.config.sticky = sticky
        self
    }
}

// Tabs component
pub struct TabItem {
    label: String
    content: String
    icon: String
    active: Bool
}

pub struct TabsComponent {
    tabs: Array[TabItem]
    activeTab: Int
    variant: String

    pub fn new() -> Self {
        TabsComponent {
            tabs: Array::new(),
            activeTab: 0,
            variant: "default"
        }
    }

    pub fn render(self: Self) -> String {
        let mut html = "<div class=\"tabs tabs-" + self.variant + "\">"

        html = html + "<div class=\"tabs-header\">"
        for i in 0..self.tabs.len() {
            let tab = self.tabs[i]
            let mut classes = "tab-button"
            if i == self.activeTab {
                classes = classes + " active"
            }

            html = html + "<button class=\"" + classes + "\">"
            if !tab.icon.is_empty() {
                html = html + "<i class=\"tab-icon icon-" + tab.icon + "\"></i>"
            }
            html = html + tab.label + "</button>"
        }
        html = html + "</div>"

        html = html + "<div class=\"tabs-content\">"
        if self.activeTab < self.tabs.len() {
            html = html + "<div class=\"tab-panel\">" + self.tabs[self.activeTab].content + "</div>"
        }
        html = html + "</div>"

        html = html + "</div>"
        html
    }

    pub fn add_tab(mut self: Self, tab: TabItem) -> Self {
        self.tabs.push(tab)
        self
    }

    pub fn set_active_tab(mut self: Self, index: Int) -> Self {
        self.activeTab = index
        self
    }
}

// Breadcrumb navigation
pub struct BreadcrumbItem {
    label: String
    href: String
    active: Bool
}

pub struct BreadcrumbComponent {
    items: Array[BreadcrumbItem]
    separator: String

    pub fn new() -> Self {
        BreadcrumbComponent {
            items: Array::new(),
            separator: "/"
        }
    }

    pub fn render(self: Self) -> String {
        let mut html = "<nav class=\"breadcrumb\">"

        for i in 0..self.items.len() {
            let item = self.items[i]

            if item.active {
                html = html + "<span class=\"breadcrumb-item active\">" + item.label + "</span>"
            } else {
                html = html + "<a class=\"breadcrumb-item\" href=\"" + item.href + "\">" + item.label + "</a>"
            }

            if i < self.items.len() - 1 {
                html = html + "<span class=\"breadcrumb-separator\">" + self.separator + "</span>"
            }
        }

        html = html + "</nav>"
        html
    }

    pub fn add_item(mut self: Self, item: BreadcrumbItem) -> Self {
        self.items.push(item)
        self
    }
}

// Pagination component
pub struct PaginationComponent {
    currentPage: Int
    totalPages: Int
    onPageChange: String
    showFirstLast: Bool
    showPrevNext: Bool

    pub fn new(totalPages: Int) -> Self {
        PaginationComponent {
            currentPage: 1,
            totalPages: totalPages,
            onPageChange: "",
            showFirstLast: true,
            showPrevNext: true
        }
    }

    pub fn render(self: Self) -> String {
        let mut html = "<nav class=\"pagination\">"

        if self.showFirstLast && self.currentPage > 1 {
            html = html + "<button class=\"pagination-btn\">First</button>"
        }

        if self.showPrevNext && self.currentPage > 1 {
            html = html + "<button class=\"pagination-btn\">Prev</button>"
        }

        let startPage = if self.currentPage > 3 { self.currentPage - 2 } else { 1 }
        let endPage = if self.currentPage < self.totalPages - 2 { self.currentPage + 2 } else { self.totalPages }

        for i in startPage..endPage + 1 {
            let iStr = i.to_string()
            let mut classes = "pagination-btn"
            if i == self.currentPage {
                classes = classes + " active"
            }

            html = html + "<button class=\"" + classes + "\">" + iStr + "</button>"
        }

        if self.showPrevNext && self.currentPage < self.totalPages {
            html = html + "<button class=\"pagination-btn\">Next</button>"
        }

        if self.showFirstLast && self.currentPage < self.totalPages {
            html = html + "<button class=\"pagination-btn\">Last</button>"
        }

        html = html + "</nav>"
        html
    }

    pub fn set_current_page(mut self: Self, page: Int) -> Self {
        self.currentPage = page
        self
    }
}

// Stepper component
pub struct StepperItem {
    label: String
    description: String
    completed: Bool
    active: Bool
}

pub struct StepperComponent {
    steps: Array[StepperItem]
    currentStep: Int
    orientation: String

    pub fn new() -> Self {
        StepperComponent {
            steps: Array::new(),
            currentStep: 0,
            orientation: "horizontal"
        }
    }

    pub fn render(self: Self) -> String {
        let mut html = "<div class=\"stepper stepper-" + self.orientation + "\">"

        for i in 0..self.steps.len() {
            let step = self.steps[i]
            let mut classes = "stepper-item"
            if step.completed {
                classes = classes + " completed"
            }
            if step.active {
                classes = classes + " active"
            }

            html = html + "<div class=\"" + classes + "\">"
            html = html + "<div class=\"stepper-number\">" + (i + 1).to_string() + "</div>"
            html = html + "<div class=\"stepper-content\">"
            html = html + "<p class=\"stepper-label\">" + step.label + "</p>"
            if !step.description.is_empty() {
                html = html + "<p class=\"stepper-description\">" + step.description + "</p>"
            }
            html = html + "</div>"
            html = html + "</div>"
        }

        html = html + "</div>"
        html
    }

    pub fn add_step(mut self: Self, step: StepperItem) -> Self {
        self.steps.push(step)
        self
    }

    pub fn next_step(mut self: Self) -> Self {
        if self.currentStep < self.steps.len() - 1 {
            self.currentStep = self.currentStep + 1
        }
        self
    }

    pub fn prev_step(mut self: Self) -> Self {
        if self.currentStep > 0 {
            self.currentStep = self.currentStep - 1
        }
        self
    }
}
