    pub struct ExtensionModule {
        name: string,
        version: string,
        base_module: string,
        language: string,
        dependencies: vector<string>,
        exports: vector<string>,
        capabilities: vector<string>,
        status: ModuleStatus,
    }

    pub enum ModuleStatus {
        Active,
        Development,
        Experimental,
        Deprecated,
    }

