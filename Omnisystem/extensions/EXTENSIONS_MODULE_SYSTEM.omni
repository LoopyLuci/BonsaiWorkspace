    // ========================================================================
    // EXTENDED MODULE REGISTRY
    // ========================================================================

    pub struct ExtendedModuleRegistry {
        core_modules: vector<ExtensionModule>,
        extension_modules: vector<ExtensionModule>,
        total_capabilities: u32,
    }

    impl ExtendedModuleRegistry {
        pub fn new() -> Self {
            ExtendedModuleRegistry {
                core_modules: vector::new(),
                extension_modules: vector::new(),
                total_capabilities: 0,
            }
        }

        pub fn register_extension(&mut self, module: ExtensionModule) -> Result<(), string> {
            // Verify dependencies
            for dep in &module.dependencies {
                // Check if dependency exists in core or extensions
                let dep_found = self.core_modules.iter()
                    .any(|m| &m.name == dep)
                    || self.extension_modules.iter()
                    .any(|m| &m.name == dep);

                if !dep_found {
                    return Err(format!("Dependency {} not found", dep));
                }
            }

            // Update capability count
            self.total_capabilities += module.capabilities.len() as u32;

            self.extension_modules.push(module);
            Ok(())
        }

        pub fn get_all_modules(&self) -> vector<ExtensionModule> {
            let mut all = self.core_modules.clone();
            all.extend(self.extension_modules.clone());
            all
        }

        pub fn verify_integrity(&self) -> bool {
            let all_modules = self.get_all_modules();

            // Check all dependencies are satisfied
            for module in &all_modules {
                for dep in &module.dependencies {
                    let dep_found = all_modules.iter()
                        .any(|m| &m.name == dep);

                    if !dep_found {
                        println!("❌ Dependency {} not found for {}", dep, module.name);
                        return false;
                    }
                }
            }

            true
        }

        pub fn print_registry(&self) {
            println!("\n📦 EXTENDED MODULE REGISTRY\n");

            println!("Core Modules: {}", self.core_modules.len());
            for module in &self.core_modules {
                println!("  ✓ {} - {} capabilities", module.name, module.capabilities.len());
            }

            println!("\nExtension Modules: {}", self.extension_modules.len());
            for module in &self.extension_modules {
                println!("  ✓ {} - {} capabilities", module.name, module.capabilities.len());
            }

            println!("\nTotal Capabilities: {}", self.total_capabilities);
        }
    }

    // ========================================================================
    // MODULE COMPOSITION WITH EXTENSIONS
    // ========================================================================

    pub struct OmnisystemWithExtensions {
        core_registry: vector<ExtensionModule>,
        extension_registry: ExtendedModuleRegistry,
        active_modules: vector<string>,
    }

    impl OmnisystemWithExtensions {
        pub fn initialize() -> Result<Self, string> {
            let mut system = OmnisystemWithExtensions {
                core_registry: vector::new(),
                extension_registry: ExtendedModuleRegistry::new(),
                active_modules: vector::new(),
