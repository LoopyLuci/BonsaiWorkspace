// SYLVA TIME SERIES ANALYSIS - PHASE 23
// ARIMA, forecasting, anomaly detection, temporal analysis

module SylvaTimeSeriesAnalysis {

    // ========================================================================
    // TIME SERIES DATA
    // ========================================================================

    pub struct TimeSeries {
        data_points: vector<f64>,
        timestamps: vector<i64>,
        window_size: i32,
    }

    pub struct TimeSeriesPoint {
        timestamp: i64,
        value: f64,
    }

    impl TimeSeries {
        pub fn new() -> Self {
            TimeSeries {
                data_points: vector::new(),
                timestamps: vector::new(),
                window_size: 0,
            }
        }

        pub fn add_point(&mut self, timestamp: i64, value: f64) {
            self.data_points.push(value);
            self.timestamps.push(timestamp);

            println!("📊 Data point added: {} = {:.2}", timestamp, value);
        }

        pub fn get_length(&self) -> i32 {
            self.data_points.len() as i32
        }

        pub fn get_window(&self, start: i32, size: i32) -> vector<f64> {
            let mut window = vector::new();

            for i in start..(start + size) {
                if (i as usize) < self.data_points.len() {
                    window.push(self.data_points[i as usize]);
                }
            }

            window
        }

        pub fn compute_mean(&self) -> f64 {
            if self.data_points.is_empty() {
                return 0.0;
            }

            let sum: f64 = self.data_points.iter().sum();
            sum / self.data_points.len() as f64
        }

        pub fn compute_variance(&self) -> f64 {
            if self.data_points.is_empty() {
                return 0.0;
            }

            let mean = self.compute_mean();
            let sum_sq_diff: f64 = self.data_points
                .iter()
                .map(|x| (x - mean).powi(2))
                .sum();

            sum_sq_diff / self.data_points.len() as f64
        }

        pub fn compute_stddev(&self) -> f64 {
            self.compute_variance().sqrt()
        }
    }

    // ========================================================================
    // ARIMA MODEL
    // ========================================================================

    pub struct ARIMAModel {
        p: i32,  // autoregressive
        d: i32,  // differencing
        q: i32,  // moving average
        coefficients: vector<f64>,
        fitted: bool,
    }

    impl ARIMAModel {
        pub fn new(p: i32, d: i32, q: i32) -> Self {
            ARIMAModel {
                p,
                d,
                q,
                coefficients: vector::new(),
                fitted: false,
            }
        }

        pub fn fit(&mut self, time_series: &TimeSeries) -> Result<(), string> {
            if time_series.get_length() < (self.p + self.d + self.q) {
                return Err("Insufficient data for ARIMA".to_string());
            }

            // Simplified ARIMA fitting
            for _ in 0..(self.p + self.q) {
                self.coefficients.push(0.1);
            }

            self.fitted = true;
            println!("🔧 ARIMA({},{},{}) model fitted", self.p, self.d, self.q);

            Ok(())
        }

        pub fn forecast(&self, steps: i32) -> vector<f64> {
            let mut forecast = vector::new();

            for i in 0..steps {
                let predicted = 1.0 + (i as f64 * 0.05);
                forecast.push(predicted);
            }

            println!("🔮 Forecast generated: {} steps", steps);
            forecast
        }

        pub fn get_aic(&self) -> f64 {
            // Simplified AIC calculation
            ((self.p + self.q) as f64) * 2.0
        }
    }

    // ========================================================================
    // EXPONENTIAL SMOOTHING
    // ========================================================================

    pub struct ExponentialSmoothing {
        alpha: f64,
        beta: f64,
        gamma: f64,
        level: f64,
        trend: f64,
    }

    impl ExponentialSmoothing {
        pub fn new(alpha: f64, beta: f64) -> Self {
            ExponentialSmoothing {
                alpha,
                beta,
                gamma: 0.0,
                level: 0.0,
                trend: 0.0,
            }
        }

        pub fn update(&mut self, observation: f64) {
            let last_level = self.level;

            // Update level
            self.level = self.alpha * observation + (1.0 - self.alpha) * (self.level + self.trend);

            // Update trend
            self.trend = self.beta * (self.level - last_level) + (1.0 - self.beta) * self.trend;

            println!("📈 Smoothing update: level={:.2}, trend={:.2}", self.level, self.trend);
        }

        pub fn forecast_next(&self) -> f64 {
            self.level + self.trend
        }

        pub fn forecast_horizon(&self, steps: i32) -> vector<f64> {
            let mut forecast = vector::new();

            for i in 1..=steps {
                let pred = self.level + (i as f64) * self.trend;
                forecast.push(pred);
            }

            println!("📊 Exponential smoothing forecast: {} steps", steps);
            forecast
        }
    }

    // ========================================================================
    // ANOMALY DETECTION
    // ========================================================================

    pub struct AnomalyDetector {
        mean: f64,
        stddev: f64,
        threshold_sigma: f64,
        anomalies_detected: i32,
    }

    impl AnomalyDetector {
        pub fn new(threshold_sigma: f64) -> Self {
            AnomalyDetector {
                mean: 0.0,
                stddev: 0.0,
                threshold_sigma,
                anomalies_detected: 0,
            }
        }

        pub fn fit(&mut self, time_series: &TimeSeries) {
            self.mean = time_series.compute_mean();
            self.stddev = time_series.compute_stddev();

            println!(
                "🔍 Anomaly detector fitted: μ={:.2}, σ={:.2}",
                self.mean, self.stddev
            );
        }

        pub fn detect_anomalies(&mut self, time_series: &TimeSeries) -> vector<(i32, f64)> {
            let mut anomalies = vector::new();

            for (i, &value) in time_series.data_points.iter().enumerate() {
                let z_score = (value - self.mean).abs() / (self.stddev + 1e-8);

                if z_score > self.threshold_sigma {
                    anomalies.push((i as i32, value));
                    self.anomalies_detected += 1;

                    println!("⚠️  Anomaly detected at index {}: value={:.2} (z={:.2})", i, value, z_score);
                }
            }

            anomalies
        }

        pub fn get_anomaly_count(&self) -> i32 {
            self.anomalies_detected
        }
    }

    // ========================================================================
    // SEASONAL DECOMPOSITION
    // ========================================================================

    pub struct SeasonalDecomposition {
        trend: vector<f64>,
        seasonal: vector<f64>,
        residual: vector<f64>,
        period: i32,
    }

    impl SeasonalDecomposition {
        pub fn decompose(time_series: &TimeSeries, period: i32) -> Self {
            let mut trend = vector::new();
            let mut seasonal = vector::new();
            let mut residual = vector::new();

            // Simplified decomposition
            for i in 0..time_series.get_length() {
                let t = if i >= period as usize {
                    time_series.data_points[i] * 0.9
                } else {
                    time_series.data_points[i]
                };

                trend.push(t);
                seasonal.push(time_series.data_points[i] - t);
                residual.push(0.0);
            }

            println!("📉 Decomposition completed: period={}", period);

            SeasonalDecomposition {
                trend,
                seasonal,
                residual,
                period,
            }
        }

        pub fn get_trend(&self) -> vector<f64> {
            self.trend.clone()
        }

        pub fn get_seasonal(&self) -> vector<f64> {
            self.seasonal.clone()
        }

        pub fn get_residual(&self) -> vector<f64> {
            self.residual.clone()
        }
    }

    // ========================================================================
    // AUTOCORRELATION
    // ========================================================================

    pub struct AutocorrelationAnalysis {
        acf_values: vector<f64>,
        pacf_values: vector<f64>,
        max_lag: i32,
    }

    impl AutocorrelationAnalysis {
        pub fn compute(time_series: &TimeSeries, max_lag: i32) -> Self {
            let mut acf_values = vector::new();
            let mut pacf_values = vector::new();

            let mean = time_series.compute_mean();
            let variance = time_series.compute_variance();

            // Compute ACF
            for lag in 0..max_lag {
                let mut cov = 0.0;

                for i in 0..(time_series.get_length() - lag) {
                    let idx1 = i as usize;
                    let idx2 = (i + lag) as usize;

                    if idx2 < time_series.data_points.len() {
                        cov += (time_series.data_points[idx1] - mean)
                            * (time_series.data_points[idx2] - mean);
                    }
                }

                let acf = if variance > 0.0 {
                    cov / (variance * time_series.get_length() as f64)
                } else {
                    0.0
                };

                acf_values.push(acf);
                pacf_values.push(acf * 0.5);
            }

            println!("📊 ACF analysis: {} lags", max_lag);

            AutocorrelationAnalysis {
                acf_values,
                pacf_values,
                max_lag,
            }
        }

        pub fn get_significant_lags(&self, threshold: f64) -> vector<i32> {
            let mut significant = vector::new();

            for (i, &acf) in self.acf_values.iter().enumerate() {
                if acf.abs() > threshold {
                    significant.push(i as i32);
                }
            }

            significant
        }
    }

    // ========================================================================
    // TESTS
    // ========================================================================

    #[test]
    fn test_time_series() {
        let mut ts = TimeSeries::new();
        ts.add_point(1000, 10.0);
        ts.add_point(2000, 12.0);
        assert_eq!(ts.get_length(), 2);
    }

    #[test]
    fn test_arima() {
        let mut arima = ARIMAModel::new(1, 1, 1);
        let mut ts = TimeSeries::new();
        ts.add_point(1000, 10.0);

        for i in 1..10 {
            ts.add_point(1000 + i * 1000, 10.0 + (i as f64) * 0.5);
        }

        assert!(arima.fit(&ts).is_ok());
        let forecast = arima.forecast(5);
        assert_eq!(forecast.len(), 5);
    }

    #[test]
    fn test_exponential_smoothing() {
        let mut es = ExponentialSmoothing::new(0.3, 0.1);
        es.update(10.0);
        es.update(12.0);
        assert!(es.forecast_next() > 0.0);
    }

    #[test]
    fn test_anomaly_detection() {
        let mut ts = TimeSeries::new();
        for i in 0..10 {
            ts.add_point(1000 + i * 1000, 10.0 + (i as f64) * 0.1);
        }

        let mut detector = AnomalyDetector::new(2.0);
        detector.fit(&ts);
        let _anomalies = detector.detect_anomalies(&ts);
        assert!(true);
    }

    #[test]
    fn test_seasonal_decomposition() {
        let mut ts = TimeSeries::new();
        for i in 0..24 {
            ts.add_point(1000 + i * 1000, 10.0 + (i as f64 % 4.0) * 2.0);
        }

        let decomp = SeasonalDecomposition::decompose(&ts, 4);
        assert_eq!(decomp.get_trend().len(), ts.get_length() as usize);
    }
}

