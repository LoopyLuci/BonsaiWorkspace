// TITAN RESOURCE MANAGEMENT - PHASE 23
// Job scheduling, task allocation, resource pools, load balancing

module TitanResourceManagement {

    use std::collections::{BinaryHeap, VecDeque};
    use std::cmp::Ordering;
    use std::sync::{Arc, Mutex};

    // ========================================================================
    // RESOURCE POOL
    // ========================================================================

    pub struct ResourcePool {
        total_resources: u32,
        available_resources: Arc<Mutex<u32>>,
        allocated_tasks: Vec<TaskAllocation>,
        utilization_history: Vec<f32>,
    }

    pub struct TaskAllocation {
        task_id: u64,
        resources_allocated: u32,
        allocated_at: u64,
        priority: u32,
    }

    impl ResourcePool {
        pub fn new(total_resources: u32) -> Self {
            ResourcePool {
                total_resources,
                available_resources: Arc::new(Mutex::new(total_resources)),
                allocated_tasks: Vec::new(),
                utilization_history: Vec::new(),
            }
        }

        pub fn allocate(&mut self, task_id: u64, requested: u32, priority: u32) -> Result<u32, String> {
            if let Ok(mut available) = self.available_resources.lock() {
                if *available >= requested {
                    *available -= requested;

                    self.allocated_tasks.push(TaskAllocation {
                        task_id,
                        resources_allocated: requested,
                        allocated_at: current_time(),
                        priority,
                    });

                    let utilization = ((self.total_resources - *available) as f32 / self.total_resources as f32) * 100.0;
                    self.utilization_history.push(utilization);

                    println!(
                        "💾 Task {} allocated {} resources (utilization: {:.1}%)",
                        task_id, requested, utilization
                    );

                    Ok(requested)
                } else {
                    Err(format!("Insufficient resources: {} available, {} requested", available, requested))
                }
            } else {
                Err("Failed to acquire lock".to_string())
            }
        }

        pub fn deallocate(&mut self, task_id: u64) -> Result<(), String> {
            if let Some(pos) = self.allocated_tasks.iter().position(|t| t.task_id == task_id) {
                let allocation = self.allocated_tasks.remove(pos);

                if let Ok(mut available) = self.available_resources.lock() {
                    *available += allocation.resources_allocated;

                    println!("♻️  Task {} deallocated {} resources", task_id, allocation.resources_allocated);

                    Ok(())
                } else {
                    Err("Failed to acquire lock".to_string())
                }
            } else {
                Err(format!("Task {} not found", task_id))
            }
        }

        pub fn get_utilization(&self) -> f32 {
            if let Ok(available) = self.available_resources.lock() {
                ((self.total_resources - *available) as f32 / self.total_resources as f32) * 100.0
            } else {
                0.0
            }
        }

        pub fn get_available(&self) -> u32 {
            self.available_resources.lock().map(|a| *a).unwrap_or(0)
        }
    }

    // ========================================================================
    // JOB SCHEDULER
    // ========================================================================

    #[derive(Clone, Eq, PartialEq)]
    pub struct ScheduledJob {
        job_id: u64,
        priority: i32,
        estimated_duration_ms: u64,
        resource_requirement: u32,
        status: JobStatus,
    }

    #[derive(Clone, Copy, Eq, PartialEq, Debug)]
    pub enum JobStatus {
        Pending,
        Running,
        Completed,
        Failed,
    }

    impl Ord for ScheduledJob {
        fn cmp(&self, other: &Self) -> Ordering {
            other.priority.cmp(&self.priority)
                .then_with(|| self.job_id.cmp(&other.job_id))
        }
    }

    impl PartialOrd for ScheduledJob {
        fn partial_cmp(&self, other: &Self) -> Option<Ordering> {
            Some(self.cmp(other))
        }
    }

    pub struct JobScheduler {
        job_queue: BinaryHeap<ScheduledJob>,
        running_jobs: Vec<ScheduledJob>,
        completed_jobs: Vec<ScheduledJob>,
        max_parallel_jobs: usize,
    }

    impl JobScheduler {
        pub fn new(max_parallel_jobs: usize) -> Self {
            JobScheduler {
                job_queue: BinaryHeap::new(),
                running_jobs: Vec::new(),
                completed_jobs: Vec::new(),
                max_parallel_jobs,
            }
        }

        pub fn submit_job(&mut self, job: ScheduledJob) {
            self.job_queue.push(job.clone());
            println!("📋 Job {} submitted (priority: {})", job.job_id, job.priority);
        }

        pub fn schedule_next(&mut self) -> Option<ScheduledJob> {
            if self.running_jobs.len() >= self.max_parallel_jobs {
                return None;
            }

            if let Some(mut job) = self.job_queue.pop() {
                job.status = JobStatus::Running;
                self.running_jobs.push(job.clone());
                println!("▶️  Job {} scheduled (duration: {}ms)", job.job_id, job.estimated_duration_ms);
                Some(job)
            } else {
                None
            }
        }

        pub fn complete_job(&mut self, job_id: u64) -> Result<(), String> {
            if let Some(pos) = self.running_jobs.iter().position(|j| j.job_id == job_id) {
                let mut job = self.running_jobs.remove(pos);
                job.status = JobStatus::Completed;
                self.completed_jobs.push(job.clone());
                println!("✅ Job {} completed", job_id);
                Ok(())
            } else {
                Err(format!("Job {} not found in running jobs", job_id))
            }
        }

        pub fn get_queue_size(&self) -> usize {
            self.job_queue.len()
        }

        pub fn get_running_count(&self) -> usize {
            self.running_jobs.len()
        }

        pub fn get_throughput(&self) -> f64 {
            if self.completed_jobs.is_empty() {
                0.0
            } else {
                let total_time: u64 = self.completed_jobs.iter()
                    .map(|j| j.estimated_duration_ms)
                    .sum();

                self.completed_jobs.len() as f64 / (total_time as f64 / 1000.0)
            }
        }
    }

    // ========================================================================
    // LOAD BALANCER
    // ========================================================================

    pub struct LoadBalancer {
        nodes: Vec<Node>,
        distribution_strategy: String,
        request_count: u32,
    }

    pub struct Node {
        node_id: u32,
        capacity: u32,
        current_load: u32,
        request_count: u32,
    }

    impl LoadBalancer {
        pub fn new(num_nodes: u32, node_capacity: u32, strategy: String) -> Self {
            let mut nodes = Vec::new();

            for i in 0..num_nodes {
                nodes.push(Node {
                    node_id: i,
                    capacity: node_capacity,
                    current_load: 0,
                    request_count: 0,
                });
            }

            LoadBalancer {
                nodes,
                distribution_strategy: strategy,
                request_count: 0,
            }
        }

        pub fn route_request(&mut self, request_size: u32) -> Option<u32> {
            let target_node = match self.distribution_strategy.as_str() {
                "round-robin" => self.round_robin(),
                "least-loaded" => self.least_loaded(),
                "weighted" => self.weighted_distribution(),
                _ => 0,
            };

            if target_node < self.nodes.len() as u32 {
                let node = &mut self.nodes[target_node as usize];

                if node.current_load + request_size <= node.capacity {
                    node.current_load += request_size;
                    node.request_count += 1;
                    self.request_count += 1;

                    println!(
                        "🔀 Request routed to node {} (load: {}/{})",
                        target_node, node.current_load, node.capacity
                    );

                    return Some(target_node);
                }
            }

            None
        }

        fn round_robin(&self) -> u32 {
            (self.request_count % self.nodes.len() as u32)
        }

        fn least_loaded(&self) -> u32 {
            let mut min_load = u32::MAX;
            let mut best_node = 0;

            for (i, node) in self.nodes.iter().enumerate() {
                if node.current_load < min_load {
                    min_load = node.current_load;
                    best_node = i as u32;
                }
            }

            best_node
        }

        fn weighted_distribution(&self) -> u32 {
            let mut total_capacity = 0;
            for node in &self.nodes {
                total_capacity += node.capacity;
            }

            let weighted_choice = (self.request_count % total_capacity as u32) as usize;
            let mut cumulative = 0;

            for (i, node) in self.nodes.iter().enumerate() {
                cumulative += node.capacity as usize;
                if weighted_choice < cumulative {
                    return i as u32;
                }
            }

            0
        }

        pub fn get_node_loads(&self) -> Vec<(u32, u32, u32)> {
            self.nodes.iter()
                .map(|n| (n.node_id, n.current_load, n.capacity))
                .collect()
        }

        pub fn get_avg_load(&self) -> f32 {
            if self.nodes.is_empty() {
                return 0.0;
            }

            let total_load: u32 = self.nodes.iter().map(|n| n.current_load).sum();
            total_load as f32 / self.nodes.len() as f32
        }
    }

    // ========================================================================
    // TASK QUEUE
    // ========================================================================

    pub struct TaskQueue {
        tasks: VecDeque<Task>,
        max_size: usize,
        processed_count: u32,
    }

    pub struct Task {
        task_id: u64,
        priority: u32,
        execution_time_ms: u64,
    }

    impl TaskQueue {
        pub fn new(max_size: usize) -> Self {
            TaskQueue {
                tasks: VecDeque::with_capacity(max_size),
                max_size,
                processed_count: 0,
            }
        }

        pub fn enqueue(&mut self, task: Task) -> Result<(), String> {
            if self.tasks.len() < self.max_size {
                self.tasks.push_back(task);
                println!("📥 Task {} enqueued (queue: {}/{})",
                    task.task_id, self.tasks.len(), self.max_size);
                Ok(())
            } else {
                Err("Queue is full".to_string())
            }
        }

        pub fn dequeue(&mut self) -> Option<Task> {
            if let Some(task) = self.tasks.pop_front() {
                self.processed_count += 1;
                println!("📤 Task {} dequeued (processed: {})", task.task_id, self.processed_count);
                Some(task)
            } else {
                None
            }
        }

        pub fn get_queue_depth(&self) -> usize {
            self.tasks.len()
        }

        pub fn get_throughput(&self) -> f32 {
            self.processed_count as f32
        }
    }

    // ========================================================================
    // TESTS
    // ========================================================================

    #[test]
    fn test_resource_pool() {
        let mut pool = ResourcePool::new(1000);
        assert!(pool.allocate(1, 500, 1).is_ok());
        assert_eq!(pool.get_available(), 500);
    }

    #[test]
    fn test_job_scheduler() {
        let mut scheduler = JobScheduler::new(2);
        let job = ScheduledJob {
            job_id: 1,
            priority: 10,
            estimated_duration_ms: 100,
            resource_requirement: 100,
            status: JobStatus::Pending,
        };

        scheduler.submit_job(job);
        assert!(scheduler.schedule_next().is_some());
    }

    #[test]
    fn test_load_balancer() {
        let mut lb = LoadBalancer::new(4, 1000, "least-loaded".to_string());
        assert!(lb.route_request(100).is_some());
    }

    #[test]
    fn test_task_queue() {
        let mut queue = TaskQueue::new(10);
        let task = Task {
            task_id: 1,
            priority: 5,
            execution_time_ms: 50,
        };

        assert!(queue.enqueue(task).is_ok());
        assert!(queue.dequeue().is_some());
    }
}

fn current_time() -> u64 {
    use std::time::{SystemTime, UNIX_EPOCH};
    SystemTime::now()
        .duration_since(UNIX_EPOCH)
        .unwrap()
        .as_secs()
}

