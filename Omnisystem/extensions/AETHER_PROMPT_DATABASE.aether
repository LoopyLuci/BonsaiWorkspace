// AETHER PROMPT DATABASE - PHASE 20
// Distributed prompt storage, retrieval, replication, and consensus

module AetherPromptDatabase {

    // ========================================================================
    // DISTRIBUTED PROMPT STORE
    // ========================================================================

    pub struct PromptDatabase {
        node_id: string,
        prompts: map<string, PromptRecord>,
        prompt_index: map<string, vector<string>>,  // tag -> [prompt_ids]
        version_log: vector<VersionEntry>,
    }

    pub struct PromptRecord {
        id: string,
        title: string,
        content: string,
        created_by: string,
        created_at: i64,
        updated_at: i64,
        version: i32,
        tags: vector<string>,
        metadata: map<string, string>,
        usage_count: i64,
        effectiveness_score: f64,
    }

    pub struct VersionEntry {
        prompt_id: string,
        version: i32,
        changed_by: string,
        timestamp: i64,
        change_summary: string,
    }

    impl PromptDatabase {
        pub fn new(node_id: string) -> Self {
            PromptDatabase {
                node_id,
                prompts: map::new(),
                prompt_index: map::new(),
                version_log: vector::new(),
            }
        }

        // Store prompt with versioning
        pub fn store_prompt(
            &mut self,
            id: string,
            title: string,
            content: string,
            tags: vector<string>,
            created_by: string,
        ) -> Result<PromptRecord, string> {
            if self.prompts.contains_key(&id) {
                return Err(format!("Prompt {} already exists", id));
            }

            let now = current_time();
            let record = PromptRecord {
                id: id.clone(),
                title,
                content,
                created_by,
                created_at: now,
                updated_at: now,
                version: 1,
                tags: tags.clone(),
                metadata: map::new(),
                usage_count: 0,
                effectiveness_score: 0.0,
            };

            // Add to main store
            self.prompts.insert(id.clone(), record.clone());

            // Update index
            for tag in tags {
                self.prompt_index
                    .entry(tag)
                    .or_insert_with(vector::new)
                    .push(id.clone());
            }

            // Log version
            self.version_log.push(VersionEntry {
                prompt_id: id.clone(),
                version: 1,
                changed_by: "system".to_string(),
                timestamp: now,
                change_summary: "Created".to_string(),
            });

            println!("✅ Prompt stored: {} (v1)", id);
            Ok(record)
        }

        // Retrieve prompt by ID
        pub fn get_prompt(&self, id: &str) -> Option<PromptRecord> {
            self.prompts.get(&id.to_string()).cloned()
        }

        // Search by tags
        pub fn search_by_tags(&self, tags: &vector<string>) -> vector<PromptRecord> {
            let mut results = vector::new();

            for tag in tags {
                if let Some(ids) = self.prompt_index.get(tag) {
                    for id in ids {
                        if let Some(record) = self.prompts.get(id) {
                            results.push(record.clone());
                        }
                    }
                }
            }

            results
        }

        // Update prompt
        pub fn update_prompt(
            &mut self,
            id: string,
            new_content: string,
            updated_by: string,
        ) -> Result<PromptRecord, string> {
            if let Some(record) = self.prompts.get_mut(&id) {
                record.content = new_content;
                record.version += 1;
                record.updated_at = current_time();

                // Log version
                self.version_log.push(VersionEntry {
                    prompt_id: id.clone(),
                    version: record.version,
                    changed_by: updated_by,
                    timestamp: current_time(),
                    change_summary: "Updated".to_string(),
                });

                println!("✅ Prompt updated: {} (v{})", id, record.version);
                Ok(record.clone())
            } else {
                Err(format!("Prompt {} not found", id))
            }
        }

        // Record usage
        pub fn record_usage(&mut self, id: &str, effectiveness: f64) -> Result<(), string> {
            if let Some(record) = self.prompts.get_mut(&id.to_string()) {
                record.usage_count += 1;
                record.effectiveness_score = (record.effectiveness_score + effectiveness) / 2.0;
                Ok(())
            } else {
                Err(format!("Prompt {} not found", id))
            }
        }

        pub fn get_version_history(&self, id: &str) -> vector<VersionEntry> {
            self.version_log
                .iter()
                .filter(|e| &e.prompt_id == id)
                .cloned()
                .collect()
        }
    }

    // ========================================================================
    // DISTRIBUTED REPLICATION
    // ========================================================================

    pub struct PromptReplicator {
        primary_node_id: string,
        replica_nodes: vector<string>,
        replication_factor: i32,
    }

    impl PromptReplicator {
        pub fn new(primary_node_id: string, replication_factor: i32) -> Self {
            PromptReplicator {
                primary_node_id,
                replica_nodes: vector::new(),
                replication_factor,
            }
        }

        pub fn add_replica(&mut self, node_id: string) {
            if self.replica_nodes.len() < self.replication_factor as usize {
                self.replica_nodes.push(node_id.clone());
                println!("🔗 Replica added: {}", node_id);
            }
        }

        pub fn replicate_prompt(
            &self,
            prompt: &PromptRecord,
        ) -> Result<ReplicationResult, string> {
            let mut replicated_to = vector::new();

            for node_id in &self.replica_nodes {
                println!("📤 Replicating {} to {}", prompt.id, node_id);
                replicated_to.push(node_id.clone());
            }

            Ok(ReplicationResult {
                prompt_id: prompt.id.clone(),
                replicated_to,
                timestamp: current_time(),
                status: "success".to_string(),
            })
        }
    }

    pub struct ReplicationResult {
        prompt_id: string,
        replicated_to: vector<string>,
        timestamp: i64,
        status: string,
    }

    // ========================================================================
    // CONSENSUS-BASED PROMPT SELECTION
    // ========================================================================

    pub struct PromptConsensus {
        candidate_prompts: vector<CandidatePrompt>,
        quorum_size: i32,
    }

    pub struct CandidatePrompt {
        id: string,
        score: f64,
        votes: i32,
    }

    impl PromptConsensus {
        pub fn new(quorum_size: i32) -> Self {
            PromptConsensus {
                candidate_prompts: vector::new(),
                quorum_size,
            }
        }

        pub fn add_candidate(&mut self, id: string, score: f64) {
            self.candidate_prompts.push(CandidatePrompt {
                id,
                score,
                votes: 0,
            });
        }

        pub fn vote_for(&mut self, prompt_id: &str) -> Result<(), string> {
            if let Some(candidate) = self.candidate_prompts
                .iter_mut()
                .find(|c| &c.id == prompt_id)
            {
                candidate.votes += 1;
                Ok(())
            } else {
                Err(format!("Candidate {} not found", prompt_id))
            }
        }

        pub fn select_with_consensus(&self) -> Option<CandidatePrompt> {
            let best = self.candidate_prompts
                .iter()
                .max_by(|a, b| {
                    a.score.partial_cmp(&b.score)
                        .unwrap_or(std::cmp::Ordering::Equal)
                })?;

            if best.votes >= self.quorum_size {
                println!("✅ Prompt selected by consensus: {} ({} votes)", best.id, best.votes);
                Some(best.clone())
            } else {
                None
            }
        }
    }

    // ========================================================================
    // QUERY AND SEARCH
    // ========================================================================

    pub struct PromptQuery {
        tags: Option<vector<string>>,
        title_contains: Option<string>,
        min_effectiveness: Option<f64>,
        created_after: Option<i64>,
        limit: i32,
    }

    impl PromptQuery {
        pub fn new() -> Self {
            PromptQuery {
                tags: None,
                title_contains: None,
                min_effectiveness: None,
                created_after: None,
                limit: 100,
            }
        }

        pub fn with_tags(mut self, tags: vector<string>) -> Self {
            self.tags = Some(tags);
            self
        }

        pub fn with_title_contains(mut self, text: string) -> Self {
            self.title_contains = Some(text);
            self
        }

        pub fn with_min_effectiveness(mut self, score: f64) -> Self {
            self.min_effectiveness = Some(score);
            self
        }

        pub fn execute(&self, db: &PromptDatabase) -> vector<PromptRecord> {
            let mut results = vector::new();

            for (_, record) in &db.prompts {
                // Check tag filter
                if let Some(tags) = &self.tags {
                    let has_tag = tags.iter().any(|t| record.tags.contains(t));
                    if !has_tag {
                        continue;
                    }
                }

                // Check title filter
                if let Some(title_text) = &self.title_contains {
                    if !record.title.contains(title_text) {
                        continue;
                    }
                }

                // Check effectiveness filter
                if let Some(min_eff) = self.min_effectiveness {
                    if record.effectiveness_score < min_eff {
                        continue;
                    }
                }

                // Check created_after filter
                if let Some(after) = self.created_after {
                    if record.created_at < after {
                        continue;
                    }
                }

                results.push(record.clone());

                if results.len() >= self.limit as usize {
                    break;
                }
            }

            println!("🔍 Query found {} prompts", results.len());
            results
        }
    }

    // ========================================================================
    // TESTS
    // ========================================================================

    #[test]
    fn test_prompt_database() {
        let mut db = PromptDatabase::new("node1".to_string());
        let result = db.store_prompt(
            "p1".to_string(),
            "Test Prompt".to_string(),
            "Content".to_string(),
            vec!["test".to_string()],
            "user1".to_string(),
        );

        assert!(result.is_ok());
        assert!(db.get_prompt("p1").is_some());
    }

    #[test]
    fn test_prompt_replication() {
        let mut replicator = PromptReplicator::new("node1".to_string(), 2);
        replicator.add_replica("node2".to_string());
        replicator.add_replica("node3".to_string());

        assert_eq!(replicator.replica_nodes.len(), 2);
    }

    #[test]
    fn test_prompt_consensus() {
        let mut consensus = PromptConsensus::new(2);
        consensus.add_candidate("p1".to_string(), 0.9);
        consensus.add_candidate("p2".to_string(), 0.8);

        consensus.vote_for("p1").ok();
        consensus.vote_for("p1").ok();

        assert!(consensus.select_with_consensus().is_some());
    }

    #[test]
    fn test_prompt_query() {
        let db = PromptDatabase::new("node1".to_string());
        let query = PromptQuery::new()
            .with_min_effectiveness(0.5)
            .with_tags(vec!["test".to_string()]);

        let _results = query.execute(&db);
        assert!(true);
    }
}

fn current_time() -> i64 {
    use std::time::{SystemTime, UNIX_EPOCH};
    SystemTime::now()
        .duration_since(UNIX_EPOCH)
        .unwrap()
        .as_secs() as i64
}

