// @ expect-stdout: axiom BaseCase -> ASSUMED (true)
// @ expect-stdout: theorem CommuteAdd -> PROVEN (exhaustively verified over 100 cases)
// @ expect-stdout: theorem PositiveSquare -> PROVEN (exhaustively verified over 10 cases)
// @ expect-stdout: theorem AlwaysUnderThree -> DISPROVEN counterexample: x=3 (checked 5 cases)
// @ expect-stdout: theorem UsesAxiom -> PROVEN (exhaustively verified over 5 cases)
// @ expect-stdout: invariant CounterNonNegative -> VIOLATED at state[2]: count=-1 (checked 3 of 3 states)
// @ expect-exit: 1
theorem CommuteAdd forall x in 0..10, y in 0..10 {
  x + y == y + x
}

theorem PositiveSquare forall x in -5..5 {
  x * x >= 0
}

theorem AlwaysUnderThree forall x in 0..5 {
  x < 3
}

axiom BaseCase {
  0 + 0 == 0
}

theorem UsesAxiom forall x in 0..5 {
  BaseCase => x + 0 == x
}

invariant CounterNonNegative over states (
  { count: 0 },
  { count: 5 },
  { count: -1 }
) {
  count >= 0
}
