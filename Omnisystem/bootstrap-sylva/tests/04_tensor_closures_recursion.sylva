#@ expect-stdout: 4.0
#@ expect-stdout: 1.0
#@ expect-stdout: 10.0
#@ expect-stdout: 55
#@ expect-stdout: 1
#@ expect-stdout: 2
#@ expect-stdout: 3
def main():
    a = zeros([2, 2])
    b = ones([2, 2])
    c = a.add(b)
    print(c.sum())
    print(c.mean())

    d = tensor([1.0, 2.0, 3.0, 4.0])
    print(d.sum())

    def fib(n):
        if n <= 1:
            return n
        return fib(n - 1) + fib(n - 2)

    print(fib(10))

    def make_counter():
        count = [0]
        def inc():
            count[0] = count[0] + 1
            return count[0]
        return inc

    counter = make_counter()
    print(counter())
    print(counter())
    print(counter())

main()
