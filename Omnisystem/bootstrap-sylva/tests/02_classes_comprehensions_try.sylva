#@ expect-stdout: Generic makes a sound
#@ expect-stdout: Rex says Woof
#@ expect-stdout: [1, 4, 9, 16, 25]
#@ expect-stdout: even sum: 30
#@ expect-stdout: caught division error
class Animal:
    def __init__(self, name):
        self.name = name

    def speak(self):
        return f"{self.name} makes a sound"

class Dog(Animal):
    def speak(self):
        return f"{self.name} says Woof"

def main():
    animals = [Animal("Generic"), Dog("Rex")]
    for a in animals:
        print(a.speak())

    squares = [x * x for x in range(1, 6)]
    print(squares)

    total = sum([n for n in range(1, 11) if n % 2 == 0])
    print(f"even sum: {total}")

    try:
        result = 10 / 0
        print(result)
    except:
        print("caught division error")

main()
