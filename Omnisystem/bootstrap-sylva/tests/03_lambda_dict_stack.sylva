#@ expect-stdout: 7
#@ expect-stdout: {'apple': 5, 'banana': 6, 'cherry': 6}
#@ expect-stdout: a=1
#@ expect-stdout: b=2
#@ expect-stdout: hello world
#@ expect-stdout: ['Hello', 'World']
#@ expect-stdout: 3
#@ expect-stdout: 2
#@ expect-stdout: 1
def main():
    add = lambda a, b: a + b
    print(add(3, 4))

    words = ["apple", "banana", "cherry"]
    lengths = {w: len(w) for w in words}
    print(lengths)

    d = {"a": 1, "b": 2}
    for k, v in d.items():
        print(f"{k}={v}")

    s = "Hello World"
    print(s.lower())
    print(s.split(" "))

    class Stack:
        def __init__(self):
            self.items = []
        def push(self, x):
            self.items.append(x)
        def pop(self):
            return self.items.pop()
        def is_empty(self):
            return len(self.items) == 0

    st = Stack()
    st.push(1)
    st.push(2)
    st.push(3)
    while not st.is_empty():
        print(st.pop())

main()
