    fn render_preview_panel(&self) -> Widget {
        Panel {
            width: "300px".to_string(),
            padding: 16.0,
            background_color: self.theme.colors.surface,
            border_left: true,

            children: vec![
                Label {
                    text: "LIVE PREVIEW".to_string(),
                    font_size: 11.0,
                    font_weight: 700,
                    color: self.theme.colors.foreground_secondary,
                    margin_bottom: 12.0,
                },

                // Component previews
                Column {
                    spacing: 12.0,

                    children: vec![
                        // Button preview
                        Button {
                            label: "Primary Button".to_string(),
                            variant: "primary".to_string(),
                            width: "100%".to_string(),
                        },

                        Button {
                            label: "Secondary Button".to_string(),
                            variant: "secondary".to_string(),
                            width: "100%".to_string(),
                        },

                        // Text preview
                        Label {
                            text: "Heading Large".to_string(),
                            font_size: 18.0,
                            font_weight: 700,
                        },

                        Label {
                            text: "Body text preview with default font".to_string(),
                            font_size: 12.0,
                            color: self.theme.colors.foreground_secondary,
                        },

                        // Color swatches
                        Column {
                            spacing: 4.0,

                            children: vec![
                                self.render_color_swatch("Primary", 0xFF6200EE),
                                self.render_color_swatch("Secondary", 0xFF03DAC6),
                                self.render_color_swatch("Accent", 0xFF018786),
                                self.render_color_swatch("Error", 0xFFB00020),
                                self.render_color_swatch("Success", 0xFF00C853),
                            ],
                        },

                        Separator { margin: 12.0 },

                        Label {
                            text: "Theme Info".to_string(),
                            font_size: 11.0,
                            font_weight: 700,
                            margin_bottom: 8.0,
                        },

                        Column {
                            spacing: 4.0,

                            children: vec![
                                self.render_info_item("Name", "Light Modern"),
                                self.render_info_item("Type", "Built-in"),
                                self.render_info_item("Colors", "9"),
                                self.render_info_item("Font", "Inter"),
                            ],
                        },

                        Button {
                            label: "Apply Theme".to_string(),
                            variant: "primary".to_string(),
                            width: "100%".to_string(),
                            margin_top: 16.0,
                            onClick: || {},
                        },
                    ],
                },
            ],
        }
    }

    // Helper rendering methods
    fn render_nav_tab(&self, label: &str, view: ThemeView) -> Widget {
        Button {
            label: label.to_string(),
            variant: if std::mem::discriminant(&self.current_view) == std::mem::discriminant(&view) { "primary" } else { "secondary" },
            width: "100%".to_string(),
            margin_bottom: 4.0,
            onClick: || {},
        }
    }

    fn render_category_button(&self, label: &str, category: &str) -> Widget {
        Button {
            label: label.to_string(),
            variant: if self.selected_category == category { "primary" } else { "tertiary" },
            width: "100%".to_string(),
            margin_bottom: 2.0,
            onClick: || {},
        }
    }

    fn render_theme_card(&self, theme: &ThemeDefinition) -> Widget {
        Panel {
            padding: 16.0,
            background_color: self.theme.colors.surface,
            border: true,

            children: vec![
                Row {
                    spacing: 16.0,

                    children: vec![
                        // Color preview grid
                        Column {
                            spacing: 2.0,

                            children: vec![
                                Row {
                                    spacing: 2.0,
                                    children: vec![
                                        Panel { width: "24px".to_string(), height: "24px".to_string(), background_color: theme.primary_color, border: true },
                                        Panel { width: "24px".to_string(), height: "24px".to_string(), background_color: theme.secondary_color, border: true },
                                    ],
                                },
                                Row {
                                    spacing: 2.0,
                                    children: vec![
                                        Panel { width: "24px".to_string(), height: "24px".to_string(), background_color: theme.accent_color, border: true },
                                        Panel { width: "24px".to_string(), height: "24px".to_string(), background_color: theme.background_color, border: true },
                                    ],
                                },
                            ],
                        },

                        // Theme info
                        Column {
                            spacing: 4.0,
                            width: "1fr".to_string(),

                            children: vec![
                                Label {
                                    text: theme.name.clone(),
                                    font_size: 12.0,
                                    font_weight: 700,
                                },
                                Label {
                                    text: theme.description.clone(),
                                    font_size: 10.0,
                                    color: self.theme.colors.foreground_secondary,
                                },
                                Row {
                                    spacing: 8.0,
                                    children: theme.tags.iter().take(3).map(|tag| {
                                        Badge { label: tag.clone(), size: "small".to_string() }
                                    }).collect(),
                                },
                            ],
                        },

                        Spacer {},

                        // Actions
                        Column {
                            spacing: 4.0,

                            children: vec![
                                Button {
                                    label: "Use".to_string(),
                                    size: "small".to_string(),
                                    onClick: || {},
                                },
                                Button {
                                    label: "❤️".to_string(),
                                    size: "small".to_string(),
                                    onClick: || {},
                                },
                                Button {
                                    label: "⋯".to_string(),
                                    size: "small".to_string(),
                                    onClick: || {},
                                },
                            ],
                        },
                    ],
                },
            ],
        }
    }

    fn render_category_section(&self, title: &str, items: Vec<(&str, u32)>) -> Widget {
        Panel {
            padding: 16.0,
            background_color: self.theme.colors.surface,
            border: true,

            children: vec![
                Label {
                    text: title.to_string(),
                    font_size: 13.0,
                    font_weight: 700,
                    margin_bottom: 12.0,
                },

                Row {
                    spacing: 12.0,

                    children: items.iter().map(|(name, count)| {
                        Panel {
                            width: "1fr".to_string(),
                            padding: 12.0,
                            background_color: self.theme.colors.background,

                            children: vec![
                                Label {
                                    text: name.to_string(),
                                    font_size: 11.0,
                                    font_weight: 600,
                                },
                                Label {
                                    text: format!("{} themes", count),
                                    font_size: 10.0,
                                    color: self.theme.colors.foreground_secondary,
                                },
                            ],
                        }
                    }).collect(),
                },
            ],
        }
    }

    fn render_color_picker(&self, label: &str, _color_id: &str) -> Widget {
        Row {
            spacing: 12.0,

            children: vec![
                Label {
                    text: label.to_string(),
                    font_size: 11.0,
                    font_weight: 600,
                    width: "120px".to_string(),
                },
                Panel {
                    width: "40px".to_string(),
                    height: "40px".to_string(),
                    background_color: 0xFF6200EE,
                    border: true,
                },
                TextField {
                    value: "#6200EE".to_string(),
                    width: "100px".to_string(),
                },
                Button {
                    label: "Pick".to_string(),
                    size: "small".to_string(),
                    onClick: || {},
                },
            ],
        }
    }

    fn render_font_selector(&self) -> Widget {
        Row {
            spacing: 12.0,

            children: vec![
                Label { text: "Font Family".to_string(), font_size: 11.0, font_weight: 600, width: "120px".to_string() },
                Dropdown {
                    options: vec!["Inter", "Roboto", "Open Sans", "Poppins", "IBM Plex"],
                    selected: 0,
                },
            ],
        }
    }

    fn render_slider_input(&self, label: &str, value: i32, min: i32, max: i32) -> Widget {
        Row {
            spacing: 12.0,

            children: vec![
                Label { text: label.to_string(), font_size: 11.0, font_weight: 600, width: "120px".to_string() },
                Slider { value, min, max },
                Label { text: value.to_string(), font_size: 11.0, width: "40px".to_string() },
            ],
        }
    }

    fn render_generator_option(&self, title: &str, description: &str) -> Widget {
        Panel {
            padding: 12.0,
            background_color: self.theme.colors.background,
            border: true,
            margin_bottom: 8.0,

            children: vec![
                Label { text: title.to_string(), font_size: 11.0, font_weight: 700 },
                Label { text: description.to_string(), font_size: 10.0, color: self.theme.colors.foreground_secondary, margin_top: 4.0 },
            ],
        }
    }

    fn render_color_swatch(&self, label: &str, color: u32) -> Widget {
        Row {
            spacing: 8.0,

            children: vec![
                Panel { width: "20px".to_string(), height: "20px".to_string(), background_color: color, border: true },
                Label { text: label.to_string(), font_size: 10.0 },
            ],
        }
    }

    fn render_info_item(&self, label: &str, value: &str) -> Widget {
        Row {
            spacing: 8.0,

            children: vec![
                Label { text: format!("{}:", label), font_size: 10.0, font_weight: 600, width: "60px".to_string() },
                Label { text: value.to_string(), font_size: 10.0, color: self.theme.colors.foreground_secondary },
            ],
        }
    }

    // Data generation methods
    fn generate_built_in_themes() -> Vec<ThemeDefinition> {
        vec![
            ThemeDefinition {
                id: "light-modern".to_string(),
                name: "Light Modern".to_string(),
                description: "Clean, modern light theme".to_string(),
                category: "light".to_string(),
                creator: "System".to_string(),
                tags: vec!["light".to_string(), "modern".to_string(), "professional".to_string()],
                primary_color: 0xFF6200EE,
                secondary_color: 0xFF03DAC6,
                accent_color: 0xFF018786,
                background_color: 0xFFFFFFFF,
                rating: 4.8,
                downloads: 12450,
            },
            // Add more built-in themes...
        ]
    }

    fn load_community_themes() -> Vec<ThemeDefinition> {
        vec![
            ThemeDefinition {
                id: "dark-neon".to_string(),
                name: "Dark Neon".to_string(),
                description: "Cyberpunk-inspired neon theme".to_string(),
                category: "neon".to_string(),
                creator: "DesignJunkie92".to_string(),
                tags: vec!["dark".to_string(), "neon".to_string(), "cyberpunk".to_string()],
                primary_color: 0xFF00FF88,
                secondary_color: 0xFFFF00FF,
                accent_color: 0xFF00FFFF,
                background_color: 0xFF0A0E27,
                rating: 4.9,
                downloads: 8932,
            },
            // Add more community themes...
        ]
    }

    fn generate_procedural_themes() -> Vec<ProceduralTheme> {
        vec![
            ProceduralTheme {
                id: "harmony-mono".to_string(),
                name: "Monochromatic Harmony".to_string(),
                generator_type: "harmony".to_string(),
                base_color: 0xFF6200EE,
                variations: 5,
            },
            // Add more procedural themes...
        ]
    }

    fn get_filtered_themes(&self) -> Vec<&ThemeDefinition> {
        let mut themes: Vec<_> = self.built_in_themes
            .iter()
            .chain(self.user_themes.iter())
            .chain(self.community_themes.iter())
            .filter(|t| {
                (self.selected_category == "All" || t.category == self.selected_category)
                    && (self.search_query.is_empty() || t.name.to_lowercase().contains(&self.search_query.to_lowercase()))
            })
            .collect();

        themes.sort_by(|a, b| match self.sort_by {
            SortOption::Popular => b.downloads.cmp(&a.downloads),
            SortOption::Rated => b.rating.partial_cmp(&a.rating).unwrap(),
            SortOption::New => b.id.cmp(&a.id),
            SortOption::Name => a.name.cmp(&b.name),
        });

        themes
    }

    fn get_total_themes(&self) -> usize {
        self.built_in_themes.len() + self.user_themes.len() + self.community_themes.len() + self.procedural_themes.len()
    }
}

// ============================================================================
// DATA STRUCTURES
// ============================================================================

#[derive(Clone, Copy, Debug, PartialEq)]
pub enum ThemeView { Gallery, Categories, Editor, Generator, Community }

#[derive(Clone, Copy, Debug)]
pub enum PreviewMode { Desktop, Tablet, Mobile }

#[derive(Clone, Copy, Debug)]
pub enum SortOption { Popular, Rated, New, Name }

#[derive(Clone, Debug)]
pub struct ThemeDefinition {
    id: String,
    name: String,
    description: String,
    category: String,
    creator: String,
    tags: Vec<String>,
    primary_color: u32,
    secondary_color: u32,
    accent_color: u32,
    background_color: u32,
    rating: f32,
    downloads: u32,
}

#[derive(Clone, Debug)]
pub struct ProceduralTheme {
    id: String,
    name: String,
    generator_type: String,
    base_color: u32,
    variations: u32,
}

pub static THEME_SYSTEM_V2_STATE: LazyStatic<Mutex<AdvancedThemeSystem>> =
    LazyStatic::new(|| {
        Mutex::new(AdvancedThemeSystem::new(AssetManager::global()))
    });
