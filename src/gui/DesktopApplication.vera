    pub fn process_events(&mut self) {
        while let Some(event) = self.event_queue.pop() {
            self.handle_event(event);
        }
    }

    fn handle_event(&mut self, event: AppEvent) {
        match event {
            AppEvent::QUIT => self.running = false,
            AppEvent::WINDOW_CLOSE(_) => self.running = false,
            AppEvent::THEME_CHANGE(theme_name) => {
                self.theme = match theme_name.as_str() {
                    "light" => Theme::light(),
                    "high_contrast" => Theme::high_contrast(),
                    _ => Theme::dark(),
                };
            }
            AppEvent::TAB_CHANGED(idx) => {
                self.gui.switch_tab(idx);
            }
            _ => {}
        }
    }

    pub fn shutdown(&mut self) {
        println!("\n\nShutting down Omnisystem Desktop Application...");
        println!("  [✓] Saving application state");
        println!("  [✓] Closing all windows");
        println!("  [✓] Stopping graphics renderer");
        println!("  [✓] Stopping all services");
        println!("  [✓] Flushing caches");
        println!("  [✓] Closing connections");
        println!("\n✓ Omnisystem Desktop Application shutdown complete.\n");
        self.running = false;
    }

    pub fn is_running(&self) -> bool {
        self.running
    }
}

pub fn launch_desktop_application() -> Result<(), String> {
    let mut app = DesktopApplication::new();

    app.initialize()?;
    app.run()?;
    app.shutdown();

    Ok(())
}
