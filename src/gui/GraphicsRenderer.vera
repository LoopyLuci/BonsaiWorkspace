// GRAPHICS RENDERER
// 2D Graphics Rendering Engine for Desktop GUI
// VERA UI Language Implementation (Using HELIX for core rendering)

pub struct GraphicsContext {
    width: u32,
    height: u32,
    backbuffer: Vec<u32>,
    clear_color: Color,
}

pub struct Color {
    r: u8,
    g: u8,
    b: u8,
    a: u8,
}

pub struct Point {
    x: i32,
    y: i32,
}

pub struct Rect {
    x: i32,
    y: i32,
    width: u32,
    height: u32,
}

pub struct FontMetrics {
    char_width: u32,
    char_height: u32,
    line_height: u32,
}

pub enum PrimitiveShape {
    RECTANGLE,
    CIRCLE,
    TRIANGLE,
    POLYGON,
    LINE,
}

impl GraphicsContext {
    pub fn new(width: u32, height: u32) -> Self {
        GraphicsContext {
            width,
            height,
            backbuffer: vec![0; (width * height) as usize],
            clear_color: Color {
                r: 33,
                g: 33,
                b: 33,
                a: 255,
            },
        }
    }

    pub fn clear(&mut self) {
        let color = self.color_to_argb(self.clear_color);
        for pixel in &mut self.backbuffer {
            *pixel = color;
        }
    }

    pub fn set_clear_color(&mut self, color: Color) {
        self.clear_color = color;
    }

    pub fn draw_rectangle(&mut self, rect: Rect, color: Color) {
        let c = self.color_to_argb(color);
        for y in rect.y..(rect.y + rect.height as i32) {
            for x in rect.x..(rect.x + rect.width as i32) {
                self.set_pixel(x, y, c);
            }
        }
    }

    pub fn draw_filled_rectangle(&mut self, rect: Rect, color: Color, fill_color: Color) {
        // Draw border
        self.draw_rectangle(rect, color);

        // Draw fill
        let fill_c = self.color_to_argb(fill_color);
        for y in (rect.y + 1)..(rect.y + rect.height as i32 - 1) {
            for x in (rect.x + 1)..(rect.x + rect.width as i32 - 1) {
                self.set_pixel(x, y, fill_c);
            }
        }
    }

    pub fn draw_circle(&mut self, center: Point, radius: u32, color: Color) {
        let c = self.color_to_argb(color);
        let r = radius as i32;

        for y in -r..=r {
            for x in -r..=r {
                if x * x + y * y <= r * r {
                    self.set_pixel(center.x + x, center.y + y, c);
                }
            }
        }
    }

    pub fn draw_line(&mut self, from: Point, to: Point, color: Color) {
        let c = self.color_to_argb(color);

        let dx = (to.x - from.x).abs();
        let dy = (to.y - from.y).abs();
        let sx = if from.x < to.x { 1 } else { -1 };
        let sy = if from.y < to.y { 1 } else { -1 };

        let mut err = (dx - dy).abs();
        let mut x = from.x;
        let mut y = from.y;

        loop {
            self.set_pixel(x, y, c);

            if x == to.x && y == to.y {
                break;
            }

            let e2 = 2 * err;
            if e2 > -dy {
                err -= dy;
                x += sx;
            }
            if e2 < dx {
                err += dx;
                y += sy;
            }
        }
    }

    pub fn draw_text(
        &mut self,
        text: &str,
        x: u32,
        y: u32,
        color: Color,
        font_size: u16,
    ) {
        let c = self.color_to_argb(color);
        let char_width = (font_size / 2) as u32;
        let char_height = font_size as u32;

        for (i, _ch) in text.chars().enumerate() {
            // Simple character rendering (2x3 dot pattern for letters)
            let char_x = (x as i32) + (i as i32 * char_width as i32);
            let char_y = y as i32;

            for dy in 0..char_height {
                for dx in 0..char_width {
                    if (dy * char_width + dx) % 3 == 0 {
                        self.set_pixel(char_x + dx as i32, char_y + dy as i32, c);
                    }
                }
            }
        }
    }

    pub fn draw_gradient(&mut self, rect: Rect, color1: Color, color2: Color) {
        let c1 = self.color_to_argb(color1);
        let c2 = self.color_to_argb(color2);

        for y in rect.y..(rect.y + rect.height as i32) {
            let progress = ((y - rect.y) as f32) / (rect.height as f32);
            let r = (color1.r as f32 + (color2.r as f32 - color1.r as f32) * progress) as u8;
            let g = (color1.g as f32 + (color2.g as f32 - color1.g as f32) * progress) as u8;
            let b = (color1.b as f32 + (color2.b as f32 - color1.b as f32) * progress) as u8;
            let a = 255u8;

            let gradient_color = ((a as u32) << 24)
                | ((r as u32) << 16)
                | ((g as u32) << 8)
                | (b as u32);

            for x in rect.x..(rect.x + rect.width as i32) {
                self.set_pixel(x, y, gradient_color);
            }
        }
    }

    pub fn draw_shadow(&mut self, rect: Rect, shadow_color: Color, shadow_size: u32) {
        let shadow_c = self.color_to_argb(shadow_color);

        for offset in 0..shadow_size {
            let alpha_reduction = ((shadow_size - offset) as f32 / shadow_size as f32) as u8;
            let adjusted_color = Color {
                r: shadow_color.r,
                g: shadow_color.g,
                b: shadow_color.b,
                a: alpha_reduction,
            };

            let shadow_rect = Rect {
                x: rect.x + offset as i32,
                y: rect.y + offset as i32,
                width: rect.width,
                height: rect.height,
            };

            self.draw_rectangle(shadow_rect, adjusted_color);
        }
    }

    pub fn draw_button(
        &mut self,
        rect: Rect,
        label: &str,
        color: Color,
        text_color: Color,
        pressed: bool,
    ) {
        let adjusted_color = if pressed {
            Color {
                r: (color.r / 2) as u8,
                g: (color.g / 2) as u8,
                b: (color.b / 2) as u8,
                a: color.a,
            }
        } else {
            color
        };

        self.draw_filled_rectangle(rect, adjusted_color, adjusted_color);
        self.draw_text(
            label,
            rect.x as u32 + 5,
            rect.y as u32 + 5,
            text_color,
            12,
        );
    }

    pub fn draw_progress_bar(
        &mut self,
        rect: Rect,
        progress: f32,
        color: Color,
        background_color: Color,
    ) {
        // Draw background
        self.draw_filled_rectangle(rect, background_color, background_color);

        // Draw progress
        let progress_width = ((rect.width as f32) * progress) as u32;
        let progress_rect = Rect {
            x: rect.x,
            y: rect.y,
            width: progress_width,
            height: rect.height,
        };

        self.draw_filled_rectangle(progress_rect, color, color);
    }

    pub fn present(&self) {
        // Present backbuffer to screen (implementation depends on platform)
        // For now, we'll just indicate that rendering is complete
        println!("[Graphics] Frame rendered: {} x {} pixels", self.width, self.height);
    }

    fn set_pixel(&mut self, x: i32, y: i32, color: u32) {
        if x >= 0 && x < self.width as i32 && y >= 0 && y < self.height as i32 {
            let index = (y as u32 * self.width + x as u32) as usize;
            if index < self.backbuffer.len() {
                self.backbuffer[index] = color;
            }
        }
    }

    fn color_to_argb(&self, color: Color) -> u32 {
        ((color.a as u32) << 24)
            | ((color.r as u32) << 16)
            | ((color.g as u32) << 8)
            | (color.b as u32)
    }
}

pub struct Theme {
    pub primary: Color,
    pub secondary: Color,
    pub accent: Color,
    pub background: Color,
    pub text: Color,
    pub border: Color,
    pub shadow: Color,
}

impl Theme {
    pub fn light() -> Self {
        Theme {
            primary: Color {
                r: 41,
                g: 128,
                b: 185,
                a: 255,
            },
            secondary: Color {
                r: 52,
                g: 152,
                b: 219,
                a: 255,
            },
            accent: Color {
                r: 46,
                g: 204,
                b: 113,
                a: 255,
            },
            background: Color {
                r: 236,
                g: 240,
                b: 241,
                a: 255,
            },
            text: Color {
                r: 44,
                g: 62,
                b: 80,
                a: 255,
            },
            border: Color {
                r: 189,
                g: 195,
                b: 199,
                a: 255,
            },
            shadow: Color {
                r: 0,
                g: 0,
                b: 0,
                a: 100,
            },
        }
    }

    pub fn dark() -> Self {
        Theme {
            primary: Color {
                r: 52,
                g: 152,
                b: 219,
                a: 255,
            },
            secondary: Color {
                r: 41,
                g: 128,
                b: 185,
                a: 255,
            },
            accent: Color {
                r: 46,
                g: 204,
                b: 113,
                a: 255,
            },
            background: Color {
                r: 33,
                g: 33,
                b: 33,
                a: 255,
            },
            text: Color {
                r: 236,
                g: 240,
                b: 241,
                a: 255,
            },
            border: Color {
                r: 52,
                g: 52,
                b: 52,
                a: 255,
            },
            shadow: Color {
                r: 0,
                g: 0,
                b: 0,
                a: 200,
            },
        }
    }

    pub fn high_contrast() -> Self {
        Theme {
            primary: Color {
                r: 0,
                g: 0,
                b: 0,
                a: 255,
            },
            secondary: Color {
                r: 255,
                g: 255,
                b: 255,
                a: 255,
            },
            accent: Color {
                r: 255,
                g: 255,
                b: 0,
                a: 255,
            },
            background: Color {
                r: 255,
                g: 255,
                b: 255,
                a: 255,
            },
            text: Color {
                r: 0,
                g: 0,
                b: 0,
                a: 255,
            },
            border: Color {
                r: 0,
                g: 0,
                b: 0,
                a: 255,
            },
            shadow: Color {
                r: 0,
                g: 0,
                b: 0,
                a: 100,
            },
        }
    }
}
