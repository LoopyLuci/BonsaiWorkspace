    fn create_overview_panel(&self) -> OverviewPanel {
        OverviewPanel {
            status_cards: vec![],
            quick_actions: vec![],
            recent_activity: vec![],
        }
    }

    fn create_auth_panel(&self) -> AuthPanel {
        AuthPanel {
            active_sessions: vec![],
            mfa_devices: vec![],
            recovery_methods: vec![],
            trust_score: 100,
            last_login: 0,
        }
    }

