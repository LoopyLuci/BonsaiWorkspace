            },
            privacy_settings: PrivacySettings {
                telemetry_enabled: false,
                analytics_enabled: false,
                data_retention_days: 30,
                encryption_enabled: true,
            },
        }
    }

    pub fn switch_tab(&mut self, tab_index: usize) {
        if tab_index < self.tabs.len() {
            self.current_tab = tab_index;
        }
    }

    pub fn update_system_status(&mut self, cpu: f32, memory: f32, disk: f32, services: u32) {
        self.system_status.cpu_usage = cpu;
        self.system_status.memory_usage = memory;
        self.system_status.disk_usage = disk;
        self.system_status.running_services = services;
        self.system_status.health_score = 100 - ((cpu + memory + disk) / 3.0) as u8;
    }
}

pub fn launch_gui() {
    let mut gui = OmnisystemGUI::new();
    gui.update_system_status(35.2, 62.1, 62.0, 35);
    gui.run();
}
