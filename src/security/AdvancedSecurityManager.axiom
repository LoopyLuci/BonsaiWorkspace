// ADVANCED SECURITY MANAGER
// Threat Detection & Prevention
// AXIOM Verification Language Implementation

pub struct ThreatIndicator {
    pub indicator_type: String,
    pub severity: u8,
    pub description: String,
}

pub struct SecurityManager {
    threats: Vec<ThreatIndicator>,
}

impl SecurityManager {
    pub fn new() -> Self {
        SecurityManager { threats: Vec::new() }
    }

    pub fn detect_threat(&mut self, indicator: ThreatIndicator) -> Result<(), String> {
        self.threats.push(indicator);
        Ok(())
    }

    pub fn get_threat_level(&self) -> u8 {
        if self.threats.is_empty() {
            0
        } else {
            self.threats.iter().map(|t| t.severity).max().unwrap_or(0)
        }
    }

    pub fn is_threat_detected(&self) -> bool {
        !self.threats.is_empty()
    }
}
