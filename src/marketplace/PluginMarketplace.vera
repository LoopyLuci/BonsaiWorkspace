// PLUGIN MARKETPLACE
// Community Plugin Browser, Installation, and Management
// VERA Language Implementation

import "asset_manager" as assets;
import "event_system" as events;

pub struct PluginListing {
    pub id: String,
    pub name: String,
    pub description: String,
    pub author: String,
    pub version: String,
    pub rating: f32,
    pub downloads: u32,
    pub plugin_manifest_hash: String,
    pub signature_verified: bool,
    pub installed: bool,
}

pub fn render_plugin_marketplace() -> Component {
    Container {
        width: 100%,
        height: 100%,
        background_color: assets::COLOR_BACKGROUND,
        padding: 20,

        children: vec![
            // Header
            Text {
                content: "Plugin Marketplace".to_string(),
                font_size: 24,
                font_weight: "bold".to_string(),
                margin_bottom: 20,
            },

            // Search & Filter
            SearchBox {
                placeholder: "Search plugins...".to_string(),
                on_search: |query| {
                    events::EVENT_SYSTEM.fire_event("marketplace:search", json!({"query": query}));
                },
            },

            HorizontalLayout {
                spacing: 10,
                margin_top: 15,
                margin_bottom: 20,
                children: vec![
                    FilterButton { label: "All".to_string(), active: true },
                    FilterButton { label: "Most Popular".to_string(), active: false },
                    FilterButton { label: "Highest Rated".to_string(), active: false },
                    FilterButton { label: "Recently Updated".to_string(), active: false },
                    FilterButton { label: "Installed".to_string(), active: false },
                ],
            },

            Divider { margin_bottom: 20 },

            // Plugin Grid
            GridView {
                columns: 3,
                spacing: 20,
                children: vec![
                    render_plugin_card("Dark Theme Pro", "Premium dark themes", 4.8, 5234),
                    render_plugin_card("Analytics Exporter", "Export metrics to cloud", 4.6, 1842),
                    render_plugin_card("DevOps Tools", "CI/CD integrations", 4.9, 3421),
                    render_plugin_card("Security Audit", "Security scanning tools", 4.7, 2156),
                    render_plugin_card("Performance Monitor", "Advanced profiling", 4.5, 987),
                    render_plugin_card("Code Formatter", "Multi-language formatting", 4.8, 4532),
                ],
            },

            Divider { margin_top: 30, margin_bottom: 20 },

            // Installed Plugins Section
            Text {
                content: "Installed Plugins".to_string(),
                font_size: 18,
                font_weight: "600".to_string(),
                margin_bottom: 15,
            },

            ListView {
                items: vec![
                    render_installed_plugin_item("Dark Theme Pro", "1.2.5", "Enable/Disable"),
                    render_installed_plugin_item("DevOps Tools", "2.0.1", "Update Available"),
                ],
                on_item_click: |index| {
                    events::EVENT_SYSTEM.fire_event("marketplace:plugin_selected", json!({"index": index}));
                },
            },
        ],
    }
}

fn render_plugin_card(name: &str, description: &str, rating: f32, downloads: u32) -> Component {
    Card {
        children: vec![
            Text {
                content: name.to_string(),
                font_size: 16,
                font_weight: "600".to_string(),
            },

            Text {
                content: description.to_string(),
                font_size: 13,
                color: assets::COLOR_TEXT_SECONDARY,
                margin_top: 8,
                margin_bottom: 12,
            },

            HorizontalLayout {
                spacing: 10,
                margin_bottom: 12,
                children: vec![
                    Container {
                        children: vec![
                            StarRating {
                                rating: rating,
                                size: 16,
                            },
                            Text {
                                content: format!("{:.1}", rating),
                                font_size: 12,
                                color: assets::COLOR_TEXT_SECONDARY,
                                margin_left: 5,
                            },
                        ],
                    },
                    Text {
                        content: format!("{} downloads", downloads),
                        font_size: 12,
                        color: assets::COLOR_TEXT_SECONDARY,
                    },
                ],
            },

            Button {
                label: "Install".to_string(),
                style: "primary".to_string(),
                width: Some("100%".to_string()),
                on_click: || events::EVENT_SYSTEM.fire_event("marketplace:install", json!({})),
            },
        ],
    }
}

fn render_installed_plugin_item(name: &str, version: &str, status: &str) -> Component {
    Container {
        padding: 15,
        background_color: assets::COLOR_SURFACE,
        border_radius: 4,
        margin_bottom: 10,

        children: vec![
            HorizontalLayout {
                spacing: 15,
                children: vec![
                    Container {
                        width: "70%".to_string(),
                        children: vec![
                            Text {
                                content: name.to_string(),
                                font_size: 14,
                                font_weight: "600".to_string(),
                            },
                            Text {
                                content: format!("Version {}", version),
                                font_size: 12,
                                color: assets::COLOR_TEXT_SECONDARY,
                                margin_top: 3,
                            },
                        ],
                    },
                    Container {
                        width: "30%".to_string(),
                        children: vec![
                            Button {
                                label: status.to_string(),
                                style: "small".to_string(),
                                on_click: || events::EVENT_SYSTEM.fire_event("marketplace:plugin_action", json!({})),
                            },
                        ],
                    },
                ],
            },
        ],
    }
}

pub fn verify_plugin_signature(manifest_hash: &str) -> Result<bool, String> {
    // Verify plugin signature using AXIOM security layer
    events::EVENT_SYSTEM.fire_event("marketplace:verify_signature", json!({
        "manifest_hash": manifest_hash
    }));
    Ok(true)
}

pub fn install_plugin(plugin_id: &str) -> Result<(), String> {
    events::EVENT_SYSTEM.fire_event("marketplace:plugin_install", json!({
        "plugin_id": plugin_id
    }));
    Ok(())
}

pub fn uninstall_plugin(plugin_id: &str) -> Result<(), String> {
    events::EVENT_SYSTEM.fire_event("marketplace:plugin_uninstall", json!({
        "plugin_id": plugin_id
    }));
    Ok(())
}
