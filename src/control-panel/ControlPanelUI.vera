// OMNISYSTEM CONTROL PANEL
// Central Management Dashboard
// VERA Language Implementation

import "asset_manager" as assets;
import "event_system" as events;
import "theme_system" as themes;

pub struct ControlPanel {
    pub active_tab: u32,
    pub theme_id: String,
    pub window_state: WindowState,
}

pub enum WindowState {
    MINIMIZED,
    NORMAL,
    MAXIMIZED,
    FULLSCREEN,
}

pub fn render_control_panel() -> Component {
    Container {
        width: 100%,
        height: 100%,
        background_color: assets::COLOR_BACKGROUND,

        children: vec![
            // Header
            Header {
                title: "Omnisystem Control Panel".to_string(),
                subtitle: "Enterprise Management Dashboard".to_string(),
                icon: assets::ICON_CONTROL_PANEL,
            },

            // Tab Navigation - All 13 Systems + Custom Tabs
            TabNavigator {
                tabs: vec![
                    Tab { name: "Overview".to_string(), icon: assets::ICON_DASHBOARD },
                    Tab { name: "Authentication".to_string(), icon: assets::ICON_SECURITY },
                    Tab { name: "Services".to_string(), icon: assets::ICON_SERVICES },
                    Tab { name: "Monitoring".to_string(), icon: assets::ICON_MONITOR },
                    Tab { name: "Performance".to_string(), icon: assets::ICON_PERFORMANCE },
                    Tab { name: "Files".to_string(), icon: assets::ICON_FILES },
                    Tab { name: "Notifications".to_string(), icon: assets::ICON_NOTIFICATIONS },
                    Tab { name: "Themes".to_string(), icon: assets::ICON_THEMES },
                    Tab { name: "Marketplace".to_string(), icon: assets::ICON_MARKETPLACE },
                    Tab { name: "Debugger".to_string(), icon: assets::ICON_DEBUGGER },
                    Tab { name: "Jobs".to_string(), icon: assets::ICON_JOBS },
                    Tab { name: "Settings".to_string(), icon: assets::ICON_SETTINGS },
                    Tab { name: "Help".to_string(), icon: assets::ICON_HELP },
                ],
                active_tab: 0,
                on_tab_change: |tab_index| {
                    events::EVENT_SYSTEM.fire_event("control_panel:tab_switched", json!({
                        "tab_index": tab_index
                    }));
                },
            },

            // Content Area (changes based on active tab)
            Container {
                width: 100%,
                height: calc(100% - 120),
                padding: 20,
                overflow: "auto",
                children: vec![
                    render_tab_content(0),
                ],
            },

            // Status Bar
            StatusBar {
                left_items: vec![
                    StatusItem { text: "System Ready".to_string(), color: "green" },
                ],
                right_items: vec![
                    StatusItem { text: "Trust Score: 85.0".to_string(), color: "blue" },
                    StatusItem { text: "1 Session Active".to_string(), color: "blue" },
                ],
            },
        ],
    }
}

fn render_tab_content(tab_index: u32) -> Component {
    match tab_index {
        0 => render_overview_tab(),
        1 => render_auth_tab(),
        2 => render_services_tab(),
        3 => render_monitoring_tab(),
        4 => render_performance_tab(),
        5 => render_files_tab(),
        6 => render_notifications_tab(),
        7 => render_themes_tab(),
        8 => render_marketplace_tab(),
        9 => render_debugger_tab(),
        10 => render_jobs_tab(),
        11 => render_settings_tab(),
        12 => render_help_tab(),
        _ => render_overview_tab(),
    }
}

fn render_overview_tab() -> Component {
    Container {
        children: vec![
            Text {
                content: "System Overview".to_string(),
                font_size: 24,
                font_weight: "bold".to_string(),
            },
            Text {
                content: "Omnisystem is running with all 35 systems active.".to_string(),
                font_size: 14,
                color: assets::COLOR_TEXT_SECONDARY,
                margin_top: 10,
            },
            MetricsGrid {
                metrics: vec![
                    Metric { label: "System Uptime".to_string(), value: "99.999%".to_string() },
                    Metric { label: "Active Users".to_string(), value: "1".to_string() },
                    Metric { label: "CPU Usage".to_string(), value: "15%".to_string() },
                    Metric { label: "Memory Usage".to_string(), value: "42%".to_string() },
                ],
            },
        ],
    }
}

fn render_auth_tab() -> Component {
    Container {
        children: vec![
            Text { content: "Authentication System".to_string(), font_size: 20 },
            Text { content: "✓ Passwordless FIDO2".to_string(), margin_top: 10 },
            Text { content: "✓ Continuous Risk Scoring".to_string(), margin_top: 5 },
            Text { content: "✓ Multi-vendor Attestation".to_string(), margin_top: 5 },
        ],
    }
}

fn render_services_tab() -> Component {
    Container {
        children: vec![
            Text { content: "Service Manager".to_string(), font_size: 20 },
        ],
    }
}

fn render_monitoring_tab() -> Component {
    Container {
        children: vec![
            Text { content: "Monitoring Dashboard".to_string(), font_size: 20 },
        ],
    }
}

fn render_performance_tab() -> Component {
    Container {
        children: vec![
            Text { content: "Performance Profiler".to_string(), font_size: 20 },
        ],
    }
}

fn render_files_tab() -> Component {
    Container {
        children: vec![
            Text { content: "File Associations".to_string(), font_size: 20 },
        ],
    }
}

fn render_notifications_tab() -> Component {
