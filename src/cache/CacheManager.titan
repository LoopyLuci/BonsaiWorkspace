// CACHE MANAGER
// Distributed Caching with Eviction Policies
// TITAN Systems Language Implementation

use std::collections::HashMap;

pub struct CacheEntry<T> {
    pub value: T,
    pub ttl_ms: u64,
    pub created_at: u64,
}

pub struct CacheManager<T> {
    data: HashMap<String, CacheEntry<T>>,
    max_size: usize,
}

impl<T: Clone> CacheManager<T> {
    pub fn new(max_size: usize) -> Self {
        CacheManager {
            data: HashMap::new(),
            max_size,
        }
    }

    pub fn get(&self, key: &str) -> Option<T> {
        self.data.get(key).map(|entry| entry.value.clone())
    }

    pub fn set(&mut self, key: String, value: T, ttl_ms: u64) {
        if self.data.len() >= self.max_size {
            // Evict oldest entry
            if let Some(oldest) = self.data.iter().min_by_key(|(_, v)| v.created_at).map(|(k, _)| k.clone()) {
                self.data.remove(&oldest);
            }
        }

        self.data.insert(key, CacheEntry {
            value,
            ttl_ms,
            created_at: std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap_or_default().as_millis() as u64,
        });
    }

    pub fn clear(&mut self) {
        self.data.clear();
    }
}
