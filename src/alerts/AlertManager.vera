// ALERT MANAGER
// Multi-Channel Alert Distribution
// VERA Language Implementation

import "event_system" as events;

pub struct Alert {
    pub id: String,
    pub severity: AlertSeverity,
    pub title: String,
    pub message: String,
    pub channels: Vec<AlertChannel>,
}

pub enum AlertSeverity {
    INFO,
    WARNING,
    CRITICAL,
}

pub enum AlertChannel {
    EMAIL,
    SLACK,
    SMS,
    WEBHOOK,
}

pub fn send_alert(alert: Alert) -> Result<(), String> {
    for channel in alert.channels {
        match channel {
            AlertChannel::EMAIL => send_email_alert(&alert)?,
            AlertChannel::SLACK => send_slack_alert(&alert)?,
            AlertChannel::SMS => send_sms_alert(&alert)?,
            AlertChannel::WEBHOOK => send_webhook_alert(&alert)?,
        }
    }
    Ok(())
}

fn send_email_alert(alert: &Alert) -> Result<(), String> {
    events::EVENT_SYSTEM.fire_event("alert:email_sent", json!({"title": alert.title}));
    Ok(())
}

fn send_slack_alert(alert: &Alert) -> Result<(), String> {
    events::EVENT_SYSTEM.fire_event("alert:slack_sent", json!({"title": alert.title}));
    Ok(())
}

fn send_sms_alert(alert: &Alert) -> Result<(), String> {
    events::EVENT_SYSTEM.fire_event("alert:sms_sent", json!({"title": alert.title}));
    Ok(())
}

fn send_webhook_alert(alert: &Alert) -> Result<(), String> {
    events::EVENT_SYSTEM.fire_event("alert:webhook_sent", json!({"title": alert.title}));
    Ok(())
}
