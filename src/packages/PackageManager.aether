// PACKAGE MANAGER
// Application Package Management & Distribution
// AETHER Distributed Systems Language Implementation

use std::collections::HashMap;

pub struct Package {
    pub id: String,
    pub name: String,
    pub version: String,
    pub installed: bool,
}

pub struct PackageManager {
    packages: HashMap<String, Package>,
}

impl PackageManager {
    pub fn new() -> Self {
        PackageManager { packages: HashMap::new() }
    }

    pub fn install_package(&mut self, package: Package) -> Result<(), String> {
        self.packages.insert(package.id.clone(), package);
        Ok(())
    }

    pub fn remove_package(&mut self, package_id: &str) -> Result<(), String> {
        self.packages.remove(package_id);
        Ok(())
    }

    pub fn list_packages(&self) -> Vec<Package> {
        self.packages.values().cloned().collect()
    }

    pub fn get_package(&self, package_id: &str) -> Option<Package> {
        self.packages.get(package_id).cloned()
    }
}
