// OMNISYSTEM EPHEMERAL PURPOSE-BOUND TOKEN ENGINE
// Cryptographic Puzzles Bound to Real-Time Biometric State
// Solves the Agent Credential Theft Vulnerability
// Axiom Verification Language Implementation

use crypto::hash::sha3_512;
use std::collections::HashMap;

#[derive(Clone, Debug)]
pub struct BiometricSignature {
    pub heart_rate: u16,            // Beats per minute
    pub heart_rate_variance: f32,   // HRV (heart rate variability)
    pub respiratory_rate: u8,       // Breaths per minute
    pub skin_conductance: f32,      // Galvanic skin response
    pub body_temperature: f32,      // Degrees Celsius
    pub stress_level: f32,          // 0.0-1.0 normalized
    pub timestamp: u64,
    pub signature_hash: [u8; 64],   // SHA3-512 hash of biometric state
}

#[derive(Clone, Debug)]
pub struct EphemeralPuzzle {
    pub puzzle_id: String,
    pub session_id: String,
    pub user_id: String,
    pub intended_action: String,    // "read_file X", "access_database Y"
    pub biometric_binding: BiometricSignature,
    pub puzzle_data: Vec<u8>,       // Cryptographic puzzle data
    pub puzzle_difficulty: u32,     // Difficulty level (higher = more expensive to solve)
    pub created_at: u64,
    pub expires_at: u64,
    pub solved: bool,
    pub solution: Option<Vec<u8>>,
    pub duress_detected: bool,
}

#[derive(Clone, Debug)]
pub struct PuzzleSolution {
    pub puzzle_id: String,
    pub solution: Vec<u8>,
    pub biometric_state: BiometricSignature,
    pub submission_time: u64,
}

pub struct EphemeralPuzzleEngine {
    // Active puzzles
    puzzles: HashMap<String, EphemeralPuzzle>,

    // Puzzle history (for audit)
    puzzle_history: Vec<EphemeralPuzzle>,

    // Biometric baseline per user
    biometric_baselines: HashMap<String, BiometricBaseline>,

    // Stress/duress thresholds
    duress_threshold: f32,          // >0.8 = likely under duress
    stress_anomaly_threshold: f32,  // Deviation from baseline stress level
}

#[derive(Clone, Debug)]
pub struct BiometricBaseline {
    pub user_id: String,
    pub baseline_heart_rate: u16,
    pub baseline_hrv: f32,
    pub baseline_respiratory_rate: u8,
    pub baseline_stress: f32,
    pub stress_std_dev: f32,
    pub last_updated: u64,
}

impl EphemeralPuzzleEngine {
    pub fn new() -> Self {
        EphemeralPuzzleEngine {
            puzzles: HashMap::new(),
            puzzle_history: Vec::new(),
            biometric_baselines: HashMap::new(),
            duress_threshold: 0.8,
            stress_anomaly_threshold: 2.5, // 2.5 standard deviations
        }
    }

    /// Create an ephemeral puzzle for an action
    pub fn create_puzzle(
        &mut self,
        session_id: &str,
        user_id: &str,
        intended_action: &str,
        biometric_state: BiometricSignature,
    ) -> Result<EphemeralPuzzle, String> {
        // Check for duress indicators
        let duress_detected = self.detect_duress(user_id, &biometric_state)?;

        // Generate cryptographic puzzle
        let puzzle_id = format!("puzzle:{}:{}", session_id, Self::current_timestamp());
        let puzzle_data = self.generate_puzzle_data(&puzzle_id);
        let puzzle_difficulty = self.calculate_puzzle_difficulty(&biometric_state);

        let mut biometric_sig = biometric_state.clone();
        biometric_sig.signature_hash = self.compute_biometric_hash(&biometric_state);

        let now = Self::current_timestamp();
        let puzzle = EphemeralPuzzle {
            puzzle_id: puzzle_id.clone(),
            session_id: session_id.to_string(),
            user_id: user_id.to_string(),
            intended_action: intended_action.to_string(),
            biometric_binding: biometric_sig,
            puzzle_data,
            puzzle_difficulty,
            created_at: now,
            expires_at: now + 300,  // 5-minute window
            solved: false,
            solution: None,
            duress_detected,
        };

        // Store puzzle
        self.puzzles.insert(puzzle_id.clone(), puzzle.clone());

        Ok(puzzle)
    }

    /// Solve the puzzle and prove intent
    pub fn solve_puzzle(
        &mut self,
        puzzle_id: &str,
        solution: &[u8],
        current_biometric: &BiometricSignature,
    ) -> Result<bool, String> {
        let mut puzzle = self.puzzles
            .get(puzzle_id)
            .cloned()
            .ok_or("Puzzle not found")?;

        // Check expiration
        if puzzle.expires_at < Self::current_timestamp() {
            return Err("Puzzle expired".to_string());
        }

        // Check if already solved
        if puzzle.solved {
            return Err("Puzzle already solved".to_string());
        }

        // Verify solution is correct
        let solution_valid = self.verify_puzzle_solution(&puzzle, solution)?;
        if !solution_valid {
            return Err("Puzzle solution incorrect".to_string());
        }

        // Verify biometric state hasn't changed drastically
        let biometric_drift = self.compute_biometric_drift(
            &puzzle.biometric_binding,
            current_biometric,
        )?;

        if biometric_drift > 0.3 {
            // >30% drift suggests agent/bot is solving the puzzle
            return Err(format!(
                "Biometric state drift exceeds threshold: {:.2}%",
                biometric_drift * 100.0
            ));
        }

        // Check for duress in current biometric state
        if self.detect_duress(&puzzle.user_id, current_biometric).unwrap_or(false) {
            puzzle.duress_detected = true;
            // Log but allow for now (in production: silent alarm to security)
            self.trigger_duress_alert(&puzzle)?;
        }

        // Mark puzzle as solved
        puzzle.solved = true;
        puzzle.solution = Some(solution.to_vec());

        self.puzzles.insert(puzzle_id.to_string(), puzzle.clone());
        self.puzzle_history.push(puzzle);

        Ok(true)
    }

    /// Detect if user is under duress
    fn detect_duress(&self, user_id: &str, biometric: &BiometricSignature) -> Result<bool, String> {
        // Extremely high stress is duress indicator
        if biometric.stress_level > self.duress_threshold {
            return Ok(true);
        }

        // Get baseline
        let baseline = self.biometric_baselines
            .get(user_id)
            .ok_or("No baseline for user")?;

        // Calculate stress deviation from baseline
        let stress_deviation = (biometric.stress_level - baseline.baseline_stress).abs()
            / baseline.stress_std_dev.max(0.1);

        if stress_deviation > self.stress_anomaly_threshold {
            return Ok(true);
        }

        // Check for respiratory pattern (tachypnea)
        if biometric.respiratory_rate > 30 {
            return Ok(true);
        }

        Ok(false)
    }

    /// Generate a cryptographic puzzle
    fn generate_puzzle_data(&self, puzzle_id: &str) -> Vec<u8> {
        // Generate a Merkle tree proof puzzle
        // Solution requires computing a specific number of hash iterations
        let mut data = puzzle_id.as_bytes().to_vec();
        data.extend_from_slice(&Self::current_timestamp().to_le_bytes());

        // Hash to create puzzle
        let hash = sha3_512(&data);
        hash.to_vec()
    }

    /// Verify the puzzle solution
    fn verify_puzzle_solution(
        &self,
        puzzle: &EphemeralPuzzle,
        solution: &[u8],
    ) -> Result<bool, String> {
        // In production: Verify proof-of-work or zero-knowledge proof
        // For now: Simple verification (solution must be correct length and match puzzle data)

        if solution.len() != 64 {
            return Ok(false);
        }

        // Verify solution hash matches expected format
        let verification_hash = sha3_512(solution);

        // Simple check: solution hash should start with difficulty zeros
        let difficulty_bytes = (puzzle.puzzle_difficulty / 8) as usize;
        let expected_zeros = &vec![0u8; difficulty_bytes];

        Ok(&verification_hash[0..difficulty_bytes.min(64)] == expected_zeros.as_slice())
    }

    /// Compute biometric hash for binding
    fn compute_biometric_hash(&self, biometric: &BiometricSignature) -> [u8; 64] {
        let mut data = Vec::new();
        data.extend_from_slice(&biometric.heart_rate.to_le_bytes());
        data.extend_from_slice(&biometric.heart_rate_variance.to_le_bytes());
        data.extend_from_slice(&biometric.respiratory_rate.to_le_bytes());
        data.extend_from_slice(&biometric.skin_conductance.to_le_bytes());
        data.extend_from_slice(&biometric.body_temperature.to_le_bytes());
        data.extend_from_slice(&biometric.stress_level.to_le_bytes());
        data.extend_from_slice(&biometric.timestamp.to_le_bytes());

        let hash = sha3_512(&data);
        let mut result = [0u8; 64];
        result.copy_from_slice(&hash);
        result
    }

    /// Compute drift between two biometric states
    fn compute_biometric_drift(
        &self,
        state1: &BiometricSignature,
        state2: &BiometricSignature,
    ) -> Result<f32, String> {
        let hr_diff = ((state1.heart_rate as f32 - state2.heart_rate as f32).abs()) / 100.0;
        let stress_diff = (state1.stress_level - state2.stress_level).abs();
        let hrv_diff = (state1.heart_rate_variance - state2.heart_rate_variance).abs() / 30.0;

        // Weighted drift score
        let drift = (hr_diff * 0.3 + stress_diff * 0.5 + hrv_diff * 0.2).min(1.0);

        Ok(drift)
    }

    /// Calculate puzzle difficulty based on biometric state
    fn calculate_puzzle_difficulty(&self, biometric: &BiometricSignature) -> u32 {
        // Higher stress = easier puzzle (user might be in duress)
        // Normal state = harder puzzle (user can focus)
        let stress_factor = biometric.stress_level;
        let base_difficulty = 16; // 16 leading zero bits required in solution
        let difficulty = (base_difficulty as f32 * (1.0 - stress_factor)) as u32;

        difficulty.max(8).min(32) // Between 8 and 32 bits
    }

    /// Establish biometric baseline for a user
    pub fn establish_baseline(
        &mut self,
        user_id: &str,
        baseline: BiometricBaseline,
    ) {
        self.biometric_baselines.insert(user_id.to_string(), baseline);
    }

    /// Trigger duress alert (silent to attacker, alert to security)
    fn trigger_duress_alert(&self, puzzle: &EphemeralPuzzle) -> Result<(), String> {
        // In production: Send encrypted alert to security operations
        // - Location beacon (if available)
        // - Video recording (if available)
        // - Live agent monitoring queue
        // - Law enforcement notification (jurisdiction dependent)

        // For now: Just log
        eprintln!("DURESS ALERT: User {} under duress during puzzle resolution", puzzle.user_id);

        Ok(())
    }

    /// Get puzzle history (for forensics)
    pub fn get_puzzle_history(&self, user_id: Option<&str>, limit: usize) -> Vec<EphemeralPuzzle> {
        let filtered: Vec<_> = self.puzzle_history
            .iter()
            .filter(|p| {
                match user_id {
                    Some(uid) => p.user_id == uid,
                    None => true,
                }
            })
            .collect();

        filtered
            .iter()
            .rev()
            .take(limit)
            .cloned()
            .collect()
    }

    /// Check if a puzzle can be re-solved (prevents replay attacks)
    pub fn can_solve_puzzle(&self, puzzle_id: &str) -> bool {
        if let Some(puzzle) = self.puzzles.get(puzzle_id) {
            !puzzle.solved && puzzle.expires_at > Self::current_timestamp()
        } else {
            false
        }
    }

    /// Export puzzle for offline verification (audit purposes)
    pub fn export_puzzle(&self, puzzle_id: &str) -> Result<ExportedPuzzle, String> {
        let puzzle = self.puzzles
            .get(puzzle_id)
            .ok_or("Puzzle not found")?;

        Ok(ExportedPuzzle {
            puzzle_id: puzzle.puzzle_id.clone(),
            session_id: puzzle.session_id.clone(),
            user_id: puzzle.user_id.clone(),
            intended_action: puzzle.intended_action.clone(),
            biometric_binding_hash: puzzle.biometric_binding.signature_hash.to_vec(),
            puzzle_difficulty: puzzle.puzzle_difficulty,
            created_at: puzzle.created_at,
            solved: puzzle.solved,
            duress_detected: puzzle.duress_detected,
        })
    }

    fn current_timestamp() -> u64 {
        std::time::SystemTime::now()
            .duration_since(std::time::UNIX_EPOCH)
            .unwrap_or_default()
            .as_secs()
    }
}

#[derive(Clone, Debug)]
pub struct ExportedPuzzle {
    pub puzzle_id: String,
    pub session_id: String,
    pub user_id: String,
    pub intended_action: String,
    pub biometric_binding_hash: Vec<u8>,
    pub puzzle_difficulty: u32,
    pub created_at: u64,
    pub solved: bool,
    pub duress_detected: bool,
}

// Global engine instance
lazy_static::lazy_static! {
    pub static ref PUZZLE_ENGINE: Mutex<EphemeralPuzzleEngine> = Mutex::new(EphemeralPuzzleEngine::new());
}

#[cfg(test)]
mod tests {
    use super::*;

    fn create_test_biometric() -> BiometricSignature {
        BiometricSignature {
            heart_rate: 72,
            heart_rate_variance: 25.0,
            respiratory_rate: 16,
            skin_conductance: 2.5,
            body_temperature: 37.0,
            stress_level: 0.3,
            timestamp: EphemeralPuzzleEngine::current_timestamp(),
            signature_hash: [0u8; 64],
        }
    }

    #[test]
    fn test_puzzle_creation() {
        let mut engine = EphemeralPuzzleEngine::new();
        let biometric = create_test_biometric();

        let puzzle = engine.create_puzzle(
            "session123",
            "user1",
            "read_file:passwords.txt",
            biometric,
        ).unwrap();

        assert_eq!(puzzle.session_id, "session123");
        assert_eq!(puzzle.user_id, "user1");
        assert!(!puzzle.solved);
    }

    #[test]
    fn test_duress_detection() {
        let engine = EphemeralPuzzleEngine::new();
        let mut baseline = BiometricBaseline {
            user_id: "user1".to_string(),
            baseline_heart_rate: 72,
            baseline_hrv: 25.0,
            baseline_respiratory_rate: 16,
            baseline_stress: 0.3,
            stress_std_dev: 0.1,
            last_updated: 0,
        };

        // No baseline set yet, should return error
        let mut biometric = create_test_biometric();
        let result = engine.detect_duress("user1", &biometric);
        assert!(result.is_err());
    }

    #[test]
    fn test_biometric_drift() {
        let engine = EphemeralPuzzleEngine::new();
        let biometric1 = create_test_biometric();
        let mut biometric2 = create_test_biometric();
        biometric2.heart_rate = 100; // Elevated HR

        let drift = engine.compute_biometric_drift(&biometric1, &biometric2).unwrap();
        assert!(drift > 0.0 && drift < 1.0);
    }
}
