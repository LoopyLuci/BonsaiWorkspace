// OMNISYSTEM IMMUTABLE AUDIT LEDGER
// Certificate Transparency-style Merkle Tree for Authentication Events
// Axiom Verification Language Implementation

use std::collections::BTreeMap;
use crypto::hash::sha3_512;

pub struct MerkleTree {
    leaves: Vec<AuditEntry>,
    nodes: Vec<[u8; 64]>,  // SHA3-512 hashes (64 bytes each)
}

#[derive(Clone, Debug)]
pub struct AuditEntry {
    pub index: u64,
    pub timestamp: u64,
    pub action: String,
    pub entity_id: String,
    pub user_id: Option<String>,
    pub details: String,
    pub hash: [u8; 64],
}

pub struct ImmutableLedger {
    merkle_tree: MerkleTree,
    public_witnesses: Vec<WitnessServer>,
    differential_privacy_budget: DifferentialPrivacyBudget,
}

pub struct WitnessServer {
    pub id: String,
    pub public_key: Vec<u8>,
    pub last_verified_index: u64,
    pub last_verification_timestamp: u64,
}

pub struct DifferentialPrivacyBudget {
    pub total_epsilon: f32,        // Privacy budget (0-1)
    pub total_delta: f32,          // Failure probability
    pub consumed_epsilon: f32,
    pub queries_used: u32,
}

impl MerkleTree {
    pub fn new() -> Self {
        MerkleTree {
            leaves: Vec::new(),
            nodes: Vec::new(),
        }
    }

    /// Add a leaf to the Merkle tree
    pub fn append(&mut self, entry: &AuditEntry) {
        self.leaves.push(entry.clone());
        self.rebuild_tree();
    }

    /// Rebuild Merkle tree after modification
    fn rebuild_tree(&mut self) {
        self.nodes.clear();

        // Add leaf hashes
        for entry in &self.leaves {
            self.nodes.push(entry.hash);
        }

        // Build internal nodes (bottom-up)
        let mut current_level = self.leaves.len();
        while current_level > 1 {
            let mut next_level = (current_level + 1) / 2;
            for i in 0..current_level {
                if i % 2 == 0 && i + 1 < current_level {
                    // Combine two children
                    let left = self.nodes[i];
                    let right = self.nodes[i + 1];
                    let parent = self.hash_pair(&left, &right);
                    self.nodes.push(parent);
                } else if i % 2 == 0 && i == current_level - 1 {
                    // Odd leaf, promote to next level
                    self.nodes.push(self.nodes[i]);
                }
            }
            current_level = next_level;
        }
    }

    /// Get Merkle root (for external verification)
    pub fn root(&self) -> [u8; 64] {
        if self.nodes.is_empty() {
            [0u8; 64]
        } else {
            self.nodes[self.nodes.len() - 1]
        }
    }

    /// Generate Merkle proof for a leaf
    pub fn generate_proof(&self, leaf_index: usize) -> Option<Vec<[u8; 64]>> {
        if leaf_index >= self.leaves.len() {
            return None;
        }

        let mut proof = Vec::new();
        let mut index = leaf_index;
        let mut level_size = self.leaves.len();

        // Collect sibling hashes from leaf to root
        let mut current_nodes = self.nodes[0..self.leaves.len()].to_vec();

        while level_size > 1 {
            let sibling_index = if index % 2 == 0 {
                index + 1
            } else {
                index - 1
            };

            if sibling_index < current_nodes.len() {
                proof.push(current_nodes[sibling_index]);
            }

            index = index / 2;
            level_size = (level_size + 1) / 2;
        }

        Some(proof)
    }

    /// Verify a leaf hasn't been tampered with
    pub fn verify_proof(
        &self,
        leaf_index: usize,
        leaf_hash: [u8; 64],
        proof: &[[u8; 64]],
    ) -> bool {
        if leaf_index >= self.leaves.len() {
            return false;
        }

        let mut hash = leaf_hash;
        let mut index = leaf_index;

        for sibling_hash in proof {
            hash = if index % 2 == 0 {
                self.hash_pair(&hash, sibling_hash)
            } else {
                self.hash_pair(sibling_hash, &hash)
            };
            index = index / 2;
        }

        hash == self.root()
    }

    fn hash_pair(&self, left: &[u8; 64], right: &[u8; 64]) -> [u8; 64] {
        let mut combined = [0u8; 128];
        combined[0..64].copy_from_slice(left);
        combined[64..128].copy_from_slice(right);

        let hash = sha3_512(&combined);
        let mut result = [0u8; 64];
        result.copy_from_slice(&hash);
        result
    }
}

impl ImmutableLedger {
    pub fn new() -> Self {
        ImmutableLedger {
            merkle_tree: MerkleTree::new(),
            public_witnesses: Vec::new(),
            differential_privacy_budget: DifferentialPrivacyBudget {
                total_epsilon: 1.0,
                total_delta: 0.00001,
                consumed_epsilon: 0.0,
                queries_used: 0,
            },
        }
    }

    /// Log an authentication event to the immutable ledger
    pub fn log_event(&mut self, mut entry: AuditEntry) {
        let index = self.merkle_tree.leaves.len() as u64;
        entry.index = index;

        // Compute cryptographic hash of entry
        let entry_bytes = format!(
            "{}:{}:{}:{}:{}:{}",
            entry.timestamp,
            entry.action,
            entry.entity_id,
            entry.user_id.as_deref().unwrap_or(""),
            entry.details,
            index
        );

        let hash = sha3_512(entry_bytes.as_bytes());
        let mut entry_hash = [0u8; 64];
        entry_hash.copy_from_slice(&hash);
        entry.hash = entry_hash;

        // Append to Merkle tree
        self.merkle_tree.append(&entry);

        // Notify public witnesses
        self.notify_witnesses(index, entry.hash);
    }

    /// Get entry from ledger (with privacy considerations)
    pub fn get_entry(&self, index: u64) -> Option<AuditEntry> {
        if index < self.merkle_tree.leaves.len() as u64 {
            Some(self.merkle_tree.leaves[index as usize].clone())
        } else {
            None
        }
    }

    /// Get entries in range (with differential privacy)
    pub fn get_entries_range(
        &mut self,
        start_index: u64,
        end_index: u64,
    ) -> Result<Vec<AuditEntry>, String> {
        // Check differential privacy budget
        let queries_needed = 1.0 + ((end_index - start_index) as f32 * 0.001);
        if self.differential_privacy_budget.consumed_epsilon + queries_needed
            > self.differential_privacy_budget.total_epsilon
        {
            return Err("Differential privacy budget exceeded".to_string());
        }

        let mut entries = Vec::new();
        for i in start_index..=end_index {
            if let Some(entry) = self.get_entry(i) {
                entries.push(entry);
            }
        }

        // Consume privacy budget
        self.differential_privacy_budget.consumed_epsilon += queries_needed;
        self.differential_privacy_budget.queries_used += 1;

        Ok(entries)
    }

    /// Verify consistency of ledger (called by external monitors)
    pub fn verify_consistency(&self, old_root: [u8; 64], new_root: [u8; 64]) -> bool {
        // In production: Verify that new_root is consistent with old_root
        // and that no entries were modified (only appended)
        new_root != [0u8; 64] && old_root != new_root
    }

    /// Register a public witness server
    pub fn register_witness(&mut self, witness: WitnessServer) {
        self.public_witnesses.push(witness);
    }

    /// Notify public witnesses of new entries
    fn notify_witnesses(&self, index: u64, leaf_hash: [u8; 64]) {
        for witness in &self.public_witnesses {
            // In production: Send signed notification to witness
            // witness.notify(index, leaf_hash, self.merkle_tree.root());
        }
    }

    /// Generate a privacy-preserving audit report
    /// Uses differential privacy to ensure individual entries cannot be re-identified
    pub fn generate_privacy_preserving_report(
        &mut self,
        query_type: &str,
    ) -> Result<AuditReport, String> {
        // Check privacy budget
        let query_cost = 0.1; // Epsilon cost for aggregate query
        if self.differential_privacy_budget.consumed_epsilon + query_cost
            > self.differential_privacy_budget.total_epsilon
        {
            return Err("Privacy budget exhausted".to_string());
        }

        let report = match query_type {
            "failed_auths" => self.report_failed_authentications(),
            "risk_escalations" => self.report_risk_escalations(),
            "credential_issuances" => self.report_credential_issuances(),
            _ => return Err("Unknown report type".to_string()),
        };

        self.differential_privacy_budget.consumed_epsilon += query_cost;
        self.differential_privacy_budget.queries_used += 1;

        Ok(report)
    }

    fn report_failed_authentications(&self) -> AuditReport {
        let failed_count = self.merkle_tree
            .leaves
            .iter()
            .filter(|e| e.action.contains("AUTH_FAILURE"))
            .count();

        // Add Laplace noise for differential privacy
        let noise = self.add_laplace_noise(0.5, 1.0);
        let noisy_count = (failed_count as f32 + noise).max(0.0) as u32;

        AuditReport {
            report_type: "Failed Authentications".to_string(),
            metric_name: "failed_auth_count".to_string(),
            metric_value: noisy_count.to_string(),
            time_period: "24h".to_string(),
            privacy_level: "DP(ε=0.1, δ=0.00001)".to_string(),
        }
    }

    fn report_risk_escalations(&self) -> AuditReport {
        let escalation_count = self.merkle_tree
            .leaves
            .iter()
            .filter(|e| e.action.contains("RISK_ESCALATION"))
            .count();

        let noise = self.add_laplace_noise(0.5, 1.0);
        let noisy_count = (escalation_count as f32 + noise).max(0.0) as u32;

        AuditReport {
            report_type: "Risk Escalations".to_string(),
            metric_name: "escalation_count".to_string(),
            metric_value: noisy_count.to_string(),
            time_period: "24h".to_string(),
            privacy_level: "DP(ε=0.1, δ=0.00001)".to_string(),
        }
    }

    fn report_credential_issuances(&self) -> AuditReport {
        let issuance_count = self.merkle_tree
            .leaves
            .iter()
            .filter(|e| e.action.contains("CREDENTIAL_ISSUED"))
            .count();

        let noise = self.add_laplace_noise(0.5, 1.0);
        let noisy_count = (issuance_count as f32 + noise).max(0.0) as u32;

        AuditReport {
            report_type: "Credential Issuances".to_string(),
            metric_name: "issuance_count".to_string(),
            metric_value: noisy_count.to_string(),
            time_period: "24h".to_string(),
            privacy_level: "DP(ε=0.1, δ=0.00001)".to_string(),
        }
    }

    /// Add Laplace noise for differential privacy
    fn add_laplace_noise(&self, scale: f32, sensitivity: f32) -> f32 {
        // Generate random number (in production, use cryptographically secure RNG)
        let u: f32 = 0.5; // Placeholder
        if u < 0.5 {
            -(scale * sensitivity * (1.0 - u).ln())
        } else {
            scale * sensitivity * (1.0 - u).ln()
        }
    }

    /// Get current Merkle root (published publicly for verification)
    pub fn get_current_root(&self) -> [u8; 64] {
        self.merkle_tree.root()
    }

    /// Get entry count
    pub fn entry_count(&self) -> u64 {
        self.merkle_tree.leaves.len() as u64
    }
}

#[derive(Clone, Debug)]
pub struct AuditReport {
    pub report_type: String,
    pub metric_name: String,
    pub metric_value: String,
    pub time_period: String,
    pub privacy_level: String,
}

// Global immutable ledger instance
lazy_static::lazy_static! {
    pub static ref AUDIT_LEDGER: Mutex<ImmutableLedger> = Mutex::new(ImmutableLedger::new());
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_merkle_tree_append() {
        let mut tree = MerkleTree::new();

        let entry = AuditEntry {
            index: 0,
            timestamp: 1234567890,
            action: "TEST_ACTION".to_string(),
            entity_id: "test_entity".to_string(),
            user_id: Some("test_user".to_string()),
            details: "Test entry".to_string(),
            hash: [0u8; 64],
        };

        tree.append(&entry);
        assert_eq!(tree.leaves.len(), 1);
    }

    #[test]
    fn test_merkle_proof() {
        let mut tree = MerkleTree::new();

        let entry1 = AuditEntry {
            index: 0,
            timestamp: 1234567890,
            action: "ACTION1".to_string(),
            entity_id: "entity1".to_string(),
            user_id: Some("user1".to_string()),
            details: "Entry 1".to_string(),
            hash: [0u8; 64],
        };

        let entry2 = AuditEntry {
            index: 1,
            timestamp: 1234567891,
            action: "ACTION2".to_string(),
            entity_id: "entity2".to_string(),
            user_id: Some("user2".to_string()),
            details: "Entry 2".to_string(),
            hash: [1u8; 64],
        };

        tree.append(&entry1);
        tree.append(&entry2);

        let proof = tree.generate_proof(0).unwrap();
        assert!(proof.len() > 0);
    }

    #[test]
    fn test_audit_ledger_logging() {
        let mut ledger = ImmutableLedger::new();

        let entry = AuditEntry {
            index: 0,
            timestamp: 1234567890,
            action: "AUTH_SUCCESS".to_string(),
            entity_id: "session123".to_string(),
            user_id: Some("user1".to_string()),
            details: "Authentication successful".to_string(),
            hash: [0u8; 64],
        };

        ledger.log_event(entry);
        assert_eq!(ledger.entry_count(), 1);
    }
}
