// OMNISYSTEM AUTHENTICATION MANAGER
// Central Orchestration for All Authentication Systems
// Integrates CAL, Risk Engine, DID/VC, and UI Components
// VERA Language Implementation

import "event_system" as events;
import "auth/CryptoAgilityLayer" as cal;
import "auth/RiskEngine" as risk;
import "auth/DecentralizedIdentity" as did;
import "asset_manager" as assets;

lazy_static::lazy_static! {
    pub static ref AUTH_MANAGER: Mutex<AuthenticationManager> = Mutex::new(AuthenticationManager::new());
}

pub struct AuthenticationManager {
    pub crypto_agility_layer: CryptoAgilityLayer,
    pub risk_engine: RiskEngine,
    pub did_manager: DecentralizedIdentityManager,
    pub active_sessions: HashMap<String, SessionContext>,
    pub auth_history: Vec<AuthenticationEvent>,
    pub mfa_challenges: HashMap<String, MFAChallenge>,
}

#[derive(Clone, Debug)]
pub struct SessionContext {
    pub session_id: String,
    pub user_id: String,
    pub user_did: String,
    pub device_id: String,
    pub device_did: String,
    pub created_at: u64,
    pub last_activity: u64,
    pub trust_score: f32,
    pub access_level: AccessLevel,
    pub encrypted: bool,
    pub crypto_algorithm: String,
    pub biometric_validated: bool,
}

#[derive(Clone, Copy, Debug, PartialEq)]
pub enum AccessLevel {
    NONE,
    USER,
    POWER_USER,
    ADMIN,
    ROOT,
}

#[derive(Clone, Debug)]
pub struct AuthenticationEvent {
    pub timestamp: u64,
    pub event_type: AuthEventType,
    pub user_id: Option<String>,
    pub session_id: Option<String>,
    pub details: String,
    pub result: AuthResult,
}

#[derive(Clone, Copy, Debug, PartialEq)]
pub enum AuthEventType {
    PASSKEY_AUTH_INITIATED,
    PASSKEY_AUTH_SUCCESS,
    PASSKEY_AUTH_FAILURE,
    BIOMETRIC_AUTH_INITIATED,
    BIOMETRIC_AUTH_SUCCESS,
    BIOMETRIC_AUTH_FAILURE,
    MFA_CHALLENGE_ISSUED,
    MFA_VERIFIED,
    SESSION_CREATED,
    SESSION_EXTENDED,
    SESSION_TERMINATED,
    RISK_ESCALATION,
    CREDENTIAL_ISSUED,
    CREDENTIAL_REVOKED,
}

#[derive(Clone, Copy, Debug, PartialEq)]
pub enum AuthResult {
    SUCCESS,
    FAILURE,
    CHALLENGE_REQUIRED,
    DENIED,
}

#[derive(Clone, Debug)]
pub struct MFAChallenge {
    pub challenge_id: String,
    pub user_id: String,
    pub challenge_type: MFAChallengeType,
    pub challenge_data: Vec<u8>,
    pub created_at: u64,
    pub expires_at: u64,
    pub verified: bool,
}

#[derive(Clone, Copy, Debug)]
pub enum MFAChallengeType {
    BIOMETRIC,
    SECURITY_KEY,
    OTP,
    STEP_UP,
}

impl AuthenticationManager {
    pub fn new() -> Self {
        AuthenticationManager {
            crypto_agility_layer: cal::CryptoAgilityLayer::new(),
            risk_engine: risk::RiskEngine::new(),
            did_manager: did::DecentralizedIdentityManager::new(),
            active_sessions: HashMap::new(),
            auth_history: Vec::new(),
            mfa_challenges: HashMap::new(),
        }
    }

    /// PHASE 1: Authenticate user with passkeys
    pub fn authenticate_with_passkey(
        &mut self,
        username: &str,
        credential_id: &[u8],
        client_signature: &[u8],
    ) -> Result<SessionContext, String> {
        self.log_auth_event(
            AuthEventType::PASSKEY_AUTH_INITIATED,
            Some(username.to_string()),
            format!("Passkey authentication attempt"),
            AuthResult::CHALLENGE_REQUIRED,
        );

        // Verify credential signature using Crypto Agility Layer
        let message = format!("{}:{}", username, chrono::Utc::now().timestamp());
        let signature_valid = self.crypto_agility_layer
            .verify(message.as_bytes(), client_signature)
            .unwrap_or(false);

        if !signature_valid {
            self.log_auth_event(
                AuthEventType::PASSKEY_AUTH_FAILURE,
                Some(username.to_string()),
                "Signature verification failed".to_string(),
                AuthResult::FAILURE,
            );
            return Err("Passkey signature invalid".to_string());
        }

        // Verify credential hasn't been revoked
        // In production: lookup credential ID in revocation list

        // Create user DID if doesn't exist
        let user_did = format!("did:web:omnisystem/{}", username);

        // Create session
        let session = self.create_session(username, &user_did)?;

        self.log_auth_event(
            AuthEventType::PASSKEY_AUTH_SUCCESS,
            Some(username.to_string()),
            format!("Passkey authentication successful, session {}", session.session_id),
            AuthResult::SUCCESS,
        );

        events::EVENT_SYSTEM.fire_event("auth:passkey_success", json!({
            "user": username,
            "session_id": session.session_id
        }));

        Ok(session)
    }

    /// PHASE 2: Continuous risk evaluation during session
    pub fn evaluate_session_risk(
        &mut self,
        session_id: &str,
        behavioral_signal: &BehavioralSignal,
        contextual_signal: &ContextualSignal,
    ) -> Result<RiskEvaluation, String> {
        let mut session = self.active_sessions
            .get(session_id)
            .cloned()
            .ok_or("Session not found")?;

        // Compute continuous trust score
        let trust_score = self.risk_engine.evaluate_trust(
            &session.user_id,
            behavioral_signal,
            contextual_signal,
        );

        let evaluation = RiskEvaluation {
            session_id: session_id.to_string(),
            trust_score: trust_score.clone(),
            action: self.determine_risk_action(&trust_score),
            anomaly_flags: trust_score.anomaly_flags.clone(),
        };

        // Update session trust score
        session.trust_score = trust_score.score;
        session.last_activity = Self::current_timestamp();
        self.active_sessions.insert(session_id.to_string(), session);

        // If risk escalated, trigger event
        if evaluation.action == RiskAction::DENY_ACCESS {
            self.log_auth_event(
                AuthEventType::RISK_ESCALATION,
                Some(evaluation.session_id.clone()),
                format!("Risk score dropped to {:.1}, access denied", trust_score.score),
                AuthResult::DENIED,
            );

            events::EVENT_SYSTEM.fire_event("auth:risk_escalation", json!({
                "session_id": session_id,
                "trust_score": trust_score.score,
                "anomalies": trust_score.anomaly_flags
            }));

            // Terminate session
            self.terminate_session(session_id)?;
        } else if evaluation.action == RiskAction::REQUEST_STEP_UP {
            self.issue_mfa_challenge(session_id, MFAChallengeType::STEP_UP)?;
        }

        Ok(evaluation)
    }

    /// PHASE 3: Issue MFA Challenge (Step-Up Authentication)
    pub fn issue_mfa_challenge(
        &mut self,
        session_id: &str,
        challenge_type: MFAChallengeType,
    ) -> Result<String, String> {
        let session = self.active_sessions
            .get(session_id)
            .ok_or("Session not found")?;

        let challenge_id = format!("mfa:{}:{}", session_id, Self::current_timestamp());
        let now = Self::current_timestamp();

        let challenge = MFAChallenge {
            challenge_id: challenge_id.clone(),
            user_id: session.user_id.clone(),
            challenge_type,
            challenge_data: vec![0u8; 32], // Random nonce
            created_at: now,
            expires_at: now + 300, // 5-minute expiration
            verified: false,
        };

        self.mfa_challenges.insert(challenge_id.clone(), challenge);

        self.log_auth_event(
            AuthEventType::MFA_CHALLENGE_ISSUED,
            Some(session.user_id.clone()),
            format!("MFA challenge issued: {:?}", challenge_type),
            AuthResult::CHALLENGE_REQUIRED,
        );

        events::EVENT_SYSTEM.fire_event("auth:mfa_challenge_issued", json!({
            "challenge_id": challenge_id,
            "challenge_type": format!("{:?}", challenge_type),
            "expires_in_seconds": 300
        }));

        Ok(challenge_id)
    }

    /// PHASE 4: Verify MFA Response
    pub fn verify_mfa_challenge(
        &mut self,
        challenge_id: &str,
        response: &[u8],
    ) -> Result<(), String> {
        let mut challenge = self.mfa_challenges
            .get(challenge_id)
            .cloned()
            .ok_or("Challenge not found")?;

        // Check expiration
        if challenge.expires_at < Self::current_timestamp() {
            return Err("MFA challenge expired".to_string());
        }

        // Verify response (challenge-dependent)
        let valid = match challenge.challenge_type {
            MFAChallengeType::BIOMETRIC => self.verify_biometric_response(response),
            MFAChallengeType::SECURITY_KEY => {
                self.crypto_agility_layer
                    .verify(&challenge.challenge_data, response)
                    .unwrap_or(false)
            },
            MFAChallengeType::OTP => Self::verify_otp_response(response),
            MFAChallengeType::STEP_UP => self.verify_step_up_response(response),
        };

        if !valid {
            self.log_auth_event(
                AuthEventType::MFA_CHALLENGE_ISSUED,
                Some(challenge.user_id.clone()),
                "MFA verification failed".to_string(),
                AuthResult::FAILURE,
            );
            return Err("MFA verification failed".to_string());
        }

        challenge.verified = true;
        self.mfa_challenges.insert(challenge_id.to_string(), challenge.clone());

        self.log_auth_event(
            AuthEventType::MFA_VERIFIED,
            Some(challenge.user_id.clone()),
            "MFA challenge verified".to_string(),
            AuthResult::SUCCESS,
        );

        // Find session by user ID and update trust
        for session in self.active_sessions.values_mut() {
            if session.user_id == challenge.user_id {
                session.biometric_validated = true;
                session.trust_score = 95.0; // Elevated trust after MFA
                session.last_activity = Self::current_timestamp();
            }
        }

        Ok(())
    }

    /// PHASE 5: Issue Verifiable Credentials (e.g., after enrollment)
    pub fn issue_employee_credential(
        &mut self,
        user_id: &str,
        employee_data: EmployeeCredentialData,
    ) -> Result<VerifiableCredential, String> {
        // Get HR system's issuer DID
        let hr_issuer_did = "did:web:omnisystem/hr-system";

        // Ensure issuer is registered
        self.did_manager.register_issuer(hr_issuer_did)?;

        // Create user DID
        let user_did = format!("did:web:omnisystem/{}", user_id);

        // Prepare claims
        let mut claims = HashMap::new();
        claims.insert("employee_id".to_string(), employee_data.employee_id);
        claims.insert("department".to_string(), employee_data.department);
        claims.insert("role".to_string(), employee_data.role);
        claims.insert("clearance_level".to_string(), employee_data.clearance_level);
        claims.insert("status".to_string(), "active".to_string());

        // Issue credential
        let vc = self.did_manager.issue_credential(
            hr_issuer_did,
            &user_did,
            vec!["Employee".to_string(), "Role".to_string()],
            claims,
            365,
        )?;

        self.log_auth_event(
            AuthEventType::CREDENTIAL_ISSUED,
            Some(user_id.to_string()),
            format!("Employee credential issued"),
            AuthResult::SUCCESS,
        );

        events::EVENT_SYSTEM.fire_event("auth:credential_issued", json!({
            "user_id": user_id,
            "credential_type": "Employee",
            "credential_id": vc.id
        }));

        Ok(vc)
    }

    /// Get authentication history for audit purposes
    pub fn get_auth_history(&self, user_id: Option<&str>, limit: usize) -> Vec<AuthenticationEvent> {
        let filtered: Vec<_> = self.auth_history
            .iter()
            .filter(|e| {
                match user_id {
                    Some(uid) => e.user_id.as_ref() == Some(&uid.to_string()),
                    None => true,
                }
            })
            .collect();

        filtered
            .iter()
            .rev()
            .take(limit)
            .cloned()
            .collect()
    }

    /// Integrate with Control Panel
    pub fn render_auth_dashboard_tab() -> Component {
        let manager = AUTH_MANAGER.lock().unwrap();

        Container {
            width: 100%,
            padding: 20,
            children: vec![
                Text {
                    content: "Authentication & Trust Management".to_string(),
                    font_size: 24,
                    font_weight: "bold".to_string(),
                },

                // Key metrics
                MetricsGrid {
                    metrics: vec![
                        Metric {
                            label: "Active Sessions".to_string(),
                            value: format!("{}", manager.active_sessions.len()),
                            icon: assets::ICON_DEVICES,
                        },
                        Metric {
                            label: "Average Trust Score".to_string(),
                            value: format!("{:.1}%", manager.get_avg_trust_score()),
                            icon: assets::ICON_SHIELD,
                        },
                        Metric {
                            label: "Auth Events (24h)".to_string(),
                            value: format!("{}", manager.get_recent_events_count()),
                            icon: assets::ICON_LOG,
                        },
                        Metric {
                            label: "MFA Challenges".to_string(),
                            value: format!("{}", manager.mfa_challenges.len()),
                            icon: assets::ICON_SECURITY,
                        },
                    ],
                },

                Divider {},

                // Active sessions list
                Text {
                    content: "Active Sessions".to_string(),
                    font_size: 18,
                    font_weight: "600".to_string(),
                    margin_top: 20,
                    margin_bottom: 15,
                },

                DataTable {
                    columns: vec![
                        "User".to_string(),
                        "Device".to_string(),
                        "Trust Score".to_string(),
                        "Last Activity".to_string(),
                    ],
                    rows: manager.active_sessions.iter().map(|(session_id, context)| {
                        vec![
                            context.user_id.clone(),
                            context.device_id.clone(),
                            format!("{:.1}", context.trust_score),
                            format!("{}m ago", (Self::current_timestamp() - context.last_activity) / 60),
                        ]
                    }).collect(),
                },

                // Recent authentication events
                Text {
                    content: "Recent Authentication Events".to_string(),
                    font_size: 18,
                    font_weight: "600".to_string(),
                    margin_top: 20,
                    margin_bottom: 15,
                },

                EventLog {
                    events: manager.get_auth_history(None, 20),
                },
            ],
        }
    }

    // ============ PRIVATE HELPER METHODS ============

    fn create_session(&mut self, user_id: &str, user_did: &str) -> Result<SessionContext, String> {
        let session_id = format!("sess:{}", uuid::Uuid::new_v4());
        let now = Self::current_timestamp();

        let session = SessionContext {
            session_id: session_id.clone(),
            user_id: user_id.to_string(),
            user_did: user_did.to_string(),
            device_id: "device-auto-detected".to_string(),
            device_did: "did:web:omnisystem/device-auto".to_string(),
            created_at: now,
            last_activity: now,
            trust_score: 75.0,
            access_level: AccessLevel::USER,
            encrypted: true,
            crypto_algorithm: "ML-DSA-87+ECDSA".to_string(),
            biometric_validated: false,
        };

        self.active_sessions.insert(session_id.clone(), session.clone());

        self.log_auth_event(
            AuthEventType::SESSION_CREATED,
            Some(user_id.to_string()),
            format!("Session created: {}", session_id),
            AuthResult::SUCCESS,
        );

        Ok(session)
    }

    fn terminate_session(&mut self, session_id: &str) -> Result<(), String> {
        self.active_sessions.remove(session_id);

        self.log_auth_event(
            AuthEventType::SESSION_TERMINATED,
            None,
            format!("Session terminated: {}", session_id),
            AuthResult::SUCCESS,
        );

        Ok(())
    }

    fn determine_risk_action(&self, trust_score: &ContinuousTrustScore) -> RiskAction {
        match trust_score.risk_level {
            RiskLevel::CRITICAL => RiskAction::DENY_ACCESS,
            RiskLevel::HIGH => RiskAction::REQUEST_STEP_UP,
            RiskLevel::MEDIUM => RiskAction::REQUEST_STEP_UP,
            RiskLevel::LOW => RiskAction::CONTINUE,
            RiskLevel::NONE => RiskAction::CONTINUE,
        }
    }

    fn verify_biometric_response(&self, response: &[u8]) -> bool {
        // In production: call native biometric verification API
        response.len() > 0
    }

    fn verify_step_up_response(&self, response: &[u8]) -> bool {
        // Typically a re-authentication with passkey or biometric
        response.len() > 32
    }

    fn verify_otp_response(response: &[u8]) -> bool {
        // Verify TOTP/HOTP code
        response.len() == 6 || response.len() == 8
    }

    fn log_auth_event(&mut self, event_type: AuthEventType, user_id: Option<String>, details: String, result: AuthResult) {
        let event = AuthenticationEvent {
            timestamp: Self::current_timestamp(),
            event_type,
            user_id,
            session_id: None,
            details,
            result,
        };

        self.auth_history.push(event.clone());

        events::EVENT_SYSTEM.fire_event("auth:event_logged", json!({
            "event_type": format!("{:?}", event_type),
            "result": format!("{:?}", result)
        }));
    }

    fn get_avg_trust_score(&self) -> f32 {
        if self.active_sessions.is_empty() {
            return 0.0;
        }
        let sum: f32 = self.active_sessions.values().map(|s| s.trust_score).sum();
        sum / self.active_sessions.len() as f32
    }

    fn get_recent_events_count(&self) -> usize {
        let now = Self::current_timestamp();
        let day_ago = now - 86400;
        self.auth_history.iter().filter(|e| e.timestamp > day_ago).count()
    }

    fn current_timestamp() -> u64 {
        std::time::SystemTime::now()
            .duration_since(std::time::UNIX_EPOCH)
            .unwrap_or_default()
            .as_secs()
    }
}

#[derive(Clone, Debug)]
pub struct RiskEvaluation {
    pub session_id: String,
    pub trust_score: ContinuousTrustScore,
    pub action: RiskAction,
    pub anomaly_flags: Vec<String>,
}

#[derive(Clone, Copy, Debug, PartialEq)]
pub enum RiskAction {
    CONTINUE,
    REQUEST_STEP_UP,
    DENY_ACCESS,
}

pub struct EmployeeCredentialData {
    pub employee_id: String,
    pub department: String,
    pub role: String,
    pub clearance_level: String,
}
