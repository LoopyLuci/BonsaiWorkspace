// OMNISYSTEM HARDWARE ATTESTATION PROXY
// Multi-Vendor Attestation for Defense Against Silicon-Level Backdoors
// Axiom Verification Language Implementation

use std::collections::HashMap;
use crypto::hash::sha3_512;

#[derive(Clone, Debug)]
pub struct HardwareAttestationQuote {
    pub vendor: HardwareVendor,
    pub timestamp: u64,
    pub device_id: String,
    pub firmware_version: String,
    pub security_version: u32,
    pub platform_counter: u64,
    pub quote_data: Vec<u8>,
    pub signature: Vec<u8>,
    pub public_key: Vec<u8>,
}

#[derive(Clone, Copy, Debug, PartialEq)]
pub enum HardwareVendor {
    INTEL_SGX,
    INTEL_TDX,
    AMD_SEV_SNP,
    ARM_CCA,
    RISC_V_CUSTOM,
}

#[derive(Clone, Debug)]
pub struct AttestationResult {
    pub session_id: String,
    pub device_id: String,
    pub attestation_level: AttestationLevel,
    pub vendor_quotes: Vec<HardwareAttestationQuote>,
    pub cross_vendor_verified: bool,
    pub risk_indicators: Vec<String>,
    pub timestamp: u64,
}

#[derive(Clone, Copy, Debug, PartialEq)]
pub enum AttestationLevel {
    NONE,                  // No attestation
    SINGLE_VENDOR,         // Single vendor attestation (lower security)
    MULTI_VENDOR,          // Multiple independent vendors verified
    CROSS_VENDOR_VERIFIED, // Cross-verified between 2+ vendors
}

pub struct HardwareAttestationProxy {
    // Trusted roots for each vendor
    intel_sgx_root_cert: Vec<u8>,
    intel_tdx_root_cert: Vec<u8>,
    amd_sev_root_cert: Vec<u8>,
    arm_cca_root_cert: Vec<u8>,

    // Cached quotes
    quote_cache: HashMap<String, CachedQuote>,

    // Vendor interop compatibility map
    vendor_compatibility: HashMap<(HardwareVendor, HardwareVendor), bool>,

    // Audit trail
    attestation_history: Vec<AttestationResult>,

    // Allowlist of trusted firmware versions
    trusted_firmware_versions: HashMap<HardwareVendor, Vec<String>>,
}

#[derive(Clone, Debug)]
struct CachedQuote {
    quote: HardwareAttestationQuote,
    cached_at: u64,
    expires_at: u64,
}

impl HardwareAttestationProxy {
    pub fn new() -> Self {
        let mut vendor_compatibility = HashMap::new();

        // Intel SGX and AMD SEV-SNP are compatible
        vendor_compatibility.insert((HardwareVendor::INTEL_SGX, HardwareVendor::AMD_SEV_SNP), true);
        vendor_compatibility.insert((HardwareVendor::AMD_SEV_SNP, HardwareVendor::INTEL_SGX), true);

        // Intel TDX and ARM CCA are compatible
        vendor_compatibility.insert((HardwareVendor::INTEL_TDX, HardwareVendor::ARM_CCA), true);
        vendor_compatibility.insert((HardwareVendor::ARM_CCA, HardwareVendor::INTEL_TDX), true);

        HardwareAttestationProxy {
            intel_sgx_root_cert: vec![],
            intel_tdx_root_cert: vec![],
            amd_sev_root_cert: vec![],
            arm_cca_root_cert: vec![],
            quote_cache: HashMap::new(),
            vendor_compatibility,
            attestation_history: Vec::new(),
            trusted_firmware_versions: HashMap::from([
                (HardwareVendor::INTEL_SGX, vec!["SGX_1.24.1".to_string(), "SGX_1.25.0".to_string()]),
                (HardwareVendor::INTEL_TDX, vec!["TDX_1.0.1".to_string()]),
                (HardwareVendor::AMD_SEV_SNP, vec!["SEV_SNP_1.3.0".to_string()]),
                (HardwareVendor::ARM_CCA, vec!["CCA_1.0.0".to_string()]),
            ]),
        }
    }

    /// Request hardware attestation from a device
    pub fn request_attestation(
        &mut self,
        device_id: &str,
        session_id: &str,
        challenge: &[u8],
        required_vendors: &[HardwareVendor],
    ) -> Result<AttestationResult, String> {
        let mut vendor_quotes = Vec::new();

        // Collect attestation quotes from each required vendor
        for vendor in required_vendors {
            let quote = self.get_vendor_quote(device_id, *vendor, challenge)?;
            vendor_quotes.push(quote);
        }

        if vendor_quotes.is_empty() {
            return Err("No vendor quotes obtained".to_string());
        }

        // Verify each quote independently
        for quote in &vendor_quotes {
            self.verify_quote(quote)?;
        }

        // Cross-verify compatibility between vendors (if multiple)
        let cross_vendor_verified = if vendor_quotes.len() >= 2 {
            self.verify_cross_vendor_compatibility(&vendor_quotes)?
        } else {
            false
        };

        let attestation_level = match vendor_quotes.len() {
            1 => AttestationLevel::SINGLE_VENDOR,
            2..=3 if cross_vendor_verified => AttestationLevel::CROSS_VENDOR_VERIFIED,
            2..=3 => AttestationLevel::MULTI_VENDOR,
            _ => AttestationLevel::MULTI_VENDOR,
        };

        let risk_indicators = self.assess_risk_indicators(&vendor_quotes);

        let result = AttestationResult {
            session_id: session_id.to_string(),
            device_id: device_id.to_string(),
            attestation_level,
            vendor_quotes,
            cross_vendor_verified,
            risk_indicators,
            timestamp: Self::current_timestamp(),
        };

        // Store in history for audit
        self.attestation_history.push(result.clone());

        Ok(result)
    }

    /// Get quote from a specific vendor's TEE
    fn get_vendor_quote(
        &mut self,
        device_id: &str,
        vendor: HardwareVendor,
        challenge: &[u8],
    ) -> Result<HardwareAttestationQuote, String> {
        // Check cache first
        let cache_key = format!("{}:{:?}", device_id, vendor);
        if let Some(cached) = self.quote_cache.get(&cache_key) {
            if cached.expires_at > Self::current_timestamp() {
                return Ok(cached.quote.clone());
            }
        }

        // Request from platform-specific TEE
        let quote = match vendor {
            HardwareVendor::INTEL_SGX => self.get_intel_sgx_quote(device_id, challenge)?,
            HardwareVendor::INTEL_TDX => self.get_intel_tdx_quote(device_id, challenge)?,
            HardwareVendor::AMD_SEV_SNP => self.get_amd_sev_quote(device_id, challenge)?,
            HardwareVendor::ARM_CCA => self.get_arm_cca_quote(device_id, challenge)?,
            HardwareVendor::RISC_V_CUSTOM => self.get_risc_v_quote(device_id, challenge)?,
        };

        // Validate firmware version
        if !self.is_firmware_trusted(vendor, &quote.firmware_version) {
            return Err(format!("Untrusted firmware version: {}", quote.firmware_version));
        }

        // Cache for 5 minutes
        let now = Self::current_timestamp();
        self.quote_cache.insert(
            cache_key,
            CachedQuote {
                quote: quote.clone(),
                cached_at: now,
                expires_at: now + 300,
            },
        );

        Ok(quote)
    }

    /// Get Intel SGX attestation quote
    fn get_intel_sgx_quote(
        &self,
        device_id: &str,
        challenge: &[u8],
    ) -> Result<HardwareAttestationQuote, String> {
        // In production: Call into Intel SGX SDK
        // For now: Mock implementation
        let mut quote_data = Vec::new();
        quote_data.extend_from_slice(device_id.as_bytes());
        quote_data.extend_from_slice(challenge);

        Ok(HardwareAttestationQuote {
            vendor: HardwareVendor::INTEL_SGX,
            timestamp: Self::current_timestamp(),
            device_id: device_id.to_string(),
            firmware_version: "SGX_1.24.1".to_string(),
            security_version: 12,
            platform_counter: 0,
            quote_data,
            signature: vec![0u8; 384], // SGX quotes are 4KB, simplified here
            public_key: vec![0u8; 128],
        })
    }

    /// Get Intel TDX attestation quote
    fn get_intel_tdx_quote(
        &self,
        device_id: &str,
        challenge: &[u8],
    ) -> Result<HardwareAttestationQuote, String> {
        let mut quote_data = Vec::new();
        quote_data.extend_from_slice(device_id.as_bytes());
        quote_data.extend_from_slice(challenge);

        Ok(HardwareAttestationQuote {
            vendor: HardwareVendor::INTEL_TDX,
            timestamp: Self::current_timestamp(),
            device_id: device_id.to_string(),
            firmware_version: "TDX_1.0.1".to_string(),
            security_version: 10,
            platform_counter: 0,
            quote_data,
            signature: vec![0u8; 512],
            public_key: vec![0u8; 256],
        })
    }

    /// Get AMD SEV-SNP attestation quote
    fn get_amd_sev_quote(
        &self,
        device_id: &str,
        challenge: &[u8],
    ) -> Result<HardwareAttestationQuote, String> {
        let mut quote_data = Vec::new();
        quote_data.extend_from_slice(device_id.as_bytes());
        quote_data.extend_from_slice(challenge);

        Ok(HardwareAttestationQuote {
            vendor: HardwareVendor::AMD_SEV_SNP,
            timestamp: Self::current_timestamp(),
            device_id: device_id.to_string(),
            firmware_version: "SEV_SNP_1.3.0".to_string(),
            security_version: 15,
            platform_counter: 0,
            quote_data,
            signature: vec![0u8; 512],
            public_key: vec![0u8; 256],
        })
    }

    /// Get ARM CCA attestation quote
    fn get_arm_cca_quote(
        &self,
        device_id: &str,
        challenge: &[u8],
    ) -> Result<HardwareAttestationQuote, String> {
        let mut quote_data = Vec::new();
        quote_data.extend_from_slice(device_id.as_bytes());
        quote_data.extend_from_slice(challenge);

        Ok(HardwareAttestationQuote {
            vendor: HardwareVendor::ARM_CCA,
            timestamp: Self::current_timestamp(),
            device_id: device_id.to_string(),
            firmware_version: "CCA_1.0.0".to_string(),
            security_version: 8,
            platform_counter: 0,
            quote_data,
            signature: vec![0u8; 256],
            public_key: vec![0u8; 192],
        })
    }

    /// Get RISC-V custom attestation quote
    fn get_risc_v_quote(
        &self,
        device_id: &str,
        challenge: &[u8],
    ) -> Result<HardwareAttestationQuote, String> {
        let mut quote_data = Vec::new();
        quote_data.extend_from_slice(device_id.as_bytes());
        quote_data.extend_from_slice(challenge);

        Ok(HardwareAttestationQuote {
            vendor: HardwareVendor::RISC_V_CUSTOM,
            timestamp: Self::current_timestamp(),
            device_id: device_id.to_string(),
            firmware_version: "RISC_V_1.0.0".to_string(),
            security_version: 1,
            platform_counter: 0,
            quote_data,
            signature: vec![0u8; 256],
            public_key: vec![0u8; 192],
        })
    }

    /// Verify a single attestation quote cryptographically
    fn verify_quote(&self, quote: &HardwareAttestationQuote) -> Result<(), String> {
        // Verify firmware version is trusted
        if !self.is_firmware_trusted(quote.vendor, &quote.firmware_version) {
            return Err("Untrusted firmware version".to_string());
        }

        // In production: Verify quote signature against vendor root cert
        // For now: Simple validation
        if quote.signature.is_empty() || quote.public_key.is_empty() {
            return Err("Invalid quote signature or public key".to_string());
        }

        // Verify quote freshness (within last hour)
        let now = Self::current_timestamp();
        if quote.timestamp + 3600 < now {
            return Err("Attestation quote too old".to_string());
        }

        Ok(())
    }

    /// Verify compatibility between attestations from different vendors
    fn verify_cross_vendor_compatibility(
        &self,
        quotes: &[HardwareAttestationQuote],
    ) -> Result<bool, String> {
        if quotes.len() < 2 {
            return Ok(false);
        }

        // Check if vendor pairs are compatible
        for i in 0..quotes.len() {
            for j in (i + 1)..quotes.len() {
                let pair = (quotes[i].vendor, quotes[j].vendor);
                if !self.vendor_compatibility.get(&pair).copied().unwrap_or(false) {
                    return Ok(false);
                }
            }
        }

        // All quotes have compatible vendors
        Ok(true)
    }

    /// Assess security risk indicators from quotes
    fn assess_risk_indicators(&self, quotes: &[HardwareAttestationQuote]) -> Vec<String> {
        let mut indicators = Vec::new();

        for quote in quotes {
            // Check security version
            if quote.security_version < 5 {
                indicators.push(format!(
                    "{:?} security version below baseline ({})",
                    quote.vendor, quote.security_version
                ));
            }

            // Check firmware freshness
            let now = Self::current_timestamp();
            if quote.timestamp + 7200 < now {
                indicators.push(format!("{:?} quote is older than 2 hours", quote.vendor));
            }
        }

        indicators
    }

    /// Check if firmware version is trusted
    fn is_firmware_trusted(&self, vendor: HardwareVendor, version: &str) -> bool {
        self.trusted_firmware_versions
            .get(&vendor)
            .map(|versions| versions.contains(&version.to_string()))
            .unwrap_or(false)
    }

    /// Get attestation history for audit
    pub fn get_attestation_history(&self, device_id: Option<&str>, limit: usize) -> Vec<AttestationResult> {
        let filtered: Vec<_> = self.attestation_history
            .iter()
            .filter(|a| {
                match device_id {
                    Some(id) => a.device_id == id,
                    None => true,
                }
            })
            .collect();

        filtered
            .iter()
            .rev()
            .take(limit)
            .cloned()
            .collect()
    }

    /// Require multi-vendor attestation for privileged access
    pub fn require_privileged_attestation(
        &self,
        result: &AttestationResult,
    ) -> Result<bool, String> {
        // For admin operations: Require cross-vendor verification
        if result.attestation_level != AttestationLevel::CROSS_VENDOR_VERIFIED {
            return Err(format!(
                "Privileged access requires cross-vendor attestation, got {:?}",
                result.attestation_level
            ));
        }

        // Must have at least 2 independent vendors
        if result.vendor_quotes.len() < 2 {
            return Err("Privileged access requires attestation from at least 2 vendors".to_string());
        }

        // No critical risk indicators
        if !result.risk_indicators.is_empty() {
            return Err(format!(
                "Privileged access blocked: {}",
                result.risk_indicators.join("; ")
            ));
        }

        Ok(true)
    }

    fn current_timestamp() -> u64 {
        std::time::SystemTime::now()
            .duration_since(std::time::UNIX_EPOCH)
            .unwrap_or_default()
            .as_secs()
    }
}

// Global attestation proxy instance
lazy_static::lazy_static! {
    pub static ref ATTESTATION_PROXY: Mutex<HardwareAttestationProxy> =
        Mutex::new(HardwareAttestationProxy::new());
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_request_single_vendor_attestation() {
        let mut proxy = HardwareAttestationProxy::new();
        let challenge = b"test_challenge";

        let result = proxy.request_attestation(
            "device123",
            "session456",
            challenge,
            &[HardwareVendor::INTEL_SGX],
        ).unwrap();

        assert_eq!(result.attestation_level, AttestationLevel::SINGLE_VENDOR);
        assert_eq!(result.vendor_quotes.len(), 1);
    }

    #[test]
    fn test_request_multi_vendor_attestation() {
        let mut proxy = HardwareAttestationProxy::new();
        let challenge = b"test_challenge";

        let result = proxy.request_attestation(
            "device123",
            "session456",
            challenge,
            &[HardwareVendor::INTEL_SGX, HardwareVendor::AMD_SEV_SNP],
        ).unwrap();

        assert_eq!(result.vendor_quotes.len(), 2);
        assert!(result.cross_vendor_verified);
    }

    #[test]
    fn test_privileged_access_requires_cross_vendor() {
        let mut proxy = HardwareAttestationProxy::new();
        let challenge = b"admin_challenge";

        let result = proxy.request_attestation(
            "admin_device",
            "admin_session",
            challenge,
            &[HardwareVendor::INTEL_SGX, HardwareVendor::AMD_SEV_SNP],
        ).unwrap();

        let privileged_check = proxy.require_privileged_attestation(&result);
        assert!(privileged_check.is_ok());
    }
}
