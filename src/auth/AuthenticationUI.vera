}

fn render_authenticated_ui(state: &AuthUIState) -> Component {
    Container {
        width: 100%,
        height: 100%,
        background_color: assets::COLOR_BACKGROUND,
        children: vec![
            // Welcome header
            Header {
                title: format!("Welcome, {}", state.current_user.clone().unwrap_or("User".to_string())),
                subtitle: format!("Trust Score: {:.1}/100", state.trust_score),
                icon: assets::ICON_USER,
            },

            // Tab navigation for auth features
            TabNavigator {
                tabs: vec![
                    AuthFeatureTab {
                        name: "Overview".to_string(),
                        content: render_auth_overview(state),
                        icon: assets::ICON_DASHBOARD,
                    },
                    AuthFeatureTab {
                        name: "Sessions".to_string(),
                        content: render_sessions_view(state),
                        icon: assets::ICON_DEVICES,
                    },
                    AuthFeatureTab {
                        name: "Credentials".to_string(),
                        content: render_credentials_view(state),
                        icon: assets::ICON_KEY,
                    },
                    AuthFeatureTab {
                        name: "Trust Settings".to_string(),
                        content: render_trust_settings(state),
                        icon: assets::ICON_SETTINGS,
                    },
                ],
                active_tab: 0,
                on_tab_change: |tab_index| {
                    events::EVENT_SYSTEM.fire_event("auth:tab_switched", json!({
                        "tab": tab_index
                    }));
                },
            },
        ],
    }
}

fn render_auth_overview(state: &AuthUIState) -> Component {
    Container {
        padding: 20,
        children: vec![
            // Trust score card
            Card {
                title: "Current Trust Score".to_string(),
                content: format!("{:.1}", state.trust_score),
                icon: assets::ICON_SHIELD,
                color: trust_score_color(state.trust_score),
                children: vec![
                    Text {
                        content: "Based on behavior, device health, and location patterns.".to_string(),
                        font_size: 12,
                        color: assets::COLOR_TEXT_SECONDARY,
                    },
                ],
            },

            // Active sessions summary
            Card {
                title: "Active Sessions".to_string(),
                content: format!("{} active", state.active_sessions.len()),
                icon: assets::ICON_DEVICES,
                children: vec![
                    ListView {
                        items: state.active_sessions.iter().map(|s| {
                            SessionCard {
                                device_name: s.device_name.clone(),
                                location: s.location.clone(),
                                risk_level: s.risk_level.clone(),
                            }
                        }).collect(),
                        on_item_click: |_| {},
                    },
                ],
            },

            // Biometric status
            StatusCard {
                title: "Biometric Authentication".to_string(),
                status: if state.biometric_enabled { "Enabled" } else { "Disabled" },
                status_color: if state.biometric_enabled { "green" } else { "gray" },
            },

            // Last authentication
            InfoCard {
                title: "Last Authentication".to_string(),
                timestamp: state.last_auth_time,
            },
        ],
    }
}

fn render_sessions_view(state: &AuthUIState) -> Component {
    Container {
        padding: 20,
        children: vec![
            Text {
                content: "Manage Your Active Sessions".to_string(),
                font_size: 18,
                font_weight: "600".to_string(),
                margin_bottom: 20,
            },

            // Sessions table
            DataTable {
                columns: vec![
                    TableColumn { header: "Device".to_string(), width: "30%" },
                    TableColumn { header: "Location".to_string(), width: "25%" },
                    TableColumn { header: "Last Activity".to_string(), width: "25%" },
                    TableColumn { header: "Risk".to_string(), width: "15%" },
                    TableColumn { header: "Action".to_string(), width: "5%" },
                ],
                rows: state.active_sessions.iter().map(|session| {
                    TableRow {
                        cells: vec![
                            session.device_name.clone(),
                            session.location.clone(),
                            format_timestamp(session.last_activity),
                            session.risk_level.clone(),
                            "⋮".to_string(),
                        ],
                        on_click: |row_index| {
                            events::EVENT_SYSTEM.fire_event("auth:session_clicked", json!({
                                "session_index": row_index
                            }));
                        },
                    }
                }).collect(),
            },

            // Logout all button
            Button {
                label: "Logout All Sessions".to_string(),
                style: "danger".to_string(),
                width: "200px".to_string(),
                margin_top: 20,
                on_click: || {
                    events::EVENT_SYSTEM.fire_event("auth:logout_all_requested", json!({}));
                },
            },
        ],
    }
}

