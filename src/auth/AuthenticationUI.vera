                        name: "Employee Status".to_string(),
                        created: "2024-01-01".to_string(),
                        credential_type: "VC (DID/VC)".to_string(),
                    },
                    CredentialInfo {
                        name: "Role: Engineer".to_string(),
                        created: "2024-01-01".to_string(),
                        credential_type: "VC (DID/VC)".to_string(),
