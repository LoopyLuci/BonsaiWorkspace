fn render_trust_settings(_state: &AuthUIState) -> Component {
    Container {
        padding: 20,
        children: vec![
            Text {
                content: "Trust & Security Settings".to_string(),
                font_size: 18,
                font_weight: "600".to_string(),
                margin_bottom: 20,
            },

            // Biometric settings
            SettingsSection {
                title: "Biometric Authentication".to_string(),
                children: vec![
                    ToggleSetting {
                        label: "Enable Continuous Biometric Monitoring".to_string(),
                        enabled: true,
                        on_toggle: |enabled| {
                            events::EVENT_SYSTEM.fire_event("auth:biometric_toggle", json!({
                                "enabled": enabled
                            }));
                        },
                    },
                    ToggleSetting {
                        label: "Require Face Recognition for Sensitive Operations".to_string(),
                        enabled: true,
                        on_toggle: |enabled| {
                            events::EVENT_SYSTEM.fire_event("auth:sensitive_ops_mfa_toggle", json!({
                                "enabled": enabled
                            }));
                        },
                    },
                ],
            },

            // Risk-based authentication settings
            SettingsSection {
                title: "Risk-Based Authentication".to_string(),
                children: vec![
                    SliderSetting {
                        label: "High Risk Threshold".to_string(),
                        min: 0,
                        max: 100,
                        value: 50,
                        on_change: |value| {
                            events::EVENT_SYSTEM.fire_event("auth:risk_threshold_changed", json!({
                                "value": value
                            }));
                        },
                    },
                ],
            },

            // Recovery settings
            SettingsSection {
                title: "Recovery Options".to_string(),
                children: vec![
                    Button {
                        label: "Manage Recovery Guardians".to_string(),
                        style: "secondary".to_string(),
                        on_click: || {
                            events::EVENT_SYSTEM.fire_event("auth:manage_guardians", json!({}));
                        },
                    },
                    Button {
                        label: "Generate New Recovery Keys".to_string(),
                        style: "secondary".to_string(),
                        margin_top: 10,
                        on_click: || {
                            events::EVENT_SYSTEM.fire_event("auth:generate_recovery_keys", json!({}));
                        },
                    },
                ],
            },
        ],
    }
}

// Helper functions
fn trust_score_color(score: f32) -> String {
    match score {
        s if s >= 90.0 => "green".to_string(),
        s if s >= 70.0 => "blue".to_string(),
        s if s >= 50.0 => "orange".to_string(),
        _ => "red".to_string(),
    }
}

fn format_timestamp(timestamp: u64) -> String {
    // Format Unix timestamp as human-readable string
    format!("{}s ago", timestamp)
}

