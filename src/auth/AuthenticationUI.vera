            },

            TextInput {
                label: "Email Address".to_string(),
                placeholder: "your.email@company.com".to_string(),
                width: "100%".to_string(),
                on_change: |_| {},
            },

            TextArea {
                label: "Describe Your Situation".to_string(),
                placeholder: "Lost all devices, cannot authenticate...".to_string(),
                height: 100,
