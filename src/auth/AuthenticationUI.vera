                margin_top: 15,
                on_change: |_| {},
            },

            Button {
                label: "Request Admin Help".to_string(),
                style: "primary".to_string(),
                width: "100%".to_string(),
                margin_top: 20,
                on_click: || {
                    events::EVENT_SYSTEM.fire_event("auth:admin_help_requested", json!({}));
                },
