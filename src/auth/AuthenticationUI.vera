// OMNISYSTEM AUTHENTICATION UI
// Next-Generation Passwordless & Biometric Authentication Interface
// VERA Language Implementation

import "asset_manager" as assets;
import "event_system" as events;

lazy_static::lazy_static! {
    pub static ref AUTH_UI_STATE: Mutex<AuthUIState> = Mutex::new(AuthUIState::new());
}

pub struct AuthUIState {
    pub authenticated: bool,
    pub current_user: Option<String>,
    pub active_sessions: Vec<SessionInfo>,
    pub pending_mfa: bool,
    pub passkey_enrolled: bool,
    pub biometric_enabled: bool,
    pub trust_score: f32,
    pub last_auth_time: u64,
}

pub struct SessionInfo {
    pub session_id: String,
    pub device_name: String,
    pub login_time: u64,
    pub last_activity: u64,
    pub risk_level: String,
    pub location: String,
}

impl AuthUIState {
    pub fn new() -> Self {
        AuthUIState {
            authenticated: false,
            current_user: None,
            active_sessions: Vec::new(),
            pending_mfa: false,
            passkey_enrolled: false,
            biometric_enabled: false,
            trust_score: 0.0,
            last_auth_time: 0,
        }
    }
}

pub fn render_authentication_screen() -> Component {
    let state = AUTH_UI_STATE.lock().unwrap();

    if state.authenticated {
        render_authenticated_ui(&state)
    } else {
        render_login_screen()
    }
}

fn render_login_screen() -> Component {
    Container {
        width: 100%,
        height: 100%,
        background_color: assets::COLOR_BACKGROUND,
        children: vec![
            // Header with Omnisystem branding
            Header {
                title: "Omnisystem Authentication".to_string(),
                subtitle: "Secure, Passwordless, Next-Generation".to_string(),
                icon: assets::ICON_SECURITY_SHIELD,
                background_gradient: ("0066CC".to_string(), "00AA44".to_string()),
            },

            // Tab-based authentication methods
            TabNavigator {
                tabs: vec![
                    AuthTab {
                        name: "Passkey".to_string(),
                        content: render_passkey_login(),
                        icon: assets::ICON_KEY,
                    },
                    AuthTab {
                        name: "Biometric".to_string(),
                        content: render_biometric_login(),
                        icon: assets::ICON_FINGERPRINT,
                    },
                    AuthTab {
                        name: "Recovery".to_string(),
                        content: render_recovery_login(),
                        icon: assets::ICON_RECOVERY,
                    },
                ],
                active_tab: 0,
                on_tab_change: |tab_index| {
                    events::EVENT_SYSTEM.fire_event("auth:tab_changed", json!({
                        "tab": tab_index
                    }));
                },
            },

            // Security status indicator
            SecurityStatusBar {
                threat_level: "LOW".to_string(),
                encryption_status: "AES-256-GCM".to_string(),
                device_health: 95,
            },

            // Footer with help and settings
            Footer {
                items: vec![
                    FooterLink { label: "Help".to_string(), action: "auth:help" },
                    FooterLink { label: "Settings".to_string(), action: "auth:settings" },
                    FooterLink { label: "Privacy".to_string(), action: "auth:privacy" },
                ],
            },
        ],
    }
}

fn render_passkey_login() -> Component {
    Container {
        width: 100%,
        padding: 20,
        children: vec![
            Text {
                content: "Sign in with your passkey".to_string(),
                font_size: 18,
                font_weight: "600".to_string(),
                color: assets::COLOR_TEXT_PRIMARY,
                margin_bottom: 20,
            },

            Text {
                content: "Phishing-proof authentication using FIDO2 WebAuthn".to_string(),
                font_size: 14,
                color: assets::COLOR_TEXT_SECONDARY,
                margin_bottom: 30,
            },

            // Device selection dropdown
            Dropdown {
                label: "Select Device".to_string(),
                options: vec![
                    DropdownOption { label: "This Computer".to_string(), value: "platform" },
                    DropdownOption { label: "Security Key".to_string(), value: "security_key" },
                    DropdownOption { label: "Mobile Device".to_string(), value: "mobile" },
                ],
                on_select: |device_type| {
                    events::EVENT_SYSTEM.fire_event("auth:device_selected", json!({
                        "device": device_type
                    }));
                },
            },

            // Primary CTA: Start Passkey Authentication
            Button {
                label: "Sign in with Passkey".to_string(),
                style: "primary".to_string(),
                width: "100%".to_string(),
                height: 48,
                margin_top: 30,
                on_click: || {
                    events::EVENT_SYSTEM.fire_event("auth:passkey_start", json!({}));
                    // Trigger WebAuthn navigator.credentials.get()
                    call_webauthn_get_assertion();
                },
            },

            // Status indicator during authentication
            ProgressIndicator {
                label: "Waiting for device...".to_string(),
                show_spinner: true,
                is_visible: false,
            },

            // Error message display (shown on auth failure)
            ErrorMessage {
                message: "".to_string(),
                is_visible: false,
                margin_top: 20,
            },

            // Info box about passkeys
            InfoBox {
                title: "What is a Passkey?".to_string(),
                content: "Passkeys are cryptographic credentials stored securely on your device. They cannot be phished because they're bound to the website's origin.".to_string(),
                icon: assets::ICON_INFO,
                background_color: assets::COLOR_INFO_BACKGROUND,
            },
        ],
    }
}

fn render_biometric_login() -> Component {
    Container {
        width: 100%,
        padding: 20,
        children: vec![
            Text {
                content: "Sign in with Biometric".to_string(),
                font_size: 18,
                font_weight: "600".to_string(),
                color: assets::COLOR_TEXT_PRIMARY,
                margin_bottom: 20,
            },

            Text {
                content: "Authenticate using your fingerprint, face, or device unlock".to_string(),
                font_size: 14,
                color: assets::COLOR_TEXT_SECONDARY,
                margin_bottom: 30,
            },

            // Biometric type selector
            RadioGroup {
                name: "biometric_type".to_string(),
                options: vec![
                    RadioOption { label: "Facial Recognition".to_string(), value: "face" },
                    RadioOption { label: "Fingerprint".to_string(), value: "fingerprint" },
                    RadioOption { label: "Device Unlock Pattern".to_string(), value: "device_unlock" },
                ],
                selected: "face".to_string(),
                on_change: |selected| {
                    events::EVENT_SYSTEM.fire_event("auth:biometric_type_selected", json!({
                        "type": selected
                    }));
                },
            },

            // Primary CTA: Start Biometric Authentication
            Button {
                label: "Authenticate with Biometric".to_string(),
                style: "primary".to_string(),
                width: "100%".to_string(),
                height: 48,
                margin_top: 30,
                on_click: || {
                    events::EVENT_SYSTEM.fire_event("auth:biometric_start", json!({}));
                    initiate_biometric_capture();
                },
            },

            // Liveness check indicator
            Container {
                margin_top: 30,
                padding: 15,
                background_color: assets::COLOR_SURFACE,
                border_radius: 8,
                children: vec![
                    Text {
                        content: "🔍 Liveness Detection Active".to_string(),
                        font_size: 12,
                        color: assets::COLOR_SUCCESS,
                    },
                    Text {
                        content: "Presentation attack detection (PAD) enabled".to_string(),
                        font_size: 11,
                        color: assets::COLOR_TEXT_SECONDARY,
                        margin_top: 5,
                    },
                ],
            },

            // Accessibility note
            AccessibilityNote {
                text: "If you have difficulty using biometric authentication, use the Passkey or Recovery option above.".to_string(),
            },
        ],
    }
}

fn render_recovery_login() -> Component {
    Container {
        width: 100%,
        padding: 20,
        children: vec![
            Text {
                content: "Account Recovery".to_string(),
                font_size: 18,
                font_weight: "600".to_string(),
                color: assets::COLOR_TEXT_PRIMARY,
                margin_bottom: 20,
            },

            Text {
                content: "Lost access to your devices? Use your recovery keys or contact your administrator.".to_string(),
                font_size: 14,
                color: assets::COLOR_TEXT_SECONDARY,
                margin_bottom: 30,
            },

            // Recovery method tabs
            TabNavigator {
                tabs: vec![
                    RecoveryTab {
                        name: "Recovery Key".to_string(),
                        content: render_recovery_key_input(),
                    },
                    RecoveryTab {
                        name: "Recovery Contact".to_string(),
                        content: render_recovery_contact(),
                    },
                    RecoveryTab {
                        name: "Admin Help".to_string(),
                        content: render_admin_recovery(),
                    },
                ],
                active_tab: 0,
                on_tab_change: |_| {},
            },
        ],
    }
}

fn render_recovery_key_input() -> Component {
    Container {
        children: vec![
            TextInput {
                label: "Recovery Key".to_string(),
                placeholder: "XXXX-XXXX-XXXX-XXXX".to_string(),
                input_type: "password".to_string(),
                width: "100%".to_string(),
                on_change: |value| {
                    events::EVENT_SYSTEM.fire_event("auth:recovery_key_entered", json!({
                        "key": value
                    }));
                },
            },

            Button {
                label: "Recover Account".to_string(),
                style: "primary".to_string(),
                width: "100%".to_string(),
                margin_top: 20,
                on_click: || {
                    events::EVENT_SYSTEM.fire_event("auth:recovery_submit", json!({}));
                },
            },

            InfoBox {
                title: "About Recovery Keys".to_string(),
                content: "Recovery keys were provided when you enrolled. Store them securely in case you lose access to all your devices.".to_string(),
                background_color: assets::COLOR_WARNING_BACKGROUND,
            },
        ],
    }
}

fn render_recovery_contact() -> Component {
    Container {
        children: vec![
            Text {
                content: "Contact a Recovery Guardian".to_string(),
                font_size: 16,
                font_weight: "600".to_string(),
                margin_bottom: 15,
            },

            // List of recovery guardians
            ListView {
                items: vec![
                    GuardianItem {
                        name: "Alice Johnson".to_string(),
                        relationship: "Friend".to_string(),
                        email: "alice@example.com".to_string(),
                        verified: true,
                    },
                    GuardianItem {
                        name: "Bob Smith".to_string(),
                        relationship: "Family".to_string(),
                        email: "bob@example.com".to_string(),
                        verified: true,
                    },
                ],
                on_item_click: |index| {
                    events::EVENT_SYSTEM.fire_event("auth:contact_guardian", json!({
                        "guardian_index": index
                    }));
                },
            },

            Text {
                content: "A recovery request will be sent to your selected guardian.".to_string(),
