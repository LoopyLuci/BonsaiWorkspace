/// Authenticate a user with passkeys (primary authentication method)
pub fn authenticate_user(
    username: &str,
    credential_id: &[u8],
    client_signature: &[u8],
) -> Result<SessionContext, String> {
    let mut auth_manager = authentication_manager::AUTH_MANAGER.lock().unwrap();
    auth_manager.authenticate_with_passkey(username, credential_id, client_signature)
}

/// Evaluate risk for an active session
pub fn evaluate_session_risk(
    session_id: &str,
    behavioral: &BehavioralSignal,
    contextual: &ContextualSignal,
) -> Result<RiskLevel, String> {
    let mut auth_manager = authentication_manager::AUTH_MANAGER.lock().unwrap();
    let evaluation = auth_manager.evaluate_session_risk(session_id, behavioral, contextual)?;
    Ok(evaluation.trust_score.risk_level)
}

/// Request step-up authentication (MFA challenge)
pub fn request_step_up_authentication(session_id: &str) -> Result<String, String> {
    let mut auth_manager = authentication_manager::AUTH_MANAGER.lock().unwrap();
    auth_manager.issue_mfa_challenge(session_id, MFAChallengeType::STEP_UP)
}

/// Verify MFA response
pub fn verify_mfa_response(challenge_id: &str, response: &[u8]) -> Result<(), String> {
    let mut auth_manager = authentication_manager::AUTH_MANAGER.lock().unwrap();
    auth_manager.verify_mfa_challenge(challenge_id, response)
}

/// Create an ephemeral puzzle for privileged access
pub fn create_action_puzzle(
    session_id: &str,
    action_description: &str,
    biometric_state: &BiometricSignature,
) -> Result<EphemeralPuzzle, String> {
    let session = get_active_session(session_id)?;
    let mut puzzle_engine = ephemeral_puzzle_engine::PUZZLE_ENGINE.lock().unwrap();
    puzzle_engine.create_puzzle(
        session_id,
        &session.user_id,
        action_description,
        biometric_state.clone(),
    )
}

/// Request hardware attestation for privileged operations
pub fn request_attestation(
    device_id: &str,
    session_id: &str,
    required_vendors: &[hardware_attestation::HardwareVendor],
) -> Result<AttestationResult, String> {
    let challenge = b"auth_attestation_challenge";
    let mut proxy = hardware_attestation::ATTESTATION_PROXY.lock().unwrap();
    proxy.request_attestation(device_id, session_id, challenge, required_vendors)
}

/// Verify a device has proper attestation for admin access
pub fn verify_privileged_access(attestation: &AttestationResult) -> Result<bool, String> {
    let proxy = hardware_attestation::ATTESTATION_PROXY.lock().unwrap();
    proxy.require_privileged_attestation(attestation)
}

/// Log an authentication event to immutable ledger
pub fn log_auth_event(
    action: String,
    entity_id: String,
    user_id: Option<String>,
    details: String,
) -> Result<(), String> {
    let entry = AuditEntry {
        index: 0,
        timestamp: std::time::SystemTime::now()
            .duration_since(std::time::UNIX_EPOCH)
            .unwrap_or_default()
            .as_secs(),
        action,
        entity_id,
        user_id,
        details,
        hash: [0u8; 64],
    };

    let mut ledger = immutable_ledger::AUDIT_LEDGER.lock().unwrap();
    ledger.log_event(entry);
    Ok(())
}

/// Get privacy-preserving audit report
pub fn get_audit_report(report_type: &str) -> Result<immutable_ledger::AuditReport, String> {
    let mut ledger = immutable_ledger::AUDIT_LEDGER.lock().unwrap();
    ledger.generate_privacy_preserving_report(report_type)
}

/// Get active session information
fn get_active_session(session_id: &str) -> Result<SessionContext, String> {
    let auth_manager = authentication_manager::AUTH_MANAGER.lock().unwrap();
    let sessions = &auth_manager.active_sessions;
    sessions.get(session_id)
        .cloned()
        .ok_or("Session not found".to_string())
}

/// Render authentication UI in Control Panel
pub fn render_auth_dashboard_tab() -> Component {
    authentication_manager::AuthenticationManager::render_auth_dashboard_tab()
}

