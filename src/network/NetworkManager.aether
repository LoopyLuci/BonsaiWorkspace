// NETWORK MANAGER
// Network Configuration & Monitoring
// AETHER Distributed Systems Language Implementation

use std::collections::HashMap;

pub struct NetworkInterface {
    pub name: String,
    pub status: NetworkStatus,
    pub bandwidth_mbps: u32,
}

pub enum NetworkStatus {
    CONNECTED,
    DISCONNECTED,
    DEGRADED,
}

pub struct NetworkManager {
    interfaces: HashMap<String, NetworkInterface>,
}

impl NetworkManager {
    pub fn new() -> Self {
        NetworkManager { interfaces: HashMap::new() }
    }

    pub fn get_interface_status(&self, name: &str) -> Option<NetworkStatus> {
        self.interfaces.get(name).map(|i| match i.status {
            NetworkStatus::CONNECTED => NetworkStatus::CONNECTED,
            NetworkStatus::DISCONNECTED => NetworkStatus::DISCONNECTED,
            NetworkStatus::DEGRADED => NetworkStatus::DEGRADED,
        })
    }

    pub fn list_interfaces(&self) -> Vec<NetworkInterface> {
        self.interfaces.values().cloned().collect()
    }

    pub fn is_connected(&self) -> bool {
        self.interfaces.values().any(|i| matches!(i.status, NetworkStatus::CONNECTED))
    }
}

#[derive(Clone)]
struct NetworkInterface {
    name: String,
    status: NetworkStatus,
    bandwidth_mbps: u32,
}
