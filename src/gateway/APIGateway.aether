// API GATEWAY
// Request Routing, Rate Limiting & Protocol Bridging
// AETHER Distributed Systems Language Implementation

use std::collections::HashMap;
use std::sync::Mutex;

#[derive(Clone, Debug)]
pub struct Route {
    pub path: String,
    pub methods: Vec<String>,
    pub target_service: String,
    pub rate_limit: Option<RateLimit>,
    pub middleware: Vec<String>,
    pub auth_required: bool,
}

#[derive(Clone, Debug)]
pub struct RateLimit {
    pub requests_per_minute: u32,
    pub requests_per_hour: u32,
}

#[derive(Clone, Debug)]
pub struct Request {
    pub id: String,
    pub method: String,
    pub path: String,
    pub headers: HashMap<String, String>,
    pub body: Option<Vec<u8>>,
    pub client_ip: String,
}

#[derive(Clone, Debug)]
pub struct Response {
    pub status_code: u16,
    pub headers: HashMap<String, String>,
    pub body: Option<Vec<u8>>,
}

pub struct APIGateway {
    routes: Mutex<HashMap<String, Route>>,
    rate_limiters: Mutex<HashMap<String, RateLimitTracker>>,
    request_log: Mutex<Vec<RequestLog>>,
}

#[derive(Clone, Debug)]
struct RateLimitTracker {
    requests_this_minute: u32,
    requests_this_hour: u32,
    last_reset: u64,
}

#[derive(Clone, Debug)]
struct RequestLog {
    timestamp: u64,
    request_id: String,
    status: u16,
    latency_ms: u32,
}

impl APIGateway {
    pub fn new() -> Self {
        APIGateway {
            routes: Mutex::new(HashMap::new()),
            rate_limiters: Mutex::new(HashMap::new()),
            request_log: Mutex::new(Vec::new()),
        }
    }

    /// Register a new route
    pub fn register_route(&self, route: Route) -> Result<(), String> {
        let mut routes = self.routes.lock().map_err(|e| e.to_string())?;
        routes.insert(route.path.clone(), route);
        Ok(())
    }

    /// Route an incoming request
    pub fn route_request(&self, request: Request) -> Result<Response, String> {
        // Find matching route
        let routes = self.routes.lock().map_err(|e| e.to_string())?;
        let route = routes
            .values()
            .find(|r| r.path == request.path && r.methods.contains(&request.method))
            .ok_or("Route not found")?;

        // Check authentication
        if route.auth_required {
            self.verify_authentication(&request)?;
        }

        // Check rate limiting
        self.check_rate_limit(&request.client_ip, route)?;

        // Route to target service
        let response = self.forward_to_service(&request, route)?;

        // Log request
        self.log_request(&request, &response)?;

        Ok(response)
    }

    /// Verify request authentication
    fn verify_authentication(&self, request: &Request) -> Result<(), String> {
        let auth_header = request
            .headers
            .get("Authorization")
            .ok_or("Missing Authorization header")?;

        if !auth_header.starts_with("Bearer ") {
            return Err("Invalid Authorization header".to_string());
        }

        Ok(())
    }

    /// Check rate limiting
    fn check_rate_limit(&self, client_ip: &str, route: &Route) -> Result<(), String> {
        let Some(limit) = &route.rate_limit else {
            return Ok(());
        };

        let mut limiters = self.rate_limiters.lock().map_err(|e| e.to_string())?;
        let tracker = limiters
            .entry(client_ip.to_string())
            .or_insert_with(|| RateLimitTracker {
                requests_this_minute: 0,
                requests_this_hour: 0,
                last_reset: std::time::SystemTime::now()
                    .duration_since(std::time::UNIX_EPOCH)
                    .unwrap_or_default()
                    .as_secs(),
            });

        // Check minute limit
        if tracker.requests_this_minute >= limit.requests_per_minute {
            return Err("Rate limit exceeded (per minute)".to_string());
        }

        // Check hour limit
        if tracker.requests_this_hour >= limit.requests_per_hour {
            return Err("Rate limit exceeded (per hour)".to_string());
        }

        tracker.requests_this_minute += 1;
        tracker.requests_this_hour += 1;

        Ok(())
    }

    /// Forward request to target service
    fn forward_to_service(&self, request: &Request, route: &Route) -> Result<Response, String> {
        // Simulate forwarding to service
        Ok(Response {
            status_code: 200,
            headers: HashMap::new(),
            body: Some(b"OK".to_vec()),
        })
    }

    /// Log request for analytics
    fn log_request(&self, request: &Request, response: &Response) -> Result<(), String> {
        let log = RequestLog {
            timestamp: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap_or_default()
                .as_secs(),
            request_id: request.id.clone(),
            status: response.status_code,
            latency_ms: 45,
        };

        let mut logs = self.request_log.lock().map_err(|e| e.to_string())?;
        logs.push(log);

        Ok(())
    }

    /// Get request metrics
    pub fn get_metrics(&self) -> Result<GatewayMetrics, String> {
        let logs = self.request_log.lock().map_err(|e| e.to_string())?;

        let total_requests = logs.len() as u32;
        let avg_latency = if total_requests > 0 {
            logs.iter().map(|l| l.latency_ms).sum::<u32>() / total_requests
        } else {
            0
        };

        Ok(GatewayMetrics {
            total_requests,
            avg_latency,
        })
    }
}

#[derive(Debug)]
pub struct GatewayMetrics {
    pub total_requests: u32,
    pub avg_latency: u32,
}

// Global API Gateway instance
lazy_static::lazy_static! {
    pub static ref API_GATEWAY: APIGateway = APIGateway::new();
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_route_registration() {
        let gw = APIGateway::new();
        let route = Route {
            path: "/api/users".to_string(),
            methods: vec!["GET".to_string()],
            target_service: "user_service".to_string(),
            rate_limit: None,
            middleware: vec![],
            auth_required: false,
        };

        assert!(gw.register_route(route).is_ok());
    }

    #[test]
    fn test_metrics() {
        let gw = APIGateway::new();
        assert!(gw.get_metrics().is_ok());
    }
}
