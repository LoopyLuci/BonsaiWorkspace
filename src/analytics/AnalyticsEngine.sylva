// ANALYTICS ENGINE
// Event Tracking & Business Intelligence
// SYLVA Machine Learning Language Implementation

use std::collections::HashMap;

#[derive(Clone, Debug)]
pub struct Event {
    pub event_type: String,
    pub timestamp: u64,
    pub user_id: Option<String>,
    pub properties: HashMap<String, String>,
}

#[derive(Clone, Debug)]
pub struct Analytics {
    pub events: Vec<Event>,
    pub dashboards: HashMap<String, Dashboard>,
}

#[derive(Clone, Debug)]
pub struct Dashboard {
    pub name: String,
    pub widgets: Vec<Widget>,
}

#[derive(Clone, Debug)]
pub struct Widget {
    pub title: String,
    pub widget_type: String,
    pub data: Vec<f32>,
}

pub struct AnalyticsEngine {
    events: Vec<Event>,
}

impl AnalyticsEngine {
    pub fn new() -> Self {
        AnalyticsEngine {
            events: Vec::new(),
        }
    }

    /// Track an event
    pub fn track_event(&mut self, event: Event) {
        self.events.push(event);
    }

    /// Get events by type
    pub fn get_events_by_type(&self, event_type: &str) -> Vec<Event> {
        self.events
            .iter()
            .filter(|e| e.event_type == event_type)
            .cloned()
            .collect()
    }

    /// Calculate retention metrics
    pub fn calculate_retention(&self) -> RetentionMetrics {
        let total_events = self.events.len() as u32;
        let auth_events = self.get_events_by_type("auth_success").len() as u32;
        let risk_events = self.get_events_by_type("risk_escalation").len() as u32;

        RetentionMetrics {
            total_events,
            auth_events,
            risk_events,
            retention_rate: if total_events > 0 {
                (auth_events as f32 / total_events as f32) * 100.0
            } else {
                0.0
            },
        }
    }

    /// Generate daily report
    pub fn generate_daily_report(&self) -> DailyReport {
        let metrics = self.calculate_retention();
        let top_events = self.get_top_events(5);

        DailyReport {
            date: format_date_today(),
            metrics,
            top_events,
        }
    }

    /// Get top events
    fn get_top_events(&self, limit: usize) -> Vec<EventCount> {
        let mut event_counts: HashMap<String, u32> = HashMap::new();

        for event in &self.events {
            *event_counts.entry(event.event_type.clone()).or_insert(0) += 1;
        }

        let mut counts: Vec<_> = event_counts
            .into_iter()
            .map(|(event_type, count)| EventCount {
                event_type,
                count,
            })
            .collect();

        counts.sort_by(|a, b| b.count.cmp(&a.count));
        counts.into_iter().take(limit).collect()
    }
}

#[derive(Debug)]
pub struct RetentionMetrics {
    pub total_events: u32,
    pub auth_events: u32,
    pub risk_events: u32,
    pub retention_rate: f32,
}

#[derive(Debug)]
pub struct DailyReport {
    pub date: String,
    pub metrics: RetentionMetrics,
    pub top_events: Vec<EventCount>,
}

#[derive(Debug)]
pub struct EventCount {
    pub event_type: String,
    pub count: u32,
}

fn format_date_today() -> String {
    "2026-06-23".to_string()
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_event_tracking() {
        let mut engine = AnalyticsEngine::new();
        let event = Event {
            event_type: "auth_success".to_string(),
            timestamp: 0,
            user_id: Some("user1".to_string()),
            properties: HashMap::new(),
        };

        engine.track_event(event);
        assert_eq!(engine.events.len(), 1);
    }

    #[test]
    fn test_retention_calculation() {
        let mut engine = AnalyticsEngine::new();
        for i in 0..10 {
            let event = Event {
                event_type: if i < 5 { "auth_success" } else { "other" }.to_string(),
                timestamp: i as u64,
                user_id: None,
                properties: HashMap::new(),
            };
            engine.track_event(event);
        }

        let metrics = engine.calculate_retention();
        assert_eq!(metrics.total_events, 10);
        assert_eq!(metrics.auth_events, 5);
    }
}
