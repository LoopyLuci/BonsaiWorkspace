// SYSTEM TRAY MANAGER
// Native Platform Tray Integration (Windows, macOS, Linux)
// VERA Language Implementation

import "asset_manager" as assets;
import "event_system" as events;

pub struct TrayMenu {
    pub items: Vec<MenuItem>,
}

pub struct MenuItem {
    pub label: String,
    pub action: String,
    pub submenu: Option<Box<TrayMenu>>,
}

pub fn render_system_tray() -> TrayMenu {
    TrayMenu {
        items: vec![
            MenuItem {
                label: "Show Control Panel".to_string(),
                action: "show_control_panel".to_string(),
                submenu: None,
            },
            MenuItem {
                label: "Status".to_string(),
                action: "".to_string(),
                submenu: Some(Box::new(TrayMenu {
                    items: vec![
                        MenuItem {
                            label: "Trust Score: 85.0".to_string(),
                            action: "view_trust_score".to_string(),
                            submenu: None,
                        },
                        MenuItem {
                            label: "1 Session Active".to_string(),
                            action: "view_sessions".to_string(),
                            submenu: None,
                        },
                    ],
                })),
            },
            MenuItem {
                label: "Quick Access".to_string(),
                action: "".to_string(),
                submenu: Some(Box::new(TrayMenu {
                    items: vec![
                        MenuItem {
                            label: "Notification Center".to_string(),
                            action: "show_notifications".to_string(),
                            submenu: None,
                        },
                        MenuItem {
                            label: "Authentication".to_string(),
                            action: "show_auth".to_string(),
                            submenu: None,
                        },
                        MenuItem {
                            label: "Themes".to_string(),
                            action: "show_themes".to_string(),
                            submenu: None,
                        },
                    ],
                })),
            },
            MenuItem {
                label: "Help".to_string(),
                action: "show_help".to_string(),
                submenu: None,
            },
            MenuItem {
                label: "Settings".to_string(),
                action: "show_settings".to_string(),
                submenu: None,
            },
            MenuItem {
                label: "Exit".to_string(),
                action: "exit_application".to_string(),
                submenu: None,
            },
        ],
    }
}

pub fn on_tray_menu_click(action: &str) {
    match action {
        "show_control_panel" => {
            events::EVENT_SYSTEM.fire_event("tray:open_control_panel", json!({}));
        }
        "view_trust_score" => {
            events::EVENT_SYSTEM.fire_event("tray:show_trust_score", json!({}));
        }
        "view_sessions" => {
            events::EVENT_SYSTEM.fire_event("tray:show_sessions", json!({}));
        }
        "show_notifications" => {
            events::EVENT_SYSTEM.fire_event("tray:open_notifications", json!({}));
        }
        "show_auth" => {
            events::EVENT_SYSTEM.fire_event("tray:open_auth", json!({}));
        }
        "show_themes" => {
            events::EVENT_SYSTEM.fire_event("tray:open_themes", json!({}));
        }
        "show_help" => {
            events::EVENT_SYSTEM.fire_event("tray:open_help", json!({}));
        }
        "show_settings" => {
            events::EVENT_SYSTEM.fire_event("tray:open_settings", json!({}));
        }
        "exit_application" => {
            events::EVENT_SYSTEM.fire_event("tray:exit", json!({}));
        }
        _ => {}
    }
}

pub fn update_tray_icon(trust_score: f32) {
    let icon_name = if trust_score >= 90.0 {
        "tray_secure"
    } else if trust_score >= 70.0 {
        "tray_good"
    } else if trust_score >= 50.0 {
        "tray_caution"
    } else {
        "tray_alert"
    };

    events::EVENT_SYSTEM.fire_event("tray:update_icon", json!({
        "icon": icon_name,
        "trust_score": trust_score
    }));
}

pub fn show_tray_tooltip(text: &str) {
    events::EVENT_SYSTEM.fire_event("tray:show_tooltip", json!({
        "text": text
    }));
}
