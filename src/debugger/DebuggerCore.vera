// MULTI-LANGUAGE DEBUGGER
// Integrated Debugging for All Omni-Languages
// VERA Language Implementation

import "asset_manager" as assets;
import "event_system" as events;

pub struct DebuggerState {
    pub paused: bool,
    pub current_line: u32,
    pub current_file: String,
    pub call_stack: Vec<StackFrame>,
    pub breakpoints: Vec<Breakpoint>,
    pub watches: Vec<WatchExpression>,
}

pub struct StackFrame {
    pub function: String,
    pub file: String,
    pub line: u32,
    pub locals: Vec<LocalVariable>,
}

pub struct LocalVariable {
    pub name: String,
    pub value: String,
    pub var_type: String,
}

pub struct Breakpoint {
    pub id: u32,
    pub file: String,
    pub line: u32,
    pub condition: Option<String>,
    pub enabled: bool,
}

pub struct WatchExpression {
    pub id: u32,
    pub expression: String,
    pub value: Option<String>,
}

pub fn render_debugger_ui() -> Component {
    Container {
        width: 100%,
        height: 100%,
        background_color: assets::COLOR_BACKGROUND,

        children: vec![
            // Toolbar
            HorizontalLayout {
                spacing: 10,
                padding: 10,
                background_color: assets::COLOR_SURFACE,
                children: vec![
                    Button { label: "▶ Continue".to_string(), style: "primary".to_string() },
                    Button { label: "⏸ Pause".to_string(), style: "secondary".to_string() },
                    Button { label: "↻ Restart".to_string(), style: "secondary".to_string() },
                    Divider { vertical: true },
                    Button { label: "⬇ Step Over".to_string(), style: "secondary".to_string() },
                    Button { label: "⬇⬇ Step Into".to_string(), style: "secondary".to_string() },
                    Button { label: "⬆ Step Out".to_string(), style: "secondary".to_string() },
                ],
            },

            // Main Debugging Area
            HorizontalLayout {
                width: 100%,
                height: calc(100% - 60),
                spacing: 0,

                children: vec![
                    // Code Editor (70%)
                    Container {
                        width: "70%".to_string(),
                        background_color: "#1E1E1E".to_string(),
                        padding: 10,

                        children: vec![
                            Text {
                                content: "main.titan:42".to_string(),
                                font_size: 12,
                                color: assets::COLOR_TEXT_SECONDARY,
                                font_family: "monospace".to_string(),
                                margin_bottom: 10,
                            },

                            Container {
                                background_color: "#252526".to_string(),
                                padding: 15,
                                children: vec![
                                    CodeDisplay {
                                        language: "titan".to_string(),
                                        code: "pub fn main() {\n    let x = 42;  // <- BREAK HERE\n    println!(x);\n}".to_string(),
                                        highlight_line: 2,
                                    },
                                ],
                            },
                        ],
                    },

                    // Right Sidebar (30%)
                    Container {
                        width: "30%".to_string(),
                        background_color: assets::COLOR_SURFACE,
                        border_left: "1px solid #333333".to_string(),

                        children: vec![
                            // Tabs
                            TabNavigator {
                                tabs: vec![
                                    Tab { name: "Locals".to_string(), icon: assets::ICON_VARIABLES },
                                    Tab { name: "Watch".to_string(), icon: assets::ICON_WATCH },
                                    Tab { name: "Call Stack".to_string(), icon: assets::ICON_STACK },
                                    Tab { name: "Breakpoints".to_string(), icon: assets::ICON_BREAKPOINT },
                                ],
                                active_tab: 0,
                                on_tab_change: |_| {},
                            },

                            Divider { margin: 10 },

                            // Locals Variables
                            Container {
                                padding: 10,
                                children: vec![
                                    VariableTree {
                                        variables: vec![
                                            VariableItem {
                                                name: "x".to_string(),
                                                value: "42".to_string(),
                                                var_type: "i32".to_string(),
                                                expanded: true,
                                            },
                                            VariableItem {
                                                name: "y".to_string(),
                                                value: "\"hello\"".to_string(),
                                                var_type: "String".to_string(),
                                                expanded: false,
                                            },
                                        ],
                                    },
                                ],
                            },
                        ],
                    },
                ],
            },
        ],
    }
}

pub fn set_breakpoint(file: &str, line: u32) -> Result<Breakpoint, String> {
    let breakpoint = Breakpoint {
        id: generate_breakpoint_id(),
        file: file.to_string(),
        line,
        condition: None,
        enabled: true,
    };

    events::EVENT_SYSTEM.fire_event("debugger:breakpoint_set", json!({
        "file": file,
        "line": line
    }));

    Ok(breakpoint)
}

pub fn remove_breakpoint(breakpoint_id: u32) -> Result<(), String> {
    events::EVENT_SYSTEM.fire_event("debugger:breakpoint_removed", json!({
        "id": breakpoint_id
    }));
    Ok(())
}

pub fn add_watch_expression(expression: &str) -> Result<WatchExpression, String> {
    let watch = WatchExpression {
        id: generate_watch_id(),
        expression: expression.to_string(),
        value: None,
    };

    events::EVENT_SYSTEM.fire_event("debugger:watch_added", json!({
        "expression": expression
    }));

    Ok(watch)
}

pub fn step_over() {
    events::EVENT_SYSTEM.fire_event("debugger:step_over", json!({}));
}

pub fn step_into() {
    events::EVENT_SYSTEM.fire_event("debugger:step_into", json!({}));
}

pub fn step_out() {
    events::EVENT_SYSTEM.fire_event("debugger:step_out", json!({}));
}

pub fn continue_execution() {
    events::EVENT_SYSTEM.fire_event("debugger:continue", json!({}));
}

fn generate_breakpoint_id() -> u32 {
    // Generate unique ID
    1
}

fn generate_watch_id() -> u32 {
    // Generate unique ID
    1
}

pub struct VariableItem {
    pub name: String,
    pub value: String,
    pub var_type: String,
    pub expanded: bool,
}
