// OMNISYSTEM MONITORING DASHBOARD
// Real-Time System Metrics & Health Tracking
// VERA + Graphics (HELIX)

import "asset_manager" as assets;
import "event_system" as events;

pub struct MetricsSnapshot {
    pub timestamp: u64,
    pub cpu_usage: f32,
    pub memory_usage: f32,
    pub disk_usage: f32,
    pub network_bandwidth: f32,
    pub active_sessions: u32,
    pub auth_events_per_sec: f32,
    pub avg_latency_ms: f32,
}

pub fn render_monitoring_dashboard() -> Component {
    Container {
        width: 100%,
        height: 100%,
        padding: 20,
        background_color: assets::COLOR_BACKGROUND,

        children: vec![
            // Title
            Text {
                content: "System Monitoring Dashboard".to_string(),
                font_size: 24,
                font_weight: "bold".to_string(),
            },

            // Real-Time Metrics Grid
            MetricsGrid {
                columns: 4,
                spacing: 20,
                children: vec![
                    render_metric_card("CPU Usage", "15%", "green", assets::ICON_CPU),
                    render_metric_card("Memory Usage", "42%", "green", assets::ICON_MEMORY),
                    render_metric_card("Disk Usage", "58%", "yellow", assets::ICON_DISK),
                    render_metric_card("Network", "125 Mbps", "green", assets::ICON_NETWORK),

                    render_metric_card("Auth Events/s", "245", "blue", assets::ICON_AUTH),
                    render_metric_card("Avg Latency", "47ms", "green", assets::ICON_SPEED),
                    render_metric_card("Active Sessions", "8", "blue", assets::ICON_SESSIONS),
                    render_metric_card("System Uptime", "99.999%", "green", assets::ICON_UPTIME),
                ],
            },

            Divider { margin_top: 30, margin_bottom: 30 },

            // Charts Section
            HorizontalLayout {
                spacing: 20,
                children: vec![
                    // CPU Usage Chart
                    Chart {
                        title: "CPU Usage (Last 1 Hour)".to_string(),
                        width: 50%,
                        height: 300,
                        chart_type: "line",
                        data: vec![
                            15.0, 18.0, 20.0, 19.0, 16.0, 14.0, 12.0, 15.0,
                            17.0, 19.0, 18.0, 16.0, 14.0, 13.0, 12.0, 15.0,
                        ],
                    },

                    // Memory Usage Chart
                    Chart {
                        title: "Memory Usage (Last 1 Hour)".to_string(),
                        width: 50%,
                        height: 300,
                        chart_type: "line",
                        data: vec![
                            40.0, 41.0, 42.0, 42.0, 41.0, 40.0, 39.0, 42.0,
                            43.0, 42.0, 41.0, 40.0, 39.0, 38.0, 37.0, 38.0,
                        ],
                    },
                ],
            },

            Divider { margin_top: 30, margin_bottom: 30 },

            // System Health
            Text {
                content: "System Health Status".to_string(),
                font_size: 18,
                font_weight: "600".to_string(),
                margin_bottom: 15,
            },

            HealthStatusList {
                items: vec![
                    HealthItem {
                        name: "Authentication System".to_string(),
                        status: "Healthy".to_string(),
                        status_color: "green",
                        details: "All subsystems operational".to_string(),
                    },
                    HealthItem {
                        name: "Monitoring Dashboard".to_string(),
                        status: "Healthy".to_string(),
                        status_color: "green",
                        details: "Real-time metrics flowing".to_string(),
                    },
                    HealthItem {
                        name: "Network Connectivity".to_string(),
                        status: "Healthy".to_string(),
                        status_color: "green",
                        details: "All endpoints reachable".to_string(),
                    },
                    HealthItem {
                        name: "Storage Capacity".to_string(),
                        status: "Warning".to_string(),
                        status_color: "yellow",
                        details: "58% used, 42% free".to_string(),
                    },
                ],
            },

            Divider { margin_top: 30, margin_bottom: 30 },

            // Alert Threshold Configuration
            Text {
                content: "Alert Configuration".to_string(),
                font_size: 18,
                font_weight: "600".to_string(),
                margin_bottom: 15,
            },

            AlertConfigGrid {
                items: vec![
                    AlertConfig {
                        metric: "CPU Usage".to_string(),
                        warning_threshold: 70.0,
                        critical_threshold: 90.0,
                    },
                    AlertConfig {
                        metric: "Memory Usage".to_string(),
                        warning_threshold: 75.0,
                        critical_threshold: 90.0,
                    },
                    AlertConfig {
                        metric: "Disk Usage".to_string(),
                        warning_threshold: 80.0,
                        critical_threshold: 95.0,
                    },
                    AlertConfig {
                        metric: "Auth Latency".to_string(),
                        warning_threshold: 200.0,
                        critical_threshold: 500.0,
                    },
                ],
            },
        ],
    }
}

fn render_metric_card(title: &str, value: &str, color: &str, icon: &str) -> Component {
    Card {
        title: title.to_string(),
        children: vec![
            Container {
                children: vec![
                    Icon { name: icon.to_string(), size: 32 },
                    Text {
                        content: value.to_string(),
                        font_size: 32,
                        font_weight: "bold".to_string(),
                        color: color.to_string(),
                        margin_top: 10,
                    },
                ],
            },
        ],
    }
}

pub struct HealthItem {
    pub name: String,
    pub status: String,
    pub status_color: String,
    pub details: String,
}

pub struct AlertConfig {
    pub metric: String,
    pub warning_threshold: f32,
    pub critical_threshold: f32,
}
