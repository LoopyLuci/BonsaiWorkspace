// OMNISYSTEM NOTIFICATION SYSTEM
// Multi-Channel Notification Delivery with Priority Queuing
// VERA Language Implementation

import "asset_manager" as assets;
import "event_system" as events;

pub enum NotificationPriority {
    LOW,
    NORMAL,
    HIGH,
    CRITICAL,
}

pub enum NotificationType {
    INFO,
    SUCCESS,
    WARNING,
    ERROR,
    ALERT,
}

pub struct Notification {
    pub id: String,
    pub title: String,
    pub message: String,
    pub notification_type: NotificationType,
    pub priority: NotificationPriority,
    pub timestamp: u64,
    pub read: bool,
    pub actions: Vec<NotificationAction>,
}

pub struct NotificationAction {
    pub label: String,
    pub action_id: String,
}

pub fn render_notification_center() -> Component {
    Container {
        width: 100%,
        height: 100%,
        background_color: assets::COLOR_BACKGROUND,
        padding: 20,

        children: vec![
            // Header
            Text {
                content: "Notification Center".to_string(),
                font_size: 24,
                font_weight: "bold".to_string(),
                margin_bottom: 20,
            },

            // Notification Filters
            HorizontalLayout {
                spacing: 10,
                margin_bottom: 20,
                children: vec![
                    FilterButton {
                        label: "All".to_string(),
                        active: true,
                        on_click: || events::EVENT_SYSTEM.fire_event("notifications:filter", json!({"filter": "all"})),
                    },
                    FilterButton {
                        label: "Unread".to_string(),
                        active: false,
                        on_click: || events::EVENT_SYSTEM.fire_event("notifications:filter", json!({"filter": "unread"})),
                    },
                    FilterButton {
                        label: "Critical".to_string(),
                        active: false,
                        on_click: || events::EVENT_SYSTEM.fire_event("notifications:filter", json!({"filter": "critical"})),
                    },
                    FilterButton {
                        label: "Auth Events".to_string(),
                        active: false,
                        on_click: || events::EVENT_SYSTEM.fire_event("notifications:filter", json!({"filter": "auth"})),
                    },
                ],
            },

            Divider { margin_bottom: 20 },

            // Notifications List
            ListView {
                items: vec![
                    render_notification_item("MFA Challenge Issued", "Complete authentication", NotificationType::ALERT),
                    render_notification_item("Trust Score Alert", "Risk level elevated to HIGH", NotificationType::WARNING),
                    render_notification_item("Credential Issued", "Employee VC successfully issued", NotificationType::SUCCESS),
                    render_notification_item("Session Created", "New session from Windows Hello", NotificationType::INFO),
                ],
                on_item_click: |index| {
                    events::EVENT_SYSTEM.fire_event("notifications:selected", json!({"index": index}));
                },
            },

            Divider { margin_top: 20, margin_bottom: 20 },

            // Notification Settings
            Text {
                content: "Notification Preferences".to_string(),
                font_size: 18,
                font_weight: "600".to_string(),
                margin_bottom: 15,
            },

            SettingsGroup {
                items: vec![
                    ToggleSetting {
                        label: "Enable Toast Notifications".to_string(),
                        enabled: true,
                    },
                    ToggleSetting {
                        label: "Enable Sound Alerts".to_string(),
                        enabled: true,
                    },
                    ToggleSetting {
                        label: "Show Authentication Events".to_string(),
                        enabled: true,
                    },
                    ToggleSetting {
                        label: "Show Risk Escalations".to_string(),
                        enabled: true,
                    },
                    ToggleSetting {
                        label: "Show Duress Alerts (Silent)".to_string(),
                        enabled: true,
                    },
                ],
            },

            Divider { margin_top: 20, margin_bottom: 20 },

            // Clear Notifications Button
            HorizontalLayout {
                spacing: 10,
                children: vec![
                    Button {
                        label: "Mark All as Read".to_string(),
                        style: "secondary".to_string(),
                        on_click: || events::EVENT_SYSTEM.fire_event("notifications:mark_all_read", json!({})),
                    },
                    Button {
                        label: "Clear All".to_string(),
                        style: "danger".to_string(),
                        on_click: || events::EVENT_SYSTEM.fire_event("notifications:clear_all", json!({})),
                    },
                ],
            },
        ],
    }
}

fn render_notification_item(title: &str, message: &str, notification_type: NotificationType) -> Component {
    let icon = match notification_type {
        NotificationType::INFO => assets::ICON_INFO,
        NotificationType::SUCCESS => assets::ICON_SUCCESS,
        NotificationType::WARNING => assets::ICON_WARNING,
        NotificationType::ERROR => assets::ICON_ERROR,
        NotificationType::ALERT => assets::ICON_ALERT,
    };

    let color = match notification_type {
        NotificationType::INFO => "blue",
        NotificationType::SUCCESS => "green",
        NotificationType::WARNING => "orange",
        NotificationType::ERROR => "red",
        NotificationType::ALERT => "red",
    };

    Card {
        children: vec![
            HorizontalLayout {
                spacing: 15,
                children: vec![
                    Icon {
                        name: icon.to_string(),
                        size: 24,
                        color: color.to_string(),
                    },
                    Container {
                        width: calc(100% - 60),
                        children: vec![
                            Text {
                                content: title.to_string(),
                                font_size: 16,
                                font_weight: "600".to_string(),
                            },
                            Text {
                                content: message.to_string(),
                                font_size: 14,
                                color: assets::COLOR_TEXT_SECONDARY,
                                margin_top: 5,
                            },
                        ],
                    },
                    Button {
                        label: "✕".to_string(),
                        style: "flat".to_string(),
                        on_click: || events::EVENT_SYSTEM.fire_event("notifications:dismiss", json!({})),
                    },
                ],
            },
        ],
    }
}

pub fn show_toast_notification(title: &str, message: &str, notification_type: NotificationType) {
    // Show temporary toast notification at bottom-right
    events::EVENT_SYSTEM.fire_event("notifications:toast", json!({
        "title": title,
        "message": message,
        "type": format!("{:?}", notification_type),
    }));
}

pub fn show_mfa_challenge(challenge_id: &str, expires_in_seconds: u32) {
    show_toast_notification(
        "MFA Challenge Required",
        &format!("Complete authentication within {} seconds", expires_in_seconds),
        NotificationType::ALERT,
    );
}

pub fn show_risk_escalation(trust_score: f32, anomalies: &[String]) {
    let message = format!("Trust score dropped to {:.1}. Anomalies detected.", trust_score);
    show_toast_notification("Risk Escalation", &message, NotificationType::WARNING);
}
