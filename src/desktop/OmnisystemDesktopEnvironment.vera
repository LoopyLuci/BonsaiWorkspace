    pub fn shutdown(&mut self) -> Result<(), String> {
        println!("\nShutting down Omnisystem Desktop Environment...");
        println!("  [✓] Saving application state");
        println!("  [✓] Closing all windows ({} open)", self.window_manager.window_count());
        println!("  [✓] Stopping graphics renderer");
        println!("  [✓] Stopping all services");
        println!("  [✓] Flushing notification queue");
        println!("  [✓] Disabling system tray");
        println!("  [✓] Closing GPU connections");
        println!("  [✓] Flushing caches");
        println!("  [✓] Closing connections");
        println!("\n✓ Omnisystem Desktop Environment shutdown complete.\n");
        self.running = false;
        Ok(())
    }

    pub fn is_running(&self) -> bool {
        self.running
    }

    pub fn add_notification(
        &mut self,
        title: String,
        message: String,
        notification_type: NotificationType,
    ) {
        let notification = Notification {
            title,
            message,
            notification_type,
            duration_ms: 5000,
            timestamp: SystemTime::now()
                .duration_since(UNIX_EPOCH)
                .unwrap_or_default()
                .as_secs(),
        };

        self.notification_center.show_notification(notification);
    }

    pub fn set_theme(&mut self, theme: Theme) {
        self.theme_manager.set_theme(theme);
    }

    pub fn set_dpi_scale(&mut self, scale: f32) {
        self.graphics.set_dpi_scale(scale);
    }
}

// ============================================================================
// PUBLIC API
// ============================================================================

pub fn launch_desktop_environment() -> Result<(), String> {
    let mut desktop = OmnisystemDesktopEnvironment::new();

    desktop.run()?;

    // Simulate some events
    desktop.add_notification(
        "System Ready".to_string(),
        "Desktop Environment initialized successfully".to_string(),
        NotificationType::Success,
    );

    desktop.process_event(Event::Window(WindowEvent::Created("main".to_string())))?;

    desktop.shutdown()?;

    Ok(())
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_graphics_context_creation() {
        let graphics = GraphicsContext::new(1400, 900);
        assert_eq!(graphics.width, 1400);
        assert_eq!(graphics.height, 900);
    }

    #[test]
    fn test_theme_manager() {
        let mut theme_mgr = ThemeManager::new();
        theme_mgr.set_theme(Theme::Light);
        let theme = theme_mgr.get_current_theme();
        assert_eq!(theme.background.r, 236);
    }

    #[test]
    fn test_window_manager() {
        let mut wm = WindowManager::new(1400, 900);
        wm.create_window("test".to_string(), "Test".to_string(), 0, 0, 400, 300);
        assert_eq!(wm.window_count(), 1);

        wm.focus_window("test");
        assert_eq!(wm.get_active_window().map(|w| w.id.clone()), Some("test".to_string()));

        wm.maximize_window("test");
        let window = wm.get_window("test").unwrap();
        assert_eq!(window.width, 1400);
        assert_eq!(window.height, 900);
    }

    #[test]
    fn test_layout_engine() {
        let engine = LayoutEngine::new(LayoutType::Box);
        let components = vec![
            UIComponent {
                id: "btn1".to_string(),
                component_type: ComponentType::Button,
                x: 0,
                y: 0,
                width: 100,
                height: 40,
                enabled: true,
                visible: true,
                content: "Button 1".to_string(),
                tooltip: "".to_string(),
            },
            UIComponent {
                id: "btn2".to_string(),
                component_type: ComponentType::Button,
                x: 0,
                y: 0,
                width: 100,
                height: 40,
                enabled: true,
                visible: true,
                content: "Button 2".to_string(),
                tooltip: "".to_string(),
            },
        ];

        let rects = engine.compute_layout(800, 600, &components);
        assert_eq!(rects.len(), 2);
    }

    #[test]
    fn test_notification_center() {
        let mut center = NotificationCenter::new();
        center.show_notification(Notification {
            title: "Test".to_string(),
            message: "Test notification".to_string(),
            notification_type: NotificationType::Info,
            duration_ms: 1000,
            timestamp: 0,
        });

        assert_eq!(center.get_notifications().len(), 1);
    }

    #[test]
    fn test_distributed_renderer() {
        let mut renderer = DistributedRenderer::new();
        assert_eq!(renderer.device_count(), 2);

        let result = renderer.select_device(0);
        assert!(result.is_ok());

        let device = renderer.get_active_device();
        assert!(device.is_some());
    }

    #[test]
    fn test_desktop_environment_creation() {
        let desktop = OmnisystemDesktopEnvironment::new();
        assert!(!desktop.running);
        assert_eq!(desktop.application_version, "32.0.0");
    }

    #[test]
    fn test_event_queue() {
        let mut queue = EventQueue::new();
        queue.push(Event::System("test".to_string()));
        assert_eq!(queue.len(), 1);

        let event = queue.pop();
        assert!(event.is_some());
        assert_eq!(queue.len(), 0);
    }
}
