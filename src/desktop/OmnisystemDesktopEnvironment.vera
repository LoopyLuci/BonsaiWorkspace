// ============================================================================
// CORE GRAPHICS INTEGRATION (HELIX + VERA)
// ============================================================================

pub struct GraphicsContext {
    width: u32,
    height: u32,
    dpi_scale: f32,
    backbuffer: Vec<u32>,
    clear_color: Color,
    frame_time_ms: u64,
    frame_count: u64,
    target_fps: u32,
}

pub struct Color {
    r: u8,
    g: u8,
    b: u8,
    a: u8,
}

pub struct Point {
    x: i32,
    y: i32,
}

pub struct Rect {
    x: i32,
    y: i32,
    width: u32,
    height: u32,
}

pub enum Theme {
    Dark,
    Light,
    HighContrast,
    Custom(String),
}

pub struct ThemeManager {
    current_theme: Theme,
    themes: HashMap<String, ThemeData>,
}

pub struct ThemeData {
    primary: Color,
    secondary: Color,
    accent: Color,
    background: Color,
    surface: Color,
    text: Color,
    text_secondary: Color,
    border: Color,
    shadow: Color,
    error: Color,
    warning: Color,
    success: Color,
    info: Color,
}

impl GraphicsContext {
    pub fn new(width: u32, height: u32) -> Self {
        GraphicsContext {
            width,
            height,
            dpi_scale: 1.0,
            backbuffer: vec![0; (width * height) as usize],
            clear_color: Color {
                r: 33,
                g: 33,
                b: 33,
                a: 255,
            },
            frame_time_ms: 0,
            frame_count: 0,
            target_fps: 60,
        }
    }

    pub fn set_dpi_scale(&mut self, scale: f32) {
        self.dpi_scale = scale.max(0.5).min(3.0); // Clamp 50% to 300%
    }

    pub fn clear(&mut self) {
        let color = self.color_to_argb(self.clear_color);
        for pixel in &mut self.backbuffer {
            *pixel = color;
        }
    }

    pub fn draw_filled_rectangle(&mut self, rect: Rect, color: Color) {
        let c = self.color_to_argb(color);
        for y in rect.y..(rect.y + rect.height as i32) {
            for x in rect.x..(rect.x + rect.width as i32) {
                self.set_pixel(x, y, c);
            }
        }
    }

    pub fn draw_rounded_rectangle(&mut self, rect: Rect, radius: u32, color: Color) {
        let c = self.color_to_argb(color);
        let r = radius as i32;

        // Corners
        for y in 0..radius {
            for x in 0..radius {
                let dx = x as i32;
                let dy = y as i32;
                if dx * dx + dy * dy <= r * r {
                    self.set_pixel(rect.x + dx, rect.y + dy, c);
                    self.set_pixel(rect.x + rect.width as i32 - dx - 1, rect.y + dy, c);
                    self.set_pixel(rect.x + dx, rect.y + rect.height as i32 - dy - 1, c);
                    self.set_pixel(
                        rect.x + rect.width as i32 - dx - 1,
                        rect.y + rect.height as i32 - dy - 1,
                        c,
                    );
                }
            }
        }

        // Sides
        for y in radius..(rect.height - radius) {
            for x in 0..rect.width {
                self.set_pixel(rect.x + x as i32, rect.y + y as i32, c);
            }
        }
    }

    pub fn draw_shadow(&mut self, rect: Rect, shadow_color: Color, shadow_size: u32) {
        for offset in 1..shadow_size {
            let alpha = (255 * (shadow_size - offset) / shadow_size) as u8;
            let shadow = Color {
                r: shadow_color.r,
                g: shadow_color.g,
                b: shadow_color.b,
                a: alpha,
            };

            let shadow_rect = Rect {
                x: rect.x + offset as i32,
                y: rect.y + offset as i32,
                width: rect.width,
                height: rect.height,
            };

            self.draw_filled_rectangle(shadow_rect, shadow);
        }
    }

    pub fn draw_gradient(&mut self, rect: Rect, color1: Color, color2: Color) {
        for y in rect.y..(rect.y + rect.height as i32) {
            let progress = ((y - rect.y) as f32) / (rect.height as f32);
            let r = (color1.r as f32 + (color2.r as f32 - color1.r as f32) * progress) as u8;
            let g = (color1.g as f32 + (color2.g as f32 - color1.g as f32) * progress) as u8;
            let b = (color1.b as f32 + (color2.b as f32 - color1.b as f32) * progress) as u8;

            let gradient_color = Color { r, g, b, a: 255 };
            let color = self.color_to_argb(gradient_color);

            for x in rect.x..(rect.x + rect.width as i32) {
                self.set_pixel(x, y, color);
            }
        }
    }

    pub fn draw_text(&mut self, text: &str, x: u32, y: u32, color: Color, _font_size: u16) {
        let c = self.color_to_argb(color);
        let char_width = 8u32;

        for (i, _ch) in text.chars().enumerate() {
            let char_x = (x as i32) + (i as i32 * char_width as i32);

            // Simple character rendering
            for dy in 0..12u32 {
                for dx in 0..char_width {
                    if (dy * char_width + dx) % 7 == 0 {
                        self.set_pixel(char_x + dx as i32, y as i32 + dy as i32, c);
                    }
                }
            }
        }
    }

    pub fn present(&self) -> String {
        format!(
            "[HELIX Graphics] Frame {}: {}x{} @ {} FPS, {} ms/frame",
            self.frame_count, self.width, self.height, self.target_fps, self.frame_time_ms
        )
    }

    fn set_pixel(&mut self, x: i32, y: i32, color: u32) {
        if x >= 0 && x < self.width as i32 && y >= 0 && y < self.height as i32 {
            let index = (y as u32 * self.width + x as u32) as usize;
            if index < self.backbuffer.len() {
                self.backbuffer[index] = color;
            }
        }
    }

    fn color_to_argb(&self, color: Color) -> u32 {
        ((color.a as u32) << 24)
            | ((color.r as u32) << 16)
            | ((color.g as u32) << 8)
            | (color.b as u32)
    }
}

impl ThemeManager {
    pub fn new() -> Self {
        let mut themes = HashMap::new();

        themes.insert("dark".to_string(), ThemeData {
            primary: Color { r: 52, g: 152, b: 219, a: 255 },
            secondary: Color { r: 41, g: 128, b: 185, a: 255 },
            accent: Color { r: 46, g: 204, b: 113, a: 255 },
            background: Color { r: 33, g: 33, b: 33, a: 255 },
            surface: Color { r: 44, g: 44, b: 44, a: 255 },
            text: Color { r: 236, g: 240, b: 241, a: 255 },
            text_secondary: Color { r: 189, g: 195, b: 199, a: 255 },
            border: Color { r: 52, g: 52, b: 52, a: 255 },
            shadow: Color { r: 0, g: 0, b: 0, a: 200 },
            error: Color { r: 231, g: 76, b: 60, a: 255 },
            warning: Color { r: 241, g: 196, b: 15, a: 255 },
            success: Color { r: 46, g: 204, b: 113, a: 255 },
            info: Color { r: 52, g: 152, b: 219, a: 255 },
        });

        themes.insert("light".to_string(), ThemeData {
            primary: Color { r: 41, g: 128, b: 185, a: 255 },
            secondary: Color { r: 52, g: 152, b: 219, a: 255 },
            accent: Color { r: 46, g: 204, b: 113, a: 255 },
            background: Color { r: 236, g: 240, b: 241, a: 255 },
            surface: Color { r: 255, g: 255, b: 255, a: 255 },
            text: Color { r: 44, g: 62, b: 80, a: 255 },
            text_secondary: Color { r: 127, g: 140, b: 141, a: 255 },
            border: Color { r: 189, g: 195, b: 199, a: 255 },
            shadow: Color { r: 0, g: 0, b: 0, a: 100 },
            error: Color { r: 192, g: 57, b: 43, a: 255 },
            warning: Color { r: 230, g: 126, b: 34, a: 255 },
            success: Color { r: 39, g: 174, b: 96, a: 255 },
            info: Color { r: 41, g: 128, b: 185, a: 255 },
        });

        themes.insert("high_contrast".to_string(), ThemeData {
            primary: Color { r: 0, g: 0, b: 0, a: 255 },
            secondary: Color { r: 255, g: 255, b: 255, a: 255 },
            accent: Color { r: 255, g: 255, b: 0, a: 255 },
            background: Color { r: 255, g: 255, b: 255, a: 255 },
            surface: Color { r: 240, g: 240, b: 240, a: 255 },
            text: Color { r: 0, g: 0, b: 0, a: 255 },
            text_secondary: Color { r: 51, g: 51, b: 51, a: 255 },
            border: Color { r: 0, g: 0, b: 0, a: 255 },
            shadow: Color { r: 0, g: 0, b: 0, a: 200 },
            error: Color { r: 255, g: 0, b: 0, a: 255 },
            warning: Color { r: 255, g: 165, b: 0, a: 255 },
            success: Color { r: 0, g: 128, b: 0, a: 255 },
            info: Color { r: 0, g: 0, b: 255, a: 255 },
        });

        ThemeManager {
            current_theme: Theme::Dark,
            themes,
        }
    }

    pub fn get_current_theme(&self) -> &ThemeData {
        let theme_name = match &self.current_theme {
            Theme::Dark => "dark",
            Theme::Light => "light",
            Theme::HighContrast => "high_contrast",
            Theme::Custom(name) => name,
        };

        self.themes.get(theme_name).unwrap_or_else(|| {
            self.themes.get("dark").unwrap()
        })
    }

    pub fn set_theme(&mut self, theme: Theme) {
        self.current_theme = theme;
    }
}

// ============================================================================
// WINDOW EVENT SYSTEM (TITAN Integration)
// ============================================================================

#[derive(Clone, Debug)]
pub enum WindowEvent {
    Created(String),
    Closed(String),
    Minimized(String),
    Maximized(String),
    Restored(String),
    Moved(String, u32, u32),
    Resized(String, u32, u32),
    FocusGained(String),
    FocusLost(String),
    ShowRequested(String),
    HideRequested(String),
}

#[derive(Clone, Debug)]
pub enum InputEvent {
    KeyDown(u32, String),
    KeyUp(u32, String),
    KeyChar(char),
    MouseMove(u32, u32),
    MouseDown(u32, u32, MouseButton),
    MouseUp(u32, u32, MouseButton),
    MouseWheel(i32),
}

#[derive(Clone, Debug, Copy)]
pub enum MouseButton {
    Left,
    Right,
    Middle,
    Back,
    Forward,
}

pub struct EventQueue {
    events: VecDeque<Event>,
    max_queue_size: usize,
}

#[derive(Clone, Debug)]
pub enum Event {
    Window(WindowEvent),
    Input(InputEvent),
    System(String),
}

impl EventQueue {
    pub fn new() -> Self {
        EventQueue {
            events: VecDeque::new(),
            max_queue_size: 1000,
        }
    }

    pub fn push(&mut self, event: Event) {
        if self.events.len() < self.max_queue_size {
            self.events.push_back(event);
        }
    }

    pub fn pop(&mut self) -> Option<Event> {
        self.events.pop_front()
    }

    pub fn len(&self) -> usize {
        self.events.len()
    }
}

