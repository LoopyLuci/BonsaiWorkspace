// ============================================================================
// WINDOW MANAGEMENT (VERA Components)
// ============================================================================

pub struct Window {
    pub id: String,
    pub title: String,
    pub x: u32,
    pub y: u32,
    pub width: u32,
    pub height: u32,
    pub visible: bool,
    pub minimized: bool,
    pub maximized: bool,
    pub resizable: bool,
    pub has_frame: bool,
    pub controls: Vec<UIComponent>,
}

pub struct UIComponent {
    pub id: String,
    pub component_type: ComponentType,
    pub x: u32,
    pub y: u32,
    pub width: u32,
    pub height: u32,
    pub enabled: bool,
    pub visible: bool,
    pub content: String,
    pub tooltip: String,
}

#[derive(Clone, Debug)]
pub enum ComponentType {
    Button,
    Label,
    TextBox,
    Checkbox,
    RadioButton,
    Dropdown,
    Slider,
    ProgressBar,
    ListBox,
    TabControl,
    Panel,
    Separator,
    Image,
}

pub struct WindowManager {
    windows: HashMap<String, Window>,
    active_window: Option<String>,
    screen_width: u32,
    screen_height: u32,
    z_order: Vec<String>,
}

impl WindowManager {
    pub fn new(width: u32, height: u32) -> Self {
        WindowManager {
            windows: HashMap::new(),
            active_window: None,
            screen_width: width,
            screen_height: height,
            z_order: Vec::new(),
        }
    }

    pub fn create_window(
        &mut self,
        id: String,
        title: String,
        x: u32,
        y: u32,
        width: u32,
        height: u32,
    ) {
        let window = Window {
            id: id.clone(),
            title,
            x,
            y,
            width,
            height,
            visible: true,
            minimized: false,
            maximized: false,
            resizable: true,
            has_frame: true,
            controls: Vec::new(),
        };

        self.windows.insert(id.clone(), window);
        self.z_order.push(id.clone());
        self.active_window = Some(id);
    }

    pub fn add_control(
        &mut self,
        window_id: &str,
        component_type: ComponentType,
        id: String,
        x: u32,
        y: u32,
        width: u32,
        height: u32,
        content: String,
    ) {
        if let Some(window) = self.windows.get_mut(window_id) {
            let control = UIComponent {
                id,
                component_type,
                x,
                y,
                width,
                height,
                enabled: true,
                visible: true,
                content,
                tooltip: String::new(),
            };
            window.controls.push(control);
        }
    }

    pub fn focus_window(&mut self, window_id: &str) {
        if self.windows.contains_key(window_id) {
            if let Some(pos) = self.z_order.iter().position(|x| x == window_id) {
                self.z_order.remove(pos);
            }
            self.z_order.push(window_id.to_string());
            self.active_window = Some(window_id.to_string());
        }
    }

    pub fn minimize_window(&mut self, window_id: &str) {
        if let Some(window) = self.windows.get_mut(window_id) {
            window.minimized = true;
        }
    }

    pub fn maximize_window(&mut self, window_id: &str) {
        if let Some(window) = self.windows.get_mut(window_id) {
            window.maximized = true;
            window.x = 0;
            window.y = 0;
            window.width = self.screen_width;
            window.height = self.screen_height;
        }
    }

    pub fn restore_window(&mut self, window_id: &str) {
        if let Some(window) = self.windows.get_mut(window_id) {
            window.minimized = false;
            window.maximized = false;
        }
    }

    pub fn close_window(&mut self, window_id: &str) {
        self.windows.remove(window_id);
        if let Some(pos) = self.z_order.iter().position(|x| x == window_id) {
            self.z_order.remove(pos);
        }
        if self.active_window.as_ref() == Some(&window_id.to_string()) {
            self.active_window = self.z_order.last().cloned();
        }
    }

    pub fn window_count(&self) -> usize {
        self.windows.len()
    }

    pub fn get_window(&self, window_id: &str) -> Option<&Window> {
        self.windows.get(window_id)
    }
}

// ============================================================================
// LAYOUT & RENDERING OPTIMIZATION (SYLVA Integration)
// ============================================================================

pub struct LayoutEngine {
    layout_type: LayoutType,
}

#[derive(Clone, Copy)]
pub enum LayoutType {
    Box,      // Simple box layout
    Grid,     // Grid layout
    Flex,     // Flexible layout
    Absolute, // Absolute positioning
}

impl LayoutEngine {
    pub fn new(layout_type: LayoutType) -> Self {
        LayoutEngine { layout_type }
    }

    pub fn compute_layout(
        &self,
        available_width: u32,
        available_height: u32,
        components: &[UIComponent],
    ) -> Vec<Rect> {
        match self.layout_type {
            LayoutType::Box => self.box_layout(available_width, available_height, components),
            LayoutType::Grid => self.grid_layout(available_width, available_height, components),
            LayoutType::Flex => self.flex_layout(available_width, available_height, components),
            LayoutType::Absolute => {
                components
                    .iter()
                    .map(|c| Rect {
                        x: c.x as i32,
                        y: c.y as i32,
                        width: c.width,
                        height: c.height,
                    })
                    .collect()
            }
        }
    }

    fn box_layout(&self, width: u32, _height: u32, components: &[UIComponent]) -> Vec<Rect> {
        let mut rects = Vec::new();
        let item_width = width / components.len().max(1) as u32;
        let padding = 4u32;

        for (i, component) in components.iter().enumerate() {
            rects.push(Rect {
                x: (i as u32 * item_width + padding) as i32,
                y: padding as i32,
                width: item_width - padding * 2,
                height: component.height,
            });
        }

        rects
    }

    fn grid_layout(&self, width: u32, height: u32, components: &[UIComponent]) -> Vec<Rect> {
        let mut rects = Vec::new();
        let cols = (components.len() as f32).sqrt().ceil() as usize;
        let rows = (components.len() as f32 / cols as f32).ceil() as usize;

        let cell_width = width / cols as u32;
        let cell_height = height / rows as u32;
        let padding = 4u32;

        for (i, _component) in components.iter().enumerate() {
            let row = i / cols;
            let col = i % cols;

            rects.push(Rect {
                x: (col as u32 * cell_width + padding) as i32,
                y: (row as u32 * cell_height + padding) as i32,
                width: cell_width - padding * 2,
                height: cell_height - padding * 2,
            });
        }

        rects
    }

    fn flex_layout(&self, _width: u32, _height: u32, components: &[UIComponent]) -> Vec<Rect> {
        // Simplified flex layout
        components
            .iter()
            .enumerate()
            .map(|(i, c)| Rect {
                x: 10,
                y: (i as u32 * c.height + i as u32 * 10 + 10) as i32,
                width: c.width,
                height: c.height,
            })
            .collect()
    }
}

// ============================================================================
// NOTIFICATION SYSTEM
// ============================================================================

pub struct Notification {
    pub title: String,
    pub message: String,
    pub notification_type: NotificationType,
    pub duration_ms: u32,
    pub timestamp: u64,
}

#[derive(Clone, Copy)]
pub enum NotificationType {
    Info,
    Success,
    Warning,
    Error,
}

pub struct NotificationCenter {
    notifications: VecDeque<Notification>,
    max_notifications: usize,
}

impl NotificationCenter {
    pub fn new() -> Self {
        NotificationCenter {
            notifications: VecDeque::new(),
            max_notifications: 10,
        }
    }

    pub fn show_notification(&mut self, notification: Notification) {
        if self.notifications.len() >= self.max_notifications {
            self.notifications.pop_front();
        }
        self.notifications.push_back(notification);
    }

    pub fn get_notifications(&self) -> Vec<&Notification> {
        self.notifications.iter().collect()
    }

    pub fn clear_expired(&mut self, current_time: u64) {
        self.notifications
            .retain(|n| (current_time - n.timestamp) < n.duration_ms as u64);
    }
}

