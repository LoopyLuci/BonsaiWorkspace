    pub fn render(&mut self) -> Result<(), String> {
        if !self.running {
            return Ok(());
        }

        // Clear graphics buffer
        self.graphics.clear();

        let theme = self.theme_manager.get_current_theme();

        // Draw background
        self.graphics.draw_filled_rectangle(
            Rect {
                x: 0,
                y: 0,
                width: 1400,
                height: 900,
            },
            theme.background,
        );

        // Draw main window
        if let Some(main_window) = self.window_manager.get_window("main") {
            self.render_window(main_window, theme)?;
        }

        // Render notifications
        self.render_notifications(theme);

        // Present frame
        let frame_info = self.graphics.present();
        println!("{}", frame_info);

        Ok(())
    }

    fn render_window(&self, window: &Window, theme: &ThemeData) -> Result<(), String> {
        // Draw window background
        self.graphics.draw_filled_rectangle(
            Rect {
                x: window.x as i32,
                y: window.y as i32,
                width: window.width,
                height: window.height,
            },
            theme.surface,
        );

        // Draw window frame
        if window.has_frame {
            // Draw header
            self.graphics.draw_filled_rectangle(
                Rect {
                    x: window.x as i32,
                    y: window.y as i32,
                    width: window.width,
                    height: 40,
                },
                theme.primary,
            );

            // Draw title
            self.graphics.draw_text(
                &window.title,
                window.x + 10,
                window.y + 8,
                theme.text,
                14,
            );
        }

        // Draw controls
        for control in &window.controls {
            if control.visible {
                self.render_component(control, theme);
            }
        }

        Ok(())
    }

    fn render_component(&self, component: &UIComponent, theme: &ThemeData) {
        let rect = Rect {
            x: component.x as i32,
            y: component.y as i32,
            width: component.width,
            height: component.height,
        };

        match component.component_type {
            ComponentType::Button => {
                self.graphics
                    .draw_filled_rectangle(rect, theme.accent);
                self.graphics.draw_text(
                    &component.content,
                    component.x + 5,
                    component.y + 5,
                    theme.text,
                    12,
                );
            }
            ComponentType::Label => {
                self.graphics.draw_text(
                    &component.content,
                    component.x,
                    component.y,
                    theme.text,
                    11,
                );
            }
            ComponentType::Panel => {
                self.graphics
                    .draw_filled_rectangle(rect, theme.surface);
                self.graphics.draw_text(
                    &component.content,
                    component.x + 10,
                    component.y + 10,
                    theme.text_secondary,
                    10,
                );
            }
            ComponentType::TabControl => {
                // Draw tab bar
                let tabs: Vec<&str> = component.content.split('|').map(|s| s.trim()).collect();
                let mut x_offset = component.x;

                for (idx, tab) in tabs.iter().enumerate() {
                    let tab_rect = Rect {
                        x: x_offset as i32,
                        y: component.y as i32,
                        width: 120,
                        height: 35,
                    };

                    if idx == 0 {
                        self.graphics.draw_filled_rectangle(tab_rect, theme.accent);
                    } else {
                        self.graphics.draw_filled_rectangle(tab_rect, theme.secondary);
                    }

                    self.graphics.draw_text(
                        tab,
                        x_offset + 10,
                        component.y + 10,
                        theme.text,
                        10,
                    );

                    x_offset += 125;
                }
            }
            _ => {
                self.graphics
                    .draw_filled_rectangle(rect, theme.surface);
            }
        }
    }

    fn render_notifications(&self, theme: &ThemeData) {
        let notifications = self.notification_center.get_notifications();

        for (idx, notif) in notifications.iter().enumerate() {
            let y = 50 + (idx as u32 * 70);
            let rect = Rect {
                x: 1200,
                y: y as i32,
                width: 180,
                height: 60,
            };

            let color = match notif.notification_type {
                NotificationType::Info => theme.info,
                NotificationType::Success => theme.success,
                NotificationType::Warning => theme.warning,
                NotificationType::Error => theme.error,
            };

            self.graphics.draw_filled_rectangle(rect, color);
            self.graphics.draw_text(
                &notif.title,
                1210,
                y + 5,
                theme.text,
                10,
            );
            self.graphics.draw_text(
                &notif.message,
                1210,
                y + 20,
                theme.text,
                9,
            );
        }
    }

    pub fn run(&mut self) -> Result<(), String> {
        self.initialize()?;
        self.render_system_overview();
        self.render()?;
        Ok(())
    }

    pub fn process_event(&mut self, event: Event) -> Result<(), String> {
        // Verify event with AXIOM
        SecurityVerifier::verify_event_authenticity(&event)?;

        match event {
            Event::Window(window_event) => {
                self.handle_window_event(window_event)?;
            }
            Event::Input(input_event) => {
                self.handle_input_event(input_event)?;
            }
            Event::System(msg) => {
                println!("[System] {}", msg);
            }
        }

        Ok(())
    }

    fn handle_window_event(&mut self, event: WindowEvent) -> Result<(), String> {
        match event {
            WindowEvent::Created(window_id) => {
                println!("[Window Manager] Window created: {}", window_id);
            }
            WindowEvent::Closed(window_id) => {
                self.window_manager.close_window(&window_id);
                println!("[Window Manager] Window closed: {}", window_id);
            }
            WindowEvent::FocusGained(window_id) => {
                self.window_manager.focus_window(&window_id);
                println!("[Window Manager] Focus gained: {}", window_id);
            }
            WindowEvent::Minimized(window_id) => {
                self.window_manager.minimize_window(&window_id);
                println!("[Window Manager] Window minimized: {}", window_id);
            }
            WindowEvent::Maximized(window_id) => {
                self.window_manager.maximize_window(&window_id);
                println!("[Window Manager] Window maximized: {}", window_id);
            }
            _ => {}
        }

        Ok(())
    }

    fn handle_input_event(&mut self, event: InputEvent) -> Result<(), String> {
        match event {
            InputEvent::KeyDown(key_code, key_name) => {
                println!("[Input] Key down: {} ({})", key_name, key_code);
            }
            InputEvent::MouseDown(x, y, button) => {
                println!("[Input] Mouse down at ({}, {}): {:?}", x, y, button);
            }
            InputEvent::MouseMove(x, y) => {
                // println!("[Input] Mouse move: ({}, {})", x, y);
            }
            _ => {}
        }

        Ok(())
    }

