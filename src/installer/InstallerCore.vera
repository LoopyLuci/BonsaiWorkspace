// OMNISYSTEM INSTALLER
// 8-Step Installation Wizard with Component Selection
// VERA Language Implementation

import "asset_manager" as assets;
import "event_system" as events;

pub enum InstallerStep {
    WELCOME,
    LICENSE,
    LOCATION,
    COMPONENTS,
    AUTHENTICATION,
    SETTINGS,
    READY,
    INSTALLING,
}

pub struct InstallerState {
    pub current_step: InstallerStep,
    pub install_location: String,
    pub selected_components: Vec<String>,
    pub enrollment_complete: bool,
}

pub fn render_installer() -> Component {
    Container {
        width: 600,
        height: 700,
        background_color: assets::COLOR_BACKGROUND,
        padding: 30,
        border_radius: 8,

        children: vec![
            // Header
            Container {
                margin_bottom: 30,
                children: vec![
                    Text {
                        content: "Omnisystem Installer".to_string(),
                        font_size: 28,
                        font_weight: "bold".to_string(),
                    },
                    Text {
                        content: "Enterprise Operating System v2.0".to_string(),
                        font_size: 14,
                        color: assets::COLOR_TEXT_SECONDARY,
                        margin_top: 5,
                    },
                ],
            },

            // Progress Bar
            ProgressBar {
                current: 1,
                total: 8,
                margin_bottom: 30,
            },

            // Step Content (Welcome)
            render_welcome_step(),

            Divider { margin_top: 30, margin_bottom: 30 },

            // Navigation Buttons
            HorizontalLayout {
                spacing: 10,
                children: vec![
                    Button {
                        label: "Cancel".to_string(),
                        style: "secondary".to_string(),
                        on_click: || events::EVENT_SYSTEM.fire_event("installer:cancel", json!({})),
                    },
                    Button {
                        label: "Next >".to_string(),
                        style: "primary".to_string(),
                        on_click: || events::EVENT_SYSTEM.fire_event("installer:next", json!({})),
                    },
                ],
            },
        ],
    }
}

fn render_welcome_step() -> Component {
    Container {
        children: vec![
            Text {
                content: "Welcome to Omnisystem".to_string(),
                font_size: 20,
                font_weight: "600".to_string(),
                margin_bottom: 15,
            },
            Text {
                content: "This wizard will guide you through the installation process.".to_string(),
                font_size: 14,
                margin_bottom: 10,
            },
            Text {
                content: "\n✓ Enterprise-grade authentication\n✓ Passwordless FIDO2 security\n✓ Real-time risk assessment\n✓ 35 integrated systems".to_string(),
                font_size: 13,
                color: assets::COLOR_TEXT_SECONDARY,
                line_height: 1.8,
            },
        ],
    }
}

pub fn render_components_step() -> Component {
    Container {
        children: vec![
            Text {
                content: "Select Components to Install".to_string(),
                font_size: 20,
                font_weight: "600".to_string(),
                margin_bottom: 20,
            },

            CheckboxGroup {
                items: vec![
                    CheckboxItem { label: "Core System (Required)".to_string(), checked: true, disabled: true },
                    CheckboxItem { label: "Authentication System".to_string(), checked: true, disabled: false },
                    CheckboxItem { label: "Control Panel".to_string(), checked: true, disabled: false },
                    CheckboxItem { label: "Notification System".to_string(), checked: true, disabled: false },
                    CheckboxItem { label: "Monitoring Dashboard".to_string(), checked: true, disabled: false },
                    CheckboxItem { label: "Theme Editor".to_string(), checked: true, disabled: false },
                    CheckboxItem { label: "Plugin Marketplace".to_string(), checked: false, disabled: false },
                    CheckboxItem { label: "Debugger Integration".to_string(), checked: false, disabled: false },
                ],
            },

            Text {
                content: "Total Size: 2.5 GB".to_string(),
                font_size: 12,
                color: assets::COLOR_TEXT_SECONDARY,
                margin_top: 20,
            },
        ],
    }
}

pub fn render_authentication_step() -> Component {
    Container {
        children: vec![
            Text {
                content: "Authentication Setup".to_string(),
                font_size: 20,
                font_weight: "600".to_string(),
                margin_bottom: 20,
            },

            Text {
                content: "Enroll your authentication credentials:".to_string(),
                font_size: 14,
                margin_bottom: 15,
            },

            CheckboxGroup {
                items: vec![
                    CheckboxItem { label: "FIDO2 Passkey (Recommended)".to_string(), checked: true, disabled: false },
                    CheckboxItem { label: "Biometric (Face or Fingerprint)".to_string(), checked: true, disabled: false },
                    CheckboxItem { label: "Recovery Key (Backup)".to_string(), checked: false, disabled: false },
                ],
            },

            Text {
                content: "\nYou will be prompted to enroll each selected authentication method.".to_string(),
                font_size: 12,
                color: assets::COLOR_TEXT_SECONDARY,
                margin_top: 20,
            },
        ],
    }
}

pub fn render_ready_step() -> Component {
    Container {
        children: vec![
            Text {
                content: "Ready to Install".to_string(),
                font_size: 20,
                font_weight: "600".to_string(),
                margin_bottom: 20,
            },

            Text {
                content: "Installation Summary:".to_string(),
                font_size: 14,
                font_weight: "600".to_string(),
                margin_bottom: 15,
            },

            Text {
                content: "Location: C:\\Program Files\\Omnisystem\nComponents: 8 selected\nSize: 2.5 GB\nAuthentication: FIDO2 + Biometric + Recovery".to_string(),
                font_size: 13,
                margin_bottom: 20,
            },

            Button {
                label: "< Back".to_string(),
                style: "secondary".to_string(),
                on_click: || events::EVENT_SYSTEM.fire_event("installer:back", json!({})),
                width: Some("100%".to_string()),
                margin_bottom: Some(10),
            },

            Button {
                label: "Install Now".to_string(),
                style: "primary".to_string(),
                on_click: || events::EVENT_SYSTEM.fire_event("installer:install_start", json!({})),
                width: Some("100%".to_string()),
            },
        ],
    }
}

pub fn render_installing_step(progress: u32) -> Component {
    Container {
        children: vec![
            Text {
                content: "Installing Omnisystem...".to_string(),
                font_size: 20,
                font_weight: "600".to_string(),
                margin_bottom: 20,
            },

            ProgressBar {
                current: progress,
                total: 100,
                margin_bottom: 15,
            },

            Text {
                content: format!("{}% complete", progress),
                font_size: 14,
                color: assets::COLOR_TEXT_SECONDARY,
            },
        ],
    }
}
