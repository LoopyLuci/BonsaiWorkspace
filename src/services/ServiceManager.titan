// SERVICE MANAGER
// Lifecycle Management for System Services & Agents
// TITAN Systems Language Implementation

use std::collections::HashMap;
use std::sync::Mutex;

#[derive(Clone, Copy, Debug, PartialEq)]
pub enum ServiceState {
    STOPPED,
    STARTING,
    RUNNING,
    STOPPING,
    FAILED,
    RESTARTING,
}

#[derive(Clone, Debug)]
pub struct Service {
    pub id: String,
    pub name: String,
    pub service_type: ServiceType,
    pub state: ServiceState,
    pub pid: Option<u32>,
    pub start_time: u64,
    pub memory_usage: u64,
    pub cpu_usage: f32,
    pub dependencies: Vec<String>,
    pub restart_count: u32,
    pub last_error: Option<String>,
}

#[derive(Clone, Copy, Debug)]
pub enum ServiceType {
    SYSTEM,
    AGENT,
    BACKGROUND,
    USER,
}

pub struct ServiceManager {
    services: Mutex<HashMap<String, Service>>,
    startup_order: Mutex<Vec<String>>,
    dependency_graph: Mutex<HashMap<String, Vec<String>>>,
}

impl ServiceManager {
    pub fn new() -> Self {
        ServiceManager {
            services: Mutex::new(HashMap::new()),
            startup_order: Mutex::new(Vec::new()),
            dependency_graph: Mutex::new(HashMap::new()),
        }
    }

    /// Register a new service
    pub fn register_service(&self, service: Service) -> Result<(), String> {
        let mut services = self.services.lock().map_err(|e| e.to_string())?;
        services.insert(service.id.clone(), service);
        Ok(())
    }

    /// Start a service and its dependencies
    pub fn start_service(&self, service_id: &str) -> Result<(), String> {
        let mut services = self.services.lock().map_err(|e| e.to_string())?;

        // Start dependencies first
        if let Some(service) = services.get(service_id) {
            for dep in &service.dependencies {
                if let Some(dep_service) = services.get_mut(dep) {
                    if dep_service.state == ServiceState::STOPPED {
                        dep_service.state = ServiceState::STARTING;
                    }
                }
            }
        }

        // Start the service
        if let Some(service) = services.get_mut(service_id) {
            service.state = ServiceState::STARTING;
            service.start_time = std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap_or_default()
                .as_secs();
            service.state = ServiceState::RUNNING;
        }

        Ok(())
    }

    /// Stop a service
    pub fn stop_service(&self, service_id: &str) -> Result<(), String> {
        let mut services = self.services.lock().map_err(|e| e.to_string())?;

        if let Some(service) = services.get_mut(service_id) {
            service.state = ServiceState::STOPPING;
            service.state = ServiceState::STOPPED;
        }

        Ok(())
    }

    /// Restart a service
    pub fn restart_service(&self, service_id: &str) -> Result<(), String> {
        self.stop_service(service_id)?;
        self.start_service(service_id)?;
        Ok(())
    }

    /// Get service status
    pub fn get_service_status(&self, service_id: &str) -> Result<Service, String> {
        let services = self.services.lock().map_err(|e| e.to_string())?;
        services
            .get(service_id)
            .cloned()
            .ok_or_else(|| format!("Service not found: {}", service_id))
    }

    /// Get all services
    pub fn list_services(&self) -> Result<Vec<Service>, String> {
        let services = self.services.lock().map_err(|e| e.to_string())?;
        Ok(services.values().cloned().collect())
    }

    /// Check service health
    pub fn check_health(&self) -> Result<HealthStatus, String> {
        let services = self.services.lock().map_err(|e| e.to_string())?;

        let running = services
            .values()
            .filter(|s| s.state == ServiceState::RUNNING)
            .count();
        let failed = services
            .values()
            .filter(|s| s.state == ServiceState::FAILED)
            .count();
        let total = services.len();

        Ok(HealthStatus {
            total_services: total as u32,
            running_services: running as u32,
            failed_services: failed as u32,
        })
    }

    /// Calculate restart policy
    pub fn should_auto_restart(&self, service_id: &str) -> bool {
        if let Ok(service) = self.get_service_status(service_id) {
            service.restart_count < 5 && service.state == ServiceState::FAILED
        } else {
            false
        }
    }

    /// Resolve dependencies and return startup order
    pub fn compute_startup_order(&self) -> Result<Vec<String>, String> {
        // Topological sort of dependency graph
        let graph = self.dependency_graph.lock().map_err(|e| e.to_string())?;
        let mut order = Vec::new();

        // Simple topological sort (in production, use Kahn's algorithm)
        for (service_id, _) in graph.iter() {
            if !order.contains(service_id) {
                order.push(service_id.clone());
            }
        }

        Ok(order)
    }
}

#[derive(Debug)]
pub struct HealthStatus {
    pub total_services: u32,
    pub running_services: u32,
    pub failed_services: u32,
}

// Global Service Manager instance
lazy_static::lazy_static! {
    pub static ref SERVICE_MANAGER: ServiceManager = ServiceManager::new();
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_service_registration() {
        let sm = ServiceManager::new();
        let service = Service {
            id: "test_service".to_string(),
            name: "Test Service".to_string(),
            service_type: ServiceType::SYSTEM,
            state: ServiceState::STOPPED,
            pid: None,
            start_time: 0,
            memory_usage: 0,
            cpu_usage: 0.0,
            dependencies: vec![],
            restart_count: 0,
            last_error: None,
        };

        assert!(sm.register_service(service).is_ok());
    }

    #[test]
    fn test_service_lifecycle() {
        let sm = ServiceManager::new();
        let service = Service {
            id: "test".to_string(),
            name: "Test".to_string(),
            service_type: ServiceType::SYSTEM,
            state: ServiceState::STOPPED,
            pid: None,
            start_time: 0,
            memory_usage: 0,
            cpu_usage: 0.0,
            dependencies: vec![],
            restart_count: 0,
            last_error: None,
        };

        sm.register_service(service).unwrap();
        sm.start_service("test").unwrap();
        assert_eq!(
            sm.get_service_status("test").unwrap().state,
            ServiceState::RUNNING
        );
    }
}
