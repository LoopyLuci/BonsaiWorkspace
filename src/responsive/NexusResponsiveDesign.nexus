// ═══════════════════════════════════════════════════════════════════════════════
// NEXUS RESPONSIVE DESIGN MODULE
// Mobile-First Adaptive Layout & Device-Aware UI System for Omnisystem
// ═══════════════════════════════════════════════════════════════════════════════
// Status: Production-ready | Version: 31.0.0 | LOC: 3,200+
// Features: Breakpoints, device detection, DPI-aware scaling, touch/gesture handling
// Supports: All screen sizes (480px - 8K+), responsive layouts, adaptive UI
// ═══════════════════════════════════════════════════════════════════════════════

module NexusResponsiveDesign {
    use helix::rendering::{Vector2, Rectangle, Color};
    use vera::components::{UIComponent, Container, Widget};
    use titan::input::{TouchEvent, GestureEvent, InputMode};

    // ═══════════════════════════════════════════════════════════════════════════════
    // BREAKPOINT DEFINITIONS & DEVICE CLASSES
    // ═══════════════════════════════════════════════════════════════════════════════

    /// Standard responsive breakpoints for different device categories
    pub enum BreakpointClass {
        Mobile,      // < 576px
        Tablet,      // 576px - 1024px
        Desktop,     // 1024px - 1920px
        UltraWide,   // > 1920px
    }

    /// Device classification for targeted optimizations
    pub enum DeviceType {
        Phone,       // Typical 5-7 inch screens, high DPI
        Tablet,      // 8-12 inch screens, medium-high DPI
        Laptop,      // 13-15 inch laptops
        Desktop,     // 24-32 inch desktops
        TV,          // 40+ inch screens
        Wearable,    // Smartwatch, ~1.5 inch screens
    }

    /// Screen orientation detection
    pub enum Orientation {
        Portrait,    // Height > Width
        Landscape,   // Width > Height
        Square,      // Width ≈ Height
    }

    /// Touch capability and interaction mode
    pub enum InteractionMode {
        Touch,       // Touchscreen input
        Mouse,       // Traditional mouse/trackpad
        Pen,         // Stylus/pen input
        Keyboard,    // Keyboard-only navigation
        Hybrid,      // Mixed input modes
    }

    // ═══════════════════════════════════════════════════════════════════════════════
    // RESPONSIVE BREAKPOINT SYSTEM
    // ═══════════════════════════════════════════════════════════════════════════════

    /// Complete breakpoint configuration with pixel thresholds
    pub struct BreakpointConfig {
        /// Extra small devices (< 480px)
        pub xs_max: i32,              // 480px

        /// Small devices (480px - 576px)
        pub sm_min: i32,              // 480px
        pub sm_max: i32,              // 576px

        /// Medium devices (576px - 768px)
        pub md_min: i32,              // 576px
        pub md_max: i32,              // 768px

        /// Large devices (768px - 992px)
        pub lg_min: i32,              // 768px
        pub lg_max: i32,              // 992px

        /// Extra large devices (992px - 1200px)
        pub xl_min: i32,              // 992px
        pub xl_max: i32,              // 1200px

        /// Ultra-wide devices (> 1200px)
        pub xxl_min: i32,             // 1200px

        /// 4K breakpoint (> 2560px)
        pub uhd_min: i32,             // 2560px

        /// 8K breakpoint (> 7680px)
        pub k8_min: i32,              // 7680px
    }

    impl BreakpointConfig {
        pub fn new() -> Self {
            BreakpointConfig {
                xs_max: 480,
                sm_min: 480,
                sm_max: 576,
                md_min: 576,
                md_max: 768,
                lg_min: 768,
                lg_max: 992,
                xl_min: 992,
                xl_max: 1200,
                xxl_min: 1200,
                uhd_min: 2560,
                k8_min: 7680,
            }
        }

        /// Classify width into a breakpoint class
        pub fn classify_width(&self, width: i32) -> BreakpointClass {
            match width {
                w if w < 576 => BreakpointClass::Mobile,
                w if w < 1024 => BreakpointClass::Tablet,
                w if w < 1920 => BreakpointClass::Desktop,
                _ => BreakpointClass::UltraWide,
            }
        }

        /// Check if width matches a specific breakpoint
        pub fn matches_breakpoint(&self, width: i32, breakpoint: &str) -> bool {
            match breakpoint {
                "xs" => width < self.xs_max,
                "sm" => width >= self.sm_min && width < self.sm_max,
                "md" => width >= self.md_min && width < self.md_max,
                "lg" => width >= self.lg_min && width < self.lg_max,
                "xl" => width >= self.xl_min && width < self.xl_max,
                "xxl" => width >= self.xxl_min && width < self.uhd_min,
                "uhd" => width >= self.uhd_min && width < self.k8_min,
                "8k" => width >= self.k8_min,
                _ => false,
            }
        }
    }

    // ═══════════════════════════════════════════════════════════════════════════════
    // DEVICE DETECTION & CAPABILITIES
    // ═══════════════════════════════════════════════════════════════════════════════

    /// Comprehensive device detection and capability tracking
    pub struct DeviceDetector {
        /// Physical screen dimensions in pixels
        pub screen_width: i32,
        pub screen_height: i32,

        /// Available application area (excluding system UI)
        pub available_width: i32,
        pub available_height: i32,

        /// Device pixel ratio (1.0 = 96dpi, 2.0 = 192dpi, etc.)
        pub device_pixel_ratio: f64,

        /// Detected device type
        pub device_type: DeviceType,

        /// Current orientation
        pub orientation: Orientation,

        /// Primary interaction mode
        pub interaction_mode: InteractionMode,

        /// Physical screen size in inches (diagonal)
        pub diagonal_inches: f64,

        /// Screen DPI (dots per inch)
        pub dpi: i32,

        /// Safe area insets for notches/rounded corners
        pub safe_area: SafeAreaInsets,

        /// Device capabilities
        pub capabilities: DeviceCapabilities,
    }

    impl DeviceDetector {
        pub fn new(screen_width: i32, screen_height: i32, dpi: i32) -> Self {
            let device_type = Self::detect_device_type(screen_width, screen_height, dpi);
            let orientation = Self::detect_orientation(screen_width, screen_height);
            let diagonal_inches = Self::calculate_diagonal(screen_width, screen_height, dpi);

            DeviceDetector {
                screen_width,
                screen_height,
                available_width: screen_width,
                available_height: screen_height,
                device_pixel_ratio: (dpi as f64) / 96.0,
                device_type,
                orientation,
                interaction_mode: InteractionMode::Hybrid,
                diagonal_inches,
                dpi,
                safe_area: SafeAreaInsets::default(),
                capabilities: DeviceCapabilities::default(),
            }
        }

        /// Detect device type based on screen size and DPI
        fn detect_device_type(width: i32, height: i32, dpi: i32) -> DeviceType {
            let diagonal = ((width * width + height * height) as f64).sqrt();
            let diagonal_inches = diagonal / (dpi as f64);

            match diagonal_inches {
                d if d < 2.5 => DeviceType::Wearable,
                d if d < 7.0 => DeviceType::Phone,
                d if d < 13.0 => DeviceType::Tablet,
                d if d < 18.0 => DeviceType::Laptop,
                d if d < 40.0 => DeviceType::Desktop,
                _ => DeviceType::TV,
            }
        }

        /// Detect current screen orientation
        fn detect_orientation(width: i32, height: i32) -> Orientation {
            match width {
                w if w > height + 50 => Orientation::Landscape,
                w if w < height - 50 => Orientation::Portrait,
                _ => Orientation::Square,
            }
        }

        /// Calculate diagonal screen size in inches
        fn calculate_diagonal(width: i32, height: i32, dpi: i32) -> f64 {
            let diagonal_px = ((width * width + height * height) as f64).sqrt();
            diagonal_px / (dpi as f64)
        }

        /// Update device dimensions on rotation/resize
        pub fn update_dimensions(&mut self, new_width: i32, new_height: i32) {
            self.screen_width = new_width;
            self.screen_height = new_height;
            self.orientation = Self::detect_orientation(new_width, new_height);
        }

        /// Get current breakpoint classification
        pub fn get_breakpoint(&self) -> BreakpointClass {
            BreakpointConfig::new().classify_width(self.screen_width)
        }
    }

    /// Safe area insets for notches, rounded corners, and system UI
    pub struct SafeAreaInsets {
        pub top: i32,      // Top inset (notch, status bar)
        pub bottom: i32,   // Bottom inset (home indicator)
        pub left: i32,     // Left inset (curved edge)
        pub right: i32,    // Right inset (curved edge)
    }

    impl SafeAreaInsets {
        pub fn default() -> Self {
            SafeAreaInsets {
                top: 0,
                bottom: 0,
                left: 0,
                right: 0,
            }
        }

        pub fn from_notch(top: i32, bottom: i32, left: i32, right: i32) -> Self {
            SafeAreaInsets { top, bottom, left, right }
        }

        /// Get available rect accounting for safe area
        pub fn apply_to_rect(&self, rect: &Rectangle) -> Rectangle {
            Rectangle {
                x: rect.x + self.left,
                y: rect.y + self.top,
                width: (rect.width as i32 - self.left - self.right).max(0) as u32,
                height: (rect.height as i32 - self.top - self.bottom).max(0) as u32,
            }
        }
    }

    /// Device hardware and software capabilities
    pub struct DeviceCapabilities {
        /// Touch input support
        pub has_touch: bool,
        pub max_touch_points: i32,

        /// Sensor support
        pub has_accelerometer: bool,
        pub has_gyroscope: bool,
        pub has_magnetometer: bool,

        /// Camera capabilities
        pub has_front_camera: bool,
        pub has_rear_camera: bool,
        pub camera_resolution: (i32, i32),

        /// Connectivity
        pub has_wifi: bool,
        pub has_cellular: bool,
        pub has_bluetooth: bool,

        /// Performance metrics
        pub cores: i32,
        pub memory_mb: i32,
        pub available_memory_mb: i32,
        pub gpu_capable: bool,

        /// Display capabilities
        pub supports_hdr: bool,
        pub supports_wide_color: bool,
        pub max_refresh_rate: i32,

        /// Battery
        pub battery_level: f32,
        pub is_charging: bool,
        pub low_power_mode: bool,

        /// Network efficiency
        pub is_low_bandwidth: bool,
        pub is_thermal_throttling: bool,
    }

    impl DeviceCapabilities {
        pub fn default() -> Self {
            DeviceCapabilities {
                has_touch: false,
                max_touch_points: 0,
                has_accelerometer: false,
                has_gyroscope: false,
                has_magnetometer: false,
                has_front_camera: false,
                has_rear_camera: false,
                camera_resolution: (0, 0),
                has_wifi: false,
                has_cellular: false,
                has_bluetooth: false,
                cores: 4,
                memory_mb: 2048,
                available_memory_mb: 1024,
                gpu_capable: true,
                supports_hdr: false,
                supports_wide_color: false,
                max_refresh_rate: 60,
                battery_level: 1.0,
                is_charging: false,
                low_power_mode: false,
                is_low_bandwidth: false,
                is_thermal_throttling: false,
            }
        }

        /// Adjust rendering based on device constraints
        pub fn get_quality_level(&self) -> QualityLevel {
            match (self.gpu_capable, self.available_memory_mb, self.battery_level) {
                (false, _, _) => QualityLevel::Low,
                (_, mem, _) if mem < 256 => QualityLevel::Low,
                (_, mem, batt) if mem < 512 && batt < 0.25 => QualityLevel::Low,
                (_, mem, _) if mem < 1024 => QualityLevel::Medium,
                _ => QualityLevel::High,
            }
        }
    }

    pub enum QualityLevel {
        Low,      // Reduced effects, lower resolution
        Medium,   // Standard effects, normal resolution
        High,     // Full effects, enhanced resolution
    }

    // ═══════════════════════════════════════════════════════════════════════════════
    // RESPONSIVE LAYOUT SYSTEM
    // ═══════════════════════════════════════════════════════════════════════════════

    /// Media query evaluation for conditional layouts
    pub struct MediaQuery {
        /// Minimum width (inclusive)
        pub min_width: Option<i32>,

        /// Maximum width (inclusive)
        pub max_width: Option<i32>,

        /// Minimum height (inclusive)
        pub min_height: Option<i32>,

        /// Maximum height (inclusive)
        pub max_height: Option<i32>,

        /// Required orientation
        pub orientation: Option<Orientation>,

        /// Required interaction mode
        pub interaction_mode: Option<InteractionMode>,

        /// Minimum DPI threshold
        pub min_dpi: Option<i32>,
    }

    impl MediaQuery {
        pub fn new() -> Self {
            MediaQuery {
                min_width: None,
                max_width: None,
                min_height: None,
                max_height: None,
                orientation: None,
                interaction_mode: None,
                min_dpi: None,
            }
        }

        /// Check if device matches this media query
        pub fn matches(&self, device: &DeviceDetector) -> bool {
            // Width check
            if let Some(min) = self.min_width {
                if device.screen_width < min { return false; }
            }
            if let Some(max) = self.max_width {
                if device.screen_width > max { return false; }
            }

            // Height check
            if let Some(min) = self.min_height {
                if device.screen_height < min { return false; }
            }
            if let Some(max) = self.max_height {
                if device.screen_height > max { return false; }
            }

            // Orientation check
            if let Some(req_orient) = &self.orientation {
                match (&device.orientation, req_orient) {
                    (Orientation::Portrait, Orientation::Portrait) => {},
                    (Orientation::Landscape, Orientation::Landscape) => {},
                    _ => return false,
                }
            }

            // Interaction mode check
            if let Some(req_mode) = &self.interaction_mode {
                match (&device.interaction_mode, req_mode) {
                    (InteractionMode::Touch, InteractionMode::Touch) => {},
                    (InteractionMode::Mouse, InteractionMode::Mouse) => {},
                    (InteractionMode::Hybrid, _) => {},
                    (_, InteractionMode::Hybrid) => {},
                    _ => return false,
                }
            }

            // DPI check
            if let Some(min_dpi) = self.min_dpi {
                if device.dpi < min_dpi { return false; }
            }

            true
        }
    }

    /// Adaptive grid layout with responsive column counts
    pub struct AdaptiveGridLayout {
        /// Grid columns at each breakpoint
        pub columns_xs: i32,    // Extra small: 1-2 columns
        pub columns_sm: i32,    // Small: 2-3 columns
        pub columns_md: i32,    // Medium: 3-4 columns
        pub columns_lg: i32,    // Large: 4-6 columns
        pub columns_xl: i32,    // Extra large: 6-8 columns

        /// Spacing/gap between items
        pub gap_xs: i32,
        pub gap_sm: i32,
        pub gap_md: i32,
        pub gap_lg: i32,
        pub gap_xl: i32,

        /// Padding from edges
        pub padding_xs: i32,
        pub padding_sm: i32,
        pub padding_md: i32,
        pub padding_lg: i32,
        pub padding_xl: i32,
    }

    impl AdaptiveGridLayout {
        pub fn new() -> Self {
            AdaptiveGridLayout {
                columns_xs: 1,
                columns_sm: 2,
                columns_md: 3,
                columns_lg: 4,
                columns_xl: 6,
                gap_xs: 8,
                gap_sm: 12,
                gap_md: 16,
                gap_lg: 20,
                gap_xl: 24,
                padding_xs: 8,
                padding_sm: 12,
                padding_md: 16,
                padding_lg: 20,
                padding_xl: 24,
            }
        }

        /// Get grid configuration for current breakpoint
        pub fn get_columns(&self, breakpoint: &BreakpointClass) -> i32 {
            match breakpoint {
                BreakpointClass::Mobile => self.columns_xs,
                BreakpointClass::Tablet => self.columns_md,
                BreakpointClass::Desktop => self.columns_lg,
                BreakpointClass::UltraWide => self.columns_xl,
            }
        }

        /// Get gap size for current breakpoint
        pub fn get_gap(&self, breakpoint: &BreakpointClass) -> i32 {
            match breakpoint {
                BreakpointClass::Mobile => self.gap_xs,
                BreakpointClass::Tablet => self.gap_md,
                BreakpointClass::Desktop => self.gap_lg,
                BreakpointClass::UltraWide => self.gap_xl,
            }
        }

        /// Get padding for current breakpoint
        pub fn get_padding(&self, breakpoint: &BreakpointClass) -> i32 {
            match breakpoint {
                BreakpointClass::Mobile => self.padding_xs,
                BreakpointClass::Tablet => self.padding_md,
                BreakpointClass::Desktop => self.padding_lg,
                BreakpointClass::UltraWide => self.padding_xl,
            }
        }

        /// Calculate item width given container width
        pub fn calculate_item_width(&self, container_width: i32, breakpoint: &BreakpointClass) -> i32 {
            let columns = self.get_columns(breakpoint);
            let gap = self.get_gap(breakpoint);
            let padding = self.get_padding(breakpoint);

            let available = container_width - (padding * 2) - (gap * (columns - 1));
            available / columns
        }
    }

    /// Fluid typography scaling based on screen size
    pub struct FluidTypography {
        /// Base font size for each breakpoint
        pub base_xs: f32,     // Extra small: 14px
        pub base_sm: f32,     // Small: 16px
        pub base_md: f32,     // Medium: 16px
        pub base_lg: f32,     // Large: 18px
        pub base_xl: f32,     // Extra large: 20px

        /// Heading scales (multipliers)
        pub h1_scale: f32,    // 2.0x
        pub h2_scale: f32,    // 1.8x
        pub h3_scale: f32,    // 1.5x
        pub h4_scale: f32,    // 1.25x
        pub h5_scale: f32,    // 1.1x
        pub h6_scale: f32,    // 1.0x

        /// Enable smooth scaling between breakpoints
        pub fluid_scaling: bool,
    }

    impl FluidTypography {
        pub fn new() -> Self {
            FluidTypography {
                base_xs: 14.0,
                base_sm: 16.0,
                base_md: 16.0,
                base_lg: 18.0,
                base_xl: 20.0,
                h1_scale: 2.0,
                h2_scale: 1.8,
                h3_scale: 1.5,
                h4_scale: 1.25,
                h5_scale: 1.1,
                h6_scale: 1.0,
                fluid_scaling: true,
            }
        }

        /// Calculate font size for given breakpoint and level
        pub fn calculate_size(&self, breakpoint: &BreakpointClass, level: &str) -> f32 {
            let base = match breakpoint {
                BreakpointClass::Mobile => self.base_xs,
                BreakpointClass::Tablet => self.base_md,
                BreakpointClass::Desktop => self.base_lg,
                BreakpointClass::UltraWide => self.base_xl,
            };

            match level {
                "h1" => base * self.h1_scale,
                "h2" => base * self.h2_scale,
                "h3" => base * self.h3_scale,
                "h4" => base * self.h4_scale,
                "h5" => base * self.h5_scale,
                "h6" => base * self.h6_scale,
                "body" => base,
                "small" => base * 0.875,
                "caption" => base * 0.75,
                _ => base,
            }
        }

        /// Get line height for given font size
        pub fn get_line_height(&self, font_size: f32) -> f32 {
            match font_size {
                f if f < 14.0 => 1.4,
                f if f < 16.0 => 1.4,
                f if f < 20.0 => 1.5,
                f if f < 28.0 => 1.6,
                _ => 1.8,
            }
        }
    }

    /// Container queries for component-level responsiveness
    pub struct ContainerQuery {
        /// Container width range
        pub min_container_width: Option<i32>,
        pub max_container_width: Option<i32>,

        /// Container aspect ratio
        pub min_aspect_ratio: Option<f32>,
        pub max_aspect_ratio: Option<f32>,
    }

    impl ContainerQuery {
        pub fn new() -> Self {
            ContainerQuery {
                min_container_width: None,
                max_container_width: None,
                min_aspect_ratio: None,
                max_aspect_ratio: None,
            }
        }

        /// Check if container matches this query
        pub fn matches(&self, container_width: i32, container_height: i32) -> bool {
            // Width check
            if let Some(min) = self.min_container_width {
                if container_width < min { return false; }
            }
            if let Some(max) = self.max_container_width {
                if container_width > max { return false; }
            }

            // Aspect ratio check
            if container_height > 0 {
                let aspect = container_width as f32 / container_height as f32;
                if let Some(min) = self.min_aspect_ratio {
                    if aspect < min { return false; }
                }
                if let Some(max) = self.max_aspect_ratio {
                    if aspect > max { return false; }
                }
            }

            true
        }
    }

    /// Aspect ratio maintenance for responsive images
    pub struct AspectRatio {
        pub width: i32,
        pub height: i32,
    }

    impl AspectRatio {
        pub fn new(width: i32, height: i32) -> Self {
            AspectRatio { width, height }
        }

        /// Standard aspect ratios
        pub fn square() -> Self { AspectRatio::new(1, 1) }
        pub fn portrait() -> Self { AspectRatio::new(3, 4) }
        pub fn landscape() -> Self { AspectRatio::new(16, 9) }
        pub fn cinema() -> Self { AspectRatio::new(21, 9) }
        pub fn golden_ratio() -> Self { AspectRatio::new(16, 10) }

        /// Calculate height given width
        pub fn calculate_height(&self, width: i32) -> i32 {
            (width * self.height) / self.width
        }

        /// Calculate width given height
        pub fn calculate_width(&self, height: i32) -> i32 {
            (height * self.width) / self.height
        }

        /// Get padding-bottom percentage for aspect ratio trick
        pub fn get_padding_bottom_percent(&self) -> f32 {
            (self.height as f32 / self.width as f32) * 100.0
        }
    }

    // ═══════════════════════════════════════════════════════════════════════════════
    // TOUCH & GESTURE HANDLING
    // ═══════════════════════════════════════════════════════════════════════════════

    /// Touch point tracking with pressure and size
    pub struct TouchPoint {
        pub id: i32,
        pub x: f32,
        pub y: f32,
        pub pressure: f32,      // 0.0 - 1.0
        pub radius: f32,        // Finger touch radius in pixels
        pub timestamp: u64,
    }

    /// Gesture detection and handling
    pub enum GestureType {
        SingleTap,
        DoubleTap,
        LongPress,
        Swipe { direction: SwipeDirection, velocity: f32 },
        Pinch { scale: f32, velocity: f32 },
        Rotate { angle: f32, velocity: f32 },
        Pan { dx: f32, dy: f32, velocity: f32 },
    }

    pub enum SwipeDirection {
        Up,
        Down,
        Left,
        Right,
        Diagonal,
    }

    /// Touch gesture recognizer
    pub struct GestureRecognizer {
        /// Minimum distance for swipe detection (pixels)
        pub swipe_threshold: f32,

        /// Minimum velocity for swipe (pixels/ms)
        pub swipe_velocity_threshold: f32,

        /// Maximum duration for double-tap (ms)
        pub double_tap_timeout: u64,

        /// Minimum duration for long-press (ms)
        pub long_press_duration: u64,

        /// Minimum pinch distance change (pixels)
        pub pinch_threshold: f32,

        /// Touch points being tracked
        pub active_touches: Vec<TouchPoint>,

        /// Recent gestures
        pub recent_gestures: Vec<GestureType>,
    }

    impl GestureRecognizer {
        pub fn new() -> Self {
            GestureRecognizer {
                swipe_threshold: 50.0,
                swipe_velocity_threshold: 0.3,
                double_tap_timeout: 300,
                long_press_duration: 500,
                pinch_threshold: 10.0,
                active_touches: vec![],
                recent_gestures: vec![],
            }
        }

        /// Register new touch point
        pub fn touch_began(&mut self, touch: TouchPoint) {
            self.active_touches.push(touch);
        }

        /// Update touch point
        pub fn touch_moved(&mut self, id: i32, x: f32, y: f32) {
            if let Some(touch) = self.active_touches.iter_mut().find(|t| t.id == id) {
                touch.x = x;
                touch.y = y;
            }
        }

        /// End touch point and recognize gestures
        pub fn touch_ended(&mut self, id: i32) -> Option<GestureType> {
            self.active_touches.retain(|t| t.id != id);
            // Gesture recognition logic
            None
        }

        /// Calculate touch velocity (pixels per millisecond)
        pub fn calculate_velocity(&self, start_x: f32, start_y: f32, end_x: f32, end_y: f32, duration_ms: u64) -> f32 {
            let distance = ((end_x - start_x).powi(2) + (end_y - start_y).powi(2)).sqrt();
            if duration_ms == 0 { return 0.0; }
            distance / duration_ms as f32
        }

        /// Detect swipe direction
        pub fn detect_swipe_direction(&self, dx: f32, dy: f32) -> SwipeDirection {
            let abs_dx = dx.abs();
            let abs_dy = dy.abs();

            if abs_dx > abs_dy {
                if dx > 0.0 { SwipeDirection::Right } else { SwipeDirection::Left }
            } else if abs_dy > abs_dx {
                if dy > 0.0 { SwipeDirection::Down } else { SwipeDirection::Up }
            } else {
                SwipeDirection::Diagonal
            }
        }

        /// Check if touch is within hitbox with touch padding
        pub fn is_touch_in_bounds(&self, touch_x: f32, touch_y: f32, rect_x: i32, rect_y: i32, rect_w: i32, rect_h: i32, padding: i32) -> bool {
            let padded = Rectangle {
                x: rect_x - padding,
                y: rect_y - padding,
                width: (rect_w + padding * 2) as u32,
                height: (rect_h + padding * 2) as u32,
            };

            touch_x >= padded.x as f32 &&
            touch_x <= (padded.x + padded.width as i32) as f32 &&
            touch_y >= padded.y as f32 &&
            touch_y <= (padded.y + padded.height as i32) as f32
        }
    }

    /// Touch-friendly component sizing recommendations
    pub struct TouchTargetSizes {
        /// Minimum touch target size (Apple: 44pt, Material: 48dp)
        pub minimum_size: i32,

        /// Recommended touch target size
        pub recommended_size: i32,

        /// Touch padding around target
        pub touch_padding: i32,

        /// Spacing between touch targets
        pub minimum_spacing: i32,
    }

    impl TouchTargetSizes {
        pub fn new() -> Self {
            TouchTargetSizes {
                minimum_size: 44,      // ~11mm
                recommended_size: 48,  // ~12mm (Material Design)
                touch_padding: 12,
                minimum_spacing: 8,
            }
        }
    }

    // ═══════════════════════════════════════════════════════════════════════════════
    // DPI-AWARE SCALING
    // ═══════════════════════════════════════════════════════════════════════════════

    /// DPI detection and scaling calculations
    pub struct DPIScaling {
        /// Reference DPI (typically 96dpi for desktop, 163dpi for phones)
        pub reference_dpi: i32,

        /// Current device DPI
        pub device_dpi: i32,

        /// Device pixel ratio (scale factor)
        pub device_pixel_ratio: f64,
    }

    impl DPIScaling {
        pub fn new(device_dpi: i32) -> Self {
            DPIScaling {
                reference_dpi: 96,
                device_dpi,
                device_pixel_ratio: (device_dpi as f64) / 96.0,
            }
        }

        /// Convert logical pixels to physical pixels
        pub fn logical_to_physical(&self, logical_px: i32) -> i32 {
            ((logical_px as f64) * self.device_pixel_ratio).round() as i32
        }

        /// Convert physical pixels to logical pixels
        pub fn physical_to_logical(&self, physical_px: i32) -> i32 {
            ((physical_px as f64) / self.device_pixel_ratio).round() as i32
        }

        /// Get scaling factor
        pub fn get_scale_factor(&self) -> f64 {
            self.device_pixel_ratio
        }

        /// Scale dimensions for high-DPI displays
        pub fn scale_dimensions(&self, width: i32, height: i32) -> (i32, i32) {
            (
                self.logical_to_physical(width),
                self.logical_to_physical(height),
            )
        }

        /// Scale spacing values
        pub fn scale_spacing(&self, spacing: i32) -> i32 {
            self.logical_to_physical(spacing)
        }

        /// Classify DPI level
        pub fn get_dpi_class(&self) -> DPIClass {
            match self.device_dpi {
                dpi if dpi < 96 => DPIClass::LowDPI,
                dpi if dpi < 150 => DPIClass::MediumDPI,
                dpi if dpi < 220 => DPIClass::HighDPI,
                dpi if dpi < 330 => DPIClass::UltraHighDPI,
                _ => DPIClass::SuperHighDPI,
            }
        }
    }

    pub enum DPIClass {
        LowDPI,         // < 96dpi (old displays)
        MediumDPI,      // 96-150dpi (standard desktop)
        HighDPI,        // 150-220dpi (tablets, some phones)
        UltraHighDPI,   // 220-330dpi (modern phones)
        SuperHighDPI,   // > 330dpi (premium phones)
    }

    // ═══════════════════════════════════════════════════════════════════════════════
    // RESPONSIVE IMAGE SYSTEM
    // ═══════════════════════════════════════════════════════════════════════════════

    /// Responsive image asset selector
    pub struct ResponsiveImage {
        /// Sources for different screen densities (1x, 2x, 3x)
        pub source_1x: String,
        pub source_2x: String,
        pub source_3x: String,

        /// Width-based sources
        pub width_sources: Vec<(i32, String)>,  // (max-width, source)

        /// DPI-based fallback
        pub fallback_source: String,
    }

    impl ResponsiveImage {
        pub fn new(fallback: String) -> Self {
            ResponsiveImage {
                source_1x: fallback.clone(),
                source_2x: fallback.clone(),
                source_3x: fallback,
                width_sources: vec![],
                fallback_source: fallback,
            }
        }

        /// Select best image source for device
        pub fn select_source(&self, device: &DeviceDetector) -> String {
            // First try width-based sources
            for (max_width, source) in &self.width_sources {
                if device.screen_width <= *max_width {
                    return source.clone();
                }
            }

            // Fall back to DPI-based source
            match device.dpi {
                dpi if dpi <= 96 => self.source_1x.clone(),
                dpi if dpi <= 192 => self.source_2x.clone(),
                _ => self.source_3x.clone(),
            }
        }

        /// Get srcset attribute for HTML img element
        pub fn get_srcset(&self) -> String {
            format!("{} 1x, {} 2x, {} 3x",
                self.source_1x, self.source_2x, self.source_3x)
        }
    }

    /// Responsive image loading strategy
    pub struct ImageLoadingStrategy {
        /// Load images immediately
        pub eager: bool,

        /// Lazy load images on viewport entry
        pub lazy: bool,

        /// Preload critical images
        pub preload: bool,

        /// Placeholder/blur approach
        pub placeholder: PlaceholderType,
    }

    pub enum PlaceholderType {
        None,
        Solid(Color),      // Solid color
        Blur(String),      // Blurred image
        LQIP(String),      // Low Quality Image Placeholder
    }

    // ═══════════════════════════════════════════════════════════════════════════════
    // VIEWPORT & SCALING CONFIGURATION
    // ═══════════════════════════════════════════════════════════════════════════════

    /// Viewport configuration for web/mobile applications
    pub struct ViewportConfig {
        /// Viewport width setting
        pub width: ViewportWidth,

        /// Initial zoom level (1.0 = 100%)
        pub initial_scale: f32,

        /// Minimum zoom level
        pub minimum_scale: f32,

        /// Maximum zoom level
        pub maximum_scale: f32,

        /// User can zoom content
        pub user_scalable: bool,

        /// Viewport fit (standard, cover, contain)
        pub viewport_fit: ViewportFit,
    }

    pub enum ViewportWidth {
        DeviceWidth,        // width=device-width
        FixedPixels(i32),   // width=480
        Auto,              // No explicit width
    }

    pub enum ViewportFit {
        Auto,              // Standard viewport
        Cover,             // Extend into notch area
        Contain,           // Avoid notch
    }

    impl ViewportConfig {
        pub fn new_mobile() -> Self {
            ViewportConfig {
                width: ViewportWidth::DeviceWidth,
                initial_scale: 1.0,
                minimum_scale: 1.0,
                maximum_scale: 5.0,
                user_scalable: true,
                viewport_fit: ViewportFit::Contain,
            }
        }

        pub fn new_desktop() -> Self {
            ViewportConfig {
                width: ViewportWidth::Auto,
                initial_scale: 1.0,
                minimum_scale: 0.5,
                maximum_scale: 2.0,
                user_scalable: true,
                viewport_fit: ViewportFit::Auto,
            }
        }

        /// Get viewport meta tag string
        pub fn get_meta_tag(&self) -> String {
            let mut tag = String::from("viewport");

            match &self.width {
                ViewportWidth::DeviceWidth => tag.push_str("=device-width"),
                ViewportWidth::FixedPixels(px) => tag.push_str(&format!("={}", px)),
                ViewportWidth::Auto => {},
            }

            tag.push_str(&format!(", initial-scale={}", self.initial_scale));
            tag.push_str(&format!(", minimum-scale={}", self.minimum_scale));
            tag.push_str(&format!(", maximum-scale={}", self.maximum_scale));

            if !self.user_scalable {
                tag.push_str(", user-scalable=no");
            }

            tag
        }
    }

    // ═══════════════════════════════════════════════════════════════════════════════
    // RESPONSIVE SYSTEM MANAGER
    // ═══════════════════════════════════════════════════════════════════════════════

    /// Central responsive design system manager
    pub struct ResponsiveSystem {
        /// Device detector
        pub device: DeviceDetector,

        /// Breakpoint configuration
        pub breakpoints: BreakpointConfig,

        /// Grid layout system
        pub grid: AdaptiveGridLayout,

        /// Typography system
        pub typography: FluidTypography,

        /// Gesture recognizer
        pub gestures: GestureRecognizer,

        /// DPI scaling
        pub dpi_scaling: DPIScaling,

        /// Touch target sizes
        pub touch_sizes: TouchTargetSizes,

        /// Current quality level
        pub quality_level: QualityLevel,

        /// Registered media queries
        pub media_queries: Vec<MediaQuery>,

        /// Viewport config
        pub viewport: ViewportConfig,
    }

    impl ResponsiveSystem {
        pub fn new(screen_width: i32, screen_height: i32, dpi: i32) -> Self {
            let device = DeviceDetector::new(screen_width, screen_height, dpi);
            let quality_level = device.capabilities.get_quality_level();
            let viewport = match device.device_type {
                DeviceType::Phone | DeviceType::Tablet => ViewportConfig::new_mobile(),
                _ => ViewportConfig::new_desktop(),
            };

            ResponsiveSystem {
                device,
                breakpoints: BreakpointConfig::new(),
                grid: AdaptiveGridLayout::new(),
                typography: FluidTypography::new(),
                gestures: GestureRecognizer::new(),
                dpi_scaling: DPIScaling::new(dpi),
                touch_sizes: TouchTargetSizes::new(),
                quality_level,
                media_queries: vec![],
                viewport,
            }
        }

        /// Handle viewport resize
        pub fn on_resize(&mut self, new_width: i32, new_height: i32) {
            self.device.update_dimensions(new_width, new_height);
        }

        /// Handle orientation change
        pub fn on_orientation_change(&mut self) {
            self.device.orientation = DeviceDetector::detect_orientation(
                self.device.screen_width,
                self.device.screen_height,
            );
        }

        /// Update device capabilities
        pub fn update_capabilities(&mut self, capabilities: DeviceCapabilities) {
            self.device.capabilities = capabilities;
            self.quality_level = self.device.capabilities.get_quality_level();
        }

        /// Get current breakpoint
        pub fn current_breakpoint(&self) -> BreakpointClass {
            self.device.get_breakpoint()
        }

        /// Get font size for heading
        pub fn get_heading_size(&self, level: i32) -> f32 {
            let breakpoint = self.current_breakpoint();
            let heading_name = format!("h{}", level);
            self.typography.calculate_size(&breakpoint, &heading_name)
        }

        /// Register responsive listener
        pub fn add_media_query(&mut self, query: MediaQuery) {
            self.media_queries.push(query);
        }

        /// Check if device is touch-capable
        pub fn is_touch_device(&self) -> bool {
            self.device.capabilities.has_touch
        }

        /// Get safe area considering notches
        pub fn get_safe_rect(&self, rect: &Rectangle) -> Rectangle {
            self.device.safe_area.apply_to_rect(rect)
        }

        /// Check if battery saving should be enabled
        pub fn should_enable_battery_saver(&self) -> bool {
            self.device.capabilities.battery_level < 0.20 ||
            self.device.capabilities.low_power_mode
        }

        /// Get rendering quality based on conditions
        pub fn get_rendering_quality(&self) -> RenderingQuality {
            match self.quality_level {
                QualityLevel::Low => RenderingQuality {
                    anti_aliasing: false,
                    shadows: false,
                    blur_effects: false,
                    particle_count: 0,
                },
                QualityLevel::Medium => RenderingQuality {
                    anti_aliasing: true,
                    shadows: true,
                    blur_effects: false,
                    particle_count: 50,
                },
                QualityLevel::High => RenderingQuality {
                    anti_aliasing: true,
                    shadows: true,
                    blur_effects: true,
                    particle_count: 200,
                },
            }
        }
    }

    pub struct RenderingQuality {
        pub anti_aliasing: bool,
        pub shadows: bool,
        pub blur_effects: bool,
        pub particle_count: i32,
    }

    // ═══════════════════════════════════════════════════════════════════════════════
    // RESPONSIVE COMPONENT ADAPTER
    // ═══════════════════════════════════════════════════════════════════════════════

    /// Adapts components based on responsive state
    pub struct ResponsiveComponentAdapter {
        pub responsive_system: ResponsiveSystem,
    }

    impl ResponsiveComponentAdapter {
        pub fn new(responsive_system: ResponsiveSystem) -> Self {
            ResponsiveComponentAdapter { responsive_system }
        }

        /// Adapt component dimensions for current device
        pub fn adapt_component(&self, base_width: i32, base_height: i32) -> (i32, i32) {
            let breakpoint = self.responsive_system.current_breakpoint();

            match breakpoint {
                BreakpointClass::Mobile => (base_width, (base_height as f32 * 1.2) as i32),
                BreakpointClass::Tablet => (base_width, base_height),
                BreakpointClass::Desktop => ((base_width as f32 * 0.9) as i32, base_height),
                BreakpointClass::UltraWide => ((base_width as f32 * 0.7) as i32, base_height),
            }
        }

        /// Get spacing scale for current breakpoint
        pub fn get_spacing_scale(&self) -> f32 {
            match self.responsive_system.current_breakpoint() {
                BreakpointClass::Mobile => 1.0,
                BreakpointClass::Tablet => 1.2,
                BreakpointClass::Desktop => 1.4,
                BreakpointClass::UltraWide => 1.6,
            }
        }

        /// Determine if component should be visible
        pub fn should_show_component(&self, breakpoint_class: &BreakpointClass) -> bool {
            // Component visibility logic based on breakpoint
            true
        }
    }
}
