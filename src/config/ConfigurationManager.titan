// CONFIGURATION MANAGER
// Centralized Configuration Management
// TITAN Systems Language Implementation

use std::collections::HashMap;

pub struct Config {
    pub values: HashMap<String, ConfigValue>,
}

pub enum ConfigValue {
    String(String),
    Integer(i32),
    Boolean(bool),
    Float(f32),
}

impl Config {
    pub fn new() -> Self {
        Config { values: HashMap::new() }
    }

    pub fn get(&self, key: &str) -> Option<ConfigValue> {
        self.values.get(key).cloned()
    }

    pub fn set(&mut self, key: String, value: ConfigValue) {
        self.values.insert(key, value);
    }

    pub fn load_from_file(&mut self, _path: &str) -> Result<(), String> {
        Ok(())
    }

    pub fn save_to_file(&self, _path: &str) -> Result<(), String> {
        Ok(())
    }
}
