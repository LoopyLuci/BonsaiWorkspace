// EVENT BUS SYSTEM
// Asynchronous Event Processing & Distribution
// AETHER Distributed Systems Language Implementation

use std::collections::HashMap;

pub trait EventListener {
    fn handle_event(&self, event: &Event);
}

pub struct Event {
    pub event_type: String,
    pub data: HashMap<String, String>,
}

pub struct EventBus {
    listeners: HashMap<String, Vec<Box<dyn EventListener>>>,
}

impl EventBus {
    pub fn new() -> Self {
        EventBus { listeners: HashMap::new() }
    }

    pub fn publish(&self, event: Event) {
        if let Some(handlers) = self.listeners.get(&event.event_type) {
            for handler in handlers {
                handler.handle_event(&event);
            }
        }
    }

    pub fn subscribe(&mut self, event_type: String, _listener: Box<dyn EventListener>) {
        self.listeners.entry(event_type).or_insert_with(Vec::new);
    }
}
