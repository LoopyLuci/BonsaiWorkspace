// JOB SCHEDULER
// Cron-Based Task Scheduling with Retry Policies
// TITAN Systems Language Implementation

use std::collections::HashMap;
use std::sync::Mutex;

#[derive(Clone, Debug)]
pub struct ScheduledJob {
    pub id: String,
    pub name: String,
    pub cron_expression: String,
    pub command: String,
    pub enabled: bool,
    pub last_run: Option<u64>,
    pub next_run: u64,
    pub retry_count: u32,
    pub max_retries: u32,
    pub timeout_seconds: u32,
    pub description: String,
}

#[derive(Clone, Copy, Debug, PartialEq)]
pub enum JobState {
    IDLE,
    RUNNING,
    SUCCESS,
    FAILED,
    RETRYING,
}

pub struct JobScheduler {
    jobs: Mutex<HashMap<String, ScheduledJob>>,
    job_states: Mutex<HashMap<String, JobState>>,
    execution_history: Mutex<Vec<JobExecution>>,
}

#[derive(Clone, Debug)]
pub struct JobExecution {
    pub job_id: String,
    pub timestamp: u64,
    pub state: JobState,
    pub output: String,
    pub duration_ms: u32,
}

impl JobScheduler {
    pub fn new() -> Self {
        JobScheduler {
            jobs: Mutex::new(HashMap::new()),
            job_states: Mutex::new(HashMap::new()),
            execution_history: Mutex::new(Vec::new()),
        }
    }

    /// Create a new scheduled job
    pub fn create_job(&self, job: ScheduledJob) -> Result<(), String> {
        let mut jobs = self.jobs.lock().map_err(|e| e.to_string())?;
        let mut states = self.job_states.lock().map_err(|e| e.to_string())?;

        jobs.insert(job.id.clone(), job);
        states.insert(job.id.clone(), JobState::IDLE);

        Ok(())
    }

    /// List all jobs
    pub fn list_jobs(&self) -> Result<Vec<ScheduledJob>, String> {
        let jobs = self.jobs.lock().map_err(|e| e.to_string())?;
        Ok(jobs.values().cloned().collect())
    }

    /// Get job by ID
    pub fn get_job(&self, job_id: &str) -> Result<ScheduledJob, String> {
        let jobs = self.jobs.lock().map_err(|e| e.to_string())?;
        jobs.get(job_id)
            .cloned()
            .ok_or_else(|| format!("Job not found: {}", job_id))
    }

    /// Run a job immediately
    pub fn run_job(&self, job_id: &str) -> Result<(), String> {
        let mut states = self.job_states.lock().map_err(|e| e.to_string())?;

        states.insert(job_id.to_string(), JobState::RUNNING);

        // Simulate job execution
        let result = JobExecution {
            job_id: job_id.to_string(),
            timestamp: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap_or_default()
                .as_secs(),
            state: JobState::SUCCESS,
            output: "Job completed successfully".to_string(),
            duration_ms: 150,
        };

        let mut history = self.execution_history.lock().map_err(|e| e.to_string())?;
        history.push(result);

        states.insert(job_id.to_string(), JobState::IDLE);

        Ok(())
    }

    /// Get job execution history
    pub fn get_execution_history(&self, job_id: &str, limit: usize) -> Result<Vec<JobExecution>, String> {
        let history = self.execution_history.lock().map_err(|e| e.to_string())?;
        let filtered: Vec<_> = history
            .iter()
            .filter(|e| e.job_id == job_id)
            .rev()
            .take(limit)
            .cloned()
            .collect();

        Ok(filtered)
    }

    /// Retry failed job
    pub fn retry_job(&self, job_id: &str) -> Result<(), String> {
        let mut jobs = self.jobs.lock().map_err(|e| e.to_string())?;

        if let Some(job) = jobs.get_mut(job_id) {
            if job.retry_count < job.max_retries {
                job.retry_count += 1;
                self.run_job(job_id)?;
            }
        }

        Ok(())
    }

    /// Disable a job
    pub fn disable_job(&self, job_id: &str) -> Result<(), String> {
        let mut jobs = self.jobs.lock().map_err(|e| e.to_string())?;

        if let Some(job) = jobs.get_mut(job_id) {
            job.enabled = false;
        }

        Ok(())
    }

    /// Delete a job
    pub fn delete_job(&self, job_id: &str) -> Result<(), String> {
        let mut jobs = self.jobs.lock().map_err(|e| e.to_string())?;
        jobs.remove(job_id);

        let mut states = self.job_states.lock().map_err(|e| e.to_string())?;
        states.remove(job_id);

        Ok(())
    }

    /// Check which jobs should run now
    pub fn get_jobs_to_run(&self) -> Result<Vec<ScheduledJob>, String> {
        let jobs = self.jobs.lock().map_err(|e| e.to_string())?;
        let now = std::time::SystemTime::now()
            .duration_since(std::time::UNIX_EPOCH)
            .unwrap_or_default()
            .as_secs();

        let ready: Vec<_> = jobs
            .values()
            .filter(|job| job.enabled && job.next_run <= now)
            .cloned()
            .collect();

        Ok(ready)
    }
}

// Global Job Scheduler instance
lazy_static::lazy_static! {
    pub static ref JOB_SCHEDULER: JobScheduler = JobScheduler::new();
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_job_creation() {
        let scheduler = JobScheduler::new();
        let job = ScheduledJob {
            id: "test_job".to_string(),
            name: "Test Job".to_string(),
            cron_expression: "0 * * * *".to_string(),
            command: "echo 'hello'".to_string(),
            enabled: true,
            last_run: None,
            next_run: 0,
            retry_count: 0,
            max_retries: 3,
            timeout_seconds: 300,
            description: "Test job".to_string(),
        };

        assert!(scheduler.create_job(job).is_ok());
    }

    #[test]
    fn test_job_execution() {
        let scheduler = JobScheduler::new();
        let job = ScheduledJob {
            id: "test".to_string(),
            name: "Test".to_string(),
            cron_expression: "* * * * *".to_string(),
            command: "echo".to_string(),
            enabled: true,
            last_run: None,
            next_run: 0,
            retry_count: 0,
            max_retries: 3,
            timeout_seconds: 300,
            description: "Test".to_string(),
        };

        scheduler.create_job(job).unwrap();
        assert!(scheduler.run_job("test").is_ok());
    }
}
