// OBSERVABILITY DASHBOARD
// Distributed Tracing & Real-Time Analytics
// VERA Language Implementation

import "asset_manager" as assets;
import "event_system" as events;

pub fn render_observability_dashboard() -> Component {
    Container {
        width: 100%,
        height: 100%,
        background_color: assets::COLOR_BACKGROUND,
        padding: 20,

        children: vec![
            Text {
                content: "Observability & Distributed Tracing".to_string(),
                font_size: 24,
                font_weight: "bold".to_string(),
                margin_bottom: 20,
            },

            // Key Metrics
            MetricsGrid {
                columns: 4,
                children: vec![
                    MetricCard { label: "Request Rate".to_string(), value: "2,453/min".to_string(), trend: "↑ 12%".to_string() },
                    MetricCard { label: "Avg Latency".to_string(), value: "47.3ms".to_string(), trend: "↓ 5%".to_string() },
                    MetricCard { label: "Error Rate".to_string(), value: "0.12%".to_string(), trend: "↓ 2%".to_string() },
                    MetricCard { label: "P99 Latency".to_string(), value: "156ms".to_string(), trend: "→ 0%".to_string() },
                ],
            },

            Divider { margin_top: 20, margin_bottom: 20 },

            // Trace Visualization
            Text {
                content: "Request Traces".to_string(),
                font_size: 18,
                font_weight: "600".to_string(),
                margin_bottom: 15,
            },

            ListView {
                items: vec![
                    render_trace_item("POST /api/auth/login", "145ms", "success"),
                    render_trace_item("GET /api/user/profile", "78ms", "success"),
                    render_trace_item("PUT /api/settings/theme", "92ms", "success"),
                    render_trace_item("GET /api/notifications", "34ms", "success"),
                ],
                on_item_click: |index| {
                    events::EVENT_SYSTEM.fire_event("observability:trace_selected", json!({"index": index}));
                },
            },

            Divider { margin_top: 20, margin_bottom: 20 },

            // Service Dependencies
            Text {
                content: "Service Dependencies".to_string(),
                font_size: 18,
                font_weight: "600".to_string(),
                margin_bottom: 15,
            },

            Container {
                height: 300,
                children: vec![
                    ServiceDependencyGraph {
                        nodes: vec![
                            "API Gateway",
                            "Auth Service",
                            "User Service",
                            "Theme Service",
                            "Database",
                        ],
                        edges: vec![
                            ("API Gateway", "Auth Service"),
                            ("API Gateway", "User Service"),
                            ("Auth Service", "Database"),
                            ("User Service", "Database"),
                        ],
                    },
                ],
            },

            Divider { margin_top: 20, margin_bottom: 20 },

            // Span Timeline
            Text {
                content: "Detailed Trace Timeline".to_string(),
                font_size: 18,
                font_weight: "600".to_string(),
                margin_bottom: 15,
            },

            TreeView {
                items: vec![
                    TreeNode {
                        label: "POST /api/auth/login [145ms]".to_string(),
                        expanded: true,
                        children: vec![
                            TreeNode {
                                label: "Auth Service [120ms]".to_string(),
                                expanded: true,
                                children: vec![
                                    TreeNode { label: "Verify Passkey [85ms]".to_string(), children: vec![] },
                                    TreeNode { label: "Check Risk [25ms]".to_string(), children: vec![] },
                                    TreeNode { label: "Create Session [10ms]".to_string(), children: vec![] },
                                ],
                            },
                            TreeNode {
                                label: "API Gateway [25ms]".to_string(),
                                expanded: false,
                                children: vec![],
                            },
                        ],
                    },
                ],
            },
        ],
    }
}

fn render_trace_item(endpoint: &str, duration: &str, status: &str) -> Component {
    Container {
        padding: 12,
        background_color: assets::COLOR_SURFACE,
        border_radius: 4,
        margin_bottom: 8,

        children: vec![
            HorizontalLayout {
                spacing: 15,
                children: vec![
                    Container {
                        width: "60%".to_string(),
                        children: vec![
                            Text {
                                content: endpoint.to_string(),
                                font_size: 13,
                                font_weight: "600".to_string(),
                                font_family: "monospace".to_string(),
                            },
                        ],
                    },
                    Container {
                        width: "20%".to_string(),
                        children: vec![
                            Text {
                                content: duration.to_string(),
                                font_size: 12,
                                color: assets::COLOR_TEXT_SECONDARY,
                            },
                        ],
                    },
                    Container {
                        width: "20%".to_string(),
                        children: vec![
                            Badge {
                                text: status.to_string(),
                                color: "green".to_string(),
                            },
                        ],
                    },
                ],
            },
        ],
    }
}

pub struct MetricCard {
    pub label: String,
    pub value: String,
    pub trend: String,
}

pub struct ServiceDependencyGraph {
    pub nodes: Vec<String>,
    pub edges: Vec<(String, String)>,
}

pub struct TreeNode {
    pub label: String,
    pub expanded: bool,
    pub children: Vec<TreeNode>,
}
