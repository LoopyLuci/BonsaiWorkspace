// METRICS AGGREGATOR
// Time-Series Metrics Collection & Aggregation
// SYLVA Machine Learning Language Implementation

use std::collections::HashMap;

pub struct MetricPoint {
    pub timestamp: u64,
    pub value: f32,
}

pub struct Metric {
    pub name: String,
    pub points: Vec<MetricPoint>,
}

pub struct MetricsAggregator {
    metrics: HashMap<String, Metric>,
}

impl MetricsAggregator {
    pub fn new() -> Self {
        MetricsAggregator { metrics: HashMap::new() }
    }

    pub fn record_metric(&mut self, name: String, value: f32) {
        let metric = self.metrics.entry(name).or_insert_with(|| Metric {
            name: String::new(),
            points: Vec::new(),
        });

        metric.points.push(MetricPoint {
            timestamp: std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap_or_default().as_secs(),
            value,
        });
    }

    pub fn get_metric(&self, name: &str) -> Option<Metric> {
        self.metrics.get(name).cloned()
    }

    pub fn calculate_average(&self, name: &str) -> Option<f32> {
        self.metrics.get(name).map(|m| {
            if m.points.is_empty() {
                0.0
            } else {
                m.points.iter().map(|p| p.value).sum::<f32>() / m.points.len() as f32
            }
        })
    }
}
