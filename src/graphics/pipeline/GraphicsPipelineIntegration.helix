    // PERFORMANCE MONITORING PIPELINE
    // ═══════════════════════════════════════════════════════════════════════════════

    /// Frame timing metrics
    pub struct FrameTimingMetrics {
        pub frame_number: u64,
        pub total_frame_time_ms: f32,
        pub cpu_time_ms: f32,
        pub gpu_time_ms: f32,
        pub submit_time_ms: f32,
        pub wait_time_ms: f32,
        pub present_time_ms: f32,
        pub frame_time_history: Vec<f32>,
        pub frame_time_min_ms: f32,
        pub frame_time_max_ms: f32,
        pub frame_time_avg_ms: f32,
    }

    /// GPU utilization metrics
    pub struct GpuUtilization {
        pub timestamp_ns: u64,
        pub gpu_utilization_percent: f32,
        pub memory_utilization_percent: f32,
        pub l1_cache_utilization_percent: f32,
        pub l2_cache_utilization_percent: f32,
        pub texture_cache_utilization_percent: f32,
        pub bandwidth_utilization_percent: f32,
        pub sm_active_percent: f32,  // Streaming Multiprocessor
        pub thermal_utilization_percent: f32,
    }

    /// Stall detection and analysis
    pub struct StallDetection {
        pub stall_id: u64,
        pub stall_type: String,     // Memory, Dependency, Resource, Thermal
        pub duration_us: u32,
        pub stage_affected: PipelineStage,
        pub sample_count: u32,
        pub stalled_threads_percent: f32,
        pub root_cause_analysis: String,
    }

    /// Bottleneck analysis
    pub struct BottleneckAnalysis {
        pub analysis_id: String,
        pub primary_bottleneck: String,  // Vertex, Rasterization, Fragment, etc.
        pub bottleneck_severity: f32,    // 0.0-1.0
        pub secondary_bottlenecks: Vec<(String, f32)>,
        pub affected_stages: Vec<PipelineStage>,
        pub optimization_suggestions: Vec<String>,
    }

    /// Performance profiler
    pub struct PerformanceProfiler {
        pub profiler_id: String,
        pub enabled: bool,
        pub sample_interval_ms: f32,
        pub metrics_collected: Vec<String>,
        pub profiling_overhead_percent: f32,
        pub data_points_recorded: u64,
        pub memory_usage_bytes: u64,
    }

