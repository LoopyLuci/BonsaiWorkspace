    /// Draw call batching
    pub struct DrawCallBatching {
        pub batch_id: u32,
        pub original_draw_calls: u32,
        pub batched_draw_calls: u32,
        pub reduction_percent: f32,
        pub state_changes_eliminated: u32,
        pub total_vertices_drawn: u64,
        pub total_indices_drawn: u64,
        pub batch_overhead_bytes: u32,
    }

    /// State change tracking
    pub struct StateChangeTracking {
        pub frame_number: u64,
        pub total_state_changes: u32,
        pub pipeline_changes: u32,
        pub render_target_changes: u32,
        pub descriptor_set_changes: u32,
        pub viewport_scissor_changes: u32,
        pub push_constant_changes: u32,
        pub shader_changes: u32,
    }

    /// GPU pipeline efficiency metrics
    pub struct PipelineEfficiency {
        pub warp_efficiency_percent: f32,
        pub occupancy_percent: f32,
        pub compute_intensity: f32,
        pub memory_efficiency_percent: f32,
        pub bandwidth_utilization_percent: f32,
        pub cache_hit_rate: f32,
        pub latency_bound: bool,
        pub throughput_bound: bool,
    }

    /// Cache warming configuration
    pub struct CacheWarming {
        pub enabled: bool,
        pub prefetch_distance: u32,
        pub l1_cache_preload_enabled: bool,
        pub l2_cache_preload_enabled: bool,
        pub shared_memory_preload_bytes: u32,
        pub texture_cache_preload_enabled: bool,
    }

    /// Memory access pattern analysis
    pub struct MemoryAccessPattern {
        pub pattern_id: String,
        pub access_type: String,    // Sequential, Random, Strided
        pub stride_distance: u64,
        pub reuse_distance: u64,
        pub hit_ratio: f32,
        pub recommended_cache_strategy: String,
    }

