    /// Record command to buffer
    pub fn record_command(buffer: &mut CommandBuffer, command: GpuCommand) {
        if buffer.is_recording && buffer.commands.len() < buffer.commands.capacity() {
            buffer.commands.push(command);
        }
    }

    /// Begin render pass
    pub fn begin_render_pass(
        pipeline: &mut GraphicsPipeline,
        render_pass_id: String,
        clear_color: (f32, f32, f32, f32),
    ) {
        pipeline.frame_metrics.frame_number += 1;
        if let Some(window) = &mut pipeline.window_surface {
            pipeline.swapchain.frame_count += 1;
        }
    }

    /// Submit command buffer for execution
    pub fn submit_command_buffer(
        pipeline: &mut GraphicsPipeline,
        buffer: CommandBuffer,
        wait_semaphores: Vec<u64>,
        signal_semaphores: Vec<u64>,
    ) {
        let mut batch = CommandBatch {
            batch_id: buffer.buffer_id,
            commands: buffer.commands.clone(),
            total_duration_us: 0,
            state_changes: 0,
            draw_calls: 0,
            dispatch_calls: 0,
            memory_barriers: 0,
        };

        for cmd in &batch.commands {
            if cmd.command_type == "Draw" {
                batch.draw_calls += 1;
            } else if cmd.command_type == "Dispatch" {
                batch.dispatch_calls += 1;
            } else if cmd.command_type == "MemoryBarrier" {
                batch.memory_barriers += 1;
            }
        }

        pipeline.batches.push(batch);
    }

    /// Present frame to display
    pub fn present_frame(
        pipeline: &mut GraphicsPipeline,
        present_op: PresentOperation,
    ) -> bool {
        let current_time_ns = chrono::Utc::now().timestamp_nanos() as u64;

        if pipeline.vsync_control.enabled {
            let frame_period_ns = (pipeline.vsync_control.frame_period_ms * 1_000_000.0) as u64;
            let next_vsync_ns = pipeline.vsync_control.next_present_time_ns;

            if current_time_ns < next_vsync_ns {
                let wait_time_ns = next_vsync_ns - current_time_ns;
                pipeline.frame_metrics.present_time_ms = (wait_time_ns as f32) / 1_000_000.0;
            }

            pipeline.vsync_control.present_time_ns = current_time_ns;
            pipeline.vsync_control.next_present_time_ns = current_time_ns + frame_period_ns;
        }

        pipeline.frame_sync.ready_to_present = true;
        true
    }

    /// Enable ray tracing features
    pub fn enable_ray_tracing(
        pipeline: &mut GraphicsPipeline,
        max_recursion_depth: u32,
    ) {
        pipeline.ray_tracing_enabled = true;

        if let Some(rt_pipeline) = &mut pipeline.ray_tracing_pipeline {
            rt_pipeline.max_recursion_depth = max_recursion_depth;
        }
    }

    /// Analyze performance bottlenecks
    pub fn analyze_bottlenecks(pipeline: &GraphicsPipeline) -> String {
        let mut analysis = String::new();

        let gpu_util = &pipeline.gpu_utilization;
        if gpu_util.gpu_utilization_percent > 90.0 {
            analysis.push_str("GPU is at high utilization\n");
        }

        if pipeline.frame_metrics.gpu_time_ms > pipeline.frame_pacing.target_frame_time_ms {
            analysis.push_str("GPU time exceeds frame budget\n");
        }

        if pipeline.pipeline_efficiency.memory_efficiency_percent < 50.0 {
            analysis.push_str("Memory efficiency is low - check access patterns\n");
        }

        analysis
    }

    /// Update frame timing statistics
    pub fn update_frame_stats(pipeline: &mut GraphicsPipeline, frame_time_ms: f32) {
        pipeline.frame_metrics.frame_time_history.push(frame_time_ms);
        if pipeline.frame_metrics.frame_time_history.len() > 300 {
            pipeline.frame_metrics.frame_time_history.remove(0);
        }

        let mut sum = 0.0;
        let mut min = f32::MAX;
        let mut max = 0.0;

        for &time in &pipeline.frame_metrics.frame_time_history {
            sum += time;
            min = min.min(time);
            max = max.max(time);
        }

        let count = pipeline.frame_metrics.frame_time_history.len() as f32;
        pipeline.frame_metrics.frame_time_avg_ms = sum / count;
        pipeline.frame_metrics.frame_time_min_ms = min;
        pipeline.frame_metrics.frame_time_max_ms = max;

        // Calculate variance
        let mut variance_sum = 0.0;
        for &time in &pipeline.frame_metrics.frame_time_history {
            variance_sum += (time - pipeline.frame_metrics.frame_time_avg_ms).powi(2);
        }
        pipeline.frame_pacing.frame_time_variance = variance_sum / count;
    }
}

// ═══════════════════════════════════════════════════════════════════════════════
// INTEGRATION EXAMPLES
// ═══════════════════════════════════════════════════════════════════════════════

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_pipeline_initialization() {
        let pipeline = GraphicsPipelineIntegration::initialize_pipeline(1920, 1080, true, false);
        assert_eq!(pipeline.enabled, true);
        assert_eq!(pipeline.current_frame, 0);
    }

    #[test]
    fn test_vsync_control() {
        let mut pipeline = GraphicsPipelineIntegration::initialize_pipeline(1920, 1080, false, false);
        assert_eq!(pipeline.vsync_control.enabled, true);
        assert_eq!(pipeline.vsync_control.refresh_rate_hz, 60);
    }

    #[test]
    fn test_frame_timing() {
        let mut pipeline = GraphicsPipelineIntegration::initialize_pipeline(1920, 1080, false, false);

        GraphicsPipelineIntegration::update_frame_stats(&mut pipeline, 16.667);
        GraphicsPipelineIntegration::update_frame_stats(&mut pipeline, 16.667);
        GraphicsPipelineIntegration::update_frame_stats(&mut pipeline, 16.667);

        assert!(pipeline.frame_metrics.frame_time_avg_ms > 0.0);
    }

    #[test]
    fn test_memory_pools() {
        let pipeline = GraphicsPipelineIntegration::initialize_pipeline(1920, 1080, false, false);
        assert!(!pipeline.memory_pools.is_empty());
        assert_eq!(pipeline.memory_pools[0].pool_type, "Vertex");
    }
}
