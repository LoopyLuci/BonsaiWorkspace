        /// Get GPU core count information
        pub fn get_gpu_info(&self) -> String {
            format!(
                "{} - GPU: {} cores @ {}MHz, Neural Engine: {} cores, Memory: {}GB, BW: {:.1} GB/s",
                self.model_name,
                self.gpu_cores,
                self.max_frequency_mhz,
                self.neural_engine_cores,
                self.unified_memory_mb / 1024,
                self.max_memory_bandwidth_gbps
            )
        }
