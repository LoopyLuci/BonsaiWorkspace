// ═══════════════════════════════════════════════════════════════════════════════
// APPLE METAL DRIVER - USAGE EXAMPLES
// Comprehensive examples demonstrating all driver capabilities
// ═══════════════════════════════════════════════════════════════════════════════

module AppleMetalDriverExamples {

    use AppleMetalDriver;
    use AppleMetalDriverTitan;

    // ═══════════════════════════════════════════════════════════════════════════════
    // EXAMPLE 1: Basic Initialization and Device Detection
    // ═══════════════════════════════════════════════════════════════════════════════

    pub fn example_basic_initialization() -> Result<(), String> {
        println!("\n╔════════════════════════════════════════════════════════════╗");
        println!("║  EXAMPLE 1: Basic Initialization                           ║");
        println!("╚════════════════════════════════════════════════════════════╝\n");

        // Detect host device and initialize automatically
        let ctx = AppleMetalDriverTitan::detect_and_initialize()?;
        println!("✅ Driver initialized successfully");

        // List all supported chips
        let supported = AppleMetalDriverTitan::list_supported_devices();
        println!("\n📱 Supported Apple Silicon Devices ({} total):", supported.len());
        for (i, chip) in supported.iter().enumerate() {
            if i < 5 {
                println!("   • {}", chip);
            }
        }
        println!("   ... and {} more", supported.len().saturating_sub(5));

        Ok(())
    }

    // ═══════════════════════════════════════════════════════════════════════════════
    // EXAMPLE 2: Memory Management and Allocation
    // ═══════════════════════════════════════════════════════════════════════════════

    pub fn example_memory_management() -> Result<(), String> {
        println!("\n╔════════════════════════════════════════════════════════════╗");
        println!("║  EXAMPLE 2: Memory Management                              ║");
        println!("╚════════════════════════════════════════════════════════════╝\n");

        let mut ctx = AppleMetalDriverTitan::MetalGraphicsContext::new(
            AppleMetalDriver::AppleSiliconChip::M3Pro,
            60
        )?;

        println!("🧠 Unified Memory Architecture:");
        let (mem_util, mem_used) = ctx.get_memory_usage();
        println!("   Utilization: {:.1}%", mem_util);
        println!("   Used: {:.2} MB", mem_used);

        // Allocate various GPU buffers
        println!("\n📦 Allocating GPU Buffers:");

        let vertex_buffer = ctx.allocate_memory(
            "vertex_buffer".to_string(),
            64 * 1024  // 64 KB
        )?;
        println!("   ✓ Vertex Buffer: {} bytes @ address {}", 64 * 1024, vertex_buffer);

        let index_buffer = ctx.allocate_memory(
            "index_buffer".to_string(),
            32 * 1024  // 32 KB
        )?;
        println!("   ✓ Index Buffer: {} bytes @ address {}", 32 * 1024, index_buffer);

        let uniform_buffer = ctx.allocate_memory(
            "uniform_buffer".to_string(),
            16 * 1024  // 16 KB
        )?;
        println!("   ✓ Uniform Buffer: {} bytes @ address {}", 16 * 1024, uniform_buffer);

        println!("\n✅ All buffers allocated in unified memory");
        let (mem_util_after, mem_used_after) = ctx.get_memory_usage();
        println!("   New utilization: {:.1}%", mem_util_after);
        println!("   New used: {:.2} MB", mem_used_after);

        ctx.cleanup();
        Ok(())
    }

    // ═══════════════════════════════════════════════════════════════════════════════
    // EXAMPLE 3: Texture and Buffer Management
    // ═══════════════════════════════════════════════════════════════════════════════

    pub fn example_texture_and_buffer_management() -> Result<(), String> {
        println!("\n╔════════════════════════════════════════════════════════════╗");
        println!("║  EXAMPLE 3: Texture and Buffer Management                  ║");
        println!("╚════════════════════════════════════════════════════════════╝\n");

        let mut ctx = AppleMetalDriverTitan::MetalGraphicsContext::new(
            AppleMetalDriver::AppleSiliconChip::M3Pro,
            60
        )?;

        // Create various textures
        println!("🖼️  Creating Textures:");

        ctx.create_texture(
            "color_target".to_string(),
            1920, 1080,
            "RGBA8".to_string()
        )?;
        println!("   ✓ Color Target: 1920x1080 RGBA8");

        ctx.create_texture(
            "normal_map".to_string(),
            2048, 2048,
            "RGBA8".to_string()
        )?;
        println!("   ✓ Normal Map: 2048x2048");

        ctx.create_texture(
            "hdr_target".to_string(),
            1920, 1080,
            "RGBA16F".to_string()
        )?;
        println!("   ✓ HDR Target: 1920x1080 RGBA16Float");

        ctx.create_texture(
            "depth_target".to_string(),
            1920, 1080,
            "Depth32F".to_string()
        )?;
        println!("   ✓ Depth Target: 1920x1080 Depth32F");

        println!("\n📦 Creating GPU Buffers:");

        ctx.create_buffer(
            "vertex_buffer".to_string(),
            1024 * 1024,  // 1 MB
            "vertex".to_string()
        )?;
        println!("   ✓ Vertex Buffer: 1 MB");

        ctx.create_buffer(
            "index_buffer".to_string(),
            512 * 1024,   // 512 KB
            "index".to_string()
        )?;
        println!("   ✓ Index Buffer: 512 KB");

        ctx.create_buffer(
            "uniform_buffer".to_string(),
            64 * 1024,    // 64 KB
            "uniform".to_string()
        )?;
        println!("   ✓ Uniform Buffer: 64 KB");

        ctx.create_buffer(
            "storage_buffer".to_string(),
            4 * 1024 * 1024,  // 4 MB
            "storage".to_string()
        )?;
        println!("   ✓ Storage Buffer: 4 MB");

        println!("\n📊 Resource Summary:");
        println!("   Textures: 4 (Total: {:.2} MB)",
            (1920 * 1080 * 4 + 2048 * 2048 * 4 + 1920 * 1080 * 8) as f64 / 1024.0 / 1024.0);
        println!("   Buffers: 4 (Total: {:.2} MB)", 5.625);

        ctx.cleanup();
        Ok(())
    }

    // ═══════════════════════════════════════════════════════════════════════════════
    // EXAMPLE 4: Shader Compilation
    // ═══════════════════════════════════════════════════════════════════════════════

    pub fn example_shader_compilation() -> Result<(), String> {
        println!("\n╔════════════════════════════════════════════════════════════╗");
        println!("║  EXAMPLE 4: Shader Compilation (MSL)                       ║");
        println!("╚════════════════════════════════════════════════════════════╝\n");

        let mut ctx = AppleMetalDriverTitan::MetalGraphicsContext::new(
            AppleMetalDriver::AppleSiliconChip::M2Pro,
            60
        )?;

        // Vertex shader
        let vertex_shader = r#"
#include <metal_stdlib>
using namespace metal;

struct VertexInput {
    float3 position [[attribute(0)]];
    float3 normal [[attribute(1)]];
    float2 texcoord [[attribute(2)]];
};

struct VertexOutput {
    float4 position [[position]];
    float3 normal;
    float2 texcoord;
};

vertex VertexOutput vs_main(VertexInput in [[stage_in]]) {
    VertexOutput out;
    out.position = float4(in.position, 1.0);
    out.normal = in.normal;
    out.texcoord = in.texcoord;
    return out;
}
"#;

        ctx.compile_shader(
            "standard_vs".to_string(),
            "vertex".to_string(),
            vertex_shader.to_string()
        )?;

        // Fragment shader
        let fragment_shader = r#"
#include <metal_stdlib>
using namespace metal;

struct VertexOutput {
    float4 position [[position]];
    float3 normal;
    float2 texcoord;
};

fragment float4 fs_main(VertexOutput in [[stage_in]]) {
    float3 normal = normalize(in.normal);
    float3 light_dir = normalize(float3(1.0, 1.0, 1.0));
    float diffuse = max(dot(normal, light_dir), 0.0);

    return float4(float3(diffuse), 1.0);
}
"#;

        ctx.compile_shader(
            "standard_fs".to_string(),
            "fragment".to_string(),
            fragment_shader.to_string()
        )?;

        // Compute shader for image processing
        let compute_shader = r#"
#include <metal_stdlib>
using namespace metal;

kernel void compute_blur(
    texture2d<float, access::read> input [[texture(0)]],
    texture2d<float, access::write> output [[texture(1)]],
    uint2 gid [[thread_position_in_grid]])
{
    float4 sum = float4(0.0);
    for (int x = -2; x <= 2; x++) {
        for (int y = -2; y <= 2; y++) {
            sum += input.read(gid + uint2(x, y));
        }
    }
    sum /= 25.0;
    output.write(sum, gid);
}
"#;

        ctx.compile_shader(
            "blur_cs".to_string(),
            "compute".to_string(),
            compute_shader.to_string()
        )?;

        println!("✅ All shaders compiled successfully");
        println!("   Shader Cache: {} entries", 3);

        ctx.cleanup();
        Ok(())
    }

    // ═══════════════════════════════════════════════════════════════════════════════
    // EXAMPLE 5: Frame Rendering Loop
    // ═══════════════════════════════════════════════════════════════════════════════

    pub fn example_frame_loop() -> Result<(), String> {
        println!("\n╔════════════════════════════════════════════════════════════╗");
        println!("║  EXAMPLE 5: Frame Rendering Loop                           ║");
        println!("╚════════════════════════════════════════════════════════════╝\n");

        let mut ctx = AppleMetalDriverTitan::MetalGraphicsContext::new(
            AppleMetalDriver::AppleSiliconChip::M1Pro,
            60
        )?;

        println!("🎬 Rendering {} frames...", 5);

        for frame in 0..5 {
            ctx.begin_frame();

            // Simulate work
            let frame_time = 16.67 + (frame as f64 * 0.1);  // Target 60 FPS = 16.67ms

            // In real app: submit render/compute commands
            println!("   Frame {} completed in {:.2}ms", frame, frame_time);

            ctx.end_frame(frame_time);
        }

        println!("\n📊 Frame Statistics:");
        ctx.print_statistics();

        ctx.cleanup();
        Ok(())
    }

    // ═══════════════════════════════════════════════════════════════════════════════
    // EXAMPLE 6: Power Management and Thermal Control
    // ═══════════════════════════════════════════════════════════════════════════════

    pub fn example_power_management() -> Result<(), String> {
        println!("\n╔════════════════════════════════════════════════════════════╗");
        println!("║  EXAMPLE 6: Power Management and Thermal Control           ║");
        println!("╚════════════════════════════════════════════════════════════╝\n");

        let driver = AppleMetalDriver::AppleMetalDriver::new(
            AppleMetalDriver::AppleSiliconChip::M3Max
        )?;

        println!("⚡ Power Management");
        println!("   Max Frequency: {} MHz", driver.device.max_frequency_mhz);
        println!("   GPU Cores: {}", driver.device.gpu_cores);

        // Simulate different power modes
        println!("\n🔋 Power Modes:");

        let modes = vec![
            (AppleMetalDriver::PowerMode::HighPerformance, "High Performance"),
            (AppleMetalDriver::PowerMode::Balanced, "Balanced"),
            (AppleMetalDriver::PowerMode::PowerSaver, "Power Saver"),
            (AppleMetalDriver::PowerMode::ThermalReduction, "Thermal Reduction"),
        ];

        for (mode, name) in modes {
            let mut freq_mgr = AppleMetalDriver::GpuFrequencyManager::new(
                driver.device.max_frequency_mhz
            );
            freq_mgr.set_power_mode(mode);

            let power_mw = freq_mgr.estimate_power_mw();
            println!("   • {}: {} MHz, {} mW",
                name, freq_mgr.current_frequency_mhz, power_mw);
        }

        // Thermal management
        println!("\n🌡️  Thermal Management:");
        let temps = vec![40.0, 60.0, 75.0, 85.0, 95.0];

        for temp in temps {
            let mut freq_mgr = AppleMetalDriver::GpuFrequencyManager::new(3000);
            freq_mgr.update_thermal_state(temp);

            let throttle_status = if freq_mgr.thermal_throttle_active {
                "THROTTLED"
            } else {
                "Normal"
            };

            println!("   • {:.0}°C: {} ({} MHz)",
                temp, throttle_status, freq_mgr.current_frequency_mhz);
        }

        Ok(())
    }

    // ═══════════════════════════════════════════════════════════════════════════════
    // EXAMPLE 7: Neural Engine Integration
    // ═══════════════════════════════════════════════════════════════════════════════

    pub fn example_neural_engine() -> Result<(), String> {
        println!("\n╔════════════════════════════════════════════════════════════╗");
        println!("║  EXAMPLE 7: Neural Engine Integration                      ║");
        println!("╚════════════════════════════════════════════════════════════╝\n");

        let driver = AppleMetalDriver::AppleMetalDriver::new(
            AppleMetalDriver::AppleSiliconChip::M4Max
        )?;

        let neural_engine = &driver.neural_engine;

        println!("🧠 Neural Engine Capabilities");
        println!("   {}", neural_engine.get_capabilities());
        println!("   Supported Data Types:");
        for dtype in &neural_engine.supported_dtypes {
            println!("      • {}", dtype);
        }

        // Simulate ML inference
        println!("\n📊 ML Inference Estimation");
        let ops = vec![
            (1_000_000_000, "1B operations (small model)"),
            (10_000_000_000, "10B operations (medium model)"),
            (100_000_000_000, "100B operations (large model)"),
        ];

        for (operation_count, description) in ops {
            let time_ms = neural_engine.estimate_inference_time_ms(operation_count as u64);
            println!("   • {}: {:.2}ms", description, time_ms);
        }

        println!("\n✅ Neural Engine ready for ML acceleration");

        Ok(())
    }

    // ═══════════════════════════════════════════════════════════════════════════════
    // EXAMPLE 8: Device Capabilities and Ray Tracing
    // ═══════════════════════════════════════════════════════════════════════════════

    pub fn example_device_capabilities() -> Result<(), String> {
        println!("\n╔════════════════════════════════════════════════════════════╗");
        println!("║  EXAMPLE 8: Device Capabilities                            ║");
        println!("╚════════════════════════════════════════════════════════════╝\n");

        // Compare different chips
        let chips = vec![
            AppleMetalDriver::AppleSiliconChip::M1,
            AppleMetalDriver::AppleSiliconChip::M3Pro,
            AppleMetalDriver::AppleSiliconChip::M4Max,
            AppleMetalDriver::AppleSiliconChip::A17Pro,
        ];

        println!("📱 Apple Silicon Device Comparison\n");

        for chip in chips {
            let device = AppleMetalDriver::AppleSiliconDevice::from_chip(chip);

            println!("{}:", device.model_name);
            println!("   GPU Cores: {}", device.gpu_cores);
            println!("   Memory: {} GB", device.unified_memory_mb / 1024);
            println!("   Bandwidth: {:.0} GB/s", device.max_memory_bandwidth_gbps);
            println!("   Ray Tracing: {}", if device.supports_ray_tracing { "Yes" } else { "No" });
            println!("   Family: {}", device.device_family);
            println!();
        }

        // Ray tracing capability check
        println!("🎯 Ray Tracing Support:");

        let device_m3max = AppleMetalDriver::AppleSiliconDevice::from_chip(
            AppleMetalDriver::AppleSiliconChip::M3Max
        );
        println!("   M3 Max: {}", if device_m3max.supports_ray_tracing { "Supported ✓" } else { "Not supported" });

        let device_m1 = AppleMetalDriver::AppleSiliconDevice::from_chip(
            AppleMetalDriver::AppleSiliconChip::M1
        );
        println!("   M1: {}", if device_m1.supports_ray_tracing { "Supported ✓" } else { "Not supported" });

        Ok(())
    }

    // ═══════════════════════════════════════════════════════════════════════════════
    // EXAMPLE 9: Compute Kernel Configuration
    // ═══════════════════════════════════════════════════════════════════════════════

    pub fn example_compute_kernels() -> Result<(), String> {
        println!("\n╔════════════════════════════════════════════════════════════╗");
        println!("║  EXAMPLE 9: Compute Kernel Configuration                   ║");
        println!("╚════════════════════════════════════════════════════════════╝\n");

        // Image blur kernel
        let mut blur_kernel = AppleMetalDriver::ComputeKernel::new(
            "blur_kernel".to_string(),
            "Gaussian Blur".to_string(),
            "compute_blur".to_string()
        );
        blur_kernel.set_threadgroup_size(16, 16, 1);  // 256 threads
        blur_kernel.set_grid_size(120, 68, 1);        // Cover 1920x1080

        println!("🎨 Image Blur Kernel:");
        println!("   Threadgroup: {}x{}x{} = {} threads",
            16, 16, 1, blur_kernel.get_total_threads());
        println!("   Grid: {}x{}x{} = {} groups",
            120, 68, 1, blur_kernel.get_total_threadgroups());
        println!("   Total Threads: {}",
            blur_kernel.get_total_threads() * blur_kernel.get_total_threadgroups());

        // Matrix multiplication kernel
        let mut matmul_kernel = AppleMetalDriver::ComputeKernel::new(
            "matmul_kernel".to_string(),
            "Matrix Multiplication".to_string(),
            "compute_matmul".to_string()
        );
        matmul_kernel.set_threadgroup_size(32, 8, 1);  // 256 threads, 32x32 tile
        matmul_kernel.set_grid_size(64, 64, 1);        // 4096x4096 matrix

        println!("\n🧮 Matrix Multiplication Kernel:");
        println!("   Threadgroup: {}x{}x{} = {} threads",
            32, 8, 1, matmul_kernel.get_total_threads());
        println!("   Grid: {}x{}x{} = {} groups",
            64, 64, 1, matmul_kernel.get_total_threadgroups());
        println!("   Total Threads: {}",
            matmul_kernel.get_total_threads() * matmul_kernel.get_total_threadgroups());

        // Reduction kernel (tree reduction)
        let mut reduction_kernel = AppleMetalDriver::ComputeKernel::new(
            "reduction_kernel".to_string(),
            "Tree Reduction".to_string(),
            "compute_reduction".to_string()
        );
        reduction_kernel.set_threadgroup_size(256, 1, 1);  // Warp size aligned
        reduction_kernel.set_grid_size(256, 1, 1);

        println!("\n🌳 Tree Reduction Kernel:");
        println!("   Threadgroup: {}x{}x{} = {} threads",
            256, 1, 1, reduction_kernel.get_total_threads());
        println!("   Grid: {}x{}x{} = {} groups",
            256, 1, 1, reduction_kernel.get_total_threadgroups());
        println!("   Total Threads: {}",
            reduction_kernel.get_total_threads() * reduction_kernel.get_total_threadgroups());

        Ok(())
    }

    // ═══════════════════════════════════════════════════════════════════════════════
    // MAIN EXAMPLE RUNNER
    // ═══════════════════════════════════════════════════════════════════════════════

    pub fn run_all_examples() -> Result<(), String> {
        println!("\n╔════════════════════════════════════════════════════════════╗");
        println!("║                                                            ║");
        println!("║     APPLE METAL DRIVER - COMPREHENSIVE EXAMPLES            ║");
        println!("║                                                            ║");
        println!("╚════════════════════════════════════════════════════════════╝");

        example_basic_initialization()?;
        example_device_capabilities()?;
        example_memory_management()?;
        example_texture_and_buffer_management()?;
        example_shader_compilation()?;
        example_frame_loop()?;
        example_power_management()?;
        example_neural_engine()?;
        example_compute_kernels()?;

        println!("\n╔════════════════════════════════════════════════════════════╗");
        println!("║  ✅ All examples completed successfully!                  ║");
        println!("╚════════════════════════════════════════════════════════════╝\n");

        Ok(())
    }
}
