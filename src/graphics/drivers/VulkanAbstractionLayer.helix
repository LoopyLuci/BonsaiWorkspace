    // COMMAND BUFFERS
    // ═══════════════════════════════════════════════════════════════════════════════

    /// Create command pool
    pub fn vk_create_command_pool(
        device: VkDevice,
        queue_family_index: u32,
        transient: bool,
        reset_command_buffer: bool,
    ) -> Result<VkCommandPool, String> {
        // Implementation: Create command pool
        // - Call vkCreateCommandPool
        // - Configure flags for pool type
        Result::Ok(VkCommandPool {
            handle: 0,
            queue_family_index: queue_family_index,
            transient: transient,
            reset_command_buffer: reset_command_buffer,
        })
    }

    /// Allocate command buffers
    pub fn vk_allocate_command_buffers(
        device: VkDevice,
        command_pool: VkCommandPool,
        level: String, // PRIMARY or SECONDARY
        count: u32,
    ) -> Result<Vec<VkCommandBuffer>, String> {
        // Implementation: Allocate command buffers
        // - Call vkAllocateCommandBuffers
        // - Initialize command buffer state
        let mut buffers = vec![];
        for i in 0..count {
            buffers.push(VkCommandBuffer {
                handle: 0,
                command_pool: command_pool.clone(),
                level: level.clone(),
                state: CommandBufferState::Initial,
                begin_time: 0,
                recorded_commands: 0,
                inheritance_info: None,
            });
        }
        Result::Ok(buffers)
    }

