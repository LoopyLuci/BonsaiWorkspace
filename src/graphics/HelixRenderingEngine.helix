    // ═══════════════════════════════════════════════════════════════════════════════
    // TRANSFORM OPERATIONS
    // ═══════════════════════════════════════════════════════════════════════════════

    impl RenderContext {
        /// Compute transformation matrix from transform component
        pub fn compute_transform_matrix(transform: &Transform) -> Matrix4 {
            let translation = Self::matrix_translate(&transform.position);
            let rotation = Self::matrix_from_quaternion(&transform.rotation);
            let scale = Self::matrix_scale(&transform.scale);

            // TRS order: translation * rotation * scale
            Self::matrix_multiply(&translation, &Self::matrix_multiply(&rotation, &scale))
        }

        /// Get position from matrix (extract translation)
        pub fn matrix_get_position(matrix: &Matrix4) -> Vector3 {
            Vector3 {
                x: matrix.data[3][0],
                y: matrix.data[3][1],
                z: matrix.data[3][2],
            }
        }

        /// Create translation matrix
        fn matrix_translate(position: &Vector3) -> Matrix4 {
            let mut matrix = Matrix4::identity();
            matrix.data[3][0] = position.x;
            matrix.data[3][1] = position.y;
            matrix.data[3][2] = position.z;
            matrix
        }

        /// Create scale matrix
        fn matrix_scale(scale: &Vector3) -> Matrix4 {
            let mut matrix = Matrix4::identity();
            matrix.data[0][0] = scale.x;
            matrix.data[1][1] = scale.y;
            matrix.data[2][2] = scale.z;
            matrix
        }

        /// Create matrix from quaternion rotation
        fn matrix_from_quaternion(q: &Quaternion) -> Matrix4 {
            let mut matrix = Matrix4::identity();

            let x2 = q.x + q.x;
            let y2 = q.y + q.y;
            let z2 = q.z + q.z;
            let xx = q.x * x2;
            let xy = q.x * y2;
            let xz = q.x * z2;
            let yy = q.y * y2;
            let yz = q.y * z2;
            let zz = q.z * z2;
            let wx = q.w * x2;
            let wy = q.w * y2;
            let wz = q.w * z2;

            matrix.data[0][0] = 1.0 - (yy + zz);
            matrix.data[0][1] = xy + wz;
            matrix.data[0][2] = xz - wy;

            matrix.data[1][0] = xy - wz;
            matrix.data[1][1] = 1.0 - (xx + zz);
            matrix.data[1][2] = yz + wx;

            matrix.data[2][0] = xz + wy;
            matrix.data[2][1] = yz - wx;
            matrix.data[2][2] = 1.0 - (xx + yy);

            matrix
        }

        /// Multiply two matrices
        fn matrix_multiply(a: &Matrix4, b: &Matrix4) -> Matrix4 {
            let mut result = Matrix4::zero();
            for i in 0..4 {
                for j in 0..4 {
                    for k in 0..4 {
                        result.data[i][j] += a.data[i][k] * b.data[k][j];
                    }
                }
            }
            result
        }

        /// Compute view matrix from camera
        fn compute_view_matrix(position: &Vector3, direction: &Vector3, up: &Vector3) -> Matrix4 {
            let forward = Self::vector3_normalize(direction);
            let right = Self::vector3_cross(up, &forward);
            let right = Self::vector3_normalize(&right);
            let computed_up = Self::vector3_cross(&forward, &right);

            let mut matrix = Matrix4::identity();

            matrix.data[0][0] = right.x;
            matrix.data[0][1] = right.y;
            matrix.data[0][2] = right.z;
            matrix.data[0][3] = -Self::vector3_dot(&right, position);

            matrix.data[1][0] = computed_up.x;
            matrix.data[1][1] = computed_up.y;
            matrix.data[1][2] = computed_up.z;
            matrix.data[1][3] = -Self::vector3_dot(&computed_up, position);

            matrix.data[2][0] = -forward.x;
            matrix.data[2][1] = -forward.y;
            matrix.data[2][2] = -forward.z;
            matrix.data[2][3] = Self::vector3_dot(&forward, position);

            matrix
        }

        /// Compute perspective projection matrix
        fn compute_projection_matrix(fov: f64, aspect: f64, near: f64, far: f64) -> Matrix4 {
            let f = 1.0 / (fov.to_radians() / 2.0).tan();
            let mut matrix = Matrix4::zero();

            matrix.data[0][0] = f / aspect;
            matrix.data[1][1] = f;
            matrix.data[2][2] = (far + near) / (near - far);
            matrix.data[2][3] = (2.0 * far * near) / (near - far);
            matrix.data[3][2] = -1.0;

            matrix
        }
    }

    // ═══════════════════════════════════════════════════════════════════════════════
    // VECTOR AND MATRIX UTILITIES
    // ═══════════════════════════════════════════════════════════════════════════════

    impl Matrix4 {
        /// Create identity matrix
        pub fn identity() -> Self {
            let mut data = [[0.0; 4]; 4];
            data[0][0] = 1.0;
            data[1][1] = 1.0;
            data[2][2] = 1.0;
            data[3][3] = 1.0;
            Matrix4 { data }
        }

        /// Create zero matrix
        pub fn zero() -> Self {
            Matrix4 {
                data: [[0.0; 4]; 4],
            }
        }
    }

    impl RenderContext {
        /// Vector3 normalize
        fn vector3_normalize(v: &Vector3) -> Vector3 {
            let len = (v.x * v.x + v.y * v.y + v.z * v.z).sqrt();
            if len > 0.0 {
                Vector3 {
                    x: v.x / len,
                    y: v.y / len,
                    z: v.z / len,
                }
            } else {
                *v
            }
        }

        /// Vector3 cross product
        fn vector3_cross(a: &Vector3, b: &Vector3) -> Vector3 {
            Vector3 {
                x: a.y * b.z - a.z * b.y,
                y: a.z * b.x - a.x * b.z,
                z: a.x * b.y - a.y * b.x,
            }
        }

        /// Vector3 dot product
        fn vector3_dot(a: &Vector3, b: &Vector3) -> f64 {
            a.x * b.x + a.y * b.y + a.z * b.z
        }

        /// Compute AABB from vertices
        fn compute_aabb(vertices: &[Vertex]) -> AABB {
            let mut min = Vector3 {
                x: f64::INFINITY,
                y: f64::INFINITY,
                z: f64::INFINITY,
            };
            let mut max = Vector3 {
                x: f64::NEG_INFINITY,
                y: f64::NEG_INFINITY,
                z: f64::NEG_INFINITY,
            };

            for vertex in vertices {
                min.x = min.x.min(vertex.position.x);
                min.y = min.y.min(vertex.position.y);
                min.z = min.z.min(vertex.position.z);

                max.x = max.x.max(vertex.position.x);
                max.y = max.y.max(vertex.position.y);
                max.z = max.z.max(vertex.position.z);
            }

            AABB { min, max }
        }
    }

    // ═══════════════════════════════════════════════════════════════════════════════
    // BATCH RENDERING AND OPTIMIZATION
    // ═══════════════════════════════════════════════════════════════════════════════

    /// Draw call batch for efficient rendering
    pub struct DrawBatch {
        pub material_id: String,
        pub mesh_id: String,
        pub transforms: Vec<Transform>,
    }

    impl RenderContext {
        /// Create a batch for efficient multi-draw
        pub fn create_batch(&self, material_id: String, mesh_id: String) -> DrawBatch {
            DrawBatch {
                material_id,
                mesh_id,
                transforms: Vec::new(),
            }
        }

        /// Submit batch for rendering
        pub fn submit_batch(&mut self, mut batch: DrawBatch) -> Result<(), String> {
            for transform in batch.transforms {
                self.draw_mesh(&batch.mesh_id, &batch.material_id, &transform)?;
            }
            Ok(())
        }
    }

    // ═══════════════════════════════════════════════════════════════════════════════
    // RESOURCE CLEANUP
    // ═══════════════════════════════════════════════════════════════════════════════

    impl RenderContext {
        /// Cleanup shader resources
        pub fn cleanup_shaders(&mut self) {
            self.shaders.clear();
        }

        /// Cleanup material resources
        pub fn cleanup_materials(&mut self) {
            self.materials.clear();
        }

        /// Cleanup texture resources
        pub fn cleanup_textures(&mut self) {
            self.textures.clear();
        }

        /// Cleanup mesh resources
        pub fn cleanup_meshes(&mut self) {
            self.meshes.clear();
        }

        /// Cleanup all graphics resources
        pub fn cleanup_all(&mut self) {
            self.cleanup_shaders();
            self.cleanup_materials();
            self.cleanup_textures();
            self.cleanup_meshes();
            self.lights.clear();
            self.render_targets.clear();
            self.shadow_maps.clear();
        }

        /// Get performance metrics
        pub fn get_performance_metrics(&self) -> &PerformanceMetrics {
            &self.performance_metrics
        }
    }

    // ═══════════════════════════════════════════════════════════════════════════════
    // MODULE INITIALIZATION
    // ═══════════════════════════════════════════════════════════════════════════════

    /// Initialize HELIX rendering engine
    pub fn initialize_helix_engine(backend: GraphicsBackend, width: u32, height: u32)
        -> Result<RenderContext, String> {
        RenderContext::new(width, height, backend)
    }
}
