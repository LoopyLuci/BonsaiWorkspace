@echo off
REM Omnisystem v2.5.0 - Enterprise GUI Launcher
REM Launches the complete Omnisystem App Menu with full GUI

title Omnisystem v2.5.0 - Enterprise Application Manager
color 0B

REM Get the directory where this batch file is located
set SCRIPT_DIR=%~dp0

REM Launch the HTML GUI in default browser
start "" "%SCRIPT_DIR%AppMenu.html"

REM Also show CLI menu in background
echo.
echo ???????????????????????????????????????????????????????????????????????????????
echo.
echo   OMNISYSTEM v2.5.0 - ENTERPRISE OPERATING SYSTEM
echo.
echo   GUI Menu is launching in your browser...
echo.
echo   For CLI interface, use:
echo   ? Omnisystem_CLI.exe gui
echo.
echo ???????????????????????????????????????????????????????????????????????????????
echo.
pause
